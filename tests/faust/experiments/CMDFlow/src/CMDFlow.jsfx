breathPhase = (iid - floor(iid / 997) * 997) * 0.006283185307179586;

setup_from_sliders();
build_filterbank();

cf_energy_c=1-exp(-1/(.010*srate));
cf_smooth_c=1-exp(-1/(.040*srate));
cf_breath=1;
cf_e0=0;
