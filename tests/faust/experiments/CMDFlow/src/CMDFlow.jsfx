cf_b_l6=cf_lp_l6-cf_lp_l5;
cf_b_l7=cf_lp_l7-cf_lp_l6;
cf_b_l8=cf_lp_l8-cf_lp_l7;
cf_b_l9=cf_lp_l9-cf_lp_l8;
cf_b_l10=cf_lp_l10-cf_lp_l9;
cf_b_l11=spl0-cf_lp_l10;
cf_lp_r0=cf_pole(cf_a0,spl1);
cf_lp_r1=cf_pole(cf_a1,spl1);
cf_lp_r2=cf_pole(cf_a2,spl1);
cf_lp_r3=cf_pole(cf_a3,spl1);
cf_lp_r4=cf_pole(cf_a4,spl1);
cf_lp_r5=cf_pole(cf_a5,spl1);
