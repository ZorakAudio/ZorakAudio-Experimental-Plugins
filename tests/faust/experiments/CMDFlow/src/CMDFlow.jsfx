contact_accum+=accum[9];
visc_accum+=accum[9];
accum[10]=max(0,cf_e10)*samplesblock; total_accum+=accum[10];
contact_accum+=accum[10];
accum[11]=max(0,cf_e11)*samplesblock; total_accum+=accum[11];
onset_accum=max(0,total_accum-cf_previous_total); cf_previous_total=total_accum;
cf_policy_time += samplesblock/srate;
cf_policy_time >= .020 ? (
cf_policy_time = cf_policy_time-floor(cf_policy_time/.020)*.020;
setup_from_sliders();

work_srate = srate;
work_srate < 1000 ? work_srate = 48000;
(work_srate != last_srate || need_filter_rebuild) ? build_filterbank();

ensure_bus_header();
allocate_slot();
publish_slot();

drain_messages();
update_band_envs();
update_motion_envs();
compute_turnpulse_target();
publish_slot();
compute_declutter_targets();
publish_slot();
compute_somatic_targets();
// Final M/S width target is kept below +/-1% for barely-JND piston behavior.
targetWidth = manifold_amt * clamp(targetWidth + pistonTargetWidth, -JND_WIDTH_LIMIT, JND_WIDTH_LIMIT);

seq += 1;
peer_count = active_peer_instances;


);
cf_tcut0=targetCut[0]; cf_tsom0=targetSom[0]; smoothCut[0]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[0]-smoothCut[0]); smoothSom[0]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[0]-smoothSom[0]);
cf_tcut1=targetCut[1]; cf_tsom1=targetSom[1]; smoothCut[1]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[1]-smoothCut[1]); smoothSom[1]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[1]-smoothSom[1]);
cf_tcut2=targetCut[2]; cf_tsom2=targetSom[2]; smoothCut[2]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[2]-smoothCut[2]); smoothSom[2]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[2]-smoothSom[2]);
cf_tcut3=targetCut[3]; cf_tsom3=targetSom[3]; smoothCut[3]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[3]-smoothCut[3]); smoothSom[3]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[3]-smoothSom[3]);
cf_tcut4=targetCut[4]; cf_tsom4=targetSom[4]; smoothCut[4]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[4]-smoothCut[4]); smoothSom[4]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[4]-smoothSom[4]);
cf_tcut5=targetCut[5]; cf_tsom5=targetSom[5]; smoothCut[5]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[5]-smoothCut[5]); smoothSom[5]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[5]-smoothSom[5]);
cf_tcut6=targetCut[6]; cf_tsom6=targetSom[6]; smoothCut[6]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[6]-smoothCut[6]); smoothSom[6]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[6]-smoothSom[6]);
cf_tcut7=targetCut[7]; cf_tsom7=targetSom[7]; smoothCut[7]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[7]-smoothCut[7]); smoothSom[7]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[7]-smoothSom[7]);
cf_tcut8=targetCut[8]; cf_tsom8=targetSom[8]; smoothCut[8]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[8]-smoothCut[8]); smoothSom[8]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[8]-smoothSom[8]);
cf_tcut9=targetCut[9]; cf_tsom9=targetSom[9]; smoothCut[9]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[9]-smoothCut[9]); smoothSom[9]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[9]-smoothSom[9]);
cf_tcut10=targetCut[10]; cf_tsom10=targetSom[10]; smoothCut[10]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[10]-smoothCut[10]); smoothSom[10]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[10]-smoothSom[10]);
cf_tcut11=targetCut[11]; cf_tsom11=targetSom[11]; smoothCut[11]+=(1-exp(-samplesblock/(.040*srate)))*(targetCut[11]-smoothCut[11]); smoothSom[11]+=(1-exp(-samplesblock/(.040*srate)))*(targetSom[11]-smoothSom[11]);

@faust block
cf_pole(c,x)=x:(step~_):(!,_) with {
 step(previous,value)=next,next with { next=previous+(value-previous)*c; };
};
cf_lp_l0=cf_pole(cf_a0,spl0);
cf_lp_l1=cf_pole(cf_a1,spl0);
cf_lp_l2=cf_pole(cf_a2,spl0);
