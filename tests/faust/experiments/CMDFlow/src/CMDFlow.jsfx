clear_own_slot();
sprintf(#flow_namespace,"ZorakAudio.CMD.Flow.%s",#bus_name);
gmem_attach_size(#flow_namespace, GMEM_SIZE);

@block
// Summaries from the preceding FAUST block feed peer policy once per block.
cf_energy_c=1-exp(-1/(.010*srate));
cf_smooth_c=1-exp(-1/(.040*srate));
cf_breath_phase += samplesblock/srate*(.045+.420*bus_arousal+.220*bus_thrust)*2*$pi;
cf_breath_phase -= floor(cf_breath_phase/(2*$pi))*2*$pi;
cf_breath=.70+.30*sin(cf_breath_phase);
total_accum=0; low_accum=0; contact_accum=0; visc_accum=0;
accum[0]=max(0,cf_e0)*samplesblock; total_accum+=accum[0];
low_accum+=accum[0];
accum[1]=max(0,cf_e1)*samplesblock; total_accum+=accum[1];
low_accum+=accum[1];
accum[2]=max(0,cf_e2)*samplesblock; total_accum+=accum[2];
low_accum+=accum[2];
accum[3]=max(0,cf_e3)*samplesblock; total_accum+=accum[3];
visc_accum+=accum[3];
