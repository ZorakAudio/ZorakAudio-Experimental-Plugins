cf_lp_r10=cf_pole(cf_a10,spl1);
cf_b_r0=cf_lp_r0;
cf_b_r1=cf_lp_r1-cf_lp_r0;
cf_b_r2=cf_lp_r2-cf_lp_r1;
cf_b_r3=cf_lp_r3-cf_lp_r2;
cf_b_r4=cf_lp_r4-cf_lp_r3;
cf_b_r5=cf_lp_r5-cf_lp_r4;
cf_b_r6=cf_lp_r6-cf_lp_r5;
cf_b_r7=cf_lp_r7-cf_lp_r6;
cf_b_r8=cf_lp_r8-cf_lp_r7;
cf_b_r9=cf_lp_r9-cf_lp_r8;
cf_b_r10=cf_lp_r10-cf_lp_r9;
cf_b_r11=spl1-cf_lp_r10;
cf_e0=cf_pole(cf_energy_c,.5*(cf_b_l0*cf_b_l0+cf_b_r0*cf_b_r0));
cf_cut0=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut0)));
cf_som0=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom0)));
cf_gain0=1-cf_cut0+cf_som0*cf_breath;
cf_e1=cf_pole(cf_energy_c,.5*(cf_b_l1*cf_b_l1+cf_b_r1*cf_b_r1));
cf_cut1=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut1)));
cf_som1=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom1)));
cf_gain1=1-cf_cut1+cf_som1*cf_breath;
cf_e2=cf_pole(cf_energy_c,.5*(cf_b_l2*cf_b_l2+cf_b_r2*cf_b_r2));
cf_cut2=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut2)));
cf_som2=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom2)));
cf_gain2=1-cf_cut2+cf_som2*cf_breath;
cf_e3=cf_pole(cf_energy_c,.5*(cf_b_l3*cf_b_l3+cf_b_r3*cf_b_r3));
cf_cut3=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut3)));
cf_som3=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom3)));
cf_gain3=1-cf_cut3+cf_som3*cf_breath;
cf_e4=cf_pole(cf_energy_c,.5*(cf_b_l4*cf_b_l4+cf_b_r4*cf_b_r4));
cf_cut4=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut4)));
cf_som4=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom4)));
cf_gain4=1-cf_cut4+cf_som4*cf_breath;
cf_e5=cf_pole(cf_energy_c,.5*(cf_b_l5*cf_b_l5+cf_b_r5*cf_b_r5));
cf_cut5=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut5)));
cf_som5=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom5)));
cf_gain5=1-cf_cut5+cf_som5*cf_breath;
cf_e6=cf_pole(cf_energy_c,.5*(cf_b_l6*cf_b_l6+cf_b_r6*cf_b_r6));
cf_cut6=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut6)));
cf_som6=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom6)));
cf_gain6=1-cf_cut6+cf_som6*cf_breath;
cf_e7=cf_pole(cf_energy_c,.5*(cf_b_l7*cf_b_l7+cf_b_r7*cf_b_r7));
cf_cut7=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut7)));
cf_som7=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom7)));
cf_gain7=1-cf_cut7+cf_som7*cf_breath;
cf_e8=cf_pole(cf_energy_c,.5*(cf_b_l8*cf_b_l8+cf_b_r8*cf_b_r8));
cf_cut8=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut8)));
cf_som8=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom8)));
cf_gain8=1-cf_cut8+cf_som8*cf_breath;
cf_e9=cf_pole(cf_energy_c,.5*(cf_b_l9*cf_b_l9+cf_b_r9*cf_b_r9));
cf_cut9=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut9)));
cf_som9=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom9)));
cf_gain9=1-cf_cut9+cf_som9*cf_breath;
cf_e10=cf_pole(cf_energy_c,.5*(cf_b_l10*cf_b_l10+cf_b_r10*cf_b_r10));
cf_cut10=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut10)));
cf_som10=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom10)));
cf_gain10=1-cf_cut10+cf_som10*cf_breath;
cf_e11=cf_pole(cf_energy_c,.5*(cf_b_l11*cf_b_l11+cf_b_r11*cf_b_r11));
cf_cut11=cf_pole(cf_smooth_c,min(.95,max(0,cf_tcut11)));
cf_som11=cf_pole(cf_smooth_c,min(.25,max(-.25,cf_tsom11)));
cf_gain11=1-cf_cut11+cf_som11*cf_breath;
cf_out_l=cf_b_l0*cf_gain0+cf_b_l1*cf_gain1+cf_b_l2*cf_gain2+cf_b_l3*cf_gain3+cf_b_l4*cf_gain4+cf_b_l5*cf_gain5+cf_b_l6*cf_gain6+cf_b_l7*cf_gain7+cf_b_l8*cf_gain8+cf_b_l9*cf_gain9+cf_b_l10*cf_gain10+cf_b_l11*cf_gain11;
cf_out_r=cf_b_r0*cf_gain0+cf_b_r1*cf_gain1+cf_b_r2*cf_gain2+cf_b_r3*cf_gain3+cf_b_r4*cf_gain4+cf_b_r5*cf_gain5+cf_b_r6*cf_gain6+cf_b_r7*cf_gain7+cf_b_r8*cf_gain8+cf_b_r9*cf_gain9+cf_b_r10*cf_gain10+cf_b_r11*cf_gain11;
cf_width=cf_pole(cf_smooth_c,targetWidth);
cf_sat=cf_pole(cf_smooth_c,min(.35,max(0,targetSat)));
cf_mid=.5*(cf_out_l+cf_out_r);
cf_side=.5*(cf_out_l-cf_out_r)*(1+cf_width);
cf_left=cf_mid+cf_side;
cf_right=cf_mid-cf_side;
cf_audio_l=min(8,max(-8,out_gain*cf_left*(1+cf_sat)/(1+cf_sat*abs(cf_left))));
cf_audio_r=min(8,max(-8,out_gain*cf_right*(1+cf_sat)/(1+cf_sat*abs(cf_right))));
process=cf_audio_l,cf_audio_r;

@gfx 620 300
gfx_clear = 0;
w = gfx_w;
h = gfx_h;

gfx_set(0.80, 0.80, 0.80, 1);
gfx_x = 12; gfx_y = 10;
gfx_drawstr("CMD Flow | Full-block FAUST  |  Shared Bus  |  Active ");
gfx_drawnumber(active_instances, 0);
gfx_drawstr("  |  Peers ");
gfx_drawnumber(active_peer_instances, 0);
gfx_drawstr("  |  Role ");
role_name();

x0 = 14; y0 = 44; x1 = w - 14; y1 = 142;
barw = (x1 - x0) / max(active_nb, 1);

i = 0;
while (i < active_nb) (
  x = x0 + i * barw;
  a = env[i] / floor_energy - 1;
  a < 0 ? a = 0;
  a = clamp(a / 24, 0, 1);

  gr = smoothCut[i];
  gr = clamp(gr, 0, 1);

  sm = abs(smoothSom[i]);
  sm = clamp(sm * 8, 0, 1);

  gfx_set(0.20, 0.35 + 0.45 * a, 0.90, 0.82);
  gfx_rect(x, y1 - a * (y1 - y0), max(1, barw - 2), a * (y1 - y0), 1);

  gfx_set(0.95, 0.35, 0.20, 0.90);
  gfx_rect(x, y1 - gr * (y1 - y0), max(1, barw - 2), 2 + gr * (y1 - y0) * 0.08, 1);

  gfx_set(0.35, 0.95, 0.55, 0.80);
  gfx_rect(x, y1 - sm * (y1 - y0), max(1, barw - 2), 2, 1);

  i += 1;
);

gfx_set(0.55, 0.55, 0.55, 1);
gfx_line(x0, y1, x1, y1, 1);

gfx_x = 14; gfx_y = 156;
gfx_set(0.80, 0.80, 0.80, 1);
gfx_drawstr("Bus motion from peers:  Pressure "); gfx_drawnumber(bus_pressure * 100, 0); gfx_drawstr("%   Contact "); gfx_drawnumber(bus_contact * 100, 0); gfx_drawstr("%   Viscosity "); gfx_drawnumber(bus_viscosity * 100, 0); gfx_drawstr("%");

gfx_x = 14; gfx_y = 178;
gfx_drawstr("                         Thrust "); gfx_drawnumber(bus_thrust * 100, 0); gfx_drawstr("%   Arousal "); gfx_drawnumber(bus_arousal * 100, 0); gfx_drawstr("%   Fatigue "); gfx_drawnumber(bus_fatigue * 100, 0); gfx_drawstr("%");

gfx_x = 14; gfx_y = 206;
gfx_drawstr("This track drives: P "); gfx_drawnumber(local_pressure * 100, 0); gfx_drawstr("  C "); gfx_drawnumber(local_contact * 100, 0); gfx_drawstr("  V "); gfx_drawnumber(local_viscosity * 100, 0); gfx_drawstr("  T "); gfx_drawnumber(local_thrust * 100, 0);

gfx_x = 14; gfx_y = 232;
gfx_set(0.80, 0.80, 0.80, 1);
gfx_drawstr("TurnPulse manifold: rank "); gfx_drawnumber(my_rank + 1, 0); gfx_drawstr("/"); gfx_drawnumber(active_instances, 0);
gfx_drawstr("  pulse "); gfx_drawnumber(pistonPulse * 100, 0); gfx_drawstr("%  gate "); gfx_drawnumber(pistonGate * 100, 0); gfx_drawstr("%  width "); gfx_drawnumber(pistonTargetWidth * 100, 2); gfx_drawstr("%  swap "); gfx_drawnumber(piston_swap_on, 0);

gfx_x = 14; gfx_y = 266;
gfx_set(0.70, 0.70, 0.70, 1);
gfx_drawstr("Blue=local broad-band activity. Orange=TurnPulse-shaped declutter yield. Green=somatic peer modulation. Width is M/S-capped below +/-1%.");
