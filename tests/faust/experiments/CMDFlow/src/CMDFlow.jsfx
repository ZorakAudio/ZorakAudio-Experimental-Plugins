cf_e10=0;
cf_e11=0;
cf_a0=1-exp(-2*$pi*min(80,srate*.42)/srate);
cf_a1=1-exp(-2*$pi*min(135.891717171,srate*.42)/srate);
cf_a2=1-exp(-2*$pi*min(230.831984945,srate*.42)/srate);
cf_a3=1-exp(-2*$pi*min(392.101935152,srate*.42)/srate);
cf_a4=1-exp(-2*$pi*min(666.042565921,srate*.42)/srate);
cf_a5=1-exp(-2*$pi*min(1131.3708499,srate*.42)/srate);
cf_a6=1-exp(-2*$pi*min(1921.79909437,srate*.42)/srate);
cf_a7=1-exp(-2*$pi*min(3264.45723739,srate*.42)/srate);
cf_a8=1-exp(-2*$pi*min(5545.15874524,srate*.42)/srate);
cf_a9=1-exp(-2*$pi*min(9419.26429844,srate*.42)/srate);
cf_a10=1-exp(-2*$pi*min(16000,srate*.42)/srate);

@slider
cf_policy_time=.020;
setup_from_sliders();
// Re-bind the shared endpoint when the string bus name changes.
