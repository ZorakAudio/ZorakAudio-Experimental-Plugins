    8 | "l\n// #HELP: Use a traditional multisampler when you need exact key zones, velocity-layer authoring, or realistic note-by-note recreation.\n// #HELP:\n// #HELP: ## In one sentence\n// #HELP: Sample turns a loose bank of audio files into a playable, variable instrument with almost no setup.\n\nslider1:0<0,1,1{idle,rescan}>--Force rescan slot 0\nslider2:3<0.1,500,0.1>--Attack (ms)\nslider3:110<1,5000,1>--Decay (ms)\nslider4:0.82<0,1,0.001>--Sustain level\nslider5:180<5,5000,1>--Release (ms)\nslider6:0<-18,18,0.1>--Color Tilt (dB)\nslider7:0<-1,1,0.001>--Focus (-softer / +clearer)\nslider8:0.18<0,1,0.001>--Width\nslider9:0.22<0,1,0.001>--Liveliness\nslider10:0.30<0,1,0.001>--Truth (0=matched / 1=raw)\nslider11:-9<-24,12,0.1>--Output (dB)\nslider12:0<-24,24,0.01>--Pitch (semitones)\nslider13:0<0,2,1{random,sequence,walk}>--Selection mode\nslider14:1<1,4,0.001>--Stretch (x)\nslider15:0<0,1,0.001>--Weight\nslider16:0<0,2,1{auto,punch,off}>--Transient mode\nslider17:1<0,3,1{raw,tape,hybrid,granular}>--Playback mode\nslider18:0.55<0,1,0.001>--Grain\nslider19:0.35<0,1,0.001>--Spice\nslider20:20<0,2000,1>--Hold (ms)\nslider21:0<0,1,1{stereo,mono}>--Mono Source\nslider22:0<0,1,0.001>--Dynamics\nslider23:0<0,1,1{classic,gaussian}>--Onset align mode\nslider24:0<0,65536,256>--Bank RAM Budget (MB, 0=unlimited)\nslider25:0<0,1,0.001>--Clean\nslider26:0<0,1,0.001>--Room Tame\nslider27:0<0,100,0.1>--Anti-Salience Mix (%)\nslider28:100<-100,100,1>--Attack slope (%)\nslider29:-100<-100,100,1>--Decay slope (%)\nslider30:-100<-100,100,1>--Release slope (%)\nslider31:-1<-3,117648,1>--Hidden EQ Drives HPF/B1/B2 (-2=import v60; -3=import v61+)\nslider32:0<-18,18,0.1>--EQ Band 1 Gain (dB)\nslider33:0<-18,18,0.1>--EQ Band 2 Gain (dB)\nslider34:0<-18,18,0.1>--EQ Band 3 Gain (dB)\nslider35:120<20,20000,1>--EQ Band 1 Freq (Hz)\nslider36:950<20,20000,1>--EQ Band 2 Freq (Hz)\nslider37:6500<20,20000,1>--EQ Band 3 Freq (Hz)\nslider38:20<20,1000,1>--EQ HPF (Hz)\nslider39:20000<1000,20000,1>--EQ LPF (Hz)\nslider40:1.15<0.35,8,0.01>--EQ Band 1 Q\nslider41:1.15<0.35,8,0.01>--EQ Band 2 Q\nslider42:1.15<0.35,8,0.01>--EQ Band 3 Q\nslider43:1<0,4,1{6,12,24,36,48}>--EQ HPF Slope\nslider44:1<0,4,1{6,12,24,36,48}>--EQ LPF Slope\nslider45:0.707<0.35,4,0.001>--EQ HPF Q\nslider46:0.707<0.35,4,0.001>--EQ LPF Q\nslider47:0<-12,12,0.01>--Hidden Formant Shift\nslider48:1<0,1,0.001>--Hidden Tail Grace\nslider49:0<-1,1,0.001>--Hidden Peak Pack\nslider50:0<0,1,0.001>--Universal Contour Aggression\nslider51:0<0,1,0.001>--Hidden Edge Melt\nslider52:0<0,1,0.001>--Hidden Clean DeCrust\nslider53:0<0,1,0.001>--Hidden Space Amount\nslider54:0.5<0,1,0.001>--Hidden Space Character\nslider55:0<0,1,0.001>--Hidden Harmonics\nslider56:0<0,1,0.001>--Hidden PopCue\nslider57:0<0,1,1{manual,auto}>--Auto Smooth A/R\nslider58:0<0,2400,1>--Hidden EQ Drives B3/LPF\nslider59:0<0,4820,1>--Anti-Salience Profile + Thrill\nslider60:1000<-20000,20000,1>--Hidden Color Pivot (Hz; negative=Auto)\nslider61:1<0,1,0.001>--Hidden Pitch Mix\nslider62:0<0,242,1>--Hidden EQ Character Pack\nslider63:0<0,812990017200,1>--Legacy EQ Drive Import (retained)\nslider64:6<0,60,0.1>--Hidden Source Expand Depth (dB)\n@init\nza_char_drive0=-1;\nza_char_drive1=-1;\nza_char_drive2=-1;\nza_char_drive3=-1;\nza_char_drive4=-1;\nza_harm_amount=-1;\n// Sample v71 embedded Anti-Salience MX; source: Anti-Salience MX v1.1.0 supplied 2026-09-16.\n// 20 profiles: 1 + source_profile*4 + preset. Index 0 Legacy is owned by Sample.\n// Source-only integration: no external reference detector, standalone UI diagnostics, or trim.\n// All helpers belong to @init. See AntiSalience_Integration_v71.md for lifecycle and compatibility.\nfunction sa_clampv(sa_x,sa_lo,sa_hi) (\n    sa_x<sa_lo ? sa_lo : (sa_x>sa_hi ? sa_hi : sa_x);\n  );\n\nfunction sa_clamp01(sa_x) (\n    sa_clampv(sa_x,0,1);\n  );\n\nfunction sa_db2amp(sa_x) (\n    pow(10,sa_x/20);\n  );\n\nfunction sa_denorm(sa_x) (\n    abs(sa_x)<0.000000000000000001 ? 0 : sa_x;\n  );\n\nfunction sa_r"
