// Refresh restored/automated distance readouts even before audio starts.
last_dist_m = p3d_distance_m_from_n(p3d_clamp(slider7,0,1));
last_far01 = p3d_far01_from_m(last_dist_m);

@block
// --- raw UI targets ---
tgt_lat = slider6;
tgt_lat < -1 ? tgt_lat = -1;
tgt_lat > 1 ? tgt_lat = 1;

tgt_dist_n = slider7;
tgt_dist_n < 0 ? tgt_dist_n = 0;
tgt_dist_n > 1 ? tgt_dist_n = 1;

tgt_fb = slider8;
tgt_fb < -1 ? tgt_fb = -1;
tgt_fb > 1 ? tgt_fb = 1;

tgt_throw = slider9;
tgt_throw < 0 ? tgt_throw = 0;
tgt_throw > 1 ? tgt_throw = 1;

tgt_width = slider10;
tgt_width < 0 ? tgt_width = 0;
tgt_width > 1 ? tgt_width = 1;

tgt_ext = slider11;
tgt_ext < 0 ? tgt_ext = 0;
tgt_ext > 1 ? tgt_ext = 1;

tgt_room = slider12;
tgt_room < 0 ? tgt_room = 0;
tgt_room > 1 ? tgt_room = 1;

tgt_elev = slider21;
tgt_elev < -1 ? tgt_elev = -1;
tgt_elev > 1 ? tgt_elev = 1;

tgt_source_mode = floor(slider22 + 0.5);
tgt_source_mode < 0 ? tgt_source_mode = 0;
tgt_source_mode > 3 ? tgt_source_mode = 3;
last_input_mode = tgt_source_mode;

tgt_in_width = slider23;
tgt_in_width < 0 ? tgt_in_width = 0;
tgt_in_width > 1 ? tgt_in_width = 1;
last_input_width_preserve = tgt_in_width;

tgt_bed_anchor = slider24;
tgt_bed_anchor < 0 ? tgt_bed_anchor = 0;
tgt_bed_anchor > 1 ? tgt_bed_anchor = 1;
last_bed_anchor = tgt_bed_anchor;

tgt_occ = slider13;
tgt_occ < 0 ? tgt_occ = 0;
tgt_occ > 1 ? tgt_occ = 1;

tgt_motion = slider14;
tgt_motion < 0 ? tgt_motion = 0;
tgt_motion > 1 ? tgt_motion = 1;

tgt_trim = 10^(slider15/20);

auto_safe = slider16 >= 0.5 ? 1 : 0;
last_automation_safe = auto_safe;

cue_curve_user = slider17;
cue_curve_user < 1 ? cue_curve_user = 1;
cue_curve_user > 3 ? cue_curve_user = 3;

smooth_ms = slider18;
smooth_ms < 5 ? smooth_ms = 5;
auto_safe && smooth_ms < 90 ? smooth_ms = 90;
last_smooth_ms = smooth_ms;
smooth_k = 1 - exp(-1/((smooth_ms*0.001)*srate));
coeff_ms = smooth_ms * 1.55;
coeff_ms < 15 ? coeff_ms = 15;
coeff_k = 1 - exp(-1/((coeff_ms*0.001)*srate));
meter_k  = 1 - exp(-1/(0.050*srate));

tgt_rsize = slider19;
tgt_rsize < 0 ? tgt_rsize = 0;
tgt_rsize > 1 ? tgt_rsize = 1;

// --- visual coordinate normalization ---
pos_r = sqrt(tgt_lat*tgt_lat + tgt_fb*tgt_fb);
(pos_r > 1) ? (
  vis_lat = tgt_lat / pos_r;
  vis_fb = tgt_fb / pos_r;
  pos_r = 1;
) : (
  vis_lat = tgt_lat;
  vis_fb = tgt_fb;
);

// If object is dead-center, treat it as front-center so cue math stays stable.
pos_r < 0.0001 ? (
  raw_side = 0;
  raw_front = 1;
) : (
  raw_side = vis_lat / pos_r;
  raw_front = vis_fb / pos_r;
);

// Visual angle readout, preserving V5 convention: negative = left, positive = right.
vis_ang = atan(raw_side / (abs(raw_front) + 0.000000000000000001)) * 180 / $pi;
(raw_front < 0) ? (
  raw_side >= 0 ? vis_ang = 180 - vis_ang : vis_ang = -180 - vis_ang;
);
last_visual_az = vis_ang;
last_lat = vis_lat;
last_fb = vis_fb;

// Spatial Throw becomes the cue-stack intensity. Automation Safe caps it.
throw_dsp = tgt_throw;
auto_safe && throw_dsp > 0.72 ? throw_dsp = 0.72;
last_throw = tgt_throw;
last_throw_dsp = throw_dsp;

// Cardinal-preserving continuous angular compression. Throw changes strength,
// never reconstructs a discontinuous front sign from a reduced side component.
curve_eff = 1+(1-throw_dsp)*(cue_curve_user-1);
last_cue_curve_eff = curve_eff;
cue_side = sign(raw_side)*abs(raw_side)^curve_eff;
cue_front = sign(raw_front)*abs(raw_front)^curve_eff;
cue_norm = sqrt(cue_side*cue_side+cue_front*cue_front);
cue_norm > 0.000001 ? (cue_side/=cue_norm; cue_front/=cue_norm;) : (cue_side=0; cue_front=1;);

tgt_cue_side = cue_side;
tgt_cue_front = cue_front;
cue_ang = p3d_angle_from_components(cue_side, cue_front);
tgt_az = cue_ang;
last_cue_az = cue_ang;

// Distance mapping: preserve the local near-to-far response.
// V6.13 separates perceptual meters from normalized DSP distance. The room, width and nearfield laws stay 0..1;
// far-field cues use a log-distance weight so 10 m reads distant and 80+ m stays clear instead of just wet.
tgt_dist_calc = tgt_dist_n;
tgt_dist_calc < 0 ? tgt_dist_calc = 0;
tgt_dist_calc > 4 ? tgt_dist_calc = 4;
tgt_depth = tgt_dist_calc;
tgt_depth > 1 ? tgt_depth = 1;
_depth2 = tgt_depth*tgt_depth;
_depth3 = _depth2*tgt_depth;
dist_m = p3d_distance_m_from_n(tgt_dist_calc);
last_dist_m = dist_m;
tgt_far01 = p3d_far01_from_m(dist_m);
last_far01 = tgt_far01;

// Direct gain vs distance/occlusion. Allow real far-field attenuation below the old -18 dB floor.
_direct_g = 1 / (1 + 0.18*dist_m + 0.0035*dist_m*dist_m);
_direct_g *= 1 - 0.28*tgt_occ;
_direct_floor = 0.014 + 0.096*(1 - tgt_far01)*(1 - tgt_far01);
_direct_g < _direct_floor ? _direct_g = _direct_floor;
tgt_direct_g = _direct_g;

// Room gain vs distance + occlusion. Far distance is carried by level/spectrum/detail, not by runaway wetness.
_er_far_trim = 1 - 0.58*tgt_far01;
_er_far_trim < 0.38 ? _er_far_trim = 0.38;
_er_g = tgt_room * (0.035 + 0.14*tgt_depth + 0.06*_depth2);
_er_g *= _er_far_trim;
_er_g *= 1 + 0.60*tgt_occ;
tgt_er_g = _er_g;

// Air absorption cutoff: log-distance driven, so 10 m is clear-but-far and 80 m is darkened without turning into mud.
air_fc = 19000 * (1 - 0.68*tgt_far01) / (1 + 1.25*tgt_occ);
air_fc < 2800 ? air_fc = 2800;
air_fc > 19000 ? air_fc = 19000;
last_air_fc = air_fc;
tgt_air_a = exp(-2*$pi*air_fc/srate);

// Occlusion cutoff
occ_fc = 13000 / (1 + 18*tgt_occ*tgt_occ);
occ_fc < 450 ? occ_fc = 450;
occ_fc > 13000 ? occ_fc = 13000;
tgt_occ_a = exp(-2*$pi*occ_fc/srate);

// Room geometry (for early reflections + UI readout)
room_curve = tgt_rsize*tgt_rsize*(0.72 + 0.28*tgt_rsize);
room_w = 2.8 + 9.8*room_curve;
room_d = 3.3 + 12.2*room_curve;
last_room_w = room_w;
last_room_d = room_d;

// Reflection delays from a simple image-source style room.
// Uses visual object coordinate, not compressed cue angle, so the room picture remains honest.
src_nx = 0.74 * vis_lat;
src_ny = 0.74 * vis_fb;

hw = room_w * 0.5;
hd = room_d * 0.5;

direct_geom = sqrt((src_nx*hw)*(src_nx*hw) + (src_ny*hd)*(src_ny*hd));
direct_geom < 0.08 ? direct_geom = 0.08;

len_l  = sqrt(((-2 - src_nx)*hw)*((-2 - src_nx)*hw) + ((src_ny)*hd)*((src_ny)*hd));
len_r  = sqrt((( (2 - src_nx)*hw))*(((2 - src_nx)*hw)) + ((src_ny)*hd)*((src_ny)*hd));
len_f  = sqrt(((src_nx*hw)*(src_nx*hw)) + (((2 - src_ny)*hd)*((2 - src_ny)*hd)));
len_b  = sqrt(((src_nx*hw)*(src_nx*hw)) + (((-2 - src_ny)*hd)*((-2 - src_ny)*hd)));
len_fl = sqrt(((-2 - src_nx)*hw)*((-2 - src_nx)*hw) + (((2 - src_ny)*hd)*((2 - src_ny)*hd)));
len_fr = sqrt((((2 - src_nx)*hw))*(((2 - src_nx)*hw)) + (((2 - src_ny)*hd)*((2 - src_ny)*hd)));
len_bl = sqrt(((-2 - src_nx)*hw)*((-2 - src_nx)*hw) + (((-2 - src_ny)*hd)*((-2 - src_ny)*hd)));
len_br = sqrt((((2 - src_nx)*hw))*(((2 - src_nx)*hw)) + (((-2 - src_ny)*hd)*((-2 - src_ny)*hd)));

ms_scale = 1000/343;
base_ms = 0.8 + 1.4*tgt_depth + 1.4*tgt_far01 + 0.6*tgt_room;

d1 = base_ms + max(1.0, (len_l  - direct_geom) * ms_scale);
d2 = base_ms + max(1.0, (len_r  - direct_geom) * ms_scale);
d3 = base_ms + max(1.0, (len_f  - direct_geom) * ms_scale);
d4 = base_ms + max(1.2, (len_b  - direct_geom) * ms_scale);
d5 = base_ms + max(1.5, (len_fl - direct_geom) * ms_scale);
d6 = base_ms + max(1.5, (len_fr - direct_geom) * ms_scale);
d7 = base_ms + max(1.8, (len_bl - direct_geom) * ms_scale);
d8 = base_ms + max(1.8, (len_br - direct_geom) * ms_scale);

tgt_er1_d = d1 * srate * 0.001;
tgt_er2_d = d2 * srate * 0.001;
tgt_er3_d = d3 * srate * 0.001;
tgt_er4_d = d4 * srate * 0.001;
tgt_er5_d = d5 * srate * 0.001;
tgt_er6_d = d6 * srate * 0.001;
tgt_er7_d = d7 * srate * 0.001;
tgt_er8_d = d8 * srate * 0.001;

// Reflection LPFs get darker with perceived distance + occlusion, but not linearly with meters.
hf_scale = (1 - 0.55*tgt_far01) / (1 + 1.1*tgt_occ);

c1 = 11800*hf_scale; c2 = 11800*hf_scale; c3 = 10200*hf_scale; c4 = 7200*hf_scale;
c5 = 7600*hf_scale;  c6 = 7600*hf_scale;  c7 = 5200*hf_scale; c8 = 5200*hf_scale;

c1 < 1500 ? c1=1500; c2 < 1500 ? c2=1500; c3 < 1500 ? c3=1500; c4 < 1500 ? c4=1500;
c5 < 1500 ? c5=1500; c6 < 1500 ? c6=1500; c7 < 1500 ? c7=1500; c8 < 1500 ? c8=1500;

c1 > 18000 ? c1=18000; c2 > 18000 ? c2=18000; c3 > 18000 ? c3=18000; c4 > 18000 ? c4=18000;
c5 > 18000 ? c5=18000; c6 > 18000 ? c6=18000; c7 > 18000 ? c7=18000; c8 > 18000 ? c8=18000;

er_t_a1 = exp(-2*$pi*c1/srate);
er_t_a2 = exp(-2*$pi*c2/srate);
er_t_a3 = exp(-2*$pi*c3/srate);
er_t_a4 = exp(-2*$pi*c4/srate);
er_t_a5 = exp(-2*$pi*c5/srate);
er_t_a6 = exp(-2*$pi*c6/srate);
er_t_a7 = exp(-2*$pi*c7/srate);
er_t_a8 = exp(-2*$pi*c8/srate);

// --- Pinna externalize biquad (negative peaking EQ = notch hint) ---
// Use cue vector components, not raw angle trig, so rear-center does not depend
// on the arbitrary sign of +180/-180.
az_s = tgt_cue_side;
az_c = tgt_cue_front;
az_abs = abs(az_s);
front = max(0, az_c);
rear = max(0, -az_c);
side = 1 - abs(az_c);
side < 0 ? side = 0;
last_rear = rear;
last_front = front;
last_side = side;
last_back = rear;

focus = 1 - 0.74*tgt_width;
focus < 0.18 ? focus = 0.18;
last_focus = focus;
last_shadow = az_abs * focus;

// semantic zone weighting:
// front = cleaner / tighter
// side  = stronger lateral lock
// back  = darker / more notch / wider reflections
zone_notch = 0.70 + 0.55*side + 0.85*rear;
dist_focus = 1 - 0.34*tgt_far01;
dist_focus < 0.58 ? dist_focus = 0.58;
notch_db = -6.8 * tgt_ext * (0.18 + 0.82*az_abs) * zone_notch * focus * dist_focus;
last_ext_db = notch_db;

Q = 3.0 + 2.6*tgt_ext;

elev_up = max(0,tgt_elev); elev_down = max(0,-tgt_elev); elev_abs = abs(tgt_elev);
base_fc = 7150 + 220*front - 650*side - 1250*rear + 620*elev_up - 380*elev_down;
span_fc = (1700 + 450*side + 250*rear + 260*elev_abs) * focus;

fc_l = base_fc - span_fc*az_s;
fc_r = base_fc + span_fc*az_s;

// Fade unavailable pinna bands before Nyquist; never fold a notch into a boost.
pinna_available = p3d_clamp((0.48*srate-max(fc_l,fc_r))/2000,0,1);
notch_db *= pinna_available;
fc_l = min(max(20,fc_l),0.45*srate);
fc_r = min(max(20,fc_r),0.45*srate);

abs(notch_db) < 0.001 ? (
  pn_t_b0_l = 1; pn_t_b1_l = 0; pn_t_b2_l = 0; pn_t_a1_l = 0; pn_t_a2_l = 0;
  pn_t_b0_r = 1; pn_t_b1_r = 0; pn_t_b2_r = 0; pn_t_a1_r = 0; pn_t_a2_r = 0;
) : (
  A = 10^(notch_db/40);

  // Left
  w0 = 2*$pi*fc_l/srate;
  cs = cos(w0);
  sn = sin(w0);
  alpha = sn/(2*Q);
  b0 = 1 + alpha*A;
  b1 = -2*cs;
  b2 = 1 - alpha*A;
  a0 = 1 + alpha/A;
  a1 = -2*cs;
  a2 = 1 - alpha/A;
  b0 /= a0; b1 /= a0; b2 /= a0; a1 /= a0; a2 /= a0;
  pn_t_b0_l = b0; pn_t_b1_l = b1; pn_t_b2_l = b2; pn_t_a1_l = a1; pn_t_a2_l = a2;

  // Right
  w0 = 2*$pi*fc_r/srate;
  cs = cos(w0);
  sn = sin(w0);
  alpha = sn/(2*Q);
  b0 = 1 + alpha*A;
  b1 = -2*cs;
  b2 = 1 - alpha*A;
  a0 = 1 + alpha/A;
  a1 = -2*cs;
  a2 = 1 - alpha/A;
  b0 /= a0; b1 /= a0; b2 /= a0; a1 /= a0; a2 /= a0;
  pn_t_b0_r = b0; pn_t_b1_r = b1; pn_t_b2_r = b2; pn_t_a1_r = a1; pn_t_a2_r = a2;
);

// Rear tint targets (very gentle, only when push out is up)
rear_t_mix = (0.08*side + 0.34*rear) * tgt_ext;
rear_fc = 18000 / (1 + 1.2*side*tgt_ext + 2.8*rear*tgt_ext);
rear_fc < 2300 ? rear_fc = 2300;
rear_fc > 18000 ? rear_fc = 18000;
rear_t_a = exp(-2*$pi*rear_fc/srate);

// SceneVerb always uses this instance's local macros.
sv_late = slider27;
sv_size = slider28;
sv_protect = slider29;

sv_late < 0 ? sv_late = 0; sv_late > 1 ? sv_late = 1;
sv_size < 0 ? sv_size = 0; sv_size > 1 ? sv_size = 1;
sv_protect < 0 ? sv_protect = 0; sv_protect > 1 ? sv_protect = 1;

// Three macro model:
//   Late Field = amount / activation.
//   Space Size = delay spread + decay + width.
//   Protect    = low-end protection + ducking + damping safety.
sv_damp_amt = (0.26 + 0.56*sv_protect);
sv_lowprotect = (0.56 + 0.43*sv_protect);
sv_duck_amt = (0.20 + 0.74*sv_protect);
sv_damp_amt < 0 ? sv_damp_amt = 0; sv_damp_amt > 1 ? sv_damp_amt = 1;
sv_lowprotect < 0 ? sv_lowprotect = 0; sv_lowprotect > 1 ? sv_lowprotect = 1;
sv_duck_amt < 0 ? sv_duck_amt = 0; sv_duck_amt > 1 ? sv_duck_amt = 1;

sv_on_target = sv_late > 0.00001;
(
  sv_role = floor(slider32 + 0.5);
  sv_send = sv_late;
  sv_decay = 0.38 + 0.36*sv_size;
  sv_width = 0.46 + 0.42*sv_size;

  // Role modifiers: inert unless SceneVerb Lite is active.
  sv_role == 1 ? ( // Vocal
    sv_send *= 0.58; sv_duck_amt = max(sv_duck_amt, 0.72); sv_lowprotect = max(sv_lowprotect, 0.86); sv_decay *= 0.86;
  ) : sv_role == 2 ? ( // Impact
    sv_send *= 0.42; sv_duck_amt = max(sv_duck_amt, 0.86); sv_lowprotect = max(sv_lowprotect, 0.94); sv_decay *= 0.68;
  ) : sv_role == 3 ? ( // Wet_Internal
    sv_send *= 0.75; sv_damp_amt = max(sv_damp_amt, 0.62); sv_decay *= 0.78; sv_width *= 0.82;
  ) : sv_role == 4 ? ( // Wet_External
    sv_send *= 1.08; sv_damp_amt *= 0.82; sv_width *= 1.10;
  ) : sv_role == 5 ? ( // Ambience
    sv_send *= 1.18; sv_decay *= 1.10; sv_width *= 1.16; sv_duck_amt *= 0.70;
  );
  sv_width > 1 ? sv_width = 1;
  sv_trim_db = slider33;

  // Role limits are calculated at block rate; bypassed tanks do not advance audio state.
  sv_role == 1 ? ( // Vocal: close, clean, clear.
    sv_send > 0.34 ? sv_send = 0.34;
    sv_decay > 0.60 ? sv_decay = 0.60;
    sv_width > 0.66 ? sv_width = 0.66;
    sv_lowprotect < 0.90 ? sv_lowprotect = 0.90;
    sv_duck_amt < 0.78 ? sv_duck_amt = 0.78;
    sv_trim_db > 6 ? sv_trim_db = 6;
  ) : sv_role == 2 ? ( // Impact: bloom only, no low-end fog.
    sv_send > 0.22 ? sv_send = 0.22;
    sv_decay > 0.50 ? sv_decay = 0.50;
    sv_width > 0.58 ? sv_width = 0.58;
    sv_lowprotect < 0.96 ? sv_lowprotect = 0.96;
    sv_duck_amt < 0.90 ? sv_duck_amt = 0.90;
    sv_trim_db > 4 ? sv_trim_db = 4;
  ) : sv_role == 3 ? ( // Wet_Internal: dark, short, body-adjacent.
    sv_send > 0.48 ? sv_send = 0.48;
    sv_decay > 0.62 ? sv_decay = 0.62;
    sv_width > 0.68 ? sv_width = 0.68;
    sv_damp_amt < 0.64 ? sv_damp_amt = 0.64;
    sv_lowprotect < 0.82 ? sv_lowprotect = 0.82;
    sv_duck_amt < 0.52 ? sv_duck_amt = 0.52;
    sv_trim_db > 7 ? sv_trim_db = 7;
  ) : sv_role == 4 ? ( // Wet_External: brighter/wider but still bounded.
    sv_send > 0.68 ? sv_send = 0.68;
    sv_decay > 0.76 ? sv_decay = 0.76;
    sv_width > 0.92 ? sv_width = 0.92;
    sv_lowprotect < 0.68 ? sv_lowprotect = 0.68;
    sv_duck_amt < 0.34 ? sv_duck_amt = 0.34;
    sv_trim_db > 8 ? sv_trim_db = 8;
  ) : sv_role == 5 ? ( // Ambience: largest safe halo.
    sv_send > 0.80 ? sv_send = 0.80;
    sv_decay > 0.84 ? sv_decay = 0.84;
    sv_width > 0.98 ? sv_width = 0.98;
    sv_lowprotect < 0.55 ? sv_lowprotect = 0.55;
    sv_duck_amt < 0.18 ? sv_duck_amt = 0.18;
    sv_trim_db > 9 ? sv_trim_db = 9;
  ) : ( // Generic: conservative neutral depth.
    sv_send > 0.56 ? sv_send = 0.56;
    sv_decay > 0.72 ? sv_decay = 0.72;
    sv_width > 0.86 ? sv_width = 0.86;
    sv_lowprotect < 0.72 ? sv_lowprotect = 0.72;
    sv_duck_amt < 0.36 ? sv_duck_amt = 0.36;
    sv_trim_db > 6 ? sv_trim_db = 6;
  );

  sv_hp_fc = 70+260*sv_lowprotect;
  sv_t_hp_a=exp(-2*$pi*sv_hp_fc/srate);
  sv_damp_fc=2400+(1-sv_damp_amt)*9800;
  sv_t_damp_a=exp(-2*$pi*sv_damp_fc/srate);
  sv_t_send=sv_send; sv_t_decay=sv_decay; sv_t_width=sv_width;
  sv_t_duck=sv_duck_amt; sv_t_trim=10^(sv_trim_db/20);
  sv_t_d1=(0.031+0.067*sv_size)*srate;
  sv_t_d2=(0.047+0.083*sv_size)*srate;
  sv_t_d3=(0.071+0.121*sv_size)*srate;
  sv_t_d4=(0.103+0.163*sv_size)*srate;
);
// Finish each reader transition before accepting its latest pending destination.
sv_xfade >= 1 ? (
  sv_old_d1=sv_d1; sv_old_d2=sv_d2; sv_old_d3=sv_d3; sv_old_d4=sv_d4;
  sv_d1=sv_t_d1; sv_d2=sv_t_d2; sv_d3=sv_t_d3; sv_d4=sv_t_d4;
  (abs(sv_d1-sv_old_d1)+abs(sv_d2-sv_old_d2)+abs(sv_d3-sv_old_d3)+abs(sv_d4-sv_old_d4))>0.00001 ? sv_xfade=0;
);

// Physical targets do not use artistic angle compression.
p7_model=slider36>=.5;
p7_t_distance_gain=p3d_clamp(slider38,0,1);
p7_t_travel=slider39>=.5;p7_t_air=p3d_clamp(slider40,0,1);
p7_t_profile=slider37<.5 ? .92 : slider37<1.5 ? 1 : 1.08;
p7_t_room_height=p3d_clamp(slider44,2,24);
p7_t_ear_height=p3d_clamp(slider45,.4,2.2);
p71_target_az=p71_pan_angle(raw_side,raw_front,cue_curve_user);
p7_phi=tgt_elev*$pi*.5;
p7_t_x=dist_m*cos(p7_phi)*raw_side;
p7_t_y=dist_m*cos(p7_phi)*raw_front;
p7_t_z=dist_m*sin(p7_phi);
p7_ay=p3d_clamp(slider41,-180,180)*$pi/360;
p7_ap=p3d_clamp(slider42,-90,90)*$pi/360;
p7_ar=p3d_clamp(slider43,-180,180)*$pi/360;
p7_cy=cos(p7_ay);p7_sy=sin(p7_ay);p7_cp=cos(p7_ap);p7_sp=sin(p7_ap);p7_cr=cos(p7_ar);p7_sr=sin(p7_ar);
p7_t_qw=p7_cy*p7_cp*p7_cr+p7_sy*p7_sp*p7_sr;
p7_t_qx=p7_cy*p7_sp*p7_cr+p7_sy*p7_cp*p7_sr;
p7_t_qy=p7_cy*p7_cp*p7_sr-p7_sy*p7_sp*p7_cr;
p7_t_qz=p7_cy*p7_sp*p7_sr-p7_sy*p7_cp*p7_cr;
p7_t_qw*p7_sm_qw+p7_t_qx*p7_sm_qx+p7_t_qy*p7_sm_qy+p7_t_qz*p7_sm_qz<0 ? (p7_t_qw=-p7_t_qw;p7_t_qx=-p7_t_qx;p7_t_qy=-p7_t_qy;p7_t_qz=-p7_t_qz;);

// Initialize from saved targets before processing the first sample.
seed_pending ? (
  sm_cue_side=tgt_cue_side;
  sm_cue_front=tgt_cue_front;
  sm_depth=tgt_depth;
  sm_far=tgt_far01;
  sm_width=tgt_width;
  sm_ext=tgt_ext;
  sm_room=tgt_room;
  sm_elev=tgt_elev;
  sm_in_width=tgt_in_width;
  sm_bed_anchor=tgt_bed_anchor;
  sm_rsize=tgt_rsize;
  sm_occ=tgt_occ;
  sm_motion=tgt_motion;
  sm_trim=tgt_trim;
  sm_direct_g=tgt_direct_g;
  sm_er_g=tgt_er_g;
  sm_air_a=tgt_air_a;
  sm_occ_a=tgt_occ_a;
  sm_er1_d=tgt_er1_d;
  sm_er2_d=tgt_er2_d;
  sm_er3_d=tgt_er3_d;
  sm_er4_d=tgt_er4_d;
  sm_er5_d=tgt_er5_d;
  sm_er6_d=tgt_er6_d;
  sm_er7_d=tgt_er7_d;
  sm_er8_d=tgt_er8_d;
  pn_b0_l=pn_t_b0_l;
  pn_b1_l=pn_t_b1_l;
  pn_b2_l=pn_t_b2_l;
  pn_a1_l=pn_t_a1_l;
  pn_a2_l=pn_t_a2_l;
  pn_b0_r=pn_t_b0_r;
  pn_b1_r=pn_t_b1_r;
  pn_b2_r=pn_t_b2_r;
  pn_a1_r=pn_t_a1_r;
  pn_a2_r=pn_t_a2_r;
  rear_a=rear_t_a;
  rear_mix=rear_t_mix;
  sm_throw=throw_dsp;
  er_a1=er_t_a1;
  er_a2=er_t_a2;
  er_a3=er_t_a3;
  er_a4=er_t_a4;
  er_a5=er_t_a5;
  er_a6=er_t_a6;
  er_a7=er_t_a7;
  er_a8=er_t_a8;
  mode_w0 = tgt_source_mode==0;
  mode_w1 = tgt_source_mode==1;
  mode_w2 = tgt_source_mode==2;
  mode_w3 = tgt_source_mode==3;
  sv_s_send=sv_t_send;
  sv_s_decay=sv_t_decay;
  sv_s_width=sv_t_width;
  sv_s_duck=sv_t_duck;
  sv_s_trim=sv_t_trim;
  sv_s_hp_a=sv_t_hp_a;
  sv_s_damp_a=sv_t_damp_a;
  sv_d1=sv_t_d1; sv_old_d1=sv_d1;
  sv_d2=sv_t_d2; sv_old_d2=sv_d2;
  sv_d3=sv_t_d3; sv_old_d3=sv_d3;
  sv_d4=sv_t_d4; sv_old_d4=sv_d4;
  sv_xfade=1; sv_gate=sv_on_target; seed_pending=0;
);

samples_since_init==0 ? (
  p71_sm_az=p71_target_az;p71_sm_el=tgt_elev*90;p71_sm_range=dist_m;
  p7_sm_x=p7_t_x;
  p7_sm_y=p7_t_y;
  p7_sm_z=p7_t_z;
  p7_sm_qw=p7_t_qw;
  p7_sm_qx=p7_t_qx;
  p7_sm_qy=p7_t_qy;
  p7_sm_qz=p7_t_qz;
  p7_sm_distance_gain=p7_t_distance_gain;
  p7_sm_travel=p7_t_travel;
  p7_sm_air=p7_t_air;
  p7_sm_profile=p7_t_profile;
  p7_sm_room_height=p7_t_room_height;
  p7_sm_ear_height=p7_t_ear_height;
  p7_blend=p7_model;p7_capture=1;p7_geometry(1);p7_delay_phase=1;
);

@sample
// --- source input interpretation ---
// Mono Emitter keeps the legacy mono-first path. Stereo/Dual/Ambience modes
// preserve controlled side/field information around that point-source core.
in_l = spl0;
in_r = spl1;
input_mid = (in_l + in_r) * 0.5;
input_side = (in_l - in_r) * 0.5;
mono_in = input_mid;

// Input correlation meter: warns when Mono Emitter would collapse meaningful stereo material.
input_corr_l2 += (in_l*in_l - input_corr_l2) * meter_k;
input_corr_r2 += (in_r*in_r - input_corr_r2) * meter_k;
input_corr_lr += (in_l*in_r - input_corr_lr) * meter_k;
_corr_den = sqrt(input_corr_l2*input_corr_r2) + 0.000000000001;
last_input_corr = input_corr_lr / _corr_den;
last_input_corr < -1 ? last_input_corr = -1;
last_input_corr > 1 ? last_input_corr = 1;
last_source_warn = (tgt_source_mode == 0 && last_input_corr < 0.82) ? 1 : 0;

samples_since_init += 1;
// --- smooth user params ---
// Smooth the cue vector, not the wrapped azimuth angle.  Linear angle smoothing
// jumps at +/-180 and makes rear L/R moves or centered front/back moves sweep
// wildly through the wrong side.
sm_cue_side  += (tgt_cue_side  - sm_cue_side)  * smooth_k;
sm_cue_front += (tgt_cue_front - sm_cue_front) * smooth_k;
cue_side_s = p3d_clamp(sm_cue_side, -1, 1);
cue_front_s = p3d_clamp(sm_cue_front, -1, 1);
sm_depth  += (tgt_depth  - sm_depth)  * smooth_k;
sm_far    += (tgt_far01  - sm_far)    * smooth_k;
sm_width  += (tgt_width  - sm_width)  * smooth_k;
sm_ext    += (tgt_ext    - sm_ext)    * smooth_k;
sm_room   += (tgt_room   - sm_room)   * smooth_k;
sm_elev   += (tgt_elev   - sm_elev)   * smooth_k;
sm_in_width += (tgt_in_width - sm_in_width) * smooth_k;
sm_bed_anchor += (tgt_bed_anchor - sm_bed_anchor) * smooth_k;
sm_rsize  += (tgt_rsize  - sm_rsize)  * smooth_k;
sm_occ    += (tgt_occ    - sm_occ)    * smooth_k;
sm_motion += (tgt_motion - sm_motion) * smooth_k;
sm_trim   += (tgt_trim   - sm_trim)   * smooth_k;
sm_throw += (throw_dsp-sm_throw)*smooth_k;
mode_w0 += ((tgt_source_mode==0)-mode_w0)*sv_k;
mode_w1 += ((tgt_source_mode==1)-mode_w1)*sv_k;
mode_w2 += ((tgt_source_mode==2)-mode_w2)*sv_k;
mode_w3 += ((tgt_source_mode==3)-mode_w3)*sv_k;
er_a1 += (er_t_a1-er_a1)*coeff_k;
er_a2 += (er_t_a2-er_a2)*coeff_k;
er_a3 += (er_t_a3-er_a3)*coeff_k;
er_a4 += (er_t_a4-er_a4)*coeff_k;
er_a5 += (er_t_a5-er_a5)*coeff_k;
er_a6 += (er_t_a6-er_a6)*coeff_k;
er_a7 += (er_t_a7-er_a7)*coeff_k;
er_a8 += (er_t_a8-er_a8)*coeff_k;


// --- smooth derived ---
sm_direct_g += (tgt_direct_g - sm_direct_g) * smooth_k;
sm_er_g     += (tgt_er_g     - sm_er_g)     * smooth_k;
sm_air_a    += (tgt_air_a    - sm_air_a)    * coeff_k;
sm_occ_a    += (tgt_occ_a    - sm_occ_a)    * coeff_k;

sm_er1_d += (tgt_er1_d - sm_er1_d) * smooth_k;
sm_er2_d += (tgt_er2_d - sm_er2_d) * smooth_k;
sm_er3_d += (tgt_er3_d - sm_er3_d) * smooth_k;
sm_er4_d += (tgt_er4_d - sm_er4_d) * smooth_k;
sm_er5_d += (tgt_er5_d - sm_er5_d) * smooth_k;
sm_er6_d += (tgt_er6_d - sm_er6_d) * smooth_k;
sm_er7_d += (tgt_er7_d - sm_er7_d) * smooth_k;
sm_er8_d += (tgt_er8_d - sm_er8_d) * smooth_k;

// Smooth pinna biquad coefficients
pn_b0_l += (pn_t_b0_l - pn_b0_l) * coeff_k;
pn_b1_l += (pn_t_b1_l - pn_b1_l) * coeff_k;
pn_b2_l += (pn_t_b2_l - pn_b2_l) * coeff_k;
pn_a1_l += (pn_t_a1_l - pn_a1_l) * coeff_k;
pn_a2_l += (pn_t_a2_l - pn_a2_l) * coeff_k;

pn_b0_r += (pn_t_b0_r - pn_b0_r) * coeff_k;
pn_b1_r += (pn_t_b1_r - pn_b1_r) * coeff_k;
pn_b2_r += (pn_t_b2_r - pn_b2_r) * coeff_k;
pn_a1_r += (pn_t_a1_r - pn_a1_r) * coeff_k;
pn_a2_r += (pn_t_a2_r - pn_a2_r) * coeff_k;

rear_a   += (rear_t_a   - rear_a)   * coeff_k;
rear_mix += (rear_t_mix - rear_mix) * coeff_k;

p71_sm_az=p3d_wrap_deg(p71_sm_az+p3d_wrap_deg(p71_target_az-p71_sm_az)*smooth_k);
p71_sm_el+=(tgt_elev*90-p71_sm_el)*smooth_k;
p71_sm_range+=(dist_m-p71_sm_range)*smooth_k;
p7_sm_x+=(p7_t_x-p7_sm_x)*smooth_k;
p7_sm_y+=(p7_t_y-p7_sm_y)*smooth_k;
p7_sm_z+=(p7_t_z-p7_sm_z)*smooth_k;
p7_sm_qw+=(p7_t_qw-p7_sm_qw)*smooth_k;
p7_sm_qx+=(p7_t_qx-p7_sm_qx)*smooth_k;
p7_sm_qy+=(p7_t_qy-p7_sm_qy)*smooth_k;
p7_sm_qz+=(p7_t_qz-p7_sm_qz)*smooth_k;
p7_sm_distance_gain+=(p7_t_distance_gain-p7_sm_distance_gain)*smooth_k;
p7_sm_travel+=(p7_t_travel-p7_sm_travel)*smooth_k;
p7_sm_air+=(p7_t_air-p7_sm_air)*smooth_k;
p7_sm_profile+=(p7_t_profile-p7_sm_profile)*smooth_k;
p7_sm_room_height+=(p7_t_room_height-p7_sm_room_height)*smooth_k;
p7_sm_ear_height+=(p7_t_ear_height-p7_sm_ear_height)*smooth_k;
p7_late_delay+=(p7_late_target-p7_late_delay)*smooth_k;
p7_blend+=p3d_clamp(p7_model-p7_blend,-sv_gate_step,sv_gate_step);
p71_sm_room_weight+=(p71_room_weight-p71_sm_room_weight)*p7_coeff_k;
p7_filter_count=max(0,p7_filter_count-1);
p7_delay_phase=min(1,p7_delay_phase+p7_delay_step);
p7_running=p7_model || p7_blend>0;
p7_running ? (
  p7_control_count-=1;
  p7_control_count<=0 || !p7_was_running ? (
    p7_capture=p7_delay_phase>=1;
    p7_scene_change=abs(p71_sm_az-p7_prev_0)+abs(p71_sm_el-p7_prev_1)+abs(p71_sm_range-p7_prev_2)+abs(p7_sm_qw-p7_prev_3)+abs(p7_sm_qx-p7_prev_4)+abs(p7_sm_qy-p7_prev_5)+abs(p7_sm_qz-p7_prev_6)+abs(p7_sm_distance_gain-p7_prev_7)+abs(p7_sm_travel-p7_prev_8)+abs(p7_sm_air-p7_prev_9)+abs(p7_sm_profile-p7_prev_10)+abs(p7_sm_room_height-p7_prev_11)+abs(p7_sm_ear_height-p7_prev_12)+abs(sm_width-p7_prev_13)+abs(sm_rsize-p7_prev_14)+abs(sm_occ-p7_prev_15)+abs(sm_room-p7_prev_16)+abs(sm_throw-p7_prev_17)+abs(sm_ext-p7_prev_18)+abs(mode_w0-p7_prev_19)+abs(mode_w1-p7_prev_20)+abs(mode_w2-p7_prev_21)+abs(mode_w3-p7_prev_22)+abs(sv_t_d1-p7_prev_23);
    p7_scene_change>0.0000000001 || !p7_was_running || (p7_pending_geometry && p7_capture) ? (
      p7_geometry(!p7_was_running);
      p7_pending_geometry=!p7_capture;
      p7_prev_0=p71_sm_az;
      p7_prev_1=p71_sm_el;
      p7_prev_2=p71_sm_range;
      p7_prev_3=p7_sm_qw;
      p7_prev_4=p7_sm_qx;
      p7_prev_5=p7_sm_qy;
      p7_prev_6=p7_sm_qz;
      p7_prev_7=p7_sm_distance_gain;
      p7_prev_8=p7_sm_travel;
      p7_prev_9=p7_sm_air;
      p7_prev_10=p7_sm_profile;
      p7_prev_11=p7_sm_room_height;
      p7_prev_12=p7_sm_ear_height;
      p7_prev_13=sm_width;
      p7_prev_14=sm_rsize;
      p7_prev_15=sm_occ;
      p7_prev_16=sm_room;
      p7_prev_17=sm_throw;
      p7_prev_18=sm_ext;
      p7_prev_19=mode_w0;
      p7_prev_20=mode_w1;
      p7_prev_21=mode_w2;
      p7_prev_22=mode_w3;
      p7_prev_23=sv_t_d1;
    ) : p7_capture ? (
      // Keep the reader cadence unchanged when cached geometry is stationary.
      p7_ci=0;loop(28,p7_cs=p7_states+p7_ci*128;p7_cs[0]=p7_cs[1];p7_ci+=1;);
    );
    p7_capture ? p7_delay_phase=0;
    !p7_was_running ? p7_delay_phase=1;
    p7_control_count=p7_control_period;
  );
);
p7_was_running=p7_running;

// --- optional micro motion ---
ph1 += (2*$pi*(0.12 + 0.08*sm_motion))/srate;
ph2 += (2*$pi*(0.20 + 0.10*sm_motion))/srate;
(ph1 > 2*$pi) ? ph1 -= 2*$pi;
(ph2 > 2*$pi) ? ph2 -= 2*$pi;

mot_deg = 2.3 * sm_motion;
mot_rad = (mot_deg*(sin(ph1) + 0.55*sin(ph2))) * $pi / 180;
// Apply micro-motion as a tiny vector rotation.  Do not clamp at +/-180; rear
// is a continuous circle, and clamping creates discontinuities.
mm_cs = cos(mot_rad);
mm_sn = sin(mot_rad);
az_sin_base = cue_side_s;
az_cos_base = cue_front_s;
az_sin = az_sin_base*mm_cs + az_cos_base*mm_sn;
az_cos = az_cos_base*mm_cs - az_sin_base*mm_sn;

// --- distance / air absorption ---
air_state = (1-sm_air_a)*mono_in + sm_air_a*air_state;
side_air_state = (1-sm_air_a)*input_side + sm_air_a*side_air_state;
bed_air_l = (1-sm_air_a)*in_l + sm_air_a*bed_air_l;
bed_air_r = (1-sm_air_a)*in_r + sm_air_a*bed_air_r;

// --- stable occlusion source model ---
// Build a mono blocked-source color for reflections, but keep the direct
// localization feed clean. Applying the occlusion smear before ITD made the
// delayed/far ear hear the blocker as a separate moving cue.
occ_lp = (1-sm_occ_a)*air_state + sm_occ_a*occ_lp;
occ_low_mem = (1-occ_split_a)*occ_lp + occ_split_a*occ_low_mem;
occ_high = occ_lp - occ_low_mem;

occ_low_g  = 1 + 0.24*sm_occ;
occ_high_g = 1 - 0.86*sm_occ;
occ_high_g < 0.10 ? occ_high_g = 0.10;
occ_sig = occ_low_mem*occ_low_g + occ_high*occ_high_g;

// Reflection-only phase smear. The direct path gets per-ear coloration later,
// after localization, which prevents opposite-ear occlusion flicker.
ap_a = 0.38 + 0.16*sm_occ;
ap_y = -ap_a*occ_sig + occ_ap_x1 + ap_a*occ_ap_y1;
occ_ap_x1 = occ_sig;
occ_ap_y1 = ap_y;
occ_er_sig = occ_sig*(1 - 0.30*sm_occ) + ap_y*(0.30*sm_occ);

// Direct path is localized first; reflections are less occluded and may smear.
direct_feed = air_state;
er_feed = air_state*(1 - 0.28*sm_occ) + occ_er_sig*(0.28*sm_occ);

// --- ITD delay line ---
itdbuf[itd_wpos] = direct_feed;

// az_sin / az_cos are already the stable smoothed cue vector plus micro-motion.
// Center-axis lock fades out arbitrary left/right assignment when lateral is
// effectively zero.  This keeps front-center and rear-center deterministic.
az_axis_abs = abs(az_sin);
axis_lock = 1 - (az_axis_abs / 0.018);
axis_lock < 0 ? axis_lock = 0;
axis_lock > 1 ? axis_lock = 1;
last_axis_lock = axis_lock;
az_sin_dsp = az_sin * (1 - axis_lock);
az_abs = abs(az_sin_dsp);
az_sign = az_sin >= 0 ? 1 : -1;

focus = 1 - 0.74*sm_width;
focus *= 1 - 0.20*sm_far;
focus < 0.14 ? focus = 0.14;

itd_ms = 0.68 * az_sin_dsp * focus * (0.50+0.50*sm_throw);
last_itd_ms = itd_ms;
itd_spl = abs(itd_ms) * 0.001 * srate;
far_sig=p7_read(itdbuf,itd_wpos,1+itd_spl,itd_mask);
near_sig=p7_read(itdbuf,itd_wpos,1,itd_mask);

az_sin < 0 ? (
  sig_l = near_sig;
  sig_r = far_sig;
) : (
  sig_l = far_sig;
  sig_r = near_sig;
);
axis_lock > 0 ? (
  sig_l = sig_l*(1-axis_lock) + near_sig*axis_lock;
  sig_r = sig_r*(1-axis_lock) + near_sig*axis_lock;
);

itd_wpos = (itd_wpos + 1) & itd_mask;

// --- perceptual band split (rough critical-band inspired weighting) ---
l_band1 = (1-band1_a)*sig_l + band1_a*l_band1;
l_rem1 = sig_l - l_band1;
l_band2 = (1-band2_a)*l_rem1 + band2_a*l_band2;
l_lowb = l_band1;
l_midb = l_band2;
l_hib = l_rem1 - l_band2;

r_band1 = (1-band1_a)*sig_r + band1_a*r_band1;
r_rem1 = sig_r - r_band1;
r_band2 = (1-band2_a)*r_rem1 + band2_a*r_band2;
r_lowb = r_band1;
r_midb = r_band2;
r_hib = r_rem1 - r_band2;

// --- frequency-shaped directional weighting ---
axis_mag = sqrt(az_sin*az_sin + az_cos*az_cos);
front = max(0, az_cos);
rear = max(0, -az_cos);
axis_mag > 0.0001 ? (
  side = axis_mag * (1 - abs(az_cos / axis_mag));
) : (
  side = 0;
);
side < 0 ? side = 0;
side > 1 ? side = 1;
shadow = az_abs * focus;
nearfield = 1 - sm_depth;
nearfield < 0 ? nearfield = 0;

// semantic field zones
front_tight = 1 + 0.12*front;
side_lock   = 1 + 0.28*side;
rear_diff   = 1 + 0.30*rear;

// low band = mostly ITD, mild level asymmetry
low_near_g = 1 + 0.03*shadow;
low_far_g  = 1 - 0.10*shadow;
low_far_g < 0.84 ? low_far_g = 0.84;

// mid band = stronger direction + slight proximity push
mid_shape = (1 + 0.10*sm_ext*front - 0.16*sm_ext*rear) * (1 + 0.10*side);
mid_near_g = (1 + 0.10*shadow*side_lock + 0.05*nearfield) * mid_shape;
mid_far_g  = (1 - 0.36*shadow*side_lock - 0.05*rear) * (1 - 0.05*sm_ext*rear);
mid_far_g < 0.30 ? mid_far_g = 0.30;

// high band = strongest head shadow + front/back character
hi_shape = (1 + 0.08*sm_ext*front - 0.24*sm_ext*rear) * (1 + 0.08*side);
hi_near_g = (1 + 0.18*shadow*side_lock + 0.05*nearfield + 0.05*sm_ext*front) * hi_shape;
hi_far_g  = (1 - 0.92*shadow*side_lock - 0.22*sm_ext*rear);
hi_far_g < 0.08 ? hi_far_g = 0.08;

az_sin < 0 ? (
  dir_l = l_lowb*low_near_g + l_midb*mid_near_g + l_hib*hi_near_g;
  dir_r = r_lowb*low_far_g  + r_midb*mid_far_g  + r_hib*hi_far_g;
) : (
  dir_l = l_lowb*low_far_g  + l_midb*mid_far_g  + l_hib*hi_far_g;
  dir_r = r_lowb*low_near_g + r_midb*mid_near_g + r_hib*hi_near_g;
);

// Additional broad-band split for a gentle low/high pan contour
l_low = (1-split_a)*dir_l + split_a*l_low;
r_low = (1-split_a)*dir_r + split_a*r_low;
l_high = dir_l - l_low;
r_high = dir_r - r_low;

shadow_h = shadow;
shadow_l = shadow * 0.25;

near_low_g = 1 + 0.03*shadow_l;
far_low_g  = 1 - 0.14*shadow_l;
near_hi_g  = 1 + 0.06*shadow_h;
far_hi_g   = 1 - 0.28*shadow_h;
far_hi_g < 0.70 ? far_hi_g = 0.70;

az_sin < 0 ? (
  dir_l = l_low*near_low_g + l_high*near_hi_g;
  dir_r = r_low*far_low_g  + r_high*far_hi_g;
) : (
  dir_l = l_low*far_low_g  + l_high*far_hi_g;
  dir_r = r_low*near_low_g + r_high*near_hi_g;
);
axis_lock > 0 ? (
  axis_mid = (dir_l + dir_r) * 0.5;
  dir_l = dir_l*(1-axis_lock) + axis_mid*axis_lock;
  dir_r = dir_r*(1-axis_lock) + axis_mid*axis_lock;
);

// Width = blur toward center, more at distance
center_blend = sm_width * (0.22 + 0.10*sm_depth + 0.10*rear) + 0.035*sm_far*(1 + 0.35*rear);
center_blend > 0.48 ? center_blend = 0.48;
dir_l = dir_l*(1-center_blend) + direct_feed*center_blend;
dir_r = dir_r*(1-center_blend) + direct_feed*center_blend;

// --- stable per-ear occlusion coloration ---
// Color the already-localized left/right direct path instead of feeding a
// pre-occluded mono signal into ITD. This keeps the blocker attached to the
// object and stops far-ear flicker when Occlusion is high.
occ_dir_lp_l = (1-sm_occ_a)*dir_l + sm_occ_a*occ_dir_lp_l;
occ_dir_low_l = (1-occ_split_a)*occ_dir_lp_l + occ_split_a*occ_dir_low_l;
occ_dir_high_l = occ_dir_lp_l - occ_dir_low_l;
occ_dir_col_l = occ_dir_low_l*occ_low_g + occ_dir_high_l*occ_high_g;

occ_dir_lp_r = (1-sm_occ_a)*dir_r + sm_occ_a*occ_dir_lp_r;
occ_dir_low_r = (1-occ_split_a)*occ_dir_lp_r + occ_split_a*occ_dir_low_r;
occ_dir_high_r = occ_dir_lp_r - occ_dir_low_r;
occ_dir_col_r = occ_dir_low_r*occ_low_g + occ_dir_high_r*occ_high_g;

occ_blend = sm_occ;
dir_l = dir_l*(1-occ_blend) + occ_dir_col_l*occ_blend;
dir_r = dir_r*(1-occ_blend) + occ_dir_col_r*occ_blend;

// --- pinna externalize hint ---
pn_y = pn_b0_l*dir_l + pn_b1_l*pn_x1_l + pn_b2_l*pn_x2_l - pn_a1_l*pn_y1_l - pn_a2_l*pn_y2_l;
pn_x2_l = pn_x1_l; pn_x1_l = dir_l;
pn_y2_l = pn_y1_l; pn_y1_l = pn_y;
dir_l = pn_y;

pn_y = pn_b0_r*dir_r + pn_b1_r*pn_x1_r + pn_b2_r*pn_x2_r - pn_a1_r*pn_y1_r - pn_a2_r*pn_y2_r;
pn_x2_r = pn_x1_r; pn_x1_r = dir_r;
pn_y2_r = pn_y1_r; pn_y1_r = pn_y;
dir_r = pn_y;

// --- rear tint ---
rear_lp_l = (1-rear_a)*dir_l + rear_a*rear_lp_l;
rear_lp_r = (1-rear_a)*dir_r + rear_a*rear_lp_r;
dir_l = dir_l*(1-rear_mix) + rear_lp_l*rear_mix;
dir_r = dir_r*(1-rear_mix) + rear_lp_r*rear_mix;
dir_l *= front_tight;
dir_r *= front_tight;
rear_scale = 1 - 0.05*rear;
dir_l *= rear_scale + 0.05*front;
dir_r *= rear_scale + 0.05*front;
axis_lock > 0 ? (
  // Final deterministic centerline blend catches any residual asymmetry from
  // per-ear filter histories while preserving non-centered localization.
  axis_final = axis_lock * 0.88;
  axis_mid = (dir_l + dir_r) * 0.5;
  dir_l = dir_l*(1-axis_final) + axis_mid*axis_final;
  dir_r = dir_r*(1-axis_final) + axis_mid*axis_final;
);

// --- Elevation feel: non-HRTF lifted/grounded macro ---
// The Artistic renderer uses this height-feel cue. It gently biases
// spectral mass/air and becomes more convincing as Push Out rises.
elev_abs_s = abs(sm_elev);
elev_cue_s = elev_abs_s^1.35;
elev_up_s = max(0, sm_elev);
elev_down_s = max(0, -sm_elev);
elev_strength_s = elev_cue_s * (0.30 + 0.70*sm_ext);

// Keep the filter states warm even at neutral elevation so enabling it does not click/jump.
elev_body_l = (1-elev_body_a)*dir_l + elev_body_a*elev_body_l;
elev_air_lp_l = (1-elev_air_a)*dir_l + elev_air_a*elev_air_lp_l;
elev_hi_l = dir_l - elev_air_lp_l;

elev_body_r = (1-elev_body_a)*dir_r + elev_body_a*elev_body_r;
elev_air_lp_r = (1-elev_air_a)*dir_r + elev_air_a*elev_air_lp_r;
elev_hi_r = dir_r - elev_air_lp_r;

(elev_strength_s > 0.00001) ? (
  elev_body_g = 1 - 0.08*elev_up_s*elev_strength_s + 0.10*elev_down_s*elev_strength_s;
  elev_air_g  = 1 + 0.14*elev_up_s*elev_strength_s - 0.18*elev_down_s*elev_strength_s;

  dir_l = dir_l + elev_body_l*(elev_body_g-1) + elev_hi_l*(elev_air_g-1);
  dir_r = dir_r + elev_body_r*(elev_body_g-1) + elev_hi_r*(elev_air_g-1);
);

// apply distance gain after spectral cues
dir_l *= sm_direct_g;
dir_r *= sm_direct_g;

// --- Early reflections buffer ---
erbuf[er_wpos] = er_feed;

er_l = 0;
er_r = 0;
rear_wide = 1 + 0.32*rear;
front_focus = 1 - 0.20*front;
side_wide = 1 + 0.18*side;

// Tap 1: left wall
rd = sm_er1_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp1 = (1-er_a1)*tap + er_a1*er_lp1;
er_l += er_lp1 * 0.45 * 1.22 * front_focus;
er_r += er_lp1 * 0.45 * 0.74 * front_focus;

// Tap 2: right wall
rd = sm_er2_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp2 = (1-er_a2)*tap + er_a2*er_lp2;
er_l += er_lp2 * 0.45 * 0.74 * front_focus;
er_r += er_lp2 * 0.45 * 1.22 * front_focus;

// Tap 3: front wall
rd = sm_er3_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp3 = (1-er_a3)*tap + er_a3*er_lp3;
er_l += er_lp3 * 0.34 * (0.98 + 0.05*side);
er_r += er_lp3 * 0.34 * (0.98 + 0.05*side);

// Tap 4: back wall
rd = sm_er4_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp4 = (1-er_a4)*tap + er_a4*er_lp4;
er_l += er_lp4 * 0.26 * rear_wide * 1.04;
er_r += er_lp4 * 0.26 * rear_wide * 1.04;

// Tap 5: front-left corner
rd = sm_er5_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp5 = (1-er_a5)*tap + er_a5*er_lp5;
er_l += er_lp5 * 0.20 * 1.16;
er_r += er_lp5 * 0.20 * 0.86;

// Tap 6: front-right corner
rd = sm_er6_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp6 = (1-er_a6)*tap + er_a6*er_lp6;
er_l += er_lp6 * 0.20 * 0.86;
er_r += er_lp6 * 0.20 * 1.16;

// Tap 7: back-left corner
rd = sm_er7_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp7 = (1-er_a7)*tap + er_a7*er_lp7;
er_l += er_lp7 * 0.13 * 1.14 * rear_wide;
er_r += er_lp7 * 0.13 * 0.82 * rear_wide;

// Tap 8: back-right corner
rd = sm_er8_d;
rdi = floor(rd); rdf = rd - rdi;
idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
er_lp8 = (1-er_a8)*tap + er_a8*er_lp8;
er_l += er_lp8 * 0.13 * 0.82 * rear_wide;
er_r += er_lp8 * 0.13 * 1.14 * rear_wide;

// --- Elevation vertical early-reflection bias ---
// Uses existing ER buffer; upward favors a ceiling-like tap, downward favors a floor-like tap.
elev_abs_s = abs(sm_elev);
elev_cue_s = elev_abs_s^1.35;
elev_er_amt = elev_cue_s * sm_room * (0.25 + 0.75*sm_ext);
(elev_er_amt > 0.00001) ? (
  ceil_ms = 2.6 + 3.8*sm_rsize + 2.4*max(0, sm_elev);
  floor_ms = 3.4 + 4.4*sm_rsize + 2.8*max(0, -sm_elev);

  rd = ceil_ms * srate * 0.001;
  rdi = floor(rd); rdf = rd - rdi;
  idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
  tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
  elev_er_lp1 = (1-er_a3)*tap + er_a3*elev_er_lp1;
  ceil_g = elev_er_amt * (0.055 + 0.145*max(0, sm_elev));

  rd = floor_ms * srate * 0.001;
  rdi = floor(rd); rdf = rd - rdi;
  idx0 = (er_wpos - rdi) & er_mask; idx1 = (er_wpos - rdi - 1) & er_mask;
  tap = erbuf[idx0]*(1-rdf) + erbuf[idx1]*rdf;
  elev_er_lp2 = (1-er_a4)*tap + er_a4*elev_er_lp2;
  floor_g = elev_er_amt * (0.050 + 0.140*max(0, -sm_elev));

  er_l += elev_er_lp1*ceil_g + elev_er_lp2*floor_g*0.92;
  er_r += elev_er_lp1*ceil_g + elev_er_lp2*floor_g*0.92;
);

// ER decorrelation
apL = 0.53;
apR = 0.69;

er_ap_y = -apL*er_l + er_ap_x1_l + apL*er_ap_y1_l;
er_ap_x1_l = er_l;
er_ap_y1_l = er_ap_y;
er_l = er_ap_y;

er_ap_y = -apR*er_r + er_ap_x1_r + apR*er_ap_y1_r;
er_ap_x1_r = er_r;
er_ap_y1_r = er_ap_y;
er_r = er_ap_y;
axis_lock > 0 ? (
  // Centered sources can still have roomy width, but they should not throw
  // unpredictable left/right reflection flashes while moving on the center axis.
  axis_er = axis_lock * 0.45;
  er_mid = (er_l + er_r) * 0.5;
  er_l = er_l*(1-axis_er) + er_mid*axis_er;
  er_r = er_r*(1-axis_er) + er_mid*axis_er;
);

// Distance / occlusion push more energy into the room.
// V6.2.2 moderates the occlusion room boost so the opposite ear does not
// read reflections as a second blocker position.
er_push = 0.70 + 0.45*sm_depth + 0.10*sm_far + 0.30*sm_occ + 0.12*side + 0.18*rear;
er_l *= sm_er_g * er_push;
er_r *= sm_er_g * er_push;

// Mix out with source-mode preservation.
// 0 Mono Emitter: legacy mono point source.
// 1 Stereo Emitter: spatialized mid + preserved side around one object.
// 2 Ambience Bed: keeps the stereo field broad; placement acts as a bias/anchor.
// 3 Dual Emitter: treats L/R difference as two linked emitters using stronger side preservation.
core_l = dir_l + er_l;
core_r = dir_r + er_r;

src_mode = tgt_source_mode;
side_env_g = sm_in_width * (1 - 0.55*sm_far) * (1 - 0.35*sm_occ);
side_env_g < 0 ? side_env_g = 0;

// All four artistic transfer functions remain warm during mode automation.
side_g1=side_env_g*(0.22+0.66*sm_width+0.16*sm_ext)*sm_direct_g;
side_g3=side_env_g*(0.42+0.82*sm_width+0.22*sm_ext)*sm_direct_g;
anchor=sm_bed_anchor;
pan_bias=p3d_clamp(az_sin*anchor*(0.10+0.25*(1-sm_far)),-0.65,0.65);
bed_g=max(0.42,0.86-0.26*sm_far-0.16*sm_occ);
bed_l=bed_air_l*bed_g*(pan_bias>=0 ? 1-0.28*pan_bias : 1-0.12*pan_bias);
bed_r=bed_air_r*bed_g*(pan_bias>=0 ? 1+0.12*pan_bias : 1+0.28*pan_bias);
bed_mid=(bed_l+bed_r)*0.5;
bed_l=bed_mid+(bed_l-bed_mid)*sm_in_width;
bed_r=bed_mid+(bed_r-bed_mid)*sm_in_width;
core_amt=0.10+0.38*anchor; bed_amt=1-0.22*anchor;
art_l=core_l*(mode_w0+mode_w1+mode_w3)+side_air_state*(side_g1*mode_w1+side_g3*mode_w3)+(bed_l*bed_amt+core_l*core_amt)*mode_w2;
art_r=core_r*(mode_w0+mode_w1+mode_w3)-side_air_state*(side_g1*mode_w1+side_g3*mode_w3)+(bed_r*bed_amt+core_r*core_amt)*mode_w2;
out_l=art_l; out_r=art_r;

// Real L/R emitter feeds precede direct attenuation and occlusion.
p7_width=sm_in_width*(mode_w1+mode_w2+mode_w3);
p7_emit_l=.5*(input_mid+input_side*p7_width);
p7_emit_r=.5*(input_mid-input_side*p7_width);
p7_buf_l[p7_wpos]=p7_emit_l;p7_buf_r[p7_wpos]=p7_emit_r;
p7_out_l=0;p7_out_r=0;p7_direct_l=0;p7_direct_r=0;p7_er_l=0;p7_er_r=0;
p7_running ? (
  p7_actor=0;
  loop(2,
    p7_buf=p7_actor==0 ? p7_buf_l : p7_buf_r;
    p7_kind=0;
    loop(7,
      p7_st=p7_states+(p7_actor*14+p7_kind*2)*128;
      p7_yl=p7_path_tick(p7_st,p7_buf,p7_wpos);
      p7_yr=p7_path_tick(p7_st+128,p7_buf,p7_wpos);
      p7_kind==0 ? (p7_direct_l+=p7_yl;p7_direct_r+=p7_yr;) : (p7_er_l+=p7_yl;p7_er_r+=p7_yr;);
      p7_kind+=1;
    );
    p7_actor+=1;
  );
  p7_out_l=p7_direct_l+p7_er_l;p7_out_r=p7_direct_r+p7_er_r;
  p7_anchor=1-mode_w2*(1-sm_bed_anchor);
  p7_out_l=p7_out_l*p7_anchor+in_l*(1-p7_anchor);
  p7_out_r=p7_out_r*p7_anchor+in_r*(1-p7_anchor);
);
p7_wpos=(p7_wpos+1)&p7_mask;
out_l=art_l*(1-p7_blend)+p7_out_l*p7_blend;
out_r=art_r*(1-p7_blend)+p7_out_r*p7_blend;
// Diagnostic only: no synthesis of missing high-frequency source content.
p7_high_lp=(1-elev_air_a)*in_l+elev_air_a*p7_high_lp;
p7_high_lp_r=(1-elev_air_a)*in_r+elev_air_a*p7_high_lp_r;
p7_high_energy+=(.5*((in_l-p7_high_lp)^2+(in_r-p7_high_lp_r)^2)-p7_high_energy)*meter_k;
p7_total_energy+=(.5*(in_l*in_l+in_r*in_r)-p7_total_energy)*meter_k;
p7_height_limited=p7_total_energy>0.0000000001 && p7_high_energy<.01*p7_total_energy;

// Optional late field. Ten-millisecond bypass ramp followed by logical invalidation.
legacy_l=out_l; legacy_r=out_r;
sv_gate += p3d_clamp(sv_on_target-sv_gate,-sv_gate_step,sv_gate_step);
sv_xfade=min(1,sv_xfade+sv_delay_step);
sv_s_send += (sv_t_send-sv_s_send)*sv_k;
sv_s_decay += (sv_t_decay-sv_s_decay)*sv_k;
sv_s_width += (sv_t_width-sv_s_width)*sv_k;
sv_s_duck += (sv_t_duck-sv_s_duck)*sv_k;
sv_s_trim += (sv_t_trim-sv_s_trim)*sv_k;
sv_s_hp_a += (sv_t_hp_a-sv_s_hp_a)*sv_k;
sv_s_damp_a += (sv_t_damp_a-sv_s_damp_a)*sv_k;
sceneverb_active=sv_gate>0;
sceneverb_active ? (
  sv_in=(legacy_l+legacy_r)*0.5;
  sv_side_in=(legacy_l-legacy_r)*0.5;
  // Physical diffuse excitation remains independent of direct 1/r attenuation.
  p7_send_l=p7_read(p7_buf_l,(p7_wpos-1)&p7_mask,1+p7_late_delay,p7_mask);
  p7_send_r=p7_read(p7_buf_r,(p7_wpos-1)&p7_mask,1+p7_late_delay,p7_mask);
  sv_in=sv_in*(1-p7_blend)+(p7_send_l+p7_send_r)*p7_late_gain*p71_sm_room_weight*p7_blend;
  sv_side_in=sv_side_in*(1-p7_blend)+(p7_send_l-p7_send_r)*p7_late_gain*p71_sm_room_weight*p7_blend;
  sceneverb_lp=(1-sv_s_hp_a)*sv_in+sv_s_hp_a*sceneverb_lp;
  sceneverb_side_lp=(1-sv_s_hp_a)*sv_side_in+sv_s_hp_a*sceneverb_side_lp;
  sv_feed=(sv_in-sceneverb_lp)*sv_gate;
  sv_side_feed=(sv_side_in-sceneverb_side_lp)*sv_gate;
  sv_env_t=max(abs(legacy_l),abs(legacy_r));
  sceneverb_env += (sv_env_t-sceneverb_env)*(sv_env_t>sceneverb_env ? sv_attack_k : sv_release_k);
  sv_duck_g=1/(1+sv_s_duck*sceneverb_env*8);
  sv_t1=p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_old_d1,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_d1,sceneverb_mask,sceneverb_valid)*sv_xfade;
  ss_t1=p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_old_d1*1.07,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_d1*1.07,sceneverb_mask,sceneverb_valid)*sv_xfade;
  sv_t2=p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_old_d2,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_d2,sceneverb_mask,sceneverb_valid)*sv_xfade;
  ss_t2=p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_old_d2*1.07,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_d2*1.07,sceneverb_mask,sceneverb_valid)*sv_xfade;
  sv_t3=p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_old_d3,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_d3,sceneverb_mask,sceneverb_valid)*sv_xfade;
  ss_t3=p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_old_d3*1.07,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_d3*1.07,sceneverb_mask,sceneverb_valid)*sv_xfade;
  sv_t4=p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_old_d4,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_buf,sceneverb_wpos,sv_d4,sceneverb_mask,sceneverb_valid)*sv_xfade;
  ss_t4=p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_old_d4*1.07,sceneverb_mask,sceneverb_valid)*(1-sv_xfade)+p7_sv_read(sceneverb_side_buf,sceneverb_wpos,sv_d4*1.07,sceneverb_mask,sceneverb_valid)*sv_xfade;
  sv_l_raw=sv_t1*.62-sv_t2*.32+sv_t3*.24-sv_t4*.18;
  sv_r_raw=sv_t2*.61+sv_t1*.27-sv_t4*.25+sv_t3*.17;
  ss_l_raw=ss_t1*.62-ss_t2*.32+ss_t3*.24-ss_t4*.18;
  ss_r_raw=ss_t2*.61+ss_t1*.27-ss_t4*.25+ss_t3*.17;
  sceneverb_damp_l=(1-sv_s_damp_a)*sv_l_raw+sv_s_damp_a*sceneverb_damp_l;
  sceneverb_damp_r=(1-sv_s_damp_a)*sv_r_raw+sv_s_damp_a*sceneverb_damp_r;
  sceneverb_side_damp_l=(1-sv_s_damp_a)*ss_l_raw+sv_s_damp_a*sceneverb_side_damp_l;
  sceneverb_side_damp_r=(1-sv_s_damp_a)*ss_r_raw+sv_s_damp_a*sceneverb_side_damp_r;
  sv_fb=(sceneverb_damp_l+sceneverb_damp_r)*.5;
  ss_fb=(sceneverb_side_damp_l+sceneverb_side_damp_r)*.5;
  sceneverb_buf[sceneverb_wpos]=sv_feed*.48+sv_fb*sv_s_decay;
  sceneverb_side_buf[sceneverb_wpos]=sv_side_feed*.48+ss_fb*sv_s_decay;
  sceneverb_wpos=(sceneverb_wpos+1)&sceneverb_mask;
  sceneverb_valid=min(sceneverb_mask,sceneverb_valid+1);
  sv_mid=(sceneverb_damp_l+sceneverb_damp_r)*.5;
  sv_side=(sceneverb_damp_l-sceneverb_damp_r)*.5*sv_s_width;
  ss_mid=(sceneverb_side_damp_l+sceneverb_side_damp_r)*.5;
  ss_side=(sceneverb_side_damp_l-sceneverb_side_damp_r)*.5*sv_s_width;
  sv_return=sv_s_send*sv_duck_g*sv_s_trim*sv_gate;
  out_l=legacy_l+(sv_mid+sv_side+ss_mid+ss_side)*sv_return;
  out_r=legacy_r+(sv_mid-sv_side-ss_mid+ss_side)*sv_return;
  sv_was_active=1;
) : (
  // Mask old samples until each requested delay has fresh history after re-enable.
  sceneverb_valid=0;
  sceneverb_lp=0; sceneverb_side_lp=0; sceneverb_env=0;
  sceneverb_damp_l=0; sceneverb_damp_r=0;
  sceneverb_side_damp_l=0; sceneverb_side_damp_r=0;
  sv_was_active=0;
);
// True final trim: detector, excitation and stored tails are independent of trim.
out_l*=sm_trim; out_r*=sm_trim;

spl0 = out_l;
spl1 = out_r;
// advance ER buffer
er_wpos = (er_wpos + 1) & er_mask;

// meters
meter_direct += (max(abs(dir_l), abs(dir_r)) - meter_direct) * meter_k;
meter_er     += (max(abs(er_l),  abs(er_r))  - meter_er)     * meter_k;


@gfx 1180 720
// Standalone perceptual-position UI.
winflags = gfx_getchar(65536);
noop = 0;

// --- layout ---
base_w = 820; base_h = 500;
ui_s = min(gfx_w/base_w, gfx_h/base_h);
ui_s < 0.56 ? ui_s = 0.56;
ui_s > 1.65 ? ui_s = 1.65;

pad = 16*ui_s;
pad < 10 ? pad = 10;
title_h = 48*ui_s;
title_h < 36 ? title_h = 36;
foot_h = 34*ui_s;
foot_h < 28 ? foot_h = 28;

right_w = gfx_w * 0.34;
right_w < 250*ui_s ? right_w = 250*ui_s;
right_w > gfx_w*0.42 ? right_w = gfx_w*0.42;

left_w = gfx_w - right_w - pad*3;
left_w < 265*ui_s ? (
  right_w = gfx_w*0.36;
  left_w = gfx_w - right_w - pad*3;
);
left_w < 245*ui_s ? left_w = 245*ui_s;

field_h = gfx_h - title_h - foot_h - pad*2;
field_h < 230*ui_s ? field_h = 230*ui_s;

canvas_x = pad;
canvas_y = title_h + pad;
canvas_w = left_w;
canvas_h = field_h - 122*ui_s;

rx = canvas_x + canvas_w + pad;
ry = canvas_y;
rw = gfx_w - rx - pad;
rw < 230*ui_s ? rw = 230*ui_s;
rh = field_h;

cx = canvas_x + canvas_w*0.50;
cy = canvas_y + canvas_h*0.52;

room_hw = canvas_w * 0.39;
room_hd = canvas_h * 0.31;
room_hw < 86*ui_s ? room_hw = 86*ui_s;
room_hd < 70*ui_s ? room_hd = 70*ui_s;
room_hw *= 0.88 + 0.12*slider19;
room_hd *= 0.86 + 0.14*slider19;

room_l = cx - room_hw;
room_r = cx + room_hw;
room_t = cy - room_hd;
room_b = cy + room_hd;

// --- sliders / readouts ---
ui_lat = slider6;
ui_dist = slider7;
ui_fb = slider8;
ui_dist_vis = ui_dist;
ui_dist_vis < 0 ? ui_dist_vis = 0;
ui_dist_vis > 1 ? ui_dist_vis = 1;
ui_throw = slider9;
ui_size = slider10;
ui_push = slider11;
ui_room = slider12;
ui_elev = slider21;
ui_occ = slider13;
ui_motion = slider14;
ui_trim = slider15;
ui_safe = slider16 >= 0.5 ? 1 : 0;
ui_curve = slider17;
ui_smooth = slider18;
ui_rsize = slider19;
ui_source_mode = floor(slider22 + 0.5);
ui_source_mode < 0 ? ui_source_mode = 0;
ui_source_mode > 3 ? ui_source_mode = 3;
ui_src_width = slider23;
ui_bed_anchor = slider24;
ui_pov_deg = slider25;
ui_sceneverb_late = slider27;
ui_sceneverb_size = slider28;
ui_sceneverb_protect = slider29;
ui_sceneverb_on = ui_sceneverb_late > 0.00001 ? 1 : 0;
ui_sceneverb_role = floor(slider32 + 0.5);
ui_sceneverb_trim = slider33;

pos_r = sqrt(ui_lat*ui_lat + ui_fb*ui_fb);
pos_r > 1 ? (
  draw_lat = ui_lat / pos_r;
  draw_fb = ui_fb / pos_r;
  draw_r = 1;
) : (
  draw_lat = ui_lat;
  draw_fb = ui_fb;
  draw_r = pos_r;
);

// Physical drawing uses the same world coordinates as the image-source room.
slider36>=.5 ? (
  draw_lat=p7_source_x/max(.1,p7_room_w*.5*.82);
  draw_fb=p7_source_y/max(.1,p7_room_d*.5*.82);
  draw_r=sqrt(draw_lat*draw_lat+draw_fb*draw_fb);
);
sx = cx + draw_lat * room_hw * 0.82;
sy = cy - draw_fb  * room_hd * 0.82;

dot_r = 8.5*ui_s + 4.5*ui_s*ui_size;
// Tooltip hit-tests need these before the drawing pass.
ghost_r = dot_r*0.72;
head_r = 17*ui_s;

cue_rad = last_cue_az * $pi/180;
ghost_x = slider36>=.5 ? draw_lat : sin(cue_rad)*draw_r;
ghost_y = slider36>=.5 ? draw_fb : cos(cue_rad)*draw_r;
gsx = cx + ghost_x * room_hw * 0.82;
gsy = cy - ghost_y * room_hd * 0.82;

frontness = max(0, draw_fb / (draw_r + 0.000000000000000001));
backness = max(0, -draw_fb / (draw_r + 0.000000000000000001));
sideness = abs(draw_lat / (draw_r + 0.000000000000000001));
draw_r < 0.0001 ? (frontness = 1; backness = 0; sideness = 0;);

// Precompute bounce points before mouse hit-testing so Room tooltips align this frame.
src_nx = draw_lat * 0.82;
src_ny = draw_fb * 0.82;
tL = (-1 - src_nx) / (-2 - src_nx + 0.000000000000000001);
bLx = -1;
bLy = src_ny + tL * (0 - src_ny);
tR = (1 - src_nx) / (2 - src_nx + 0.000000000000000001);
bRx = 1;
bRy = src_ny + tR * (0 - src_ny);
tF = (1 - src_ny) / (2 - src_ny + 0.000000000000000001);
bFx = src_nx + tF * (0 - src_nx);
bFy = 1;
tB = (-1 - src_ny) / (-2 - src_ny + 0.000000000000000001);
bBx = src_nx + tB * (0 - src_nx);
bBy = -1;
bpLx = cx + bLx * room_hw; bpLy = cy - bLy * room_hd;
bpRx = cx + bRx * room_hw; bpRy = cy - bRy * room_hd;
bpFx = cx + bFx * room_hw; bpFy = cy - bFy * room_hd;
bpBx = cx + bBx * room_hw; bpBy = cy - bBy * room_hd;

// --- cards / bars ---
card_gap = 10*ui_s;
card_gap < 6 ? card_gap = 6;

// Advanced controls sit below the canvas, leaving all quick lanes visible.
card1_h=106*ui_s;
card2_h=rh-card1_h-card_gap;
card3_h=112*ui_s;

c1x = rx; c1y = ry; c1w = rw; c1h = card1_h;
c2x = rx; c2y = c1y + c1h + card_gap; c2w = rw; c2h = card2_h;
c3x = canvas_x; c3y = canvas_y+canvas_h+card_gap; c3w = canvas_w; c3h = card3_h;

bar_pad_x = 14*ui_s;
value_gutter = 62*ui_s;
value_gutter < 48 ? value_gutter = 48;
barx = c2x + max(112*ui_s,102);
barw = c2x+c2w-bar_pad_x-value_gutter-barx;
barw < 50 ? barw = 50;
valx = barx + barw + 8*ui_s;

bars_top = c2y + 36*ui_s;
bars_bottom = c2y + c2h - 10*ui_s;
row_h = (bars_bottom - bars_top) / 11;
row_h < 16 ? row_h = 16;
barh = row_h * 0.32;
barh > 11*ui_s ? barh = 11*ui_s;
barh < 7*ui_s ? barh = 7*ui_s;
label_lift = 3*ui_s;

b1y = bars_top + row_h*0.50 - barh*0.50;
b2y = bars_top + row_h*1.50 - barh*0.50;
b3y = bars_top + row_h*2.50 - barh*0.50;
b4y = bars_top + row_h*3.50 - barh*0.50;
b5y = bars_top + row_h*4.50 - barh*0.50;
b6y = bars_top + row_h*5.50 - barh*0.50;
b7y = bars_top + row_h*6.50 - barh*0.50;
b8y = bars_top + row_h*7.50 - barh*0.50;
b9y = bars_top + row_h*8.50 - barh*0.50;
b10y = bars_top + row_h*9.50 - barh*0.50;
b11y = bars_top + row_h*10.50 - barh*0.50;

// --- mouse / hover ---
mouse_l = mouse_cap & 1;
mouse_r = mouse_cap & 2;
mouse_m = mouse_cap & 64;
mouse_shift = mouse_cap & 8;
mouse_ctrl = mouse_cap & 4;
mouse_alt = mouse_cap & 16;

inside_canvas = mouse_x >= canvas_x && mouse_x <= canvas_x + canvas_w && mouse_y >= canvas_y && mouse_y <= canvas_y + canvas_h;
inside_room = mouse_x >= room_l && mouse_x <= room_r && mouse_y >= room_t && mouse_y <= room_b;
near_src = ((mouse_x-sx)*(mouse_x-sx) + (mouse_y-sy)*(mouse_y-sy)) <= ((dot_r+8*ui_s)*(dot_r+8*ui_s));

hover_bar = 0;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b1y && mouse_y <= b1y+barh) ? hover_bar = 1;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b2y && mouse_y <= b2y+barh) ? hover_bar = 2;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b3y && mouse_y <= b3y+barh) ? hover_bar = 3;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b4y && mouse_y <= b4y+barh) ? hover_bar = 4;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b5y && mouse_y <= b5y+barh) ? hover_bar = 5;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b6y && mouse_y <= b6y+barh) ? hover_bar = 6;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b7y && mouse_y <= b7y+barh) ? hover_bar = 7;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b8y && mouse_y <= b8y+barh) ? hover_bar = 8;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b9y && mouse_y <= b9y+barh) ? hover_bar = 9;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b10y && mouse_y <= b10y+barh) ? hover_bar = 10;
(mouse_x >= barx && mouse_x <= barx+barw && mouse_y >= b11y && mouse_y <= b11y+barh) ? hover_bar = 11;

// Tooltip lane targeting must match the actual slider hitbox exactly.
// V6.2 used widened row hitboxes, which made help trigger above the visible bar
// and made the slider feel visually offset. Keep tooltip hover tied to hover_bar.
hover_tip_bar = hover_bar;

safe_x = c1x + c1w - 112*ui_s;
safe_y = c1y + 10*ui_s;
safe_w = 96*ui_s;
safe_h = 22*ui_s;
hover_safe = mouse_x >= safe_x && mouse_x <= safe_x+safe_w && mouse_y >= safe_y && mouse_y <= safe_y+safe_h;
source_btn_x = c1x + c1w - 112*ui_s;
source_btn_y = c1y + 38*ui_s;
source_btn_w = 96*ui_s;
source_btn_h = 22*ui_s;
hover_source_btn = mouse_x >= source_btn_x && mouse_x <= source_btn_x+source_btn_w && mouse_y >= source_btn_y && mouse_y <= source_btn_y+source_btn_h;

// UI-only POV canvas drag limiter.  This does not change DSP mapping or any
// existing automation lanes; it only changes how the canvas translates mouse
// X into Lateral for fast near-center POV placement.
pov_x = canvas_x + canvas_w - 160*ui_s;
pov_y = canvas_y + 14*ui_s;
pov_w = 138*ui_s;
pov_h = 24*ui_s;
pov_bar_x = pov_x + 52*ui_s;
pov_bar_y = pov_y + 14*ui_s;
pov_bar_w = pov_w - 64*ui_s;
pov_bar_h = 6*ui_s;
pov_bar_w < 44*ui_s ? pov_bar_w = 44*ui_s;
hover_pov = mouse_x >= pov_x && mouse_x <= pov_x+pov_w && mouse_y >= pov_y && mouse_y <= pov_y+pov_h;

// Optional SceneVerb side drawer. Closed by default; controls are local.
sv_drawer_w = 282*ui_s;
sv_drawer_w < 220 ? sv_drawer_w = 220;
sv_drawer_w > gfx_w*0.42 ? sv_drawer_w = gfx_w*0.42;
sv_drawer_x = gfx_w - pad - sv_drawer_w;
sv_drawer_x < canvas_x + 120*ui_s ? sv_drawer_x = canvas_x + 120*ui_s;
sv_drawer_y = canvas_y;
sv_drawer_h = field_h;
sv_tab_w = 32*ui_s;
sv_tab_h = 122*ui_s;
sv_tab_x = gfx_w - sv_tab_w - 3*ui_s;
sv_tab_y = canvas_y + 82*ui_s;
hover_sceneverb_tab = mouse_x >= sv_tab_x && mouse_x <= sv_tab_x+sv_tab_w && mouse_y >= sv_tab_y && mouse_y <= sv_tab_y+sv_tab_h;
inside_sceneverb_drawer = ui_sceneverb_drawer_open && mouse_x >= sv_drawer_x && mouse_x <= sv_drawer_x+sv_drawer_w && mouse_y >= sv_drawer_y && mouse_y <= sv_drawer_y+sv_drawer_h;

sv_pad = 14*ui_s;
sv_field_x = sv_drawer_x + sv_pad;
sv_field_w = sv_drawer_w - sv_pad*2;
sv_box_h = 24*ui_s; sv_box_h < 19 ? sv_box_h = 19;
sv_status_x = sv_field_x;
sv_status_y = sv_drawer_y + 64*ui_s;
sv_status_w = sv_field_w;
sv_status_h = sv_box_h;

// Removed explicit enable/source/guard/role buttons in V6.24.
// These variables stay defined so legacy event logic has safe false values.
hover_sv_enable = 0;
hover_sv_source = 0;
hover_sv_guard = 0;
hover_sv_role = 0;

sv_preset_gap = 6*ui_s;
sv_preset_h = 22*ui_s; sv_preset_h < 17 ? sv_preset_h = 17;
sv_preset_w = (sv_field_w - sv_preset_gap*2) / 3;
sv_preset_y1 = sv_status_y + sv_status_h + 32*ui_s;
sv_preset_y2 = sv_preset_y1 + sv_preset_h + 5*ui_s;
sv_preset1_x = sv_field_x;
sv_preset2_x = sv_preset1_x + sv_preset_w + sv_preset_gap;
sv_preset3_x = sv_preset2_x + sv_preset_w + sv_preset_gap;
hover_sv_preset = 0;
inside_sceneverb_drawer ? (
  mouse_y >= sv_preset_y1 && mouse_y <= sv_preset_y1+sv_preset_h ? (
    mouse_x >= sv_preset1_x && mouse_x <= sv_preset1_x+sv_preset_w ? hover_sv_preset = 1;
    mouse_x >= sv_preset2_x && mouse_x <= sv_preset2_x+sv_preset_w ? hover_sv_preset = 2;
    mouse_x >= sv_preset3_x && mouse_x <= sv_preset3_x+sv_preset_w ? hover_sv_preset = 3;
  );
  mouse_y >= sv_preset_y2 && mouse_y <= sv_preset_y2+sv_preset_h ? (
    mouse_x >= sv_preset1_x && mouse_x <= sv_preset1_x+sv_preset_w ? hover_sv_preset = 4;
    mouse_x >= sv_preset2_x && mouse_x <= sv_preset2_x+sv_preset_w ? hover_sv_preset = 5;
    mouse_x >= sv_preset3_x && mouse_x <= sv_preset3_x+sv_preset_w ? hover_sv_preset = 6;
  );
);

sv_bar_x = sv_field_x;
sv_bar_w = sv_field_w - 58*ui_s;
sv_val_x = sv_bar_x + sv_bar_w + 8*ui_s;
sv_bar_h = 9*ui_s; sv_bar_h < 6 ? sv_bar_h = 6;
sv_row_h = 42*ui_s; sv_row_h < 30 ? sv_row_h = 30;
sv_b1y = sv_preset_y2 + sv_preset_h + 44*ui_s;
sv_b2y = sv_b1y + sv_row_h;
sv_b3y = sv_b2y + sv_row_h;
hover_sv_bar = 0;
inside_sceneverb_drawer ? (
  (mouse_x >= sv_bar_x && mouse_x <= sv_bar_x+sv_bar_w && mouse_y >= sv_b1y && mouse_y <= sv_b1y+sv_bar_h) ? hover_sv_bar = 1;
  (mouse_x >= sv_bar_x && mouse_x <= sv_bar_x+sv_bar_w && mouse_y >= sv_b2y && mouse_y <= sv_b2y+sv_bar_h) ? hover_sv_bar = 2;
  (mouse_x >= sv_bar_x && mouse_x <= sv_bar_x+sv_bar_w && mouse_y >= sv_b3y && mouse_y <= sv_b3y+sv_bar_h) ? hover_sv_bar = 3;
);

// GFX-only advanced slider widgets in the bottom card.
adv_barx = c3x + max(112*ui_s,102);
adv_barw = c3x+c3w-64*ui_s-adv_barx;
adv_valx = adv_barx + adv_barw + 7*ui_s;
adv_barw < 74*ui_s ? adv_barw = 74*ui_s;
adv_h = 7*ui_s; adv_h < 5 ? adv_h = 5;
adv_row_h = (c3h - 34*ui_s) / 5;
adv_row_h < 16*ui_s ? adv_row_h = 16*ui_s;
adv1y = c3y + 31*ui_s;
adv2y = adv1y + adv_row_h;
adv3y = adv2y + adv_row_h;
adv4y = adv3y + adv_row_h;
adv5y = adv4y + adv_row_h;
hover_adv = 0;
(mouse_x >= adv_barx && mouse_x <= adv_barx+adv_barw && mouse_y >= adv1y && mouse_y <= adv1y+adv_h) ? hover_adv = 1;
(mouse_x >= adv_barx && mouse_x <= adv_barx+adv_barw && mouse_y >= adv2y && mouse_y <= adv2y+adv_h) ? hover_adv = 2;
(mouse_x >= adv_barx && mouse_x <= adv_barx+adv_barw && mouse_y >= adv3y && mouse_y <= adv3y+adv_h) ? hover_adv = 3;
(mouse_x >= adv_barx && mouse_x <= adv_barx+adv_barw && mouse_y >= adv4y && mouse_y <= adv4y+adv_h) ? hover_adv = 4;
(mouse_x >= adv_barx && mouse_x <= adv_barx+adv_barw && mouse_y >= adv5y && mouse_y <= adv5y+adv_h) ? hover_adv = 5;

// Snap chips
chip_h = 22*ui_s;
chip_y = canvas_y + canvas_h - chip_h - 11*ui_s;
chip_gap = 6*ui_s;
chip_x = canvas_x + 14*ui_s;
chip_w = (canvas_w - 28*ui_s - chip_gap*7) / 8;
chip_w > 54*ui_s ? chip_w = 54*ui_s;
chip_w < 34*ui_s ? chip_w = 34*ui_s;
chip1x = chip_x;
chip2x = chip1x + chip_w + chip_gap;
chip3x = chip2x + chip_w + chip_gap;
chip4x = chip3x + chip_w + chip_gap;
chip5x = chip4x + chip_w + chip_gap;
chip6x = chip5x + chip_w + chip_gap;
chip7x = chip6x + chip_w + chip_gap;
chip8x = chip7x + chip_w + chip_gap;

hover_chip = 0;
(mouse_y >= chip_y && mouse_y <= chip_y+chip_h) ? (
  mouse_x >= chip1x && mouse_x <= chip1x+chip_w ? hover_chip = 1;
  mouse_x >= chip2x && mouse_x <= chip2x+chip_w ? hover_chip = 2;
  mouse_x >= chip3x && mouse_x <= chip3x+chip_w ? hover_chip = 3;
  mouse_x >= chip4x && mouse_x <= chip4x+chip_w ? hover_chip = 4;
  mouse_x >= chip5x && mouse_x <= chip5x+chip_w ? hover_chip = 5;
  mouse_x >= chip6x && mouse_x <= chip6x+chip_w ? hover_chip = 6;
  mouse_x >= chip7x && mouse_x <= chip7x+chip_w ? hover_chip = 7;
  mouse_x >= chip8x && mouse_x <= chip8x+chip_w ? hover_chip = 8;
);

// MODEL drawer: only its own controls consume input while the pointer is inside.
ui7_tab_w=32*ui_s;ui7_tab_h=92*ui_s;
ui7_tab_x=gfx_w-ui7_tab_w-3*ui_s;ui7_tab_y=sv_tab_y+sv_tab_h+10*ui_s;
ui7_tab_hot=mouse_x>=ui7_tab_x && mouse_x<=ui7_tab_x+ui7_tab_w && mouse_y>=ui7_tab_y && mouse_y<=ui7_tab_y+ui7_tab_h;
ui7_w=min(gfx_w*.55,360*ui_s);ui7_x=gfx_w-pad-ui7_w;ui7_y=canvas_y;ui7_h=field_h;
ui7_inside=ui7_open && mouse_x>=ui7_x && mouse_x<=ui7_x+ui7_w && mouse_y>=ui7_y && mouse_y<=ui7_y+ui7_h;
ui7_row_h=(ui7_h-108*ui_s)/10;
ui7_row_h=max(21*ui_s,ui7_row_h);
ui7_bar_x=ui7_x+132*ui_s;ui7_bar_w=ui7_w-211*ui_s;
ui7_start_y=ui7_y+63*ui_s;
ui7_hover=0;
ui7_inside && mouse_y>=ui7_start_y && mouse_y<ui7_start_y+10*ui7_row_h ? ui7_hover=floor((mouse_y-ui7_start_y)/ui7_row_h)+1;
!ui_prev_l && mouse_l && ui7_tab_hot ? (ui7_open=1-ui7_open;ui_sceneverb_drawer_open=0;ui_mode=0;);
!ui_prev_l && mouse_l && hover_sceneverb_tab ? (ui7_open=0;ui7_inside=0;);
ui7_open && ui7_inside ? (
  !ui_prev_l && mouse_l && ui7_hover>0 ? (
    ui7_drag=ui7_hover;
    ui7_hover==1 ? (slider36=1-slider36;ui7_drag=0;sliderchange(-1.0););
    ui7_hover==2 ? (slider37=(floor(slider37+.5)+1)%3;ui7_drag=0;sliderchange(-1.0););
    ui7_hover==4 ? (slider39=1-slider39;ui7_drag=0;sliderchange(-1.0););
  );
  !ui_prev_r && mouse_r && ui7_hover>0 ? (
    ui7_hover==1 ? (slider36=0;sliderchange(-1.0););
    ui7_hover==2 ? (slider37=1;sliderchange(-1.0););
    ui7_hover==3 ? (slider38=1;sliderchange(-1.0););
    ui7_hover==4 ? (slider39=0;sliderchange(-1.0););
    ui7_hover==5 ? (slider40=1;sliderchange(-1.0););
