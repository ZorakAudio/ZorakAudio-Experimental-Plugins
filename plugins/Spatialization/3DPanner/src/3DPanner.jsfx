desc:Hyperreal 3D Panner V7.1.2 (Legacy Distance Preservation)

// #HELP: Headphone-focused 3D panner using softened perceptual placement, microdelay, head shadow, pinna cues, distance loss, occlusion, and room cues.
// #HELP: Drag the orange source in the stage canvas. Default canvas drag uses the POV range limiter for fast near-center placement. Mouse wheel changes Distance.
// #HELP: Spatial Throw controls directional cue intensity. Output Trim sets the final level.
// #HELP: Solid orange = visual object position. Ghost orange = effective cue position after Throw / Cue Curve compression.
// #HELP: Cyan wall markers are EARLY BOUNCES: first reflection hits used for out-of-head placement.
// #HELP: Automation Safe caps aggressive throw and lengthens smoothing for drawn automation.
// #HELP: Visual cues: Size = orange halo/cloud, Distance = grey range rings/dashes, Push Out = listener shell, Room = cyan bounces/wall glow, Motion = green trail.
// #HELP: Hover any canvas cue, snap chip, Automation Safe button, or quick-control lane for inline guidance. Tooltips use exact hit zones and dock away from controls.
// #HELP: Elevation controls artistic height cues or Physical source height (-90..+90 degrees). Middle-drag or Shift-wheel adjusts it.
// #HELP: SceneVerb Lite uses local Late Field, Space Size and Protect controls. Late Field at 0% bypasses the late field.
// #HELP: V7.1.2 keeps Artistic distance in metres with its original saved-value mapping. Physical alone displays feet.
// #HELP: V7.1.1 repairs EEL2 compilation: decimal constants and dependency-ordered helpers.
// #HELP: V7.1.0 adds listener FOLLOW gestures, center precision, feet readouts and elevation range/pole fixes.
// #HELP: V7 repairs lifecycle, stability and automation. MODEL selects Artistic or Physical; all control is local.
// #HELP: Physical uses per-ear geometry, 1/r gain, path air loss, floor/ceiling reflections and a measured KEMAR spectral fit.
// #HELP: Physical elevation preserves range. Room cues fade outside the room. FOLLOW view edits listener orientation.
// #HELP: KEMAR covers -40..+90 degrees; lower directions retain the -40-degree spectrum. Profiles scale its frequencies.
// #HELP: KEMAR data: Bill Gardner and Keith Martin, MIT Media Laboratory, 1994. https://sound.media.mit.edu/resources/KEMAR.html
// #HELP: V6.2.2 stabilizes Occlusion by applying blocked-source coloration after localization, preventing opposite-ear flicker.
// #TOOLTIP: Headphone-focused perceptual object panner with local position and room controls.

options:gfx_hz=60
options:idle=always
options:ownership=auto

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// Retired parameter slots. Keep indices and types for saved-state/automation compatibility.
// These parameters are hidden and have no effect.
slider1:#retired_text_1=""<string>-Retired 1
slider2:#retired_text_2=""<string>-Retired 2
slider3:1<1,999,1>-Retired 3
slider4:0<0,1,1{Unused,Unused}>-Retired 4
slider5:1<0,1,0.001>-Retired 5

// POSITION
// #TOOLTIP: Left/right object placement. Negative = left, positive = right.
slider6:0<-1,1,0.001>-Lateral
// #TOOLTIP: Physical distance throw. V6 uses a shorter, higher-resolution stage range than V5.
slider7:0.25<0,1,0.001>-Distance
// #TOOLTIP: Front/rear object placement. +1 = front wall, 0 = side plane, -1 = rear wall.
slider8:0.82<-1,1,0.001>-Depth Front/Rear

// FEEL
// #TOOLTIP: Directional cue intensity. Higher emphasizes timing and spectral placement cues.
slider9:0.58<0,1,0.001>-Spatial Throw
// #TOOLTIP: Apparent source size. Lower = tighter point source; higher = wider / more diffuse image.
slider10:0.10<0,1,0.001>-Size
// #TOOLTIP: Out-of-head realism cue strength. Formerly Externalize.
slider11:0.42<0,1,0.001>-Push Out
// #TOOLTIP: Early reflection amount. Higher = more room cue and more externalization, less surgical precision.
slider12:0.30<0,1,0.001>-Room

// MATERIAL / MOTION
// #TOOLTIP: How blocked or hidden the source is. Higher = more muffled direct sound and more reflection dominance.
slider13:0<0,1,0.001>-Occlusion
// #TOOLTIP: Tiny motion added to keep static sources from collapsing inward on headphones.
slider14:0.04<0,1,0.001>-Micro Motion
// #TOOLTIP: Final output trim after spatial processing.
slider15:0<-18,12,0.1>-Output Trim (dB)

// AUTOMATION / ADVANCED
// #TOOLTIP: Caps aggressive spatial throw and uses safer smoothing for automation curves.
slider16:1<0,1,1>-Automation Safe
// #TOOLTIP: Perceptual compression curve. Higher values make moderate visual angles less extreme.
slider17:2.00<1,3,0.01>-Cue Curve
// #TOOLTIP: Movement smoothing in milliseconds. Automation Safe enforces a higher minimum.
slider18:90<5,250,1>-Motion Smooth (ms)
// #TOOLTIP: Geometric room scale for the bounce model. Higher = larger room and longer early reflection timing.
slider19:0.55<0,1,0.001>-Room Size
// Retired parameter slot; hidden and inert.
slider20:1<1,64,1>-Retired 20
// #TOOLTIP: Artistic height cues, or Physical elevation from -90 to +90 degrees. Perceived localization depends on the listener and source bandwidth.
slider21:0<-1,1,0.001>-Elevation
// #TOOLTIP: Input interpretation. Mono Emitter folds to mono; Stereo/Dual preserve source width; Ambience Bed preserves field material instead of forcing a point source.
slider22:0<0,3,1{Mono,Stereo,Bed,Dual}>-Source Mode
// #TOOLTIP: How much original stereo side/difference content survives in Stereo/Dual/Ambience modes. Leave high for beds/music; lower for point sources.
slider23:0.75<0,1,0.001>-Input Width Preserve
// #TOOLTIP: Ambience Bed only. Lower = broad stable bed; higher = more world-locked bed biased by object placement.
slider24:0.45<0,1,0.001>-Bed Anchor
// #TOOLTIP: UI-only canvas drag limiter. Default +-10 deg makes POV placement quick; Quick Controls and snap chips still allow full-range placement.
slider25:10<0,90,0.1>-POV Canvas Range (deg)

// SCENEVERB LITE / OPTIONAL LATE FIELD
// Hard compatibility rule: sliders 1-25 remain the legacy panner contract.
// SceneVerb is macro-only here: Late Field at 0% is the off state; >0% activates it.
// #TOOLTIP: Internal legacy toggle kept for slot compatibility. SceneVerb activation is controlled by Late Field > 0%.
slider26:0<0,1,1{Unused,Unused}>-Internal SceneVerb Legacy Toggle
// #TOOLTIP: Late diffuse field amount. 0% fades to bypass in 10 ms and clears the old tail; raising it activates SceneVerb.
slider27:0<0,1,0.001>-Late Field (0=Off)
// #TOOLTIP: Macro size/spread. Lower = tight/short/near; higher = wider/longer/more cinematic.
slider28:0.55<0,1,0.001>-Space Size
// #TOOLTIP: Macro safety/protection. Higher = more low-end protection, stronger ducking, darker/safer field. Lower = more open/lush.
slider29:0.72<0,1,0.001>-Protect
// #TOOLTIP: Internal derived damping storage. Not user-facing in the macro drawer.
slider30:0<0,1,0.001>-Internal SceneVerb Damping
// #TOOLTIP: Internal derived ducking storage. Not user-facing in the macro drawer.
slider31:0<0,1,0.001>-Internal SceneVerb Duck
// #TOOLTIP: Source type for the hidden guard rails. Use the drawer preset chips instead of manually editing this.
slider32:0<0,5,1{Generic,Vocal,Impact,Wet_Internal,Wet_External,Ambience}>-SceneVerb Type
// #TOOLTIP: Internal return trim for presets. Default 0 dB; not exposed in the macro drawer.
slider33:0<-18,18,0.1>-Internal SceneVerb Trim (dB)
// Retired parameter slot; hidden and inert.
slider34:0<0,1,1{Unused,Unused}>-Retired 34
// #TOOLTIP: Internal guard compatibility slot. Guard rails are always on.
slider35:1<0,1,1{Off,On}>-Internal SceneVerb Guard

// V7 controls. Existing parameter slots retain their meanings.
// #TOOLTIP: Select Artistic or Physical. Physical uses the Pan Curve for fine center placement.
slider36:0<0,1,1{Artistic,Physical}>-Render Model
// #TOOLTIP: Frequency-scale variant of the KEMAR spectral fit; not an individual listener measurement.
slider37:1<0,2,1{Lower,Reference,Higher}>-Pinna Profile
// #TOOLTIP: Amount of direct inverse-distance gain. Physical only.
slider38:1<0,1,0.001>-Distance Gain
// #TOOLTIP: Include common source travel time; ear and reflection timing remain when Off.
slider39:0<0,1,1{Off,On}>-Travel Time
// #TOOLTIP: Amount of path air absorption at fixed 68 F and 50% humidity.
slider40:1<0,1,0.001>-Air Loss
// #TOOLTIP: Turn the listener. FOLLOW drag horizontally; Shift for fine control.
slider41:0<-180,180,0.1>-Listener Yaw (deg)
// #TOOLTIP: Look up or down. FOLLOW drag vertically; Shift for fine control.
slider42:0<-90,90,0.1>-Listener Pitch (deg)
// #TOOLTIP: Tilt the listener sideways. FOLLOW Alt-drag or Alt-wheel.
slider43:0<-180,180,0.1>-Listener Roll (deg)
// #TOOLTIP: Room ceiling height. Physical displays feet; Artistic displays metres. Stored automation remains metres.
slider44:4<2,24,0.01>-Room Height (m)
// #TOOLTIP: Listener height above the floor. Physical displays feet; Artistic displays metres. Stored automation remains metres.
slider45:1.6<0.4,2.2,0.01>-Ear Height (m)

// V6 control model:
//   Lateral + Depth Front/Rear = visual object coordinate.
//   Distance                  = near/far physical distance.
//   Spatial Throw             = strength of the directional cue stack.
//   Push Out                  = outside-head realism / pinna-room emphasis.
//   Elevation                 = non-HRTF lifted/grounded height feel.
//   Source Mode               = mono point emitter vs stereo/ambience preservation.
//   Cue Curve                 = how much mid-angle positions are softened.
//   POV Canvas Range          = UI-only drag cone for fast near-center placement.

@init
za_idle_mode = 4;
za_keep_awake = 1;



// EEL2 requires helpers to be defined before their callers.
function p3d_clamp(x, lo, hi) (
  x < lo ? lo : (x > hi ? hi : x);
);

function p3d_wrap_deg(a) (
  while (a > 180) ( a -= 360; );
  while (a < -180) ( a += 360; );
  a;
);

function p3d_angle_from_components(side, front) local(ang) (
  // Stable signed azimuth from a cue vector.  This is used after smoothing
  // side/front components so rear-center never has to jump through front.
  ang = atan(side / (abs(front) + 0.000000000000000001)) * 180 / $pi;
  (front < 0) ? (
    side >= 0 ? ang = 180 - ang : ang = -180 - ang;
  );
  p3d_wrap_deg(ang);
);

// Center precision changes source azimuth, before shared 3D geometry. Range is independent.
function p71_pan_angle(side,front,curve) local(a b) (
  a=(side<0 ? -1 : 1)*abs(side)^curve;
  b=(front<0 ? -1 : 1)*abs(front)^curve;
  abs(a)+abs(b)<0.000000000000000001 ? 0 : p3d_angle_from_components(a,b);
);
function p71_pan_unmap(angle,curve) local(a b n) (
  a=sin(angle*$pi/180);b=cos(angle*$pi/180);
  a=(a<0 ? -1 : 1)*abs(a)^(1/curve);b=(b<0 ? -1 : 1)*abs(b)^(1/curve);
  n=sqrt(a*a+b*b);ui71_pan_lat=a/max(0.000000000000000001,n)*.82;ui71_pan_fb=b/max(0.000000000000000001,n)*.82;
);

// GFX helpers are defined in @init. Their ui71_* state is owned by the drawing thread.
function p71_project(x,y,z) local(side ahead up depth) (
  side=x*ui71_cam_cos-y*ui71_cam_sin;
  ahead=x*ui71_cam_sin+y*ui71_cam_cos;
  up=ahead*.3713906764+z*.9284766909;
  depth=ui71_cam_dist+ahead*.9284766909-z*.3713906764;
  ui71_proj_ok=depth>.2;
  ui71_px=ui71_vcx+side*ui71_focal/max(.2,depth);
  ui71_py=ui71_vcy-up*ui71_focal/max(.2,depth);
);
function p71_line(x,y,z,a,b,c) local(x1 y1 ok x2 y2 dx dy t0 t1 t) (
  p71_project(x,y,z);x1=ui71_px;y1=ui71_py;ok=ui71_proj_ok;
  p71_project(a,b,c);x2=ui71_px;y2=ui71_py;
  // Clip in screen space so room/grid lines never cover controls outside this viewport.
  ok && ui71_proj_ok ? (
    dx=x2-x1;dy=y2-y1;t0=0;t1=1;
    abs(dx)<0.000000000001 ? (x1<ui71_clip_l || x1>ui71_clip_r ? t1=-1;) : (
      t=(ui71_clip_l-x1)/dx;dx>0 ? t0=max(t0,t) : t1=min(t1,t);
      t=(ui71_clip_r-x1)/dx;dx>0 ? t1=min(t1,t) : t0=max(t0,t);
    );
    abs(dy)<0.000000000001 ? (y1<ui71_clip_t || y1>ui71_clip_b ? t1=-1;) : (
      t=(ui71_clip_t-y1)/dy;dy>0 ? t0=max(t0,t) : t1=min(t1,t);
      t=(ui71_clip_b-y1)/dy;dy>0 ? t1=min(t1,t) : t0=max(t0,t);
    );
    t0<=t1 ? gfx_line(x1+dx*t0,y1+dy*t0,x1+dx*t1,y1+dy*t1);
  );
);
function p71_point(x,y,z,r,fill) (
  p71_project(x,y,z);
  ui71_proj_ok && ui71_px>=ui71_clip_l+r && ui71_px<=ui71_clip_r-r && ui71_py>=ui71_clip_t+r && ui71_py<=ui71_clip_b-r ? gfx_circle(ui71_px,ui71_py,r,fill,1);
);
function p71_head(x,y,z) (
  ui71_hx=ui71_r00*x+ui71_r01*y+ui71_r02*z;
  ui71_hy=ui71_r10*x+ui71_r11*y+ui71_r12*z;
  ui71_hz=ui71_r20*x+ui71_r21*y+ui71_r22*z;
);
function p71_follow_draw() local(i a b x y z hx hy hz wx wy lo hi cy sy cp sp cr sr qw qx qy qz) (
  gfx_set(.07,.085,.11,1);gfx_rect(canvas_x,canvas_y,canvas_w,chip_y-canvas_y-5*ui_s);
  ui71_cam_yaw=p3d_wrap_deg(ui71_cam_yaw+p3d_wrap_deg(slider41-ui71_cam_yaw)*.22);
  ui71_cam_sin=sin(ui71_cam_yaw*$pi/180);ui71_cam_cos=cos(ui71_cam_yaw*$pi/180);
  ui71_clip_l=canvas_x+8*ui_s;ui71_clip_r=canvas_x+canvas_w-8*ui_s;
  ui71_clip_t=canvas_y+58*ui_s;ui71_clip_b=chip_y-44*ui_s;
  ui71_cam_dist=max(3.5,p7_center_r*2.8);ui71_focal=min(canvas_w,ui71_clip_b-ui71_clip_t);
  ui71_vcx=canvas_x+canvas_w*.5;ui71_vcy=(ui71_clip_t+ui71_clip_b)*.5;
  wx=max(2,p7_room_w*.5);wy=max(2.5,p7_room_d*.5);lo=-p7_ear_height;hi=p7_room_h-p7_ear_height;
  // Room wireframe is fixed in world coordinates; the trailing camera only changes its projection.
  gfx_set(.22,.36,.44,.8);i=-5;
  loop(11,p71_line(i,-5,lo,i,5,lo);p71_line(-5,i,lo,5,i,lo);i+=1;);
  gfx_set(.32,.67,.78,.8);
  p71_line(-wx,-wy,lo,wx,-wy,lo);p71_line(wx,-wy,lo,wx,wy,lo);p71_line(wx,wy,lo,-wx,wy,lo);p71_line(-wx,wy,lo,-wx,-wy,lo);
  p71_line(-wx,-wy,hi,wx,-wy,hi);p71_line(wx,-wy,hi,wx,wy,hi);p71_line(wx,wy,hi,-wx,wy,hi);p71_line(-wx,wy,hi,-wx,-wy,hi);
  p71_line(-wx,-wy,lo,-wx,-wy,hi);p71_line(wx,-wy,lo,wx,-wy,hi);p71_line(wx,wy,lo,wx,wy,hi);p71_line(-wx,wy,lo,-wx,wy,hi);
  // World reference axes and the source's actual height/range.
  gfx_set(.43,.54,.66,.8);p71_line(0,0,lo,0,0,0);p71_line(0,0,lo,0,2,lo);
  gfx_set(.98,.66,.16,1);p71_line(0,0,0,p7_source_x,p7_source_y,p7_source_z);
  gfx_set(.98,.66,.16,.5);p71_line(p7_source_x,p7_source_y,lo,p7_source_x,p7_source_y,p7_source_z);
  gfx_set(.98,.66,.16,1);p71_point(p7_source_x,p7_source_y,p7_source_z,8*ui_s,1);
  p71_project(p7_source_x,p7_source_y,p7_source_z);ui71_source_px=ui71_px;ui71_source_py=ui71_py;
  // Exact target orientation matches the DSP quaternion convention; camera trails yaw only.
  cy=cos(slider41*$pi/360);sy=sin(slider41*$pi/360);cp=cos(slider42*$pi/360);sp=sin(slider42*$pi/360);cr=cos(slider43*$pi/360);sr=sin(slider43*$pi/360);
  qw=cy*cp*cr+sy*sp*sr;qx=cy*sp*cr+sy*cp*sr;qy=cy*cp*sr-sy*sp*cr;qz=cy*sp*sr-sy*cp*cr;
  ui71_r00=1-2*(qy*qy+qz*qz);ui71_r01=2*(qx*qy-qw*qz);ui71_r02=2*(qx*qz+qw*qy);
  ui71_r10=2*(qx*qy+qw*qz);ui71_r11=1-2*(qx*qx+qz*qz);ui71_r12=2*(qy*qz-qw*qx);
  ui71_r20=2*(qx*qz-qw*qy);ui71_r21=2*(qy*qz+qw*qx);ui71_r22=1-2*(qx*qx+qy*qy);
  // Exaggerated visual head, ears and up/forward arrows keep rotation legible at every range.
  ui71_head_scale=max(.34,ui71_cam_dist*.18);
  gfx_set(.77,.86,.98,1);i=0;
  loop(32,
    a=i*2*$pi/32;b=(i+1)*2*$pi/32;
    p71_head(sin(a)*ui71_head_scale,0,cos(a)*ui71_head_scale*1.2);hx=ui71_hx;hy=ui71_hy;hz=ui71_hz;
    p71_head(sin(b)*ui71_head_scale,0,cos(b)*ui71_head_scale*1.2);p71_line(hx,hy,hz,ui71_hx,ui71_hy,ui71_hz);i+=1;
  );
  gfx_set(.50,.61,.76,.75);i=0;
  loop(32,
    a=i*2*$pi/32;b=(i+1)*2*$pi/32;
    p71_head(0,sin(a)*ui71_head_scale*.8,cos(a)*ui71_head_scale*1.2);hx=ui71_hx;hy=ui71_hy;hz=ui71_hz;
    p71_head(0,sin(b)*ui71_head_scale*.8,cos(b)*ui71_head_scale*1.2);p71_line(hx,hy,hz,ui71_hx,ui71_hy,ui71_hz);i+=1;
  );
  p71_head(-1.3*ui71_head_scale,0,0);gfx_set(.35,.66,1,1);p71_point(ui71_hx,ui71_hy,ui71_hz,5*ui_s,1);ui71_left_x=ui71_px;ui71_left_y=ui71_py;
  p71_head(1.3*ui71_head_scale,0,0);gfx_set(1,.47,.35,1);p71_point(ui71_hx,ui71_hy,ui71_hz,5*ui_s,1);ui71_right_x=ui71_px;ui71_right_y=ui71_py;
  p71_head(0,ui71_head_scale*2.3,0);gfx_set(.65,.92,.50,1);p71_line(0,0,0,ui71_hx,ui71_hy,ui71_hz);p71_point(ui71_hx,ui71_hy,ui71_hz,4*ui_s,1);
  gfx_setfont(4,"Arial",fs4,'b');gfx_set(.85,.93,1,1);
  gfx_x=ui71_left_x-5*ui_s;gfx_y=ui71_left_y+8*ui_s;gfx_printf("L");
  gfx_x=ui71_right_x-5*ui_s;gfx_y=ui71_right_y+8*ui_s;gfx_printf("R");
  p71_head(0,0,ui71_head_scale*1.6);gfx_set(.64,.77,1,1);p71_line(0,0,0,ui71_hx,ui71_hy,ui71_hz);
  gfx_setfont(4,"Arial",fs4,'b');gfx_set(.85,.93,1,1);gfx_x=canvas_x+14*ui_s;gfx_y=canvas_y+12*ui_s;gfx_printf("LISTENER FOLLOW | %.2f ft",p7_center_r/.3048);
  gfx_setfont(4,"Arial",fs4);gfx_x=canvas_x+14*ui_s;gfx_y=canvas_y+33*ui_s;gfx_printf("Yaw %+.0f  Pitch %+.0f  Roll %+.0f | Pan %+.2f",slider41,slider42,slider43,p71_pan_angle(slider6,slider8,slider17));
  gfx_set(.73,.82,.91,1);gfx_x=canvas_x+14*ui_s;gfx_y=chip_y-39*ui_s;gfx_printf("Drag: look | Alt: roll | Ctrl: source");
  gfx_x=canvas_x+14*ui_s;gfx_y=chip_y-20*ui_s;gfx_printf("Wheel: range | Shift-wheel: height");
);

// Physical path renderer. All helpers live in @init; no external controller.
function p7_mag(x,y,z) (sqrt(x*x+y*y+z*z););

function p7_gain(az,el,band) local(a0 a1 af e0 e1 ef x0 x1) (
  az=az-floor(az/360)*360;
  az/=10; a0=floor(az); af=az-a0; a1=(a0+1)%36;
  el=p3d_clamp((el+40)/10,0,13); e0=floor(el); e1=min(13,e0+1); ef=el-e0;
  x0=kemar[(e0*36+a0)*6+band]*(1-af)+kemar[(e0*36+a1)*6+band]*af;
  x1=kemar[(e1*36+a0)*6+band]*(1-af)+kemar[(e1*36+a1)*6+band]*af;
  x0+(x1-x0)*ef;
);

function p7_peak(st,fc,q,gain,reset) local(A w cs sn alpha b0 b1 b2 a0 a1 a2 i avail) (
  avail=p3d_clamp((0.48*srate-fc)/max(500,fc*.2),0,1);
  gain*=avail;
  fc=min(fc,.45*srate);
  A=10^(gain/40); w=2*$pi*fc/srate; cs=cos(w); sn=sin(w); alpha=sn/(2*q);
  a0=1+alpha/A;
  st[0]=(1+alpha*A)/a0; st[1]=-2*cs/a0; st[2]=(1-alpha*A)/a0;
  st[3]=-2*cs/a0; st[4]=(1-alpha/A)/a0;
  !reset && abs(st[0]-st[5])+abs(st[1]-st[6])+abs(st[2]-st[7])+abs(st[3]-st[8])+abs(st[4]-st[9])>0.000000000001 ? p7_filter_count=max(p7_filter_count,.2*srate);
  reset ? (
    i=0; loop(5,st[5+i]=st[i];i+=1;);
    st[10]=0;st[11]=0;
  );
);

function p7_filter(st,x) local(i y) (
  p7_filter_count>0 ? (i=0;loop(5,st[5+i]+=(st[i]-st[5+i])*p7_coeff_k;i+=1;););
  y=st[5]*x+st[10];
  st[10]=st[6]*x-st[8]*y+st[11];
  st[11]=st[7]*x-st[9]*y;
  y;
);

// ISO 9613-1 molecular absorption expression, fixed 20 C / 50% RH / 101.325 kPa.
// Returns dB/metre at the requested band centre; the renderer uses three bands.
function p7_air_alpha(f) local(T h frO frN) (
  T=293.15;
  h=50*10^(-6.8346*(273.16/T)^1.261+4.6151);
  frO=24+40400*h*(.02+h)/(.391+h);
  frN=9+280*h;
  8.686*f*f*(0.0000000000184+0.01275*exp(-2239.1/T)/(frO+f*f/frO)+0.1068*exp(-3352/T)/(frN+f*f/frN));
);

// Inverse listener orientation from a normalized quaternion.
function p7_rotate(x,y,z) (
  p7_rx=p7_m00*x+p7_m01*y+p7_m02*z;
  p7_ry=p7_m10*x+p7_m11*y+p7_m12*z;
  p7_rz=p7_m20*x+p7_m21*y+p7_m22*z;
);

function p7_ear_path(st,x,y,z,base_delay,ear,kind,reset)
local(r hx hy hz ear_r dot extra d az el g material hi_mat mid_mat b fc q gain) (
  r=max(.2,p7_mag(x,y,z));
  p7_rotate(x,y,z); hx=p7_rx;hy=p7_ry;hz=p7_rz;
  ear_r=max(.12,p7_mag(hx-ear*.0875,hy,hz));
  dot=hx/r;
  // Bounded head-diffraction addition; magnitude comes from the fitted HRTF bank.
  extra=.0875*.65*max(0,-ear*dot);
  d=(ear_r+extra)/343*srate;
  d-=base_delay*(1-p7_sm_travel);
  d=max(1,1+d);
  st[20]=r; st[21]=ear_r; st[22]=d;
  p7_capture ? (st[0]=st[1];st[1]=min(d,p7_mask-2););
  reset ? (st[0]=d;st[1]=d;);
  material=kind==0 ? 1 : (kind==5 ? .62 : kind==6 ? .40 : .55);
  mid_mat=kind==0 ? 1 : (kind==5 ? .94 : .84);
  hi_mat=kind==0 ? 1 : (kind==5 ? .82 : kind==6 ? .42 : .60);
  g=material/ear_r;
  kind==0 ? g*=max(.2,p7_center_r)^(1-p7_sm_distance_gain)*(1-.65*sm_occ) : g*=sm_room*p71_actor_room;
  st[3]=g;
  st[5]=10^(-p7_alpha_lo*r*p7_sm_air/20);
  st[7]=10^(-p7_alpha_mid*r*p7_sm_air/20)*mid_mat;
  st[9]=10^(-p7_alpha_hi*r*p7_sm_air/20)*hi_mat;
  st[13]=kind==0 ? sm_occ : 0;
  reset ? (st[4]=st[3];st[6]=st[5];st[8]=st[7];st[10]=st[9];st[14]=st[13];st[11]=0;st[12]=0;st[15]=0;);
  az=p3d_angle_from_components(hx,hy);
  el=atan(hz/(sqrt(hx*hx+hy*hy)+0.000000000000000001))*180/$pi;
  ear>0 ? az=-az;
  st[23]=el;
  b=0;
  loop(6,
    fc=b==0 ? 1000 : b==1 ? 2300 : b==2 ? 4200 : b==3 ? 6300 : b==4 ? 8500 : 11500;
    q=b==0 ? .55 : b==1 ? .8 : b==2 ? 1.4 : b==3 ? 2.2 : b==4 ? 2.8 : 2.2;
    gain=p7_gain(az,el,b)*(0.4+0.6*sm_throw);
    // Push Out scales spectral detail, with a useful centered-height floor.
    gain*=b>=2 ? (0.65+0.35*sm_ext) : 1;
    p7_peak(st+32+b*12,fc*p7_sm_profile,q,gain,reset);
    b+=1;
  );
);

function p7_read(buf, pos, delay, mask) local(i f w0 w1 w2 w3) (
  delay = max(1,min(delay,mask-2));
  i=floor(delay); f=delay-i;
  w0=-f*(f-1)*(f-2)/6;
  w1=(f+1)*(f-1)*(f-2)/2;
  w2=-(f+1)*f*(f-2)/2;
  w3=(f+1)*f*(f-1)/6;
  buf[(pos-i+1)&mask]*w0 + buf[(pos-i)&mask]*w1 + buf[(pos-i-1)&mask]*w2 + buf[(pos-i-2)&mask]*w3;
);

function p7_path_tick(st,buf,pos) local(x low mid high y b occ) (
  x=p7_read(buf,pos,st[0],p7_mask)*(1-p7_delay_phase)+p7_read(buf,pos,st[1],p7_mask)*p7_delay_phase;
  st[4]+=(st[3]-st[4])*p7_coeff_k;
  st[6]+=(st[5]-st[6])*p7_coeff_k;st[8]+=(st[7]-st[8])*p7_coeff_k;st[10]+=(st[9]-st[10])*p7_coeff_k;
  st[14]+=(st[13]-st[14])*p7_coeff_k;
  st[11]=(1-p7_air_a1)*x+p7_air_a1*st[11]; low=st[11];
  st[12]=(1-p7_air_a2)*(x-low)+p7_air_a2*st[12]; mid=st[12];high=x-low-mid;
  y=low*st[6]+mid*st[8]+high*st[10];
  st[15]=(1-sm_occ_a)*y+sm_occ_a*st[15];
  y=y*(1-st[14])+st[15]*st[14];
  b=0;loop(6,y=p7_filter(st+32+b*12,y);b+=1;);
  y*st[4];
);

function p7_geometry(reset)
local(x y z requested f hw hd H eh extent ux uy r actor sx sy sz kind ix iy iz dl dr base st qn qw qx qy qz j clearance fade az el actor_clear actor_room) (
  // Smoothed world position, bounded by a fixed room and the exclusion radius.
  hw=(4+24*(sm_rsize*sm_rsize*(.72+.28*sm_rsize)))*.5;
  hd=(5+27*(sm_rsize*sm_rsize*(.72+.28*sm_rsize)))*.5;
  H=p7_sm_room_height;eh=min(H-.25,p7_sm_ear_height);
  p7_room_w=2*hw;p7_room_d=2*hd;p7_room_h=H;p7_ear_height=eh;
  // Smooth spherical direction and range independently: rotation cannot approach the head.
  az=p71_sm_az*$pi/180;el=p71_sm_el*$pi/180;
  requested=max(.2,p71_sm_range);
  x=requested*cos(el)*sin(az);y=requested*cos(el)*cos(az);z=requested*sin(el);
  r=requested;p7_center_r=r;p7_requested_r=requested;
  // Finite room applies only while the source is inside. Never pull an external source closer.
  clearance=min(min(hw-abs(x),hd-abs(y)),min(eh+z,H-eh-z));
  f=p3d_clamp(clearance/.30,0,1);p71_room_weight=f*f*(3-2*f);
  p7_boundary=clearance<.30;
  reset ? p71_sm_room_weight=p71_room_weight;
  p7_source_x=x;p7_source_y=y;p7_source_z=z;
  // Quaternion is interpolated along the short arc; yaw wrapping cannot sweep backwards.
  qn=sqrt(p7_sm_qw*p7_sm_qw+p7_sm_qx*p7_sm_qx+p7_sm_qy*p7_sm_qy+p7_sm_qz*p7_sm_qz);
  qw=p7_sm_qw/qn;qx=p7_sm_qx/qn;qy=p7_sm_qy/qn;qz=p7_sm_qz/qn;
  p7_m00=1-2*(qy*qy+qz*qz);p7_m01=2*(qx*qy+qw*qz);p7_m02=2*(qx*qz-qw*qy);
  p7_m10=2*(qx*qy-qw*qz);p7_m11=1-2*(qx*qx+qz*qz);p7_m12=2*(qy*qz+qw*qx);
  p7_m20=2*(qx*qz+qw*qy);p7_m21=2*(qy*qz-qw*qx);p7_m22=1-2*(qx*qx+qy*qy);
  // Two real source positions. Mono Size creates extent; Stereo/Dual use separated L/R feeds.
  extent=1.92*sm_width*(.5*mode_w0+.6*mode_w1+mode_w2+mode_w3)+.08*(mode_w1+mode_w2+mode_w3);
  // Azimuth defines source width even at the poles; no zero-length horizontal basis.
  ux=cos(az);uy=-sin(az);
  p71_extent=extent;
  p7_early_min=1000000000;
  actor=0;
  loop(2,
    sx=x+(actor==0 ? -.5 : .5)*extent*ux;
    sy=y+(actor==0 ? -.5 : .5)*extent*uy;
    sz=z;
    actor_clear=min(min(hw-abs(sx),hd-abs(sy)),min(eh+sz,H-eh-sz));
    actor_room=p3d_clamp(actor_clear/.30,0,1);
    p71_actor_room=actor_room*actor_room*(3-2*actor_room);
    p7_rotate(sx,sy,sz);
    r=max(.2,p7_mag(sx,sy,sz));
    dl=max(.12,p7_mag(p7_rx+.0875,p7_ry,p7_rz))+.0875*.65*max(0,p7_rx/r);
    dr=max(.12,p7_mag(p7_rx-.0875,p7_ry,p7_rz))+.0875*.65*max(0,-p7_rx/r);
    base=min(dl,dr)/343*srate;
    kind=0;
    loop(7,
      // Six first-order image sources: left, right, front, rear, floor, ceiling.
      ix=kind==1 ? -2*hw-sx : kind==2 ? 2*hw-sx : sx;
      iy=kind==3 ? 2*hd-sy : kind==4 ? -2*hd-sy : sy;
      iz=kind==5 ? -2*eh-sz : kind==6 ? 2*(H-eh)-sz : sz;
      st=p7_states+(actor*14+kind*2)*128;
      p7_ear_path(st,ix,iy,iz,base,-1,kind,reset);
      p7_ear_path(st+128,ix,iy,iz,base,1,kind,reset);
      kind>0 ? p7_early_min=min(p7_early_min,min(st[22],st[150]));
      kind+=1;
    );
    actor+=1;
  );
  // Nominal diffuse room constant; send remains independent of direct 1/r gain.
  p7_absorption_area=2*(4*hw*hd+2*hw*H+2*hd*H)*.35;
  p7_room_constant=p7_absorption_area/.65;
  p7_late_gain=sqrt(16*$pi/max(1,p7_room_constant));
  p7_critical_distance=sqrt(p7_room_constant/(16*$pi));
  p7_late_target=max(0,p7_early_min-sv_t_d1+.008*srate);
  reset ? p7_late_delay=p7_late_target;
);

// Non-expansive linear readers for the feedback tank; validity masks stale memory.
function p7_sv_read(buf,pos,d,mask,valid) local(i f a b) (
  i=floor(d); f=d-i;
  a = i<=valid ? buf[(pos-i)&mask] : 0;
  b = i+1<=valid ? buf[(pos-i-1)&mask] : 0;
  a+(b-a)*f;
);

function p3d_distance_m_from_n(n) local(b e d2 d3 m) (
  // Perceptual meter mapping. Local Distance 0..1 resolves 0.20..10 m.
  // Retain the existing extended law for out-of-range internal values.
  n < 0 ? n = 0;
  n > 4 ? n = 4;
  b = n;
  b > 1 ? b = 1;
  d2 = b*b;
  d3 = d2*b;
  m = 0.20 + 9.80*(0.72*d2 + 0.28*d3);
  n > 1 ? (
    e = n - 1;
    m += 10.0*e + 9.0*e*e;
  );
  m;
);

function p3d_far01_from_m(m) local(v den) (
  // Log-distance perceptual weight. 10 m lands around mid-far; 100+ m is
  // very far. This drives spectral/detail cues without turning Room into a
  // giant wet/reverb multiplier.
  m < 0.20 ? m = 0.20;
  den = log(121.0) - log(1.20);
  v = (log(1.0 + m) - log(1.20)) / den;
  v < 0 ? v = 0;
  v > 1 ? v = 1;
  v;
);

// Rate-sized buffers: all memory is allocated and cleared in @init.
er_bufsize = 16;
while (er_bufsize < ceil(0.250*srate)+8) (er_bufsize *= 2;);
er_mask = er_bufsize-1; er_wpos = 0; erbuf = 0;
itd_bufsize = 16;
while (itd_bufsize < ceil(0.002*srate)+8) (itd_bufsize *= 2;);
itd_mask = itd_bufsize-1; itd_wpos = 0; itdbuf = er_bufsize;
sceneverb_bufsize = 16;
while (sceneverb_bufsize < ceil(0.320*srate)+8) (sceneverb_bufsize *= 2;);
sceneverb_mask = sceneverb_bufsize-1;
sceneverb_buf = itdbuf+itd_bufsize;
sceneverb_side_buf = sceneverb_buf+sceneverb_bufsize;
sceneverb_wpos = 0; sceneverb_valid = 0;
sceneverb_lp = 0; sceneverb_side_lp = 0;
sceneverb_damp_l = 0; sceneverb_damp_r = 0;
sceneverb_side_damp_l = 0; sceneverb_side_damp_r = 0;
sceneverb_env = 0; sv_gate = 0; sv_xfade = 1;
sv_attack_k = 1-exp(-1/(0.000823*srate));
sv_release_k = 1-exp(-1/(0.011564*srate));
sv_gate_step = 1/max(1,0.010*srate);
sv_delay_step = 1/max(1,0.030*srate);
sv_k = 1-exp(-1/(0.020*srate));
sv_was_active = 0;
audio_memory_end = sceneverb_side_buf+sceneverb_bufsize;
memset(0,0,audio_memory_end);
seed_pending = 1; samples_since_init = 0;
mode_w0=1; mode_w1=0; mode_w2=0; mode_w3=0;
sm_throw=0.58;

// --- smoothing ---
// V6 recalculates smooth_k / coeff_k from the Motion Smooth slider in @block.
smooth_k = 1 - exp(-1/(0.090*srate));
coeff_k  = 1 - exp(-1/(0.140*srate));
meter_k  = 1 - exp(-1/(0.050*srate));

// --- filters / splits ---
split_fc = 1000;
split_a = exp(-2*$pi*split_fc/srate);

occ_split_fc = 650;
occ_split_a = exp(-2*$pi*occ_split_fc/srate);

band1_fc = 320;
band2_fc = 1800;
band1_a = exp(-2*$pi*band1_fc/srate);
band2_a = exp(-2*$pi*band2_fc/srate);

// --- reflection defaults ---
er_a1 = exp(-2*$pi*12500/srate);
er_a2 = exp(-2*$pi*9800/srate);
er_a3 = exp(-2*$pi*8000/srate);
er_a4 = exp(-2*$pi*6400/srate);
er_a5 = exp(-2*$pi*5200/srate);
er_a6 = exp(-2*$pi*4200/srate);
er_a7 = exp(-2*$pi*3200/srate);
er_a8 = exp(-2*$pi*2600/srate);

// --- smoothed params ---
// sm_az is the softened/cue-scaled azimuth, not the visual placement angle.
// V6.19 smooths the cue vector too; this avoids +/-180 rear wrap jumps and
// prevents center-front/back moves from sweeping through a fake left/right side.
sm_az = 0;
sm_cue_side = 0;
sm_cue_front = 1;
tgt_cue_side = 0;
tgt_cue_front = 1;
sm_depth = 0.25;
sm_far = 0;
sm_width = 0.10;
sm_ext = 0.42;
sm_room = 0.30;
sm_elev = 0;
sm_in_width = 0.75;
sm_bed_anchor = 0.45;
sm_rsize = 0.55;
sm_occ = 0;
sm_motion = 0.04;
sm_trim = 1;

// --- smoothed derived ---
sm_direct_g = 1;
sm_er_g = 0;
sm_air_a = 0.2;
sm_occ_a = 0.5;

sm_er1_d = 250;
sm_er2_d = 420;
sm_er3_d = 620;
sm_er4_d = 920;
sm_er5_d = 1300;
sm_er6_d = 1800;
sm_er7_d = 2450;
sm_er8_d = 3300;

// --- states ---
air_state = 0;
occ_lp = 0;
occ_low_mem = 0;
occ_ap_x1 = 0;
occ_ap_y1 = 0;

// Stable per-ear occlusion states.
// V6.2.2 localizes first, then colors each ear, so occlusion does not create
// a delayed/smeared mono event that can flicker in the opposite ear.
occ_dir_lp_l = 0;
occ_dir_lp_r = 0;
occ_dir_low_l = 0;
occ_dir_low_r = 0;

// head-shadow split states
l_low = 0;
r_low = 0;

// perceptual band split states
l_band1 = 0;
l_band2 = 0;
r_band1 = 0;
r_band2 = 0;

// ER filter states
er_lp1 = 0;
er_lp2 = 0;
er_lp3 = 0;
er_lp4 = 0;
er_lp5 = 0;
er_lp6 = 0;
er_lp7 = 0;
er_lp8 = 0;

// ER decorrelation allpass (per channel)
er_ap_x1_l = 0; er_ap_y1_l = 0;
er_ap_x1_r = 0; er_ap_y1_r = 0;

// Pinna (biquad) states
pn_x1_l = 0; pn_x2_l = 0; pn_y1_l = 0; pn_y2_l = 0;
pn_x1_r = 0; pn_x2_r = 0; pn_y1_r = 0; pn_y2_r = 0;

// Pinna coeffs (smoothed)
pn_b0_l = 1; pn_b1_l = 0; pn_b2_l = 0; pn_a1_l = 0; pn_a2_l = 0;
pn_b0_r = 1; pn_b1_r = 0; pn_b2_r = 0; pn_a1_r = 0; pn_a2_r = 0;

// Pinna coeff targets
pn_t_b0_l = 1; pn_t_b1_l = 0; pn_t_b2_l = 0; pn_t_a1_l = 0; pn_t_a2_l = 0;
pn_t_b0_r = 1; pn_t_b1_r = 0; pn_t_b2_r = 0; pn_t_a1_r = 0; pn_t_a2_r = 0;

// Rear tint (very mild)
rear_lp_l = 0;
rear_lp_r = 0;
rear_a = exp(-2*$pi*18000/srate);
rear_t_a = rear_a;
rear_mix = 0;
rear_t_mix = 0;

// Elevation feel filter states
elev_body_l = 0;
elev_body_r = 0;
elev_air_lp_l = 0;
elev_air_lp_r = 0;
elev_er_lp1 = 0;
elev_er_lp2 = 0;
elev_body_a = exp(-2*$pi*420/srate);
elev_air_a = exp(-2*$pi*6200/srate);

// Stereo / bed source-mode states
side_air_state = 0;
bed_air_l = 0;
bed_air_r = 0;
input_corr_l2 = 0;
input_corr_r2 = 0;
input_corr_lr = 0;
last_input_corr = 1;
last_input_mode = 0;
last_input_width_preserve = 0.75;
last_bed_anchor = 0.45;
last_source_warn = 0;

// Motion LFO
ph1 = 0;
ph2 = 0;

// meters / readouts
meter_direct = 0;
meter_er = 0;
last_itd_ms = 0;
last_air_fc = 18000;
last_dist_m = p3d_distance_m_from_n(p3d_clamp(slider7,0,1));
last_far01 = p3d_far01_from_m(last_dist_m);
last_elevation = 0;
last_ext_db = 0;
last_rear = 0;
last_focus = 1;
last_shadow = 0;
last_axis_lock = 1;
last_front = 1;
last_side = 0;
last_back = 0;
last_room_w = 4.8;
last_room_d = 5.6;

// V6 perceptual placement readouts
last_visual_az = 0;
last_cue_az = 0;
last_throw = 0.58;
last_throw_dsp = 0.58;
last_lat = 0;
last_fb = 0.82;
last_smooth_ms = 90;
last_cue_curve_eff = 1;
last_automation_safe = 1;

// UI interaction
ui_mode = 0;
ui_prev_l = 0;
ui_prev_r = 0;
ui_prev_m = 0;
ui_drag_start_x = 0;
ui_drag_start_y = 0;
ui_drag_start_v1 = 0;
ui_drag_start_v2 = 0;
ui_drag_start_v3 = 0;
ui_drag_bar = 0;

// UI-only state. GFX widgets edit the local slider-backed controls.
ui_sceneverb_drawer_open = 0;

slider_show(1,0); slider_show(2,0); slider_show(3,0); slider_show(4,0); slider_show(5,0);
slider_show(6,0); slider_show(7,0); slider_show(8,0); slider_show(9,0); slider_show(10,0);
slider_show(11,0); slider_show(12,0); slider_show(13,0); slider_show(14,0); slider_show(15,0);
slider_show(16,0); slider_show(17,0); slider_show(18,0); slider_show(19,0); slider_show(20,0); slider_show(21,0);
slider_show(22,0); slider_show(23,0); slider_show(24,0); slider_show(25,0);
slider_show(26,0); slider_show(27,0); slider_show(28,0); slider_show(29,0); slider_show(30,0); slider_show(31,0); slider_show(32,0); slider_show(33,0); slider_show(34,0); slider_show(35,0);


// All geometric histories and filter state allocated and cleared before audio.
p7_bufsize=16;while(p7_bufsize<ceil(.500*srate)+8)(p7_bufsize*=2;);
p7_mask=p7_bufsize-1;p7_wpos=0;
p7_buf_l=audio_memory_end;p7_buf_r=p7_buf_l+p7_bufsize;
p7_states=p7_buf_r+p7_bufsize;kemar=p7_states+28*128;
memset(p7_buf_l,0,2*p7_bufsize+28*128+3024);
audio_memory_end=kemar+3024;
p7_control_period=max(16,floor(.002*srate));p7_control_count=0;
p7_coeff_k=1-exp(-1/(.010*srate));
p7_delay_phase=1;p7_delay_step=1/max(1,.020*srate);p7_capture=1;
p7_air_a1=exp(-2*$pi*1000/srate);p7_air_a2=exp(-2*$pi*6000/srate);
p7_alpha_lo=p7_air_alpha(250);p7_alpha_mid=p7_air_alpha(3000);p7_alpha_hi=p7_air_alpha(10000);
p7_blend=0;p7_was_running=0;p7_filter_count=0;p7_pending_geometry=0;
p7_sm_qw=1;p7_sm_qx=0;p7_sm_qy=0;p7_sm_qz=0;
p7_high_lp=0;p7_high_lp_r=0;p7_high_energy=0;p7_total_energy=0;
ui71_follow=1;ui71_drag=0;ui71_prev_l=0;ui71_prev_r=0;ui71_cam_yaw=slider41;
ui7_open=0;ui7_drag=0;ui7_prev_l=0;ui7_prev_r=0;
slider_show(36,0);
slider_show(37,0);
slider_show(38,0);
slider_show(39,0);
slider_show(40,0);
slider_show(41,0);
slider_show(42,0);
slider_show(43,0);
slider_show(44,0);
slider_show(45,0);
// Six-band fit to MIT KEMAR compact data (Gardner & Martin, 1994).
// https://sound.media.mit.edu/resources/KEMAR.html
// Equalized log magnitudes, interpolated on -40..90 elevation / 10-degree azimuth grid.
kemar[0] = 1.96850438;
kemar[1] = 0.93665095;
kemar[2] = 2.72232481;
kemar[3] = -5.76690000;
kemar[4] = 3.21246001;
kemar[5] = -2.19571821;
kemar[6] = 0.44164674;
kemar[7] = 1.30309944;
kemar[8] = 1.79655192;
kemar[9] = -4.39533779;
kemar[10] = 1.61076235;
kemar[11] = -7.15215668;
kemar[12] = -0.96273130;
kemar[13] = 1.19723037;
kemar[14] = 0.77472172;
kemar[15] = -6.27985093;
kemar[16] = 1.33010088;
kemar[17] = -8.71753538;
kemar[18] = -2.30973765;
kemar[19] = 0.66442933;
kemar[20] = 0.38198068;
kemar[21] = -8.63631842;
kemar[22] = 0.27088309;
kemar[23] = -7.88711688;
kemar[24] = -3.50009213;
kemar[25] = -0.21966880;
kemar[26] = 0.05957439;
kemar[27] = -9.76355727;
kemar[28] = -2.67944090;
kemar[29] = -8.39384546;
