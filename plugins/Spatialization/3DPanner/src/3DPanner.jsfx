    slider36>=.5 ? (p71_pan_unmap(p3d_angle_from_components(slider6,slider8),slider17);slider6=ui71_pan_lat;slider8=ui71_pan_fb;);
    sliderchange(-1.0);
  ) : (near_src || inside_room) ? (
    ui_mode = 1;
    ui_drag_start_x = mouse_x;
    ui_drag_start_y = mouse_y;
    ui_drag_start_v1 = slider6;
    ui_drag_start_v2 = slider8;
    ui_drag_start_v3 = slider7;
  ) : hover_bar > 0 ? (
    ui_mode = 100 + hover_bar;
    ui_drag_bar = hover_bar;
    ui_drag_start_x = mouse_x;
    ui_drag_start_y = mouse_y;
    ui_drag_start_v1 =
      hover_bar == 1 ? slider6 :
      hover_bar == 2 ? slider8 :
      hover_bar == 3 ? slider7 :
      hover_bar == 4 ? slider9 :
      hover_bar == 5 ? slider10 :
      hover_bar == 6 ? slider11 :
      hover_bar == 7 ? slider21 :
      hover_bar == 8 ? slider12 :
      hover_bar == 9 ? slider13 :
      hover_bar == 10 ? slider14 : slider15;
  );
);

// --- drag actions ---
(mouse_l && ui_mode == 1) ? (
  mouse_alt ? (
    slider7 = ui_drag_start_v3 - (mouse_y - ui_drag_start_y) * 0.0028 / ui_s;
    slider7 < 0 ? slider7 = 0;
    slider7 > 1 ? slider7 = 1;
  ) : mouse_ctrl ? (
    slider6 = ui_drag_start_v1 + (mouse_x - ui_drag_start_x) * 0.0040 / ui_s;
    slider6 < -1 ? slider6 = -1;
    slider6 > 1 ? slider6 = 1;
  ) : mouse_shift ? (
    slider6 = ui_drag_start_v1 + (mouse_x - ui_drag_start_x) * 0.00135 / ui_s;
    slider8 = ui_drag_start_v2 - (mouse_y - ui_drag_start_y) * 0.00135 / ui_s;
    slider6 < -1 ? slider6 = -1; slider6 > 1 ? slider6 = 1;
    slider8 < -1 ? slider8 = -1; slider8 > 1 ? slider8 = 1;
    slider25 < 89.5 ? (
      pov_rad = slider25 * $pi / 180;
      pov_max_lat = abs(slider8) * sin(pov_rad) / (abs(cos(pov_rad)) + 0.000000000000000001);
      abs(slider6) > pov_max_lat ? (slider6 = slider6 >= 0 ? pov_max_lat : -pov_max_lat;);
    );
    rr = sqrt(slider6*slider6 + slider8*slider8);
    rr > 1 ? (slider6 /= rr; slider8 /= rr;);
  ) : (
    slider25 < 89.5 ? (
      xnorm = (mouse_x - cx) / (room_hw*0.82);
      xnorm < -1 ? xnorm = -1;
      xnorm > 1 ? xnorm = 1;
      dyn = (cy - mouse_y) / (room_hd*0.82);
      dyn < -1 ? dyn = -1;
      dyn > 1 ? dyn = 1;
      pov_rad = xnorm * slider25 * $pi / 180;
      dxn = abs(dyn) * sin(pov_rad) / (abs(cos(pov_rad)) + 0.000000000000000001);
      rr = sqrt(dxn*dxn + dyn*dyn);
      rr > 1 ? (dxn /= rr; dyn /= rr;);
      slider6 = dxn;
      slider8 = dyn;
    ) : (
      dxn = (mouse_x - cx) / (room_hw*0.82);
      dyn = (cy - mouse_y) / (room_hd*0.82);
      rr = sqrt(dxn*dxn + dyn*dyn);
      rr > 1 ? (
        dxn /= rr;
        dyn /= rr;
      );
      slider6 = dxn;
      slider8 = dyn;
    );
  );
  sliderchange(-1.0);
);

(mouse_l && ui_mode >= 101 && ui_mode < 200) ? (
  sid = ui_mode - 100;
  sid == 1 ? (mn=-1; mx=1;) :
  sid == 2 ? (mn=-1; mx=1;) :
  sid == 3 ? (mn=0; mx=1;) :
  sid == 4 ? (mn=0; mx=1;) :
  sid == 5 ? (mn=0; mx=1;) :
  sid == 6 ? (mn=0; mx=1;) :
  sid == 7 ? (mn=-1; mx=1;) :
  sid == 8 ? (mn=0; mx=1;) :
  sid == 9 ? (mn=0; mx=1;) :
  sid == 10 ? (mn=0; mx=1;) :
             (mn=-18; mx=12;);

  mouse_shift ? (
    v = ui_drag_start_v1 + (mouse_x - ui_drag_start_x) / barw * (mx - mn) * 0.25;
    v < mn ? v = mn;
    v > mx ? v = mx;
  ) : (
    nrm = (mouse_x - barx) / barw;
    nrm < 0 ? nrm = 0;
    nrm > 1 ? nrm = 1;
    v = mn + nrm * (mx - mn);
  );

  sid == 1 ? slider6 = v :
  sid == 2 ? slider8 = v :
  sid == 3 ? slider7 = v :
  sid == 4 ? slider9 = v :
  sid == 5 ? slider10 = v :
  sid == 6 ? slider11 = v :
  sid == 7 ? slider21 = v :
  sid == 8 ? slider12 = v :
  sid == 9 ? slider13 = v :
  sid == 10 ? slider14 = v : slider15 = v;

  sliderchange(-1.0);
);

(mouse_l && ui_mode >= 201 && ui_mode < 300) ? (
  sid = ui_mode - 200;
  sid == 1 ? (mn=1; mx=3;) : sid == 2 ? (mn=5; mx=250;) : (mn=0; mx=1;);
  mouse_shift ? (
    v = ui_drag_start_v1 + (mouse_x - ui_drag_start_x) / adv_barw * (mx - mn) * 0.25;
  ) : (
    nrm = (mouse_x - adv_barx) / adv_barw;
    nrm < 0 ? nrm = 0; nrm > 1 ? nrm = 1;
    v = mn + nrm * (mx - mn);
  );
  v < mn ? v = mn; v > mx ? v = mx;
  sid == 1 ? slider17 = v : sid == 2 ? slider18 = v : sid == 3 ? slider19 = v : sid == 4 ? slider23 = v : slider24 = v;
  sliderchange(-1.0);
);

(mouse_l && ui_mode >= 601 && ui_mode < 700) ? (
  sid = ui_mode - 600;
  mn = 0; mx = 1;
  mouse_shift ? (
    v = ui_drag_start_v1 + (mouse_x - ui_drag_start_x) / sv_bar_w * (mx - mn) * 0.25;
  ) : (
    nrm = (mouse_x - sv_bar_x) / sv_bar_w;
    nrm < 0 ? nrm = 0; nrm > 1 ? nrm = 1;
    v = mn + nrm * (mx - mn);
  );
  v < mn ? v = mn; v > mx ? v = mx;
  sid == 1 ? slider27 = v : sid == 2 ? slider28 = v : slider29 = v;
  sliderchange(-1.0);
);

(mouse_m && ui_mode == 300) ? (
  elev_step = mouse_shift ? 0.0016 : 0.0042;
  slider21 = ui_drag_start_v1 - (mouse_y - ui_drag_start_y) * elev_step / ui_s;
  slider21 < -1 ? slider21 = -1;
  slider21 > 1 ? slider21 = 1;
  sliderchange(-1.0);
);

(mouse_l && ui_mode == 400) ? (
  mouse_shift ? (
    slider25 = ui_drag_start_v1 + (mouse_x - ui_drag_start_x) * 0.12 / ui_s;
  ) : (
    pov_n = (mouse_x - pov_bar_x) / pov_bar_w;
    pov_n < 0 ? pov_n = 0;
    pov_n > 1 ? pov_n = 1;
    slider25 = pov_n * 90;
  );
  slider25 < 0 ? slider25 = 0;
  slider25 > 90 ? slider25 = 90;
  sliderchange(-1.0);
);

// finalize drag
(!mouse_l && ui_prev_l && ui_mode != 300) ? (
  ui_mode = 0;
  ui_drag_bar = 0;
  sliderchange(-1.0);
);
(!mouse_m && ui_prev_m && ui_mode == 300) ? (
  ui_mode = 0;
  ui_drag_bar = 0;
  sliderchange(-1.0);
);

ui_prev_l = mouse_l;
ui_prev_r = mouse_r;
ui_prev_m = mouse_m;

// refresh for drawing after interaction
ui_lat = slider6;
ui_dist = slider7;
// UI-only projection: never convert or write back slider7.
ui712_distance_m = p3d_distance_m_from_n(p3d_clamp(ui_dist,0,1));
ui712_far01 = p3d_far01_from_m(ui712_distance_m);
ui_fb = slider8;
ui_dist_vis = ui_dist;
ui_dist_vis < 0 ? ui_dist_vis = 0;
ui_dist_vis > 1 ? ui_dist_vis = 1;
ui_throw = slider9;
ui_size = slider10;
ui_push = slider11;
ui_room = slider12;
ui_elev = slider21;
ui_occ = slider13;
ui_motion = slider14;
ui_trim = slider15;
ui_safe = slider16 >= 0.5 ? 1 : 0;
ui_curve = slider17;
ui_smooth = slider18;
ui_rsize = slider19;
ui_source_mode = floor(slider22 + 0.5);
ui_source_mode < 0 ? ui_source_mode = 0;
ui_source_mode > 3 ? ui_source_mode = 3;
ui_src_width = slider23;
ui_bed_anchor = slider24;
ui_pov_deg = slider25;
ui_sceneverb_late = slider27;
ui_sceneverb_size = slider28;
ui_sceneverb_protect = slider29;
ui_sceneverb_on = ui_sceneverb_late > 0.00001 ? 1 : 0;
ui_sceneverb_role = floor(slider32 + 0.5);
ui_sceneverb_trim = slider33;

pos_r = sqrt(ui_lat*ui_lat + ui_fb*ui_fb);
pos_r > 1 ? (
  draw_lat = ui_lat / pos_r;
  draw_fb = ui_fb / pos_r;
  draw_r = 1;
) : (
  draw_lat = ui_lat;
  draw_fb = ui_fb;
  draw_r = pos_r;
);
// Physical drawing uses the same world coordinates as the image-source room.
slider36>=.5 ? (
  draw_lat=p7_source_x/max(.1,p7_room_w*.5*.82);
  draw_fb=p7_source_y/max(.1,p7_room_d*.5*.82);
  draw_r=sqrt(draw_lat*draw_lat+draw_fb*draw_fb);
);
sx = cx + draw_lat * room_hw * 0.82;
sy = cy - draw_fb  * room_hd * 0.82;

// V6.22 visual-only POV drag projection:
// During normal POV-limited canvas drag, the orange drag handle follows the
// mouse/raw stage position, while the actual sliders still receive the projected
// POV-cone target. This changes only the GFX affordance, not automation or DSP
// coordinate law.
src_draw_x = sx;
src_draw_y = sy;
drag_pov_project = (mouse_l && ui_mode == 1 && !mouse_alt && !mouse_ctrl && !mouse_shift && slider25 < 89.5) ? 1 : 0;
drag_pov_project ? (
  raw_dxn = (mouse_x - cx) / (room_hw*0.82);
  raw_dyn = (cy - mouse_y) / (room_hd*0.82);
  raw_dxn < -1 ? raw_dxn = -1; raw_dxn > 1 ? raw_dxn = 1;
  raw_dyn < -1 ? raw_dyn = -1; raw_dyn > 1 ? raw_dyn = 1;
  raw_rr = sqrt(raw_dxn*raw_dxn + raw_dyn*raw_dyn);
  raw_rr > 1 ? (
    raw_dxn /= raw_rr;
    raw_dyn /= raw_rr;
  );
  src_draw_x = cx + raw_dxn * room_hw * 0.82;
  src_draw_y = cy - raw_dyn * room_hd * 0.82;
);

cue_rad = last_cue_az * $pi/180;
ghost_x = slider36>=.5 ? draw_lat : sin(cue_rad)*draw_r;
ghost_y = slider36>=.5 ? draw_fb : cos(cue_rad)*draw_r;
gsx = cx + ghost_x * room_hw * 0.82;
gsy = cy - ghost_y * room_hd * 0.82;

// bounce points on room walls, visual coordinate
src_nx = draw_lat * 0.82;
src_ny = draw_fb * 0.82;

tL = (-1 - src_nx) / (-2 - src_nx + 0.000000000000000001);
bLx = -1;
bLy = src_ny + tL * (0 - src_ny);

tR = (1 - src_nx) / (2 - src_nx + 0.000000000000000001);
bRx = 1;
bRy = src_ny + tR * (0 - src_ny);

tF = (1 - src_ny) / (2 - src_ny + 0.000000000000000001);
bFx = src_nx + tF * (0 - src_nx);
bFy = 1;

tB = (-1 - src_ny) / (-2 - src_ny + 0.000000000000000001);
bBx = src_nx + tB * (0 - src_nx);
bBy = -1;

bpLx = cx + bLx * room_hw; bpLy = cy - bLy * room_hd;
bpRx = cx + bRx * room_hw; bpRy = cy - bRy * room_hd;
bpFx = cx + bFx * room_hw; bpFy = cy - bFy * room_hd;
bpBx = cx + bBx * room_hw; bpBy = cy - bBy * room_hd;

// --- colors ---
bg_r=0.056; bg_g=0.064; bg_b=0.078;
panel_r=0.100; panel_g=0.112; panel_b=0.140;
card_r=0.126; card_g=0.140; card_b=0.174;
line_r=0.235; line_g=0.260; line_b=0.320;
txt_r=0.94; txt_g=0.95; txt_b=0.98;
mut_r=0.56; mut_g=0.61; mut_b=0.69;
src_cr=0.97; src_cg=0.67; src_cb=0.16;
bounce_r=0.33; bounce_g=0.80; bounce_b=0.98;
occ_cr=0.83; occ_cg=0.38; occ_cb=0.96;
ok_r=0.58; ok_g=0.78; ok_b=0.51;
warn_r=0.96; warn_g=0.48; warn_b=0.18;

// --- background ---
gfx_set(bg_r,bg_g,bg_b,1); gfx_rect(0,0,gfx_w,gfx_h,1);

// fonts
fs1 = floor(18*ui_s); fs2 = floor(12*ui_s); fs3 = floor(10*ui_s); fs4 = floor(9*ui_s);
fs1 < 12 ? fs1 = 12; fs2 < 10 ? fs2 = 10; fs3 < 9 ? fs3 = 9; fs4 < 14 ? fs4 = 14; fs2 < 14 ? fs2 = 14;

// title
gfx_setfont(1,"Arial",fs1,'b');
gfx_set(txt_r,txt_g,txt_b,1);
gfx_x = pad; gfx_y = pad*0.45; gfx_printf("Hyperreal 3D Panner V7.1.2");

gfx_setfont(2,"Arial",fs2);
gfx_set(mut_r,mut_g,mut_b,1);
gfx_x = pad; gfx_y = pad*0.45 + fs1 + 1*ui_s;
slider36<.5 ? gfx_printf("Artistic | corrected DSP | local controls") : gfx_printf("Physical | ear paths, spectral fit and 3D room");

// main surfaces
gfx_set(panel_r,panel_g,panel_b,1);
gfx_rect(canvas_x, canvas_y, canvas_w, canvas_h);
gfx_roundrect(canvas_x, canvas_y, canvas_w, canvas_h, 14*ui_s, 1);
gfx_rect(c1x, c1y, c1w, c1h);
gfx_roundrect(c1x, c1y, c1w, c1h, 12*ui_s, 1);
gfx_rect(c2x, c2y, c2w, c2h);
gfx_roundrect(c2x, c2y, c2w, c2h, 12*ui_s, 1);
gfx_rect(c3x, c3y, c3w, c3h);
gfx_roundrect(c3x, c3y, c3w, c3h, 12*ui_s, 1);

// canvas inner
gfx_set(0.082,0.090,0.112,1);
gfx_rect(canvas_x+8*ui_s, canvas_y+8*ui_s, canvas_w-16*ui_s, canvas_h-16*ui_s);
gfx_roundrect(canvas_x+8*ui_s, canvas_y+8*ui_s, canvas_w-16*ui_s, canvas_h-16*ui_s, 12*ui_s, 1);

// stage room
gfx_set(0.112,0.124,0.158,1);
gfx_rect(room_l, room_t, room_hw*2, room_hd*2);
gfx_roundrect(room_l, room_t, room_hw*2, room_hd*2, 10*ui_s, 1);
gfx_set(0.38,0.43,0.52,0.95);
gfx_roundrect(room_l, room_t, room_hw*2, room_hd*2, 10*ui_s, 0);

// grid
gfx_set(0.23,0.26,0.33,0.55);
gfx_line(cx-room_hw, cy, cx+room_hw, cy);
gfx_line(cx, cy-room_hd, cx, cy+room_hd);
gfx_line(cx-room_hw*0.5, room_t, cx-room_hw*0.5, room_b);
gfx_line(cx+room_hw*0.5, room_t, cx+room_hw*0.5, room_b);
gfx_line(room_l, cy-room_hd*0.5, room_r, cy-room_hd*0.5);
gfx_line(room_l, cy+room_hd*0.5, room_r, cy+room_hd*0.5);

// snap rays
gfx_set(0.30,0.34,0.42,0.35);
a=-60*$pi/180; gfx_line(cx,cy,cx+sin(a)*room_hw*0.82,cy-cos(a)*room_hd*0.82);
a=-45*$pi/180; gfx_line(cx,cy,cx+sin(a)*room_hw*0.82,cy-cos(a)*room_hd*0.82);
a=-30*$pi/180; gfx_line(cx,cy,cx+sin(a)*room_hw*0.82,cy-cos(a)*room_hd*0.82);
a=30*$pi/180; gfx_line(cx,cy,cx+sin(a)*room_hw*0.82,cy-cos(a)*room_hd*0.82);
a=45*$pi/180; gfx_line(cx,cy,cx+sin(a)*room_hw*0.82,cy-cos(a)*room_hd*0.82);
a=60*$pi/180; gfx_line(cx,cy,cx+sin(a)*room_hw*0.82,cy-cos(a)*room_hd*0.82);

// room labels
gfx_setfont(3,"Arial",fs3,'b');
gfx_set(0.73,0.79,0.87,0.95);
gfx_x = cx - 30*ui_s; gfx_y = room_t - 16*ui_s; gfx_printf("FRONT");
gfx_x = room_l - 18*ui_s; gfx_y = cy - 5*ui_s; gfx_printf("L");
gfx_x = room_r + 10*ui_s; gfx_y = cy - 5*ui_s; gfx_printf("R");
gfx_set(0.70,0.58,0.85,0.95);
gfx_x = cx - 24*ui_s; gfx_y = room_b + 5*ui_s; gfx_printf("REAR");

// --- visual cue: Distance = range rings + air dashes, not a bigger source ---
range_min = min(room_hw, room_hd);
range_r1 = range_min * 0.25;
range_r2 = range_min * 0.50;
range_r3 = range_min * 0.75;
range_active = range_min * (0.18 + 0.70*ui_dist_vis);

// static reference rings
gfx_set(0.70,0.74,0.84,0.10); gfx_circle(cx,cy,range_r1,0,1);
gfx_set(0.70,0.74,0.84,0.08); gfx_circle(cx,cy,range_r2,0,1);
gfx_set(0.70,0.74,0.84,0.06); gfx_circle(cx,cy,range_r3,0,1);

// active distance ring brightens and expands with Distance
gfx_set(0.78,0.82,0.92,0.13 + 0.14*ui_dist_vis);
gfx_circle(cx,cy,range_active,0,1);

// small distance tick marks along the placement ray
seg_n = 5;
seg_i = 1;
loop(seg_n,
  seg_t = seg_i / (seg_n + 1);
  seg_x = cx + (sx-cx) * seg_t;
  seg_y = cy + (sy-cy) * seg_t;
  seg_a = (0.05 + 0.18*ui_dist_vis) * seg_t;
  gfx_set(0.78,0.82,0.92,seg_a);
  gfx_circle(seg_x, seg_y, (1.5 + 2.8*ui_dist_vis)*ui_s, 1, 1);
  seg_i += 1;
);

gfx_setfont(4,"Arial",fs4);
gfx_set(0.70,0.74,0.84,0.48);
gfx_x = room_l + 8*ui_s; gfx_y = room_b - 18*ui_s; gfx_printf("CLOSE");
gfx_x = cx - 10*ui_s; gfx_y = room_b - 18*ui_s; gfx_printf("MID");
gfx_x = room_r - 28*ui_s; gfx_y = room_b - 18*ui_s; gfx_printf("FAR");

// --- visual cue: Room = wall glow strength ---
(ui_room > 0.001) ? (
  glow_i = 0;
  loop(3,
    glow_o = (glow_i + 1) * 2.0*ui_s;
    glow_a = ui_room * (0.20 - glow_i*0.045);
    gfx_set(bounce_r,bounce_g,bounce_b,glow_a);
    gfx_roundrect(room_l-glow_o, room_t-glow_o, room_hw*2+glow_o*2, room_hd*2+glow_o*2, 10*ui_s+glow_o, 0);
    glow_i += 1;
  );
);

// direct visual path
gfx_set(src_cr,src_cg,src_cb,0.58 + 0.20*(1-ui_dist_vis));
gfx_line(cx, cy, sx, sy);

// cue ghost path
gfx_set(src_cr,src_cg,src_cb,0.22 + 0.12*ui_throw);
gfx_line(cx, cy, gsx, gsy);

// While dragging with the POV visual limiter, show that the mouse-following
// handle is being projected to the actual sound target. The target uses the
// same orange family as the source; the bridge line is blue so it reads as UI
// projection instead of audio path.
drag_pov_project ? (
  gfx_set(0.36,0.62,1.0,0.38);
  gfx_line(src_draw_x, src_draw_y, sx, sy);
  gfx_set(0.36,0.62,1.0,0.62);
  gfx_circle(sx, sy, dot_r + 6*ui_s, 0, 1);
  gfx_set(src_cr,src_cg,src_cb,0.78);
  gfx_circle(sx, sy, 3.2*ui_s, 1, 1);
);

// --- visual cue: Room = cyan early-bounce paths and wall-hit markers ---
bounce_a = 0.04 + 0.72*ui_room;
gfx_set(bounce_r,bounce_g,bounce_b,bounce_a);
gfx_line(sx, sy, bpLx, bpLy); gfx_line(bpLx, bpLy, cx, cy);
gfx_line(sx, sy, bpRx, bpRy); gfx_line(bpRx, bpRy, cx, cy);
gfx_line(sx, sy, bpFx, bpFy); gfx_line(bpFx, bpFy, cx, cy);
gfx_line(sx, sy, bpBx, bpBy); gfx_line(bpBx, bpBy, cx, cy);

// secondary stronger trace at high Room, gives a thicker-looking reflection web
(ui_room > 0.55) ? (
  gfx_set(bounce_r,bounce_g,bounce_b,(ui_room-0.55)*0.55);
  gfx_line(sx+1*ui_s, sy, bpLx+1*ui_s, bpLy); gfx_line(bpLx+1*ui_s, bpLy, cx+1*ui_s, cy);
  gfx_line(sx-1*ui_s, sy, bpRx-1*ui_s, bpRy); gfx_line(bpRx-1*ui_s, bpRy, cx-1*ui_s, cy);
  gfx_line(sx, sy+1*ui_s, bpFx, bpFy+1*ui_s); gfx_line(bpFx, bpFy+1*ui_s, cx, cy+1*ui_s);
  gfx_line(sx, sy-1*ui_s, bpBx, bpBy-1*ui_s); gfx_line(bpBx, bpBy-1*ui_s, cx, cy-1*ui_s);
);

// bounce markers fade down when Room is low; they no longer imply reflections are active at 0
bm_r = 2.5*ui_s + 5.2*ui_s*ui_room;
bm_a = 0.16 + 0.82*ui_room;
gfx_set(bounce_r,bounce_g,bounce_b,bm_a);
gfx_circle(bpLx, bpLy, bm_r, 1, 1);
gfx_circle(bpRx, bpRy, bm_r, 1, 1);
gfx_circle(bpFx, bpFy, bm_r, 1, 1);
gfx_circle(bpBx, bpBy, bm_r, 1, 1);

(ui_room > 0.30) ? (
  gfx_set(bounce_r,bounce_g,bounce_b,0.12 + 0.24*ui_room);
  gfx_circle(bpLx, bpLy, bm_r + 4.0*ui_s*ui_room, 0, 1);
  gfx_circle(bpRx, bpRy, bm_r + 4.0*ui_s*ui_room, 0, 1);
  gfx_circle(bpFx, bpFy, bm_r + 4.0*ui_s*ui_room, 0, 1);
  gfx_circle(bpBx, bpBy, bm_r + 4.0*ui_s*ui_room, 0, 1);
);

// occlusion wedge
(ui_occ > 0.001) ? (
  bx = cx + (sx-cx)*0.56;
  by = cy + (sy-cy)*0.56;
  wx = (sy-cy) * 0.09 * ui_occ;
  wy = -(sx-cx) * 0.09 * ui_occ;
  ax = cx + (sx-cx)*0.23;
  ay = cy + (sy-cy)*0.23;
  gfx_set(occ_cr,occ_cg,occ_cb,0.48 + 0.22*ui_occ);
  gfx_triangle(ax,ay, bx+wx,by+wy, bx-wx,by-wy);
);

// --- visual cue: Push Out = listener externalization shell, not distance ---
head_r = 17*ui_s;
(ui_push > 0.001) ? (
  shell_r = head_r + (10 + 52*ui_push)*ui_s;
  shell_a = 0.06 + 0.22*ui_push;
  gfx_set(src_cr,src_cg,src_cb,shell_a);
  gfx_circle(cx, cy, shell_r, 0, 1);
  gfx_set(bounce_r,bounce_g,bounce_b,0.04 + 0.16*ui_push);
  gfx_circle(cx, cy, shell_r + 8*ui_s, 0, 1);

  // faint ear-to-source separation rays appear only as Push Out rises
  ear_a = 0.05 + 0.16*ui_push;
  gfx_set(src_cr,src_cg,src_cb,ear_a);
  gfx_line(cx-21*ui_s, cy, sx, sy);
  gfx_line(cx+21*ui_s, cy, sx, sy);
);

// --- visual cue: Elevation = vertical height-feel stem/shadow ---
elev_abs_ui = abs(ui_elev);
(elev_abs_ui > 0.002) ? (
  elev_stem = (12 + 46*elev_abs_ui)*ui_s;
  elev_tip_y = ui_elev >= 0 ? src_draw_y - elev_stem : src_draw_y + elev_stem;
  // Upward = airy cyan/violet lift; downward = grounded violet shadow. This is visualized as height feel, not literal HRTF altitude.
  ui_elev >= 0 ? gfx_set(0.55,0.76,1.0,0.16 + 0.30*elev_abs_ui) : gfx_set(0.72,0.45,0.95,0.16 + 0.30*elev_abs_ui);
  gfx_line(src_draw_x, src_draw_y, src_draw_x, elev_tip_y);
  gfx_circle(src_draw_x, elev_tip_y, (4 + 10*elev_abs_ui)*ui_s, 0, 1);
  ui_elev < 0 ? (
    gfx_set(0.50,0.30,0.72,0.10 + 0.22*elev_abs_ui);
    gfx_circle(src_draw_x, src_draw_y + elev_stem*0.72, (10 + 24*elev_abs_ui)*ui_s, 0, 1);
  ) : (
    gfx_set(0.58,0.80,1.0,0.08 + 0.18*elev_abs_ui);
    gfx_circle(src_draw_x, src_draw_y - elev_stem*0.72, (8 + 22*elev_abs_ui)*ui_s, 0, 1);
  );
);

// cue ghost = effective DSP position after Spatial Throw/Cue Curve compression
ghost_r = dot_r*0.72;
gfx_set(src_cr,src_cg,src_cb,0.12 + 0.20*ui_throw);
gfx_circle(gsx, gsy, ghost_r, 1, 1);
gfx_set(src_cr,src_cg,src_cb,0.45 + 0.35*ui_throw);
gfx_circle(gsx, gsy, ghost_r + 3*ui_s, 0, 1);

// --- visual cue: Motion = green fading trail around source ---
(ui_motion > 0.002) ? (
  trail_n = 11;
  trail_i = 0;
  trail_amp = (4 + 28*ui_motion)*ui_s;
  trail_phase = ph1*0.70 + ph2*0.33;
  loop(trail_n,
    trail_t = trail_i / (trail_n - 1);
    trail_a = trail_phase - trail_t*(1.45 + 2.20*ui_motion)*$pi;
    trail_rr = trail_amp * (0.35 + 0.65*trail_t);
    tx = src_draw_x + cos(trail_a) * trail_rr;
    ty = src_draw_y + sin(trail_a) * trail_rr * 0.58;
    ta = (0.06 + 0.30*ui_motion) * (1 - trail_t);
    gfx_set(ok_r,ok_g,ok_b,ta);
    gfx_circle(tx, ty, (1.2 + 2.4*ui_motion)*ui_s, 1, 1);
    trail_i += 1;
  );
  gfx_set(ok_r,ok_g,ok_b,0.08 + 0.18*ui_motion);
  gfx_circle(src_draw_x, src_draw_y, trail_amp, 0, 1);
);

// --- visual cue: Size = orange source extent / diffusion ---
size_pow = ui_size^0.72;
halo_r = dot_r + (8 + 46*size_pow)*ui_s;
halo_a = 0.05 + 0.24*ui_size;
gfx_set(src_cr,src_cg,src_cb,halo_a);
gfx_circle(src_draw_x, src_draw_y, halo_r, 0, 1);
gfx_set(src_cr,src_cg,src_cb,0.04 + 0.14*ui_size);
gfx_circle(src_draw_x, src_draw_y, halo_r*0.58, 0, 1);

(ui_size > 0.12) ? (
  cloud_n = floor(4 + 14*ui_size);
  cloud_i = 0;
  loop(cloud_n,
    cloud_t = cloud_i / (cloud_n + 0.000001);
    ca = cloud_t*2*$pi + 0.55;
    cr = halo_r * (0.24 + 0.58*(cloud_i + 1)/(cloud_n + 1));
    px = src_draw_x + cos(ca)*cr;
    py = src_draw_y + sin(ca)*cr*0.68;
    pa = (0.06 + 0.20*ui_size) * (0.55 + 0.45*(cloud_n - cloud_i)/(cloud_n + 1));
    gfx_set(src_cr,src_cg,src_cb,pa);
    gfx_circle(px, py, (1.2 + 2.5*ui_size)*ui_s, 1, 1);
    cloud_i += 1;
  );
);

// focus crosshair fades out as Size becomes diffuse
focus_a_ui = 0.62 * (1 - ui_size);
(focus_a_ui > 0.02) ? (
  gfx_set(1,1,1,focus_a_ui);
  gfx_line(src_draw_x-13*ui_s, src_draw_y, src_draw_x+13*ui_s, src_draw_y);
  gfx_line(src_draw_x, src_draw_y-13*ui_s, src_draw_x, src_draw_y+13*ui_s);
);

// main source orb: size changes mildly; distance only dims the edge, avoiding size/distance confusion
core_a = 1 - 0.16*ui_dist_vis;
gfx_set(src_cr,src_cg,src_cb,core_a);
gfx_circle(src_draw_x, src_draw_y, dot_r, 1, 1);
gfx_set(1,0.88,0.55,0.35 + 0.20*(1-ui_dist_vis));
gfx_circle(src_draw_x, src_draw_y, dot_r + 1.8*ui_s, 0, 1);
gfx_set(0.12,0.12,0.13,1); gfx_circle(src_draw_x, src_draw_y, 2.6*ui_s, 1, 1);

// listener
gfx_set(0.60,0.66,0.76,1);
gfx_circle(cx, cy, head_r, 0, 1);
gfx_circle(cx-21*ui_s, cy, 5.1*ui_s, 0, 1);
gfx_circle(cx+21*ui_s, cy, 5.1*ui_s, 0, 1);
ui_head_yaw=slider36>=.5 ? slider41*$pi/180 : 0;
gfx_line(cx+sin(ui_head_yaw)*head_r,cy-cos(ui_head_yaw)*head_r,cx+sin(ui_head_yaw)*(head_r+9*ui_s),cy-cos(ui_head_yaw)*(head_r+9*ui_s));

// legend / readout on canvas
gfx_setfont(4,"Arial",fs4);
gfx_set(bounce_r,bounce_g,bounce_b,0.95);
gfx_x = canvas_x + 14*ui_s; gfx_y = canvas_y + 12*ui_s; gfx_printf("cyan = Room bounces");
gfx_set(src_cr,src_cg,src_cb,0.95);
gfx_x = canvas_x + 14*ui_s; gfx_y = canvas_y + 12*ui_s + fs4 + 4*ui_s; gfx_printf("orange halo = Size | ghost = cue");
gfx_set(0.78,0.82,0.92,0.82);
gfx_x = canvas_x + 14*ui_s; gfx_y = canvas_y + 12*ui_s + (fs4 + 4*ui_s)*2; gfx_printf("rings = Distance | shell = Push Out");
gfx_set(ok_r,ok_g,ok_b,0.82);
gfx_x = canvas_x + 14*ui_s; gfx_y = canvas_y + 12*ui_s + (fs4 + 4*ui_s)*3; gfx_printf("green trail = Motion | stem = Elevation");

// UI-only POV canvas range control. This is a drag affordance only; it does not
// touch the actual DSP coordinate law or existing automation mappings.
pov_n = ui_pov_deg / 90;
pov_n < 0 ? pov_n = 0; pov_n > 1 ? pov_n = 1;
gfx_set(0.11,0.14,0.19, hover_pov ? 0.96 : 0.82);
gfx_rect(pov_x,pov_y,pov_w,pov_h); gfx_roundrect(pov_x,pov_y,pov_w,pov_h,8*ui_s,1);
gfx_set(0.25,0.55,0.95, hover_pov ? 0.95 : 0.62);
gfx_roundrect(pov_x,pov_y,pov_w,pov_h,8*ui_s,0);
gfx_setfont(4,"Arial",fs4,'b');
gfx_set(0.86,0.92,1.0,1);
gfx_x = pov_x + 7*ui_s; gfx_y = pov_y + 5*ui_s; gfx_printf("POV");
gfx_set(0.20,0.23,0.29,1); gfx_rect(pov_bar_x,pov_bar_y,pov_bar_w,pov_bar_h); gfx_roundrect(pov_bar_x,pov_bar_y,pov_bar_w,pov_bar_h,4*ui_s,1);
gfx_set(0.36,0.62,1.0,1); gfx_rect(pov_bar_x,pov_bar_y,pov_bar_w*pov_n,pov_bar_h);
gfx_set(1,1,1, hover_pov ? 0.95 : 0.72); gfx_circle(pov_bar_x + pov_bar_w*pov_n, pov_bar_y+pov_bar_h*0.5, 3.2*ui_s,1,1);
gfx_setfont(4,"Arial",fs4);
gfx_set(0.74,0.82,0.94,1);
gfx_x = pov_x + pov_w - 47*ui_s; gfx_y = pov_y + 5*ui_s; gfx_printf("+/-%2.0f", ui_pov_deg);

ui71_active ? p71_follow_draw();
gfx_set(.12,.20,.29,1);gfx_rect(ui71_button_x,ui71_button_y,ui71_button_w,ui71_button_h);
gfx_set(.60,.80,1,1);gfx_roundrect(ui71_button_x,ui71_button_y,ui71_button_w,ui71_button_h,6*ui_s,0);
gfx_setfont(4,"Arial",fs4,'b');gfx_x=ui71_button_x+10*ui_s;gfx_y=ui71_button_y+6*ui_s;
slider36<.5 ? gfx_printf("FOLLOW: Physical") : ui71_active ? gfx_printf("View: FOLLOW") : gfx_printf("View: PLAN");

// chips
gfx_setfont(4,"Arial",fs4,'b');

active = hover_chip==1;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip1x,chip_y,chip_w,chip_h); gfx_roundrect(chip1x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip1x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("Center");

active = hover_chip==2;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip2x,chip_y,chip_w,chip_h); gfx_roundrect(chip2x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip2x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("30L");

active = hover_chip==3;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip3x,chip_y,chip_w,chip_h); gfx_roundrect(chip3x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip3x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("45L");

active = hover_chip==4;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip4x,chip_y,chip_w,chip_h); gfx_roundrect(chip4x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip4x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("60L");

active = hover_chip==5;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip5x,chip_y,chip_w,chip_h); gfx_roundrect(chip5x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip5x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("30R");

active = hover_chip==6;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip6x,chip_y,chip_w,chip_h); gfx_roundrect(chip6x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip6x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("45R");

active = hover_chip==7;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip7x,chip_y,chip_w,chip_h); gfx_roundrect(chip7x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip7x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("60R");

active = hover_chip==8;
gfx_set(active ? 0.22 : 0.15, active ? 0.24 : 0.17, active ? 0.30 : 0.22, 0.96);
gfx_rect(chip8x,chip_y,chip_w,chip_h); gfx_roundrect(chip8x,chip_y,chip_w,chip_h,7*ui_s,1);
gfx_set(active ? src_cr : mut_r, active ? src_cg : mut_g, active ? src_cb : mut_b, 1);
gfx_x = chip8x + 7*ui_s; gfx_y = chip_y + 5*ui_s; gfx_printf("Rear");

// --- right card 1: standalone object summary ---
gfx_setfont(2,"Arial",fs2,'b');
gfx_set(txt_r,txt_g,txt_b,1);
gfx_x = c1x + 14*ui_s; gfx_y = c1y + 10*ui_s; gfx_printf("Object");

// safe toggle remains on the primary surface because it matters for normal automation.
gfx_set(ui_safe ? ok_r : warn_r, ui_safe ? ok_g : warn_g, ui_safe ? ok_b : warn_b, hover_safe ? 0.95 : 0.75);
gfx_rect(safe_x,safe_y,safe_w,safe_h);
gfx_roundrect(safe_x,safe_y,safe_w,safe_h,8*ui_s,1);
gfx_set(0.08,0.09,0.11,1);
gfx_setfont(4,"Arial",fs4,'b');
gfx_x = safe_x + 9*ui_s; gfx_y = safe_y + 6*ui_s; ui_safe ? gfx_printf("AUTO SAFE") : gfx_printf("PERFORM");

// Source mode button: compact so standalone panning stays uncluttered.
gfx_set(hover_source_btn ? 0.20 : 0.13, hover_source_btn ? 0.28 : 0.18, hover_source_btn ? 0.38 : 0.25, 0.96);
gfx_rect(source_btn_x,source_btn_y,source_btn_w,source_btn_h);
gfx_roundrect(source_btn_x,source_btn_y,source_btn_w,source_btn_h,8*ui_s,1);
gfx_setfont(4,"Arial",fs4,'b');
gfx_set(0.82,0.90,0.98,1);
gfx_x = source_btn_x + 8*ui_s; gfx_y = source_btn_y + 6*ui_s;
ui_source_mode == 0 ? gfx_printf("MONO") : ui_source_mode == 1 ? gfx_printf("STEREO") : ui_source_mode == 2 ? gfx_printf("BED") : gfx_printf("DUAL");

// compact, isolation-safe status
gfx_setfont(3,"Arial",fs3);
gfx_set(0.88,0.91,0.96,1);
gfx_x = c1x + 14*ui_s; gfx_y = c1y + 36*ui_s; slider36>=.5 ? gfx_printf("Pan     %+.2f deg",p71_pan_angle(slider6,slider8,slider17)) : gfx_printf("Visual  %+.1f deg",last_visual_az);
gfx_x = c1x + 14*ui_s; gfx_y = c1y + 54*ui_s; slider36>=.5 ? gfx_printf("Height  %+.1f deg",slider21*90) : gfx_printf("Cue     %+.1f deg",last_cue_az);
gfx_x = c1x + 14*ui_s; gfx_y = c1y + 72*ui_s; slider36>=.5 ? gfx_printf("Range   %.1f ft",ui712_distance_m/.3048) : gfx_printf("Range   %.1f m",ui712_distance_m);
gfx_x = c1x + 14*ui_s; gfx_y = c1y + 90*ui_s;
last_source_warn ? gfx_set(warn_r,warn_g,warn_b,1) : gfx_set(0.88,0.91,0.96,1);
gfx_printf("Input r %.2f", last_input_corr);

// --- right card 2: control lanes ---
gfx_setfont(2,"Arial",fs2,'b');
gfx_set(txt_r,txt_g,txt_b,1);
gfx_x = c2x + 14*ui_s; gfx_y = c2y + 10*ui_s; gfx_printf("Quick Controls");

gfx_setfont(4,"Arial",fs4);

// bar drawing repeated
lat_n = (ui_lat + 1)*0.5;
fb_n = (ui_fb + 1)*0.5;
trim_n = (ui_trim + 18) / 30;

// 1 Lateral
gfx_set(0.92,0.94,0.97,1); gfx_x = c2x+14*ui_s; gfx_y = b1y-label_lift; gfx_printf("Lateral");
gfx_set(0.18,0.20,0.24,1); gfx_rect(barx,b1y,barw,barh); gfx_roundrect(barx,b1y,barw,barh,6*ui_s,1);
gfx_set(src_cr,src_cg,src_cb,1); gfx_rect(barx,b1y,barw*lat_n,barh);
gfx_set(0.08,0.08,0.10,0.65); gfx_line(barx+barw*0.5,b1y,barx+barw*0.5,b1y+barh);
gfx_set(1,1,1, hover_bar==1 ? 0.95 : 0.70); gfx_circle(barx + barw*lat_n, b1y + barh*0.5, 4.0*ui_s, 1, 1);
gfx_set(mut_r,mut_g,mut_b,1); gfx_x = valx; gfx_y = b1y-1*ui_s; gfx_printf("%+.2f", ui_lat);

// 2 Front/rear
gfx_set(0.92,0.94,0.97,1); gfx_x = c2x+14*ui_s; gfx_y = b2y-label_lift; gfx_printf("Front / Rear");
gfx_set(0.18,0.20,0.24,1); gfx_rect(barx,b2y,barw,barh); gfx_roundrect(barx,b2y,barw,barh,6*ui_s,1);
gfx_set(0.70,0.58,0.85,1); gfx_rect(barx,b2y,barw*fb_n,barh);
gfx_set(0.08,0.08,0.10,0.65); gfx_line(barx+barw*0.5,b2y,barx+barw*0.5,b2y+barh);
gfx_set(1,1,1, hover_bar==2 ? 0.95 : 0.70); gfx_circle(barx + barw*fb_n, b2y + barh*0.5, 4.0*ui_s, 1, 1);
gfx_set(mut_r,mut_g,mut_b,1); gfx_x = valx; gfx_y = b2y-1*ui_s; gfx_printf("%+.2f", ui_fb);

// 3 Distance
gfx_set(0.92,0.94,0.97,1); gfx_x = c2x+14*ui_s; gfx_y = b3y-label_lift; gfx_printf("Distance");
gfx_set(0.18,0.20,0.24,1); gfx_rect(barx,b3y,barw,barh); gfx_roundrect(barx,b3y,barw,barh,6*ui_s,1);
gfx_set(0.78,0.81,0.90,1); gfx_rect(barx,b3y,barw*ui_dist_vis,barh);
gfx_set(1,1,1, hover_bar==3 ? 0.95 : 0.70); gfx_circle(barx + barw*ui_dist_vis, b3y + barh*0.5, 4.0*ui_s, 1, 1);
gfx_set(mut_r,mut_g,mut_b,1); gfx_x = valx; gfx_y = b3y-1*ui_s; slider36>=.5 ? gfx_printf("%.1fft",ui712_distance_m/.3048) : gfx_printf("%.1fm",ui712_distance_m);

// 4 Throw
gfx_set(0.92,0.94,0.97,1); gfx_x = c2x+14*ui_s; gfx_y = b4y-label_lift; gfx_printf("Spatial Throw");
gfx_set(0.18,0.20,0.24,1); gfx_rect(barx,b4y,barw,barh); gfx_roundrect(barx,b4y,barw,barh,6*ui_s,1);
gfx_set(src_cr,src_cg,src_cb,1); gfx_rect(barx,b4y,barw*ui_throw,barh);
gfx_set(1,1,1, hover_bar==4 ? 0.95 : 0.70); gfx_circle(barx + barw*ui_throw, b4y + barh*0.5, 4.0*ui_s, 1, 1);
gfx_set(mut_r,mut_g,mut_b,1); gfx_x = valx; gfx_y = b4y-1*ui_s; gfx_printf("%.0f%%", ui_throw*100);

// 5 Size
gfx_set(0.92,0.94,0.97,1); gfx_x = c2x+14*ui_s; gfx_y = b5y-label_lift; gfx_printf("Size");
gfx_set(0.18,0.20,0.24,1); gfx_rect(barx,b5y,barw,barh); gfx_roundrect(barx,b5y,barw,barh,6*ui_s,1);
gfx_set(src_cr,src_cg,src_cb,1); gfx_rect(barx,b5y,barw*ui_size,barh);
gfx_set(1,1,1, hover_bar==5 ? 0.95 : 0.70); gfx_circle(barx + barw*ui_size, b5y + barh*0.5, 4.0*ui_s, 1, 1);
