desc:ERB Tilt EQ (Perceptual) - tilt + loudness comp + roughness guard

// Controls (4 knobs)
// #HELP: ERB tilt EQ: applies a smooth bright↔dark tilt using an ERB-spaced filterbank so the change feels consistent across the spectrum.
// #HELP: Pivot sets the “hinge” frequency; Tilt pushes lows and highs in opposite directions around that hinge (with a built-in safety clamp).
// #HELP: Comp keeps loudness steady by matching A-weighted energy before vs after the tilt (smoothed to avoid pumping).
// #HELP: Roughness Guard reduces harsh “fizz / grit” caused by high-band amplitude modulation by dynamically saturating only when roughness is detected.

// #TOOLTIP: Perceptual tilt in ERB space. Positive = brighter, negative = darker. Uses per-band gain with safety clamp to prevent extreme curves.
slider1:0<-18,18,0.1:log>Tilt (dB)
// #TOOLTIP: Frequency that stays “anchored” while tilting. Bands below pivot move opposite of bands above pivot (in ERB distance, not linear Hz).
slider2:1000<20,20000,1:log>Pivot (Hz)
// #TOOLTIP: Global loudness compensation based on A-weighted ERB-band energy (pre vs post). 0% = no comp, 100% = fully match perceived loudness across tilts.
slider3:100<0,100,1:sqr>Comp (Loudness) %
// #TOOLTIP: Anti-harshness guard for upper bands (≈2 kHz+): detects fast-vs-slow envelope divergence (AM roughness proxy) and applies modulation-driven soft saturation to reduce rough AM salience without killing brightness.
slider4:50<0,100,1:sqr>Roughness Guard %

@init
et_gain0=0;
et_freq0=0;
et_a0=0;
et_pre0=0;
et_post0=0;
et_fast0=0;
et_slow0=0;
et_gain1=0;
et_freq1=0;
et_a1=0;
et_pre1=0;
et_post1=0;
et_fast1=0;
et_slow1=0;
et_gain2=0;
et_freq2=0;
et_a2=0;
et_pre2=0;
et_post2=0;
et_fast2=0;
et_slow2=0;
et_gain3=0;
et_freq3=0;
et_a3=0;
et_pre3=0;
et_post3=0;
et_fast3=0;
et_slow3=0;
et_gain4=0;
et_freq4=0;
et_a4=0;
et_pre4=0;
et_post4=0;
et_fast4=0;
et_slow4=0;
et_gain5=0;
et_freq5=0;
et_a5=0;
et_pre5=0;
et_post5=0;
et_fast5=0;
et_slow5=0;
et_gain6=0;
et_freq6=0;
et_a6=0;
et_pre6=0;
et_post6=0;
et_fast6=0;
et_slow6=0;
et_gain7=0;
et_freq7=0;
et_a7=0;
et_pre7=0;
et_post7=0;
et_fast7=0;
et_slow7=0;
et_gain8=0;
et_freq8=0;
et_a8=0;
et_pre8=0;
et_post8=0;
et_fast8=0;
et_slow8=0;
et_gain9=0;
et_freq9=0;
et_a9=0;
et_pre9=0;
et_post9=0;
et_fast9=0;
et_slow9=0;
et_gain10=0;
et_freq10=0;
et_a10=0;
et_pre10=0;
et_post10=0;
et_fast10=0;
et_slow10=0;
et_gain11=0;
et_freq11=0;
et_a11=0;
et_pre11=0;
et_post11=0;
et_fast11=0;
et_slow11=0;
et_gain12=0;
et_freq12=0;
et_a12=0;
et_pre12=0;
et_post12=0;
et_fast12=0;
et_slow12=0;
et_gain13=0;
et_freq13=0;
et_a13=0;
et_pre13=0;
et_post13=0;
et_fast13=0;
et_slow13=0;
et_gain14=0;
et_freq14=0;
et_a14=0;
et_pre14=0;
et_post14=0;
et_fast14=0;
et_slow14=0;
et_gain15=0;
et_freq15=0;
et_pre15=0;
et_post15=0;
et_fast15=0;
et_slow15=0;
// ---------- constants ----------
pi = 3.141592653589793;
ln10 = 2.302585092994046;
inv_ln10 = 0.4342944819032518;
db2lin = 0.11512925464970229; // ln(10)/20

// ---------- filterbank config ----------
NB = 16;
NBm1 = 15;
rough_start_hz = 2000;

// ---------- memory layout ----------
mempos = 0;

lpL   = mempos; mempos += NBm1;
lpR   = mempos; mempos += NBm1;
lpA   = mempos; mempos += NBm1;

preE  = mempos; mempos += NB;
postE = mempos; mempos += NB;

envF  = mempos; mempos += NB;
envS  = mempos; mempos += NB;

gBand = mempos; mempos += NB;
wBand = mempos; mempos += NB;
fcBand = mempos; mempos += NB;
erbBand = mempos; mempos += NB;

memset(0, 0, mempos);

// ---------- state ----------
last_srate = 0;
global_gain = 1;

// ---------- functions ----------
function clamp(x, lo, hi)
(
  x < lo ? lo : (x > hi ? hi : x);
);

function erb_from_hz(f)
(
  // ERB number: 21.4 * log10(0.00437*f + 1)
  21.4 * log(0.00437*f + 1) * inv_ln10;
);

function hz_from_erb(e)
(
  // f = (10^(e/21.4) - 1) / 0.00437
  (exp((e/21.4) * ln10) - 1) / 0.00437;
);

function a_weight_amp(f)
(
  // A-weight amplitude ratio (not dB), derived from standard A-weighting:
  // A(f) = 20*log10(RA) + 2
  // amp = 10^(A/20) = 10^(0.1) * RA = 1.2589254117941673 * RA
  f2 = f*f;
  num = (12200*12200) * (f2*f2);
  den1 = f2 + (20.6*20.6);
  den2 = sqrt( (f2 + (107.7*107.7)) * (f2 + (737.9*737.9)) );
  den3 = f2 + (12200*12200);
  ra = num / (den1 * den2 * den3);
  ra * 1.2589254117941673;
);


function recalc_gains()
(
  tilt_db = slider1;
  pivot_hz = clamp(slider2, 20, fmax);
  erb_pivot = erb_from_hz(pivot_hz);

  // dB per ERB so that with pivot centered, edges land near +/- tilt_db
  slope = (2*tilt_db) / (erb_range + 0.000001);

  i = 0;
  while(i < NB)
  (
    gdB = slope * (erbBand[i] - erb_pivot);

    // SAFE clamp (prevents extreme pivot + tilt from going feral)
    gdB = clamp(gdB, -24, 24);

    gBand[i] = exp(gdB * db2lin);

    i += 1;
  );
);
function build_filterbank()
(
  work_srate = srate;
  work_srate < 1000 ? work_srate = last_good_srate;
  work_srate < 1000 ? work_srate = 48000;

  nyq = work_srate * 0.5;
  fmax = 20000;
  fmax > nyq*0.98 ? fmax = nyq*0.98;
  fmax < 40 ? fmax = 40;

  erb_min = erb_from_hz(20);
  erb_max = erb_from_hz(fmax);
  erb_range = erb_max - erb_min;
  erb_step = erb_range / NB;

  // per-band centers + weights
  i = 0;
  while(i < NB)
  (
    erb_c = erb_min + (i + 0.5) * erb_step;
    erbBand[i] = erb_c;

    fc = hz_from_erb(erb_c);
    fc > fmax ? fc = fmax;
    fcBand[i] = fc;

    aw = a_weight_amp(fc);
    wBand[i] = aw * aw;

    i += 1;
  );

  // crossover boundaries
  i = 0;
  while(i < NBm1)
  (
    erb_b = erb_min + (i + 1) * erb_step;
    f = hz_from_erb(erb_b);
    f > nyq*0.98 ? f = nyq*0.98;
    f < 10 ? f = 10;

    a = exp(-2*pi*f/work_srate);
    lpA[i] = a;

    i += 1;
  );

  tauE = 0.300;
  energy_smooth = 1 - exp(-1/(tauE*work_srate));

  tauF = 0.008;
  rough_fast = 1 - exp(-1/(tauF*work_srate));

  tauS = 0.080;
  rough_slow = 1 - exp(-1/(tauS*work_srate));

  gain_tau = 0.120;
);
// ---------- build once ----------
srate >= 1000 ? last_good_srate = srate;
build_filterbank();
recalc_gains();
last_srate = srate;

// GFX: ERB Tilt Visualizer (SAFE)
// ==============================
//
// What it shows (perceptual, not FFT):
//  - 16 ERB band centers on a log-frequency X axis
//  - 0 dB baseline
//  - Tilt curve (per-band gain in dB) as a polyline
//  - Global loudness compensation as a vertical offset (dB) + readout
//  - Pivot marker line
//  - Roughness Guard activity bars on high bands (uses envF/envS -> mod proxy)
//  - Optional faint pre/post energy bars (ERB energies), smoothed in UI
//
// ---------- state ----------
last_srate = 0;
last_good_srate = 48000;
global_gain = 1;
ext_noinit = 1;

// ---------- GFX state ----------
ui_bank = 0;

// gfx-private smoothing state
ui_pre  = mempos; mempos += NB;
ui_post = mempos; mempos += NB;
ui_mod  = mempos; mempos += NB;
ui_gdb  = mempos; mempos += NB;
ui_ggdb = mempos; mempos += 1;

// double-buffered snapshots (written in @block, read in @gfx)
snap_curve0 = mempos; mempos += NB;
snap_curve1 = mempos; mempos += NB;

snap_pre0   = mempos; mempos += NB;
snap_pre1   = mempos; mempos += NB;

snap_post0  = mempos; mempos += NB;
snap_post1  = mempos; mempos += NB;

snap_mod0   = mempos; mempos += NB;
snap_mod1   = mempos; mempos += NB;

snap_ggdb0  = mempos; mempos += 1;
snap_ggdb1  = mempos; mempos += 1;

// final clear AFTER all allocations
memset(0, 0, mempos);

// ---------- UI helper functions ----------
function log10_(x) ( log(x) * inv_ln10; );

function lin2db_(x)
(
  x <= 0.0000000001 ? -240 : (20 * log10_(x));
);

function sane_(x, fb)
(
  (x == x) && (abs(x) < 1000000000) ? x : fb;
);

function log10_(x)
(
  log(x) * inv_ln10;
);

function lin2db_(x)
(
  x <= 0.0000000001 ? -240 : (20 * log10_(x));
);


function hz_to_x_(f, x0, x1) local(f_hi l0 l1 t)
(
  f_hi = fmax;
  f_hi < 40 ? f_hi = 20000;

  f < 20 ? f = 20;
  f > f_hi ? f = f_hi;

  l0 = log(20);
  l1 = log(f_hi);
  t = (log(f) - l0) / (l1 - l0 + 0.000001);
  x0 + t * (x1 - x0);
);

function db_to_y_(db, y0, y1, db_range) local(mid scale)
(
  db = sane_(db, 0);
  mid = 0.5 * (y0 + y1);
  scale = (y1 - y0) / (2*db_range + 0.000001);
  mid - db * scale;
);
function draw_text_(x,y, str)
(
  gfx_x = x; gfx_y = y;
  gfx_drawstr(str);
);

function draw_line_(x1,y1,x2,y2)
(
  gfx_line(x1,y1,x2,y2,1);
);

function draw_rect_fill_(x,y,w,h)
(
  gfx_rect(x,y,w,h,1);
);

// tiny number formatter (no sprintf in JSFX)
function fmt_db_(v)
(
  // returns gfx_str by using gfx_printf if available; fallback: draw sign + integer-ish
  // Most JSFX support gfx_printf.
  gfx_printf("%.1f", v);
);

function draw_freq_tick_(f, label, x0, x1, y1)
(
  xx = hz_to_x_(f, x0, x1);
  gfx_r = 0.22; gfx_g = 0.22; gfx_b = 0.24; gfx_a = 1;
  gfx_line(xx, y1, xx, y1 + 4, 1);
  gfx_r = 0.65; gfx_g = 0.65; gfx_b = 0.68; gfx_a = 1;
  gfx_x = xx - 10; gfx_y = y1 + 8;
  gfx_drawstr(label);
);

@slider
comp_mix = slider3 / 100;
guard = slider4 / 100;
recalc_gains();

@block
// Publish previous block energy/follower state before compensation.
preE[0]=et_pre0;
postE[0]=et_post0;
envF[0]=et_fast0;
envS[0]=et_slow0;
preE[1]=et_pre1;
postE[1]=et_post1;
envF[1]=et_fast1;
envS[1]=et_slow1;
preE[2]=et_pre2;
postE[2]=et_post2;
envF[2]=et_fast2;
envS[2]=et_slow2;
preE[3]=et_pre3;
postE[3]=et_post3;
envF[3]=et_fast3;
envS[3]=et_slow3;
preE[4]=et_pre4;
postE[4]=et_post4;
envF[4]=et_fast4;
envS[4]=et_slow4;
preE[5]=et_pre5;
postE[5]=et_post5;
envF[5]=et_fast5;
envS[5]=et_slow5;
preE[6]=et_pre6;
postE[6]=et_post6;
envF[6]=et_fast6;
envS[6]=et_slow6;
preE[7]=et_pre7;
postE[7]=et_post7;
envF[7]=et_fast7;
envS[7]=et_slow7;
preE[8]=et_pre8;
postE[8]=et_post8;
envF[8]=et_fast8;
envS[8]=et_slow8;
preE[9]=et_pre9;
postE[9]=et_post9;
envF[9]=et_fast9;
envS[9]=et_slow9;
preE[10]=et_pre10;
postE[10]=et_post10;
envF[10]=et_fast10;
envS[10]=et_slow10;
preE[11]=et_pre11;
postE[11]=et_post11;
envF[11]=et_fast11;
envS[11]=et_slow11;
preE[12]=et_pre12;
postE[12]=et_post12;
envF[12]=et_fast12;
envS[12]=et_slow12;
preE[13]=et_pre13;
postE[13]=et_post13;
envF[13]=et_fast13;
envS[13]=et_slow13;
preE[14]=et_pre14;
postE[14]=et_post14;
envF[14]=et_fast14;
envS[14]=et_slow14;
preE[15]=et_pre15;
postE[15]=et_post15;
envF[15]=et_fast15;
envS[15]=et_slow15;
srate >= 1000 ? last_good_srate = srate;

// rebuild if sample rate changes
srate != last_srate ?
(
  memset(0, 0, mempos);
  build_filterbank();
  recalc_gains();
  last_srate = srate;
);

// loudness comp target (ERB-band energies, A-weighted)
Lpre = 0;
Lpost = 0;

i = 0;
while(i < NB)
(
  Lpre += wBand[i] * preE[i];
  Lpost += wBand[i] * postE[i];
  i += 1;
);

eps = 0.0000000001;
target = sqrt( (Lpre + eps) / (Lpost + eps) );
target = clamp(target, 0.25, 4);

blend = 1 + comp_mix * (target - 1);

// smooth global gain per block
alpha = exp( -samplesblock / (gain_tau*srate + 0.000001) );
global_gain = global_gain*alpha + blend*(1 - alpha);
// ---------- snapshot UI data into inactive bank ----------
u.next_bank = 1 - ui_bank;

u.next_bank ? (
  u.snap_curve = snap_curve1;
  u.snap_pre   = snap_pre1;
  u.snap_post  = snap_post1;
  u.snap_mod   = snap_mod1;
  u.snap_ggdb  = snap_ggdb1;
) : (
  u.snap_curve = snap_curve0;
  u.snap_pre   = snap_pre0;
  u.snap_post  = snap_post0;
  u.snap_mod   = snap_mod0;
  u.snap_ggdb  = snap_ggdb0;
);

u.gg_db = clamp(sane_(lin2db_(global_gain), 0), -24, 24);
u.snap_ggdb[0] = u.gg_db;

u.i = 0;
while(u.i < NB)
(
  u.bdB = clamp(sane_(lin2db_(gBand[u.i]) + u.gg_db, 0), -36, 36);
  u.snap_curve[u.i] = u.bdB;

  u.snap_pre[u.i]  = sane_(log(preE[u.i]  + 0.000000001), -20);
  u.snap_post[u.i] = sane_(log(postE[u.i] + 0.000000001), -20);

  u.m = 0;
  fcBand[u.i] > rough_start_hz ? (
    u.m = (envF[u.i] - envS[u.i]) / (envS[u.i] + 0.000001);
    u.m < 0 ? u.m = 0;
    u.sat = guard * u.m * 6;
    u.m = u.sat / (u.sat + 1);
  );
  u.snap_mod[u.i] = clamp(sane_(u.m, 0), 0, 1);

  u.i += 1;
);

ui_bank = u.next_bank;

et_gain0=gBand[0];
et_freq0=fcBand[0];
et_a0=lpA[0];
et_gain1=gBand[1];
et_freq1=fcBand[1];
et_a1=lpA[1];
et_gain2=gBand[2];
et_freq2=fcBand[2];
et_a2=lpA[2];
et_gain3=gBand[3];
et_freq3=fcBand[3];
et_a3=lpA[3];
et_gain4=gBand[4];
et_freq4=fcBand[4];
et_a4=lpA[4];
et_gain5=gBand[5];
et_freq5=fcBand[5];
et_a5=lpA[5];
et_gain6=gBand[6];
et_freq6=fcBand[6];
et_a6=lpA[6];
et_gain7=gBand[7];
et_freq7=fcBand[7];
et_a7=lpA[7];
et_gain8=gBand[8];
et_freq8=fcBand[8];
et_a8=lpA[8];
et_gain9=gBand[9];
et_freq9=fcBand[9];
et_a9=lpA[9];
et_gain10=gBand[10];
et_freq10=fcBand[10];
et_a10=lpA[10];
et_gain11=gBand[11];
et_freq11=fcBand[11];
et_a11=lpA[11];
et_gain12=gBand[12];
et_freq12=fcBand[12];
et_a12=lpA[12];
et_gain13=gBand[13];
et_freq13=fcBand[13];
et_a13=lpA[13];
et_gain14=gBand[14];
et_freq14=fcBand[14];
et_a14=lpA[14];
et_gain15=gBand[15];
et_freq15=fcBand[15];

@faust
// Whole fixed ERB bank; EEL retains coefficient setup, compensation and UI.
et_lp(a,x)=x:(step~_):(!,_) with {
    step(previous,value)=next,next with { next=(1-a)*value+a*previous; };
};
et_pole(c,x)=x:(step~_):(!,_) with {
    step(previous,value)=next,next with { next=previous+(value-previous)*c; };
};
et_guarded(c,on,x)=x:(step~_):(!,_) with {
    step(previous,value)=next,next with { next=previous+select2(on,0,(value-previous)*c); };
};
et_lp_l0=et_lp(et_a0,spl0);
et_lp_l1=et_lp(et_a1,spl0);
et_lp_l2=et_lp(et_a2,spl0);
et_lp_l3=et_lp(et_a3,spl0);
et_lp_l4=et_lp(et_a4,spl0);
et_lp_l5=et_lp(et_a5,spl0);
et_lp_l6=et_lp(et_a6,spl0);
et_lp_l7=et_lp(et_a7,spl0);
et_lp_l8=et_lp(et_a8,spl0);
et_lp_l9=et_lp(et_a9,spl0);
et_lp_l10=et_lp(et_a10,spl0);
et_lp_l11=et_lp(et_a11,spl0);
et_lp_l12=et_lp(et_a12,spl0);
et_lp_l13=et_lp(et_a13,spl0);
et_lp_l14=et_lp(et_a14,spl0);
et_band_l0=et_lp_l0;
et_band_l1=et_lp_l1-et_lp_l0;
et_band_l2=et_lp_l2-et_lp_l1;
et_band_l3=et_lp_l3-et_lp_l2;
et_band_l4=et_lp_l4-et_lp_l3;
et_band_l5=et_lp_l5-et_lp_l4;
et_band_l6=et_lp_l6-et_lp_l5;
et_band_l7=et_lp_l7-et_lp_l6;
et_band_l8=et_lp_l8-et_lp_l7;
et_band_l9=et_lp_l9-et_lp_l8;
et_band_l10=et_lp_l10-et_lp_l9;
et_band_l11=et_lp_l11-et_lp_l10;
et_band_l12=et_lp_l12-et_lp_l11;
et_band_l13=et_lp_l13-et_lp_l12;
et_band_l14=et_lp_l14-et_lp_l13;
et_band_l15=spl0-et_lp_l14;
et_lp_r0=et_lp(et_a0,spl1);
et_lp_r1=et_lp(et_a1,spl1);
et_lp_r2=et_lp(et_a2,spl1);
et_lp_r3=et_lp(et_a3,spl1);
et_lp_r4=et_lp(et_a4,spl1);
et_lp_r5=et_lp(et_a5,spl1);
et_lp_r6=et_lp(et_a6,spl1);
et_lp_r7=et_lp(et_a7,spl1);
et_lp_r8=et_lp(et_a8,spl1);
et_lp_r9=et_lp(et_a9,spl1);
et_lp_r10=et_lp(et_a10,spl1);
et_lp_r11=et_lp(et_a11,spl1);
et_lp_r12=et_lp(et_a12,spl1);
et_lp_r13=et_lp(et_a13,spl1);
et_lp_r14=et_lp(et_a14,spl1);
et_band_r0=et_lp_r0;
et_band_r1=et_lp_r1-et_lp_r0;
et_band_r2=et_lp_r2-et_lp_r1;
et_band_r3=et_lp_r3-et_lp_r2;
et_band_r4=et_lp_r4-et_lp_r3;
et_band_r5=et_lp_r5-et_lp_r4;
et_band_r6=et_lp_r6-et_lp_r5;
et_band_r7=et_lp_r7-et_lp_r6;
et_band_r8=et_lp_r8-et_lp_r7;
et_band_r9=et_lp_r9-et_lp_r8;
et_band_r10=et_lp_r10-et_lp_r9;
et_band_r11=et_lp_r11-et_lp_r10;
et_band_r12=et_lp_r12-et_lp_r11;
et_band_r13=et_lp_r13-et_lp_r12;
et_band_r14=et_lp_r14-et_lp_r13;
et_band_r15=spl1-et_lp_r14;
et_pre0=et_pole(energy_smooth,0.5*(et_band_l0*et_band_l0+et_band_r0*et_band_r0));
et_y_l0=et_band_l0*et_gain0;
et_y_r0=et_band_r0*et_gain0;
