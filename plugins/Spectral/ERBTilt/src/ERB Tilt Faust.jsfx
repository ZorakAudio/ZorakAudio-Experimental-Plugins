process=((((((((((((((((0.0+et_out_l0)+et_out_l1)+et_out_l2)+et_out_l3)+et_out_l4)+et_out_l5)+et_out_l6)+et_out_l7)+et_out_l8)+et_out_l9)+et_out_l10)+et_out_l11)+et_out_l12)+et_out_l13)+et_out_l14)+et_out_l15)*global_gain,((((((((((((((((0.0+et_out_r0)+et_out_r1)+et_out_r2)+et_out_r3)+et_out_r4)+et_out_r5)+et_out_r6)+et_out_r7)+et_out_r8)+et_out_r9)+et_out_r10)+et_out_r11)+et_out_r12)+et_out_r13)+et_out_r14)+et_out_r15)*global_gain;

@block
// Publish current block detector values for the existing display.
preE[0]=et_pre0;
postE[0]=et_post0;
envF[0]=et_fast0;
envS[0]=et_slow0;
preE[1]=et_pre1;
postE[1]=et_post1;
envF[1]=et_fast1;
envS[1]=et_slow1;
preE[2]=et_pre2;
postE[2]=et_post2;
envF[2]=et_fast2;
envS[2]=et_slow2;
