st_motion3=0;
st_gain3=1;
st_b4_0=0;
st_b4_1=0;
st_b4_2=0;
st_b4_3=0;
st_b4_4=0;
st_target4=1;
st_env4=0;
st_log4=0;
st_d14=0;
st_d24=0;
st_motion4=0;
st_gain4=1;
st_b5_0=0;
st_b5_1=0;
st_b5_2=0;
st_b5_3=0;
st_b5_4=0;
st_target5=1;
st_env5=0;
st_log5=0;
st_d15=0;
st_d25=0;
st_motion5=0;
st_gain5=1;
st_b6_0=0;
st_b6_1=0;
st_b6_2=0;
st_b6_3=0;
st_b6_4=0;
st_target6=1;
st_env6=0;
st_log6=0;
st_d16=0;
