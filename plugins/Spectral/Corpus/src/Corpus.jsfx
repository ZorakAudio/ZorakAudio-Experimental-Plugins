      h_bt=floor(q[4]+((g_h[2]+g_h[3])/g_h[4]-m[3])/max(0.000000001,m[4])*(q[5]-q[4])+0.5);
      when>=h_bt && gid<m[1]+m[2]-1 ? (gid+=1;g_h=cp_g(gid););
      h_bt=floor(q[4]+(g_h[2]/g_h[4]-m[3])/max(0.000000001,m[4])*(q[5]-q[4])+0.5);
      when<h_bt && gid>m[1] ? (gid-=1;g_h=cp_g(gid););
