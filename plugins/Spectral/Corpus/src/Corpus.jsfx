    lag>=2 && lag<xc_read_count/2 ? (
      dot=0;aa=0;bb=0;i=0;n=min(128,xc_read_count-lag);
      loop(n,k=floor(i*(xc_read_count-lag)/n);
        dot+=xc_time[k*2]*xc_time[(k+lag)*2]+xc_time[k*2+1]*xc_time[(k+lag)*2+1];
        aa+=xc_time[k*2]^2+xc_time[k*2+1]^2;bb+=xc_time[(k+lag)*2]^2+xc_time[(k+lag)*2+1]^2;i+=1;
      );cc=dot/sqrt(max(0.000000000000000001,aa*bb));
      cc>bestcorr ? (bestcorr=cc;bestperiod=lag/s[3];);
    );j+=1;
  );
