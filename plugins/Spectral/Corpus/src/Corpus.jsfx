function tr_capture(id e t) local(r i p req got err conf strength total wt rec head) (
  e[5]>=traj_runtime_base[5] ? (
  pe_excerpt(id,cp_w(floor((e-event_base)/64)*walker_per_event)[41],cp_w(floor((e-event_base)/64)*walker_per_event)[42]);pe_span_use=1;
  r=traj_runtime_base;e[5]!=r[5] || e!=r[6] ? (tr_history_clear();r[5]=e[5];r[6]=e;);r[2]=tr_progress(e,t);total=0;wt=0;r[1]=0;i=0;
  loop(12,p=tr_lane(i);tr_enabled(i) ? (
