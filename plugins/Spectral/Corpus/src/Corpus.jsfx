function ui_hit(x y w h) (
  !ui_input_blocked && ui_mouse_in && ui_mx>=x && ui_mx<x+w && ui_my>=y && ui_my<y+h;
);
function ui_box(x y w h r g b) (
  y+ui_oy+h>=0 && y+ui_oy<=ui_vh ? (ui_color(r,g,b,1);gfx_rect(x+ui_ox,y+ui_oy,max(0,w),max(0,h),1););
);
function ui_border(x y w h r g b) (
  y+ui_oy+h>=0 && y+ui_oy<=ui_vh ? (ui_color(r,g,b,1);gfx_rect(x+ui_ox,y+ui_oy,max(0,w),max(0,h),0););
);
function ui_text(x y w size text r g b) (
