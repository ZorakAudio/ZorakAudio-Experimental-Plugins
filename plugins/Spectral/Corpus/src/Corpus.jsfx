    );
  );
);
function cp_poll() local(gen state adopted signature)
(
  sample_pool_set_mode(bank_pool,slider13>0 ? 1 : 0);
  sample_pool_set_budget_mb(bank_pool,max(0,slider13));
  sample_pool_commit(bank_pool);
  pool_state=sample_pool_state(bank_pool); pool_selected=sample_pool_selected(bank_pool);
  pool_loaded=sample_pool_loaded(bank_pool); pool_failed=sample_pool_failed(bank_pool);
  pool_ram=sample_pool_ram_mb(bank_pool); gen=sample_pool_generation(bank_pool);
  signature=gen+pool_loaded*8191+pool_failed*131+pool_state*17+pool_selected*32771;
  (signature!=loaded_signature || rebuild_request || !have_generation) && pool_state!=1 && pool_state!=2 ? pending_adoption=1;
  pending_adoption && cp_busy()==0 && cp_hold_count()==0 && pool_state!=1 && pool_state!=2 ? (
    adopted=sample_pool_adopt(bank_pool);
    adopted>=0 ? (
      generation=sample_pool_generation(bank_pool); have_generation=1;
      loaded_signature=generation+sample_pool_loaded(bank_pool)*8191+sample_pool_failed(bank_pool)*131+sample_pool_state(bank_pool)*17+sample_pool_selected(bank_pool)*32771;
      pending_adoption=0; rebuild_request=0; cp_begin();
    );
  );
);

// ---------------- Event-owned, bounded linear + child walkers ----------------
function cp_release(ei when) local(e from) (
  ei>=0 ? (e=cp_e(ei);e[0]>0 && when<e[9] ? (
    from=cp_env(e,when);e[9]=when;e[10]=when+max(1,e[19]);e[11]=from;e[18]=0;e[22]=0;
  ););
);
// Natural mode is a finite, evidence-conditioned event, never an infinite
// background task. Explicit MIDI duration/Note Off remains authoritative.
function xc_natural_poll(w e when) local(idx st q old z chance total u mean)
(
  idx=floor((e-event_base)/64);st=xc_states+idx*64;q=h_state+idx*96;
  e[40]>0 && e[18]>0 && w[4]==0 ? (
    when>=e[41] ? (
      cp_release(idx,when);e[40]=0;xc_end_reason=2;xc_end_caps+=1;
    ) : (
      st[11]!=q[18] && q[0]==e[1] && q[1]>=2 ? (
        old=st[10];
        old>=0 && old<hm_k && xc_grammar_ready && xc_params[11]>0 ? (
          z=xc_endstats+old*4;chance=z[3]*xc_params[11];mean=z[0]>0 ? z[2]/z[0] : 0;
          when-e[5]>=max(srate*0.25,mean*srate) && z[1]>0 && h_rnd(q)<chance ? (
            cp_release(idx,when);e[40]=0;xc_end_reason=1;xc_learned_ends+=1;
          );
        );st[10]=q[14];st[11]=q[18];
      );
    );
  );
);
// Brush audition owns a separate, bounded overlapping pool within the 64 voices.
// Generated events fade once on entering a brush gesture. Existing audition
// voices are not hard cut; over-budget ones get a causal 30 ms release.
function xc_audition_prepare() local(i v e oldest oldesttime n releasing)
(
  clock-xc_last_audition>srate*0.30 ? (
    i=0;loop(8,e=cp_e(i);e[0]>0 ? cp_stop_event(i,clock,max(8,floor(srate*0.015)));i+=1;);
  );
  n=0;oldest=-1;oldesttime=1000000000000;i=0;
  loop(voice_list_n,v=cp_v(voice_list[i]);v[26]<0 && v[0]>0 && v[14]>clock && v[30]<=v[29] ? (
    n+=1;v[2]<oldesttime ? (oldesttime=v[2];oldest=voice_list[i];);
  );i+=1;);
  n>=4 && oldest>=0 ? (
    v=cp_v(oldest);v[29]=clock;v[30]=clock+max(8,floor(srate*0.030));v[14]=min(v[14],v[30]);xc_preview_steals+=1;
  );xc_last_audition=clock;xc_audition_count+=1;
);

function cp_trace(id prev bridge t dur score relax rolefit phase kind serial srcpos frames gain pan) local(z d g) (
  trace_head=(trace_head+1)%100;trace_n=min(100,trace_n+1);z=trace_base+trace_head*40;
  g=cp_g(id);memset(z,0,40);
  z[0]=id;z[1]=prev;z[2]=bridge;z[3]=t;z[4]=dur;z[5]=score;z[6]=relax;z[7]=rolefit;
  z[8]=phase;z[9]=kind;z[10]=serial;z[11]=srcpos/max(1,g[4]);z[12]=frames/max(1,g[4]);
  z[13]=score_target;z[14]=score_identity;z[15]=score_seam;z[16]=score_history;z[17]=g[1]+1;
  z[18]=gain;z[19]=pan;d=0;loop(8,
    z[20+d]=cp_feat(id,d);z[28+d]=prev>=0 ? cp_feat(id,d)-cp_feat(prev,d) : 0;d+=1;
  );z[36]=index_epoch;z[37]=selection_serial;z[38]=0;z[39]=phase_release;
  h_t=h_trace_base+trace_head*8;memset(h_t,-1,8);h_t[0]=id;h_t[7]=serial;
