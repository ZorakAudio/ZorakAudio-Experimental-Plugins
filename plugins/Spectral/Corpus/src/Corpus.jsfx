    memset(path_best,-1,32);total=0;pass=0;
    loop(2,axis=pass==0 ? cp_clamp(cp_axis(0),0,53) : cp_clamp(cp_axis(1),0,53);b=min(15,floor((pass==0 ? map_target_x : map_target_y)*16));bin=max(0,b-1);
      while(bin<=min(15,b+1))(
