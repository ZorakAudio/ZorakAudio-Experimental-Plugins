          member=h_choose_realization(guide,src,q,slider58);h_set_meso(q,member,guide,start,end);q[26]=cycle;
          q[6]=p[13];q[15]=p[13]>=0 ? hx_episodes[p[13]*128+6] : -1;
        );q[25]=source;
