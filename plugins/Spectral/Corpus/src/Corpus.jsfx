    q[80]=-1;q[81]=-1;q[2]=-1;q[3]=-1;q[6]=-1;q[14]=-1;q[15]=-1;q[21]=h_epoch;q[25]=-1;q[27]=0;
    q[13]=max(1,e[17]+65537);q[13]-=floor(q[13]/2147483647)*2147483647;
    q[1]==3 && hx_n<=0 ? (q[1]=2;q[17]+=1;h_runtime_backoff+=1;);
  );
  q[1]>=2 && h_ready && q[21]==h_epoch ? (
    h_q=q;src=floor(slider14);h_active=1;h_effect=cp_01(slider57);
    e[42]>0 ? (
      e[42]<1.5 ? (
        guide=cp_clamp(floor(e[43]),0,max(0,hm_n-1));p=h_m(guide);
        q[2]<0 || q[3]!=guide ? (member=h_choose_realization(guide,src,q,slider58);h_set_meso(q,member,guide,e[5],e[10]);q[6]=p[13];q[15]=p[13]>=0 ? h_x(p[13])[6] : -1;q[25]=p[0];);
      ) : (
        macroguide=cp_clamp(floor(e[43]),0,max(0,hx_n-1));m=h_x(macroguide);q[6]=macroguide;q[15]=m[6];q[25]=m[0];
        m[117]>0.5 ? (h_is_rest=1;h_until=e[10];q[23]=1;q[27]=1;) : (
          frac=cp_01((when-e[5])/max(1,e[10]-e[5]));seconds=m[3]+frac*m[4];guide=h_at_time(m[0],min(m[3]+m[4]-0.000000001,seconds+0.0000000001));
          guide>=m[1] && guide<m[1]+m[2] ? (p=h_m(guide);start=e[5]+(p[3]-m[3])/max(0.000001,m[4])*(e[10]-e[5]);end=start+p[4]/max(0.000001,m[4])*(e[10]-e[5]);guide!=q[3] ? (member=h_choose_realization(guide,src,q,slider58);h_set_meso(q,member,guide,start,end););) : (h_active=0;q[23]=2;);
        );
