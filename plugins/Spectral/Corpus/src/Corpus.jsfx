);
block_midi_count=0;block_note_count=0;walk_clock=block_start_clock;
while(midirecv(moff,m1,m23)) (
  mstatus=m1&240;mchan=m1&15;mnote=m23&127;mvel=(m23>>8)&127;
  at_clock=block_start_clock+cp_clamp(floor(moff),0,max(0,samplesblock-1));
