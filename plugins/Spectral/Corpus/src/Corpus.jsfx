    q[72]+=1;i=0;loop(8,b=0;loop(3,
      value=max(0,1-abs(2*cp_feat(id,i)-b));q[48+i*3+b]+=value;b+=1;
    );i+=1;);
  );
);

// Contextual PE preprocessing is advanced only while no event/voice is active.
function pe_sorted_median(n) local(i j z) (
  i=1;while(i<n)(z=pe_sort[i];j=i-1;while(j>=0 && pe_sort[j]>z)(pe_sort[j+1]=pe_sort[j];j-=1;);pe_sort[j+1]=z;i+=1;);
  n>0 ? (pe_sort[floor((n-1)/2)]+pe_sort[floor(n/2)])*0.5 : 0;
);
function pe_ref_add(id t weight context) local(i at j g q duplicate sa sb ha hb) (
  id>=0 && id<grain_count && weight>0 && pe_p(id)[14]>=0.999999999 ? (
    duplicate=0;i=0;loop(pe_nr,pe_refs[i*4]==id ? duplicate=1;
      pe_ref_mode==1 ? (sa=cp_g(id)[1];sb=cp_g(pe_refs[i*4])[1];ha=pe_source_hash+sa*4;hb=pe_source_hash+sb*4;
        sa!=sb && ha[0]==hb[0] && ha[1]==hb[1] && ha[2]==hb[2] && ha[3]==hb[3] ? duplicate=1;
      );i+=1;
    );
    !duplicate ? (
      at=0;while(at<pe_nr && pe_refs[at*4+3]<=context)(at+=1;);
      at<32 ? (j=min(31,pe_nr);while(j>at)(memcpy(pe_refs+j*4,pe_refs+(j-1)*4,4);j-=1;);
        q=pe_refs+at*4;q[0]=id;q[1]=t;q[2]=weight;q[3]=context;pe_nr=min(32,pe_nr+1);
      );
    );
  );
);
function pe_region_refs(id) local(g mi m a b j q t guard) (
  pe_nr=0;pe_ref_mode=0;g=cp_g(id);mi=hm_grainmap[id];
  mi>=0 && mi<hm_n ? (
    m=h_m(mi);a=max(m[1],id-40);b=min(m[1]+m[2],id+41);j=a;guard=max(1,g[4]*0.002);
    while(j<b)(q=cp_g(j);
      j!=id && (q[2]+q[3]+guard<=g[2] || q[2]>=g[2]+g[3]+guard) ? (
        t=((q[2]+q[3]*0.5)-(g[2]+g[3]*0.5))/max(1,g[4]*m[4]);
        pe_ref_add(j,t,1,abs(t));
      );j+=1;
    );
  );
);
function pe_context_cost(a b) local(ga gb pa pb na nb d cost n) (
  ga=cp_g(a);gb=cp_g(b);pa=xc_prev(a);pb=xc_prev(b);na=xc_next(a);nb=xc_next(b);cost=0;n=0;
  // Conditioning uses surrounding grains, never the target feature vector.
  pa>=0 && pb>=0 ? (d=0;loop(16,cost+=abs(pe_v(pa)[d]-pe_v(pb)[d])*(d<8 ? 0.125 : 1);d+=1;);n+=9;);
  na>=0 && nb>=0 ? (d=0;loop(16,cost+=abs(pe_v(na)[d]-pe_v(nb)[d])*(d<8 ? 0.125 : 1);d+=1;);n+=9;);
  n>0 ? cost/n : 0.5;
);
function pe_ec_refs(id) local(g mi m u k cls wt c lo n j ep p gid time ctx sourcea sourceb dup i q same) (
  pe_nr=0;pe_ref_mode=1;g=cp_g(id);mi=hm_grainmap[id];
  mi>=0 && mi<hm_n ? (
    m=h_m(mi);u=cp_01(((g[2]+g[3]*0.5)/g[4]-m[3])/max(0.000001,m[4]));k=0;
    loop(3,cls=m[6+k];wt=m[9+k];
      cls>=0 && wt>0.01 ? (
        n=h_class_range(0,cls,0);lo=h_range_lo;j=0;
        loop(min(40,n),ep=hm_list[lo+min(n-1,floor((j+0.5)*n/max(1,min(40,n))))];
          ep!=mi ? (
            p=h_m(ep);time=(p[3]+u*p[4]);gid=pe_at(p[0],floor(time*cp_s(p[0])[3]));
            gid>=p[1] && gid<p[1]+p[2] ? (
              sourcea=pe_source_hash+g[1]*4;sourceb=pe_source_hash+p[0]*4;
              dup=p[0]!=g[1] && sourcea[0]==sourceb[0] && sourcea[1]==sourceb[1] && sourcea[2]==sourceb[2];
              !dup ? (ctx=pe_context_cost(id,gid)+0.05*abs(log(max(0.01,p[4])/max(0.01,m[4])));pe_ref_add(gid,0,wt,ctx););
            );
          );j+=1;
        );
      );k+=1;
    );
    // Balance repeated observations from one source, retain independent regions.
    i=0;loop(pe_nr,q=pe_refs+i*4;same=0;j=0;loop(pe_nr,cp_g(pe_refs[j*4])[1]==cp_g(q[0])[1] ? same+=1;j+=1;);
      q[2]/=sqrt(max(1,same));q[2]*=exp(-q[3]*8);i+=1;
    );
  );
);
function pe_fit(id which) local(d i j q x y w sw sx sxx sy sxy den a b r scale h raw total weights fw z target confidence best bestd eff sw2 pass p ctx dispersion) (
  p=pe_p(id);p[which]=0.5;p[2+which]=0;p[4+which]=0;p[6+which]=pe_nr;
  pe_nr>=3 && p[14]>=0.999999999 ? (
    total=0;weights=0;best=-1;bestd=-1;eff=0;sw=0;sw2=0;ctx=0;i=0;
    loop(pe_nr,q=pe_refs+i*4;sw+=q[2];sw2+=q[2]*q[2];ctx+=q[2]*q[3];i+=1;);
    eff=sw*sw/max(0.000000000001,sw2);confidence=cp_01((eff-2)/10);which==1 ? confidence*=exp(-ctx/max(0.000001,sw)*2);
    d=0;loop(16,
      i=0;loop(pe_nr,pe_fit_weights[i]=pe_refs[i*4+2];i+=1;);pass=0;scale=0.025;
      loop(2,
        sw=0;sx=0;sxx=0;sy=0;sxy=0;i=0;
        loop(pe_nr,q=pe_refs+i*4;x=q[1];y=pe_v(q[0])[d];w=pe_fit_weights[i];sw+=w;sx+=w*x;sxx+=w*x*x;sy+=w*y;sxy+=w*x*y;i+=1;);
        den=sw*sxx-sx*sx;b=which==0 && den>0.00000001 ? (sw*sxy-sx*sy)/den : 0;a=(sy-b*sx)/max(0.000001,sw);
        i=0;loop(pe_nr,q=pe_refs+i*4;r=pe_v(q[0])[d]-a-b*q[1];pe_sort[i]=abs(r);i+=1;);scale=max(0.025,pe_sorted_median(pe_nr)*1.4826);
        i=0;loop(pe_nr,q=pe_refs+i*4;r=abs(pe_v(q[0])[d]-a-b*q[1]);pe_fit_weights[i]=q[2]*min(1,1.5*scale/max(0.000001,r));i+=1;);pass+=1;
      );
      // PRESS residuals penalize an overfitted temporal trend. Target stays held out.
      i=0;loop(pe_nr,q=pe_refs+i*4;x=q[1];w=pe_fit_weights[i];h=w/max(0.000001,sw);
        which==0 && den>0.00000001 ? h+=w*sw*(x-sx/max(0.000001,sw))^2/den;
        pe_sort[i]=abs(pe_v(q[0])[d]-a-b*x)/max(0.15,1-h);i+=1;
      );
      scale=max(0.025,pe_sorted_median(pe_nr)*1.4826)*sqrt(1+1/max(1,eff-2));
      z=abs(pe_v(id)[d]-a)/scale;raw=z<=1.5 ? z*z*0.5 : 1.5*(z-0.75);
      fw=d<8 ? 0.125 : 1;total+=raw*fw;weights+=fw;raw*fw>best ? (best=raw*fw;bestd=d;);d+=1;
    );
    raw=sqrt(2*total/max(0.000001,weights));p[which]=raw/(2+raw);p[2+which]=confidence;p[4+which]=raw;p[6+which]=eff;p[9+which]=bestd;p[11+which]=best;
  );
);
// Up to three reference-only modes avoid treating the average of unlike EC
// members as an expected sound. The held-out target never fits a mode or prior.
function pe_ec_fit(id) local(n k i j d c best dist far seed iter q v center weight total count good mode raw conf eff likelihood mass prior bestpost bestd besterr p entropy) (
  n=pe_nr;p=pe_p(id);p[15]=1;
  n<8 ? pe_fit(id,1) : (
    memcpy(pe_ref_copy,pe_refs,128);k=min(3,floor(n/4));memset(pe_centers,0,48);
    memcpy(pe_centers,pe_v(pe_refs[0]),16);c=1;
    loop(k-1,far=-1;seed=0;i=0;
      loop(n,v=pe_v(pe_refs[i*4]);best=1000000;j=0;
        loop(c,dist=0;d=0;loop(16,dist+=(v[d]-pe_centers[j*16+d])^2*(d<8 ? 0.125 : 1);d+=1;);best=min(best,dist);j+=1;);
        best>far ? (far=best;seed=i;);i+=1;
      );memcpy(pe_centers+c*16,pe_v(pe_refs[seed*4]),16);c+=1;
    );
    iter=0;loop(4,
      memset(pe_center_sums,0,48);memset(pe_cluster_mass,0,8);i=0;
      loop(n,q=pe_ref_copy+i*4;v=pe_v(q[0]);best=1000000;mode=0;c=0;
        loop(k,dist=0;d=0;loop(16,dist+=(v[d]-pe_centers[c*16+d])^2*(d<8 ? 0.125 : 1);d+=1;);dist<best ? (best=dist;mode=c;);c+=1;);
        pe_cluster_id[i]=mode;pe_cluster_mass[mode]+=q[2];pe_cluster_mass[4+mode]+=1;d=0;
        loop(16,pe_center_sums[mode*16+d]+=q[2]*v[d];d+=1;);i+=1;
      );c=0;loop(k,pe_cluster_mass[c]>0 ? (d=0;loop(16,pe_centers[c*16+d]=pe_center_sums[c*16+d]/pe_cluster_mass[c];d+=1;););c+=1;);iter+=1;
    );
    good=0;c=0;total=0;loop(k,pe_cluster_mass[4+c]>=3 ? good+=1;total+=pe_cluster_mass[c];c+=1;);
    good<2 ? (memcpy(pe_refs,pe_ref_copy,128);pe_nr=n;pe_fit(id,1);) : (
      c=0;likelihood=0;conf=0;eff=0;mass=0;entropy=0;bestpost=-1;bestd=-1;besterr=0;
      loop(k,pe_cluster_mass[4+c]>=3 ? (
        pe_nr=0;i=0;loop(n,pe_cluster_id[i]==c ? (memcpy(pe_refs+pe_nr*4,pe_ref_copy+i*4,4);pe_nr+=1;);i+=1;);
        pe_fit(id,1);prior=pe_cluster_mass[c]/max(0.000000001,total);raw=p[5];entropy-=prior*log(max(0.000000001,prior));
        p[3]>0 ? (weight=prior*exp(-min(700,raw*raw*0.5));likelihood+=weight;mass+=prior;conf+=prior*p[3];eff+=p[7];
          weight>bestpost ? (bestpost=weight;bestd=p[10];besterr=p[12];);
        );
      );c+=1;);
      raw=mass>0 ? sqrt(max(0,-2*log(max(0.000000000001,likelihood/mass)))) : 0;
      p[1]=mass>0 ? raw/(2+raw) : 0.5;p[3]=conf*(1-0.35*cp_01(entropy/max(0.000001,log(good))));p[5]=raw;p[7]=eff;p[10]=bestd;p[12]=besterr;p[15]=good;
      memcpy(pe_refs,pe_ref_copy,128);pe_nr=n;
    );
  );
);
function pe_begin() local(i p) (
  pe_ready=0;pe_phase=1;pe_cursor=0;pe_offset=0;pe_frames=0;pe_reads=0;pe_read_errors=0;pe_ffts=0;pe_fits=0;pe_epoch=index_epoch;
  pe_nfft=quality_request<1 ? 512 : (quality_request>1 ? 2048 : 1024);
  memset(pe_vectors,0,grain_count*16);memset(pe_stats,0,grain_count*16);memset(pe_source_hash,0,source_count*4);
  i=0;loop(source_count,p=pe_source_hash+i*4;p[0]=104729;p[1]=130363;p[2]=cp_s(i)[2];p[3]=cp_s(i)[3];i+=1;);
  pe_frame_read=0;pe_subphase=0;pg_ready=0;cc_begin();
);
function pe_frame_begin() local(g n) (
  g=cp_g(pe_cursor);pe_offset==0 ? cc_grain_begin(pe_cursor);pe_count=min(pe_nfft,g[3]-pe_offset);pe_frame_read=0;
  memset(pe_fft_l,0,pe_nfft*2);memset(pe_fft_r,0,pe_nfft*2);memset(pe_tmp,0,32);
  pe_lpow=0;pe_rpow=0;pe_cross=0;pe_peak=0;pe_diff=0;pe_last_l=0;pe_last_r=0;pe_subphase=1;
);
function pe_frame_end() local(g v p i k power freq total sum second flat peak band win n value prior) (
  g=cp_g(pe_cursor);v=pe_v(pe_cursor);p=pe_p(pe_cursor);
  fft(pe_fft_l,pe_nfft);fft_permute(pe_fft_l,pe_nfft);fft(pe_fft_r,pe_nfft);fft_permute(pe_fft_r,pe_nfft);pe_ffts+=2;
  i=1;total=0;sum=0;second=0;flat=0;
  while(i<pe_nfft/2)(power=pe_fft_l[i*2]^2+pe_fft_l[i*2+1]^2+pe_fft_r[i*2]^2+pe_fft_r[i*2+1]^2;freq=i*g[4]/pe_nfft;
    band=freq<125 ? 0 : (freq<250 ? 1 : (freq<500 ? 2 : (freq<1000 ? 3 : (freq<2000 ? 4 : (freq<4000 ? 5 : (freq<8000 ? 6 : 7))))));
    pe_tmp[band]+=power;total+=power;sum+=power*freq;second+=power*freq*freq;flat+=log(max(0.000000000000000001,power));i+=1;
  );i=0;loop(8,pe_tmp[i]=sqrt(pe_tmp[i]/max(0.000000000000000001,total));i+=1;);
  value=sqrt((pe_lpow+pe_rpow)/max(1,pe_count*2));
  pe_tmp[8]=cp_01((cp_db(value)+100)/100);pe_tmp[9]=cp_01(cp_db(pe_peak/max(0.000000000001,value))/36);
  pe_tmp[10]=total>0.000000000000000001 ? cp_01(exp(flat/max(1,pe_nfft/2-1))/(total/max(1,pe_nfft/2-1))) : 0;
  pe_tmp[11]=cp_01(sum/max(0.000000000000000001,total)/max(1,g[4]*0.5));
  pe_tmp[12]=cp_01(sqrt(max(0,second/max(0.000000000000000001,total)-(sum/max(0.000000000000000001,total))^2))/max(1,g[4]*0.5));
  pe_tmp[13]=0.5+0.5*pe_cross/sqrt(max(0.000000000000000001,pe_lpow*pe_rpow));
  pe_tmp[14]=0.5+0.5*(pe_rpow-pe_lpow)/max(0.000000000000000001,pe_rpow+pe_lpow);
  pe_tmp[15]=cp_01(sqrt(pe_diff/max(0.000000000000000001,pe_lpow+pe_rpow))*0.5);
  i=0;loop(16,v[i]+=cp_01(pe_tmp[i])*pe_count;i+=1;);p[13]+=1;
  pe_offset+=pe_count;pe_frames+=1;pe_subphase=0;
  pe_offset>=g[3] ? (cc_grain_end(pe_cursor);i=0;loop(16,v[i]/=max(1,g[3]);i+=1;);p[8]=hm_grainmap[pe_cursor];p[14]/=max(1,g[3]);pe_offset=0;pe_cursor+=1;);
);
function pe_build(work) local(g p l r x win take i z hash key d prev q) (
  pe_phase==1 ? (
    pe_cursor<grain_count ? (
      !pe_subphase ? pe_frame_begin();g=cp_g(pe_cursor);hash=pe_source_hash+g[1]*4;take=min(work,pe_count-pe_frame_read);
      loop(take,
        sample_read2(bank_pool,g[0],g[2]+pe_offset+pe_frame_read,l,r) && l==l && r==r && abs(l)<=1000000 && abs(r)<=1000000 ? pe_p(pe_cursor)[14]+=1 : (l=0;r=0;pe_read_errors+=1;);
        source_mono ? (l=cp_fold(l,r);r=l;);cc_feed((l*l+r*r)*0.5);
        win=pe_count>1 ? 0.5-0.5*cos(2*$pi*pe_frame_read/(pe_count-1)) : 1;
        pe_fft_l[pe_frame_read*2]=l*win;pe_fft_r[pe_frame_read*2]=r*win;
        pe_lpow+=l*l;pe_rpow+=r*r;pe_cross+=l*r;pe_peak=max(pe_peak,max(abs(l),abs(r)));
        pe_frame_read>0 ? pe_diff+=(l-pe_last_l)^2+(r-pe_last_r)^2;pe_last_l=l;pe_last_r=r;
        x=floor(cp_clamp(l,-8,8)*1048576)+8388608;z=floor(cp_clamp(r,-8,8)*1048576)+8388608;
        // EEL's % coerces to signed integers; use exact-double modular arithmetic
        // so the rolling hash cannot wrap negative before taking the modulus.
        key=hash[0]*131+x*17+z;hash[0]=key-floor(key/16777213)*16777213;
        key=hash[1]*137+x+z*19;hash[1]=key-floor(key/16777199)*16777199;
        pe_frame_read+=1;pe_reads+=1;
      );pe_frame_read>=pe_count ? pe_frame_end();
    );pe_cursor>=grain_count ? (pe_phase=2;pe_cursor=0;);
  ) : pe_phase==2 ? (
    pe_cursor<grain_count ? (pe_region_refs(pe_cursor);pe_fit(pe_cursor,0);pe_ec_refs(pe_cursor);pe_ec_fit(pe_cursor);pe_fits+=2;pe_cursor+=1;);
    pe_cursor>=grain_count ? (pe_phase=3;pe_cursor=0;memset(pe_sum,0,4);memset(desc_res_counts+816,0,32);memset(desc_value_range+153,0,6););
  ) : pe_phase==3 ? (
    i=0;while(i<256 && pe_cursor<grain_count)(g=cp_g(pe_cursor);p=pe_p(pe_cursor);q=pe_prefix+pe_cursor*4;d=0;
      loop(2,pe_sum[d*2]+=p[d]*p[d+2]*g[3];pe_sum[d*2+1]+=p[d+2]*g[3];q[d*2]=pe_sum[d*2];q[d*2+1]=pe_sum[d*2+1];
        p[d+2]>0.05 ? (cp_desc_extent(51+d,p[d]);key=(51+d)*16+min(15,floor(p[d]*16));z=desc_res_counts[key];desc_res_counts[key]+=1;hash=z<32 ? z : ((pe_cursor*127+key*8191)%max(1,z+1));hash<32 ? desc_reservoir[key*32+hash]=pe_cursor;);d+=1;
      );pe_cursor+=1;i+=1;
    );pe_cursor>=grain_count ? (pe_phase=0;pe_ready=1;pe_model_key=corpus_key;pg_load_pending=1;);
  );
);

// ---------- Playback consumes immutable descriptors/edges, never training ----------
function xc_runtime_begin(w e when) local(st index d anchor)
(
  index=floor((e-event_base)/64);st=xc_states+index*64;
  st[0]!=e[1] ? (
    memset(st,0,64);st[0]=e[1];st[1]=floor(slider56);st[2]=xc_ready && xc_epoch==index_epoch && xc_params[0]>0.5;
    st[3]=cp_clamp(floor(slider64)-1,0,max(0,source_count-1));st[4]=index_epoch;st[10]=-1;st[11]=-1;
    anchor=w[5];d=0;loop(2,pe_event_locks[index*4+d]=anchor>=0 ? pe_value(anchor,d) : 0.5;pe_event_locks[index*4+2+d]=anchor>=0 ? pe_conf(anchor,d) : 0;d+=1;);d=0;loop(51,st[12+d]=anchor>=0 && cp_valid(anchor) ? cp_desc(anchor,d) : 0.5;d+=1;);st[63]=anchor>=0 && cp_valid(anchor) ? cp_length_value(anchor) : 0.5;
  );
  xc_lock_state=st;
  xc_run=st[2]>0 && st[4]==index_epoch && xc_ready && xc_params[0]>0.5;
  xc_runtime_transfer=st[1]==6 && e[42]<=0;xc_runtime_guide=e[42]>0 ? floor(e[44]) : st[3];xc_when=when;xc_reference=-1;xc_future=-1;
);
function xc_runtime_reference(w e when) local(p id g q frac)
(
  xc_run ? (
    // The primary may use the hierarchy's exact Micro reference. Children share
    // the same Meso/Macro trajectory but deliberately maintain their OWN Micro
    // cursor, so a companion does not collapse onto the parent's continuation.
    w[4]==0 && h_active && h_current>=0 ? (
      p=h_m(h_current);frac=h_q[20];xc_reference=xc_hgrain(0,p,frac);
    ) : (xc_reference=xc_next(w[5]);xc_reference<0 ? xc_reference=w[5];);
    xc_reference>=0 ? xc_future=xc_next(xc_reference);
  );
);
function xc_candidate_add(id src) (
  xc_allowed(id,src,xc_runtime_transfer,xc_runtime_guide) ? h_add_candidate(id,-4,src);
);
function xc_candidates(w src) local(id n p j i s pos desired q c r)
(
  xc_run ? (
    id=w[5];xc_ok(id) ? (
      p=xc_n(id);i=0;loop(4,xc_candidate_add(p[i],src);i+=1;);
      q=xc_g(id);xc_candidate_add(q[95],src);
      g_xc=cp_g(id);s=cp_s(g_xc[1]);
      w[40]>0 ? (
        pos=w[41]+max(0,xc_when-w[40])*pt_walk_rate(w,g_xc[4]/max(8000,srate)*pow(2,slider8/12));
        desired=s[5]+min(s[6]-1,max(0,floor(pos/max(1,s[2])*s[6])));xc_candidate_add(desired,src);xc_candidate_add(xc_next(desired),src);
      );
    );
    id=xc_reference;xc_ok(id) ? (
      xc_candidate_add(id,src);p=xc_n(id);i=0;loop(4,xc_candidate_add(p[8+i],src);i+=1;);
      q=xc_g(id);c=q[110];
      c>=0 && xc_params[6]>0.01 ? (
        p=xc_coarse+c*48;r=p[36];r>=0 && p[37]>0.82 ? (q=xc_coarse+r*48;xc_candidate_add(q[33],src););
      );
    );
  );
);
function xc_runtime_cost(id w) local(prev p q au matching join context adjacency future best i cost n expectedpos nextsource)
(
  xc_cost_join=0;xc_cost_match=0;xc_cost_context=0;xc_cost_prior=0;xc_cost_total=0;
  xc_run && xc_ok(id) ? (
    prev=w[5];p=xc_g(id);
    xc_ok(xc_reference) ? xc_cost_match=xc_distance(id,xc_reference,xc_params[5]);
    xc_ok(prev) ? (
      q=xc_g(prev);au=0.75;
      w[40]>=0 && w[42]>0 ? au=cp_01((w[41]+max(0,xc_when-w[40])*pt_walk_rate(w,q[90]/max(8000,srate)*pow(2,slider8/12))-q[88])/max(1,q[89]));
      xc_cost_join=xc_join(prev,id,au,0,xc_params[5],xc_params[4]);
      // Reward a source-consistent continuation only when it also passes the
      // measured seam cost; adjacency is evidence, never a quality guarantee.
      q[95]==id && xc_cost_join<0.35 ? xc_cost_prior=0.18*xc_params[2]*(1-xc_cost_join/0.35);
      g_xc=cp_g(prev);g_yc=cp_g(id);
      g_xc[1]==g_yc[1] && w[42]>0 ? (
        expectedpos=w[41]+max(0,xc_when-w[40])*pt_walk_rate(w,q[90]/max(8000,srate)*pow(2,slider8/12));
        abs(p[88]-expectedpos)<max(1,q[90]*0.050) ? xc_cost_prior=max(xc_cost_prior,0.20*xc_params[2]);
      );
    );
    // Bounded four-successor lookahead. Candidate joins are cached at load.
