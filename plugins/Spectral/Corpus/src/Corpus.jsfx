// v1.9.0: PE is fitted once during loading, with generation gated until ready.
// Region and EC errors have independent support. Pruning uses cached evidence.
// No prediction, PCM analysis, FFT, or hierarchy fitting is performed by playback.
// Opt-in only; missing controls in older projects retain Classic.
// #NATIVE_DEFAULT: slider242=1 legacy=1
slider242:1<0,2,1{Aggressive,Auto,Coherent}>--Grain detection
// #NATIVE_DEFAULT: slider243=0.5 legacy=0.5
slider243:0.5<0,1,0.001>--Coherent boundary sensitivity
// #NATIVE_DEFAULT: slider244=0 legacy=0
// Host state/automation retain seconds for compatibility; the editor uses ms.
slider244:0<0,120,0.001>--Coherent passage limit (seconds; editor in ms, 0=no fixed limit)
// #NATIVE_DEFAULT: slider245=1 legacy=1
slider245:1<0,1,1{Allow,Avoid gaps}>--Quiet grain policy
// Stable extension slots avoid rescaling old normalized map/filter automation.
// #NATIVE_DEFAULT: slider246=0 legacy=0
slider246:0<0,1,1>--Map X Length override (internal)
// #NATIVE_DEFAULT: slider247=0 legacy=0
slider247:0<0,1,1>--Map Y Length override (internal)
// #NATIVE_DEFAULT: slider248=0 legacy=0
slider248:0<0,3,1>--Length browser filter (internal)
// #NATIVE_DEFAULT: slider249=0 legacy=0
slider249:0<0,1,0.001>--Child cleanup

@init

function cp_clamp(x a b) ( min(b,max(a,x)); );
function cp_01(x) ( cp_clamp(x,0,1); );
function cp_db(x) (20*log(max(0.000000000001,x))/log(10););
function cp_amp(x) (exp(x*log(10)/20););
function cp_fold(l r) ((l+r)*0.5;);
// ---------- v1.9.5 grain rendering (bounded DSP work only) ----------
// Fade timing and curvature are latched per voice. Auditions keep their source
// window; event envelopes remain a separate multiplicative owner of amplitude.
function gr_prepare(v dur shape soft balance) local(split total) (
  shape=cp_clamp(floor(shape),0,2);soft=shape>0 ? cp_01(soft) : 0;
  split=cp_clamp((shape==2 ? 0.70 : 0.50)+(cp_01(balance)-0.5)*0.60,0.15,0.85);
  v[9]+=soft*(max(v[9],dur*split)-v[9]);
  v[10]+=soft*(max(v[10],dur*(1-split))-v[10]);
  total=v[9]+v[10];total>dur ? (v[9]*=dur/total;v[10]*=dur/total;);
  v[21]=soft;
);
function gr_window(age duration attack release curve) local(x y) (
  x=cp_01(min(min(1,age/max(1,attack)),(duration-age)/max(1,release)));
  y=x*x*(3-2*x);
  curve>0 ? y+=(0.5-0.5*cos($pi*x)-y)*curve;y;
);
// Stamp the small per-walker accumulator instead of clearing every group at
// every sample. Event slots own disjoint walker IDs; unrelated notes and child
// levels therefore never duck one another. No PCM analysis runs here.
function gr_accumulate(group window) local(p) (
  p=gr_norm+group*4;
  p[0]!=clock+1 ? (p[0]=clock+1;p[1]=0;p[2]=0;);
  p[1]+=window;p[2]+=window*window;
);
function gr_level(group mode) local(p sum power overlap target) (
  mode>0 && group>=0 && group<walker_total ? (
    p=gr_norm+group*4;sum=p[1];power=p[2];
    // Pair participation fades compensation in continuously as another grain
    // arrives. A lone grain is exact unity, including its own fading edges.
    overlap=cp_01(2*max(0,sum*sum-power));
    target=mode>=2 ? max(0.707106781186548,sum) : sqrt(max(0.5,power));
    1/max(0.707106781186548,1+overlap*(target-1));
  ) : 1;
);

// ---------- Stereo-linked Transient Smear ----------
// Classic keeps the old short all-pass renderer. Grain uses eight windowed
// unity-speed reads over a fixed causal history, with shared channel timing.
// Buffers and window table are prepared ahead of playback; no allocation,
// FFT, new library/runtime capability, or corpus selection is involved here.
// slider45 remains the amount, slider80 chooses the renderer. Exact zero bypass.
function td_stage(l r stage n g) local(p off dl dr yl yr) (
  p=floor(td_pos_base[stage]);p>=n ? p=0;
  off=stage*1024+p;dl=td_buf_l[off];dr=td_buf_r[off];
  yl=-g*l+dl;yr=-g*r+dr;
  td_buf_l[off]=l+g*yl;td_buf_r[off]=r+g*yr;
  p+=1;p>=n ? p=0;td_pos_base[stage]=p;
  td_work_l=yl;td_work_r=yr;
);
function td_prepare() local(n) (
  n=cp_clamp(floor(srate*0.00031+0.5),1,1023);(n%2)==0 ? n+=1;td_len0=min(1023,n);
  n=cp_clamp(floor(srate*0.00073+0.5),1,1023);(n%2)==0 ? n+=1;td_len1=min(1023,n);
  n=cp_clamp(floor(srate*0.00167+0.5),1,1023);(n%2)==0 ? n+=1;td_len2=min(1023,n);
  td_fast_rel=exp(-1/max(1,srate*0.0012));
  td_slow_a=1-exp(-1/max(1,srate*0.018));
  td_peak_rel=exp(-1/max(1,srate*0.015));
  td_param_a=1-exp(-1/max(1,srate*0.004)); // automation-safe coefficient glide
  td_energy_a=1-exp(-1/max(1,srate*0.025));
  // Smooth transient blend changes without changing cloud offsets/windows.
  td_mix_attack_a=1-exp(-1/max(1,srate*0.0015));
  td_mix_release_a=1-exp(-1/max(1,srate*0.006));
  n=0;loop(1024,td_window[n]=0.5-0.5*cos(2*$pi*n/1023);n+=1;);
  td_srate=srate;
);
function td_clear() (
  memset(td_buf_l,0,65536);memset(td_pos_base,0,64);
  td_write=0;td_seed=89101112;td_input_power=0;td_wet_power=0;td_level=1;td_tail_left=0;td_was_active=0;td_history=0;
  td_fast=0;td_slow=0;td_dry_peak=0;td_mix=0;td_transient=0;td_guard_gain=1;td_amount_rt=slider80<0.5 ? 0 : cp_01(slider45);
  td_block_trans=0;td_block_mix=0;td_block_guard=0;td_block_inpeak=0;td_block_outpeak=0;
);
// Eight asynchronous, unity-speed grains disperse phase through changing
// source offsets, not modulated read speeds. The exact same heads/windows are
// applied to L/R: mono stays mono and no artificial stereo width is added.
function td_reset_grains() (
  memset(td_heads,0,32);td_write=0;td_history=0;td_seed=89101112;
  td_input_power=0;td_wet_power=0;td_level=1;td_tail_left=0;
  td_fast=0;td_slow=0;td_mix=0;td_amount_rt=cp_01(slider45);
);
function td_random() local(hi lo nextseed) (
  hi=floor(td_seed/127773);lo=td_seed-hi*127773;nextseed=16807*lo-2836*hi;
  nextseed<=0 ? nextseed+=2147483647;td_seed=nextseed;nextseed/2147483647;
);
function td_grain(l r amount) local(i q len age delay pos u ix f win sumw power wl wr spread) (
  td_buf_l[td_write]=l;td_buf_r[td_write]=r;wl=0;wr=0;power=0;
  len=max(8,floor(srate*(0.007+0.033*amount*amount)));
  spread=min(30000,max(1,floor(srate*(0.0003+0.095*amount*amount))));
  i=0;loop(8,q=td_heads+i*4;
    q[1]<8 ? (q[1]=len;q[0]=floor(len*i/8);q[2]=floor(td_random()*spread););
    age=q[0];age>=q[1] ? (q[0]=0;age=0;q[1]=len;q[2]=floor(td_random()*spread););
    u=age*1023/max(1,q[1]-1);ix=min(1022,floor(u));f=u-ix;
    win=td_window[ix]+(td_window[ix+1]-td_window[ix])*f;
    pos=(td_write-q[2]+32768)%32768;
    q[2]<=td_history ? (wl+=td_buf_l[pos]*win;wr+=td_buf_r[pos]*win;);power+=win*win;
    q[0]=age+1;i+=1;
  );
  td_write=(td_write+1)%32768;td_history=min(32767,td_history+1);
  sumw=1/sqrt(max(0.5,power));wl*=sumw;wr*=sumw;
  td_input_power+=((l*l+r*r)*0.5-td_input_power)*td_energy_a;
  td_wet_power+=((wl*wl+wr*wr)*0.5-td_wet_power)*td_energy_a;
  td_level+=(cp_clamp(sqrt((td_input_power+0.0000000001)/(td_wet_power+0.0000000001)),0.5,2)-td_level)*td_energy_a;
  td_work_l=wl*td_level;td_work_r=wr*td_level;
);
function td_process(l r amount mode endgain) local(haze peak ceiling d desired) (
  mode>=0.5 && endgain<=0 ? (td_out_l=l;td_out_r=r;td_mix=0;td_was_active=0;) : (
  mode>=0.5 && !td_was_active ? (td_reset_grains();td_was_active=1;);
  td_amount_rt+=(cp_01(amount)-td_amount_rt)*td_param_a;td_amt=cp_01(td_amount_rt);
  td_dry_l=l;td_dry_r=r;td_abs=max(abs(l),abs(r));
  td_fast=max(td_abs,td_fast*td_fast_rel);td_slow+=(td_abs-td_slow)*td_slow_a;
  td_gate=cp_01((td_fast-0.00002)/0.0015);
  td_transient=cp_01((td_fast-td_slow*1.12)/max(0.000001,td_fast*0.82))*td_gate;
  mode<0.5 ? (
    td_target_mix=td_amt*td_transient;
    td_target_mix>td_mix ? td_mix+=(td_target_mix-td_mix)*td_mix_attack_a : td_mix+=(td_target_mix-td_mix)*td_mix_release_a;
    td_dry_peak=max(td_abs,td_dry_peak*td_peak_rel);td_g=0.30+0.30*td_amt;
    td_stage(l,r,0,td_len0,td_g);td_wet_l=td_work_l;td_wet_r=td_work_r;
    td_stage(td_wet_l,td_wet_r,1,td_len1,min(0.64,td_g+0.04));td_wet_l=td_work_l;td_wet_r=td_work_r;
    td_stage(td_wet_l,td_wet_r,2,td_len2,max(0.20,td_g-0.03));td_wet_l=td_work_l;td_wet_r=td_work_r;
    td_mix_now=cp_01(td_mix);td_proc_l=l*(1-td_mix_now)+td_wet_l*td_mix_now;td_proc_r=r*(1-td_mix_now)+td_wet_r*td_mix_now;
    td_proc_peak=max(abs(td_proc_l),abs(td_proc_r));td_guard_gain=1;td_ceiling=max(0.000000001,td_dry_peak*1.001);
    td_proc_peak>td_ceiling ? td_guard_gain=min(td_guard_gain,td_ceiling/td_proc_peak);
    td_transient>0.15 ? (td_goal=max(0.000000001,td_dry_peak*(1-0.28*td_amt*td_transient));td_proc_peak>td_goal ? td_guard_gain=min(td_guard_gain,td_goal/td_proc_peak););
  ) : (
    td_grain(l,r,td_amt);
    haze=cp_01((td_amt-0.20)/0.80);haze=haze*haze*(3-2*haze);
    td_abs>0.00000002 ? td_tail_left=max(1,floor(srate*0.14)) : td_tail_left=max(0,td_tail_left-1);
    td_target_mix=td_amt*td_amt*(0.30*td_transient+0.70*haze)*(td_tail_left>0);
    td_target_mix>td_mix ? td_mix+=(td_target_mix-td_mix)*td_mix_attack_a : td_mix+=(td_target_mix-td_mix)*td_mix_release_a;
    td_mix_now=cp_01(td_mix);td_proc_l=l*(1-td_mix_now)+td_work_l*td_mix_now*endgain;td_proc_r=r*(1-td_mix_now)+td_work_r*td_mix_now*endgain;
    // Linked soft guard catches cloud peaks; no dry-peak follower can erase
    // the diffuse grains after their source transient has already decayed.
    peak=max(abs(td_proc_l),abs(td_proc_r));ceiling=max(0.90,td_abs);td_guard_gain=1;
