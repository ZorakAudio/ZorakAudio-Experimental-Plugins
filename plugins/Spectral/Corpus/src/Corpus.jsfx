  pending_adoption && repeat_hold[0]<=0 && cp_busy()==0 && cp_hold_count()==0 && pool_state!=1 && pool_state!=2 ? (
    adopted=sample_pool_adopt(bank_pool);
    adopted>=0 ? (
      generation=sample_pool_generation(bank_pool);gen=generation;have_generation=1;
      // Refresh after adoption: loaded() previously referred to the old bank.
