desc:Corpus v0.9.0 - Structure-first / automatic corpus instrument
tags:instrument sampler granular synthesis ui
// #GFX_RESIZE: responsive
// #FILE: Corpus sources {Slot 0: use Open Multiple, as in Sample v71. A single long file is valid.}
filename:0,sample.wav
in_pin:none
out_pin:Left
out_pin:Right
options:maxmem=8388608 gfx_hz=30
// @za:gfx_sync_policy EXPLICIT
// @za:gfx_sync_mem 49152 8192 DSP_TO_GFX
// Corpus v0.7.0: combined representation, walk, envelope, mutation, branching,
// and exploration prototype. Requires Sample v71's EXTENDED sample-pool host.
// Not stock REAPER JSFX. No compiler/runtime modifications or imports needed.
// Loader and analysis scaffolding derived from Corpus v0.1.2 / Sample v71.
// DSP owns corpus, analysis, scheduler, history and voices. GFX reads ONLY the
// bounded explicit snapshot and writes acknowledged slider24 command packets.
// Audio stays in the immutable host pool. Never adopt while voices/events exist.
// Roles are four independent fuzzy eligibilities, NEVER exclusive retrieval bins.
// Feature labels are acoustic PROXIES, not learned semantic/material recognition.
// The map is a user-selected two-descriptor projection, not a neural embedding.
// Existing slider slots are preserved; role filtering is now fuzzy eligibility.
// v0.9: automatic scout, quiet pruning, source-level matching, atomic drawn paths.
// Slots 22/23 now hold quiet detection and source matching. Slot IDs otherwise stable.
// New defaults are for fresh instances. Saved explicit choices are not overwritten.
// #HELP: Load files in slot 0, wait for INDEX READY, click grains/vertices to hear them.
// #HELP: MIDI notes launch the same continuous walker in One-shot or Gated mode.
// #HELP: A/D/R are milliseconds; known windows proportionally fit A+D+R when needed.
// #HELP: Sustain is gain. Stability is the separate identity-leash parameter.
// #HELP: Draw a map path to guide selected descriptor axes through an event.
// #HELP: Click map point = audition, Shift = anchor, Ctrl+drag = focus, Draw = path.
// #HELP: All panes scroll. Small windows use tabs; no minimum-size blocker.
// #HELP: Sample Hub CC118/119 v1 packets: Play/Retrigger/Continue/Choke/End supported.
// #HELP: Unsupported modifier packets are rejected and counted, not misinterpreted.
// #HELP: REPEAT uses a completed recorded plan; overflow/continued/forced plans are disabled.
// #HELP: Live controls affect future selections; replay uses recorded decisions.
// #HELP: Analysis rebuilds automatically after source/settings changes; active audio finishes first.
// #HELP: Source matching is capped at +24 dB. Quiet time is structural REST, not playable material.
// #HELP: Draw commits on mouse-up. Locks/scope remain authoritative; target error is visible.
slider1:0.5<0,1,0.001>--Force target
slider2:0.35<0,1,0.001>--Variation
slider3:0.8<0,1,0.001>--Coherence
slider4:0.4<0,1,0.001>--Detail density
slider5:0<0,1000,1>--Grain window (0=Auto; otherwise 30-1000 ms)
slider6:1<0,4,1{4096,8192,16384,32768,65536}>--Grain index budget (Apply)
slider7:0<-36,12,0.1>--Output (dB)
slider8:0<-24,24,0.1>--Pitch (semitones; generated only)
slider9:1<0,1,0.001>--Velocity influence
slider10:0<0,1,1{One-shot,Gated}>--MIDI lifecycle
slider11:12345<1,16777213,1>--Random seed
slider12:0<0,1,1{Evolve,Fixed}>--Seed mode
slider13:0<0,65536,256>--Pool RAM budget (MB; 0=resident)
slider14:0<0,65536,1>--Source scope (0=all)
slider15:0<0,65536,1>--Identity anchor (0=none)
slider16:0<0,28,1>--Feature filter (0=all)
slider17:0<0,4,1{All,Attack,Body,Detail,Tail}>--Role eligibility filter
slider18:0<0,3276,1>--Grain browser page
slider19:0<0,99,1>--Traversal history offset
slider20:1<0,1,1{Off,On}>--Safety peak catch
slider21:1<0,2,1{Fast,Balanced,Detailed}>--Analysis quality (Apply)
slider22:1<0,2,1{Off,Auto,Manual}>--Quiet-material detection
slider23:1<0,1,1{Raw,Match active}>--Source level policy
slider24:0<0,16777215,1>--UI action packet (internal; do not automate)
slider25:800<20,30000,1>--One-shot duration (ms)
slider26:5<0,2000,1>--Attack (ms)
slider27:100<0,5000,1>--Decay (ms)
slider28:0.75<0,1,0.001>--Sustain level
slider29:180<0,5000,1>--Release (ms)
slider30:0.55<0,1,0.001>--Walk flow / overlap
slider31:0.5<0,1,0.001>--Brightness mutation
slider32:0.5<0,1,0.001>--Mass (LF-weight mutation)
slider33:0.5<0,1,0.001>--Roughness mutation
slider34:0.65<0,1,0.001>--Novelty pressure
slider35:0.8<0,1,0.001>--Identity stability
slider36:0<0,3,1{Linear,Resonance,Debris,Layered}>--Branch morphology
slider37:0.25<0,1,0.001>--Branch level
slider38:0.85<0,1,0.001>--Branch identity inheritance
slider39:1<0,1,0.001>--Drawn path influence
slider40:1<0,7,1{Energy,Brightness,LF weight,Motion,Onset,Crest,Decay,Width}>--Map X descriptor
slider41:2<0,7,1{Energy,Brightness,LF weight,Motion,Onset,Crest,Decay,Width}>--Map Y descriptor
slider42:0.5<0,1,0.001>--Map focus X
slider43:0.5<0,1,0.001>--Map focus Y
slider44:0<0,1,0.001>--Map focus influence
slider45:0<0,255,1>--Map stratum page
slider46:0.75<0,1,0.001>--Envelope trajectory influence
slider47:2<0.2,20,0.01>--Gated path cycle (seconds)
slider48:0.35<0,1,0.001>--Role browser threshold
slider49:1<0,1,1{Off,On}>--Sample Hub duration packets
slider50:0<0,255,1>--Locked identity descriptors (bitmask)
slider51:0.95<0,1,0.001>--Identity lock strength
slider52:240<30,1000,1>--Generated excerpt ceiling (ms)
slider53:0.3<0,1,0.001>--Branch stereo spread
slider54:0<0,1,1{Navigate,Draw}>--Map mouse mode
slider55:4<0,4,1{Explore,Inspector,Controls,Inspector legacy,Structure}>--Interface page

// v0.8.0: source-local chronology, soft behavioural ECs, explicit durations,
// ordered member scaffolds, optional hierarchical rendering and Structure view.
// EC labels are approximate clusters; no semantic classification is asserted.
// Auto selects supported Macro/Meso/Micro levels. Learning always follows load/change.
// Bank/index reconstruction is deterministic; no playback RNG is used by learning.
// File ends are censored observations, NOT learned instructions to terminate.
// Micro analysis is still burst-sampled; no sub-tile boundary precision claimed.
slider56:5<0,5,1{Off,Inspect,Meso,Hierarchical,Reconstruct,Auto}>--Hierarchy mode
slider57:0.8<0,1,0.001>--Behaviour target influence
slider58:0.35<0,1,0.001>--Behaviour variation
slider59:0.25<0,1,0.001>--Structure variation
slider60:0.5<0,1,0.001>--Boundary sensitivity (hierarchy rebuild)
slider61:-70<-100,-30,0.5>--Structural rest floor (dB; hierarchy rebuild)
slider62:1<0.25,4,0.01>--Learned duration scale
slider63:0.5<0,1,0.001>--EC detail (hierarchy rebuild)
slider64:1<1,65536,1>--Structure / reconstruction source

@init

function cp_clamp(x a b) ( min(b,max(a,x)); );
function cp_01(x) ( cp_clamp(x,0,1); );
function cp_db(x) (20*log(max(0.000000000001,x))/log(10););
function cp_amp(x) (exp(x*log(10)/20););
function cp_frames(x) (x<0 ? x+4294967296 : x;);
function cp_rng() local(hi lo nx) (
  hi=floor(rng_state/127773); lo=rng_state-hi*127773;
  nx=16807*lo-2836*hi; nx<=0 ? nx+=2147483647;
  rng_state=nx; nx/2147483647;
);
function cp_g(id) (grain_base+id*64;);
function cp_s(id) (source_base+id*8;);
function cp_e(id) (event_base+id*64;);
function cp_w(id) (walker_base+id*64;);
function cp_v(id) (voice_base+id*32;);
function cp_source_cells(id) local(s) (s=cp_s(id);s[6];);
function cp_valid(id) local(g ok) (
  ok=0; id>=0 && id<grain_count ? (g=cp_g(id);ok=g[9]<0.5 && g[60]<0.5 && g[6]>0.00001;);ok;
);
function cp_feat(id d) local(g) (g=cp_g(id); d<5 ? g[16+d] : g[51+d-5];);
function cp_member(id vertex) local(d b g) (
  g=cp_g(id);vertex==28 ? 1 : (
    vertex>=15 && vertex<19 ? g[41+vertex-15] : (
      vertex<15 ? (d=floor(vertex/3);b=vertex-d*3;) : (d=5+floor((vertex-19)/3);b=(vertex-19)%3;);
      max(0,1-abs(2*cp_feat(id,d)-b));
    );
  );
);
function cp_dim_vertex(d b) (d<5 ? d*3+b : 19+(d-5)*3+b;);
function cp_lower(lo hi key) local(mid) (
  while(lo<hi) (mid=floor((lo+hi)/2);postings[mid]<key ? lo=mid+1 : hi=mid;);lo;
);
function cp_range(vertex src) local(lo hi s) (
  vertex=cp_clamp(floor(vertex),0,28);lo=offsets[vertex];hi=offsets[vertex+1];
  src>0 ? (src<=source_count ? (
    s=cp_s(src-1);lo=cp_lower(lo,hi,s[5]);hi=cp_lower(lo,hi,s[5]+s[6]);
  ) : hi=lo;);
  range_lo=lo;range_hi=hi;hi-lo;
);
// Per-source scout data: desired window, quiet floor dB, active RMS, confidence,
// actual indexed window, capped source gain, probe interval, probe count.
function cp_auto(src) (auto_sources+src*8;);
function cp_source_gain(src) local(a) (a=cp_auto(src);slider23>=0.5 ? a[5] : 1;);
function cp_quiet_floor(src) local(a) (a=cp_auto(src);quiet_mode==0 ? 0.00001 : cp_amp(quiet_mode==2 ? quiet_db : a[1]););
// This is an eligibility flag, distinct from the explicit user-exclusion flag.
function cp_quiet(id) local(g a floorv low prev p) (
  g=cp_g(id);floorv=cp_quiet_floor(g[1]);low=floorv;
  id>0 ? (p=cp_g(id-1);p[1]==g[1] && p[60]<0.5 ? low*=0.501187233627272;);
  g[60]=(g[6]<low && g[7]<floorv*3.98107170553497) || g[6]<=0.00001;
  g[60]>0.5 ? auto_quiet_n+=1;
);
// Cheap two-axis retrieval reservoirs; at most 64 actual eligible grains per bin.
function cp_path_index(id) local(d b k n slot) (
  cp_valid(id) ? (d=0;loop(8,
    b=min(15,floor(cp_feat(id,d)*16));k=d*16+b;n=path_res_counts[k];path_res_counts[k]=n+1;
    slot=n<64 ? n : ((id*127+k*8191)%max(1,n+1));
    slot<64 ? path_reservoir[k*64+slot]=id;d+=1;
  ););
);
function cp_clear_voices() (memset(voice_base,0,2048); voice_list_n=0; active_voices=0;);
function cp_clear_events() (memset(event_base,0,512);memset(walker_base,0,1536); event_count=0;);
function cp_busy() (voice_list_n;);
function cp_hold_count() local(i n e) (
  i=0;n=0;loop(8,e=cp_e(i);e[0]>0 ? n+=1;i+=1;);n;
);
function cp_stop_event(ei when fade) local(i v e w) (
  e=cp_e(ei);e[0]>0 ? (
    e[1]==record_event && when<e[10] && !replaying ? record_overflow=max(record_overflow,3);
    when<e[14] ? (e[14]=when;e[15]=max(0,fade);) : (when==e[14] ? e[15]=min(e[15],max(0,fade)););
    i=0;loop(24,w=cp_w(i);w[0]>0 && w[1]==ei ? w[0]=0;i+=1;);
    i=0;loop(voice_list_n,v=cp_v(voice_list[i]);v[26]==ei && v[17]==e[1] ? (
      v[14]=min(v[14],when+fade);v[15]=max(1,fade);
    );i+=1;);
  );
);
function cp_stop_all(when fade channel) local(i e) (
  i=0;loop(8,e=cp_e(i);e[0]>0 && (channel<0 || e[3]==channel) ? cp_stop_event(i,when,fade);i+=1;);
  i=0;loop(voice_list_n,stop_v=cp_v(voice_list[i]);(channel<0 || stop_v[13]==channel) ? (
    stop_v[14]=min(stop_v[14],when+fade);stop_v[15]=max(1,fade);
  );i+=1;);
);
// Analytical event envelope: late Note Off never changes samples BEFORE its timestamp.
function cp_env_pre(e t) local(x) (
  x=t<e[5] ? 0 : (t<e[6] ? (t-e[5])/max(1,e[6]-e[5]) : (
    t<e[7] ? 1-(1-e[8])*(t-e[6])/max(1,e[7]-e[6]) : e[8]
  ));
  e[37]>e[35] && t>=e[35] && t<e[37] ? x=e[36]+(e[8]-e[36])*cp_01((t-e[35])/(e[37]-e[35]));x;
);
function cp_env(e t) local(a n q ei) (
  // Only Continue needs an old envelope snapshot. The common path is O(1).
  t<e[33] && e[34]>0 ? (
    ei=floor((e-event_base)/64);n=e[34]-1;
    while(n>=0)(q=env_old_base+ei*512+n*64;t>=q[33] || n==0 ? (e=q;n=-1;) : n-=1;);
  );
  a=t<e[9] ? cp_env_pre(e,t) : e[11]*max(0,(e[10]-t)/max(1,e[10]-e[9]));
  t>=e[14] ? a*=max(0,1-(t-e[14])/max(1,e[15]));cp_01(a);
);
function cp_env_save(e when) local(n q ei ok) (
  ok=1;when>e[33] ? (
    n=e[34];n<8 ? (
      ei=floor((e-event_base)/64);q=env_old_base+ei*512+n*64;memcpy(q,e,64);e[34]=n+1;e[33]=when;
    ) : ok=0;
  );ok;
);
function cp_phase(e t) local(d z) (
  phase_release=0;
  t<e[6] ? (phase_stage=0;phase_u=0.18*cp_01((t-e[5])/max(1,e[6]-e[5]));) : (
    t<e[7] ? (phase_stage=1;phase_u=0.18+0.17*cp_01((t-e[6])/max(1,e[7]-e[6]));) : (
      t<e[9] ? (phase_stage=2;
        e[12]>0 ? phase_u=cp_01((t-e[5])/max(1,e[10]-e[5])) : (
          z=(t-e[7])/max(1,srate*slider47);phase_u=0.35+0.225*(1-cos(z*2*$pi));
        );
      ) : (phase_stage=3;phase_release=cp_01((t-e[9])/max(1,e[10]-e[9]));phase_u=0.8+0.2*phase_release;);
    );
  );
  e[12]>0 ? phase_u=cp_01((t-e[5])/max(1,e[10]-e[5])); phase_stage;
);
function cp_event_find(note chan ext) local(i e found) (
  i=0;found=-1;while(i<8 && found<0) (
    e=cp_e(i);e[0]>0 && e[3]==chan && e[14]>clock && (ext>0 ? e[4]==ext : (e[2]==note && e[4]==0)) ? found=i;i+=1;
  );found;
);
function cp_path_eval(u) local(x i n) (
  path_x=0.5;path_y=0.5;
  path_count>0 ? (
    x=cp_01(u)*max(0,path_count-1);i=floor(x);n=min(path_count-1,i+1);x-=i;
    path_x=path_base[i*2]*(1-x)+path_base[n*2]*x;
    path_y=path_base[i*2+1]*(1-x)+path_base[n*2+1]*x;
  );
);
// ---------------- Micro -> Meso -> Macro (v0.8.0) ----------------
// EC means a soft acoustic-behaviour cluster, not a proved mathematical
// equivalence relation or a semantic label. Chronology is always source-local.
function h_m(i) (hm_episodes+i*96;);
function h_x(i) (hx_episodes+i*128;);
function h_src(i) (h_sources+i*4;);
function h_ep(level i) (level<1 ? h_m(i) : h_x(i););
function h_cl(level i) (level<1 ? hm_classes+i*96 : hx_classes+i*128;);
function h_n(level) (level<1 ? hm_n : hx_n;);
function h_k(level) (level<1 ? hm_k : hx_k;);
function h_stride(level) (level<1 ? 96 : 128;);
function h_limit(level) (level<1 ? 48 : 24;);
function h_list(level) (level<1 ? hm_list : hx_list;);
function h_link(level a b) ( (level<1 ? hm_links+a*48*3 : hx_links+a*24*3)+b*3; );
function h_restgrain(id) local(g) (g=cp_g(id);g[60]>0.5;);
function h_observed(id) local(g) (g=cp_g(id);g[9]<0.5 || g[60]>0.5;);
function h_grainseconds(id) local(g) (g=cp_g(id);g[3]/max(1,g[4]););
function h_mean(p d) (0.5*p[16+d*3+1]+p[16+d*3+2];);
function h_rnd(q) local(hi lo nx) (
  hi=floor(q[13]/127773);lo=q[13]-hi*127773;nx=16807*lo-2836*hi;
  nx<=0 ? nx+=2147483647;q[13]=nx;nx/2147483647;
);
function h_dist(level a b) local(d i hp df dd tm ro z) (
  hp=0;df=0;dd=0;tm=0;ro=0;
  level<1 ? (
    i=0;loop(24,z=sqrt(max(0,a[16+i]))-sqrt(max(0,b[16+i]));hp+=z*z;i+=1;);
    i=0;loop(8,df+=abs(a[48+i]-b[48+i]);dd+=abs(a[40+i]-b[40+i]);i+=1;);
    i=0;loop(4,ro+=abs(a[56+i]-b[56+i]);i+=1;);
    tm=0.40*abs(a[60]-b[60])+0.35*abs(a[62]-b[62])+0.25*abs(a[63]-b[63]);
    h_part_distribution=sqrt(hp/16);h_part_motion=df/8;h_part_direction=dd/16;h_part_timing=tm;h_part_role=ro/4;
    0.50*h_part_distribution+0.20*h_part_motion+0.15*h_part_direction+0.10*tm+0.05*h_part_role;
  ) : (
    i=0;loop(48,z=sqrt(max(0,a[16+i]))-sqrt(max(0,b[16+i]));hp+=z*z;dd+=abs(a[64+i]-b[64+i]);i+=1;);
    tm=0.5*abs(a[112]-b[112])+0.30*abs(a[114]-b[114])+0.20*abs(a[115]-b[115]);
    h_part_distribution=sqrt(hp/2);h_part_motion=abs(a[118]-b[118]);h_part_direction=dd/2;h_part_timing=tm;h_part_role=0;
    0.60*h_part_distribution+0.20*h_part_direction+0.10*tm+0.10*h_part_motion;
  );
);
// The analysis-order permutation is coprime with N, hence covers every episode.
function h_gcd(a b) local(t) (while(b>0)(t=a%b;a=b;b=t;);a;);
function h_order_setup(n) (
  h_step=max(1,2*floor(sqrt(max(1,n)))+1);
  while(h_gcd(h_step,max(1,n))!=1)(h_step+=2;);
);
function h_nearest(level p) local(k c z i t score total temp d0 d1 d2) (
  h_best0=-1;h_best1=-1;h_best2=-1;d0=100;d1=100;d2=100;i=0;
  loop(h_k(level),c=h_cl(level,i);
    c[0]>0 ? (z=h_dist(level,p,c);
      z<d0 ? (d2=d1;h_best2=h_best1;d1=d0;h_best1=h_best0;d0=z;h_best0=i;) : (
        z<d1 ? (d2=d1;h_best2=h_best1;d1=z;h_best1=i;) : (z<d2 ? (d2=z;h_best2=i;);)
      );
    );i+=1;
  );h_bestdist=d0;
  // Truncated soft assignments; weak distant alternatives are not fabricated.
  temp=max(0.008,(level<1 ? hm_radius : hx_radius)*0.30);
  h_weight0=h_best0>=0 ? 1 : 0;
  h_weight1=h_best1>=0 && d1<=d0+temp*4 ? exp(-(d1-d0)/temp) : 0;
  h_weight2=h_best2>=0 && d2<=d0+temp*4 ? exp(-(d2-d0)/temp) : 0;
  total=max(0.000000001,h_weight0+h_weight1+h_weight2);
  h_weight0/=total;h_weight1/=total;h_weight2/=total;
);
function h_assign(p) (
  p[6]=h_best0;p[7]=h_best1;p[8]=h_best2;p[9]=h_weight0;p[10]=h_weight1;p[11]=h_weight2;p[12]=h_bestdist;
);
function h_calibrate_start(level) (
  h_level=level;h_cursor=0;h_pair_n=0;memset(h_hist,0,128);h_order_setup(h_n(level));
);
function h_calibrate_step(level) local(n a b z bin j sum q) (
  n=h_n(level);j=0;
  while(j<12 && h_cursor<min(512,n*max(1,n-1))) (
    a=(h_cursor*h_step)%max(1,n);
    b=(a+1+floor(h_cursor/max(1,n))*max(1,floor(n/7)))%max(1,n);
    a!=b ? (z=h_dist(level,h_ep(level,a),h_ep(level,b));bin=floor(cp_clamp(z*127,0,127));h_hist[bin]+=1;h_pair_n+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=min(512,n*max(1,n-1)) ? (
    sum=0;q=0;j=0;while(j<128 && sum<h_pair_n*0.25)(sum+=h_hist[j];q=j;j+=1;);
    // Corpus-relative starting radius with a numerical floor; no forced K.
    z=max(0.025,q/127)*(1.55-0.9*h_detail);z=cp_clamp(z,0.018,0.24);
    level<1 ? hm_radius=z : hx_radius=z;
    h_cursor=0;h_phase=level<1 ? 4 : 10;
  );
);
// Two fixed-prototype reassignment passes avoid order-dependent online updates.
function h_leader_step(level) local(j id p c i n k radius) (
  j=0;n=h_n(level);radius=level<1 ? hm_radius : hx_radius;
  while(j<4 && h_cursor<n) (
    id=(h_cursor*h_step)%max(1,n);p=h_ep(level,id);h_nearest(level,p);k=h_k(level);
    h_best0<0 || (h_bestdist>radius && k<h_limit(level)) ? (
      c=h_cl(level,k);memset(c,0,h_stride(level));memcpy(c+16,p+16,h_stride(level)-16);c[0]=1;c[14]=id;
      level<1 ? hm_k+=1 : hx_k+=1;
    ) : (h_bestdist>radius ? h_cluster_cap+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=n ? (h_cursor=0;h_refine_pass=0;memset(h_sums,0,6144);h_phase=level<1 ? 5 : 11;);
);
function h_refine_step(level) local(j id p c q k i wt d) (
  j=0;
  while(j<4 && h_cursor<h_n(level)) (
    id=h_cursor;p=h_ep(level,id);h_nearest(level,p);h_assign(p);i=0;
    loop(3,k=p[6+i];wt=p[9+i];k>=0 && wt>0 ? (
      q=h_sums+k*128;q[0]+=wt;d=16;loop(h_stride(level)-16,q[d]+=wt*p[d];d+=1;);
    );i+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=h_n(level) ? (
    i=0;loop(h_k(level),c=h_cl(level,i);q=h_sums+i*128;
      q[0]>0.000001 ? (c[0]=q[0];d=16;loop(h_stride(level)-16,c[d]=q[d]/q[0];d+=1;);) : c[0]=0;
      i+=1;
    );h_cursor=0;h_refine_pass+=1;memset(h_sums,0,6144);
    h_refine_pass>=2 ? (
      // Merge only near-duplicate prototypes; retain isolated rare behaviours.
      i=0;loop(h_k(level),c=h_cl(level,i);j=0;
        while(j<i && c[0]>0)(q=h_cl(level,j);q[0]>0 && h_dist(level,c,q)<(level<1 ? hm_radius : hx_radius)*0.22 ? (c[0]=0;h_merges+=1;);j+=1;);i+=1;
      );
      i=0;loop(h_k(level),c=h_cl(level,i);c[1]=0;c[2]=0;c[3]=-1;c[4]=0;c[5]=0;c[6]=0;c[7]=0;c[8]=0;c[9]=0;c[10]=0;c[11]=0;c[12]=0;c[13]=0;c[15]=0;i+=1;);
      h_phase=level<1 ? 6 : 12;h_cursor=0;h_finalize_stage=0;h_cleanup_done=0;
    );
  );
);
function h_softlink(level p prev) local(a b ca cb wt z) (
  a=0;loop(3,ca=prev[6+a];b=0;loop(3,cb=p[6+b];wt=prev[9+a]*p[9+b];
    ca>=0 && cb>=0 && wt>0 ? (
      z=h_link(level,ca,cb);z[0]+=wt;z[1]+=wt*p[4];
      // Last source starts at -1; multiple transitions in one file are not
      // presented as independent source support.
      h_ls=h_order+(level<1 ? ca*48+cb : 2304+ca*24+cb);
      h_ls[0]!=p[0]+1 ? (h_ls[0]=p[0]+1;z[2]+=1;h_link_sources+=1;);
    );b+=1;);a+=1;);
);
function h_class_cleanup(level) local(i j c q dist best bd changed d wa wb) (
  changed=0;i=0;
  loop(h_k(level),c=h_cl(level,i);
    c[6]==1 && c[10]>0 ? (
      best=-1;bd=(level<1 ? hm_radius : hx_radius)*1.1;j=0;
      loop(h_k(level),q=h_cl(level,j);
        j!=i && q[0]>0 && q[6]>=2 && q[10]>0 ? (
          dist=h_dist(level,c,q);dist<bd ? (bd=dist;best=j;);
        );j+=1;
      );
      best>=0 ? (
        q=h_cl(level,best);wa=max(0.000001,c[1]);wb=max(0.000001,q[1]);d=16;
        loop(h_stride(level)-16,q[d]=(q[d]*wb+c[d]*wa)/(wa+wb);d+=1;);
        c[0]=0;h_merges+=1;changed+=1;
      );
    );i+=1;
  );changed;
);
// 0 ordinary, 1 unique/rare, 2 rest-only (structural), 3 empty/retired.
function h_class_state(level) local(i c) (
  i=0;loop(h_k(level),c=h_cl(level,i);
    c[11]=c[6]<1 ? 3 : (c[10]<1 ? 2 : (c[6]<2 ? 1 : 0));
    c[6]<1 ? c[0]=0;i+=1;
  );
);
function h_finalize_step(level) local(j p q c i wt prev n off list id z d best err) (
  list=h_list(level);j=0;
  h_finalize_stage==0 ? (
    while(j<4 && h_cursor<h_n(level)) (
      p=h_ep(level,h_cursor);h_nearest(level,p);h_assign(p);i=0;
      loop(3,id=p[6+i];wt=p[9+i];id>=0 && wt>0 ? (
        c=h_cl(level,id);c[1]+=wt;c[4]+=wt*p[4];c[5]+=wt*p[4]*p[4];
        c[3]!=p[0] ? (c[2]+=1;c[3]=p[0];);
      );i+=1;);
      p[6]>=0 ? (c=h_cl(level,p[6]);c[6]+=1;
        (level<1 ? p[60] : p[112])>0.00001 ? c[10]+=1;
        c[6]==1 || p[12]<c[15] ? (c[14]=h_cursor;c[15]=p[12];);
      );
      h_cursor>0 ? (
        prev=h_ep(level,h_cursor-1);
        // Only real consecutive source chronology. Excluded gaps and file
        // boundaries never become learned transitions.
        prev[0]==p[0] && abs((prev[3]+prev[4])-p[3])<0.000001 && (p[5]&8)==0 ? (
          h_softlink(level,p,prev);level<1 ? hm_transitions+=1 : hx_transitions+=1;
        );
      );h_cursor+=1;j+=1;
    );
    h_cursor>=h_n(level) ? (
      !h_cleanup_done && h_class_cleanup(level)>0 ? (
        h_cleanup_done=1;h_cursor=0;i=0;
        loop(h_k(level),c=h_cl(level,i);c[1]=0;c[2]=0;c[3]=-1;c[4]=0;c[5]=0;c[6]=0;c[10]=0;c[15]=0;i+=1;);
        level<1 ? (memset(hm_links,0,6912);hm_transitions=0;) : (memset(hx_links,0,1728);hx_transitions=0;);
        memset(h_order,0,2880);
      ) : (
        h_class_state(level);off=0;i=0;loop(h_k(level),c=h_cl(level,i);c[7]=off;c[8]=0;off+=c[6];i+=1;);
        h_cursor=0;h_finalize_stage=1;
      );
    );
  ) : (
    while(j<128 && h_cursor<h_n(level)) (
      p=h_ep(level,h_cursor);p[6]>=0 ? (c=h_cl(level,p[6]);list[c[7]+c[8]]=h_cursor;c[8]+=1;);
      h_cursor+=1;j+=1;
    );
    h_cursor>=h_n(level) ? (
      i=0;loop(h_k(level),c=h_cl(level,i);c[1]>0 ? (c[4]/=c[1];c[5]=sqrt(max(0,c[5]/c[1]-c[4]*c[4])););i+=1;);
      level<1 ? (h_phase=7;h_cursor=0;h_xsource=0;h_xopen=0;h_xscan=0;h_xcount=0;) : (
        h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=0;h_ui_dirty=1;
      );
    );
  );
);
// Change score compares bounded left/right neighbourhood means, variation and
// signed evolution. Index tiles set the finest possible boundary resolution.
function h_change_at(id) local(g p i d nl nr lm rm lv rv ls rs z score a b) (
  g=cp_g(id);score=0;nl=0;nr=0;
  id<=0 ? 0 : (
    p=cp_g(id-1);
    p[1]!=g[1] || !h_observed(id) || !h_observed(id-1) ? 1 : (
      h_restgrain(id)!=h_restgrain(id-1) ? 1 : (
        h_restgrain(id) ? 0 : (
          d=0;loop(8,lm=0;rm=0;lv=0;rv=0;nl=0;nr=0;ls=0;rs=0;i=0;
            loop(3,
              a=id-1-i;b=id+i;
              a>=0 ? (p=cp_g(a);p[1]==g[1] && h_observed(a) ? (z=cp_feat(a,d);lm+=z;lv+=z*z;nl+=1;i==0 ? ls=z;i==2 ? ls-=z;););
              b<grain_count ? (p=cp_g(b);p[1]==g[1] && h_observed(b) ? (z=cp_feat(b,d);rm+=z;rv+=z*z;nr+=1;i==0 ? rs=-z;i==2 ? rs+=z;););
              i+=1;
            );
            lm/=max(1,nl);rm/=max(1,nr);lv=max(0,lv/max(1,nl)-lm*lm);rv=max(0,rv/max(1,nr)-rm*rm);
            score+=(0.75*abs(lm-rm)+0.15*abs(sqrt(lv)-sqrt(rv))+0.10*abs(ls-rs))*(d==0 || d==3 || d==4 ? 1.4 : 1);d+=1;
          );score/9.2;
        );
      );
    );
  );
);
function h_meso_finish() local(p g n d i b f t lo hi j q wt target total prev a delta dt active onset den) (
  h_mopen && hm_n<8192 ? (
    p=h_m(hm_n);n=h_mend-h_mstart;g=cp_g(h_mstart);
    p[0]=g[1];p[1]=h_mstart;p[2]=n;p[3]=g[2]/g[4];p[4]=h_mseconds;p[5]=h_mflags;p[13]=-1;
    p[6]=-1;p[7]=-1;p[8]=-1;
    d=0;loop(24,p[16+d]/=max(0.000000001,h_mseconds);d+=1;);
    d=0;loop(8,p[40+d]/=max(1,h_mtrans);p[48+d]/=max(1,h_mtrans);d+=1;);
    d=0;loop(4,p[56+d]/=max(0.000000001,h_mseconds);d+=1;);
    p[60]/=max(0.000000001,h_mseconds);p[61]=1-p[60];
    p[62]=cp_01(log(1+h_mseconds)/log(61));p[63]=1-exp(-h_monsets/max(0.000001,h_mseconds)*0.08);
    // Four actual chronological control points, not a class centroid. Each
    // uses the indexed grain at its time; no new PCM scan in this stage.
    d=0;loop(4,
      j=h_mstart+min(n-1,floor((d+0.5)*n/4));i=0;loop(8,p[64+d*8+i]=cp_feat(j,i);i+=1;);d+=1;
    );q=h_src(g[1]);q[1]+=1;
    hm_n+=1;h_mopen=0;
  );
);
function h_meso_add(id) local(g p prev d b v dt delta) (
  g=cp_g(id);p=h_m(hm_n);dt=g[3]/max(1,g[4]);h_mseconds+=dt;
  d=0;loop(8,v=cp_feat(id,d);b=0;loop(3,p[16+d*3+b]+=max(0,1-abs(2*v-b))*dt;b+=1;);
    id>h_mstart ? (
      delta=v-cp_feat(id-1,d);p[40+d]+=delta;p[48+d]+=abs(delta);
    );d+=1;
  );
  d=0;loop(4,p[56+d]+=g[41+d]*dt;d+=1;);
  p[60]+=(!h_restgrain(id))*dt;
  !h_restgrain(id) && g[20]>=0.55 ? h_monsets+=1;
  id>h_mstart ? h_mtrans+=1;
  hm_grainmap[id]=hm_n;h_mend=id+1;
);
function h_begin() local(i p) (
  h_ready=0;h_phase=0;h_epoch=-1;h_status=0;hm_n=0;hx_n=0;hm_k=0;hx_k=0;
  hm_transitions=0;hx_transitions=0;h_merges=0;h_cluster_cap=0;h_link_sources=0;h_coarsened=0;
  h_excluded=0;h_empty_classes=0;h_macro_singletons=0;h_macro_singletons=0;h_coverage_lost=0;h_macro_lost=0;h_mopen=0;h_msource=-1;h_cursor=0;h_rest_seconds=0;
  h_sensitive=cp_01(slider60);h_detail=cp_01(slider63);h_rest_db=slider61;h_rest_amp=cp_amp(h_rest_db);
  // Model-local EC IDs can change after a rebuild; never replay stale class
  // labels as though they belonged to the new hierarchy.
  record_n=0;record_done=0;record_event=-1;trace_n=0;trace_head=-1;
  h_ui_m=-1;h_ui_x=-1;h_ui_class=-1;h_ui_level=0;h_ui_compare=-1;h_ui_page=0;h_ui_memberpage=0;h_ui_pin=-1;
  memset(h_state,0,768);memset(hm_grainmap,-1,grain_count);memset(h_change,0,grain_count);
  memset(hm_classes,0,4608);memset(hx_classes,0,3072);memset(hm_links,0,6912);memset(hx_links,0,1728);
  memset(h_hist,0,128);memset(h_order,0,2880);memset(h_sources,0,source_count*4);
  i=0;loop(source_count,p=h_src(i);p[0]=-1;p[2]=-1;i+=1;);
  0 ? h_status=1 : (
    grain_count<1 ? h_status=2 : (
      source_count>8192 ? h_status=3 : (
        h_phase=1;
        // Remaining slots are reserved for remaining sources. Larger tile
        // groups coarsen chronology instead of cutting off the file end.
        h_min_meso=max(0,total_seconds/max(1,8192-source_count)*1.05);
      );
    );
  );
);
function h_meso_scan_step() local(j id g p score boundary limit remain need flags bin sum q) (
  j=0;
  while(j<64 && h_cursor<grain_count) (
    id=h_cursor;g=cp_g(id);
    h_msource!=g[1] ? (
      h_meso_finish();h_msource=g[1];p=h_src(h_msource);p[0]=hm_n;h_msource_start=hm_n;
    );
    !h_observed(id) ? (h_meso_finish();h_excluded+=1;) : (
      boundary=0;flags=0;
      h_mopen ? (
        p=cp_g(id-1);
        h_restgrain(id)!=h_restgrain(id-1) ? (boundary=1;flags=4;) : (
          score=h_change[id];
          score>=h_boundary && score>=h_change[max(0,id-1)] && (id+1>=grain_count || score>h_change[id+1]) ? (boundary=1;flags=2;);
          // A stable continuous regime is kept intact, except for a bounded
          // analysis chunk (12 s or capacity-derived minimum).
          h_mseconds>=max(12,h_min_meso*2) ? (boundary=1;flags=8;);
        );
        h_mseconds<h_min_meso ? (boundary=0;h_coarsened+=1;);
        remain=8192-hm_n;need=source_count-h_msource;
        remain<=need ? (boundary=0;h_coarsened+=1;);
        boundary ? h_meso_finish();
      );
      !h_mopen && hm_n<8192 ? (
        h_mstart=id;h_mend=id;h_mseconds=0;h_mtrans=0;h_monsets=0;h_mflags=flags;
        p=h_m(hm_n);memset(p,0,96);h_mopen=1;
      );
      h_mopen ? h_meso_add(id) : h_coverage_lost+=1;
      h_restgrain(id) ? h_rest_seconds+=g[3]/g[4];
    );h_cursor+=1;j+=1;
  );
  h_cursor>=grain_count ? (
    h_meso_finish();h_coverage_lost>0 ? (h_phase=0;h_status=6;) : (hm_n>0 ? (h_phase=3;h_calibrate_start(0);) : (h_phase=0;h_status=2;));
  );
);
function h_macro_finish() local(p m q d i wt first last mid n val lo hi) (
  h_xopen && hx_n<1024 ? (
    n=h_xend-h_xstart;
    // One isolated meso episode is not evidence for a macro regime.
    n>=2 ? (
      p=h_x(hx_n);m=h_m(h_xstart);p[0]=m[0];p[1]=h_xstart;p[2]=n;p[3]=m[3];p[4]=h_xseconds;p[5]=h_xflags;
      p[6]=-1;p[7]=-1;p[8]=-1;
      d=0;loop(48,p[16+d]/=max(0.000001,h_xseconds);d+=1;);
      p[112]/=max(0.000001,h_xseconds);p[113]=1-p[112];p[114]=cp_01(log(1+h_xseconds)/log(601));
      p[115]=1-exp(-max(0,n-1)/max(0.000001,h_xseconds)*0.25);
      p[118]=0;d=0;loop(48,val=p[16+d];val>0 ? p[118]-=val*log(val)/log(48);d+=1;);
      d=0;loop(8,p[120+d]/=max(0.000001,h_xseconds);d+=1;);
      // Ordered beginning/end class distributions distinguish equal-occupancy
      // sections with opposite evolution. Members retain the complete sequence.
      lo=max(1,ceil(n/3));i=0;
      loop(lo,
        first=h_m(h_xstart+i);last=h_m(h_xend-1-i);d=0;loop(3,
          first[6+d]>=0 ? p[64+first[6+d]]-=first[9+d]/lo;
          last[6+d]>=0 ? p[64+last[6+d]]+=last[9+d]/lo;d+=1;
        );i+=1;
      );
      q=h_src(p[0]);q[2]<0 ? q[2]=hx_n;q[3]+=1;
      i=h_xstart;loop(n,m=h_m(i);m[13]=hx_n;i+=1;);hx_n+=1;
    ) : (
      // Not silently called a macro class; meso fallback remains available.
      h_macro_singletons+=1;
    );h_xopen=0;
  );
);
function h_macro_change(id) local(p q i j a b total na nb x) (
  p=h_m(id);memset(h_aux,0,96);na=0;nb=0;i=0;
  loop(3,a=id-1-i;b=id+i;
    a>=0 ? (q=h_m(a);q[0]==p[0] ? (j=0;loop(3,q[6+j]>=0 ? h_aux[q[6+j]]+=q[9+j];j+=1;);na+=1;););
    b<hm_n ? (q=h_m(b);q[0]==p[0] ? (j=0;loop(3,q[6+j]>=0 ? h_aux[48+q[6+j]]+=q[9+j];j+=1;);nb+=1;););
    i+=1;
  );total=0;i=0;loop(48,x=sqrt(h_aux[i]/max(1,na))-sqrt(h_aux[48+i]/max(1,nb));total+=x*x;i+=1;);sqrt(total*0.5);
);
function h_macro_step() local(j p q x boundary d wt id remain sourcesleft i flags) (
  j=0;
  while(j<32 && h_cursor<hm_n) (
    id=h_cursor;p=h_m(id);boundary=0;flags=0;
    h_xopen ? (
      q=h_m(id-1);
      q[0]!=p[0] || abs(q[3]+q[4]-p[3])>0.000001 ? boundary=1 : (
        id-h_xstart>=3 && h_xseconds>=max(0.5,h_min_macro) ? (
          x=h_macro_change(id);x>0.72-0.30*h_sensitive ? boundary=1;
        );
        h_xseconds>=max(45,h_min_macro*2) ? (boundary=1;flags=8;);
        // Preserve room for one macro per later source; excessive file counts
        // disable macro only, rather than corrupting or truncating micro data.
        remain=1024-hx_n;sourcesleft=min(source_count,1024)-p[0];
        remain<=max(1,sourcesleft) && q[0]==p[0] ? boundary=0;
      );boundary ? h_macro_finish();
    );
    !h_xopen && hx_n<1024 ? (
      h_xstart=id;h_xend=id;h_xseconds=0;h_xflags=flags;h_xopen=1;memset(h_x(hx_n),0,128);
    );
    h_xopen ? (
      q=h_x(hx_n);d=0;loop(3,p[6+d]>=0 ? q[16+p[6+d]]+=p[9+d]*p[4];d+=1;);
      q[112]+=p[60]*p[4];d=0;loop(8,q[120+d]+=h_mean(p,d)*p[4];d+=1;);
      h_xseconds+=p[4];h_xend=id+1;
    ) : h_macro_lost+=1;h_cursor+=1;j+=1;
  );
  h_cursor>=hm_n ? (
    h_macro_finish();h_macro_lost>0 ? (
      hx_n=0;hx_k=0;i=0;loop(source_count,q=h_src(i);q[2]=-1;q[3]=0;i+=1;);
      i=0;loop(hm_n,q=h_m(i);q[13]=-1;i+=1;);
      h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=7;
    ) : (hx_n>0 ? (h_phase=9;h_calibrate_start(1);) : (h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=4;));
  );
);
function h_build() local(i score bin sum j q) (
  h_phase==1 ? (
    i=0;while(i<32 && h_cursor<grain_count)(
      score=h_change_at(h_cursor);h_change[h_cursor]=score;bin=floor(cp_clamp(score*127,0,127));h_hist[bin]+=1;h_cursor+=1;i+=1;
    );
    h_cursor>=grain_count ? (
      sum=0;j=0;q=0;while(j<128 && sum<max(1,grain_count*0.65))(sum+=h_hist[j];q=j;j+=1;);
      h_boundary=cp_clamp((q/127)*(1.9-1.0*h_sensitive),0.035,0.28);
      h_phase=2;h_cursor=0;
    );
  ) : (
    h_phase==2 ? h_meso_scan_step() : (
      h_phase==3 || h_phase==9 ? h_calibrate_step(h_phase==3 ? 0 : 1) : (
        h_phase==4 || h_phase==10 ? h_leader_step(h_phase==4 ? 0 : 1) : (
          h_phase==5 || h_phase==11 ? h_refine_step(h_phase==5 ? 0 : 1) : (
            h_phase==6 || h_phase==12 ? h_finalize_step(h_phase==6 ? 0 : 1) : (
              h_phase==7 ? (
                source_count>1024 ? (h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=5;) : (
                  h_min_macro=total_seconds/max(1,1024-source_count)*1.05;h_macro_step();
                );
              );
            );
          );
        );
      );
    );
  );
);

// ---------------- Bounded hierarchical performance controller ----------------
function h_lower(list lo hi key) local(mid) (
  while(lo<hi)(mid=floor((lo+hi)/2);list[mid]<key ? lo=mid+1 : hi=mid;);lo;
);
function h_class_range(level cls src) local(c lo hi s list) (
  h_range_lo=0;h_range_hi=0;
  cls>=0 && cls<h_k(level) ? (
    c=h_cl(level,cls);lo=c[7];hi=lo+c[6];list=h_list(level);
    src>0 ? (src<=source_count ? (
      s=h_src(src-1);
      level<1 ? (h_range_start=s[0];h_range_end=s[0]+s[1];) : (h_range_start=s[2];h_range_end=s[2]+s[3];);
      h_range_start>=0 ? (lo=h_lower(list,lo,hi,h_range_start);hi=h_lower(list,lo,hi,h_range_end);) : hi=lo;
    ) : hi=lo;);
    h_range_lo=lo;h_range_hi=hi;
  );h_range_hi-h_range_lo;
);
function h_allowed(level cls initial) local(c) (
  cls<0 || cls>=h_k(level) ? 0 : (
    c=h_cl(level,cls);c[11]==0 || (c[11]==2 && !initial && level<1);
  );
);
function h_auto_mode(src) local(i n m c) (
  n=0;m=0;i=0;loop(hm_k,c=h_cl(0,i);c[11]==0 && h_class_range(0,i,src)>0 ? n+=1;i+=1;);
  i=0;loop(hx_k,c=h_cl(1,i);c[11]==0 && h_class_range(1,i,src)>0 ? m+=1;i+=1;);
  m>0 && n>0 ? 3 : (n>0 ? 2 : 0);
);
function h_live_model() local(i e q n) (
  i=0;n=0;loop(8,e=cp_e(i);q=h_state+i*96;e[0]>0 && q[0]==e[1] && q[1]>=2 ? n+=1;i+=1;);n;
