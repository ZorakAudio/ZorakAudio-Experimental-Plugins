function amp_from_adsr() local(a total ax dx sx rx aa dd rr scale i u v sus) (
  a=amp_curve_base;total=max(20,slider25);aa=max(0,slider26);dd=max(0,slider27);rr=max(0,slider29);sus=cp_01(slider28);scale=min(1,total/max(1,aa+dd+rr));
  ax=cp_01(aa*scale/total);dx=cp_01((aa+dd)*scale/total);rx=cp_clamp(1-rr*scale/total,dx,0.98);sx=cp_clamp(max(dx,min(rx,0.65)),0.05,0.95);
