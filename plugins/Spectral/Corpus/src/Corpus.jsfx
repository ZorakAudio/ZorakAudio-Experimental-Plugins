block_start_clock=clock;steps_this_block=0;output_target=cp_amp(slider7);
cp_collect();
env_i=0;loop(8,env_e=cp_e(env_i);env_e[33]=clock;env_e[34]=0;env_i+=1;);
slider24!=cmd_seen ? (cmd_seen=slider24;cp_action(floor(slider24+0.5)););
