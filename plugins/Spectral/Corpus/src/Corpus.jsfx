function xc_frame_finish() local(g s p i k freq band power total logarithm peakmax peakbin weighted second flat tonal chr energy win value lag n dot aa bb cc peakshift lp lc ln bestperiod bestcorr ratio harmonic z j base pitch csum validspan)
(
  g=cp_g(xc_cursor);s=cp_s(g[1]);p=xc_g(xc_cursor);
  fft(xc_fft_l,xc_fft_size);fft_permute(xc_fft_l,xc_fft_size);
  fft(xc_fft_r,xc_fft_size);fft_permute(xc_fft_r,xc_fft_size);xc_fft_count+=2;
  total=0;logarithm=0;peakmax=0;peakbin=1;weighted=0;second=0;i=1;
  while(i<xc_fft_size/2)(
    power=(xc_fft_l[i*2]^2+xc_fft_l[i*2+1]^2+xc_fft_r[i*2]^2+xc_fft_r[i*2+1]^2)*0.5;
    xc_power[i]=power;total+=power;logarithm+=log(max(0.000000000000000001,power));
    freq=i*s[3]/xc_fft_size;weighted+=freq*power;second+=freq*freq*power;
    power>peakmax ? (peakmax=power;peakbin=i;);
    band=freq<125 ? 0 : (freq<250 ? 1 : (freq<500 ? 2 : (freq<1000 ? 3 : (freq<2000 ? 4 : (freq<4000 ? 5 : (freq<8000 ? 6 : 7))))));
    xc_tmp[band]+=power;i+=1;
  );
  n=max(1,xc_fft_size/2-1);flat=total>0.000000000000000001 ? cp_01(exp(logarithm/n)/(total/n)) : 1;
  tonal=0;csum=0;i=2;
  while(i<xc_fft_size/2-1)(
    freq=i*s[3]/xc_fft_size;power=xc_power[i];
    freq>=70 && freq<=5000 && power>xc_power[i-1] && power>xc_power[i+1] ? (
      value=max(0,power-(xc_power[i-1]+xc_power[i+1])*0.5);tonal+=value;
      lp=log(max(0.000000000000000001,xc_power[i-1]));lc=log(max(0.000000000000000001,power));ln=log(max(0.000000000000000001,xc_power[i+1]));
      peakshift=abs(lp-2*lc+ln)>0.000001 ? cp_clamp(0.5*(lp-ln)/(lp-2*lc+ln),-0.5,0.5) : 0;
      freq=(i+peakshift)*s[3]/xc_fft_size;
