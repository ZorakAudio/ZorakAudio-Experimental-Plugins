      gid=s[5]+min(s[6]-1,max(0,floor(pos/max(1,s[2])*s[6])));
      gid=cp_clamp(gid,m[1],m[1]+m[2]-1);g_h=cp_g(gid);
      // Compare integer output-sample boundaries, not a floating-point source
