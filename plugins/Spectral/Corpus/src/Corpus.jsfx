    !passage_run ? (pe_plan_event[12]>0 ? (pe_plan_sec=max(0.001,(pe_plan_event[10]-pe_plan_event[5])/srate);pe_plan_cap=max(pe_plan_kind==0 || pe_plan_kind==2 ? 0.050 : 0.075,min(slider52/1000,pe_plan_sec*(pe_plan_kind==0 ? 0.32 : 0.55)));pe_plan_frames=min(pe_plan_frames,max(1,floor(pe_plan_cap*g[4])));) : (path_count>1 ? pe_plan_frames=min(pe_plan_frames,max(1,floor(max(0.075,min(slider52/1000,slider47/10))*g[4])));););
    pg_limit_span(id,pe_plan_start,pe_plan_frames);pe_plan_start=pg_span_start;pe_plan_frames=pg_span_frames;
    pe_excerpt(id,pe_plan_start,pe_plan_frames);pe_span_use=1;
