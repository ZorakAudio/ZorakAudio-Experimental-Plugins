          q[1]==3 && q[6]>=0 ? (
            m=h_x(q[6]);seconds=m[3]+cp_01((when-q[7])/max(1,q[8]-q[7]))*m[4];
            guide=h_at_time(m[0],min(m[3]+m[4]-0.000000001,seconds+0.0000000001));
            guide>=m[1] && guide<m[1]+m[2] ? (
              p=h_m(guide);start=q[7]+(p[3]-m[3])/max(0.000001,m[4])*(q[8]-q[7]);
              end=start+p[4]/max(0.000001,m[4])*(q[8]-q[7]);
              member=h_choose_realization(guide,src,q,slider58);h_set_meso(q,member,guide,start,end);q[9]=guide;
            ) : (q[1]=2;q[17]+=1;h_runtime_backoff+=1;);
          );
        );
