function ui_child_action_name(mode) (
  mode==0 ? strcpy(#ui_child_action,"Follow") : (mode==1 ? strcpy(#ui_child_action,"Resonance") : (mode==2 ? strcpy(#ui_child_action,"Debris") : (mode==3 ? strcpy(#ui_child_action,"Contrast") : (mode==4 ? strcpy(#ui_child_action,"Shadow") : (mode==5 ? strcpy(#ui_child_action,"Body bed") : strcpy(#ui_child_action,"Mixed"))))));
);
function ui_child_description(mode) (
  mode==0 ? (strcpy(#ui_child_short,"Same motion, new grains");strcpy(#ui_child_detail,"Follows the main sound's movement with an independent grain path. Softer attacks and a steady body; it does not duplicate the primary grain sequence."));
  mode==1 ? (strcpy(#ui_child_short,"Weighted body + tails");strcpy(#ui_child_detail,"Favors low-frequency weight, body and tails while avoiding sharp attacks. A selection bias, rather than an added resonator or a tuned oscillator."));
  mode==2 ? (strcpy(#ui_child_short,"Rough, restless detail");strcpy(#ui_child_detail,"Favors motion, crest and detail at a lower energy target. Grain length still follows the source and excerpt ceiling; Debris does not guarantee tiny grains."));
  mode==3 ? (strcpy(#ui_child_short,"Alternate tone + motion");strcpy(#ui_child_detail,"Alternates companions around the main brightness, weight and motion targets. Similarity and identity locks can narrow that contrast."));
  mode==4 ? (strcpy(#ui_child_short,"Calmer, softer support");strcpy(#ui_child_detail,"Favors quieter, calmer body and tail material with fewer attacks. Shadow changes grain selection; it does not low-pass or pitch-shift the source."));
  mode==5 ? (strcpy(#ui_child_short,"Dense supporting layer");strcpy(#ui_child_detail,"The former Fill gaps mode: overlaps body/detail more densely. It creates a supporting bed rather than detecting and filling literal gaps in the primary."));
  mode==6 ? (strcpy(#ui_child_short,"A varied ensemble");strcpy(#ui_child_detail,"Assigns Follow, Resonance, Body bed, Debris, Shadow and Contrast in that order. One child is Follow; more children introduce the other characters."));
);
function ui_child_count_set(count) (ui_notify(76,cp_clamp(floor(count),0,12),1);ui_end_gesture(76););
function ui_child_mode_set(mode) (
  slider76<0 ? ui_child_count_set(cp_child_count());
  ui_notify(77,mode,1);ui_end_gesture(77);
);
