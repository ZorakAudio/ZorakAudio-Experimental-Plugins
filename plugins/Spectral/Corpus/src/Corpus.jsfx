function h_pick_class(level prev src q w freedom) local(k i c z mass total fit d value chosen best bestval means count rowmass)
(
  chosen=-1;best=-1;bestval=-1;total=0;rowmass=0;i=0;k=h_k(level);
  prev>=0 && prev<k ? loop(k,h_allowed(level,i,0) && h_class_range(level,i,src)>0 ? (z=h_link(level,prev,i);rowmass+=z[0];);i+=1;);
  prev>=0 && rowmass<=0.00001 ? (q[17]+=1;h_runtime_backoff+=1;);
  i=0;loop(k,c=h_cl(level,i);
    c[1]>0 && h_allowed(level,i,prev<0) && h_class_range(level,i,src)>0 ? (
      fit=0;d=0;loop(8,
        means=level<1 ? h_mean(c,d) : c[120+d];
        fit+=abs(means-w[16+d])*(d==0 || d==4 ? 0.25 : 1);d+=1;
      );
      mass=c[1];rowmass>0 ? (z=h_link(level,prev,i);mass=z[0];);
