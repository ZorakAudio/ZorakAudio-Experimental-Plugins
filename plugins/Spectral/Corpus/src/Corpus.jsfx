// GFX formats only the published loading metadata; it never advances analysis.
function ui_load_text() local(p group phase) (
  p=ui_snapshot_base+112;group=p[0];phase=p[1];
  strcpy(#ui_load_label,"Preparing analysis");strcpy(#ui_load_count,"");strcpy(#ui_load_step,"");
  group==1 ? sprintf(#ui_load_label,"LOADING %d files",ui_snapshot_base[6]);
  group==2 ? (
    phase==1 ? strcpy(#ui_load_label,"INDEX / Source metadata");
    phase==6 ? strcpy(#ui_load_label,"INDEX / Scout recordings");
    phase==2 ? strcpy(#ui_load_label,"INDEX / Grain layout");
    phase==3 ? strcpy(#ui_load_label,"INDEX / Probe audio");
    phase==7 ? strcpy(#ui_load_label,"INDEX / Assemble grains");
    phase==8 ? strcpy(#ui_load_label,"INDEX / Calibrate features");
    phase==4 ? strcpy(#ui_load_label,"INDEX / Normalize grains");
    phase==5 ? strcpy(#ui_load_label,"INDEX / Retrieval tables");
  );
  group==3 ? (
    phase==1 ? strcpy(#ui_load_label,"FEATURES / Spectral frames");
    phase==2 ? strcpy(#ui_load_label,"FEATURES / Pulse evidence");
    phase==7 ? strcpy(#ui_load_label,"FEATURES / PCA covariance");
    phase==8 ? strcpy(#ui_load_label,"FEATURES / PCA projection");
    phase==9 ? strcpy(#ui_load_label,"FEATURES / PCA normalization");
    phase==3 ? strcpy(#ui_load_label,"FEATURES / Coarse regions");
    phase==4 ? strcpy(#ui_load_label,"FEATURES / Parallel recurrence pairs");
    phase==5 ? strcpy(#ui_load_label,"FEATURES / Recurrence rows");
    phase==6 ? strcpy(#ui_load_label,"FEATURES / Grain neighbours");
    phase==10 ? strcpy(#ui_load_label,"FEATURES / Retrieval tables");
  );
  group==4 ? (
    phase==1 ? strcpy(#ui_load_label,"STRUCTURE / Change scores");
    phase==2 ? strcpy(#ui_load_label,"STRUCTURE / Meso regions");
    phase==3 ? strcpy(#ui_load_label,"STRUCTURE / Meso calibration");
    phase==4 ? strcpy(#ui_load_label,"STRUCTURE / Meso classes");
    phase==5 ? strcpy(#ui_load_label,"STRUCTURE / Meso refinement");
    phase==6 ? strcpy(#ui_load_label,"STRUCTURE / Meso finalization");
    phase==7 ? strcpy(#ui_load_label,"STRUCTURE / Macro regions");
    phase==9 ? strcpy(#ui_load_label,"STRUCTURE / Macro calibration");
    phase==10 ? strcpy(#ui_load_label,"STRUCTURE / Macro classes");
    phase==11 ? strcpy(#ui_load_label,"STRUCTURE / Macro refinement");
    phase==12 ? strcpy(#ui_load_label,"STRUCTURE / Macro finalization");
  );
  group==5 ? strcpy(#ui_load_label,phase==1 ? "GRAMMAR / Meso transitions" : "GRAMMAR / Macro transitions");
  group==6 ? strcpy(#ui_load_label,"MAPPING / Guide episodes");
  group==7 ? strcpy(#ui_load_label,phase==1 ? "FOCUS / Episode features" : "FOCUS / Local EC axes");
  group==8 ? strcpy(#ui_load_label,phase==1 ? "PE / Read grain audio" : (phase==2 ? "PE / Region and EC prediction" : "PE / Retrieval tables"));
  group==9 ? strcpy(#ui_load_label,phase==10 ? "PRUNING / Restore edits" : (phase==1 ? "PRUNING / Eligibility" : (phase==2 ? "PRUNING / Retained spans" : (phase==3 ? "PRUNING / Retrieval tables" : "PRUNING / Apply cache"))));
  group==10 ? strcpy(#ui_load_label,"Adopt loaded sources");
  group==11 ? strcpy(#ui_load_label,"Apply analysis settings");
  group==12 && phase==0 ? strcpy(#ui_load_label,"Prepare structure");
  strcpy(#ui_load_unit,p[6]==1 ? "files" : (p[6]==2 ? "grains" : (p[6]==3 ? "pairs" : (p[6]==4 ? "regions" : (p[6]==5 ? "episodes" : (p[6]==6 ? "ECs" : "probes"))))));
  p[3]>0 ? sprintf(#ui_load_step," %d/%d",p[2],p[3]);
  p[5]>=0 ? sprintf(#ui_load_count,"  %d / %d %s",p[4],p[5],#ui_load_unit);
  sprintf(#ui_loading,"%s%s%s",#ui_load_label,#ui_load_step,#ui_load_count);
  group==0 ? (
    strcpy(#ui_load_label,ui_wait || ui_qn>0 ? "Queued action" : "Source status");
    p[9]==2 ? sprintf(#ui_loading,"READY  %d grains / %d ECs / %d Macro",ui_snapshot_base[18],54656[4],54656[6]) : (
      p[9]==3 ? strcpy(#ui_loading,"STRUCTURE UNAVAILABLE / see status help") : (
        p[9]==4 ? strcpy(#ui_loading,"ANALYSIS COMPLETE / no playable grains") : (
          p[9]==5 ? sprintf(#ui_loading,"NO VALID AUDIO / %d failed files",ui_snapshot_base[8]) : strcpy(#ui_loading,"LOAD FILES IN SLOT 0")
        )
      )
    );
  );
  p[7]>0 ? sprintf(#ui_loading,"WAIT FOR AUDIO TO FINISH / %s",#ui_load_label);
  ui_load_stale ? sprintf(#ui_loading,"WAITING FOR PROCESSING / %s",#ui_load_label);
);
function ui_load_tip() local(p) (
  p=ui_snapshot_base+112;
  ui_load_stale ? (
    sprintf(#ui_load_help,"No new processing snapshot for %.1f seconds. Last task: %s%s%s. The host may have suspended audio processing; resume it to continue. Corpus cannot run loading analysis without processing callbacks.",ui_now-ui_load_seen_time,#ui_load_label,#ui_load_step,#ui_load_count);
  ) : p[7]>0 ? (
    sprintf(#ui_load_help,"%s%s%s is waiting for active notes, voices or a preview to finish. Release notes or press Corpus STOP to let preparation continue.",#ui_load_label,#ui_load_step,#ui_load_count);
  ) : p[9]==3 ? (
    strcpy(#ui_load_help,p[10]==3 ? "Structure cannot be built for more than 8192 sources. Reduce the source set; contextual PE and generation require a completed structure." : "Structure coverage was exhausted. Reduce the source set or use coarser analysis settings. Contextual PE and generation are not ready.");
  ) : (
    sprintf(#ui_load_help,"%s. Counts and the bar describe this stage only, not total time remaining. Recurrence compares N x N coarse-region pairs. Refinement and finalization count both passes. Optional stages can be skipped. PE is computed during preparation and cached for playback; no analysis runs in the interface.",#ui_loading);
  );
  ui_auto[22]>0 ? sprintf(#ui_load_help,"%s Preparation recovered automatically after an interrupted background job.",#ui_load_help);
  ui_tip(#ui_load_help);
);

