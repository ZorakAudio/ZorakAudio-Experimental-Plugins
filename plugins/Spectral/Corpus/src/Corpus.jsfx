          member=h_pick_member(0,cls,src,q,slider58,q[2]);
          member>=0 ? (p=h_m(member);total=max(1,p[4]*srate*slider62);e[12]>0 ? total=min(total,max(1,e[10]-when));h_set_meso(q,member,member,when,when+total);) : (
            q[1]=0;h_active=0;q[17]+=1;h_runtime_backoff+=1;
          );
        );
      );
