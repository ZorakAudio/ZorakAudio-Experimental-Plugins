  tonal=cp_01((tonal/max(0.000000000000000001,total)-0.10)*2.5)*cp_01((bestcorr-0.35)/0.60)*validspan;
  i=0;loop(8,xc_tmp[i]/=max(0.000000000000000001,total);p[i]+=xc_tmp[i]/3;i+=1;);
  energy=sqrt((xc_pow_l+xc_pow_r)/max(1,xc_read_count*2));
  xc_tmp[8]=weighted/max(0.000000000000000001,total)/max(1,s[3]*0.5);
  xc_tmp[9]=sqrt(max(0,second/max(0.000000000000000001,total)-(weighted/max(0.000000000000000001,total))^2))/max(1,s[3]*0.5);
  xc_tmp[10]=flat;xc_tmp[11]=cp_01(0.5+(xc_tmp[6]+xc_tmp[7]-xc_tmp[0]-xc_tmp[1])*0.5);
  xc_tmp[12]=tonal;xc_tmp[13]=cp_01(bestcorr);
  xc_tmp[14]=cp_01(0.5+0.5*xc_cross/sqrt(max(0.000000000000000001,xc_pow_l*xc_pow_r)));
