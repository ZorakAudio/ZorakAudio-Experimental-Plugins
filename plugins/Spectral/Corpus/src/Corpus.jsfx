      lo<s[0]+s[1] ? (p=h_m(lo);seconds>=p[3] && seconds<p[3]+p[4] ? result=lo;);
    );
  );result;
);
function h_choose_realization(guide src q freedom) local(p cls sum i id wt member) (
  p=h_m(guide);cls=p[6];sum=0;i=0;
