        ui_hit(axx,y+68,bw,28) ? (sprintf(#ui_txt,"%s unavailable for this EC. PC1 needs at least 3 regions, PC2 4, PC3 5, plus non-degenerate variance.",#ui_focus_axis);ui_tip(#ui_txt););
      );i+=1;
