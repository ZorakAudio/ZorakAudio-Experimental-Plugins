  ui_text(x+10,y+25,w-16,21,#ui_val,0.90,0.95,0.96);
  ui_box(x+10,y+59,w-20,3,0.14,0.20,0.25);ui_box(x+10,y+59,(w-20)*value,3,0.31,0.73,0.65);
