// Dedicated trajectory surface. GFX edits go through the acknowledged DSP
// command queue; audio owns committed curves and publishes their host state.
function ui_tr_undo_capture(lane) (
  memcpy(ui_tr_undo+lane*32,ui_traj+lane*40+8,32);ui_tr_undo_mask=ui_tr_undo_mask|pow(2,lane);
);
function ui_tr_scale(desc) local(p span pad) (
  p=ui_tr_range+cp_clamp(floor(desc),0,53)*3;ui_tr_lo=0;ui_tr_hi=1;
  p[2]>0 ? (
    span=max(0,p[1]-p[0]);pad=span>0.000001 ? span*0.03 : 0.005;
    ui_tr_lo=max(0,p[0]-pad);ui_tr_hi=min(1,p[1]+pad);
  );
);
function ui_tr_to_view(v) (cp_01((v-ui_tr_lo)/max(0.000001,ui_tr_hi-ui_tr_lo)););
function ui_tr_from_view(v) (ui_tr_lo+cp_01(v)*(ui_tr_hi-ui_tr_lo););
function ui_tr_axis_text(desc v) (
  desc==53 ? sprintf(#ui_axis_text,"%.0f ms",ui_length_ms(v)) : sprintf(#ui_axis_text,"%.1f%%",v*100);
);
function ui_tr_shape(lane shape) local(i u v a p) (
  ui_tr_undo_capture(lane);p=ui_traj+lane*40;ui_tr_scale(p[1]);ui_curve_draw_begin(lane,p);i=0;
  loop(32,u=i/31;v=0.5;
    shape==1 ? v=u;shape==2 ? v=1-u;
    shape==3 ? v=0.15+0.75*sin($pi*u);
    shape==4 ? v=0.9-0.75*sin($pi*u);
    shape==5 ? v=0.15+0.75*(u<0.2 ? u/0.2 : max(0,1-(u-0.2)/0.8));
    shape==6 ? v=0.15+0.75*floor(u*3.999)/3;
    shape<7 ? v=ui_tr_from_view(v);
    shape==7 ? v=p[8+31-i];shape==8 ? v=cp_01(ui_tr_lo+ui_tr_hi-p[8+i]);
    ui_curve_paint[i]=cp_01(v);i+=1;
  );ui_curve_draw_commit();
);
function ui_tr_undo_shape(lane) local(i v p) (
  (ui_tr_undo_mask&pow(2,lane))>0 ? (
    p=ui_traj+lane*40;ui_curve_draw_begin(lane,p);i=0;
    loop(32,v=ui_tr_undo[lane*32+i];ui_tr_undo[lane*32+i]=p[8+i];ui_curve_paint[i]=v;i+=1;);ui_curve_draw_commit();
  );
);
