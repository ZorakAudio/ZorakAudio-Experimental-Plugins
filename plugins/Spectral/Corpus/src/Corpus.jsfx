    while(i!=b)(frac=abs(i-a)/max(1,abs(b-a));val=ui_curve_draw_prev_y+(yn-ui_curve_draw_prev_y)*frac;lane==12 && (i==0 || i==31) ? val=0;ui_curve_paint[i]=cp_01(val);i+=step;);
    ui_curve_paint[b]=yn;
  );
  lane==12 ? (ui_curve_paint[0]=0;ui_curve_paint[31]=0;);ui_curve_draw_prev=idx;ui_curve_draw_prev_y=yn;
);
