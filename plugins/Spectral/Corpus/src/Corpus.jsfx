build_phase>0 ? cp_build(min(4096,max(256,samplesblock*8)));
cp_browse_update();
// Complete heavy analysis before adopting a new rich/structural model. Never
// rebuild cache memory under sounding voices or hold a GFX thread hostage.
ready && xc_ready && slider52!=xc_built_ceiling && cp_hold_count()==0 && cp_busy()==0 ? (xc_begin();h_ready=0;h_phase=0;);
xc_phase>0 && cp_hold_count()==0 && cp_busy()==0 ? xc_build(min(4096,max(128,samplesblock*4)));
// A hierarchy rebuild waits for active users; initial learning may progress
