function h_macro_gap(src start seconds anchor) local(p q) (
  // A chronological hole can become REST only here, at Macro scale. Short
  // gaps remain sparsity and are bridged by the active generator.
  seconds>=0.45 && hx_n<1024 ? (
    p=h_x(hx_n);memset(p,0,128);p[0]=src;p[1]=max(0,anchor);p[2]=0;p[3]=start;p[4]=seconds;p[5]=32;
    p[6]=-1;p[7]=-1;p[8]=-1;p[112]=0;p[113]=1;p[114]=cp_01(log(1+seconds)/log(601));
    p[115]=0;p[116]=1;p[117]=1;p[118]=0;p[119]=1;
