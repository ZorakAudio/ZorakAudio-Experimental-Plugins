    best>=0 ? (bin=min(15,floor(cp_01(target)*16));lo=max(0,bin-1);hi=min(15,bin+1);
      while(lo<=hi)(key=d*16+lo;n=min(32,counts[key]);j=0;
        loop(min(4,n),candidate_n<(tr_candidate_added ? 48 : 64) ? (id=entries[key*32+min(n-1,floor((j+0.5)*n/max(1,min(4,n))))];h_add_candidate(id,-7,src););j+=1;);lo+=1;
      );
    );d+=1;
  );
