function cp_fill_grain(id) local(g v pos) (
  g=cp_g(id);cp_valid(id) ? (v=0;loop(29,
    cp_member(id,v)>0.00001 ? (
      pos=offsets[v]+fill_cursor[v];postings[pos]=id;fill_cursor[v]+=1;
    );v+=1;
  ););
