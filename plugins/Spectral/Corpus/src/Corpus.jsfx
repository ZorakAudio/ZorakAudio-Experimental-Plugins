function cp_path_candidates(src) local(axis pass b bin k n i ix id g dist j at total) (
  path_candidates_n=0;
  path_count>1 && slider39>0 ? (
    memset(path_best,-1,32);total=0;pass=0;
    loop(2,axis=pass==0 ? path_axis_x : path_axis_y;b=min(15,floor(target_base[axis]*16));bin=max(0,b-1);
      while(bin<=min(15,b+1))(
