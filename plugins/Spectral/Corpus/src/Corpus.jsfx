// Four constant-time status reads detect a loader transition on the first
// available callback, even if the periodic poll has not expired. No PCM access.
function cp_pool_changed() local(state gen selected failed) (
  state=sample_pool_state(bank_pool);gen=sample_pool_generation(bank_pool);
  selected=sample_pool_selected(bank_pool);failed=sample_pool_failed(bank_pool);
  state!=pool_watch_state || gen!=pool_watch_generation || selected!=pool_watch_selected || failed!=pool_watch_failed || slider13!=pool_watch_budget;
);
function cp_poll() local(gen state adopted signature)
(
  sample_pool_set_mode(bank_pool,slider13>0 ? 1 : 0);
  sample_pool_set_budget_mb(bank_pool,max(0,slider13));
  sample_pool_commit(bank_pool);
  pool_state=sample_pool_state(bank_pool); pool_selected=sample_pool_selected(bank_pool);
  pool_loaded=sample_pool_loaded(bank_pool); pool_failed=sample_pool_failed(bank_pool);
  pool_ram=sample_pool_ram_mb(bank_pool); gen=sample_pool_generation(bank_pool);
  signature=gen+pool_loaded*8191+pool_failed*131+pool_state*17+pool_selected*32771;
  (signature!=loaded_signature || rebuild_request || !have_generation) && pool_state!=1 && pool_state!=2 ? pending_adoption=1;
  // During a render prepare, finish the armed take from its current immutable
  // bank before adopting the host's re-commit of those same files.
