  );
  pool_watch_state=pool_state;pool_watch_generation=gen;pool_watch_selected=pool_selected;pool_watch_failed=pool_failed;pool_watch_budget=slider13;
);

// ---------------- Event-owned, bounded linear + child walkers ----------------
