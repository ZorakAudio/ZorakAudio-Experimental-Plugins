function tr_reset_lane(i desc enable) local(p j) (
  p=tr_lane(i);memset(p,0,40);p[0]=enable;p[1]=cp_clamp(floor(desc),0,53);p[2]=0;p[3]=0.85;p[4]=enable;p[5]=32;p[6]=0;
