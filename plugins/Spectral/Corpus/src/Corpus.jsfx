      pool_loaded=sample_pool_loaded(bank_pool);pool_failed=sample_pool_failed(bank_pool);pool_ram=sample_pool_ram_mb(bank_pool);
      loaded_signature=generation+pool_loaded*8191+pool_failed*131+pool_state*17+pool_selected*32771;
      pending_adoption=0;rebuild_request=0;cp_begin();ui_left=0;
