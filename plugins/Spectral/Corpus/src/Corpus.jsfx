function fc_command(arg) local(code cls axis v p c) (
  arg>=32000 && arg<32192 ? (
    code=arg-32000;cls=floor(code/4);axis=code%4;p=fc_cfgp(cls);c=fc_cl(cls);p[1]=cp_clamp(axis,0,max(0,floor(c[3])-1));p[2]=0;p[3]=1;fc_recount(cls);
  ) : arg>=32200 && arg<32248 ? (
    cls=arg-32200;p=fc_cfgp(cls);p[0]=1-p[0];fc_recount(cls);
  ) : arg>=32300 && arg<32348 ? (
    cls=arg-32300;p=fc_cfgp(cls);p[0]=0;p[1]=0;p[2]=0;p[3]=1;fc_recount(cls);
  ) : arg>=33000 && arg<45288 ? (
    code=arg-33000;cls=floor(code/256);v=(code%256)/255;p=fc_cfgp(cls);p[2]=min(v,p[3]);fc_recount(cls);
  ) : arg>=46000 && arg<58288 ? (
    code=arg-46000;cls=floor(code/256);v=(code%256)/255;p=fc_cfgp(cls);p[3]=max(v,p[2]);fc_recount(cls);
  );
);
function fc_vec_normalize(v cls pc canonical) local(k p d dot norm maxa maxi) (
  k=1;while(k<pc)(p=fc_axis(fc_cl(cls),k);dot=0;d=0;loop(51,dot+=v[d]*p[d];d+=1;);d=0;loop(51,v[d]-=dot*p[d];d+=1;);k+=1;);
  norm=0;d=0;loop(51,norm+=v[d]*v[d];d+=1;);norm=sqrt(max(0.000000000001,norm));d=0;loop(51,v[d]/=norm;d+=1;);
  canonical ? (maxa=0;maxi=0;d=0;loop(51,abs(v[d])>maxa ? (maxa=abs(v[d]);maxi=d;);d+=1;);v[maxi]<0 ? (d=0;loop(51,v[d]=-v[d];d+=1;);););
  fc_last_norm=norm;
);
function fc_episode_one(id) local(p v c i grain d cf sumw) (
  p=h_m(id);v=fc_epv(id);c=fc_epc(id);memset(v,0,51);memset(c,0,51);i=0;
  loop(8,grain=xc_hgrain(0,p,(i+0.5)/8);grain>=0 && grain<grain_count && cp_valid(grain) ? (
    d=0;loop(51,cf=cp_desc_conf(grain,d);cf>0.000001 ? (v[d]+=cp_desc(grain,d)*cf;c[d]+=cf;);d+=1;);
  );i+=1;);
  d=0;loop(51,sumw=c[d];sumw>0.000001 ? v[d]/=sumw : v[d]=0.5;c[d]=cp_01(sumw/8);
    focus_global[d]+=v[d]*c[d];focus_global[64+d]+=v[d]*v[d]*c[d];focus_global[128+d]+=c[d];d+=1;);
);
function fc_global_finish() local(d w mean var) (
  d=0;loop(51,w=focus_global[128+d];mean=w>0.000001 ? focus_global[d]/w : 0.5;var=w>0.000001 ? focus_global[64+d]/w-mean*mean : 0;
    focus_global[d]=mean;focus_global[64+d]=max(0.015,sqrt(max(0,var)));focus_global[128+d]=cp_01(w/max(1,hm_n));d+=1;);
);
function fc_class_start(cls) local(c hc n d) (
  fc_class_cursor=cls;c=fc_cl(cls);memset(c,0,224);n=h_class_range(0,cls,0);fc_lo=h_range_lo;fc_n=n;fc_member_cursor=0;
  memset(focus_tmp_mean,0,51);memset(focus_tmp_weight,0,51);hc=h_cl(0,cls);c[1]=n;c[2]=hc[2];
  n<2 ? (fc_class_cursor+=1;fc_phase=2;fc_subphase=0;) : (fc_phase=3;);
);
function fc_mean_step() local(list i id v cf d n) (
  list=hm_list;i=0;while(i<64 && fc_member_cursor<fc_n)(id=list[fc_lo+fc_member_cursor];v=fc_epv(id);cf=fc_epc(id);d=0;loop(51,focus_tmp_mean[d]+=v[d]*cf[d];focus_tmp_weight[d]+=cf[d];d+=1;);fc_member_cursor+=1;i+=1;);
  fc_member_cursor>=fc_n ? (d=0;loop(51,focus_tmp_mean[d]=focus_tmp_weight[d]>0.000001 ? focus_tmp_mean[d]/focus_tmp_weight[d] : focus_global[d];d+=1;);fc_phase=4;);
);
function fc_pc_supported(pc n) (pc==1 ? n>=3 : (pc==2 ? n>=4 : n>=5););
function fc_essence() local(c v d z w norm) (
  c=fc_cl(fc_class_cursor);v=fc_axis(c,0);norm=0;d=0;loop(51,w=sqrt(max(0,(focus_tmp_weight[d]/max(1,fc_n))*focus_global[128+d]));z=(focus_tmp_mean[d]-focus_global[d])/focus_global[64+d]*w;v[d]=z;norm+=z*z;d+=1;);
  c[15]=sqrt(max(0,norm));fc_vec_normalize(v,fc_class_cursor,1,1);c[3]=1;
  fc_pc=1;fc_iter=0;fc_member_cursor=0;fc_pc_supported(1,fc_n) ? fc_phase=5 : (fc_phase=6;memset(c+7,0,8));
);
function fc_pc_setup() local(v d z) (
  v=focus_tmp_v;d=0;loop(51,z=((d*37+fc_class_cursor*13+fc_pc*17)%101)/50-1;v[d]=z;d+=1;);fc_vec_normalize(v,fc_class_cursor,fc_pc,0);memset(focus_tmp_u,0,51);fc_member_cursor=0;
);
function fc_pc_step() local(list id v cf d y dot i c axis norm) (
  fc_member_cursor==0 && fc_iter==0 && focus_tmp_u[63]==0 ? (fc_pc_setup();focus_tmp_u[63]=1;);
  list=hm_list;i=0;while(i<64 && fc_member_cursor<fc_n)(id=list[fc_lo+fc_member_cursor];v=fc_epv(id);cf=fc_epc(id);dot=0;d=0;loop(51,y=(v[d]-focus_tmp_mean[d])/focus_global[64+d]*sqrt(max(0,cf[d]*focus_global[128+d]));focus_tmp_y[d]=y;dot+=y*focus_tmp_v[d];d+=1;);d=0;loop(51,focus_tmp_u[d]+=dot*focus_tmp_y[d];d+=1;);fc_member_cursor+=1;i+=1;);
  fc_member_cursor>=fc_n ? (
    fc_vec_normalize(focus_tmp_u,fc_class_cursor,fc_pc,fc_iter>=4);norm=fc_last_norm;
    fc_iter<4 ? (memcpy(focus_tmp_v,focus_tmp_u,51);memset(focus_tmp_u,0,64);focus_tmp_u[63]=1;fc_iter+=1;fc_member_cursor=0;) : (
      c=fc_cl(fc_class_cursor);axis=fc_axis(c,fc_pc);memcpy(axis,focus_tmp_u,51);c[15+fc_pc]=norm/max(1,fc_n);c[3]=fc_pc+1;fc_pc+=1;fc_iter=0;fc_member_cursor=0;memset(focus_tmp_u,0,64);
      fc_pc<=3 && fc_pc_supported(fc_pc,fc_n) ? (fc_phase=5;) : (fc_phase=6;fc_member_cursor=0;memset(c+7,0,8););
    );
  );
);
function fc_project_raw(id axis) local(v cf vec d y dot c) (
  v=fc_epv(id);cf=fc_epc(id);c=fc_cl(fc_class_cursor);vec=fc_axis(c,axis);dot=0;d=0;
  loop(51,y=(v[d]-(axis==0 ? focus_global[d] : focus_tmp_mean[d]))/focus_global[64+d]*sqrt(max(0,cf[d]*focus_global[128+d]));dot+=y*vec[d];d+=1;);dot;
);
function fc_project_step() local(list i id cr c a raw) (
  c=fc_cl(fc_class_cursor);list=hm_list;i=0;while(i<64 && fc_member_cursor<fc_n)(id=list[fc_lo+fc_member_cursor];cr=fc_coord(id);a=0;loop(4,raw=a<c[3] ? fc_project_raw(id,a) : 0;cr[a]=raw;a<c[3] ? (c[7+a]+=raw;c[11+a]+=raw*raw;);a+=1;);fc_member_cursor+=1;i+=1;);
  fc_member_cursor>=fc_n ? (a=0;loop(4,a<c[3] ? (c[7+a]/=max(1,fc_n);c[11+a]=max(0.0001,sqrt(max(0,c[11+a]/max(1,fc_n)-c[7+a]*c[7+a])));) : (c[7+a]=0;c[11+a]=1;);a+=1;);fc_member_cursor=0;fc_phase=7;);
);
function fc_normalize_step() local(list i id cr c a) (
  c=fc_cl(fc_class_cursor);list=hm_list;i=0;while(i<96 && fc_member_cursor<fc_n)(id=list[fc_lo+fc_member_cursor];cr=fc_coord(id);a=0;loop(4,cr[a]=a<c[3] ? cp_01(0.5+(cr[a]-c[7+a])/(6*c[11+a])) : 0.5;a+=1;);fc_member_cursor+=1;i+=1;);
  fc_member_cursor>=fc_n ? (c[0]=1;fc_recount(fc_class_cursor);fc_class_cursor+=1;fc_phase=2;fc_subphase=0;);
);
function fc_begin() local(key) (
  key=fc_key();fc_ready=0;fc_phase=1;fc_cursor=0;fc_class_cursor=0;fc_member_cursor=0;fc_model_key=key;fc_epoch=h_epoch;fc_subphase=0;memset(focus_class,0,10752);memset(focus_global,0,256);
  fc_cfg_key!=key ? (fc_cfg_defaults();fc_cfg_key=key;);
);
function fc_step() local(i d) (
  fc_phase==1 ? (
    i=0;while(i<16 && fc_cursor<hm_n)(fc_episode_one(fc_cursor);fc_cursor+=1;i+=1;);
    fc_cursor>=hm_n ? (fc_global_finish();fc_class_cursor=0;fc_phase=2;);
  ) : fc_phase==2 ? (
    fc_class_cursor>=hm_k ? (fc_phase=0;fc_ready=1;fc_built_key=fc_model_key;) : fc_class_start(fc_class_cursor);
  ) : fc_phase==3 ? fc_mean_step() : (fc_phase==4 ? fc_essence() : (fc_phase==5 ? fc_pc_step() : (fc_phase==6 ? fc_project_step() : (fc_phase==7 ? fc_normalize_step();))));
);
function fc_publish(cls) local(z p c cfg n lo list i j id ep lastsrc kept sources count axis vec best bestid d k used v) (
  z=60700;memset(z,0,512);z[0]=fc_ready;z[1]=fc_phase;z[2]=cls;z[12]=fc_cursor;z[13]=fc_model_key;z[21]=fc_epoch;
  fc_ready && cls>=0 && cls<hm_k && fc_cl(cls)[0]>0.5 ? (
    c=fc_cl(cls);cfg=fc_cfgp(cls);z[3]=cfg[0];z[4]=cfg[1];z[5]=cfg[2];z[6]=cfg[3];z[7]=c[1];z[8]=c[4];z[9]=c[2];z[10]=c[5];z[11]=c[3];z[14]=c[15];z[15]=c[16];z[16]=c[17];z[17]=c[18];
    n=h_class_range(0,cls,0);lo=h_range_lo;list=hm_list;count=min(96,n);z[20]=count;i=0;
    loop(count,j=min(n-1,floor((i+0.5)*n/max(1,count)));id=list[lo+j];ep=h_m(id);p=z+32+i*4;p[0]=id;p[1]=ep[0];p[2]=fc_coord(id)[cp_clamp(floor(cfg[1]),0,max(0,floor(c[3])-1))];p[3]=fc_member_in_range(cls,id);i+=1;);
    axis=cp_clamp(floor(cfg[1]),0,max(0,floor(c[3])-1));vec=fc_axis(c,axis);memset(focus_tmp_used,0,51);i=0;
    loop(6,best=0;bestid=-1;d=0;loop(51,focus_tmp_used[d]<0.5 && abs(vec[d])>best ? (best=abs(vec[d]);bestid=d;);d+=1;);bestid>=0 ? (focus_tmp_used[bestid]=1;p=61136+i*3;p[0]=bestid;p[1]=vec[bestid];p[2]=best;);i+=1;);
  );
);
function h_live_model() local(i e q n) (
  i=0;n=0;loop(8,e=cp_e(i);q=h_state+i*96;e[0]>0 && q[0]==e[1] && q[1]>=2 ? n+=1;i+=1;);n;
);
function xc_gram_slot(level a b c create) local(hash i p slot found) (
  hash=(a*1369+b*37+c+level*251)%1024;i=0;found=-1;
  while(i<8 && found<0)(slot=(hash+i)%1024;p=xc_grammar+slot*6;
    p[4]<=0 ? (create ? (p[0]=level;p[1]=a;p[2]=b;p[3]=c;found=slot;);i=8;) : (
      p[0]==level && p[1]==a && p[2]==b && p[3]==c ? found=slot;
    );i+=1;
  );found;
);

function xc_second_order(level a b c) local(slot p) (
  slot=a>=0 && b>=0 && c>=0 ? xc_gram_slot(level,a,b,c,0) : -1;
  slot>=0 ? (p=xc_grammar+slot*6;p[4];) : 0;
);

function h_pick_member(level cls src q freedom avoid) local(c list n lo j i id p cost value sum chosen best bestcost probes eligible seen target at) (
  chosen=-1;n=h_class_range(level,cls,src);lo=h_range_lo;list=h_list(level);
  n>0 ? (
    c=h_cl(level,cls);bestcost=100;best=-1;sum=0;j=0;h_probe_seed=h_rnd(q);
    level<1 && (fc_focus_enabled(cls) || (pg_changed && !pg_bypass) || pg_preview) ? (
      // Focused selection is still bounded in expensive distance work. A cheap
      // first pass counts retained members, then <=64 evenly spread retained
      // members receive the ordinary acoustic/member score.
      eligible=0;i=0;while(i<n)(fc_member_allowed(cls,list[lo+i]) ? eligible+=1;i+=1;);
      probes=min(64,eligible);seen=0;at=0;i=0;
      while(i<n && at<probes)(id=list[lo+i];fc_member_allowed(cls,id) ? (
        target=floor((at+h_probe_seed)*eligible/max(1,probes));target=min(eligible-1,target);
        seen>=target ? (p=h_ep(level,id);cost=h_dist(level,p,c)+(id==avoid ? 0.05*freedom : 0);cost<bestcost ? (bestcost=cost;best=id;);value=exp(-cost/max(0.01,0.01+freedom*0.18));sum+=value;h_rnd(q)*sum<value ? chosen=id;at+=1;);seen+=1;
      );i+=1;);
    ) : (
      probes=min(16,n);loop(probes,i=lo+min(n-1,floor((j+h_probe_seed)*n/max(1,probes)));id=list[i];p=h_ep(level,id);cost=h_dist(level,p,c)+(id==avoid ? 0.05*freedom : 0);cost<bestcost ? (bestcost=cost;best=id;);value=exp(-cost/max(0.01,0.01+freedom*0.18));sum+=value;h_rnd(q)*sum<value ? chosen=id;j+=1;);
    );freedom<=0.0001 ? chosen=best;
  );chosen;
);
function h_pick_class(level prev src q w freedom) local(k i c z mass total fit d value chosen best bestval means count rowmass specialprior secondtotal second older)
(
  chosen=-1;best=-1;bestval=-1;total=0;rowmass=0;i=0;k=h_k(level);
  prev>=0 && prev<k ? loop(k,h_allowed(level,i,0) && fc_class_available(level,i,src) ? (z=h_link(level,prev,i);rowmass+=z[0];);i+=1;);
  prev>=0 && rowmass<=0.00001 ? (q[17]+=1;h_runtime_backoff+=1;);
  secondtotal=0;older=level<1 ? q[80] : q[81];
  xc_grammar_ready && xc_params[9]>0 && older>=0 && prev>=0 ? (i=0;loop(k,
    h_allowed(level,i,0) && fc_class_available(level,i,src) ? secondtotal+=xc_second_order(level,older,prev,i);i+=1;
  ););
  i=0;loop(k,c=h_cl(level,i);
    c[1]>0 && h_allowed(level,i,prev<0) && fc_class_available(level,i,src) ? (
      fit=0;d=0;loop(8,
        means=level<1 ? h_mean(c,d) : c[120+d];
        fit+=abs(means-w[16+d])*(d==0 || d==4 ? 0.25 : 1);d+=1;
      );
      mass=c[1];rowmass>0 ? (z=h_link(level,prev,i);mass=z[0];);
      // Unobserved transitions have no invented statistical support. If an
      // observed row has no eligible successor, report a backoff before using
      // occupancy; otherwise preserve its observed support.
      secondtotal>0 ? mass=mass*(1-xc_params[9])+max(1,rowmass)*xc_params[9]*xc_second_order(level,older,prev,i)/secondtotal;
      specialprior=exp(-c[12]*(0.05+0.35*(1-slider34)));
      value=mass*exp(-fit/max(0.06,0.1+0.8*freedom))*specialprior;
      value>bestval ? (bestval=value;best=i;);
      total+=value;value>0 && h_rnd(q)*total<value ? chosen=i;
    );i+=1;
  );freedom<=0.0001 ? chosen=best;chosen;
);
function h_at_time(src seconds) local(s lo hi mid p result) (
  result=-1;
  src>=0 && src<source_count ? (
    s=h_src(src);lo=s[0];hi=lo+s[1];
    lo>=0 && s[1]>0 ? (
      while(lo<hi)(mid=floor((lo+hi)/2);p=h_m(mid);p[3]+p[4]<=seconds ? lo=mid+1 : hi=mid;);
      lo<s[0]+s[1] ? (p=h_m(lo);seconds>=p[3] && seconds<p[3]+p[4] ? result=lo;);
    );
  );result;
);
function h_macro_at_time(src seconds) local(s lo hi mid p result) (
  result=-1;
  src>=0 && src<source_count ? (
    s=h_src(src);lo=s[2];hi=lo+s[3];
    lo>=0 && s[3]>0 ? (
      while(lo<hi)(mid=floor((lo+hi)/2);p=h_x(mid);p[3]+p[4]<=seconds ? lo=mid+1 : hi=mid;);
      lo<s[2]+s[3] ? (p=h_x(lo);seconds>=p[3] && seconds<p[3]+p[4] ? result=lo;);
    );
  );result;
);
// ---------- Sparse second-order grammar / duration and termination evidence ----------
function xc_post_begin() (
  xc_grammar_ready=0;xc_post_phase=1;xc_post_cursor=0;xc_grammar_epoch=index_epoch;xc_grammar_overflow=0;xc_terminal_examples=0;xc_triples=0;
  memset(xc_grammar,0,6144);memset(xc_dwell,0,1152);memset(xc_endstats,0,288);memset(xc_states,0,512);
);
function xc_closed_pause(p) local(source next end at q i g valid seen maxpeak reached) (
  // Only fully checked INTERNAL intervals support a learned ending. File ends
  // and excluded/partially inspected gaps cannot become positive examples.
  source=p[0];at=p[3]+p[4];end=-1;next=h_macro_at_time(source,at+0.00001);
  next>=0 ? (q=h_x(next);q[117]>0.5 && q[4]>=0.45 ? end=q[3]+q[4];);
  valid=0;
  end>at+0.40 ? (
    q=cp_s(source);end<q[2]/q[3]-0.01 ? (
      i=q[5]+floor(at*q[3]/max(1,q[2])*q[6]);
      i<q[5]+q[6] ? (g=cp_g(i);(g[2]+g[3])/g[4]<=at+0.000001 ? i+=1;);
      seen=0;maxpeak=0;valid=1;reached=0;
      while(i<q[5]+q[6] && seen<512 && !reached)(g=cp_g(i);
        g[2]/g[4]>=end-0.000001 ? reached=1 : (
          g[9]>0.5 ? valid=0;maxpeak=max(maxpeak,g[7]);seen+=1;i+=1;
        );
      );!reached || maxpeak>max(0.00001,q[7]*0.0001) ? valid=0;
    );
  );valid;
);
function xc_grammar_one(level id) local(p prev prev2 q idx bin slot z endprob) (
  p=h_ep(level,id);idx=p[6]+level*48;
  p[6]>=0 && p[6]<h_k(level) ? (
    bin=cp_clamp(floor(log(max(0.02,p[4])/0.02)/log(2)),0,15);xc_dwell[idx*16+bin]+=1;
    z=xc_endstats+idx*4;z[0]+=1;z[2]+=p[4];
    endprob=xc_closed_pause(p);
    endprob ? (z[1]+=1;xc_terminal_examples+=1;);z[3]=z[0]>0 ? z[1]/(z[0]+2) : 0;
  );
  id>=2 ? (
    prev=h_ep(level,id-1);prev2=h_ep(level,id-2);
    p[0]==prev[0] && p[0]==prev2[0] && abs(prev[3]+prev[4]-p[3])<0.000001 && abs(prev2[3]+prev2[4]-prev[3])<0.000001 && p[6]>=0 && prev[6]>=0 && prev2[6]>=0 ? (
      slot=xc_gram_slot(level,prev2[6],prev[6],p[6],1);
      slot>=0 ? (q=xc_grammar+slot*6;q[4]+=1;q[5]=p[0];xc_triples+=1;) : xc_grammar_overflow+=1;
    );
  );
);
// Transfer map: guide episodes -> up to four target episodes. The structural
// metric deliberately omits absolute timbre/chroma. Strict source exclusion is
// applied independently at every Micro candidate route, not just this map.
function xc_map_begin() (
  xc_map_ready=0;xc_map_phase=1;xc_map_cursor=0;xc_map_source=cp_clamp(floor(slider64)-1,0,max(0,source_count-1));
  xc_map_target=floor(slider14);xc_map_count=0;xc_map_unmatched=0;xc_map_epoch=index_epoch;xc_map_costsum=0;
);
function xc_map_one(id) local(p q z k j n start count idx cost best cls list lo ci exists m i)
(
  p=h_m(id);z=xc_maps+id*12;memset(z,-1,12);i=0;loop(4,z[4+i]=100;i+=1;);
  p[0]==xc_map_source ? (
    // A deterministic bounded candidate set: complete for small corpora, class
    // representatives + evenly spread members for larger ones. No N^2 table.
    xc_pool_n=0;count=min(128,hm_n);j=0;
    loop(count,idx=min(hm_n-1,floor((j+0.5)*hm_n/max(1,count)));xc_pool[xc_pool_n]=idx;xc_pool_n+=1;j+=1;);
    ci=0;loop(hm_k,n=h_class_range(0,ci,xc_map_target);lo=h_range_lo;list=h_list(0);j=0;
      loop(min(2,n),idx=list[lo+min(n-1,floor((j+0.5)*n/max(1,min(2,n))))];
        i=0;exists=0;while(i<xc_pool_n && !exists)(xc_pool[i]==idx ? exists=1;i+=1;);
        !exists && xc_pool_n<224 ? (xc_pool[xc_pool_n]=idx;xc_pool_n+=1;);j+=1;
      );ci+=1;
    );
    j=0;loop(xc_pool_n,idx=xc_pool[j];q=h_m(idx);
      q[0]!=xc_map_source && (xc_map_target<=0 || q[0]==xc_map_target-1) && q[2]>0 ? (
        cost=xc_hmetric(0,p,q,1)+0.10*abs(p[60]-q[60])+0.08*abs(p[63]-q[63]);
        xc_best_insert(z,idx,cost);xc_precompute_comparisons+=1;
      );j+=1;
    );
    z[8]=z[0]>=0 ? z[4] : 1;z[9]=z[0]>=0 && z[4]<(0.42-0.30*xc_params[7]);
    xc_map_count+=1;z[9]<=0 ? xc_map_unmatched+=1;xc_map_costsum+=z[8];z[10]=index_epoch;
  );
);
function xc_post_step() local(i) (
  xc_post_phase==1 ? (
    i=0;while(i<16 && xc_post_cursor<hm_n)(xc_grammar_one(0,xc_post_cursor);xc_post_cursor+=1;i+=1;);
    xc_post_cursor>=hm_n ? (xc_post_phase=2;xc_post_cursor=0;);
  ) : xc_post_phase==2 ? (
    i=0;while(i<16 && xc_post_cursor<hx_n)(xc_grammar_one(1,xc_post_cursor);xc_post_cursor+=1;i+=1;);
    xc_post_cursor>=hx_n ? (xc_post_phase=0;xc_grammar_ready=1;xc_map_begin(););
  );
  xc_map_phase==1 ? (
    i=0;while(i<2 && xc_map_cursor<hm_n)(xc_map_one(xc_map_cursor);xc_map_cursor+=1;i+=1;);
    xc_map_cursor>=hm_n ? (xc_map_phase=0;xc_map_ready=1;);
  );
);
function xc_map_pick(guide q freedom) local(z i id cost value sum chosen best accepted) (
  chosen=-1;
  xc_map_ready && xc_map_epoch==index_epoch && guide>=0 && guide<hm_n ? (
    z=xc_maps+guide*12;sum=0;best=-1;i=0;
    loop(4,id=z[i];id>=0 && id<hm_n ? (
      xc_map_check=h_m(id);
      xc_map_check[0]!=xc_runtime_guide && (slider14<=0 || xc_map_check[0]==floor(slider14)-1) && fc_member_allowed(xc_map_check[6],id) ? (
        cost=z[4+i];value=exp(-(cost-z[4])/max(0.01,0.02+freedom*0.15));sum+=value;
        h_rnd(q)*sum<value ? chosen=id;best<0 ? best=id;
      );
    );i+=1;);freedom<=0.0001 ? chosen=best;
    xc_last_map_cost=z[8];xc_last_map_supported=z[9];
    z[9]<=0 ? xc_mapping_misses+=1;
  );chosen;
);


function h_choose_realization(guide src q freedom) local(p cls sum i id wt member best bestd d) (
  xc_runtime_transfer ? (
    member=xc_map_pick(guide,q,freedom);
    member<0 ? (p=h_m(guide);best=-1;bestd=100;i=0;loop(hm_k,h_allowed(0,i,0) && fc_class_available(0,i,src) ? (d=h_dist(0,p,h_cl(0,i));d<bestd ? (bestd=d;best=i;););i+=1;);member=best>=0 ? h_pick_member(0,best,src,q,freedom,-1) : -1;xc_mapping_misses+=1;);
    member<0 ? member=guide;member;
