function tr_history_clear() (traj_runtime_base[0]=1;traj_runtime_base[1]=0;traj_runtime_base[2]=0;traj_runtime_base[3]=0;traj_runtime_base[4]=0;traj_runtime_base[5]=-1;traj_runtime_base[6]=-1;memset(traj_history_base,0,832););
