  cp_fingerprint_add(out[2]);cp_fingerprint_add(out[3]);
  auto_window_min=min(auto_window_min,out[3]/out[4]);auto_window_max=max(auto_window_max,out[3]/out[4]);max_grain_seconds=max(max_grain_seconds,out[3]/out[4]);
);
function cp_merge_begin() (
  merge_source=0;merge_active=0;merge_write=0;merge_done=0;auto_window_min=1000000000;auto_window_max=0;auto_quiet_n=0;silent_grains=0;max_grain_seconds=0;memset(hist,0,1024);
);
function cp_merge_step(work) local(groups s a first target seconds id boundary minsec groupend stop rem k) (
  groups=max(1,floor(work/64));
  while(groups>0 && merge_source<source_count)(
    s=cp_s(merge_source);a=cp_auto(merge_source);
    !merge_active ? (merge_orig_start=s[5];merge_orig_end=s[5]+s[6];merge_read=merge_orig_start;merge_new_start=merge_write;merge_new_count=0;merge_active=1;);
    merge_read>=merge_orig_end ? (
      s[5]=merge_new_start;s[6]=max(1,merge_new_count);a[4]=s[2]/s[3]/max(1,s[6]);merge_active=0;merge_source+=1;
    ) : (
      first=merge_read;groupend=first+1;
      window_setting<=0 ? (
        target=cp_micro_target(first,merge_orig_start,merge_orig_end);seconds=cp_g(first)[3]/cp_g(first)[4];minsec=0.09;stop=0;
        while(groupend<merge_orig_end && seconds<0.68 && !stop)(
          boundary=cp_sensor_change(groupend-1,groupend);
          seconds>=minsec && (seconds>=target || boundary>=0.62) ? stop=1 : (seconds+=cp_g(groupend)[3]/cp_g(groupend)[4];groupend+=1;);
        );
        while(groupend<merge_orig_end && seconds<minsec)(seconds+=cp_g(groupend)[3]/cp_g(groupend)[4];groupend+=1;);
        // Never strand a tiny Auto tail as its own Micro unit. If the complete
        // remaining source tail is shorter than the 90 ms normal floor, absorb it
        // into this group. A whole source shorter than the floor remains one unit.
        groupend<merge_orig_end ? (
          rem=0;k=groupend;while(k<merge_orig_end && rem<minsec)(rem+=cp_g(k)[3]/cp_g(k)[4];k+=1;);
          k>=merge_orig_end && rem<minsec ? groupend=merge_orig_end;
        );
      );
      cp_merge_group(merge_source,first,groupend,merge_write);merge_read=groupend;merge_write+=1;merge_new_count+=1;groups-=1;
    );
  );
  merge_source>=source_count && !merge_done ? (grain_count=merge_write;tile_total=grain_count;effective_window=total_seconds/max(1,grain_count);merge_done=1;build_phase=8;);
);
function cp_quantiles() local(d j sum lo hi ql qh span center) (
  d=0;loop(8,
    sum=0;lo=0;hi=127;ql=0;qh=0;j=0;
    loop(128,sum+=hist[d*128+j];
      !ql && sum>=max(1,max(0,grain_count-auto_quiet_n)*0.05) ? (lo=j;ql=1;);
      !qh && sum>=max(1,max(0,grain_count-auto_quiet_n)*0.95) ? (hi=j;qh=1;);j+=1;
    );
