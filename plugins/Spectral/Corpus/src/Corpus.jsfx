// ACKed FIFO prevents path knots/actions being overwritten between audio blocks.
function ui_enqueue(op arg) local(pos prev) (
  pos=(ui_qwrite+127)%128;
  op==1 && ui_qn>0 && ui_queue[pos*2]==1 ? ui_queue[pos*2+1]=arg : (
    ui_qn<128 ? (
      ui_queue[ui_qwrite*2]=op;ui_queue[ui_qwrite*2+1]=arg;ui_qwrite=(ui_qwrite+1)%128;ui_qn+=1;
    ) : ui_qoverflow+=1;
  );
);
function ui_traj_meta(lane code) (ui_enqueue(14,16384+cp_clamp(floor(lane),0,11)*512+cp_clamp(floor(code),0,511)););
function ui_amp_meta(code) (ui_enqueue(14,24576+cp_clamp(floor(code),0,511)););
function ui_flush() local(op arg serial packet) (
  ui_wait && ui_snapshot_base[0]==ui_sent ? ui_wait=0;
  !ui_wait && ui_qn>0 ? (
    op=ui_queue[ui_qread*2];arg=ui_queue[ui_qread*2+1];ui_qread=(ui_qread+1)%128;ui_qn-=1;
    serial=(floor(slider24/1048576)+1)%16;
    packet=serial*1048576+cp_clamp(floor(arg),0,65535)*16+op;
    ui_sent=packet;ui_wait=1;ui_notify(24,packet,0);
  );
);
function ui_button(x y w h label active) local(hot) (
  hot=ui_hit(x,y,w,h);
  ui_box(x,y,w,h,active ? 0.12 : (hot ? 0.16 : 0.085),active ? 0.29 : (hot ? 0.21 : 0.115),active ? 0.28 : (hot ? 0.26 : 0.15));
  ui_border(x,y,w,h,active ? 0.30 : 0.20,active ? 0.72 : 0.27,active ? 0.64 : 0.34);
  ui_text(x+8,y+7,w-14,15,label,0.9,0.94,0.96);hot && ui_lpress;
);
function ui_pane_begin(pid px py pw ph cw ch) local(s maxx maxy hot) (
  ui_pid=pid;ui_px=px;ui_py=py;ui_pw=max(24,pw);ui_ph=max(24,ph);
  ui_cw=max(cw,ui_pw-14);ui_ch=ch;ui_vh=ui_ph-12;
  s=ui_scroll+pid*4;maxx=max(0,ui_cw-ui_pw+14);maxy=max(0,ch-ui_vh);
  hot=!ui_input_blocked && mouse_x>=px && mouse_x<px+ui_pw && mouse_y>=py && mouse_y<py+ui_ph;
  hot && ui_wheel!=0 && !(mouse_cap&16) ? (
    (mouse_cap&8) ? s[0]-=ui_wheel/120*48 : s[1]-=ui_wheel/120*48;ui_wheel=0;
  );
  hot && ui_lpress && mouse_x>=px+ui_pw-12 ? ui_scroll_drag=pid*2+1;
  hot && ui_lpress && mouse_y>=py+ui_ph-12 ? ui_scroll_drag=pid*2+2;
  ui_down && ui_scroll_drag==pid*2+1 ? s[1]=maxy*cp_01((mouse_y-py-12)/max(1,ui_ph-36));
  ui_down && ui_scroll_drag==pid*2+2 ? s[0]=maxx*cp_01((mouse_x-px-12)/max(1,ui_pw-36));
  s[0]=cp_clamp(s[0],0,maxx);s[1]=cp_clamp(s[1],0,maxy);
  ui_ox=-s[0];ui_oy=-s[1];ui_mx=mouse_x-px+s[0];ui_my=mouse_y-py+s[1];
  ui_mouse_in=hot && mouse_x<px+ui_pw-12 && mouse_y<py+ui_ph-12 && ui_scroll_drag==0;
  s[2]!=ceil(ui_pw) || s[3]!=ceil(ui_ph) ? (
    gfx_setimgdim(100+pid,ceil(ui_pw),ceil(ui_ph));s[2]=ceil(ui_pw);s[3]=ceil(ui_ph);
  );gfx_dest=100+pid;gfx_mode=0;
  ui_color(0.060,0.078,0.102,1);gfx_rect(0,0,ui_pw,ui_ph,1);
);
function ui_pane_end() local(s maxx maxy thumb off) (
  s=ui_scroll+ui_pid*4;maxx=max(0,ui_cw-ui_pw+14);maxy=max(0,ui_ch-ui_vh);
  gfx_dest=-1;gfx_mode=0;gfx_a=1;
  gfx_blit(100+ui_pid,1,0,0,0,ui_pw-12,ui_ph-12,ui_px,ui_py,ui_pw-12,ui_ph-12);
  ui_color(0.11,0.14,0.18,1);gfx_rect(ui_px+ui_pw-11,ui_py,10,ui_ph,1);gfx_rect(ui_px,ui_py+ui_ph-11,ui_pw,10,1);
  ui_color(0.31,0.45,0.51,1);
  thumb=max(18,(ui_ph-14)*min(1,ui_vh/max(1,ui_ch)));off=maxy>0 ? (ui_ph-thumb-14)*s[1]/maxy : 0;
  gfx_rect(ui_px+ui_pw-9,ui_py+off+2,6,thumb,1);
  thumb=max(18,(ui_pw-14)*min(1,(ui_pw-14)/max(1,ui_cw)));off=maxx>0 ? (ui_pw-thumb-14)*s[0]/maxx : 0;
  gfx_rect(ui_px+off+2,ui_py+ui_ph-9,thumb,6,1);
);
function ui_slider_tip(id) (
 strcpy(#ui_tip_body,"Internal state; not a performance control.");
 id==1 ? strcpy(#ui_tip_body,"Select source fragments with a different relative energy. This is retrieval, not a volume knob. Velocity can offset this target.");
 id==2 ? strcpy(#ui_tip_body,"Texture variation: widen the probability of alternate valid grains. Zero picks the best scored candidate; it does not mute audio.");
 id==3 ? strcpy(#ui_tip_body,"Prefer similar identity and quieter seams. This is a soft selection cost, not a guarantee that every splice is inaudible.");
 id==4 ? strcpy(#ui_tip_body,"Increase fine-detail bias and the density of a debris child. Does not create missing material.");
 id==5 ? strcpy(#ui_tip_body,"Zero enables v1.4 Auto Micro: short 40-100 ms sensor probes discover local changes, then adjacent probes merge into variable-duration acoustic units (normally about 90-610 ms before source/budget limits). A positive value requests fixed manual indexing.");
 id==6 ? strcpy(#ui_tip_body,"Maximum Micro index size. Large recordings remain covered end to end, but their effective windows grow when this budget is reached.");
 id==7 ? strcpy(#ui_tip_body,"Final output trim for generated and auditioned audio. Default is 0 dB. Source matching and envelopes act before this control.");
 id==8 ? strcpy(#ui_tip_body,"Transpose generated fragments. Tape changes speed and duration. Coherent preserves movement and more of the original noisy texture: its low/mid body follows pitch, with progressively less shift in the upper spectrum. Existing grains keep their starting pitch. Source auditions remain original.");
 id==9 ? strcpy(#ui_tip_body,"How much note velocity shifts the Force target. Velocity also affects generated event gain.");
 id==10 ? strcpy(#ui_tip_body,"One-shot fits the declared duration; Gated holds until Note Off/pedal; Natural uses learned internal closures with an explicit time cap. Sample Hub duration packets override all three.");
 id==11 ? strcpy(#ui_tip_body,"Seed for reproducible selection. Fixed mode restarts from it on each event. New seed changes subsequent selections.");
 id==12 ? strcpy(#ui_tip_body,"Evolve uses ongoing variation; Fixed repeats event-local choices when controls, corpus and hierarchy are unchanged.");
 id==13 ? strcpy(#ui_tip_body,"Optional host-pool RAM budget in MB. Zero uses resident mode. Limits are handled by the existing Sample-compatible loader.");
 id==14 ? strcpy(#ui_tip_body,"Restrict generated candidates and Evidence to one validated source. Zero includes all sources. Chronology source is a separate view/guide choice.");
 id==15 ? strcpy(#ui_tip_body,"Pin a source grain as the initial identity. Zero clears the pin. It is not an instruction to replay that grain forever.");
 id==16 ? strcpy(#ui_tip_body,"Evidence descriptor/bin filter only. It does not constrain synthesis. Filtering is separate from auditioning a descriptor member.");
 id==17 ? strcpy(#ui_tip_body,"Evidence fuzzy-role filter. Roles overlap; a grain is not owned exclusively by Attack, Body, Detail or Tail.");
 id==18 ? strcpy(#ui_tip_body,"Page through source grains in the current Evidence filter. Clicking a grain auditions its full region.");
 id==19 ? strcpy(#ui_tip_body,"Scroll back through recorded generation decisions. These are actual emitted fragments, not a prediction.");
 id==20 ? strcpy(#ui_tip_body,"Linked stereo sample-peak ceiling at 0.98. It is not a true-peak limiter. Turn off only when you will manage output headroom externally.");
 id==21 ? strcpy(#ui_tip_body,"How many PCM frames are sampled in each analysis burst. Detailed costs more loading work, not per-sample rendering work.");
 id==22 ? strcpy(#ui_tip_body,"Auto estimates a per-source low-salience threshold. Low-salience material stays playable but is normally de-prioritized; it never creates Micro/Meso REST. Manual uses the floor control.");
 id==23 ? strcpy(#ui_tip_body,"Match active applies one capped gain per source to both audition and generation, preserving within-source dynamics. Raw uses the recordings original levels. Boost is capped at +24 dB.");
 id==25 ? strcpy(#ui_tip_body,"Total one-shot window including release. Incoming supported duration packets override this. It is not the duration of an individual grain.");
 id==26 ? strcpy(#ui_tip_body,"Event attack in milliseconds. Controls amplitude and transient selection pressure. Short declared windows proportionally fit A/D/R.");
 id==27 ? strcpy(#ui_tip_body,"Time from peak to Sustain level. Also relaxes onset selection pressure toward ongoing material.");
 id==28 ? strcpy(#ui_tip_body,"Held amplitude level, not identity stability. Zero intentionally makes the sustain portion silent.");
 id==29 ? strcpy(#ui_tip_body,"Release after Note Off, or inside a known one-shot window. This is the envelope owner; learned structure cannot overrun it.");
 id==30 ? strcpy(#ui_tip_body,"Higher flow overlaps consecutive fragments more. Only high-confidence Macro structural REST may deliberately interrupt active coverage.");
 id==31 ? strcpy(#ui_tip_body,"Bias retrieval toward brighter or darker source material. The neutral midpoint adds no mutation.");
 id==32 ? strcpy(#ui_tip_body,"Bias low-frequency weight of selected material. This is an acoustic proxy, not a physical mass estimate.");
 id==33 ? strcpy(#ui_tip_body,"Bias motion and crest features toward rougher or smoother fragments. Neutral is the midpoint.");
 id==34 ? strcpy(#ui_tip_body,"Penalize recently used grains and closely related texture. High settings trade target accuracy for less immediate repetition.");
 id==35 ? strcpy(#ui_tip_body,"Keep an evolving event near its established identity. Separate from amplitude Sustain and explicit descriptor locks.");
 id==36 ? strcpy(#ui_tip_body,"Legacy Morphology compatibility slot. New work should use Explore / Children and Child Action; touching the new child count clears this fallback.");
 id==37 ? strcpy(#ui_tip_body,"Level of added child walkers. Primary gain is independent. More branches can increase peak-catch activity.");
 id==38 ? strcpy(#ui_tip_body,"How strongly each independent child walk inherits the parent perceptual identity. This does not copy the parent Micro cursor or grain sequence.");
 id==39 ? strcpy(#ui_tip_body,"Authority of the committed drawn path on its two axes. At 100 percent it sets those targets; corpus coverage, source scope and explicit locks still limit realizability.");
 id==40 ? strcpy(#ui_tip_body,"Horizontal descriptor axis. A committed path retains the axes it was drawn on. Changing the view does not reinterpret the saved path.");
 id==41 ? strcpy(#ui_tip_body,"Vertical descriptor axis. A committed path retains its original axes. The path is visible when this view matches them.");
 id==42 ? strcpy(#ui_tip_body,"Horizontal focus target in the current map axes. Ctrl-drag moves the focus and auditions nearby source grains.");
 id==43 ? strcpy(#ui_tip_body,"Vertical focus target in the current map axes. Focus is a source-selection bias, not a panner.");
 id==44 ? strcpy(#ui_tip_body,"How much the map focus changes retrieval targets. A committed drawn path takes precedence on its axes.");
 id==45 ? strcpy(#ui_tip_body,"Post-selection transient softening. This is a real host-backed parameter: copy/paste, presets, Last Touched and automation use slider45 directly. Zero is exact bypass.");
 id==46 ? strcpy(#ui_tip_body,"How strongly ADSR phase biases acoustic targets and fuzzy roles. Amplitude ADSR continues to work at zero.");
 id==47 ? strcpy(#ui_tip_body,"Nominal progress time for open Gated/Natural descriptor trajectories and the legacy two-axis path cycle. Multi-lane trajectories advance 0->100% then hold at the endpoint; fixed one-shots use their exact duration.");
 id==48 ? strcpy(#ui_tip_body,"Minimum fuzzy role eligibility displayed in the Evidence role filter. Not a classifier confidence or generation threshold.");
 id==49 ? strcpy(#ui_tip_body,"Decode the existing Sample Hub CC118/119 duration packets. Play, Retrigger, Continue, Choke and End are supported; other actions are rejected visibly.");
 id==50 ? strcpy(#ui_tip_body,"Descriptor-lock bitmask. Locks hold chosen identity dimensions near the pinned or established baseline, including against a drawn path.");
 id==51 ? strcpy(#ui_tip_body,"Strength of enabled descriptor locks. Full strength can override path and macro requests on those dimensions; Inspector reports the conflict.");
 id==52 ? strcpy(#ui_tip_body,"Maximum generated playback excerpt duration. Auto Micro analysis is separate and variable-duration; stable coherent material may now use much longer playback spans up to this ceiling.");
 id==53 ? strcpy(#ui_tip_body,"Distribute child walkers across the stereo field while the primary remains centered. At 100 percent the outer children approach full left/right; each child still owns an independent Micro walk.");
 id==54 ? strcpy(#ui_tip_body,"Navigate auditions points. Draw records a local visible gesture and commits all knots together on mouse-up. It guides subsequent grain selections.");
 id==55 ? strcpy(#ui_tip_body,"Structure is the main workspace. Explore shows the feature map; Controls shapes generation; Inspector opens details only on request.");
 id==56 ? strcpy(#ui_tip_body,"Auto chooses supported Macro/Meso/Micro behavior. Transfer uses the chronology source as guide and excludes it from output; Source scope selects target material. Rich analysis builds upfront in every mode.");
 id==57 ? strcpy(#ui_tip_body,"Influence of the chosen Meso member contour on Micro targets. Drawn paths override only their selected axes, not explicit identity locks.");
 id==58 ? strcpy(#ui_tip_body,"Choose alternate Meso classes/member contours while preserving compatible behaviour. Separate from individual-grain texture variation.");
 id==59 ? strcpy(#ui_tip_body,"Variation in Macro class/member arrangements. Meaningful only when Macro evidence supports that layer.");
 id==242 ? strcpy(#ui_tip_body,"Auto preserves existing inference and playback behavior. Aggressive favors shorter units and exact grain playback. Coherent preserves longer acoustic units with no fixed length by default. Requires Micro Auto; analysis rebuilds when current events finish. Event duration, stops and source bounds still apply.");
 id==243 ? strcpy(#ui_tip_body,"Coherent sensitivity: higher permits more cuts at sustained pauses and persistent acoustic changes. Brief syllabic/transient changes do not force a split. This is acoustic inference, not sentence recognition. Right-click restores 50 percent.");
 id==245 ? strcpy(#ui_tip_body,"Avoid gaps uses cached recording-relative level and quiet coverage to avoid near-silent passages when audible alternatives exist. Quiet-only scopes still work. An explicit very-low Energy target can override this policy. Allow restores original selection. No gate or gain boost is applied to the audio.");
 id==244 ? strcpy(#ui_tip_body,"Optional passage limit in source milliseconds. Drag and Alt-wheel use a logarithmic scale for fine short-duration control. Zero removes the fixed duration ceiling; natural boundaries or the source end determine each passage. Positive limits have internal sensor-grid precision. Event duration remains independent. Right-click restores no fixed limit.");
 id==60 ? strcpy(#ui_tip_body,"Sensitivity to behavioural changes during segmentation. Higher can create more boundaries. Analysis rebuilds automatically when safe.");
 id==61 ? strcpy(#ui_tip_body,"Manual low-salience floor in dBFS, used only when detection is Manual. This affects retrieval bias and Macro rest evidence, not Micro/Meso muting.");
 id==62 ? strcpy(#ui_tip_body,"Scale learned episode durations. Explicit MIDI durations and Note Off still own the final event deadline.");
 id==63 ? strcpy(#ui_tip_body,"Class detail during clustering. Higher allows finer acoustic distinctions, subject to support and fixed class capacity. Rebuild is automatic.");
 id==64 ? strcpy(#ui_tip_body,"Source displayed in chronology and used as the reconstruction guide. This does not restrict the output corpus; Source scope does that.");
 id==65 ? strcpy(#ui_tip_body,"Original keeps the former role-based grain fades. Rounded gives broad, balanced fades; Soft rise brings each fragment in more gradually. Applies to future generated grains; source auditions stay original. Original + Overlap Off restores the old renderer.");
 id==66 ? strcpy(#ui_tip_body,"Broaden each grain's fades from their original timing toward a full rounded window. Higher values automatically receive closer grain spacing. Zero preserves original fades. Changes affect future grains, with no reanalysis.");
 id==67 ? strcpy(#ui_tip_body,"Optional grain balance: lower reaches the peak earlier, higher gives a slower rise. Center is balanced for Rounded and a slow rise for Soft rise. Right-click returns to 50 percent.");
 id==68 ? strcpy(#ui_tip_body,"Energy controls overlap loudness for noise-like textures. Amplitude is more conservative for correlated repeats. Off uses the original sum. Each walker is independent; compensation is smoothly bounded, preserves solo fades and event ADSR, and is captured by REPEAT.");
 id==69 ? strcpy(#ui_tip_body,"Original keeps each recording's channels. Mono averages left/right before grain panning, with a short glide and no file conversion. All sources and auditions follow this setting. Analysis rebuilds when existing events finish; child spread can still make a stereo cloud. Right-click restores Original.");
 id>=70 && id<=72 ? strcpy(#ui_tip_body,"Curve of this ADSR stage: Fast moves quickly toward its destination then eases in; Slow starts gently and moves later. Center is the original Linear ramp. Drag to adjust; Shift gives finer movement. Right-click resets to Linear. New notes capture the setting; REPEAT keeps its recorded curves.");
 id==73 ? strcpy(#ui_tip_body,"Tape uses speed-linked pitch. Coherent uses prepared stereo spectral engines at the excerpt's original timing. Tonal bodies get a wider conventional pitch range; rough/noisy grains and attacks preserve more upper texture. Source lookahead compensates spectral latency. Zero pitch is exact bypass. Changes affect new grains; REPEAT preserves the recorded character. Right-click restores Tape.");
 id==74 ? strcpy(#ui_tip_body,"Tame each generated grain before mixing. Cached excerpt RMS/peak measurements attenuate unusually loud fragments; a gentle stereo-linked soft peak guard catches missed spikes. Quiet grains are never boosted. Zero is exact bypass; full strength is the default. Changes affect new grains; REPEAT keeps its recorded gain and guard. Auditions stay original.");
 id==75 ? strcpy(#ui_tip_body,"Incoming duration CCs: Relative scales inherited ADSR proportions from the One-shot window to the requested duration; Absolute keeps millisecond times. Hub Attack/Release percentages override either mode. Fit includes Release inside the deadline; Free/Tail place it after. Continue retains the original timing choice. Ordinary notes are unchanged; custom curves already follow event duration.");
 id==76 ? strcpy(#ui_tip_body,"Number of independent companions, 0-12. Saved and automatable. New notes capture the plan; current notes keep their cloud. Explicit zero disables legacy Morphology too.");
 id==77 ? strcpy(#ui_tip_body,"Companion grain-selection character. All modes use independent Micro walks and the same event envelope. The visible cards explain each mode; Mixed cycles a fixed roster.");
 id==78 ? strcpy(#ui_tip_body,"Companion grain density. Higher values shorten the hops for more overlap. Body bed receives extra overlap. Saved, automatable and captured by new notes.");
 id==79 ? strcpy(#ui_tip_body,"Variation in companion start and hop timing. Zero is orderly; high values spread timing while keeping the same grain playback speed. Captured per event; Fixed seed stays reproducible.");
 id==80 ? strcpy(#ui_tip_body,"Grain: long windowed micro-grains create increasingly dense phase smearing, with identical processing in both channels. Classic: the previous short all-pass transient softener. Fresh instances use Grain; older projects retain Classic until changed.");
 id==249 ? strcpy(#ui_tip_body,"Automatically lowers quiet background and tails inside child grains before they combine. The primary stays untouched. Corpus handles threshold and timing; 0 is exact bypass. New child grains capture this amount and REPEAT preserves it. Higher values reduce more quiet texture.");
 id==81 ? strcpy(#ui_tip_body,"Overall trajectory pull. Zero removes trajectory scoring AND trajectory candidate injection. 100% uses normal lane strengths; higher values emphasize the request. Existing source scope and explicit locks still apply.");
 id==82 ? strcpy(#ui_tip_body,"Event fits a known one-shot or incoming duration. Held notes repeat over Seconds until Note Off. Once runs one timed pass then holds. Repeat wraps. Bounce runs forward and back. Each new note starts its own clock.");
 id==83 ? strcpy(#ui_tip_body,"Seconds for one pass in Once, Repeat and Bounce, and for a held Event-clock note. Known Event durations fit automatically. Bounce needs two passes for a complete return.");
 id==84 ? strcpy(#ui_tip_body,"Normalized starting position in the trajectory clock. Applies to future selections; changing it can jump the target while audio already sounding keeps its own grain window.");
 id>=87 && id<=230 && (id-87)%13==0 ? strcpy(#ui_tip_body,"Absolute strength of this lane. Zero bypasses this lane even when it is the only one. Changes apply to future choices; existing sounding grains and recorded REPEAT plans keep their decisions.");
 ui_tip(#ui_tip_body);
);
function ui_control(id x y w label lo hi def fmt) local(value hot n dx nv step) (
  value=slider(id);id==244 ? value*=1000;hot=ui_hit(x,y,w,70);
  n=fmt==3 ? log(1+max(0,value-lo))/log(1+hi-lo) : (value-lo)/max(0.00001,hi-lo);
  ui_box(x,y,w,70,0.078,0.10,0.132);ui_text(x+10,y+5,w-16,14,label,0.64,0.73,0.81);
  fmt==0 ? sprintf(#ui_val,"%.0f %%",value*100) : (
    fmt==1 ? sprintf(#ui_val,"%+.1f dB",value) : (
      fmt==2 ? sprintf(#ui_val,"%+.1f st",value) : (fmt==3 ? sprintf(#ui_val,"%.1f ms",value) : sprintf(#ui_val,"%.2f",value));
    );
  );
  fmt==5 ? (abs(value)<0.0005 ? strcpy(#ui_val,"LINEAR") : sprintf(#ui_val,"%s %.0f %%",value<0 ? "FAST" : "SLOW",abs(value)*100););
  id==5 && value<=0 ? strcpy(#ui_val,"AUTO");id==249 && value<=0 ? strcpy(#ui_val,"OFF");
  id==244 && value<=0 ? strcpy(#ui_val,"NO FIXED LIMIT");
  ui_text(x+10,y+25,w-16,21,#ui_val,0.90,0.95,0.96);
  ui_box(x+10,y+59,w-20,3,0.14,0.20,0.25);ui_box(x+10,y+59,(w-20)*cp_01(n),3,0.31,0.73,0.65);
  hot && ui_lpress ? (ui_drag=id;ui_drag_x=mouse_x;ui_drag_y=mouse_y;ui_drag_n=n;);
  ui_down && ui_drag==id ? (
    dx=(mouse_x-ui_drag_x)-(mouse_y-ui_drag_y);nv=cp_01(ui_drag_n+dx/240*((mouse_cap&8) ? 0.12 : 1));
    nv=fmt==3 ? lo+exp(nv*log(1+hi-lo))-1 : lo+nv*(hi-lo);id==244 ? nv=floor(nv+0.5);
    ui_notify(id,cp_clamp(nv,lo,hi)/(id==244 ? 1000 : 1),1);
  );
  hot && ui_rpress ? (ui_notify(id,def,1);id>=81 ? ui_end_gesture(id););
  hot && ui_wheel!=0 && (mouse_cap&16) ? (
    id==244 ? (step=(mouse_cap&8) ? 0.002 : 0.015;nv=cp_01(n+ui_wheel/120*step);nv=floor(exp(nv*log(1+hi))-1+0.5);ui_notify(id,nv/1000,1);) : (step=(hi-lo)*((mouse_cap&8) ? 0.001 : 0.01);ui_notify(id,cp_clamp(value+ui_wheel/120*step,lo,hi),1););id>=81 ? ui_end_gesture(id);ui_wheel=0;
  );
  hot ? ui_slider_tip(id);
);
function ui_choice_default(id) local(v) (
  v=floor(slider(id));
  id==242 ? v=1;id==56 ? v=5; id==10 ? v=0; id==17 ? v=0; id==23 ? v=1; id==22 ? v=1;
  id==6 ? v=1; id==21 ? v=1; id==12 ? v=0; id==20 ? v=1; id==49 ? v=1;id==65 || id==68 ? v=1;id==69 ? v=0;id==73 || id==245 ? v=1;id==75 || id==80 ? v=1;id==82 ? v=0;v;
);
function ui_choice(id x y w label options) local(n i c selected hot) (
  selected=ui_axis_value(id);i=0;n=0;strcpy(#ui_choice_value,"");
  loop(strlen(options),c=str_getchar(options,i);c==124 ? n+=1 : (n==selected ? sprintf(#ui_choice_value,"%s%c",#ui_choice_value,c););i+=1;);
  sprintf(#ui_choice_label,"%s: %s",label,#ui_choice_value);
  hot=ui_hit(x,y,w,34);
  ui_button(x,y,w,34,#ui_choice_label,0) ? (
    gfx_x=mouse_x;gfx_y=mouse_y;n=gfx_showmenu(options);n>0 ? (ui_notify(id,n-1,1);id>=81 ? ui_end_gesture(id););
  );
  hot && ui_rpress ? (ui_notify(id,ui_choice_default(id),1);id>=81 ? ui_end_gesture(id););
  hot ? ui_slider_tip(id);
);
function ui_length_ms(u) local(lo hi) (lo=max(0.000001,ui_snapshot_base[125]);hi=max(lo,ui_snapshot_base[126]);lo*exp(cp_01(u)*log(hi/lo))*1000;);
function ui_axis_value(id) (id==40 ? cp_axis(0) : (id==41 ? cp_axis(1) : floor(slider(id))););
function ui_set_axis(id d) (
  id==40 || id==41 ? (ui_notify(id==40 ? 246 : 247,d==53,1);d<53 ? ui_notify(id,d,1);) : ui_notify(id,d,1);
