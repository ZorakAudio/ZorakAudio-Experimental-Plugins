function ui_help_view(w) local(x y bw) (
  x=14;y=12;bw=w-28;
  ui_heading(x,y,bw,"HELP","");ui_btn(x+bw-40,y,40,29,"X",0,"Close contextual help.") ? ui_help=0;y+=44;
  ui_page==4 ? strcpy(#ui_help_text,"Load recordings in slot 0. Corpus scouts each source, infers grain windows and low-salience thresholds, and builds Micro > Meso > Macro automatically. Auto selects a supported hierarchy for each new note. Low-salience Micro material stays playable; Meso models sparsity/density without muting. Only high-confidence Macro REST regions schedule silence. Gold-star unique classes stay in the normal population and can be filtered with UNIQUE. Generation pins are explicit; clicking to audition never silently pins a class.") : (
    ui_page==0 ? strcpy(#ui_help_text,"Explore plots actual grains on two acoustic descriptors. Click-drag across points to hear overlapping source grains; Shift-click sets an identity anchor. Ctrl-drag moves a focus. Turn Draw on, drag a path, then release. The blue path commits atomically and guides subsequent choices. Amber is the actual primary walk. Use Path Axes to return to a saved paths coordinates. A held note traverses the full path forward and back; a one-shot fits it to the declared duration. Corpus cannot follow into material it does not contain. Explicit locks remain stronger than the path.") : (
      ui_page==2 ? strcpy(#ui_help_text,"Drag controls; Shift gives fine adjustment. Right-click restores that controls new default. Plain wheel scrolls the pane; Alt-wheel edits a hovered control. The existing performance sliders support Last Touched automation. Additional Coherence/Grammar settings are serialized controls, not new host automation slots. Output defaults to 0 dB. Match active uses one bounded source gain, preserving dynamics within that recording. Low-salience detection biases selection without deleting quiet material; only Macro REST schedules intentional silence. Rebuilds are automatic and wait for active model users to finish.") : strcpy(#ui_help_text,"Inspector opens only the evidence you request. Selected Grain shows exact source region and excludes or locks. Live Walk exposes real emitted slices and path error. Selected Class shows member distributions, comparisons and observed successors. Analysis explains inferred grain resolution and quiet thresholds. System contains actual failures, limits and protocol/replay states. A low distance is acoustic similarity, not proof of semantic equivalence.");
    );
  );y+=ui_wrap(x,y,bw,#ui_help_text,24)+28;
  ui_wrap(x,y,bw,"Evidence is a closed-by-default side drawer. Feature names and member counts remain fixed when you audition them. Right-click a feature to apply a browser filter. A feature audition changes the audition cursor, not the inspected grain. Clicked grains intentionally become selected. The underlying source audio is never deleted.",10);
  ui_help_h=y+240;
);
function ui_tooltip_draw() local(w h x y saved n) (
  // Render above backing images. No tooltip or help surface reads the DSP heap.
  strlen(#ui_tooltip)>0 && !ui_help ? (
    ui_hover_x!=mouse_x || ui_hover_y!=mouse_y ? (ui_hover_x=mouse_x;ui_hover_y=mouse_y;ui_hover_since=ui_now;);
    ui_now-ui_hover_since>0.45 && !ui_down ? (
      w=min(490,max(240,gfx_w-24));x=cp_clamp(mouse_x+16,8,max(8,gfx_w-w-8));
      h=min(156,max(80,ceil(strlen(#ui_tooltip)/max(12,floor((w-24)/7.5)))*21+28));
      y=mouse_y+22;y+h>gfx_h-26 ? y=max(8,mouse_y-h-12);
      ui_box(x,y,w,h,0.115,0.16,0.195);ui_border(x,y,w,h,0.32,0.55,0.57);ui_wrap(x+12,y+12,w-24,#ui_tooltip,max(2,floor((h-20)/21)));
    );
  );
);

