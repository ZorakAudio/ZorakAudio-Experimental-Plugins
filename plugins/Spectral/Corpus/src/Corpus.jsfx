function h_candidates(src) local(p q n i gid cls ep list lo count j base r) (
  h_active && h_current>=0 ? (
    p=h_m(h_current);q=h_q;
    // The class route augments feature-vertex postings. It is not an exclusive
    // gate: the normal feature search and fallback still get candidate slots.
    i=0;n=min(8,p[2]);r=h_rnd(q);
    loop(n,gid=p[1]+min(p[2]-1,floor((i+r)*p[2]/max(1,n)));h_add_candidate(gid,-2,src);i+=1;);
    cls=p[6];count=h_class_range(0,cls,src);lo=h_range_lo;i=0;n=min(8,count);r=h_rnd(q);
    loop(n,ep=hm_list[lo+min(count-1,floor((i+r)*count/max(1,n)))];p=h_m(ep);
      gid=p[1]+min(p[2]-1,floor(h_rnd(q)*p[2]));h_add_candidate(gid,-2,src);i+=1;
    );
