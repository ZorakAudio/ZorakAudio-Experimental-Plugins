  ) : (
    h_active && h_current>=0 ? (
      h_mp=h_m(h_current);h_t[1]=h_mp[6];h_gm=hm_grainmap[id];h_t[2]=h_gm>=0 ? hm_episodes[h_gm*96+6] : -1;
      h_t[3]=h_q[15];h_t[4]=h_current;h_t[5]=h_reference;h_t[6]=h_q[1];
    ) : h_t[6]=0;
  );
);
function cp_voice(id role t gain pitch ei kind srcpos frames pan serial) local(i found v g s rate dur e endtime shortx) (
  found=-1;i=0;while(i<64 && found<0)(voice_base[i*32]<=0 ? found=i;i+=1;);
  id>=0 && id<grain_count && found>=0 && voice_list_n<64 ? (
    g=cp_g(id);s=cp_s(g[1]);v=cp_v(found);memset(v,0,32);
