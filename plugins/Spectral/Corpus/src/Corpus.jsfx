  at_clock>=walk_clock ? (cp_walk_until(at_clock);walk_clock=at_clock;);
  block_midi_count<2048 ? (
    mstatus==144 && mvel>0 ? (
      block_note_count<32 ? (cp_start(mvel/127,mnote,mchan,at_clock,0,0,127,127,0);block_note_count+=1;) : dropped_triggers+=1;
    ) : (
      mstatus==128 || (mstatus==144 && mvel==0) ? cp_midi_noteoff(mnote,mchan,at_clock) : (
