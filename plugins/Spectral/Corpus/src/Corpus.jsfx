function cp_pick(w e t) local(d b v weight total src pass n lo hi j id k found sc value sum best bestsc pooln eligible cutoff bridge cursor seedpick)
(
  cp_target(w,e,t);pick_id=-1;pick_bridge=-1;pick_relax=0;pick_score=0;pick_checked=0;
  src=floor(slider14);candidate_n=0;pass=0;total=0;pg_available_n=-1;
  (pg_changed && !pg_bypass || pg_preview) && pg_ready ? (
    pg_search_pool=pg_preview ? pg_pool : pg_live_pool;pg_available_n=pg_preview ? pg_pool_n : pg_live_n;pg_search_lo=0;
    src>0 ? (lo=0;hi=pg_available_n;while(lo<hi)(k=floor((lo+hi)/2);cp_g(pg_search_pool[k])[1]<src-1 ? lo=k+1 : hi=k;);pg_search_lo=lo;hi=pg_available_n;while(lo<hi)(k=floor((lo+hi)/2);cp_g(pg_search_pool[k])[1]<=src-1 ? lo=k+1 : hi=k;);pg_available_n=lo-pg_search_lo;);
    j=0;n=min(16,pg_available_n);loop(n,id=pg_search_pool[pg_search_lo+min(pg_available_n-1,floor((j+0.5)*pg_available_n/max(1,n)))];h_add_candidate(id,-6,src);j+=1;);
  );
