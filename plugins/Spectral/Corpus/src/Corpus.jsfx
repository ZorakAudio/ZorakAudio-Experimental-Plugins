    // Active singleton Meso episodes are not Macro regimes. A single episode
    // may become Macro REST only after passing the strict Macro rest-evidence gate.
    m=h_m(h_xstart);
    n>=2 || (n==1 && h_macro_rest_seed(m)) ? (
      p=h_x(hx_n);p[0]=m[0];p[1]=h_xstart;p[2]=n;p[3]=m[3];p[4]=h_xseconds;p[5]=h_xflags;
      p[6]=-1;p[7]=-1;p[8]=-1;
      d=0;loop(48,p[16+d]/=max(0.000001,h_xseconds);d+=1;);
      p[112]/=max(0.000001,h_xseconds);p[113]=1-p[112];p[114]=cp_01(log(1+h_xseconds)/log(601));
      p[115]=1-exp(-max(0,n-1)/max(0.000001,h_xseconds)*0.25);
      p[118]=0;d=0;loop(48,val=p[16+d];val>0 ? p[118]-=val*log(val)/log(48);d+=1;);
      d=0;loop(8,p[120+d]/=max(0.000001,h_xseconds);d+=1;);
      // Structural REST exists ONLY at Macro scale, and only with converging
