  which==2 ? (tr_set_linear(0,0,0,0.20,0.92,0.90);tr_set_linear(1,4,1,0.78,0.05,1);tr_set_linear(2,5,1,0.82,0.12,0.95);tr_set_linear(3,20,2,0.30,0.88,0.90););
