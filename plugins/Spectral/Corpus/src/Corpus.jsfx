function xc_runtime_cost(id w) local(prev p q au matching join context adjacency future best i cost n expectedpos nextsource)
(
  xc_cost_join=0;xc_cost_match=0;xc_cost_context=0;xc_cost_prior=0;xc_cost_total=0;
  xc_run && xc_ok(id) ? (
    prev=w[5];p=xc_g(id);
    xc_ok(xc_reference) ? xc_cost_match=xc_distance(id,xc_reference,xc_params[5]);
    xc_ok(prev) ? (
      q=xc_g(prev);au=0.75;
      w[40]>=0 && w[42]>0 ? au=cp_01((w[41]+max(0,xc_when-w[40])*q[90]/max(8000,srate)*pow(2,slider8/12)-q[88])/max(1,q[89]));
      xc_cost_join=xc_join(prev,id,au,0,xc_params[5],xc_params[4]);
      // Reward a source-consistent continuation only when it also passes the
      // measured seam cost; adjacency is evidence, never a quality guarantee.
      q[95]==id && xc_cost_join<0.35 ? xc_cost_prior=0.18*xc_params[2]*(1-xc_cost_join/0.35);
      g_xc=cp_g(prev);g_yc=cp_g(id);
      g_xc[1]==g_yc[1] && w[42]>0 ? (
        expectedpos=w[41]+max(0,xc_when-w[40])*q[90]/max(8000,srate)*pow(2,slider8/12);
        abs(p[88]-expectedpos)<max(1,q[90]*0.050) ? xc_cost_prior=max(xc_cost_prior,0.20*xc_params[2]);
      );
    );
