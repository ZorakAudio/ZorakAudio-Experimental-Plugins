      old=recent_base[(recent_write-1-i+64)%64];
      old>=0 && old<grain_count && old!=id ? (
        dist=abs(cp_feat(id,1)-cp_feat(old,1))+abs(cp_feat(id,2)-cp_feat(old,2))+abs(cp_feat(id,3)-cp_feat(old,3));
        p=max(p,max(0,1-dist/0.30)*0.25*(1-i/8));
      );i+=1;
    );
  );
  // Local anti-lock works in Fixed mode too, but is deterministic per event.
  w[5]==id ? p=max(p,1);
  p;
);
// Child walkers share the structural target but should not collapse onto the
// same Micro realization. This is a SOFT sibling/primary repulsion: exact clones
// are strongly discouraged, near-identical local grains are mildly discouraged,
// but a tiny corpus can still fall back to the only valid evidence available.
function cp_child_diversity(id w) local(i base sib sid g p dist pen) (
  pen=0;
  w[4]>0 ? (
    base=floor(w[1])*walker_per_event;i=0;
    loop(walker_per_event,
      sib=cp_w(base+i);
      sib!=w && sib[0]>0 && sib[2]==w[2] ? (
        sid=floor(sib[5]);
        sid>=0 && sid<grain_count && cp_valid(sid) ? (
          id==sid ? pen=max(pen,1) : (
            g=cp_g(id);p=cp_g(sid);
            dist=abs(cp_feat(id,1)-cp_feat(sid,1))+abs(cp_feat(id,2)-cp_feat(sid,2))+abs(cp_feat(id,3)-cp_feat(sid,3))+0.5*abs(cp_feat(id,5)-cp_feat(sid,5));
            g[1]==p[1] && abs(id-sid)<=1 ? pen=max(pen,0.65);
            pen=max(pen,max(0,1-dist/0.22)*0.28);
          );
        );
      );i+=1;
    );
    // Before its first pick, also discourage replaying the exact parent grain
    // that existed at birth. It remains available if the corpus offers no choice.
    w[5]<0 && w[46]>=0 && id==floor(w[46]) ? pen=max(pen,1);
  );pen;
);
function cp_score(id w bridge) local(d g prev p cost ident seam hist same fit n delta rel axisx axisy dx dy conf lockv tnow tfuture) (
  g=cp_g(id);cost=0;ident=0;d=0;
  loop(8,
    delta=abs(cp_feat(id,d)-target_base[d]);
    cost+=delta*(d==1 || d==2 || d==3 ? 1 : 0.45);
    ident+=abs(cp_feat(id,d)-w[16+d])*(d==7 ? 0.30 : (d==0 || d==4 ? 0.02 : 0.12));d+=1;
  );
  // Registry locks above CORE are scored against the event's frozen descriptor baseline.
  xc_lock_state>0 && slider50>255 ? (d=8;while(d<51)(lockv=(floor(slider50/pow(2,d))%2)>0;lockv ? (conf=cp_desc_conf(id,d);cost+=0.55*slider51*conf*abs(cp_desc(id,d)-xc_lock_state[12+d]););d+=1;););
  fit=0;n=0;d=0;loop(4,fit+=g[41+d]*target_role[d];n+=target_role[d];d+=1;);fit/=max(0.001,n);
  prev=w[5];prev<0 && w[4]>0 && w[46]>=0 ? prev=floor(w[46]);seam=0;same=0;
  prev>=0 && prev<grain_count ? (p=cp_g(prev);seam=min(1,abs(cp_db(g[21])-cp_db(p[22]))/36);g[1]==p[1] ? same=1;);
  hist=cp_hist_penalty(id,w);
  score_target=cost/5.35;score_identity=ident;score_seam=seam;score_history=hist;score_role=fit;
  cost=1.65*score_target+slider3*(0.30*ident+0.15*seam+0.04*(1-same))+0.45*(1-fit)+slider34*0.62*hist;
  g[60]>0.5 ? cost+=0.42;
  w[4]>0 ? cost+=2.40*cp_child_diversity(id,w);
  bridge>=0 ? cost+=0.08*(1-cp_member(id,bridge));
  h_active ? cost+=0.35*h_effect*(1-h_fit(id));
  axisx=cp_clamp(floor(slider40),0,50);axisy=cp_clamp(floor(slider41),0,50);
  dx=abs(cp_desc(id,axisx)-map_target_x)*cp_desc_conf(id,axisx);dy=abs(cp_desc(id,axisy)-map_target_y)*cp_desc_conf(id,axisy);
  slider44>0 ? cost+=1.8*slider44*(dx+dy)*0.5;
  path_count>1 && slider39>0 ? (score_path=(dx+dy)*0.5;cost+=3.5*slider39*score_path;) : score_path=0;
  tnow=tr_penalty(id,traj_u);tr_active_eval>0 ? (tfuture=tr_future_penalty(id,traj_u,traj_du);cost+=2.75*tnow+0.85*tfuture;);
  cost+=xc_runtime_cost(id,w);1/(1+max(0,cost));
);
// Up to three shared feature posting lists + an explicit all-corpus safety route.
// No exclusive role lists; 64 bounded candidates, de-duplicated before scoring.
function cp_path_candidates(src) local(axis pass b bin k n i ix id g dist j at total use_rich base count) (
  path_candidates_n=0;
  path_count>1 && slider39>0 ? (
    memset(path_best,-1,32);total=0;pass=0;
    loop(2,axis=pass==0 ? cp_clamp(floor(slider40),0,50) : cp_clamp(floor(slider41),0,50);b=min(15,floor((pass==0 ? map_target_x : map_target_y)*16));bin=max(0,b-1);
      while(bin<=min(15,b+1))(
        use_rich=xc_ready; k=axis*16+bin;
        n=use_rich ? min(32,desc_res_counts[k]) : (axis<8 ? min(64,path_res_counts[axis*16+bin]) : 0);i=0;
        loop(min(16,n),ix=min(n-1,floor((i+0.5)*n/max(1,min(16,n))));id=use_rich ? desc_reservoir[k*32+ix] : path_reservoir[(axis*16+bin)*64+ix];
          cp_valid(id) ? (g=cp_g(id);src<=0 || g[1]==src-1 ? (
            dist=abs(cp_desc(id,cp_clamp(floor(slider40),0,50))-map_target_x)+abs(cp_desc(id,cp_clamp(floor(slider41),0,50))-map_target_y);
            at=0;while(at<total && path_best[at*2]!=id)(at+=1;);
            at==total ? (at=0;while(at<total && path_best[at*2+1]<=dist)(at+=1;);at<12 ? (j=min(11,total);while(j>at)(path_best[j*2]=path_best[(j-1)*2];path_best[j*2+1]=path_best[(j-1)*2+1];j-=1;);path_best[at*2]=id;path_best[at*2+1]=dist;total=min(12,total+1);););
          ););i+=1;
        );bin+=1;
      );pass+=1;
    );i=0;loop(total,h_add_candidate(path_best[i*2],-3,src);i+=1;);path_candidates_n=total;
  );
);
function cp_pick(w e t) local(d b v weight total src pass n lo hi j id k found sc value sum best bestsc pooln eligible cutoff bridge cursor seedpick)
(
  cp_target(w,e,t);pick_id=-1;pick_bridge=-1;pick_relax=0;pick_score=0;pick_checked=0;
  src=floor(slider14);candidate_n=0;pass=0;total=0;xc_candidates(w,src);cp_path_candidates(src);tr_candidates(src);
  h_active ? h_candidates(src);
  loop(24,bridge_weights[pass]=0;pass+=1;);pass=0;
  loop(3,
    total=0;d=0;seedpick=-1;
    loop(8,b=0;loop(3,
      v=cp_dim_vertex(d,b);cp_range(v,src)>0 ? (
        w[5]>=0 ? weight=cp_member(w[5],v) : weight=max(0,1-abs(2*target_base[d]-b));
        weight*=0.2+max(0,1-abs(2*target_base[d]-b));
        weight*=0.6+min(2,log(1+grain_count/max(1,vertex_counts[v])));
        used_bridge[v]>0 ? weight*=0.04;
        total+=weight;cp_rng()*total<weight ? seedpick=v;
      );b+=1;);d+=1;
    );
    seedpick>=0 ? (
      used_bridge[seedpick]=1;pooln=cp_range(seedpick,src);lo=range_lo;hi=range_hi;n=min(path_count>1 && slider39>0 ? (h_active ? 8 : 14) : (h_active ? 14 : 20),pooln);
      cursor=cp_rng();j=0;loop(n,
        id=postings[lo+min(pooln-1,floor((j+cursor)*pooln/max(1,n)))];
        cp_valid(id) ? (
          found=0;k=0;while(k<candidate_n && !found)(candidates[k*2]==id ? found=1;k+=1;);
          !found && candidate_n<64 ? (candidates[candidate_n*2]=id;candidates[candidate_n*2+1]=seedpick;candidate_n+=1;);
        );j+=1;
      );
    );pass+=1;
  );
  memset(used_bridge,0,28);
  // Four wider probes allow recovery from a sparse or locally homogeneous graph.
  pooln=cp_range(28,src);lo=range_lo;n=min(candidate_n>0 ? 4 : 64,pooln);cursor=cp_rng();j=0;
  loop(n,
    id=postings[lo+min(pooln-1,floor((j+cursor)*pooln/max(1,n)))];
    cp_valid(id) ? (
      found=0;k=0;while(k<candidate_n && !found)(candidates[k*2]==id ? found=1;k+=1;);
      !found && candidate_n<64 ? (candidates[candidate_n*2]=id;candidates[candidate_n*2+1]=-1;candidate_n+=1;);
    );j+=1;
  );
  // No guide PCM can leak into Transfer through a feature or fallback route.
  xc_runtime_transfer ? (
    j=0;k=0;while(j<candidate_n)(
      xc_allowed(candidates[j*2],src,1,xc_runtime_guide) ? (candidates[k*2]=candidates[j*2];candidates[k*2+1]=candidates[j*2+1];k+=1;);j+=1;
    );candidate_n=k;
    j=0;loop(min(16,source_count),k=src>0 ? src-1 : min(source_count-1,floor((j+0.5)*source_count/max(1,min(16,source_count))));
      k>=0 && k<source_count && k!=xc_runtime_guide ? (p_xc=cp_s(k);xc_candidate_add(p_xc[5]+floor(p_xc[6]*0.5),src););j+=1;
    );
  );
  best=-1;bestsc=-1;sum=0;j=0;pooln=0;
  loop(candidate_n,
    id=candidates[j*2];bridge=candidates[j*2+1];sc=cp_score(id,w,bridge);
    sc>bestsc ? (bestsc=sc;best=j;);
    // Relative temperature, not an unbounded random jump.
    value=exp((sc-1)/max(0.008,0.015+0.12*slider2));sum+=value;
    cp_rng()*sum<value ? pooln=j;
    pick_checked+=1;j+=1;
  );
  candidate_n>0 ? (
    slider2<0.0001 ? pooln=best;
    pick_id=candidates[pooln*2];pick_bridge=candidates[pooln*2+1];
    pick_score=cp_score(pick_id,w,pick_bridge);pick_relax=pick_bridge==-1 || (h_active && h_fit(pick_id)<0.15);
  );pick_id;
);

// ---------------- Incremental source index ----------------
function cp_reset_recent() local(i) (i=0;loop(64,recent_base[i]=-1;i+=1;);recent_write=0;selection_serial=0;);
function cp_add_recent(id) local(g) (recent_base[recent_write]=id;recent_write=(recent_write+1)%64;selection_serial+=1;g=cp_g(id);g[61]=selection_serial;);
function cp_fingerprint_add(x) local(part) (
  part=floor(abs(x)); part-=floor(part/16777213)*16777213;
  // Both operands and their sum stay below INT32_MAX before remainder.
  corpus_key=(corpus_key*127+part)%16777213;
);
// Bounded scout: 1..4096 short stereo probes spread over each complete source.
// This is inference, not exhaustive onset detection. Sparse coverage is exposed.
function cp_scout_finish() local(a s i count sum p95 high low split best w0 m0 w1 m1 sep totalvar db threshold delta changes run idx med j cumulative intervals window conf ref) (
  a=cp_auto(scout_source);s=cp_s(scout_source);sum=0;p95=0;i=0;
  loop(128,sum+=scout_hist[i];sum<scout_n*0.90 ? p95=i;i+=1;);
  high=p95-120;
  // A very sparse event must not disappear because 90 percent of the file is rest.
  high<-96 && s[7]>0.00001 ? high=cp_db(s[7]*0.25);
  best=-1;w0=0;m0=0;sum=0;i=0;loop(128,sum+=i*scout_hist[i];i+=1;);split=0;low=-120;
  i=0;loop(127,
    w0+=scout_hist[i];m0+=i*scout_hist[i];w1=scout_n-w0;
    w0>0 && w1>0 ? (
      m1=(sum-m0)/w1;sep=m1-m0/w0;totalvar=w0*w1*sep*sep/max(1,scout_n*scout_n);
      totalvar>best ? (best=totalvar;split=i;low=m0/w0-120;);
    );i+=1;
  );
  threshold=high-42;
  high-low>24 && best>8 ? threshold=max(threshold,min(high-24,low+6));
  high>-100 ? threshold=cp_clamp(threshold,-96,min(-42,high-18)) : threshold=-96;
  a[1]=threshold;a[2]=cp_amp(high);a[6]=scout_step;a[7]=scout_n;
  ref=max(cp_amp(high),s[7]*0.10);
  a[5]=s[7]>0.00001 ? cp_clamp(0.16/max(0.00001,ref),0.5,16) : 1;
  // Stable material gets a larger window. Repeated changes shorten it.
  // Derivatives compare neighbouring probe summaries, never waveform phase.
  memset(scout_hist,0,128);i=1;run=0;changes=0;intervals=0;
  while(i<scout_n)(
    db=scout_data[i*4];delta=abs(db-scout_data[(i-1)*4]);
    sep=abs(scout_data[i*4+1]-scout_data[(i-1)*4+1]);
    max(db,scout_data[(i-1)*4])>threshold+6 && (delta>7 || sep>0.22) ? (
      changes>0 ? (
        idx=min(127,max(0,floor((i-run)*scout_step/0.01)));scout_hist[idx]+=1;intervals+=1;
      );changes+=1;run=i;
    );i+=1;
  );
  med=0.25;
  intervals>0 ? (i=0;cumulative=0;j=0;while(i<128 && cumulative<ceil(intervals*0.5))(cumulative+=scout_hist[i];j=i;i+=1;);med=max(0.01,j*0.01););
  // v1.4: this is an internal SENSOR aperture, not the final Micro grain.
  // Dense sources therefore keep enough evidence to discover boundaries without
  // forcing the final corpus onto the 40-60 ms grid.
  window=changes>=2 ? cp_clamp(med*0.35,0.04,0.10) : 0.08;
  s[2]/s[3]<0.32 ? window=min(window,max(0.04,s[2]/s[3]/4));
  conf=cp_01(0.04/max(0.01,scout_step));scout_n<4 ? conf*=0.25;
  conf<0.5 ? (window=window*conf+0.08*(1-conf);auto_scout_sparse+=1;);
  a[3]=conf;a[0]=window_setting<=0 ? window : window_request;
  auto_desired_cells+=max(1,ceil(s[2]/s[3]/max(0.04,a[0])));
  cp_fingerprint_add(a[0]*100000);cp_fingerprint_add(a[1]*100);cp_fingerprint_add(a[2]*100000);
  scout_source+=1;scout_started=0;
);
function cp_scout_step(work) local(s a lo hi start frame l r power diff n val b id maxwork) (
  maxwork=max(32,floor(work));
  while(maxwork>0 && scout_source<source_count)(
    s=cp_s(scout_source);
    !scout_started ? (
      scout_n=min(4096,max(1,ceil(s[2]/s[3]/0.010)));scout_step=s[2]/s[3]/scout_n;
      scout_probe=0;scout_in=0;scout_started=1;scout_sum=0;scout_diff=0;scout_peak=0;
      memset(scout_hist,0,128);memset(cp_auto(scout_source),0,8);
    );
    lo=floor(s[2]*scout_probe/scout_n);hi=floor(s[2]*(scout_probe+1)/scout_n);
    n=min(quality_request==0 ? 32 : (quality_request==2 ? 256 : 128),max(1,hi-lo));
    start=lo+floor(max(0,hi-lo-n)*0.5);frame=min(s[2]-1,start+scout_in);
    sample_read2(bank_pool,s[0],frame,l,r) ? (
      (!(l==l) || abs(l)>1000000) ? l=0;(!(r==r) || abs(r)>1000000) ? r=0;
    ) : (l=0;r=0;invalid_audio+=1;);
    power=(l*l+r*r)*0.5;scout_sum+=power;scout_peak=max(scout_peak,max(abs(l),abs(r)));
    scout_in>0 ? scout_diff+=((l-scout_l)^2+(r-scout_r)^2)*0.5;
    scout_l=l;scout_r=r;scout_in+=1;scout_reads+=1;maxwork-=1;
    scout_in>=n ? (
      val=sqrt(scout_sum/max(1,n));scout_data[scout_probe*4]=cp_db(val);
      scout_data[scout_probe*4+1]=log(1+20*sqrt(cp_01(scout_diff/max(0.000000000001,4*scout_sum))))/log(21);
      scout_data[scout_probe*4+2]=scout_peak;scout_data[scout_probe*4+3]=val;
      b=cp_clamp(floor(cp_db(val)+120),0,127);scout_hist[b]+=1;
      scout_probe+=1;scout_in=0;scout_sum=0;scout_diff=0;scout_peak=0;
      scout_probe>=scout_n ? cp_scout_finish();
    );
  );
  scout_source>=source_count ? (
    auto_budget_scale=min(1,max(0,grain_capacity-source_count)/max(1,auto_desired_cells-source_count));
    build_phase=2;layout_cursor=0;tile_total=0;
  );
);

function cp_begin() local(n cap avail)
(
  // Must only be called at a block boundary with no current/pending voices.
  loaded_count=max(0,floor(sample_pool_loaded(bank_pool)));
  avail=max(65536,min(__memtop(),hm_episodes)-source_base-1024);
  h_ready=0;h_phase=0;h_status=0;xc_ready=0;xc_phase=0;xc_post_phase=0;xc_grammar_ready=0;xc_map_ready=0;xc_map_phase=0;
  source_capacity=min(65536,loaded_count);
  cap=4096*pow(2,floor(cp_clamp(slider6,0,4)));
  grain_capacity=min(65536,max(cap,source_capacity));
  grain_capacity=min(grain_capacity,floor((avail-source_capacity*8)/86));
  source_capacity=min(source_capacity,max(0,grain_capacity));
  grain_capacity=max(0,grain_capacity);
  grain_base=source_base+source_capacity*8+64;
  postings=grain_base+grain_capacity*64+64;
  source_count=0; meta_cursor=0; grain_count=0; tile_total=0; max_grain_seconds=0;
  total_seconds=0; ready=0; selected_id=-1; preview_id=-1;
  window_setting=slider5;window_request=slider5<=0 ? 0 : cp_clamp(slider5,30,1000)/1000;
  quiet_mode=floor(slider22);quiet_db=slider61;
  scout_source=0;scout_started=0;scout_reads=0;auto_quiet_n=0;auto_budget_coarsened=0;
  auto_window_min=1000000000;auto_window_max=0;auto_scout_sparse=0;auto_desired_cells=0;
  memset(path_res_counts,0,128);path_misses=0;
  budget_request=floor(slider6); quality_request=floor(slider21);
  burst_limit=quality_request==0 ? 16 : (quality_request==1 ? 64 : 128);
  corpus_key=900;cp_fingerprint_add(quiet_mode);cp_fingerprint_add(quiet_db*100); cp_fingerprint_add(window_request*1000); cp_fingerprint_add(grain_capacity); cp_fingerprint_add(quality_request);
  memset(hist,0,1024); memset(counts,0,29); memset(vertex_counts,0,29); memset(role_stats,0,16);
  invalid_sources=0; unindexed_sources=max(0,loaded_count-source_capacity);
  silent_grains=0; invalid_audio=0; analysis_points=0;
  build_phase=1; build_cursor=0; index_epoch+=1;
  last_plan_count=0; log_count=0; log_head=-1; selected_log=-1;
  cp_reset_recent(); cp_clear_events();record_n=0;record_done=0;record_event=-1;trace_n=0;trace_head=-1;browse_dirty=1;
);
function cp_setup_tile() local(s start end span)
(
  while(scan_source<source_count && scan_tile>=cp_source_cells(scan_source)) (
    scan_source+=1; scan_tile=0; scan_previous_tail=0;
  );
  scan_source<source_count ? (
    s=cp_s(scan_source); start=floor(s[2]*scan_tile/s[6]); end=floor(s[2]*(scan_tile+1)/s[6]);
    a_g=cp_g(grain_count); memset(a_g,0,64); a_g[0]=s[0]; a_g[1]=scan_source;
    a_g[2]=start; a_g[3]=max(1,end-start); a_g[4]=s[3]; a_g[5]=s[4];
    a_g[9]=0; a_g[10]=-1;
    a_bin=0; a_inburst=0; a_burst_ready=0;
    a_power=0; a_diff=0;a_sidepower=0; a_lowpower=0; a_lowref=0; a_num=0; a_ndiff=0;
    a_peak=0; a_headpower=0; a_headn=0; a_tailpower=0; a_tailn=0;
    a_envsum=0; a_envdiff=0; a_rise=0; a_prev_env=scan_previous_tail;
    a_max_env=0; a_peak_bin=0; a_tile_ready=1;
  ) : a_tile_ready=0;
);
function cp_finish_bin() local(env delta)
(
  env=sqrt(a_binpower/max(1,a_burst_count));
  a_g[24+a_bin]=a_binpeak;
  a_envsum+=env; delta=env-a_prev_env;
  a_envdiff+=abs(delta); a_rise=max(a_rise,delta); a_prev_env=env;
  env>a_max_env ? (a_max_env=env; a_peak_bin=a_bin;);
  a_bin<4 ? (a_headpower+=a_binpower; a_headn+=a_burst_count;);
  a_bin>=12 ? (a_tailpower+=a_binpower; a_tailn+=a_burst_count;);
  a_bin+=1; a_burst_ready=0;
);
function cp_finish_tile() local(rms bright body motion edge crest head tail d bin decay width) (
  rms=sqrt(a_power/max(1,a_num));
  bright=log(1+20*sqrt(cp_01(a_diff/max(0.000000000001,4*a_power))))/log(21);
  body=sqrt(cp_01(a_lowpower/max(0.000000000001,a_lowref)));
  motion=cp_01(a_envdiff/max(0.000000000001,a_envsum)*2.2);
  edge=cp_01(a_rise/max(0.000000000001,a_max_env));
  head=sqrt(a_headpower/max(1,a_headn));tail=sqrt(a_tailpower/max(1,a_tailn));
  crest=cp_01(log(max(1,a_peak/max(0.000000000001,rms)))/log(16));
  decay=cp_01((head-tail)/max(0.000000000001,head+tail));
  width=sqrt(cp_01(a_sidepower/max(0.000000000001,a_power)));
  a_g[6]=rms;a_g[7]=a_peak;a_g[8]=1;a_g[10]=-1;
  a_g[11]=cp_01((cp_db(rms)+84)/84);a_g[12]=bright;a_g[13]=body;a_g[14]=motion;a_g[15]=edge;
  a_g[21]=head;a_g[22]=tail;a_g[23]=cp_clamp(0.16/max(0.000001,rms),0.35,2);
  a_g[40]=a_peak_bin/15;a_g[45]=crest;a_g[46]=decay;a_g[47]=width;
  // Confidence reports sparse burst coverage, not semantic correctness.
  a_g[49]=min(1,a_num/max(1,a_g[3]));a_g[60]=0;a_g[61]=0;
  cp_quiet(grain_count);
  rms<0.00001 ? silent_grains+=1;
  a_g[60]<0.5 ? (d=0;loop(8,
    bin=floor(cp_clamp((d<5 ? a_g[11+d] : a_g[45+d-5])*127,0,127));hist[d*128+bin]+=1;d+=1;
  ););
  cp_fingerprint_add(rms*100000);cp_fingerprint_add(a_peak*100000);
