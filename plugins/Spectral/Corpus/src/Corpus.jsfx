  i==4 ? strcpy(#ui_xname,"PULSE EVIDENCE") : (i==5 ? strcpy(#ui_xname,"TONAL EVIDENCE") : (i==6 ? strcpy(#ui_xname,"RECURRENCE") : (i==7 ? strcpy(#ui_xname,"MAPPING STRICTNESS") : (
  i==8 ? strcpy(#ui_xname,"GUIDE CONTOUR") : (i==9 ? strcpy(#ui_xname,"GRAMMAR MEMORY") : (i==10 ? strcpy(#ui_xname,"NATURAL TIME LIMIT") : strcpy(#ui_xname,"LEARNED ENDINGS")))))))))));
);
