function ui_curve_pair_arg(a b) (cp_clamp(floor(a*255+0.5),0,255)*256+cp_clamp(floor(b*255+0.5),0,255););
function ui_curve_eval_samples(data interp u) local(x i q ym y0 y1 yp q2 q3 z) (
  interp=cp_clamp(floor(interp),0,2);u=cp_01(u);x=u*31;i=min(30,floor(x));q=x-i;y0=data[i];y1=data[i+1];
  interp==2 ? (u>=1 ? y1 : y0) : (interp==1 ? y0+(y1-y0)*q : (
    ym=data[max(0,i-1)];yp=data[min(31,i+2)];q2=q*q;q3=q2*q;
    z=0.5*((2*y0)+(-ym+y1)*q+(2*ym-5*y0+4*y1-yp)*q2+(-ym+3*y0-3*y1+yp)*q3);cp_01(z);
  ));
);
