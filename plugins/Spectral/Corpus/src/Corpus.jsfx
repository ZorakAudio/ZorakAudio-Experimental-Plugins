function xc_neighbor_one(id) local(g p q s j i d v lo n index cost a c target slots z)
(
  p=xc_g(id);g=cp_g(id);s=cp_s(g[1]);q=xc_n(id);memset(q,-1,16);i=0;loop(4,q[4+i]=100;q[12+i]=100;i+=1;);
  xc_pool_n=0;xc_pool_add(p[94]);xc_pool_add(p[95]);
  // Actual source continuation and context, then broad corpus / spectral probes.
  j=-8;while(j<=8)(i=id+j;i>=s[5] && i<s[5]+s[6] ? xc_pool_add(i);j+=1;);
  j=0;loop(min(64,grain_count),index=grain_count<=192 ? j : min(grain_count-1,floor((j+0.5)*grain_count/64));xc_pool_add(index);j+=1;);
  grain_count<=192 ? (j=64;while(j<grain_count)(xc_pool_add(j);j+=1;);) : (
    d=0;loop(8,v=d*16+min(15,floor(p[d]*16));n=min(32,xc_res_counts[v]);j=0;
      loop(min(12,n),i=xc_reservoir[v*32+min(n-1,floor((j+0.5)*n/max(1,min(12,n))))];xc_pool_add(i);j+=1;);d+=1;
    );
  );
  j=0;loop(xc_pool_n,i=xc_pool[j];i!=id ? (
    cost=xc_join(id,i,0.75,0,1,1)+0.12*xc_distance(id,i,1);
    i==p[95] ? cost*=0.55;xc_best_insert(q,i,cost);
    cost=xc_distance(id,i,1);
    a=p[94];a>=0 ? cost+=0.30*xc_join(a,i,0.75,0,1,1);
    a=p[95];a>=0 ? cost+=0.30*xc_join(i,a,0.75,0,1,1);
    xc_best_insert(q+8,i,cost);xc_precompute_comparisons+=1;
  );j+=1;);
);
function xc_coarse_one(src) local(s b n i j k id p z count first cells slots seconds weight total g)
(
  s=cp_s(src);slots=512-xc_coarse_n;seconds=s[2]/s[3];
  n=min(max(1,ceil(seconds/max(0.25,xc_coarse_window))),max(1,slots-(source_count-src-1)));
  xc_coarse_sources[src*2]=xc_coarse_n;xc_coarse_sources[src*2+1]=n;b=0;
  loop(n,z=xc_coarse+(xc_coarse_n+b)*48;memset(z,0,48);
    first=s[5]+floor(b*s[6]/n);cells=max(1,floor((b+1)*s[6]/n)-floor(b*s[6]/n));
    first=min(s[5]+s[6]-1,first);cells=min(cells,s[5]+s[6]-first);
    total=0;j=0;count=min(12,cells);
    loop(count,id=first+min(cells-1,floor((j+0.5)*cells/max(1,count)));p=xc_g(id);g=cp_g(id);
      xc_ok(id) ? (
        weight=max(0.05,cp_01(g[6]/max(0.00001,cp_auto(src)[2])));total+=weight;
        i=0;loop(8,z[i]+=p[i]*weight;z[20+i]+=cp_feat(id,i)*weight;i+=1;);
        i=0;loop(12,z[8+i]+=p[16+i]*weight;i+=1;);z[28]+=p[28]*weight;z[29]+=p[93]*weight;
      );j+=1;
    );i=0;loop(30,z[i]/=max(0.000001,total);i+=1;);
    z[30]=src;z[31]=seconds*b/n;z[32]=seconds/n;z[33]=first;z[34]=cells;z[36]=-1;z[37]=0;z[39]=total;
    b+=1;
  );xc_coarse_n+=n;
);
function xc_coarse_similarity(a b) local(p q d i value harm conf) (
  p=xc_coarse+a*48;q=xc_coarse+b*48;value=0;harm=0;i=0;
  loop(8,value+=abs(sqrt(max(0,p[i]))-sqrt(max(0,q[i])))*0.065+abs(p[20+i]-q[20+i])*0.035;i+=1;);
  i=0;loop(12,harm+=abs(p[8+i]-q[8+i]);i+=1;);conf=min(p[28],q[28]);
  cp_01(1-value-0.40*conf*harm*0.5);
);
// Sealed inputs and batched scalar outputs keep workers away from the live heap.
function xc_tasks_retire() local(rc) (
  xc_task_retiring ? (
    xc_task>0 ? (
      rc=task_cancel(xc_task);
      rc!=-2 ? (rc=task_release(xc_task);rc!=-2 ? xc_task=0;);
    );
    xc_task<=0 && xc_task_buffer>0 ? (
      rc=task_buffer_release(xc_task_buffer);rc!=-2 ? xc_task_buffer=0;
    );
    xc_task<=0 && xc_task_buffer<=0 ? xc_task_retiring=0;
  );
);
function xc_tasks_cancel() (
  xc_task_retiring=1;xc_tasks_retire();
  xc_task_stage=0;xc_task_copy=0;xc_task_adopt=0;
);
function xc_task_similarity(buf n pair) local(a b i value harm conf p q) (
  a=floor(pair/n);b=pair%n;p=a*30;q=b*30;value=0;harm=0;i=0;
  loop(8,
    value+=abs(sqrt(max(0,task_buffer_read(buf,p+i)))-sqrt(max(0,task_buffer_read(buf,q+i))))*0.065
      +abs(task_buffer_read(buf,p+20+i)-task_buffer_read(buf,q+20+i))*0.035;i+=1;
  );i=0;loop(12,harm+=abs(task_buffer_read(buf,p+8+i)-task_buffer_read(buf,q+8+i));i+=1;);
  conf=min(task_buffer_read(buf,p+28),task_buffer_read(buf,q+28));
  min(1,max(0,1-value-0.40*conf*harm*0.5));
);
function xc_matrix_step() local(i rc total pair a b batch buf n start) (
  total=xc_coarse_n*xc_coarse_n;
  !xc_task_retiring ? (
  xc_task_stage==0 ? (
    xc_task_buffer=task_buffer_create(max(1,xc_coarse_n*30));
    xc_task_buffer>0 ? (xc_task_stage=1;xc_task_copy=0;) : xc_task_buffer!=-2 ? xc_task_stage=4;
  );
  xc_task_stage==1 ? (
    i=0;rc=1;
    while(i<512 && xc_task_copy<xc_coarse_n*30 && rc>0)(
      a=floor(xc_task_copy/30);b=xc_task_copy%30;
      rc=task_buffer_set(xc_task_buffer,xc_task_copy,xc_coarse[a*48+b]);
      rc>0 ? (xc_task_copy+=1;i+=1;);
    );
    rc<0 && rc!=-2 ? (xc_tasks_cancel();xc_task_stage=4;);
    xc_task_stage==1 && xc_task_copy>=xc_coarse_n*30 ? (
      rc=task_buffer_seal(xc_task_buffer);
      rc>0 ? xc_task_stage=2 : rc!=-2 ? (xc_tasks_cancel();xc_task_stage=4;);
    );
  );
  xc_task_stage==2 && xc_cursor<total ? (
    buf=xc_task_buffer;n=xc_coarse_n;start=xc_cursor;batch=min(4096,total-start);
    xc_task=defer_for(pair,batch,xc_task_similarity(buf,n,start+pair););
    xc_task>0 ? (xc_task_count=batch;xc_task_adopt=0;xc_task_stage=3;)
      : xc_task!=-2 ? (xc_tasks_cancel();xc_task_stage=4;);
  );
  xc_task_stage==3 ? (
    task_status(xc_task)==TASK_SUCCEEDED ? (
      i=0;while(i<512 && xc_task_adopt<xc_task_count)(
        pair=xc_cursor+xc_task_adopt;a=floor(pair/xc_coarse_n);b=pair%xc_coarse_n;
        xc_matrix[a*512+b]=task_value(xc_task,xc_task_adopt);
        xc_task_adopt+=1;xc_precompute_comparisons+=1;i+=1;
      );
      xc_task_adopt>=xc_task_count ? (
        rc=task_release(xc_task);rc!=-2 ? (xc_task=0;xc_cursor+=xc_task_count;xc_task_stage=2;);
      );
    ) : task_finished(xc_task) ? (xc_tasks_cancel();xc_task_stage=4;xc_task_fallbacks+=1;);
  );
  xc_task_stage==4 ? (
    i=0;while(i<48 && xc_cursor<total)(
      a=floor(xc_cursor/xc_coarse_n);b=xc_cursor%xc_coarse_n;
      xc_matrix[a*512+b]=xc_coarse_similarity(a,b);
      xc_cursor+=1;xc_precompute_comparisons+=1;i+=1;
    );
  );
  xc_cursor>=total ? (xc_tasks_cancel();xc_phase=5;xc_cursor=0;);
  );
);

function xc_recur_finish_row(row) local(i j p q score total n same best bi novelty scale a b left right cross sums count l r)
(
  p=xc_coarse+row*48;best=0;bi=-1;i=0;
  loop(xc_coarse_n,q=xc_coarse+i*48;
    (q[30]!=p[30] || abs(row-i)>3) && p[39]>0 && q[39]>0 ? (
      score=0;n=0;j=-1;while(j<=1)(
        a=row+j;b=i+j;
        a>=0 && a<xc_coarse_n && b>=0 && b<xc_coarse_n && xc_coarse[a*48+30]==p[30] && xc_coarse[b*48+30]==q[30] ? (score+=xc_matrix[a*512+b];n+=1;);j+=1;
      );score/=max(1,n);score>best && n>=2 ? (best=score;bi=i;);
    );i+=1;
  );p[36]=bi;p[37]=best;best>0.82 ? xc_recurrences+=1;
  novelty=0;scale=1;loop(2,
    left=0;right=0;cross=0;n=0;l=1;
    while(l<=scale*2)(r=1;while(r<=scale*2)(
      a=row-l;b=row+r-1;
      a>=0 && b<xc_coarse_n && xc_coarse[a*48+30]==p[30] && xc_coarse[b*48+30]==p[30] ? (
        cross+=xc_matrix[a*512+b];
        left+=xc_matrix[a*512+max(0,row-r)];right+=xc_matrix[min(xc_coarse_n-1,row+l-1)*512+b];n+=1;
      );r+=1;
    );l+=1;);
    n>0 ? novelty=max(novelty,cp_01((0.5*(left+right)-cross)/n*3));scale=3;
  );p[35]=novelty;
);
// Four corpus-derived axes: deterministic PCA over 16 universal rich descriptors.
// This is load-specific structure discovery, not semantic classification.
function xd_reset() (
  memset(xd_sum,0,16);memset(xd_cross,0,256);memset(xd_vec,0,64);memset(xd_eval,0,4);memset(xd_minmax,0,8);
);
function xd_accumulate(id) local(p i j x) (
  p=xc_g(id);i=0;loop(16,xd_sum[i]+=p[i];j=0;loop(16,xd_cross[i*16+j]+=p[i]*p[j];j+=1;);i+=1;);
);
function xd_finalize(n) local(i j c it k mean v dot norm eig) (
  n=max(1,n);i=0;loop(16,xd_sum[i]/=n;i+=1;);
  i=0;loop(16,j=0;loop(16,xd_cross[i*16+j]=xd_cross[i*16+j]/n-xd_sum[i]*xd_sum[j];j+=1;);i+=1;);
  c=0;loop(4,
    i=0;loop(16,xd_vec[c*16+i]=(((i+1)*(c+3))%17-8)/8;i+=1;);
    it=0;loop(14,
      i=0;loop(16,v=0;j=0;loop(16,v+=xd_cross[i*16+j]*xd_vec[c*16+j];j+=1;);xd_tmp[i]=v;i+=1;);
      k=0;while(k<c)(dot=0;i=0;loop(16,dot+=xd_tmp[i]*xd_vec[k*16+i];i+=1;);i=0;loop(16,xd_tmp[i]-=dot*xd_vec[k*16+i];i+=1;);k+=1;);
      norm=0;i=0;loop(16,norm+=xd_tmp[i]*xd_tmp[i];i+=1;);norm=sqrt(max(0.000000000001,norm));
      i=0;loop(16,xd_vec[c*16+i]=xd_tmp[i]/norm;i+=1;);it+=1;
    );
    eig=0;i=0;loop(16,v=0;j=0;loop(16,v+=xd_cross[i*16+j]*xd_vec[c*16+j];j+=1;);eig+=xd_vec[c*16+i]*v;i+=1;);xd_eval[c]=max(0,eig);c+=1;
  );
);
function xd_score_raw(id) local(p c i score) (
  p=xc_g(id);c=0;loop(4,score=0;i=0;loop(16,score+=(p[i]-xd_sum[i])*xd_vec[c*16+i];i+=1;);p[96+c]=score;
    id==0 ? (xd_minmax[c*2]=score;xd_minmax[c*2+1]=score;) : (xd_minmax[c*2]=min(xd_minmax[c*2],score);xd_minmax[c*2+1]=max(xd_minmax[c*2+1],score););c+=1;);
);
function xd_score_normalize(id) local(p c lo hi) (
  p=xc_g(id);c=0;loop(4,lo=xd_minmax[c*2];hi=xd_minmax[c*2+1];p[96+c]=hi-lo>0.000000001 ? cp_01((p[96+c]-lo)/(hi-lo)) : 0.5;c+=1;);
);
function xd_res_add(id) local(d conf value bin k n slot) (
  d=0;loop(51,conf=cp_desc_conf(id,d);conf>0.05 ? (value=cp_desc(id,d);cp_desc_extent(d,value);bin=min(15,max(0,floor(value*16)));k=d*16+bin;n=desc_res_counts[k];desc_res_counts[k]=n+1;
    slot=n<32 ? n : ((id*127+k*8191)%max(1,n+1));slot<32 ? desc_reservoir[k*32+slot]=id;);d+=1;);
  cp_length_index(id);
);
function xc_features_work(work) local(budget g p s n frame l r win i j a b c idx count variance mean total)
(
  xc_phase==1 ? (
    budget=min(4096,max(128,work));
    xc_cursor<grain_count ? (
      xc_subphase==0 ? xc_frame_setup();
      while(budget>0 && xc_read_i<xc_read_count)(
        g=cp_g(xc_cursor);frame=xc_read_start+xc_read_i;
        sample_read2(bank_pool,g[0],frame,l,r) ? (
          (!(l==l) || abs(l)>1000000) ? l=0;(!(r==r) || abs(r)>1000000) ? r=0;
        ) : (l=0;r=0;invalid_audio+=1;);
        source_mono ? (l=cp_fold(l,r);r=l;);
        win=xc_read_count>1 ? 0.5-0.5*cos(2*$pi*xc_read_i/(xc_read_count-1)) : 1;
        xc_fft_l[xc_read_i*2]=l*win;xc_fft_r[xc_read_i*2]=r*win;
        xc_time[xc_read_i*2]=l;xc_time[xc_read_i*2+1]=r;
        xc_pow_l+=l*l;xc_pow_r+=r*r;xc_cross+=l*r;xc_peak=max(xc_peak,max(abs(l),abs(r)));
        xc_read_i+=1;xc_pcm_reads+=1;budget-=1;
      );xc_read_i>=xc_read_count ? xc_frame_finish();
    );
    xc_cursor>=grain_count ? (xc_phase=2;xc_cursor=0;);
  ) : xc_phase==2 ? (
    i=0;while(i<4 && xc_cursor<grain_count)(xc_pulse_one(xc_cursor);xc_cursor+=1;i+=1;);
    xc_cursor>=grain_count ? (
      i=0;loop(8,mean=xc_stats[i]/max(1,grain_count);variance=max(0,xc_stats[8+i]/max(1,grain_count)-mean*mean);
        xc_weights[i]=0.35+0.65*cp_01(sqrt(variance)*8);i+=1;
      );xc_stats[16]/=max(1,grain_count);xc_stats[17]/=max(1,grain_count);xc_stats[18]/=max(1,grain_count);
      xd_reset();xc_cursor=0;xc_phase=7;
    );
  ) : xc_phase==7 ? (
    i=0;while(i<12 && xc_cursor<grain_count)(xd_accumulate(xc_cursor);xc_cursor+=1;i+=1;);
    xc_cursor>=grain_count ? (xd_finalize(grain_count);xc_cursor=0;xc_phase=8;);
  ) : xc_phase==8 ? (
    i=0;while(i<16 && xc_cursor<grain_count)(xd_score_raw(xc_cursor);xc_cursor+=1;i+=1;);
    xc_cursor>=grain_count ? (xc_cursor=0;xc_phase=9;);
  ) : xc_phase==9 ? (
    i=0;while(i<16 && xc_cursor<grain_count)(xd_score_normalize(xc_cursor);xc_cursor+=1;i+=1;);
    xc_cursor>=grain_count ? (xc_coarse_window=max(0.25,total_seconds/max(1,512-source_count));xc_cursor=0;xc_phase=source_count>512 ? 6 : 3;source_count>512 ? xc_coverage_limited=1;);
  ) : xc_phase==3 ? (
    xc_cursor<source_count ? (xc_coarse_one(xc_cursor);xc_cursor+=1;);
    xc_cursor>=source_count ? (xc_phase=4;xc_cursor=0;);
  ) : xc_phase==4 ? (
    0;
  ) : xc_phase==5 ? (
    xc_cursor<xc_coarse_n ? (xc_recur_finish_row(xc_cursor);xc_cursor+=1;);
    xc_cursor>=xc_coarse_n ? (xc_phase=6;xc_cursor=0;);
  ) : xc_phase==6 ? (
    i=0;while(i<2 && xc_cursor<grain_count)(
      g=cp_g(xc_cursor);p=xc_g(xc_cursor);s=cp_s(g[1]);
      xc_coarse_n>0 ? (a=xc_coarse_sources[g[1]*2];n=xc_coarse_sources[g[1]*2+1];p[110]=a+min(n-1,floor((g[2]+g[3]*0.5)/s[2]*n)););
      xc_neighbor_one(xc_cursor);xc_cursor+=1;i+=1;
    );
    xc_cursor>=grain_count ? (memset(desc_res_counts,0,864);memset(desc_value_range,0,162);xc_cursor=0;xc_phase=10;);
  ) : xc_phase==10 ? (
    i=0;while(i<8 && xc_cursor<grain_count)(xd_res_add(xc_cursor);xc_cursor+=1;i+=1;);
    xc_cursor>=grain_count ? (xc_phase=0;xc_ready=1;xc_epoch=index_epoch;xc_request_hierarchy=1;h_rebuild_requested=1;);
  );
);

function xc_build(work) (
  xc_phase==4 ? xc_matrix_step() : xc_features_work(work);
);
function cg_features_step(work) local(total i a b) (
  xc_phase==4 ? (
    total=xc_coarse_n*xc_coarse_n;i=0;
    while(i<48 && xc_cursor<total)(
      a=floor(xc_cursor/xc_coarse_n);b=xc_cursor%xc_coarse_n;
      xc_matrix[a*512+b]=xc_coarse_similarity(a,b);
      xc_cursor+=1;xc_precompute_comparisons+=1;i+=1;
    );xc_cursor>=total ? (xc_phase=5;xc_cursor=0;);
  ) : xc_features_work(work);
);
// Dependency stages use one private arena and a pinned immutable audio generation.
function cg_index() (
  while(build_phase>0)(task_report(5,build_phase,grain_count,max(1,tile_total));cp_index_work(4096););
  task_report(5,0,grain_count,grain_count);1;
);
function cg_features() (
  while(xc_phase>0)(task_report(1,xc_phase,xc_cursor,grain_count);cg_features_step(4096););
  task_report(1,0,grain_count,grain_count);1;
);
function cg_structure() (
  h_begin();h_rebuild_requested=0;
  while(h_phase>0)(task_report(2,h_phase,h_cursor,grain_count);h_build(););
  task_report(2,0,grain_count,grain_count);1;
);
function cg_context() (
  xc_post_begin();while(xc_post_phase>0 || xc_map_phase>0)(task_report(3,xc_post_phase,xc_post_cursor,hm_n);xc_post_step(););
  fc_begin();while(fc_phase>0)(task_report(3,fc_phase,fc_cursor,hm_n);fc_step(););
  task_report(3,0,hm_n,hm_n);1;
);
function cg_pe() (
  pe_begin();while(pe_phase>0)(task_report(4,pe_phase,pe_cursor,grain_count);pe_build(4096););
  task_report(4,0,grain_count,grain_count);1;
);

function cg_key() (
  auto_config_key;
);
function cg_retire() local(rc) (
  cg_retiring ? (
    cg_arena>0 ? (rc=task_arena_release(cg_arena);rc!=-2 ? cg_arena=0;);
    cg_t0>0 ? (rc=task_release(cg_t0);rc!=-2 ? cg_t0=0;);
    cg_t1>0 ? (rc=task_release(cg_t1);rc!=-2 ? cg_t1=0;);
    cg_t2>0 ? (rc=task_release(cg_t2);rc!=-2 ? cg_t2=0;);
    cg_t3>0 ? (rc=task_release(cg_t3);rc!=-2 ? cg_t3=0;);
    cg_t4>0 ? (rc=task_release(cg_t4);rc!=-2 ? cg_t4=0;);
    cg_arena<=0 && cg_t0<=0 && cg_t1<=0 && cg_t2<=0 && cg_t3<=0 && cg_t4<=0 ? cg_retiring=0;
  );
);
function cg_cancel() (
  cg_retiring=1;cg_retire();cg_stage=0;
);
// A valid arena can outlive a failed writer. Poll every retained root: later
// dependency tasks become CANCELLED rather than SUCCEEDED in that case.
function cg_error(task) local(status) (
  status=task>0 ? task_status(task) : 0;
  task>0 && (status==TASK_FAILED || status==TASK_CANCELLED || status==TASK_INVALID) ? status : 0;
);
function cg_fail(reason) (
  cg_failures+=1;cg_last_failure=reason;cg_last_fail_stage=task_arena_progress(cg_arena,0);
  cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;
);
function cg_publish() (task_arena_adopt(cg_arena,cc_used,cc_scale,source_mono,passage_mode,passage_sensitivity,passage_limit,passage_run,a_bin,a_binpeak,a_binpower,a_burst_count,a_burst_ready,a_burst_start,a_diff,a_envdiff,a_envsum,a_g,a_headn,a_headpower,a_inburst,a_last_l,a_last_r,a_lowpower,a_lowref,a_lp_l,a_lp_r,a_lpc,a_max_env,a_ndiff,a_num,a_peak,a_peak_bin,a_power,a_prev_env,a_rise,a_sidepower,a_tailn,a_tailpower,a_tile_ready,analysis_points,apply_saved_edits,auto_budget_coarsened,auto_budget_scale,auto_desired_cells,auto_quiet_n,auto_s,auto_scout_sparse,auto_window_max,auto_window_min,browse_dirty,build_phase,corpus_key,edit_cursor,edits_inactive,edits_match,effective_window,fc_built_key,fc_cfg_key,fc_class_cursor,fc_cursor,fc_epoch,fc_iter,fc_last_norm,fc_lo,fc_member_cursor,fc_model_key,fc_n,fc_pc,fc_phase,fc_ready,fc_subphase,fill_grain,grain_count,h_best0,h_best1,h_best2,h_bestdist,h_boundary,h_cleanup_done,h_cluster_cap,h_coarsened,h_coverage_lost,h_cursor,h_detail,h_empty_classes,h_epoch,h_excluded,h_finalize_stage,h_level,h_link_sources,h_ls,h_macro_gap_n,h_macro_lost,h_macro_singletons,h_mend,h_merges,h_mflags,h_micro_only_short,h_min_macro,h_min_meso,h_monsets,h_mopen,h_mseconds,h_msource,h_msource_start,h_mstart,h_mtrans,h_pair_n,h_part_direction,h_part_distribution,h_part_motion,h_part_role,h_part_timing,h_phase,h_range_end,h_range_hi,h_range_lo,h_range_start,h_ready,h_rebuild_requested,h_refine_pass,h_rest_amp,h_rest_db,h_rest_seconds,h_rest_seed_conf,h_sensitive,h_status,h_step,h_weight0,h_weight1,h_weight2,h_xcount,h_xend,h_xflags,h_xopen,h_xscan,h_xseconds,h_xsource,h_xstart,hm_k,hm_n,hm_radius,hm_transitions,hx_k,hx_n,hx_radius,hx_transitions,invalid_audio,invalid_sources,layout_cursor,max_grain_seconds,merge_active,merge_done,merge_new_count,merge_new_start,merge_orig_end,merge_orig_start,merge_read,merge_source,merge_write,meta_cursor,norm_cursor,pe_count,pe_cross,pe_cursor,pe_diff,pe_epoch,pe_ffts,pe_fits,pe_frame_read,pe_frames,pe_last_l,pe_last_r,pe_lpow,pe_model_key,pe_nfft,pe_nr,pe_offset,pe_peak,pe_phase,pe_read_errors,pe_reads,pe_ready,pe_ref_mode,pe_rpow,pe_subphase,pg_load_pending,pg_ready,play_frames,play_run_limited,play_srcpos,playable_grains,posting_count,ready,scan_previous_tail,scan_source,scan_tile,scout_diff,scout_in,scout_l,scout_n,scout_peak,scout_probe,scout_r,scout_reads,scout_source,scout_started,scout_step,scout_sum,selected_id,silent_grains,source_count,tile_total,total_seconds,ui_left,xc_built_ceiling,xc_coarse_n,xc_coarse_window,xc_coverage_limited,xc_cross,xc_cursor,xc_descriptor_count,xc_epoch,xc_fft_count,xc_fft_size,xc_frame,xc_grammar_epoch,xc_grammar_overflow,xc_grammar_ready,xc_map_costsum,xc_map_count,xc_map_cursor,xc_map_epoch,xc_map_phase,xc_map_ready,xc_map_source,xc_map_target,xc_map_unmatched,xc_mapping_misses,xc_matrix_cursor,xc_pcm_reads,xc_peak,xc_phase,xc_pool_n,xc_post_cursor,xc_post_phase,xc_pow_l,xc_pow_r,xc_precompute_comparisons,xc_quality,xc_read_count,xc_read_i,xc_read_start,xc_ready,xc_recurrences,xc_request_hierarchy,xc_runtime_comparisons,xc_schema,xc_sparse_sources,xc_spectral_frames,xc_subphase,xc_terminal_examples,xc_triples););
function cg_step() local(rc phase cursor stage) (
  cg_retire();
  cg_stage==0 && !cg_disabled && !cg_retiring && !xc_task_retiring && !rebuild_request && !pending_adoption && pool_state!=1 && pool_state!=2 && build_phase==1 && loaded_count>0 && cp_hold_count()==0 && cp_busy()==0 ? (
    cg_arena=task_arena_clone(__memtop(),bank_pool,generation);
    cg_arena>0 ? (
      cg_epoch=index_epoch;cg_config=cg_key();cg_command=cmd_seen;cg_ceiling=slider52;cg_scope=slider14;cg_source=slider64;
      cg_stage=1;cg_keep=0;ready=0;xc_ready=0;h_ready=0;fc_ready=0;pe_ready=0;pg_ready=0;
    ) : (cg_arena==-1 || cg_arena==-2) ? cg_clone_retries+=1 : (cg_disabled=1;cg_failed_key=cg_retry_key;);
  );
  cg_stage>0 && (pool_state==1 || pool_state==2 || pending_adoption || cg_epoch!=index_epoch || cg_config!=cg_key() || cg_command!=cmd_seen || cg_ceiling!=slider52 || cg_scope!=slider14 || cg_source!=slider64) ? (
    cg_cancel();rebuild_request=1;poll_left=0;
  );
  cg_stage==1 ? (
    rc=task_arena_status(cg_arena);
    rc==4 ? (
      // Only live controls/runtime are copied at adoption; model storage is swapped.
      cg_keep==0 ? rc=task_arena_preserve(cg_arena,0,hist);
      cg_keep==1 ? rc=task_arena_preserve(cg_arena,candidates,source_base-candidates);
      cg_keep==2 ? rc=task_arena_preserve(cg_arena,traj_base,traj_memory_end-traj_base);
      cg_keep==3 ? rc=task_arena_preserve(cg_arena,td_buf_l,td_memory_end-td_buf_l);
      cg_keep==4 ? rc=task_arena_preserve(cg_arena,xc_params,16);
      cg_keep==5 ? rc=task_arena_preserve(cg_arena,pe_event_locks,32);
      cg_keep==6 ? rc=task_arena_preserve(cg_arena,gr_record,gr_memory_end-gr_record);
      cg_keep==7 ? rc=task_arena_preserve(cg_arena,cc_voices,cc_memory_end-cc_voices);
      cg_keep==8 ? rc=task_arena_preserve(cg_arena,repeat_hold,repeat_memory_end-repeat_hold);
      rc>0 ? cg_keep+=1;
      cg_keep>=9 ? cg_stage=2;
    ) : rc==5 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;);
  );
  cg_stage==2 ? (cg_t0=defer_arena(cg_arena,0,cg_index(););cg_t0>0 ? cg_stage=3 : cg_t0!=-2 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;););
  cg_stage==3 ? (cg_t1=defer_arena(cg_arena,cg_t0,cg_features(););cg_t1>0 ? cg_stage=4 : cg_t1!=-2 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;););
  cg_stage==4 ? (cg_t2=defer_arena(cg_arena,cg_t1,cg_structure(););cg_t2>0 ? cg_stage=5 : cg_t2!=-2 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;););
  cg_stage==5 ? (cg_t3=defer_arena(cg_arena,cg_t2,cg_context(););cg_t3>0 ? cg_stage=6 : cg_t3!=-2 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;););
  cg_stage==6 ? (cg_t4=defer_arena(cg_arena,cg_t3,cg_pe(););cg_t4>0 ? cg_stage=7 : cg_t4!=-2 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;););
  cg_stage>=2 && cg_stage<=7 ? (
    rc=cg_error(cg_t0);rc==0 ? rc=cg_error(cg_t1);rc==0 ? rc=cg_error(cg_t2);
    rc==0 ? rc=cg_error(cg_t3);rc==0 ? rc=cg_error(cg_t4);
    rc!=0 ? cg_fail(rc);
  );
  cg_stage>=2 && cg_stage<=7 ? (
    stage=task_arena_progress(cg_arena,0);phase=task_arena_progress(cg_arena,1);cursor=task_arena_progress(cg_arena,2);
    stage>0 && phase>=0 && cursor>=0 ? (
      build_phase=stage==5 ? max(1,phase) : 0;
      xc_phase=stage==1 ? max(1,phase) : 0;xc_cursor=stage==1 ? cursor : 0;
      h_phase=stage==2 ? max(1,phase) : 0;h_cursor=stage==2 ? cursor : 0;
      xc_post_phase=stage==3 ? 1 : 0;fc_phase=0;
      pe_phase=stage==4 ? max(1,phase) : 0;pe_cursor=stage==4 ? cursor : 0;
    );
    task_arena_status(cg_arena)==5 ? (cg_cancel();cg_disabled=1;cg_failed_key=cg_retry_key;rebuild_request=1;poll_left=0;);
    cg_stage==7 && task_status(cg_t4)==TASK_SUCCEEDED ? cg_stage=8;
  );
  cg_stage==8 ? (
    rc=cg_publish();rc>0 ? (cg_completed+=1;cg_cancel();) : rc!=-2 ? (cg_cancel();rebuild_request=1;poll_left=0;);
  );
);

// ---------------- Micro -> Meso -> Macro (v0.8.0) ----------------
// EC means a soft acoustic-behaviour cluster, not a proved mathematical
// equivalence relation or a semantic label. Chronology is always source-local.
function h_m(i) (hm_episodes+i*96;);
function h_x(i) (hx_episodes+i*128;);
function h_src(i) (h_sources+i*4;);
function h_ep(level i) (level<1 ? h_m(i) : h_x(i););
function h_cl(level i) (level<1 ? hm_classes+i*96 : hx_classes+i*128;);
function h_n(level) (level<1 ? hm_n : hx_n;);
function h_k(level) (level<1 ? hm_k : hx_k;);
function h_stride(level) (level<1 ? 96 : 128;);
function h_limit(level) (level<1 ? 48 : 24;);
function h_list(level) (level<1 ? hm_list : hx_list;);
function h_link(level a b) ( (level<1 ? hm_links+a*48*3 : hx_links+a*24*3)+b*3; );
function h_lowsalience(id) local(g) (g=cp_g(id);g[60]>0.5;);
function h_observed(id) local(g) (g=cp_g(id);g[9]<0.5 && g[6]>0.00001;);
function h_salience(id) local(g f) (
  g=cp_g(id);f=max(0.000001,cp_quiet_floor(g[1]));
  g[60]<0.5 ? 1 : cp_clamp(g[6]/max(0.000001,f*2),0.18,0.72);
);
function h_grainseconds(id) local(g) (g=cp_g(id);g[3]/max(1,g[4]););
function h_mean(p d) (0.5*p[16+d*3+1]+p[16+d*3+2];);
// Meso can provide evidence FOR a Macro rest boundary, but never schedules one.
// This gate is deliberately strict: low salience alone is insufficient.
function h_macro_rest_seed(p) local(c) (
  c=cp_01((p[4]-0.45)/0.75)
    *cp_01((0.22-p[60])/0.22)
    *cp_01((0.16-h_mean(p,0))/0.16)
    *cp_01((0.14-h_mean(p,3))/0.14)
    *cp_01((0.12-h_mean(p,4))/0.12)
    *cp_01((0.12-p[63])/0.12);
  h_rest_seed_conf=c;c>=0.82;
);
function h_rnd(q) local(hi lo nx) (
  hi=floor(q[13]/127773);lo=q[13]-hi*127773;nx=16807*lo-2836*hi;
  nx<=0 ? nx+=2147483647;q[13]=nx;nx/2147483647;
);
// ---------- Hierarchical ordered profiles and replaceability evidence ----------
function xc_hp(level p) local(id) (
  level<1 ? (
    id=p>=hm_classes && p<hm_classes+4608 ? floor(p[14]) : floor((p-hm_episodes)/96);
    xc_me(cp_clamp(id,0,8191));
  ) : (
    id=p>=hx_classes && p<hx_classes+3072 ? floor(p[14]) : floor((p-hx_episodes)/128);
    xc_ma(cp_clamp(id,0,1023));
  );
);
function xc_hgrain(level p u) local(m i id s) (
  id=-1;
  level<1 ? (p[2]>0 ? id=p[1]+min(p[2]-1,floor(cp_01(u)*p[2]));) : (
    p[2]>0 ? (i=p[1]+min(p[2]-1,floor(cp_01(u)*p[2]));m=h_m(i);m[2]>0 ? id=m[1]+min(m[2]-1,floor(cp_01(u)*m[2])););
  );id;
);
function xc_hsummary(level id) local(p z i d grain g q n first last) (
  p=h_ep(level,id);z=level<1 ? xc_me(id) : xc_ma(id);memset(z,0,64);first=-1;last=-1;n=0;
  i=0;loop(8,grain=xc_hgrain(level,p,(i+0.5)/8);
    xc_ok(grain) ? (
      q=xc_g(grain);g=cp_g(grain);first<0 ? first=grain;last=grain;n+=1;
      d=0;loop(8,z[d]+=q[d];d+=1;);d=0;loop(12,z[8+d]+=q[16+d];d+=1;);
      z[20]+=q[28];z[21]+=q[30];z[22]+=q[93];z[23]+=q[91]*q[93];
      z[24+i]=cp_feat(grain,0);z[32+i]=cp_feat(grain,3);z[40+i]=q[8];z[48+i]=cp_feat(grain,4);
    );i+=1;
  );i=0;loop(24,z[i]/=max(1,n);i+=1;);z[23]/=max(0.000001,z[22]);z[56]=first;z[57]=last;z[58]=-1;z[59]=-1;z[60]=-1;z[61]=0;z[62]=0;z[63]=n;
  first>=0 && xc_g(first)[110]>=0 ? (
    q=xc_coarse+xc_g(first)[110]*48;z[60]=q[36];z[61]=q[37];
  );
);
function xc_hmetric(level a b behavioral) local(p q i spec harm contour entry exit confid value direction)
(
  value=0;xc_ready ? (
    p=xc_hp(level,a);q=xc_hp(level,b);spec=0;harm=0;contour=0;direction=0;
    i=0;loop(8,spec+=abs(sqrt(max(0,p[i]))-sqrt(max(0,q[i])));
      contour+=abs(p[24+i]-q[24+i])+abs(p[32+i]-q[32+i])+abs(p[48+i]-q[48+i]);
      i>0 ? direction+=abs((p[24+i]-p[23+i])-(q[24+i]-q[23+i]));i+=1;
    );i=0;loop(12,harm+=abs(p[8+i]-q[8+i]);i+=1;);
    value=0.40*contour/24+0.12*direction/14+0.08*abs(log(max(0.02,a[4])/max(0.02,b[4])))/4;
    behavioral<0.5 ? value+=0.23*spec/4+0.17*min(p[20],q[20])*harm*0.5;
    // Boundary context is symmetric replaceability evidence, not the directed
    // playback join. Singleton support never implies that a behavior is bad.
    p[56]>=0 && q[56]>=0 && behavioral<0.5 ? (
      value+=0.08*xc_distance(p[56],q[56],1)+0.08*xc_distance(p[57],q[57],1);
    );
    value=cp_01(value);
  );value;
);

function h_dist(level a b) local(d i hp df dd tm ro z) (
  hp=0;df=0;dd=0;tm=0;ro=0;
  level<1 ? (
    i=0;loop(24,z=sqrt(max(0,a[16+i]))-sqrt(max(0,b[16+i]));hp+=z*z;i+=1;);
    i=0;loop(8,df+=abs(a[48+i]-b[48+i]);dd+=abs(a[40+i]-b[40+i]);i+=1;);
    i=0;loop(4,ro+=abs(a[56+i]-b[56+i]);i+=1;);
    tm=0.40*abs(a[60]-b[60])+0.35*abs(a[62]-b[62])+0.25*abs(a[63]-b[63]);
    h_part_distribution=sqrt(hp/16);h_part_motion=df/8;h_part_direction=dd/16;h_part_timing=tm;h_part_role=ro/4;
    z=0.50*h_part_distribution+0.20*h_part_motion+0.15*h_part_direction+0.10*tm+0.05*h_part_role;
    xc_ready && xc_params[0]>0.5 ? 0.58*z+0.42*xc_hmetric(level,a,b,0) : z;
  ) : (
    i=0;loop(48,z=sqrt(max(0,a[16+i]))-sqrt(max(0,b[16+i]));hp+=z*z;dd+=abs(a[64+i]-b[64+i]);i+=1;);
    tm=0.5*abs(a[112]-b[112])+0.30*abs(a[114]-b[114])+0.20*abs(a[115]-b[115]);
    h_part_distribution=sqrt(hp/2);h_part_motion=abs(a[118]-b[118]);h_part_direction=dd/2;h_part_timing=tm;h_part_role=0;
    z=0.60*h_part_distribution+0.20*h_part_direction+0.10*tm+0.10*h_part_motion;
    xc_ready && xc_params[0]>0.5 ? (0.65*z+0.35*xc_hmetric(level,a,b,0)+((a[117]>0.5)!=(b[117]>0.5) ? 0.6 : 0)) : z;
  );
);
// The analysis-order permutation is coprime with N, hence covers every episode.
function h_gcd(a b) local(t) (while(b>0)(t=a%b;a=b;b=t;);a;);
function h_order_setup(n) (
  h_step=max(1,2*floor(sqrt(max(1,n)))+1);
  while(h_gcd(h_step,max(1,n))!=1)(h_step+=2;);
);
function h_nearest(level p) local(k c z i t score total temp d0 d1 d2) (
  h_best0=-1;h_best1=-1;h_best2=-1;d0=100;d1=100;d2=100;i=0;
  loop(h_k(level),c=h_cl(level,i);
    c[0]>0 ? (z=h_dist(level,p,c);
      z<d0 ? (d2=d1;h_best2=h_best1;d1=d0;h_best1=h_best0;d0=z;h_best0=i;) : (
        z<d1 ? (d2=d1;h_best2=h_best1;d1=z;h_best1=i;) : (z<d2 ? (d2=z;h_best2=i;);)
      );
    );i+=1;
  );h_bestdist=d0;
  // Truncated soft assignments; weak distant alternatives are not fabricated.
  temp=max(0.008,(level<1 ? hm_radius : hx_radius)*0.30);
  h_weight0=h_best0>=0 ? 1 : 0;
  h_weight1=h_best1>=0 && d1<=d0+temp*4 ? exp(-(d1-d0)/temp) : 0;
  h_weight2=h_best2>=0 && d2<=d0+temp*4 ? exp(-(d2-d0)/temp) : 0;
  total=max(0.000000001,h_weight0+h_weight1+h_weight2);
  h_weight0/=total;h_weight1/=total;h_weight2/=total;
);
function h_assign(p) (
  p[6]=h_best0;p[7]=h_best1;p[8]=h_best2;p[9]=h_weight0;p[10]=h_weight1;p[11]=h_weight2;p[12]=h_bestdist;
);
function h_calibrate_start(level) (
  h_level=level;h_cursor=0;h_pair_n=0;memset(h_hist,0,128);h_order_setup(h_n(level));
);
function h_calibrate_step(level) local(n a b z bin j sum q) (
  n=h_n(level);j=0;
  while(j<12 && h_cursor<min(512,n*max(1,n-1))) (
    a=(h_cursor*h_step)%max(1,n);
    b=(a+1+floor(h_cursor/max(1,n))*max(1,floor(n/7)))%max(1,n);
    a!=b ? (z=h_dist(level,h_ep(level,a),h_ep(level,b));bin=floor(cp_clamp(z*127,0,127));h_hist[bin]+=1;h_pair_n+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=min(512,n*max(1,n-1)) ? (
    sum=0;q=0;j=0;while(j<128 && sum<h_pair_n*0.25)(sum+=h_hist[j];q=j;j+=1;);
    // Corpus-relative starting radius with a numerical floor; no forced K.
    z=max(0.025,q/127)*(1.55-0.9*h_detail);z=cp_clamp(z,0.018,0.24);
    level<1 ? hm_radius=z : hx_radius=z;
    h_cursor=0;h_phase=level<1 ? 4 : 10;
  );
);
// Two fixed-prototype reassignment passes avoid order-dependent online updates.
function h_leader_step(level) local(j id p c i n k radius) (
  j=0;n=h_n(level);radius=level<1 ? hm_radius : hx_radius;
  while(j<4 && h_cursor<n) (
    id=(h_cursor*h_step)%max(1,n);p=h_ep(level,id);h_nearest(level,p);k=h_k(level);
    h_best0<0 || (h_bestdist>radius && k<h_limit(level)) ? (
      c=h_cl(level,k);memset(c,0,h_stride(level));memcpy(c+16,p+16,h_stride(level)-16);c[0]=1;c[14]=id;
      level<1 ? hm_k+=1 : hx_k+=1;
    ) : (h_bestdist>radius ? h_cluster_cap+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=n ? (h_cursor=0;h_refine_pass=0;memset(h_sums,0,6144);h_phase=level<1 ? 5 : 11;);
);
function h_refine_step(level) local(j id p c q k i wt d) (
  j=0;
  while(j<4 && h_cursor<h_n(level)) (
    id=h_cursor;p=h_ep(level,id);h_nearest(level,p);h_assign(p);i=0;
    loop(3,k=p[6+i];wt=p[9+i];k>=0 && wt>0 ? (
      q=h_sums+k*128;q[0]+=wt;d=16;loop(h_stride(level)-16,q[d]+=wt*p[d];d+=1;);
    );i+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=h_n(level) ? (
    i=0;loop(h_k(level),c=h_cl(level,i);q=h_sums+i*128;
      q[0]>0.000001 ? (c[0]=q[0];d=16;loop(h_stride(level)-16,c[d]=q[d]/q[0];d+=1;);) : c[0]=0;
      i+=1;
    );h_cursor=0;h_refine_pass+=1;memset(h_sums,0,6144);
    h_refine_pass>=2 ? (
      // Merge only near-duplicate prototypes; retain isolated rare behaviours.
      i=0;loop(h_k(level),c=h_cl(level,i);j=0;
        while(j<i && c[0]>0)(q=h_cl(level,j);q[0]>0 && h_dist(level,c,q)<(level<1 ? hm_radius : hx_radius)*0.22 ? (c[0]=0;h_merges+=1;);j+=1;);i+=1;
      );
