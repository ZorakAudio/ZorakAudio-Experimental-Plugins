  w[4]==2 ? (target_role[0]*=0.3;target_role[2]=1;target_role[1]=0.55;);
  w[4]==3 ? (target_role[0]*=0.45;target_role[1]=1;);
  w[4]==4 ? (target_role[0]*=0.35;target_role[1]=0.85;target_role[2]=max(target_role[2],0.45););
  w[4]==5 ? (target_role[0]*=0.18;target_role[1]=1;target_role[3]=max(target_role[3],0.40););
  w[4]==6 ? (target_role[0]*=0.12;target_role[1]=0.95;target_role[2]=max(target_role[2],0.72););  cp_gap_request();
