  h_active && h_current>=0 ? (
    mi=hm_grainmap[id];mi>=0 && mi<hm_n ? (
      p=h_m(mi);q=h_m(h_current);a=0;loop(3,b=0;loop(3,
        p[6+a]>=0 && p[6+a]==q[6+b] ? value+=p[9+a]*q[9+b];b+=1;
      );a+=1;);
    );
  );value;
);
function h_add_candidate(id bridge src) local(g i exists) (
  id>=0 && id<grain_count && candidate_n<64 && cp_valid(id) ? (
    g=cp_g(id);src<=0 || g[1]==src-1 ? (
      exists=0;i=0;while(i<candidate_n && !exists)(candidates[i*2]==id ? exists=1;i+=1;);
      !exists ? (candidates[candidate_n*2]=id;candidates[candidate_n*2+1]=bridge;candidate_n+=1;);
    );
  );
);
function tr_candidates(src) local(pass l best bests usedmask p d mode target b key n j ix id counts entries limit passlimit) (
  usedmask=0;pass=0;limit=min(40,candidate_n+24);tr_candidate_added=0;
  counts=pg_preview ? pg_res_counts : ((pg_changed && !pg_bypass && pg_ready) ? pg_live_counts : desc_res_counts);
  entries=pg_preview ? pg_reservoir : ((pg_changed && !pg_bypass && pg_ready) ? pg_live_res : desc_reservoir);
  loop(4,
    best=-1;bests=-1;l=0;loop(12,p=tr_lane(l);tr_enabled(l) && (floor(usedmask/pow(2,l))%2)==0 ? (p[3]>bests ? (bests=p[3];best=l;););l+=1;);
    best>=0 ? (
      usedmask+=pow(2,best);p=tr_lane(best);d=cp_clamp(floor(p[1]),0,53);mode=cp_clamp(floor(p[2]),0,2);target=tr_lane_value(best,traj_u);passlimit=min(limit,candidate_n+6);b=0;
      loop(3,key=mode==0 ? cp_clamp(floor(target*16)+b-1,0,15) : (mode==1 ? floor(min(15,target*16)*b/2) : floor(min(15,target*16)+(15-min(15,target*16))*b/2));
        key=d*16+key;n=xc_ready ? min(32,counts[key]) : (d<8 ? min(64,path_res_counts[key]) : 0);j=0;
        loop(min(2,n),candidate_n<passlimit ? (
