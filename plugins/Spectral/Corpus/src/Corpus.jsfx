              at<12 ? (
                j=min(11,total);while(j>at)(path_best[j*2]=path_best[(j-1)*2];path_best[j*2+1]=path_best[(j-1)*2+1];j-=1;);
                path_best[at*2]=id;path_best[at*2+1]=dist;total=min(12,total+1);
