    n=xc_n(id);best=100;i=0;
    loop(4,future=n[i];xc_allowed(future,floor(slider14),xc_runtime_transfer,xc_runtime_guide) ? (
      cost=n[4+i];xc_ok(xc_future) ? cost+=0.25*xc_distance(future,xc_future,xc_params[5]);best=min(best,cost);
    );i+=1;);
    best<100 ? xc_cost_context=best;
