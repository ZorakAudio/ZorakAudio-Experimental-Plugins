  edits_inactive=edits_match ? 0 : edit_count;
);
// Neighbours contribute only across genuine same-source adjacency. File ends
// are NOT automatically tails: long files can contain many unrelated events.
function cp_roles(id) local(g p q prev next wt i k raw norm onset fall steady intra a b de ta best n) (
  g=cp_g(id);prev=0;next=0;wt=0;i=1;
  loop(2,k=id-i;
    k>=0 ? (p=cp_g(k);p[1]==g[1] ? (prev+=p[6]/i;wt+=1/i;););i+=1;
  );prev=wt>0 ? prev/wt : g[21];wt=0;i=1;
  loop(2,k=id+i;
    k<grain_count ? (q=cp_g(k);q[1]==g[1] ? (next+=q[6]/i;wt+=1/i;););i+=1;
  );next=wt>0 ? next/wt : g[22];
  onset=cp_01((g[6]-prev)/max(0.00001,g[6]+prev));
  fall=cp_01((g[6]-next)/max(0.00001,g[6]+next));
  intra=cp_01((g[21]-g[22])/max(0.00001,g[21]+g[22]));
  steady=1-cp_01(0.55*g[14]+0.25*onset+0.20*fall);
  // Independent eligibility dimensions: these do not sum to 1.
  a=cp_01(0.05+0.55*onset+0.36*g[20]*(1-0.55*g[40])+0.12*g[15]);
  b=cp_01(0.12+0.60*steady+0.16*g[16]-0.30*onset-0.15*g[15]);
  de=cp_01(0.06+0.55*g[19]+0.35*g[51]+0.10*g[14]);
  ta=cp_01(0.05+0.38*fall+0.55*intra+0.12*(1-g[16])-0.15*onset);
  g[41]=a;g[42]=b;g[43]=de;g[44]=ta;g[48]=steady;
  // Explicit manual ROLE BIAS boosts eligibility, never excludes other roles.
  g[10]>=0 ? g[41+g[10]]=cp_01(g[41+g[10]]+0.40);
  best=-1;n=0;i=0;loop(4,
    g[41+i]>best ? (best=g[41+i];n=i;);
    cp_valid(id) ? (
      role_stats[i]+=g[41+i];role_stats[4+i]+=g[41+i]*g[41+i];
      g[41+i]>=0.35 ? role_stats[8+i]+=1;
    );i+=1;
  );g[8]=n;
);
function cp_count_grain(id apply_edits) local(g d raw norm e v) (
  g=cp_g(id);d=0;loop(8,
    raw=d<5 ? g[11+d] : g[45+d-5];
