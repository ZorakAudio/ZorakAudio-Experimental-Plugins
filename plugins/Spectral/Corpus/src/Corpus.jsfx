    d<5 ? g[16+d]=norm : g[51+d-5]=norm;d+=1;
  );
  apply_edits && edits_match ? (
    while(edit_cursor<edit_count && edits[edit_cursor*3]<id)(edit_cursor+=1;);
    edit_cursor<edit_count && edits[edit_cursor*3]==id ? (
      e=edits+edit_cursor*3;g[9]=e[1];g[10]=e[2];
    );
  );
