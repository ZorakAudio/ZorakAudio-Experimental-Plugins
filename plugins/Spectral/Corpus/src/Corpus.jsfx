function tr_meta(id) local(lane code p q j) (
  id>=7000 ? (id==7000 ? tr_clear_all() : tr_preset(id-7000);j=0;loop(12,tr_store_lane(j);j+=1;);) : (
    lane=floor(id/512);code=id-lane*512;lane>=0 && lane<12 ? (
