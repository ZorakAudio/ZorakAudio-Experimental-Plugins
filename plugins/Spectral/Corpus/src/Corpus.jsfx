desc:Corpus v1.3.0 - coherence / grammar / guide-transfer prototype
tags:instrument sampler granular synthesis ui
// #GFX_RESIZE: responsive
// #FILE: Corpus sources {Slot 0: use Open Multiple, as in Sample v71. A single long file is valid.}
filename:0,sample.wav
in_pin:none
out_pin:Left
out_pin:Right
options:maxmem=25165824 gfx_hz=30
// @za:gfx_sync_policy EXPLICIT
// @za:gfx_sync_mem 49152 16384 DSP_TO_GFX
// Corpus v0.7.0: combined representation, walk, envelope, mutation, branching,
// and exploration prototype. Requires Sample v71's EXTENDED sample-pool host.
// Not stock REAPER JSFX. No compiler/runtime modifications or imports needed.
// Loader and analysis scaffolding derived from Corpus v0.1.2 / Sample v71.
// DSP owns corpus, analysis, scheduler, history and voices. GFX reads ONLY the
// bounded explicit snapshot and writes acknowledged slider24 command packets.
// Audio stays in the immutable host pool. Never adopt while voices/events exist.
// Roles are four independent fuzzy eligibilities, NEVER exclusive retrieval bins.
// Feature labels are acoustic PROXIES, not learned semantic/material recognition.
// The map is a user-selected two-descriptor projection, not a neural embedding.
// Existing slider slots are preserved; role filtering is now fuzzy eligibility.
// v0.9.3: decoupled analysis/audio clocks, active-run playback spans, audible-hole diagnostics.
// Slots 22/23 now hold quiet detection and source matching. Slot IDs otherwise stable.
// New defaults are for fresh instances. Saved explicit choices are not overwritten.
// #HELP: Load files in slot 0, wait for INDEX READY, click grains/vertices to hear them.
// #HELP: MIDI notes launch the same continuous walker in One-shot or Gated mode.
// #HELP: A/D/R are milliseconds; known windows proportionally fit A+D+R when needed.
// #HELP: Sustain is gain. Stability is the separate identity-leash parameter.
// #HELP: Draw a map path to guide selected descriptor axes through an event.
// #HELP: Click map point = audition, Shift = anchor, Ctrl+drag = focus, Draw = path.
// #HELP: All panes scroll. Small windows use tabs; no minimum-size blocker.
// #HELP: Sample Hub CC118/119 v1 packets: Play/Retrigger/Continue/Choke/End supported.
// #HELP: Unsupported modifier packets are rejected and counted, not misinterpreted.
// #HELP: REPEAT uses a completed recorded plan; overflow/continued/forced plans are disabled.
// #HELP: Live controls affect future selections; replay uses recorded decisions.
// #HELP: Analysis rebuilds automatically after source/settings changes; active audio finishes first.
// #HELP: Micro/Meso boundaries retarget future selections; they never truncate sounding audio.
// #HELP: Only event deadlines, explicit stops/source ends and Macro REST may terminate active audio.
// #HELP: Inspector distinguishes scheduler gaps, source holes and final audible holes.
// #HELP: Source matching is capped at +24 dB. Low-salience material stays playable; only Macro may schedule structural REST.
// #HELP: Draw commits on mouse-up. Locks/scope remain authoritative; target error is visible.
slider1:0.5<0,1,0.001>--Force target
slider2:0.35<0,1,0.001>--Variation
slider3:0.8<0,1,0.001>--Coherence
slider4:0.4<0,1,0.001>--Detail density
slider5:0<0,1000,1>--Analysis anchor window (0=Auto; otherwise 60-1000 ms)
slider6:1<0,4,1{4096,8192,16384,32768,65536}>--Grain index budget (Apply)
slider7:0<-36,12,0.1>--Output (dB)
slider8:0<-24,24,0.1>--Pitch (semitones; generated only)
slider9:1<0,1,0.001>--Velocity influence
slider10:0<0,2,1{One-shot,Gated,Natural}>--MIDI lifecycle
slider11:12345<1,16777213,1>--Random seed
slider12:0<0,1,1{Evolve,Fixed}>--Seed mode
slider13:0<0,65536,256>--Pool RAM budget (MB; 0=resident)
slider14:0<0,65536,1>--Source scope (0=all)
slider15:0<0,65536,1>--Identity anchor (0=none)
slider16:0<0,28,1>--Feature filter (0=all)
slider17:0<0,4,1{All,Attack,Body,Detail,Tail}>--Role eligibility filter
slider18:0<0,3276,1>--Grain browser page
slider19:0<0,99,1>--Traversal history offset
slider20:1<0,1,1{Off,On}>--Safety peak catch
slider21:1<0,2,1{Fast,Balanced,Detailed}>--Analysis quality (Apply)
slider22:1<0,2,1{Off,Auto,Manual}>--Low-salience detection
slider23:1<0,1,1{Raw,Match active}>--Source level policy
slider24:0<0,16777215,1>--UI action packet (internal; do not automate)
slider25:800<20,30000,1>--One-shot duration (ms)
slider26:5<0,2000,1>--Attack (ms)
slider27:100<0,5000,1>--Decay (ms)
slider28:0.75<0,1,0.001>--Sustain level
slider29:180<0,5000,1>--Release (ms)
slider30:0.55<0,1,0.001>--Walk flow / overlap
slider31:0.5<0,1,0.001>--Brightness mutation
slider32:0.5<0,1,0.001>--Mass (LF-weight mutation)
slider33:0.5<0,1,0.001>--Roughness mutation
slider34:0.65<0,1,0.001>--Novelty pressure
slider35:0.8<0,1,0.001>--Identity stability
slider36:0<0,3,1{Linear,Resonance,Debris,Layered}>--Branch morphology
slider37:0.25<0,1,0.001>--Branch level
slider38:0.85<0,1,0.001>--Branch identity inheritance
slider39:1<0,1,0.001>--Drawn path influence
slider40:1<0,7,1{Energy,Brightness,LF weight,Motion,Onset,Crest,Decay,Width}>--Map X descriptor
slider41:2<0,7,1{Energy,Brightness,LF weight,Motion,Onset,Crest,Decay,Width}>--Map Y descriptor
slider42:0.5<0,1,0.001>--Map focus X
slider43:0.5<0,1,0.001>--Map focus Y
slider44:0<0,1,0.001>--Map focus influence
slider45:0<0,255,1>--Map stratum page
slider46:0.75<0,1,0.001>--Envelope trajectory influence
slider47:2<0.2,20,0.01>--Gated path cycle (seconds)
slider48:0.35<0,1,0.001>--Role browser threshold
slider49:1<0,1,1{Off,On}>--Sample Hub duration packets
slider50:0<0,255,1>--Locked identity descriptors (bitmask)
slider51:0.95<0,1,0.001>--Identity lock strength
slider52:420<80,1000,1>--Adaptive grain ceiling (ms)
slider53:0.3<0,1,0.001>--Branch stereo spread
slider54:0<0,1,1{Navigate,Draw}>--Map mouse mode
slider55:4<0,4,1{Explore,Inspector,Controls,Inspector legacy,Structure}>--Interface page

// v0.8.0: source-local chronology, soft behavioural ECs, explicit durations,
// ordered member scaffolds, optional hierarchical rendering and Structure view.
// EC labels are approximate clusters; no semantic classification is asserted.
// Auto selects supported Macro/Meso/Micro levels. Learning always follows load/change.
// Bank/index reconstruction is deterministic; no playback RNG is used by learning.
// File ends are censored observations, NOT learned instructions to terminate.
// Micro analysis is still burst-sampled; no sub-tile boundary precision claimed.
slider56:5<0,6,1{Off,Inspect,Meso,Hierarchical,Reconstruct,Auto,Transfer}>--Hierarchy mode
slider57:0.8<0,1,0.001>--Behaviour target influence
slider58:0.35<0,1,0.001>--Behaviour variation
slider59:0.25<0,1,0.001>--Structure variation
slider60:0.5<0,1,0.001>--Boundary sensitivity (hierarchy rebuild)
slider61:-70<-100,-30,0.5>--Manual low-salience floor (dB; auto rebuild)
slider62:1<0.25,4,0.01>--Learned duration scale
slider63:0.5<0,1,0.001>--EC detail (hierarchy rebuild)
slider64:1<1,65536,1>--Structure / reconstruction source

@init

function cp_clamp(x a b) ( min(b,max(a,x)); );
function cp_01(x) ( cp_clamp(x,0,1); );
function cp_db(x) (20*log(max(0.000000000001,x))/log(10););
function cp_amp(x) (exp(x*log(10)/20););
function cp_frames(x) (x<0 ? x+4294967296 : x;);
function cp_rng() local(hi lo nx) (
  hi=floor(rng_state/127773); lo=rng_state-hi*127773;
  nx=16807*lo-2836*hi; nx<=0 ? nx+=2147483647;
  rng_state=nx; nx/2147483647;
);
function cp_g(id) (grain_base+id*64;);
function cp_s(id) (source_base+id*8;);
function cp_e(id) (event_base+id*64;);
function cp_w(id) (walker_base+id*64;);
function cp_v(id) (voice_base+id*32;);
function cp_source_cells(id) local(s) (s=cp_s(id);s[6];);
function cp_valid(id) local(g ok) (
  // Low-salience is NOT silence. Keep it playable and let scoring de-prioritize it.
  // Only explicit exclusion or the hard numerical floor removes a Micro grain.
  ok=0; id>=0 && id<grain_count ? (g=cp_g(id);ok=g[9]<0.5 && g[6]>0.00001;);ok;
);
function cp_feat(id d) local(g) (g=cp_g(id); d<5 ? g[16+d] : g[51+d-5];);
function cp_member(id vertex) local(d b g) (
  g=cp_g(id);vertex==28 ? 1 : (
    vertex>=15 && vertex<19 ? g[41+vertex-15] : (
      vertex<15 ? (d=floor(vertex/3);b=vertex-d*3;) : (d=5+floor((vertex-19)/3);b=(vertex-19)%3;);
      max(0,1-abs(2*cp_feat(id,d)-b));
    );
  );
);
function cp_dim_vertex(d b) (d<5 ? d*3+b : 19+(d-5)*3+b;);
function cp_lower(lo hi key) local(mid) (
  while(lo<hi) (mid=floor((lo+hi)/2);postings[mid]<key ? lo=mid+1 : hi=mid;);lo;
);
function cp_range(vertex src) local(lo hi s) (
  vertex=cp_clamp(floor(vertex),0,28);lo=offsets[vertex];hi=offsets[vertex+1];
  src>0 ? (src<=source_count ? (
    s=cp_s(src-1);lo=cp_lower(lo,hi,s[5]);hi=cp_lower(lo,hi,s[5]+s[6]);
  ) : hi=lo;);
  range_lo=lo;range_hi=hi;hi-lo;
);
// Per-source scout data: desired window, quiet floor dB, active RMS, confidence,
// actual indexed window, capped source gain, probe interval, probe count.
function cp_auto(src) (auto_sources+src*8;);
function cp_source_gain(src) local(a) (a=cp_auto(src);slider23>=0.5 ? a[5] : 1;);
function cp_quiet_floor(src) local(a) (a=cp_auto(src);quiet_mode==0 ? 0.00001 : cp_amp(quiet_mode==2 ? quiet_db : a[1]););
// This is a LOW-SALIENCE flag, distinct from explicit exclusion and from structural REST.
function cp_quiet(id) local(g a floorv low prev p) (
  g=cp_g(id);floorv=cp_quiet_floor(g[1]);low=floorv;
  id>0 ? (p=cp_g(id-1);p[1]==g[1] && p[60]<0.5 ? low*=0.501187233627272;);
  g[60]=(g[6]<low && g[7]<floorv*3.98107170553497) || g[6]<=0.00001;
  g[60]>0.5 ? auto_quiet_n+=1;
);
// Analysis anchors and playback grains are intentionally different scales.
// Anchors preserve local descriptor resolution; emitted regions may extend into
// adjacent source material when stability supports a longer, safer splice.
function cp_play_seconds(id kind) local(g stable motion onset detail lo hi) (
  g=cp_g(id);motion=cp_feat(id,3);onset=g[41];detail=g[43];
  stable=cp_01(0.50*g[48]+0.25*(1-motion)+0.15*(1-onset)+0.10*(1-detail));
  lo=kind==0 || kind==2 ? 0.050 : 0.075;
  hi=max(lo,slider52/1000);
  cp_clamp(lo+(hi-lo)*(0.18+0.82*stable),lo,hi);
);
// Local peak bins are load-time evidence. They are used only to keep an
// expanded playback span inside one contiguous active source run; they do not
// classify quiet material as REST. Scan is bounded to neighbouring index tiles.
function cp_bin_active(id bin) local(g floorv peakv) (
  g=cp_g(id);bin=cp_clamp(floor(bin),0,15);peakv=g[24+bin];
  floorv=max(0.000003,max(cp_quiet_floor(g[1])*1.20,g[7]*0.012));
  g[9]<0.5 && peakv>floorv;
);
function cp_play_region(id kind) local(g s seconds want center abin bestbd besti b i li lb ri rb gg left right cand span start frames sid first last steps ok) (
  g=cp_g(id);sid=g[1];s=cp_s(sid);seconds=cp_play_seconds(id,kind);want=min(s[2],max(1,floor(seconds*s[3])));
  center=g[2]+g[3]*(kind==0 ? (0.18+0.68*g[40]) : 0.5);
  abin=cp_clamp(floor((center-g[2])/max(1,g[3])*16),0,15);
  !cp_bin_active(id,abin) ? (
    bestbd=100;besti=-1;i=0;loop(16,cp_bin_active(id,i) && abs(i-abin)<bestbd ? (bestbd=abs(i-abin);besti=i;);i+=1;);
    besti>=0 ? (abin=besti;center=g[2]+g[3]*(abin+0.5)/16;);
  );
  first=s[5];last=first+s[6]-1;
  // If this tile contains no active sub-bin, keep its original bounded region;
  // retrieval scoring can still de-prioritize it as low-salience.
  cp_bin_active(id,abin) ? (
    li=id;lb=abin;gg=cp_g(li);left=gg[2]+floor(gg[3]*lb/16);steps=0;ok=1;
    while(ok && steps<96 && center-left<want)(
      lb>0 ? lb-=1 : (li>first ? (li-=1;lb=15;) : ok=0;);
      ok ? (gg=cp_g(li);gg[1]==sid && cp_bin_active(li,lb) ? left=gg[2]+floor(gg[3]*lb/16) : ok=0;);steps+=1;
    );
    ri=id;rb=abin;gg=cp_g(ri);right=gg[2]+floor(gg[3]*(rb+1)/16);steps=0;ok=1;
    while(ok && steps<96 && right-center<want)(
      rb<15 ? rb+=1 : (ri<last ? (ri+=1;rb=0;) : ok=0;);
      ok ? (gg=cp_g(ri);gg[1]==sid && cp_bin_active(ri,rb) ? right=gg[2]+floor(gg[3]*(rb+1)/16) : ok=0;);steps+=1;
    );
    span=max(1,right-left);frames=min(want,span);
    start=floor(center-frames*(kind==0 ? 0.25 : 0.5));start=cp_clamp(start,left,max(left,right-frames));
    play_srcpos=cp_clamp(start,0,max(0,s[2]-frames));play_frames=max(1,min(frames,s[2]-play_srcpos));
    play_run_limited=play_frames<want;
  ) : (
    frames=min(want,g[3]);start=floor(center-frames*(kind==0 ? 0.25 : 0.5));
    play_srcpos=cp_clamp(start,g[2],max(g[2],g[2]+g[3]-frames));play_frames=max(1,frames);play_run_limited=1;
  );
);
function h_meso_floor(src) local(a base) (
  a=cp_auto(src);base=max(0.06,max(a[0],a[4]));cp_clamp(max(0.16,base*2.50),0.16,0.75);
);
// Cheap two-axis retrieval reservoirs; at most 64 actual eligible grains per bin.
function cp_path_index(id) local(d b k n slot) (
  cp_valid(id) ? (d=0;loop(8,
    b=min(15,floor(cp_feat(id,d)*16));k=d*16+b;n=path_res_counts[k];path_res_counts[k]=n+1;
    slot=n<64 ? n : ((id*127+k*8191)%max(1,n+1));
    slot<64 ? path_reservoir[k*64+slot]=id;d+=1;
  ););
);
function cp_clear_voices() (memset(voice_base,0,2048); voice_list_n=0; active_voices=0;);
function cp_clear_events() (memset(event_base,0,512);memset(walker_base,0,1536); event_count=0;);
function cp_busy() (voice_list_n;);
function cp_hold_count() local(i n e) (
  i=0;n=0;loop(8,e=cp_e(i);e[0]>0 ? n+=1;i+=1;);n;
);
function cp_stop_event(ei when fade) local(i v e w) (
  e=cp_e(ei);e[0]>0 ? (
    e[1]==record_event && when<e[10] && !replaying ? record_overflow=max(record_overflow,3);
    when<e[14] ? (e[14]=when;e[15]=max(0,fade);) : (when==e[14] ? e[15]=min(e[15],max(0,fade)););
    i=0;loop(24,w=cp_w(i);w[0]>0 && w[1]==ei ? w[0]=0;i+=1;);
    i=0;loop(voice_list_n,v=cp_v(voice_list[i]);v[26]==ei && v[17]==e[1] ? (
      v[14]=min(v[14],when+fade);v[15]=max(1,fade);
    );i+=1;);
  );
);
function cp_stop_all(when fade channel) local(i e) (
  i=0;loop(8,e=cp_e(i);e[0]>0 && (channel<0 || e[3]==channel) ? cp_stop_event(i,when,fade);i+=1;);
  i=0;loop(voice_list_n,stop_v=cp_v(voice_list[i]);(channel<0 || stop_v[13]==channel) ? (
    stop_v[14]=min(stop_v[14],when+fade);stop_v[15]=max(1,fade);
  );i+=1;);
);
// Analytical event envelope: late Note Off never changes samples BEFORE its timestamp.
function cp_env_pre(e t) local(x) (
  x=t<e[5] ? 0 : (t<e[6] ? (t-e[5])/max(1,e[6]-e[5]) : (
    t<e[7] ? 1-(1-e[8])*(t-e[6])/max(1,e[7]-e[6]) : e[8]
  ));
  e[37]>e[35] && t>=e[35] && t<e[37] ? x=e[36]+(e[8]-e[36])*cp_01((t-e[35])/(e[37]-e[35]));x;
);
function cp_env(e t) local(a n q ei) (
  // Only Continue needs an old envelope snapshot. The common path is O(1).
  t<e[33] && e[34]>0 ? (
    ei=floor((e-event_base)/64);n=e[34]-1;
    while(n>=0)(q=env_old_base+ei*512+n*64;t>=q[33] || n==0 ? (e=q;n=-1;) : n-=1;);
  );
  a=t<e[9] ? cp_env_pre(e,t) : e[11]*max(0,(e[10]-t)/max(1,e[10]-e[9]));
  t>=e[14] ? a*=max(0,1-(t-e[14])/max(1,e[15]));cp_01(a);
);
function cp_env_save(e when) local(n q ei ok) (
  ok=1;when>e[33] ? (
    n=e[34];n<8 ? (
      ei=floor((e-event_base)/64);q=env_old_base+ei*512+n*64;memcpy(q,e,64);e[34]=n+1;e[33]=when;
    ) : ok=0;
  );ok;
);
function cp_phase(e t) local(d z) (
  phase_release=0;
  t<e[6] ? (phase_stage=0;phase_u=0.18*cp_01((t-e[5])/max(1,e[6]-e[5]));) : (
    t<e[7] ? (phase_stage=1;phase_u=0.18+0.17*cp_01((t-e[6])/max(1,e[7]-e[6]));) : (
      t<e[9] ? (phase_stage=2;
        e[12]>0 ? phase_u=cp_01((t-e[5])/max(1,e[10]-e[5])) : (
          z=(t-e[7])/max(1,srate*slider47);phase_u=0.35+0.225*(1-cos(z*2*$pi));
        );
      ) : (phase_stage=3;phase_release=cp_01((t-e[9])/max(1,e[10]-e[9]));phase_u=0.8+0.2*phase_release;);
    );
  );
  e[12]>0 ? phase_u=cp_01((t-e[5])/max(1,e[10]-e[5])); phase_stage;
);
function cp_event_find(note chan ext) local(i e found) (
  i=0;found=-1;while(i<8 && found<0) (
    e=cp_e(i);e[0]>0 && e[3]==chan && e[14]>clock && (ext>0 ? e[4]==ext : (e[2]==note && e[4]==0)) ? found=i;i+=1;
  );found;
);
function cp_path_eval(u) local(x i n) (
  path_x=0.5;path_y=0.5;
  path_count>0 ? (
    x=cp_01(u)*max(0,path_count-1);i=floor(x);n=min(path_count-1,i+1);x-=i;
    path_x=path_base[i*2]*(1-x)+path_base[n*2]*x;
    path_y=path_base[i*2+1]*(1-x)+path_base[n*2+1]*x;
  );
);
// ---------- v1.3 Coherence Core: immutable multiscale descriptor cache ----------
// All measurements below run in the idle load-time pipeline. Playback NEVER
// runs an FFT, PCM analysis, clustering, recurrence discovery or mapping search.
// Broad spectral shape and stereo are universal. Chroma and pulse costs are
// confidence-gated observations, not inferred semantic key/beat guarantees.
function xc_g(id) (xc_features+id*112;);
function xc_n(id) (xc_neighbors+id*16;);
function xc_me(id) (xc_meso+id*64;);
function xc_ma(id) (xc_macro+id*64;);
function xc_ok(id) (id>=0 && id<grain_count && xc_g(id)[107]>0.5;);
function xc_next(id) local(g s n) (
  n=-1;id>=0 && id<grain_count ? (g=cp_g(id);s=cp_s(g[1]);id+1<s[5]+s[6] && cp_valid(id+1) ? n=id+1;);n;
);
function xc_prev(id) local(g s n) (
  n=-1;id>=0 && id<grain_count ? (g=cp_g(id);s=cp_s(g[1]);id>s[5] && cp_valid(id-1) ? n=id-1;);n;
);
function xc_allowed(id src transfer guide) local(g yes) (
  yes=0;cp_valid(id) ? (g=cp_g(id);yes=(src<=0 || g[1]==src-1) && (!transfer || g[1]!=guide););yes;
);
// Body spectral cost: occupancy and timbre; not interchangeable with join cost.
function xc_distance(a b tone) local(i p q z v harm conf tot) (
  v=0;xc_ok(a) && xc_ok(b) ? (
    p=xc_g(a);q=xc_g(b);tot=0;i=0;
    loop(8,z=sqrt(max(0,p[i]))-sqrt(max(0,q[i]));v+=xc_weights[i]*z*z;tot+=xc_weights[i];i+=1;);
    v=sqrt(v/max(0.001,tot))*0.65+0.10*abs(p[8]-q[8])+0.10*abs(p[10]-q[10])+0.08*abs(p[14]-q[14])+0.07*abs(p[15]-q[15]);
    harm=0;i=0;loop(12,harm+=abs(p[16+i]-q[16+i]);i+=1;);
    conf=min(p[28],q[28])*tone;
    v+=0.55*conf*harm*0.5;
  );v;
);
// Join cost compares cached endpoint neighborhoods. au/bu are positions inside
// the actual planned playback spans, not whole-file means. This is evidence,
// not a promise of waveform phase matching or perfect harmonic compatibility.
function xc_join(a b au bu tone pulse) local(p q i u v z spectral harm conf pa pb ph d) (
  d=0;xc_ok(a) && xc_ok(b) ? (
    p=xc_g(a);q=xc_g(b);au=cp_01(au);bu=cp_01(bu);spectral=0;harm=0;
    i=0;loop(8,u=p[32+i]*(1-au)+p[48+i]*au;v=q[32+i]*(1-bu)+q[48+i]*bu;
      z=sqrt(max(0,u))-sqrt(max(0,v));spectral+=z*z;i+=1;);
    d=0.50*sqrt(spectral/2);
    u=p[40]*(1-au)+p[56]*au;v=q[40]*(1-bu)+q[56]*bu;
    // Level is relative to each source's active reference; source trim is not
    // treated as a different object. We do not flatten the audio to this value.
    d+=0.10*min(1,abs((u-p[31])-(v-q[31]))/30);
    d+=0.10*abs((p[41]*(1-au)+p[57]*au)-(q[41]*(1-bu)+q[57]*bu));
    d+=0.08*abs((p[42]*(1-au)+p[58]*au)-(q[42]*(1-bu)+q[58]*bu));
    i=0;loop(12,u=p[64+i]*(1-au)+p[76+i]*au;v=q[64+i]*(1-bu)+q[76+i]*bu;harm+=abs(u-v);i+=1;);
    conf=min(p[28],q[28])*tone;d+=0.70*conf*harm*0.5;
    p[93]>0.25 && q[93]>0.25 && p[91]>0 && q[91]>0 ? (
      pa=p[92]+au*p[89]/max(1,p[90])/p[91];pb=q[92]+bu*q[89]/max(1,q[90])/q[91];
      ph=abs(pa-pb);ph-=floor(ph);ph=min(ph,1-ph)*2;
      d+=0.30*pulse*min(p[93],q[93])*(0.70*ph+0.30*min(1,abs(log(p[91]/q[91]))));
    );
  );d;
);
function xc_pool_add(id) local(i found) (
  cp_valid(id) && xc_pool_n<192 ? (
    i=0;found=0;while(i<xc_pool_n && !found)(xc_pool[i]==id ? found=1;i+=1;);
    !found ? (xc_pool[xc_pool_n]=id;xc_pool_n+=1;);
  );
);
function xc_best_insert(base id cost) local(i j exists) (
  exists=0;i=0;loop(4,base[i]==id ? exists=1;i+=1;);
  !exists ? (
    i=0;while(i<4 && base[4+i]<=cost)(i+=1;);
    i<4 ? (j=3;while(j>i)(base[j]=base[j-1];base[4+j]=base[4+j-1];j-=1;);base[i]=id;base[4+i]=cost;);
  );
);
function xc_begin() local(i) (
  xc_ready=0;xc_grammar_ready=0;xc_map_ready=0;xc_epoch=index_epoch;xc_phase=1;xc_cursor=0;xc_frame=0;xc_subphase=0;
  xc_pcm_reads=0;xc_fft_count=0;xc_precompute_comparisons=0;xc_runtime_comparisons=0;xc_spectral_frames=0;xc_descriptor_count=0;
  xc_coarse_n=0;xc_matrix_cursor=0;xc_coverage_limited=0;xc_sparse_sources=0;xc_mapping_misses=0;xc_recurrences=0;
  xc_built_ceiling=slider52;xc_quality=quality_request;xc_fft_size=quality_request<1 ? 512 : (quality_request>1 ? 4096 : 2048);
  memset(xc_stats,0,256);i=0;loop(8,xc_weights[i]=1;i+=1;);
  memset(xc_res_counts,0,128);memset(xc_states,0,512);
  xc_schema=1300;xc_request_hierarchy=1;
);
function xc_frame_setup() local(g s p length offset) (
  g=cp_g(xc_cursor);s=cp_s(g[1]);p=xc_g(xc_cursor);
  xc_frame==0 ? (
    memset(p,0,112);p[94]=xc_prev(xc_cursor);p[95]=xc_next(xc_cursor);p[110]=-1;
    cp_play_region(xc_cursor,1);p[88]=play_srcpos;p[89]=play_frames;p[90]=g[4];
    p[31]=cp_db(max(0.000000000001,cp_auto(g[1])[2]));
  );
  length=min(xc_fft_size,max(1,p[89]));
  offset=xc_frame==0 ? 0 : (xc_frame==1 ? floor((p[89]-length)/2) : p[89]-length);
  xc_read_start=p[88]+offset;xc_read_count=length;xc_read_i=0;
  xc_pow_l=0;xc_pow_r=0;xc_cross=0;xc_peak=0;
  memset(xc_fft_l,0,xc_fft_size*2);memset(xc_fft_r,0,xc_fft_size*2);
  memset(xc_tmp,0,64);xc_subphase=1;
);
function xc_frame_finish() local(g s p i k freq band power total logarithm peakmax peakbin weighted second flat tonal chr energy win value lag n dot aa bb cc peakshift lp lc ln bestperiod bestcorr ratio harmonic z j base pitch csum validspan)
(
  g=cp_g(xc_cursor);s=cp_s(g[1]);p=xc_g(xc_cursor);
  fft(xc_fft_l,xc_fft_size);fft_permute(xc_fft_l,xc_fft_size);
  fft(xc_fft_r,xc_fft_size);fft_permute(xc_fft_r,xc_fft_size);xc_fft_count+=2;
  total=0;logarithm=0;peakmax=0;peakbin=1;weighted=0;second=0;i=1;
  while(i<xc_fft_size/2)(
    power=(xc_fft_l[i*2]^2+xc_fft_l[i*2+1]^2+xc_fft_r[i*2]^2+xc_fft_r[i*2+1]^2)*0.5;
    xc_power[i]=power;total+=power;logarithm+=log(max(0.000000000000000001,power));
    freq=i*s[3]/xc_fft_size;weighted+=freq*power;second+=freq*freq*power;
    power>peakmax ? (peakmax=power;peakbin=i;);
    band=freq<125 ? 0 : (freq<250 ? 1 : (freq<500 ? 2 : (freq<1000 ? 3 : (freq<2000 ? 4 : (freq<4000 ? 5 : (freq<8000 ? 6 : 7))))));
    xc_tmp[band]+=power;i+=1;
  );
  n=max(1,xc_fft_size/2-1);flat=total>0.000000000000000001 ? cp_01(exp(logarithm/n)/(total/n)) : 1;
  tonal=0;csum=0;i=2;
  while(i<xc_fft_size/2-1)(
    freq=i*s[3]/xc_fft_size;power=xc_power[i];
    freq>=70 && freq<=5000 && power>xc_power[i-1] && power>xc_power[i+1] ? (
      value=max(0,power-(xc_power[i-1]+xc_power[i+1])*0.5);tonal+=value;
      lp=log(max(0.000000000000000001,xc_power[i-1]));lc=log(max(0.000000000000000001,power));ln=log(max(0.000000000000000001,xc_power[i+1]));
      peakshift=abs(lp-2*lc+ln)>0.000001 ? cp_clamp(0.5*(lp-ln)/(lp-2*lc+ln),-0.5,0.5) : 0;
      freq=(i+peakshift)*s[3]/xc_fft_size;
      pitch=69+12*log(freq/440)/log(2);k=floor(pitch+0.5);k-=floor(k/12)*12;
      xc_tmp[16+k]+=value;csum+=value;
    );i+=1;
  );
  // A few subharmonic lags around the strongest spectral partial. This is a
  // periodicity/voicing cue, NOT reliable polyphonic fundamental estimation.
  bestcorr=0;bestperiod=0;j=1;freq=peakbin*s[3]/xc_fft_size;
  loop(4,lag=floor(s[3]/max(20,freq)*j+0.5);
    lag>=2 && lag<xc_read_count/2 ? (
      dot=0;aa=0;bb=0;i=0;n=min(128,xc_read_count-lag);
      loop(n,k=floor(i*(xc_read_count-lag)/n);
        dot+=xc_time[k*2]*xc_time[(k+lag)*2]+xc_time[k*2+1]*xc_time[(k+lag)*2+1];
        aa+=xc_time[k*2]^2+xc_time[k*2+1]^2;bb+=xc_time[(k+lag)*2]^2+xc_time[(k+lag)*2+1]^2;i+=1;
      );cc=dot/sqrt(max(0.000000000000000001,aa*bb));
      cc>bestcorr ? (bestcorr=cc;bestperiod=lag/s[3];);
    );j+=1;
  );
  validspan=cp_01(xc_read_count/max(1,min(xc_fft_size,s[3]*0.040)));
  tonal=cp_01((tonal/max(0.000000000000000001,total)-0.10)*2.5)*cp_01((bestcorr-0.35)/0.60)*validspan;
  i=0;loop(8,xc_tmp[i]/=max(0.000000000000000001,total);p[i]+=xc_tmp[i]/3;i+=1;);
  energy=sqrt((xc_pow_l+xc_pow_r)/max(1,xc_read_count*2));
  xc_tmp[8]=weighted/max(0.000000000000000001,total)/max(1,s[3]*0.5);
  xc_tmp[9]=sqrt(max(0,second/max(0.000000000000000001,total)-(weighted/max(0.000000000000000001,total))^2))/max(1,s[3]*0.5);
  xc_tmp[10]=flat;xc_tmp[11]=cp_01(0.5+(xc_tmp[6]+xc_tmp[7]-xc_tmp[0]-xc_tmp[1])*0.5);
  xc_tmp[12]=tonal;xc_tmp[13]=cp_01(bestcorr);
  xc_tmp[14]=cp_01(0.5+0.5*xc_cross/sqrt(max(0.000000000000000001,xc_pow_l*xc_pow_r)));
  xc_tmp[15]=cp_01(0.5+0.5*(xc_pow_r-xc_pow_l)/max(0.000000000000000001,xc_pow_l+xc_pow_r));
  i=8;loop(8,p[i]+=xc_tmp[i]/3;i+=1;);
  i=0;loop(12,xc_tmp[16+i]/=max(0.000000000000000001,csum);p[16+i]+=xc_tmp[16+i]/3;i+=1;);
  p[28]+=tonal/3;p[29]+=freq/3;p[30]+=cp_01(bestcorr)/3;p[106]+=validspan/3;
  xc_frame!=1 ? (
    base=xc_frame==0 ? 32 : 48;i=0;loop(8,p[base+i]=xc_tmp[i];i+=1;);
    p[base+8]=cp_db(energy);p[base+9]=xc_tmp[8];p[base+10]=flat;p[base+11]=tonal;
    p[base+12]=cp_01(bestcorr);p[base+13]=xc_tmp[14];p[base+14]=xc_tmp[15];p[base+15]=freq;
    base=xc_frame==0 ? 64 : 76;memcpy(p+base,xc_tmp+16,12);
  );
  xc_spectral_frames+=1;xc_frame+=1;xc_subphase=0;
  xc_frame>=3 ? (
    p[107]=1;xc_descriptor_count+=1;i=0;loop(8,xc_stats[i]+=p[i];xc_stats[8+i]+=p[i]*p[i];i+=1;);
    xc_stats[16]+=p[28];xc_stats[17]+=p[30];
    // Cached reservoir keys are independent of playback random state.
    i=0;loop(8,k=i*16+min(15,floor(p[i]*16));n=xc_res_counts[k];xc_res_counts[k]=n+1;
      z=n<32 ? n : ((xc_cursor*127+k*8191)%max(1,n+1));z<32 ? xc_reservoir[k*32+z]=xc_cursor;i+=1;
    );xc_cursor+=1;xc_frame=0;
  );
);
function xc_pulse_one(id) local(g p s first last lo hi n maxlag lag i a b am bm dot aa bb corr best bl mean value conf step peakvalue peaktime time phase)
(
  g=cp_g(id);s=cp_s(g[1]);p=xc_g(id);step=s[2]/s[3]/max(1,s[6]);
  first=s[5];last=first+s[6];lo=max(first,id-48);hi=min(last,lo+96);lo=max(first,hi-96);n=hi-lo;
  best=0;bl=0;mean=0;i=lo;
  while(i<hi)(mean+=cp_g(i)[20];i+=1;);mean/=max(1,n);
  maxlag=min(32,floor(n/3));lag=max(2,ceil(0.15/max(0.000001,step)));
  while(lag<=maxlag && lag*step<=2.5)(
    dot=0;aa=0;bb=0;i=lo;
    while(i<hi-lag)(a=cp_g(i)[20]-mean;b=cp_g(i+lag)[20]-mean;dot+=a*b;aa+=a*a;bb+=b*b;i+=1;);
    corr=dot/sqrt(max(0.000000000000000001,aa*bb));
    corr>best+0.025 ? (best=corr;bl=lag;);lag+=1;
  );
  conf=cp_01((best-0.40)/0.55)*cp_01(n/24)*cp_01(0.16/max(0.001,step));
  bl>0 && conf>0 ? (
    a=0;b=0;i=lo;peakvalue=0;peaktime=0;
    while(i<hi)(value=max(0,cp_g(i)[20]-mean);time=cp_g(i)[2]/g[4];phase=time/(bl*step)*2*$pi;
      a+=value*cos(phase);b+=value*sin(phase);peakvalue+=value;i+=1;
    );conf*=cp_01(sqrt(a*a+b*b)/max(0.000001,peakvalue)*2);
    peaktime=atan2(b,a)/(2*$pi);phase=p[88]/p[90]/(bl*step)-peaktime;phase-=floor(phase);
    p[91]=bl*step;p[92]=phase;p[93]=conf;
  ) : (p[91]=0;p[92]=0;p[93]=0;);
  xc_stats[18]+=p[93];
);
function xc_neighbor_one(id) local(g p q s j i d v lo n index cost a c target slots z)
(
  p=xc_g(id);g=cp_g(id);s=cp_s(g[1]);q=xc_n(id);memset(q,-1,16);i=0;loop(4,q[4+i]=100;q[12+i]=100;i+=1;);
  xc_pool_n=0;xc_pool_add(p[94]);xc_pool_add(p[95]);
  // Actual source continuation and context, then broad corpus / spectral probes.
  j=-8;while(j<=8)(i=id+j;i>=s[5] && i<s[5]+s[6] ? xc_pool_add(i);j+=1;);
  j=0;loop(min(64,grain_count),index=grain_count<=192 ? j : min(grain_count-1,floor((j+0.5)*grain_count/64));xc_pool_add(index);j+=1;);
  grain_count<=192 ? (j=64;while(j<grain_count)(xc_pool_add(j);j+=1;);) : (
    d=0;loop(8,v=d*16+min(15,floor(p[d]*16));n=min(32,xc_res_counts[v]);j=0;
      loop(min(12,n),i=xc_reservoir[v*32+min(n-1,floor((j+0.5)*n/max(1,min(12,n))))];xc_pool_add(i);j+=1;);d+=1;
    );
  );
  j=0;loop(xc_pool_n,i=xc_pool[j];i!=id ? (
    cost=xc_join(id,i,0.75,0,1,1)+0.12*xc_distance(id,i,1);
    i==p[95] ? cost*=0.55;xc_best_insert(q,i,cost);
    cost=xc_distance(id,i,1);
    a=p[94];a>=0 ? cost+=0.30*xc_join(a,i,0.75,0,1,1);
    a=p[95];a>=0 ? cost+=0.30*xc_join(i,a,0.75,0,1,1);
    xc_best_insert(q+8,i,cost);xc_precompute_comparisons+=1;
  );j+=1;);
);
function xc_coarse_one(src) local(s b n i j k id p z count first cells slots seconds weight total g)
(
  s=cp_s(src);slots=512-xc_coarse_n;seconds=s[2]/s[3];
  n=min(max(1,ceil(seconds/max(0.25,xc_coarse_window))),max(1,slots-(source_count-src-1)));
  xc_coarse_sources[src*2]=xc_coarse_n;xc_coarse_sources[src*2+1]=n;b=0;
  loop(n,z=xc_coarse+(xc_coarse_n+b)*48;memset(z,0,48);
    first=s[5]+floor(b*s[6]/n);cells=max(1,floor((b+1)*s[6]/n)-floor(b*s[6]/n));
    first=min(s[5]+s[6]-1,first);cells=min(cells,s[5]+s[6]-first);
    total=0;j=0;count=min(12,cells);
    loop(count,id=first+min(cells-1,floor((j+0.5)*cells/max(1,count)));p=xc_g(id);g=cp_g(id);
      xc_ok(id) ? (
        weight=max(0.05,cp_01(g[6]/max(0.00001,cp_auto(src)[2])));total+=weight;
        i=0;loop(8,z[i]+=p[i]*weight;z[20+i]+=cp_feat(id,i)*weight;i+=1;);
        i=0;loop(12,z[8+i]+=p[16+i]*weight;i+=1;);z[28]+=p[28]*weight;z[29]+=p[93]*weight;
      );j+=1;
    );i=0;loop(30,z[i]/=max(0.000001,total);i+=1;);
    z[30]=src;z[31]=seconds*b/n;z[32]=seconds/n;z[33]=first;z[34]=cells;z[36]=-1;z[37]=0;z[39]=total;
    b+=1;
  );xc_coarse_n+=n;
);
function xc_coarse_similarity(a b) local(p q d i value harm conf) (
  p=xc_coarse+a*48;q=xc_coarse+b*48;value=0;harm=0;i=0;
  loop(8,value+=abs(sqrt(max(0,p[i]))-sqrt(max(0,q[i])))*0.065+abs(p[20+i]-q[20+i])*0.035;i+=1;);
  i=0;loop(12,harm+=abs(p[8+i]-q[8+i]);i+=1;);conf=min(p[28],q[28]);
  cp_01(1-value-0.40*conf*harm*0.5);
);
function xc_recur_finish_row(row) local(i j p q score total n same best bi novelty scale a b left right cross sums count l r)
(
  p=xc_coarse+row*48;best=0;bi=-1;i=0;
  loop(xc_coarse_n,q=xc_coarse+i*48;
    (q[30]!=p[30] || abs(row-i)>3) && p[39]>0 && q[39]>0 ? (
      score=0;n=0;j=-1;while(j<=1)(
        a=row+j;b=i+j;
        a>=0 && a<xc_coarse_n && b>=0 && b<xc_coarse_n && xc_coarse[a*48+30]==p[30] && xc_coarse[b*48+30]==q[30] ? (score+=xc_matrix[a*512+b];n+=1;);j+=1;
      );score/=max(1,n);score>best && n>=2 ? (best=score;bi=i;);
    );i+=1;
  );p[36]=bi;p[37]=best;best>0.82 ? xc_recurrences+=1;
  novelty=0;scale=1;loop(2,
    left=0;right=0;cross=0;n=0;l=1;
    while(l<=scale*2)(r=1;while(r<=scale*2)(
      a=row-l;b=row+r-1;
      a>=0 && b<xc_coarse_n && xc_coarse[a*48+30]==p[30] && xc_coarse[b*48+30]==p[30] ? (
        cross+=xc_matrix[a*512+b];
        left+=xc_matrix[a*512+max(0,row-r)];right+=xc_matrix[min(xc_coarse_n-1,row+l-1)*512+b];n+=1;
      );r+=1;
    );l+=1;);
    n>0 ? novelty=max(novelty,cp_01((0.5*(left+right)-cross)/n*3));scale=3;
  );p[35]=novelty;
);
function xc_build(work) local(budget g p s n frame l r win i j a b c idx count variance mean total)
(
  xc_phase==1 ? (
    budget=min(4096,max(128,work));
    xc_cursor<grain_count ? (
      xc_subphase==0 ? xc_frame_setup();
      while(budget>0 && xc_read_i<xc_read_count)(
        g=cp_g(xc_cursor);frame=xc_read_start+xc_read_i;
        sample_read2(bank_pool,g[0],frame,l,r) ? (
          (!(l==l) || abs(l)>1000000) ? l=0;(!(r==r) || abs(r)>1000000) ? r=0;
        ) : (l=0;r=0;invalid_audio+=1;);
        win=xc_read_count>1 ? 0.5-0.5*cos(2*$pi*xc_read_i/(xc_read_count-1)) : 1;
        xc_fft_l[xc_read_i*2]=l*win;xc_fft_r[xc_read_i*2]=r*win;
        xc_time[xc_read_i*2]=l;xc_time[xc_read_i*2+1]=r;
        xc_pow_l+=l*l;xc_pow_r+=r*r;xc_cross+=l*r;xc_peak=max(xc_peak,max(abs(l),abs(r)));
        xc_read_i+=1;xc_pcm_reads+=1;budget-=1;
      );xc_read_i>=xc_read_count ? xc_frame_finish();
    );
    xc_cursor>=grain_count ? (xc_phase=2;xc_cursor=0;);
  ) : xc_phase==2 ? (
    i=0;while(i<4 && xc_cursor<grain_count)(xc_pulse_one(xc_cursor);xc_cursor+=1;i+=1;);
    xc_cursor>=grain_count ? (
      i=0;loop(8,mean=xc_stats[i]/max(1,grain_count);variance=max(0,xc_stats[8+i]/max(1,grain_count)-mean*mean);
        xc_weights[i]=0.35+0.65*cp_01(sqrt(variance)*8);i+=1;
      );xc_stats[16]/=max(1,grain_count);xc_stats[17]/=max(1,grain_count);xc_stats[18]/=max(1,grain_count);
      xc_coarse_window=max(0.25,total_seconds/max(1,512-source_count));xc_cursor=0;xc_phase=3;
      source_count>512 ? (xc_coverage_limited=1;xc_phase=6;);
    );
  ) : xc_phase==3 ? (
    xc_cursor<source_count ? (xc_coarse_one(xc_cursor);xc_cursor+=1;);
    xc_cursor>=source_count ? (xc_phase=4;xc_cursor=0;);
  ) : xc_phase==4 ? (
    i=0;while(i<48 && xc_cursor<xc_coarse_n*xc_coarse_n)(
      a=floor(xc_cursor/xc_coarse_n);b=xc_cursor%xc_coarse_n;xc_matrix[a*512+b]=xc_coarse_similarity(a,b);
      xc_cursor+=1;xc_precompute_comparisons+=1;i+=1;
    );xc_cursor>=xc_coarse_n*xc_coarse_n ? (xc_phase=5;xc_cursor=0;);
  ) : xc_phase==5 ? (
    xc_cursor<xc_coarse_n ? (xc_recur_finish_row(xc_cursor);xc_cursor+=1;);
    xc_cursor>=xc_coarse_n ? (xc_phase=6;xc_cursor=0;);
  ) : xc_phase==6 ? (
    i=0;while(i<2 && xc_cursor<grain_count)(
      g=cp_g(xc_cursor);p=xc_g(xc_cursor);s=cp_s(g[1]);
      xc_coarse_n>0 ? (a=xc_coarse_sources[g[1]*2];n=xc_coarse_sources[g[1]*2+1];p[110]=a+min(n-1,floor((g[2]+g[3]*0.5)/s[2]*n)););
      xc_neighbor_one(xc_cursor);xc_cursor+=1;i+=1;
    );
    xc_cursor>=grain_count ? (xc_phase=0;xc_ready=1;xc_epoch=index_epoch;xc_request_hierarchy=1;h_rebuild_requested=1;);
  );
);

// ---------------- Micro -> Meso -> Macro (v0.8.0) ----------------
// EC means a soft acoustic-behaviour cluster, not a proved mathematical
// equivalence relation or a semantic label. Chronology is always source-local.
function h_m(i) (hm_episodes+i*96;);
function h_x(i) (hx_episodes+i*128;);
function h_src(i) (h_sources+i*4;);
function h_ep(level i) (level<1 ? h_m(i) : h_x(i););
function h_cl(level i) (level<1 ? hm_classes+i*96 : hx_classes+i*128;);
function h_n(level) (level<1 ? hm_n : hx_n;);
function h_k(level) (level<1 ? hm_k : hx_k;);
function h_stride(level) (level<1 ? 96 : 128;);
function h_limit(level) (level<1 ? 48 : 24;);
function h_list(level) (level<1 ? hm_list : hx_list;);
function h_link(level a b) ( (level<1 ? hm_links+a*48*3 : hx_links+a*24*3)+b*3; );
function h_lowsalience(id) local(g) (g=cp_g(id);g[60]>0.5;);
function h_observed(id) local(g) (g=cp_g(id);g[9]<0.5 && g[6]>0.00001;);
function h_salience(id) local(g f) (
  g=cp_g(id);f=max(0.000001,cp_quiet_floor(g[1]));
  g[60]<0.5 ? 1 : cp_clamp(g[6]/max(0.000001,f*2),0.18,0.72);
);
function h_grainseconds(id) local(g) (g=cp_g(id);g[3]/max(1,g[4]););
function h_mean(p d) (0.5*p[16+d*3+1]+p[16+d*3+2];);
// Meso can provide evidence FOR a Macro rest boundary, but never schedules one.
// This gate is deliberately strict: low salience alone is insufficient.
function h_macro_rest_seed(p) local(c) (
  c=cp_01((p[4]-0.45)/0.75)
    *cp_01((0.22-p[60])/0.22)
    *cp_01((0.16-h_mean(p,0))/0.16)
    *cp_01((0.14-h_mean(p,3))/0.14)
    *cp_01((0.12-h_mean(p,4))/0.12)
    *cp_01((0.12-p[63])/0.12);
  h_rest_seed_conf=c;c>=0.82;
);
function h_rnd(q) local(hi lo nx) (
  hi=floor(q[13]/127773);lo=q[13]-hi*127773;nx=16807*lo-2836*hi;
  nx<=0 ? nx+=2147483647;q[13]=nx;nx/2147483647;
);
// ---------- Hierarchical ordered profiles and replaceability evidence ----------
function xc_hp(level p) local(id) (
  level<1 ? (
    id=p>=hm_classes && p<hm_classes+4608 ? floor(p[14]) : floor((p-hm_episodes)/96);
    xc_me(cp_clamp(id,0,8191));
  ) : (
    id=p>=hx_classes && p<hx_classes+3072 ? floor(p[14]) : floor((p-hx_episodes)/128);
    xc_ma(cp_clamp(id,0,1023));
  );
);
function xc_hgrain(level p u) local(m i id s) (
  id=-1;
  level<1 ? (p[2]>0 ? id=p[1]+min(p[2]-1,floor(cp_01(u)*p[2]));) : (
    p[2]>0 ? (i=p[1]+min(p[2]-1,floor(cp_01(u)*p[2]));m=h_m(i);m[2]>0 ? id=m[1]+min(m[2]-1,floor(cp_01(u)*m[2])););
  );id;
);
function xc_hsummary(level id) local(p z i d grain g q n first last) (
  p=h_ep(level,id);z=level<1 ? xc_me(id) : xc_ma(id);memset(z,0,64);first=-1;last=-1;n=0;
  i=0;loop(8,grain=xc_hgrain(level,p,(i+0.5)/8);
    xc_ok(grain) ? (
      q=xc_g(grain);g=cp_g(grain);first<0 ? first=grain;last=grain;n+=1;
      d=0;loop(8,z[d]+=q[d];d+=1;);d=0;loop(12,z[8+d]+=q[16+d];d+=1;);
      z[20]+=q[28];z[21]+=q[30];z[22]+=q[93];z[23]+=q[91]*q[93];
      z[24+i]=cp_feat(grain,0);z[32+i]=cp_feat(grain,3);z[40+i]=q[8];z[48+i]=cp_feat(grain,4);
    );i+=1;
  );i=0;loop(24,z[i]/=max(1,n);i+=1;);z[23]/=max(0.000001,z[22]);z[56]=first;z[57]=last;z[58]=-1;z[59]=-1;z[60]=-1;z[61]=0;z[62]=0;z[63]=n;
  first>=0 && xc_g(first)[110]>=0 ? (
    q=xc_coarse+xc_g(first)[110]*48;z[60]=q[36];z[61]=q[37];
  );
);
function xc_hmetric(level a b behavioral) local(p q i spec harm contour entry exit confid value direction)
(
  value=0;xc_ready ? (
    p=xc_hp(level,a);q=xc_hp(level,b);spec=0;harm=0;contour=0;direction=0;
    i=0;loop(8,spec+=abs(sqrt(max(0,p[i]))-sqrt(max(0,q[i])));
      contour+=abs(p[24+i]-q[24+i])+abs(p[32+i]-q[32+i])+abs(p[48+i]-q[48+i]);
      i>0 ? direction+=abs((p[24+i]-p[23+i])-(q[24+i]-q[23+i]));i+=1;
    );i=0;loop(12,harm+=abs(p[8+i]-q[8+i]);i+=1;);
    value=0.40*contour/24+0.12*direction/14+0.08*abs(log(max(0.02,a[4])/max(0.02,b[4])))/4;
    behavioral<0.5 ? value+=0.23*spec/4+0.17*min(p[20],q[20])*harm*0.5;
    // Boundary context is symmetric replaceability evidence, not the directed
    // playback join. Singleton support never implies that a behavior is bad.
    p[56]>=0 && q[56]>=0 && behavioral<0.5 ? (
      value+=0.08*xc_distance(p[56],q[56],1)+0.08*xc_distance(p[57],q[57],1);
    );
    value=cp_01(value);
  );value;
);

function h_dist(level a b) local(d i hp df dd tm ro z) (
  hp=0;df=0;dd=0;tm=0;ro=0;
  level<1 ? (
    i=0;loop(24,z=sqrt(max(0,a[16+i]))-sqrt(max(0,b[16+i]));hp+=z*z;i+=1;);
    i=0;loop(8,df+=abs(a[48+i]-b[48+i]);dd+=abs(a[40+i]-b[40+i]);i+=1;);
    i=0;loop(4,ro+=abs(a[56+i]-b[56+i]);i+=1;);
    tm=0.40*abs(a[60]-b[60])+0.35*abs(a[62]-b[62])+0.25*abs(a[63]-b[63]);
    h_part_distribution=sqrt(hp/16);h_part_motion=df/8;h_part_direction=dd/16;h_part_timing=tm;h_part_role=ro/4;
    z=0.50*h_part_distribution+0.20*h_part_motion+0.15*h_part_direction+0.10*tm+0.05*h_part_role;
    xc_ready && xc_params[0]>0.5 ? 0.58*z+0.42*xc_hmetric(level,a,b,0) : z;
  ) : (
    i=0;loop(48,z=sqrt(max(0,a[16+i]))-sqrt(max(0,b[16+i]));hp+=z*z;dd+=abs(a[64+i]-b[64+i]);i+=1;);
    tm=0.5*abs(a[112]-b[112])+0.30*abs(a[114]-b[114])+0.20*abs(a[115]-b[115]);
    h_part_distribution=sqrt(hp/2);h_part_motion=abs(a[118]-b[118]);h_part_direction=dd/2;h_part_timing=tm;h_part_role=0;
    z=0.60*h_part_distribution+0.20*h_part_direction+0.10*tm+0.10*h_part_motion;
    xc_ready && xc_params[0]>0.5 ? (0.65*z+0.35*xc_hmetric(level,a,b,0)+((a[117]>0.5)!=(b[117]>0.5) ? 0.6 : 0)) : z;
  );
);
// The analysis-order permutation is coprime with N, hence covers every episode.
function h_gcd(a b) local(t) (while(b>0)(t=a%b;a=b;b=t;);a;);
function h_order_setup(n) (
  h_step=max(1,2*floor(sqrt(max(1,n)))+1);
  while(h_gcd(h_step,max(1,n))!=1)(h_step+=2;);
);
function h_nearest(level p) local(k c z i t score total temp d0 d1 d2) (
  h_best0=-1;h_best1=-1;h_best2=-1;d0=100;d1=100;d2=100;i=0;
  loop(h_k(level),c=h_cl(level,i);
    c[0]>0 ? (z=h_dist(level,p,c);
      z<d0 ? (d2=d1;h_best2=h_best1;d1=d0;h_best1=h_best0;d0=z;h_best0=i;) : (
        z<d1 ? (d2=d1;h_best2=h_best1;d1=z;h_best1=i;) : (z<d2 ? (d2=z;h_best2=i;);)
      );
    );i+=1;
  );h_bestdist=d0;
  // Truncated soft assignments; weak distant alternatives are not fabricated.
  temp=max(0.008,(level<1 ? hm_radius : hx_radius)*0.30);
  h_weight0=h_best0>=0 ? 1 : 0;
  h_weight1=h_best1>=0 && d1<=d0+temp*4 ? exp(-(d1-d0)/temp) : 0;
  h_weight2=h_best2>=0 && d2<=d0+temp*4 ? exp(-(d2-d0)/temp) : 0;
  total=max(0.000000001,h_weight0+h_weight1+h_weight2);
  h_weight0/=total;h_weight1/=total;h_weight2/=total;
);
function h_assign(p) (
  p[6]=h_best0;p[7]=h_best1;p[8]=h_best2;p[9]=h_weight0;p[10]=h_weight1;p[11]=h_weight2;p[12]=h_bestdist;
);
function h_calibrate_start(level) (
  h_level=level;h_cursor=0;h_pair_n=0;memset(h_hist,0,128);h_order_setup(h_n(level));
);
function h_calibrate_step(level) local(n a b z bin j sum q) (
  n=h_n(level);j=0;
  while(j<12 && h_cursor<min(512,n*max(1,n-1))) (
    a=(h_cursor*h_step)%max(1,n);
    b=(a+1+floor(h_cursor/max(1,n))*max(1,floor(n/7)))%max(1,n);
    a!=b ? (z=h_dist(level,h_ep(level,a),h_ep(level,b));bin=floor(cp_clamp(z*127,0,127));h_hist[bin]+=1;h_pair_n+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=min(512,n*max(1,n-1)) ? (
    sum=0;q=0;j=0;while(j<128 && sum<h_pair_n*0.25)(sum+=h_hist[j];q=j;j+=1;);
    // Corpus-relative starting radius with a numerical floor; no forced K.
    z=max(0.025,q/127)*(1.55-0.9*h_detail);z=cp_clamp(z,0.018,0.24);
    level<1 ? hm_radius=z : hx_radius=z;
    h_cursor=0;h_phase=level<1 ? 4 : 10;
  );
);
// Two fixed-prototype reassignment passes avoid order-dependent online updates.
function h_leader_step(level) local(j id p c i n k radius) (
  j=0;n=h_n(level);radius=level<1 ? hm_radius : hx_radius;
  while(j<4 && h_cursor<n) (
    id=(h_cursor*h_step)%max(1,n);p=h_ep(level,id);h_nearest(level,p);k=h_k(level);
    h_best0<0 || (h_bestdist>radius && k<h_limit(level)) ? (
      c=h_cl(level,k);memset(c,0,h_stride(level));memcpy(c+16,p+16,h_stride(level)-16);c[0]=1;c[14]=id;
      level<1 ? hm_k+=1 : hx_k+=1;
    ) : (h_bestdist>radius ? h_cluster_cap+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=n ? (h_cursor=0;h_refine_pass=0;memset(h_sums,0,6144);h_phase=level<1 ? 5 : 11;);
);
function h_refine_step(level) local(j id p c q k i wt d) (
  j=0;
  while(j<4 && h_cursor<h_n(level)) (
    id=h_cursor;p=h_ep(level,id);h_nearest(level,p);h_assign(p);i=0;
    loop(3,k=p[6+i];wt=p[9+i];k>=0 && wt>0 ? (
      q=h_sums+k*128;q[0]+=wt;d=16;loop(h_stride(level)-16,q[d]+=wt*p[d];d+=1;);
    );i+=1;);
    h_cursor+=1;j+=1;
  );
  h_cursor>=h_n(level) ? (
    i=0;loop(h_k(level),c=h_cl(level,i);q=h_sums+i*128;
      q[0]>0.000001 ? (c[0]=q[0];d=16;loop(h_stride(level)-16,c[d]=q[d]/q[0];d+=1;);) : c[0]=0;
      i+=1;
    );h_cursor=0;h_refine_pass+=1;memset(h_sums,0,6144);
    h_refine_pass>=2 ? (
      // Merge only near-duplicate prototypes; retain isolated rare behaviours.
      i=0;loop(h_k(level),c=h_cl(level,i);j=0;
        while(j<i && c[0]>0)(q=h_cl(level,j);q[0]>0 && h_dist(level,c,q)<(level<1 ? hm_radius : hx_radius)*0.22 ? (c[0]=0;h_merges+=1;);j+=1;);i+=1;
      );
      i=0;loop(h_k(level),c=h_cl(level,i);c[1]=0;c[2]=0;c[3]=-1;c[4]=0;c[5]=0;c[6]=0;c[7]=0;c[8]=0;c[9]=0;c[10]=0;c[11]=0;c[12]=0;c[13]=0;c[15]=0;i+=1;);
      h_phase=level<1 ? 6 : 12;h_cursor=0;h_finalize_stage=0;h_cleanup_done=0;
    );
  );
);
function h_softlink(level p prev) local(a b ca cb wt z) (
  a=0;loop(3,ca=prev[6+a];b=0;loop(3,cb=p[6+b];wt=prev[9+a]*p[9+b];
    ca>=0 && cb>=0 && wt>0 ? (
      z=h_link(level,ca,cb);z[0]+=wt;z[1]+=wt*p[4];
      // Last source starts at -1; multiple transitions in one file are not
      // presented as independent source support.
      h_ls=h_order+(level<1 ? ca*48+cb : 2304+ca*24+cb);
      h_ls[0]!=p[0]+1 ? (h_ls[0]=p[0]+1;z[2]+=1;h_link_sources+=1;);
    );b+=1;);a+=1;);
);
function h_class_cleanup(level) (
  // v0.9.2: specialness is evidence scarcity/isolation, not silence or error. Near-duplicate
  // prototypes were already handled during refinement; preserve singleton ECs.
  0;
);
// State is only active / structural REST / retired. "Specialness" is a
// continuous property in c[12], never a separate behavioural category.
function h_class_state(level) local(i j c q nearest radius scarcity source_scarcity isolation special d) (
  radius=max(0.000001,level<1 ? hm_radius : hx_radius);i=0;loop(h_k(level),c=h_cl(level,i);
    c[6]<1 ? (c[11]=3;c[12]=0;c[0]=0;) : (
      nearest=1000;j=0;loop(h_k(level),q=h_cl(level,j);j!=i && q[0]>0 ? (d=h_dist(level,c,q);nearest=min(nearest,d););j+=1;);
      isolation=nearest<999 ? cp_01(nearest/(radius*1.5)) : 0;
      scarcity=1/sqrt(max(1,c[6]));source_scarcity=1/sqrt(max(1,c[2]));
      special=cp_01(0.45*scarcity+0.20*source_scarcity+0.35*isolation);c[12]=special;
      c[11]=level>=1 && c[117]>=0.82 ? 2 : 0;
    );i+=1;
  );
);
function h_finalize_step(level) local(j p q c i wt prev n off list id z d best err) (
  list=h_list(level);j=0;
  h_finalize_stage==0 ? (
    while(j<4 && h_cursor<h_n(level)) (
      p=h_ep(level,h_cursor);h_nearest(level,p);h_assign(p);i=0;
      loop(3,id=p[6+i];wt=p[9+i];id>=0 && wt>0 ? (
        c=h_cl(level,id);c[1]+=wt;c[4]+=wt*p[4];c[5]+=wt*p[4]*p[4];
        c[3]!=p[0] ? (c[2]+=1;c[3]=p[0];);
      );i+=1;);
      p[6]>=0 ? (c=h_cl(level,p[6]);c[6]+=1;
        // c[10] counts members with actual acoustic activity. Meso always
        // remains an acoustic-behaviour class; Macro rest is decided separately.
        (level<1 || p[117]<0.5) ? c[10]+=1;
        c[6]==1 || p[12]<c[15] ? (c[14]=h_cursor;c[15]=p[12];);
      );
      h_cursor>0 ? (
        prev=h_ep(level,h_cursor-1);
        // Only real consecutive source chronology. Excluded gaps and file
        // boundaries never become learned transitions.
        prev[0]==p[0] && abs((prev[3]+prev[4])-p[3])<0.000001 && (p[5]&8)==0 ? (
          h_softlink(level,p,prev);level<1 ? hm_transitions+=1 : hx_transitions+=1;
        );
      );h_cursor+=1;j+=1;
    );
    h_cursor>=h_n(level) ? (
      !h_cleanup_done && h_class_cleanup(level)>0 ? (
        h_cleanup_done=1;h_cursor=0;i=0;
        loop(h_k(level),c=h_cl(level,i);c[1]=0;c[2]=0;c[3]=-1;c[4]=0;c[5]=0;c[6]=0;c[10]=0;c[15]=0;i+=1;);
        level<1 ? (memset(hm_links,0,6912);hm_transitions=0;) : (memset(hx_links,0,1728);hx_transitions=0;);
        memset(h_order,0,2880);
      ) : (
        h_class_state(level);off=0;i=0;loop(h_k(level),c=h_cl(level,i);c[7]=off;c[8]=0;off+=c[6];i+=1;);
        h_cursor=0;h_finalize_stage=1;
      );
    );
  ) : (
    while(j<128 && h_cursor<h_n(level)) (
      p=h_ep(level,h_cursor);p[6]>=0 ? (c=h_cl(level,p[6]);list[c[7]+c[8]]=h_cursor;c[8]+=1;);
      h_cursor+=1;j+=1;
    );
    h_cursor>=h_n(level) ? (
      i=0;loop(h_k(level),c=h_cl(level,i);c[1]>0 ? (c[4]/=c[1];c[5]=sqrt(max(0,c[5]/c[1]-c[4]*c[4])););i+=1;);
      level<1 ? (h_phase=7;h_cursor=0;h_xsource=0;h_xopen=0;h_xscan=0;h_xcount=0;) : (
        h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=0;h_ui_dirty=1;
      );
    );
  );
);
// Change score compares bounded left/right neighbourhood means, variation and
// signed evolution. Index tiles set the finest possible boundary resolution.
function h_change_at(id) local(g p i d nl nr lm rm lv rv ls rs z score a b) (
  g=cp_g(id);score=0;nl=0;nr=0;
  id<=0 ? 0 : (
    p=cp_g(id-1);
    p[1]!=g[1] || !h_observed(id) || !h_observed(id-1) ? 1 : (
      // Low-salience changes are ordinary acoustic evidence. Their Energy/Motion
      // descriptors may create a boundary naturally, but there is no REST edge.
      d=0;loop(8,lm=0;rm=0;lv=0;rv=0;nl=0;nr=0;ls=0;rs=0;i=0;
        loop(3,
          a=id-1-i;b=id+i;
          a>=0 ? (p=cp_g(a);p[1]==g[1] && h_observed(a) ? (z=cp_feat(a,d);lm+=z;lv+=z*z;nl+=1;i==0 ? ls=z;i==2 ? ls-=z;););
          b<grain_count ? (p=cp_g(b);p[1]==g[1] && h_observed(b) ? (z=cp_feat(b,d);rm+=z;rv+=z*z;nr+=1;i==0 ? rs=-z;i==2 ? rs+=z;););
          i+=1;
        );
        lm/=max(1,nl);rm/=max(1,nr);lv=max(0,lv/max(1,nl)-lm*lm);rv=max(0,rv/max(1,nr)-rm*rm);
        score+=(0.75*abs(lm-rm)+0.15*abs(sqrt(lv)-sqrt(rv))+0.10*abs(ls-rs))*(d==0 || d==3 || d==4 ? 1.4 : 1);d+=1;
      );score/9.2+(xc_ready && xc_params[0]>0.5 ? 0.30*xc_distance(id-1,id,1) : 0);
    );
  );
);
function h_meso_finish() local(p g n d i b f t lo hi j q wt target total prev a delta dt active onset den floorv k) (
  h_mopen && hm_n<8192 ? (
    g=cp_g(h_mstart);floorv=h_meso_floor(g[1]);
    // Sub-150 ms observations remain Micro evidence. They are too short to
    // become first-class behavioural ECs even when they are acoustically gold.
    h_mseconds<0.15 ? (
      k=h_mstart;while(k<h_mend)(hm_grainmap[k]=-1;k+=1;);h_micro_only_short+=1;h_mopen=0;
    ) : (
    p=h_m(hm_n);n=h_mend-h_mstart;
    p[0]=g[1];p[1]=h_mstart;p[2]=n;p[3]=g[2]/g[4];p[4]=h_mseconds;p[5]=h_mflags;p[13]=-1;
    p[6]=-1;p[7]=-1;p[8]=-1;
    d=0;loop(24,p[16+d]/=max(0.000000001,h_mseconds);d+=1;);
    d=0;loop(8,p[40+d]/=max(1,h_mtrans);p[48+d]/=max(1,h_mtrans);d+=1;);
    d=0;loop(4,p[56+d]/=max(0.000000001,h_mseconds);d+=1;);
    p[60]/=max(0.000000001,h_mseconds);p[61]=1-p[60];
    p[62]=cp_01(log(1+h_mseconds)/log(61));p[63]=1-exp(-h_monsets/max(0.000001,h_mseconds)*0.08);
    // Four actual chronological control points, not a class centroid. Each
    // uses the indexed grain at its time; no new PCM scan in this stage.
    d=0;loop(4,
      j=h_mstart+min(n-1,floor((d+0.5)*n/4));i=0;loop(8,p[64+d*8+i]=cp_feat(j,i);i+=1;);d+=1;
    );q=h_src(g[1]);q[1]+=1;
    xc_ready ? xc_hsummary(0,hm_n);hm_n+=1;h_mopen=0;
    );
  );
);
function h_meso_add(id) local(g p prev d b v dt delta) (
  g=cp_g(id);p=h_m(hm_n);dt=g[3]/max(1,g[4]);h_mseconds+=dt;
  d=0;loop(8,v=cp_feat(id,d);b=0;loop(3,p[16+d*3+b]+=max(0,1-abs(2*v-b))*dt;b+=1;);
    id>h_mstart ? (
      delta=v-cp_feat(id-1,d);p[40+d]+=delta;p[48+d]+=abs(delta);
    );d+=1;
  );
  d=0;loop(4,p[56+d]+=g[41+d]*dt;d+=1;);
  // Meso learns density/salience continuously; it never owns a hard REST state.
  p[60]+=h_salience(id)*dt;
  g[20]>=0.55 && h_salience(id)>0.28 ? h_monsets+=1;
  id>h_mstart ? h_mtrans+=1;
  hm_grainmap[id]=hm_n;h_mend=id+1;
);
function h_begin() local(i p) (
  xc_grammar_ready=0;xc_grammar_epoch=-1;xc_post_phase=0;xc_map_ready=0;xc_map_phase=0;h_ready=0;h_phase=0;h_epoch=-1;h_status=0;hm_n=0;hx_n=0;hm_k=0;hx_k=0;
  hm_transitions=0;hx_transitions=0;h_merges=0;h_cluster_cap=0;h_link_sources=0;h_coarsened=0;
  h_excluded=0;h_empty_classes=0;h_macro_singletons=0;h_coverage_lost=0;h_macro_lost=0;h_macro_gap_n=0;h_micro_only_short=0;h_mopen=0;h_msource=-1;h_cursor=0;h_rest_seconds=0;
  h_sensitive=cp_01(slider60);h_detail=cp_01(slider63);h_rest_db=slider61;h_rest_amp=cp_amp(h_rest_db);
  // Model-local EC IDs can change after a rebuild; never replay stale class
  // labels as though they belonged to the new hierarchy.
  record_n=0;record_done=0;record_event=-1;trace_n=0;trace_head=-1;
  h_ui_m=-1;h_ui_x=-1;h_ui_class=-1;h_ui_level=0;h_ui_compare=-1;h_ui_page=0;h_ui_memberpage=0;h_ui_pin=-1;
  memset(h_state,0,768);memset(hm_grainmap,-1,grain_count);memset(h_change,0,grain_count);
  memset(hm_classes,0,4608);memset(hx_classes,0,3072);memset(hm_links,0,6912);memset(hx_links,0,1728);
  memset(h_hist,0,128);memset(h_order,0,2880);memset(h_sources,0,source_count*4);
  i=0;loop(source_count,p=h_src(i);p[0]=-1;p[2]=-1;i+=1;);
  0 ? h_status=1 : (
    grain_count<1 ? h_status=2 : (
      source_count>8192 ? h_status=3 : (
        h_phase=1;
        // Remaining slots are reserved for remaining sources. Larger tile
        // groups coarsen chronology instead of cutting off the file end.
        h_min_meso=max(0,total_seconds/max(1,8192-source_count)*1.05);
      );
    );
  );
);
function h_meso_scan_step() local(j id g p score boundary limit remain need flags bin sum q floorv) (
  j=0;
  while(j<64 && h_cursor<grain_count) (
    id=h_cursor;g=cp_g(id);
    h_msource!=g[1] ? (
      h_meso_finish();h_msource=g[1];p=h_src(h_msource);p[0]=hm_n;h_msource_start=hm_n;
    );
    !h_observed(id) ? (h_meso_finish();h_excluded+=1;) : (
      boundary=0;flags=0;
      h_mopen ? (
        p=cp_g(id-1);
        score=h_change[id];
        score>=h_boundary && score>=h_change[max(0,id-1)] && (id+1>=grain_count || score>h_change[id+1]) ? (boundary=1;flags=2;);
        // Low-salience transitions are descriptive Meso evidence, NOT boundaries
        // and never instructions to mute. Stable regimes are bounded only for analysis.
        floorv=max(h_min_meso,h_meso_floor(g[1]));
        h_mseconds>=max(12,floorv*6) ? (boundary=1;flags=8;);
        h_mseconds<floorv ? (boundary=0;h_coarsened+=1;);
        remain=8192-hm_n;need=source_count-h_msource;
        remain<=need ? (boundary=0;h_coarsened+=1;);
        boundary ? h_meso_finish();
      );
      !h_mopen && hm_n<8192 ? (
        h_mstart=id;h_mend=id;h_mseconds=0;h_mtrans=0;h_monsets=0;h_mflags=flags;
        p=h_m(hm_n);memset(p,0,96);h_mopen=1;
      );
      h_mopen ? h_meso_add(id) : h_coverage_lost+=1;
      h_lowsalience(id) ? h_rest_seconds+=g[3]/g[4];
    );h_cursor+=1;j+=1;
  );
  h_cursor>=grain_count ? (
    h_meso_finish();h_coverage_lost>0 ? (h_phase=0;h_status=6;) : (hm_n>0 ? (h_phase=3;h_calibrate_start(0);) : (h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=2;));
  );
);
function h_macro_gap(src start seconds anchor) local(p q) (
  // A chronological hole can become REST only here, at Macro scale. Short
  // gaps remain sparsity and are bridged by the active generator.
  seconds>=0.45 && hx_n<1024 ? (
    p=h_x(hx_n);memset(p,0,128);p[0]=src;p[1]=max(0,anchor);p[2]=0;p[3]=start;p[4]=seconds;p[5]=32;
    p[6]=-1;p[7]=-1;p[8]=-1;p[112]=0;p[113]=1;p[114]=cp_01(log(1+seconds)/log(601));
    p[115]=0;p[116]=1;p[117]=1;p[118]=0;p[119]=1;
    q=h_src(src);q[2]<0 ? q[2]=hx_n;q[3]+=1;xc_ready ? xc_hsummary(1,hx_n);hx_n+=1;h_macro_gap_n+=1;
  );
);
function h_macro_finish() local(p m q d i wt first last mid n val lo hi) (
  h_xopen && hx_n<1024 ? (
    n=h_xend-h_xstart;
    // Active singleton Meso episodes are not Macro regimes. A single episode
    // may become Macro REST only after passing the strict Macro rest-evidence gate.
    m=h_m(h_xstart);
    n>=2 || (n==1 && h_macro_rest_seed(m)) ? (
      p=h_x(hx_n);p[0]=m[0];p[1]=h_xstart;p[2]=n;p[3]=m[3];p[4]=h_xseconds;p[5]=h_xflags;
      p[6]=-1;p[7]=-1;p[8]=-1;
      d=0;loop(48,p[16+d]/=max(0.000001,h_xseconds);d+=1;);
      p[112]/=max(0.000001,h_xseconds);p[113]=1-p[112];p[114]=cp_01(log(1+h_xseconds)/log(601));
      p[115]=1-exp(-max(0,n-1)/max(0.000001,h_xseconds)*0.25);
      p[118]=0;d=0;loop(48,val=p[16+d];val>0 ? p[118]-=val*log(val)/log(48);d+=1;);
      d=0;loop(8,p[120+d]/=max(0.000001,h_xseconds);d+=1;);
      // Structural REST exists ONLY at Macro scale, and only with converging
      // evidence: long duration, very low salience, energy, motion, onset and
      // internal transition activity. Quiet/rare Micro or Meso material cannot
      // directly create a mute instruction.
      p[116]=cp_01((p[4]-0.45)/0.75)
        *cp_01((0.20-p[112])/0.20)
        *cp_01((0.14-p[120])/0.14)
        *cp_01((0.14-p[123])/0.14)
        *cp_01((0.12-p[124])/0.12)
        *cp_01((0.28-p[115])/0.28);
      p[117]=p[4]>=0.45 && p[116]>=0.82;
      p[119]=cp_01((0.60-p[112])/0.60)*(1-p[117]);
      // Ordered beginning/end class distributions distinguish equal-occupancy
      // sections with opposite evolution. Members retain the complete sequence.
      lo=max(1,ceil(n/3));i=0;
      loop(lo,
        first=h_m(h_xstart+i);last=h_m(h_xend-1-i);d=0;loop(3,
          first[6+d]>=0 ? p[64+first[6+d]]-=first[9+d]/lo;
          last[6+d]>=0 ? p[64+last[6+d]]+=last[9+d]/lo;d+=1;
        );i+=1;
      );
      q=h_src(p[0]);q[2]<0 ? q[2]=hx_n;q[3]+=1;
      i=h_xstart;loop(n,m=h_m(i);m[13]=hx_n;i+=1;);xc_ready ? xc_hsummary(1,hx_n);hx_n+=1;
    ) : (
      // Not silently called a macro class; meso fallback remains available.
      h_macro_singletons+=1;
    );h_xopen=0;
  );
);
function h_macro_change(id) local(p q i j a b total na nb x) (
  p=h_m(id);memset(h_aux,0,96);na=0;nb=0;i=0;
  loop(3,a=id-1-i;b=id+i;
    a>=0 ? (q=h_m(a);q[0]==p[0] ? (j=0;loop(3,q[6+j]>=0 ? h_aux[q[6+j]]+=q[9+j];j+=1;);na+=1;););
    b<hm_n ? (q=h_m(b);q[0]==p[0] ? (j=0;loop(3,q[6+j]>=0 ? h_aux[48+q[6+j]]+=q[9+j];j+=1;);nb+=1;););
    i+=1;
  );total=0;i=0;loop(48,x=sqrt(h_aux[i]/max(1,na))-sqrt(h_aux[48+i]/max(1,nb));total+=x*x;i+=1;);x=sqrt(total*0.5);
  xc_ready && xc_params[0]>0.5 && xc_params[6]>0 && p[2]>0 && xc_g(p[1])[110]>=0 ? max(x,xc_coarse[xc_g(p[1])[110]*48+35]*xc_params[6]) : x;
);
function h_macro_step() local(j p q x boundary d wt id remain sourcesleft i flags gap) (
  j=0;
  while(j<32 && h_cursor<hm_n) (
    id=h_cursor;p=h_m(id);boundary=0;flags=0;
    h_xopen ? (
      q=h_m(id-1);gap=p[3]-(q[3]+q[4]);
      q[0]!=p[0] ? (
        boundary=1;
      ) : (
        gap>0.000001 ? (
          // Close the active Macro regime first. A long unobserved source gap
          // is represented explicitly as Macro REST; a short one is sparsity.
          h_macro_finish();
          gap>=0.45 ? h_macro_gap(p[0],q[3]+q[4],gap,id);
          boundary=0;
        ) : (
          // Only Macro consumes strict rest evidence. Split around a candidate
          // so a genuine pause is not averaged into an active regime.
          h_macro_rest_seed(p)!=h_macro_rest_seed(q) ? (boundary=1;flags=16;) : (
            id-h_xstart>=3 && h_xseconds>=max(0.5,h_min_macro) ? (
              x=h_macro_change(id);x>0.72-0.30*h_sensitive ? boundary=1;
            );
          );
          h_xseconds>=max(45,h_min_macro*2) ? (boundary=1;flags=8;);
          // Preserve room for one macro per later source; excessive file counts
          // disable macro only, rather than corrupting or truncating micro data.
          remain=1024-hx_n;sourcesleft=min(source_count,1024)-p[0];
          remain<=max(1,sourcesleft) && q[0]==p[0] ? boundary=0;
        );
      );
      boundary ? h_macro_finish();
    );
    !h_xopen && hx_n<1024 ? (
      h_xstart=id;h_xend=id;h_xseconds=0;h_xflags=flags;h_xopen=1;memset(h_x(hx_n),0,128);
    );
    h_xopen ? (
      q=h_x(hx_n);d=0;loop(3,p[6+d]>=0 ? q[16+p[6+d]]+=p[9+d]*p[4];d+=1;);
      q[112]+=p[60]*p[4];d=0;loop(8,q[120+d]+=h_mean(p,d)*p[4];d+=1;);
      h_xseconds+=p[4];h_xend=id+1;
    ) : h_macro_lost+=1;h_cursor+=1;j+=1;
  );
  h_cursor>=hm_n ? (
    h_macro_finish();h_macro_lost>0 ? (
      hx_n=0;hx_k=0;i=0;loop(source_count,q=h_src(i);q[2]=-1;q[3]=0;i+=1;);
      i=0;loop(hm_n,q=h_m(i);q[13]=-1;i+=1;);
      h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=7;
    ) : (hx_n>0 ? (h_phase=9;h_calibrate_start(1);) : (h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=4;));
  );
);
function h_build() local(i score bin sum j q) (
  h_phase==1 ? (
    i=0;while(i<32 && h_cursor<grain_count)(
      score=h_change_at(h_cursor);h_change[h_cursor]=score;bin=floor(cp_clamp(score*127,0,127));h_hist[bin]+=1;h_cursor+=1;i+=1;
    );
    h_cursor>=grain_count ? (
      sum=0;j=0;q=0;while(j<128 && sum<max(1,grain_count*0.65))(sum+=h_hist[j];q=j;j+=1;);
      h_boundary=cp_clamp((q/127)*(1.9-1.0*h_sensitive),0.035,0.28);
      h_phase=2;h_cursor=0;
    );
  ) : (
    h_phase==2 ? h_meso_scan_step() : (
      h_phase==3 || h_phase==9 ? h_calibrate_step(h_phase==3 ? 0 : 1) : (
        h_phase==4 || h_phase==10 ? h_leader_step(h_phase==4 ? 0 : 1) : (
          h_phase==5 || h_phase==11 ? h_refine_step(h_phase==5 ? 0 : 1) : (
            h_phase==6 || h_phase==12 ? h_finalize_step(h_phase==6 ? 0 : 1) : (
              h_phase==7 ? (
                source_count>1024 ? (h_phase=0;h_ready=1;h_epoch=index_epoch;h_status=5;) : (
                  h_min_macro=total_seconds/max(1,1024-source_count)*1.05;h_macro_step();
                );
              );
            );
          );
        );
      );
    );
  );
);

// ---------------- Bounded hierarchical performance controller ----------------
function h_lower(list lo hi key) local(mid) (
  while(lo<hi)(mid=floor((lo+hi)/2);list[mid]<key ? lo=mid+1 : hi=mid;);lo;
);
function h_class_range(level cls src) local(c lo hi s list) (
  h_range_lo=0;h_range_hi=0;
  cls>=0 && cls<h_k(level) ? (
    c=h_cl(level,cls);lo=c[7];hi=lo+c[6];list=h_list(level);
    src>0 ? (src<=source_count ? (
      s=h_src(src-1);
      level<1 ? (h_range_start=s[0];h_range_end=s[0]+s[1];) : (h_range_start=s[2];h_range_end=s[2]+s[3];);
      h_range_start>=0 ? (lo=h_lower(list,lo,hi,h_range_start);hi=h_lower(list,lo,hi,h_range_end);) : hi=lo;
    ) : hi=lo;);
    h_range_lo=lo;h_range_hi=hi;
  );h_range_hi-h_range_lo;
);
function h_allowed(level cls initial) local(c) (
  cls<0 || cls>=h_k(level) ? 0 : (
    c=h_cl(level,cls);
    // All active acoustic ECs are valid, including highly special ones.
    // Structural REST is permitted only as an observed Macro continuation.
    c[11]==0 || (c[11]==2 && !initial && level>=1);
  );
);
function h_auto_mode(src) local(i n m c) (
  n=0;m=0;i=0;loop(hm_k,c=h_cl(0,i);c[11]==0 && h_class_range(0,i,src)>0 ? n+=1;i+=1;);
  i=0;loop(hx_k,c=h_cl(1,i);c[11]==0 && h_class_range(1,i,src)>0 ? m+=1;i+=1;);
  m>0 && n>0 ? 3 : (n>0 ? 2 : 0);
);
function h_live_model() local(i e q n) (
  i=0;n=0;loop(8,e=cp_e(i);q=h_state+i*96;e[0]>0 && q[0]==e[1] && q[1]>=2 ? n+=1;i+=1;);n;
);
function xc_gram_slot(level a b c create) local(hash i p slot found) (
  hash=(a*1369+b*37+c+level*251)%1024;i=0;found=-1;
  while(i<8 && found<0)(slot=(hash+i)%1024;p=xc_grammar+slot*6;
    p[4]<=0 ? (create ? (p[0]=level;p[1]=a;p[2]=b;p[3]=c;found=slot;);i=8;) : (
      p[0]==level && p[1]==a && p[2]==b && p[3]==c ? found=slot;
    );i+=1;
  );found;
);

function xc_second_order(level a b c) local(slot p) (
  slot=a>=0 && b>=0 && c>=0 ? xc_gram_slot(level,a,b,c,0) : -1;
  slot>=0 ? (p=xc_grammar+slot*6;p[4];) : 0;
);

function h_pick_member(level cls src q freedom avoid) local(c list n lo j i id p cost value sum chosen best bestcost) (
  chosen=-1;n=h_class_range(level,cls,src);lo=h_range_lo;list=h_list(level);
  n>0 ? (
    c=h_cl(level,cls);bestcost=100;best=-1;sum=0;j=0;
    // Fixed evenly spaced probes plus the medoid; work does not grow with bank.
    h_probe_seed=h_rnd(q);
    loop(min(16,n),i=lo+min(n-1,floor((j+h_probe_seed)*n/max(1,min(16,n))));id=list[i];p=h_ep(level,id);
      cost=h_dist(level,p,c)+(id==avoid ? 0.05*freedom : 0);
      cost<bestcost ? (bestcost=cost;best=id;);
      value=exp(-cost/max(0.01,0.01+freedom*0.18));sum+=value;h_rnd(q)*sum<value ? chosen=id;
      j+=1;
    );freedom<=0.0001 ? chosen=best;
  );chosen;
);
function h_pick_class(level prev src q w freedom) local(k i c z mass total fit d value chosen best bestval means count rowmass specialprior secondtotal second older)
(
  chosen=-1;best=-1;bestval=-1;total=0;rowmass=0;i=0;k=h_k(level);
  prev>=0 && prev<k ? loop(k,h_allowed(level,i,0) && h_class_range(level,i,src)>0 ? (z=h_link(level,prev,i);rowmass+=z[0];);i+=1;);
  prev>=0 && rowmass<=0.00001 ? (q[17]+=1;h_runtime_backoff+=1;);
  secondtotal=0;older=level<1 ? q[80] : q[81];
  xc_grammar_ready && xc_params[9]>0 && older>=0 && prev>=0 ? (i=0;loop(k,
    h_allowed(level,i,0) && h_class_range(level,i,src)>0 ? secondtotal+=xc_second_order(level,older,prev,i);i+=1;
  ););
  i=0;loop(k,c=h_cl(level,i);
    c[1]>0 && h_allowed(level,i,prev<0) && h_class_range(level,i,src)>0 ? (
      fit=0;d=0;loop(8,
        means=level<1 ? h_mean(c,d) : c[120+d];
        fit+=abs(means-w[16+d])*(d==0 || d==4 ? 0.25 : 1);d+=1;
      );
      mass=c[1];rowmass>0 ? (z=h_link(level,prev,i);mass=z[0];);
      // Unobserved transitions have no invented statistical support. If an
      // observed row has no eligible successor, report a backoff before using
      // occupancy; otherwise preserve its observed support.
      secondtotal>0 ? mass=mass*(1-xc_params[9])+max(1,rowmass)*xc_params[9]*xc_second_order(level,older,prev,i)/secondtotal;
      specialprior=exp(-c[12]*(0.05+0.35*(1-slider34)));
      value=mass*exp(-fit/max(0.06,0.1+0.8*freedom))*specialprior;
      value>bestval ? (bestval=value;best=i;);
      total+=value;value>0 && h_rnd(q)*total<value ? chosen=i;
    );i+=1;
  );freedom<=0.0001 ? chosen=best;chosen;
);
function h_at_time(src seconds) local(s lo hi mid p result) (
  result=-1;
  src>=0 && src<source_count ? (
    s=h_src(src);lo=s[0];hi=lo+s[1];
    lo>=0 && s[1]>0 ? (
      while(lo<hi)(mid=floor((lo+hi)/2);p=h_m(mid);p[3]+p[4]<=seconds ? lo=mid+1 : hi=mid;);
      lo<s[0]+s[1] ? (p=h_m(lo);seconds>=p[3] && seconds<p[3]+p[4] ? result=lo;);
    );
  );result;
);
function h_macro_at_time(src seconds) local(s lo hi mid p result) (
  result=-1;
  src>=0 && src<source_count ? (
    s=h_src(src);lo=s[2];hi=lo+s[3];
    lo>=0 && s[3]>0 ? (
      while(lo<hi)(mid=floor((lo+hi)/2);p=h_x(mid);p[3]+p[4]<=seconds ? lo=mid+1 : hi=mid;);
      lo<s[2]+s[3] ? (p=h_x(lo);seconds>=p[3] && seconds<p[3]+p[4] ? result=lo;);
    );
  );result;
);
// ---------- Sparse second-order grammar / duration and termination evidence ----------
function xc_post_begin() (
  xc_grammar_ready=0;xc_post_phase=1;xc_post_cursor=0;xc_grammar_epoch=index_epoch;xc_grammar_overflow=0;xc_terminal_examples=0;xc_triples=0;
  memset(xc_grammar,0,6144);memset(xc_dwell,0,1152);memset(xc_endstats,0,288);memset(xc_states,0,512);
);
function xc_closed_pause(p) local(source next end at q i g valid seen maxpeak reached) (
  // Only fully checked INTERNAL intervals support a learned ending. File ends
  // and excluded/partially inspected gaps cannot become positive examples.
  source=p[0];at=p[3]+p[4];end=-1;next=h_macro_at_time(source,at+0.00001);
  next>=0 ? (q=h_x(next);q[117]>0.5 && q[4]>=0.45 ? end=q[3]+q[4];);
  valid=0;
  end>at+0.40 ? (
    q=cp_s(source);end<q[2]/q[3]-0.01 ? (
      i=q[5]+floor(at*q[3]/max(1,q[2])*q[6]);
      i<q[5]+q[6] ? (g=cp_g(i);(g[2]+g[3])/g[4]<=at+0.000001 ? i+=1;);
      seen=0;maxpeak=0;valid=1;reached=0;
      while(i<q[5]+q[6] && seen<512 && !reached)(g=cp_g(i);
        g[2]/g[4]>=end-0.000001 ? reached=1 : (
          g[9]>0.5 ? valid=0;maxpeak=max(maxpeak,g[7]);seen+=1;i+=1;
        );
      );!reached || maxpeak>max(0.00001,q[7]*0.0001) ? valid=0;
    );
  );valid;
);
function xc_grammar_one(level id) local(p prev prev2 q idx bin slot z endprob) (
  p=h_ep(level,id);idx=p[6]+level*48;
  p[6]>=0 && p[6]<h_k(level) ? (
    bin=cp_clamp(floor(log(max(0.02,p[4])/0.02)/log(2)),0,15);xc_dwell[idx*16+bin]+=1;
    z=xc_endstats+idx*4;z[0]+=1;z[2]+=p[4];
    endprob=xc_closed_pause(p);
    endprob ? (z[1]+=1;xc_terminal_examples+=1;);z[3]=z[0]>0 ? z[1]/(z[0]+2) : 0;
  );
  id>=2 ? (
    prev=h_ep(level,id-1);prev2=h_ep(level,id-2);
    p[0]==prev[0] && p[0]==prev2[0] && abs(prev[3]+prev[4]-p[3])<0.000001 && abs(prev2[3]+prev2[4]-prev[3])<0.000001 && p[6]>=0 && prev[6]>=0 && prev2[6]>=0 ? (
      slot=xc_gram_slot(level,prev2[6],prev[6],p[6],1);
      slot>=0 ? (q=xc_grammar+slot*6;q[4]+=1;q[5]=p[0];xc_triples+=1;) : xc_grammar_overflow+=1;
    );
  );
);
// Transfer map: guide episodes -> up to four target episodes. The structural
// metric deliberately omits absolute timbre/chroma. Strict source exclusion is
// applied independently at every Micro candidate route, not just this map.
function xc_map_begin() (
  xc_map_ready=0;xc_map_phase=1;xc_map_cursor=0;xc_map_source=cp_clamp(floor(slider64)-1,0,max(0,source_count-1));
  xc_map_target=floor(slider14);xc_map_count=0;xc_map_unmatched=0;xc_map_epoch=index_epoch;xc_map_costsum=0;
);
function xc_map_one(id) local(p q z k j n start count idx cost best cls list lo ci exists m i)
(
  p=h_m(id);z=xc_maps+id*12;memset(z,-1,12);i=0;loop(4,z[4+i]=100;i+=1;);
  p[0]==xc_map_source ? (
    // A deterministic bounded candidate set: complete for small corpora, class
    // representatives + evenly spread members for larger ones. No N^2 table.
    xc_pool_n=0;count=min(128,hm_n);j=0;
    loop(count,idx=min(hm_n-1,floor((j+0.5)*hm_n/max(1,count)));xc_pool[xc_pool_n]=idx;xc_pool_n+=1;j+=1;);
    ci=0;loop(hm_k,n=h_class_range(0,ci,xc_map_target);lo=h_range_lo;list=h_list(0);j=0;
      loop(min(2,n),idx=list[lo+min(n-1,floor((j+0.5)*n/max(1,min(2,n))))];
