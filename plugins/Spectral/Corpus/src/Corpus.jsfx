      cost=h_dist(level,p,c)+(id==avoid ? 0.05*freedom : 0);
      cost<bestcost ? (bestcost=cost;best=id;);
      value=exp(-cost/max(0.01,0.01+freedom*0.18));sum+=value;h_rnd(q)*sum<value ? chosen=id;
      j+=1;
    );freedom<=0.0001 ? chosen=best;
  );chosen;
