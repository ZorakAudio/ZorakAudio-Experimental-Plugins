      a_inburst>=a_burst_count ? cp_finish_bin();
      a_bin>=16 ? cp_finish_tile();
    );
    grain_count>=tile_total ? (cp_merge_begin();build_phase=7;);
  );
  build_phase==7 ? cp_merge_step(work);
  build_phase==8 ? (cp_quantiles();norm_cursor=0;build_phase=4;apply_saved_edits=1;);
  build_phase==4 ? (
