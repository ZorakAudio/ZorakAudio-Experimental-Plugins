      h=min(156,max(80,ceil(strlen(#ui_tooltip)/max(12,floor((w-24)/7.5)))*21+28));
      y=mouse_y+22;y+h>gfx_h-26 ? y=max(8,mouse_y-h-12);
      ui_box(x,y,w,h,0.115,0.16,0.195);ui_border(x,y,w,h,0.32,0.55,0.57);ui_wrap(x+12,y+12,w-24,#ui_tooltip,max(2,floor((h-20)/21)));
    );
  );
);

