    );i+=1;
  );freedom<=0.0001 ? chosen=best;chosen;
);
function h_at_time(src seconds) local(s lo hi mid p result) (
  result=-1;
  src>=0 && src<source_count ? (
    s=h_src(src);lo=s[0];hi=lo+s[1];
    lo>=0 && s[1]>0 ? (
