      q=xc_next(bestid);(pe_active_request() ? xc_allowed(q,floor(slider14),xc_runtime_transfer,xc_runtime_guide) : cp_valid(q)) ? best2=min(best2,tr_penalty(q,u+du*2));
    );
  );
