  by=axisy<8 ? target_base[axisy] : (w[5]>=0 && cp_valid(w[5]) ? cp_desc(w[5],axisy) : 0.5);
  map_target_x=bx*(1-slider44)+slider42*slider44;map_target_y=by*(1-slider44)+slider43*slider44;
