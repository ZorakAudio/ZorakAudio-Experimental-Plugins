  best=-1;w0=0;m0=0;sum=0;i=0;loop(128,sum+=i*scout_hist[i];i+=1;);split=0;low=-120;
  i=0;loop(127,
    w0+=scout_hist[i];m0+=i*scout_hist[i];w1=scout_n-w0;
    w0>0 && w1>0 ? (
      m1=(sum-m0)/w1;sep=m1-m0/w0;totalvar=w0*w1*sep*sep/max(1,scout_n*scout_n);
      totalvar>best ? (best=totalvar;split=i;low=m0/w0-120;);
    );i+=1;
  );
  threshold=high-42;
  high-low>24 && best>8 ? threshold=max(threshold,min(high-24,low+6));
  high>-100 ? threshold=cp_clamp(threshold,-96,min(-42,high-18)) : threshold=-96;
  a[1]=threshold;a[2]=cp_amp(high);a[6]=scout_step;a[7]=scout_n;
  ref=max(cp_amp(high),s[7]*0.10);
  a[5]=s[7]>0.00001 ? cp_clamp(0.16/max(0.00001,ref),0.5,16) : 1;
  // Stable material gets a larger window. Repeated changes shorten it.
  // Derivatives compare neighbouring probe summaries, never waveform phase.
  memset(scout_hist,0,128);i=1;run=0;changes=0;intervals=0;
  while(i<scout_n)(
    db=scout_data[i*4];delta=abs(db-scout_data[(i-1)*4]);
    sep=abs(scout_data[i*4+1]-scout_data[(i-1)*4+1]);
    max(db,scout_data[(i-1)*4])>threshold+6 && (delta>7 || sep>0.22) ? (
      changes>0 ? (
        idx=min(127,max(0,floor((i-run)*scout_step/0.01)));scout_hist[idx]+=1;intervals+=1;
      );changes+=1;run=i;
    );i+=1;
  );
  med=0.25;
  intervals>0 ? (i=0;cumulative=0;j=0;while(i<128 && cumulative<ceil(intervals*0.5))(cumulative+=scout_hist[i];j=i;i+=1;);med=max(0.01,j*0.01););
  // v1.4: this is an internal SENSOR aperture, not the final Micro grain.
  // Dense sources therefore keep enough evidence to discover boundaries without
  // forcing the final corpus onto the 40-60 ms grid.
  window=changes>=2 ? cp_clamp(med*0.35,0.04,0.10) : 0.08;
  s[2]/s[3]<0.32 ? window=min(window,max(0.04,s[2]/s[3]/4));
  conf=cp_01(0.04/max(0.01,scout_step));scout_n<4 ? conf*=0.25;
  conf<0.5 ? (window=window*conf+0.08*(1-conf);auto_scout_sparse+=1;);
  a[3]=conf;a[0]=window_setting<=0 ? window : window_request;
  auto_desired_cells+=max(1,ceil(s[2]/s[3]/max(0.04,a[0])));
  cp_fingerprint_add(a[0]*100000);cp_fingerprint_add(a[1]*100);cp_fingerprint_add(a[2]*100000);
  scout_source+=1;scout_started=0;
);
function cp_scout_step(work) local(s a lo hi start frame l r power diff n val b id maxwork) (
  maxwork=max(32,floor(work));
  while(maxwork>0 && scout_source<source_count)(
    s=cp_s(scout_source);
    !scout_started ? (
      scout_n=min(4096,max(1,ceil(s[2]/s[3]/0.010)));scout_step=s[2]/s[3]/scout_n;
      scout_probe=0;scout_in=0;scout_started=1;scout_sum=0;scout_diff=0;scout_peak=0;
      memset(scout_hist,0,128);memset(cp_auto(scout_source),0,8);
    );
    lo=floor(s[2]*scout_probe/scout_n);hi=floor(s[2]*(scout_probe+1)/scout_n);
    n=min(quality_request==0 ? 32 : (quality_request==2 ? 256 : 128),max(1,hi-lo));
    start=lo+floor(max(0,hi-lo-n)*0.5);frame=min(s[2]-1,start+scout_in);
    sample_read2(bank_pool,s[0],frame,l,r) ? (
      (!(l==l) || abs(l)>1000000) ? l=0;(!(r==r) || abs(r)>1000000) ? r=0;
    ) : (l=0;r=0;invalid_audio+=1;);
    source_mono ? (l=cp_fold(l,r);r=l;);
    power=(l*l+r*r)*0.5;scout_sum+=power;scout_peak=max(scout_peak,max(abs(l),abs(r)));
    scout_in>0 ? scout_diff+=((l-scout_l)^2+(r-scout_r)^2)*0.5;
    scout_l=l;scout_r=r;scout_in+=1;scout_reads+=1;maxwork-=1;
    scout_in>=n ? (
      val=sqrt(scout_sum/max(1,n));scout_data[scout_probe*4]=cp_db(val);
      scout_data[scout_probe*4+1]=log(1+20*sqrt(cp_01(scout_diff/max(0.000000000001,4*scout_sum))))/log(21);
      scout_data[scout_probe*4+2]=scout_peak;scout_data[scout_probe*4+3]=val;
      b=cp_clamp(floor(cp_db(val)+120),0,127);scout_hist[b]+=1;
      scout_probe+=1;scout_in=0;scout_sum=0;scout_diff=0;scout_peak=0;
      scout_probe>=scout_n ? cp_scout_finish();
    );
  );
  scout_source>=source_count ? (
    auto_budget_scale=min(1,max(0,grain_capacity-source_count)/max(1,auto_desired_cells-source_count));
    build_phase=2;layout_cursor=0;tile_total=0;
  );
);

function cp_begin() local(n cap avail)
(
  repeat_hold[0]=0;!repeat_after_prepare ? repeat_hold[6]=0;
  cg_cancel();cg_retry_key=generation+(floor(slider242)-1)*4194304+slider243*8388608+slider244*16777216+slider5+slider6*2048+slider21*16384+slider22*65536+slider61*0.001+slider60*524288+slider63*1048576+floor(slider69)*2097152;cg_failed_key!=cg_retry_key ? cg_disabled=0;
  xc_tasks_cancel();
  // Must only be called at a block boundary with no current/pending voices.
  pe_ready=0;pe_phase=0;pe_epoch=-1;pg_ready=0;pg_stage=0;pg_apply=0;pg_preview=0;pg_preview_pending=0;
  loaded_count=max(0,floor(sample_pool_loaded(bank_pool)));
  avail=max(65536,min(__memtop(),hm_episodes)-source_base-1024);
  h_ready=0;h_phase=0;h_status=0;xc_ready=0;xc_phase=0;xc_post_phase=0;xc_grammar_ready=0;xc_map_ready=0;xc_map_phase=0;
  source_capacity=min(65536,loaded_count);
  cap=4096*pow(2,floor(cp_clamp(slider6,0,4)));
  grain_capacity=min(65536,max(cap,source_capacity));
  grain_capacity=min(grain_capacity,floor((avail-source_capacity*8)/86));
  source_capacity=min(source_capacity,max(0,grain_capacity));
  grain_capacity=max(0,grain_capacity);
  grain_base=source_base+source_capacity*8+64;
  postings=grain_base+grain_capacity*64+64;
  source_count=0; meta_cursor=0; grain_count=0; tile_total=0; max_grain_seconds=0;
  total_seconds=0; ready=0; selected_id=-1; preview_id=-1;
  window_setting=slider5;window_request=slider5<=0 ? 0 : cp_clamp(slider5,30,1000)/1000;
  quiet_mode=floor(slider22);quiet_db=slider61;source_mono=cp_clamp(floor(slider69),0,1);
  passage_mode=cp_clamp(floor(slider242),0,2);passage_sensitivity=cp_01(slider243);passage_limit=max(0,slider244);passage_run=passage_mode==2 && window_setting<=0;
  memset(passage_work,0,64);
  passage_mode!=1 && window_setting<=0 ? (cp_fingerprint_add(2200+passage_mode);cp_fingerprint_add(passage_sensitivity*1000);cp_fingerprint_add(passage_limit*10););
  scout_source=0;scout_started=0;scout_reads=0;auto_quiet_n=0;auto_budget_coarsened=0;
  auto_window_min=1000000000;auto_window_max=0;auto_scout_sparse=0;auto_desired_cells=0;
  memset(path_res_counts,0,128);path_misses=0;
  budget_request=floor(slider6); quality_request=floor(slider21);
  burst_limit=quality_request==0 ? 16 : (quality_request==1 ? 64 : 128);
  corpus_key=900;cp_fingerprint_add(quiet_mode);cp_fingerprint_add(quiet_db*100); cp_fingerprint_add(window_request*1000); cp_fingerprint_add(grain_capacity); cp_fingerprint_add(quality_request);source_mono ? cp_fingerprint_add(19601);
  memset(hist,0,1024); memset(counts,0,29); memset(vertex_counts,0,29); memset(role_stats,0,16);
  invalid_sources=0; unindexed_sources=max(0,loaded_count-source_capacity);
  silent_grains=0; invalid_audio=0; analysis_points=0;
  build_phase=1; build_cursor=0; index_epoch+=1;
  last_plan_count=0; log_count=0; log_head=-1; selected_log=-1;
  cp_reset_recent(); cp_clear_events();record_n=0;record_done=0;record_event=-1;trace_n=0;trace_head=-1;browse_dirty=1;
);
function cp_setup_tile() local(s start end span)
(
  while(scan_source<source_count && scan_tile>=cp_source_cells(scan_source)) (
    scan_source+=1; scan_tile=0; scan_previous_tail=0;
  );
  scan_source<source_count ? (
    s=cp_s(scan_source); start=floor(s[2]*scan_tile/s[6]); end=floor(s[2]*(scan_tile+1)/s[6]);
    a_g=cp_g(grain_count); memset(a_g,0,64); a_g[0]=s[0]; a_g[1]=scan_source;
    a_g[2]=start; a_g[3]=max(1,end-start); a_g[4]=s[3]; a_g[5]=s[4];
    a_g[9]=0; a_g[10]=-1;
    a_bin=0; a_inburst=0; a_burst_ready=0;
    a_power=0; a_diff=0;a_sidepower=0; a_lowpower=0; a_lowref=0; a_num=0; a_ndiff=0;
    a_peak=0; a_headpower=0; a_headn=0; a_tailpower=0; a_tailn=0;
    a_envsum=0; a_envdiff=0; a_rise=0; a_prev_env=scan_previous_tail;
    a_max_env=0; a_peak_bin=0; a_tile_ready=1;
  ) : a_tile_ready=0;
);
function cp_finish_bin() local(env delta)
(
  env=sqrt(a_binpower/max(1,a_burst_count));
  a_g[24+a_bin]=a_binpeak;
  a_envsum+=env; delta=env-a_prev_env;
  a_envdiff+=abs(delta); a_rise=max(a_rise,delta); a_prev_env=env;
  env>a_max_env ? (a_max_env=env; a_peak_bin=a_bin;);
  a_bin<4 ? (a_headpower+=a_binpower; a_headn+=a_burst_count;);
  a_bin>=12 ? (a_tailpower+=a_binpower; a_tailn+=a_burst_count;);
  a_bin+=1; a_burst_ready=0;
);
function cp_finish_tile() local(rms bright body motion edge crest head tail d bin decay width) (
  rms=sqrt(a_power/max(1,a_num));
  bright=log(1+20*sqrt(cp_01(a_diff/max(0.000000000001,4*a_power))))/log(21);
  body=sqrt(cp_01(a_lowpower/max(0.000000000001,a_lowref)));
  motion=cp_01(a_envdiff/max(0.000000000001,a_envsum)*2.2);
  edge=cp_01(a_rise/max(0.000000000001,a_max_env));
  head=sqrt(a_headpower/max(1,a_headn));tail=sqrt(a_tailpower/max(1,a_tailn));
  crest=cp_01(log(max(1,a_peak/max(0.000000000001,rms)))/log(16));
  decay=cp_01((head-tail)/max(0.000000000001,head+tail));
  width=sqrt(cp_01(a_sidepower/max(0.000000000001,a_power)));
  a_g[6]=rms;a_g[7]=a_peak;a_g[8]=1;a_g[10]=-1;
  a_g[11]=cp_01((cp_db(rms)+84)/84);a_g[12]=bright;a_g[13]=body;a_g[14]=motion;a_g[15]=edge;
  a_g[21]=head;a_g[22]=tail;a_g[23]=cp_clamp(0.16/max(0.000001,rms),0.35,2);
  a_g[40]=a_peak_bin/15;a_g[45]=crest;a_g[46]=decay;a_g[47]=width;
  // Confidence reports sparse burst coverage, not semantic correctness.
  a_g[49]=min(1,a_num/max(1,a_g[3]));a_g[60]=0;a_g[61]=0;
  cp_quiet(grain_count);
  rms<0.00001 ? silent_grains+=1;
  a_g[60]<0.5 ? (d=0;loop(8,
    bin=floor(cp_clamp((d<5 ? a_g[11+d] : a_g[45+d-5])*127,0,127));hist[d*128+bin]+=1;d+=1;
  ););
  cp_fingerprint_add(rms*100000);cp_fingerprint_add(a_peak*100000);
  scan_previous_tail=tail;grain_count+=1;scan_tile+=1;a_tile_ready=0;
);
// v1.4 Auto Micro: short scout/index tiles are sensors. Before normalization,
// adjacent sensors are merged into variable-duration acoustic Micro units.
function cp_sensor_change(a b) local(x y db score) (
  x=cp_g(a);y=cp_g(b);x[1]!=y[1] ? 1 : (
    db=min(1,abs(cp_db(max(0.000000001,x[6]))-cp_db(max(0.000000001,y[6])))/30);
    score=0.24*db+0.18*abs(x[12]-y[12])+0.12*abs(x[13]-y[13])+0.18*abs(x[14]-y[14])+0.14*abs(x[15]-y[15])+0.08*abs(x[47]-y[47])+0.06*abs(x[45]-y[45]);
    cp_01(score*1.45);
  );
);
function cp_micro_target(id first last) local(g a b change instability transient target) (
  g=cp_g(id);a=id>first ? cp_sensor_change(id-1,id) : 0;b=id+1<last ? cp_sensor_change(id,id+1) : 0;
  change=max(a,b);instability=cp_01(0.58*change+0.25*g[14]+0.17*g[15]);
  transient=cp_01(0.58*g[15]+0.42*g[45]);
  target=0.11+0.50*pow(max(0,1-instability),1.35);
  transient>0.72 ? target=min(target,0.16);
  passage_mode==0 ? cp_clamp(target*0.30,0.035,0.16) : cp_clamp(target,0.09,0.61);
);
function cp_merge_group(src firstid endid outid) local(first last out i j g frames total power bright body motion edge width conf peak head tail rms crest decay tb pos rel maxbin maxv raw d bin sampleid startframe endframe sr nch) (
  first=cp_g(firstid);last=cp_g(endid-1);sampleid=first[0];startframe=first[2];endframe=last[2]+last[3];sr=first[4];nch=first[5];head=first[21];tail=last[22];
  total=0;power=0;bright=0;body=0;motion=0;edge=0;width=0;conf=0;peak=0;memset(scout_hist,0,16);
  i=firstid;while(i<endid)(g=cp_g(i);frames=max(1,g[3]);total+=frames;power+=g[6]*g[6]*frames;bright+=g[12]*frames;body+=g[13]*frames;motion+=g[14]*frames;edge=max(edge,g[15]);width+=g[47]*g[47]*frames;conf+=g[49]*frames;peak=max(peak,g[7]);
    j=0;loop(16,pos=g[2]+g[3]*(j+0.5)/16;rel=(pos-first[2])/max(1,(last[2]+last[3])-first[2]);tb=min(15,max(0,floor(rel*16)));scout_hist[tb]=max(scout_hist[tb],g[24+j]);j+=1;);i+=1;);
  rms=sqrt(power/max(1,total));crest=cp_01(log(max(1,peak/max(0.000000001,rms)))/log(16));decay=cp_01((head-tail)/max(0.000000001,head+tail));
  out=cp_g(outid);memset(out,0,64);out[0]=sampleid;out[1]=src;out[2]=startframe;out[3]=max(1,endframe-startframe);out[4]=sr;out[5]=nch;
  out[6]=rms;out[7]=peak;out[8]=1;out[9]=0;out[10]=-1;out[11]=cp_01((cp_db(rms)+84)/84);out[12]=bright/max(1,total);out[13]=body/max(1,total);out[14]=motion/max(1,total);out[15]=edge;
  out[21]=head;out[22]=tail;out[23]=cp_clamp(0.16/max(0.000001,rms),0.35,2);out[45]=crest;out[46]=decay;out[47]=sqrt(cp_01(width/max(1,total)));out[49]=conf/max(1,total);
  maxbin=0;maxv=-1;j=0;loop(16,out[24+j]=scout_hist[j];scout_hist[j]>maxv ? (maxv=scout_hist[j];maxbin=j;);j+=1;);out[40]=maxbin/15;
  cp_quiet(outid);out[60]>0.5 ? auto_quiet_n+=0; // cp_quiet already increments
  rms<0.00001 ? silent_grains+=1;
  out[60]<0.5 ? (d=0;loop(8,raw=d<5 ? out[11+d] : out[45+d-5];bin=floor(cp_clamp(raw*127,0,127));hist[d*128+bin]+=1;d+=1;););
  cp_fingerprint_add(out[2]);cp_fingerprint_add(out[3]);
  auto_window_min=min(auto_window_min,out[3]/out[4]);auto_window_max=max(auto_window_max,out[3]/out[4]);max_grain_seconds=max(max_grain_seconds,out[3]/out[4]);
);
// Opt-in passage segmentation. No duration target: sustained pauses and
// persistent acoustic changes close a unit. Short phonetic fluctuations do not.
// Scratch lives in the private preparation heap. Both scanning and aggregation
// consume sensor budgets, including the incremental non-worker fallback.
function cp_passage_finish() local(p first last out total rms crest decay j raw d bin maxbin maxv sid startframe endframe sr nch head tail) (
  p=passage_work;first=cp_g(p[1]);last=cp_g(p[2]-1);
  sid=first[0];startframe=first[2];endframe=last[2]+last[3];sr=first[4];nch=first[5];head=first[21];tail=last[22];
  total=max(1,p[20]);rms=sqrt(p[21]/total);crest=cp_01(log(max(1,p[28]/max(0.000000001,rms)))/log(16));decay=cp_01((head-tail)/max(0.000000001,head+tail));
  out=cp_g(merge_write);memset(out,0,64);out[0]=sid;out[1]=merge_source;out[2]=startframe;out[3]=max(1,endframe-startframe);out[4]=sr;out[5]=nch;
  out[6]=rms;out[7]=p[28];out[8]=1;out[10]=-1;out[11]=cp_01((cp_db(rms)+84)/84);out[12]=p[22]/total;out[13]=p[23]/total;out[14]=p[24]/total;out[15]=p[25];
  out[21]=head;out[22]=tail;out[23]=cp_clamp(0.16/max(0.000001,rms),0.35,2);out[45]=crest;out[46]=decay;out[47]=sqrt(cp_01(p[26]/total));out[49]=p[27]/total;
  maxbin=0;maxv=-1;j=0;loop(16,out[24+j]=p[32+j];p[32+j]>maxv ? (maxv=p[32+j];maxbin=j;);j+=1;);out[40]=maxbin/15;
  cp_quiet(merge_write);rms<0.00001 ? silent_grains+=1;
  out[60]<0.5 ? (d=0;loop(8,raw=d<5 ? out[11+d] : out[45+d-5];bin=floor(cp_clamp(raw*127,0,127));hist[d*128+bin]+=1;d+=1;););
  cp_fingerprint_add(out[2]);cp_fingerprint_add(out[3]);auto_window_min=min(auto_window_min,out[3]/sr);auto_window_max=max(auto_window_max,out[3]/sr);max_grain_seconds=max(max_grain_seconds,out[3]/sr);
  merge_read=p[2];merge_write+=1;merge_new_count+=1;p[0]=0;
);
function cp_passage_step(work) local(budget p s a g first last dt quietfloor quiet change pendingtype hold boundary nextseconds alpha j pos rel tb frames totalspan) (
  budget=max(1,floor(work/64));p=passage_work;
  while(budget>0 && merge_source<source_count)(
    s=cp_s(merge_source);a=cp_auto(merge_source);
    !merge_active ? (merge_orig_start=s[5];merge_orig_end=s[5]+s[6];merge_read=merge_orig_start;merge_new_start=merge_write;merge_new_count=0;merge_active=1;p[0]=0;);
    merge_read>=merge_orig_end ? (
      s[5]=merge_new_start;s[6]=max(1,merge_new_count);a[4]=s[2]/s[3]/max(1,s[6]);merge_active=0;merge_source+=1;
    ) : (
      quietfloor=max(0.000003,max(cp_quiet_floor(merge_source)*1.6,a[2]*0.08));
      p[0]==0 ? (
        memset(p,0,64);g=cp_g(merge_read);p[0]=1;p[1]=merge_read;p[2]=merge_read+1;p[3]=merge_read+1;p[4]=g[3]/g[4];
        p[5]=g[6];p[6]=g[12];p[7]=g[13];p[8]=g[47];p[9]=g[6]<quietfloor;p[10]=-1;
      );
      p[0]==1 ? (
        boundary=0;
        p[3]>=merge_orig_end ? boundary=1 : (
          g=cp_g(p[3]);dt=g[3]/g[4];nextseconds=p[4]+dt;
          passage_limit>0 && nextseconds>passage_limit+0.5/g[4] ? boundary=1 : (
            quiet=g[6]<quietfloor*(p[9]>0.5 ? 1.6 : 1);
            change=0.30*min(1,abs(cp_db(max(0.000001,g[6]))-cp_db(max(0.000001,p[5])))/24)+0.40*abs(g[12]-p[6])+0.18*abs(g[13]-p[7])+0.12*abs(g[47]-p[8]);
            pendingtype=quiet!=p[9] ? 1 : (!quiet && p[4]>=0.35 && change>0.40-0.22*passage_sensitivity ? 2 : 0);
            pendingtype>0 ? (
              p[10]<0 || p[12]!=pendingtype ? (p[10]=p[3];p[11]=0;p[12]=pendingtype;);p[11]+=dt;
              hold=pendingtype==1 ? (p[9]>0.5 ? 0.04 : 0.10+0.22*(1-passage_sensitivity)) : 0.40-0.20*passage_sensitivity;
              p[11]>=hold ? (p[2]=max(p[1]+1,p[10]);boundary=1;);
            ) : (
              p[10]=-1;p[11]=0;p[12]=0;alpha=min(0.15,dt/0.8);
              p[5]+=(g[6]-p[5])*alpha;p[6]+=(g[12]-p[6])*alpha;p[7]+=(g[13]-p[7])*alpha;p[8]+=(g[47]-p[8])*alpha;
            );
            !boundary ? (p[4]=nextseconds;p[3]+=1;p[2]=p[3];);
          );
        );
        boundary ? (p[0]=2;p[3]=p[1];memset(p+20,0,28););
        budget-=1;
      ) : (
        first=cp_g(p[1]);last=cp_g(p[2]-1);totalspan=max(1,last[2]+last[3]-first[2]);g=cp_g(p[3]);frames=max(1,g[3]);
        p[20]+=frames;p[21]+=g[6]*g[6]*frames;p[22]+=g[12]*frames;p[23]+=g[13]*frames;p[24]+=g[14]*frames;p[25]=max(p[25],g[15]);p[26]+=g[47]*g[47]*frames;p[27]+=g[49]*frames;p[28]=max(p[28],g[7]);
        j=0;loop(16,pos=g[2]+g[3]*(j+0.5)/16;rel=(pos-first[2])/totalspan;tb=min(15,max(0,floor(rel*16)));p[32+tb]=max(p[32+tb],g[24+j]);j+=1;);
        p[3]+=1;budget-=1;p[3]>=p[2] ? cp_passage_finish();
      );
    );
  );
  merge_source>=source_count && !merge_done ? (grain_count=merge_write;tile_total=grain_count;effective_window=total_seconds/max(1,grain_count);merge_done=1;build_phase=8;);
);

function cp_merge_begin() (
  memset(passage_work,0,64);
  merge_source=0;merge_active=0;merge_write=0;merge_done=0;auto_window_min=1000000000;auto_window_max=0;auto_quiet_n=0;silent_grains=0;max_grain_seconds=0;memset(hist,0,1024);
);
function cp_merge_step(work) local(groups s a first target seconds id boundary minsec groupend stop rem k) (
  passage_run ? cp_passage_step(work) : (
  groups=max(1,floor(work/64));
  while(groups>0 && merge_source<source_count)(
    s=cp_s(merge_source);a=cp_auto(merge_source);
    !merge_active ? (merge_orig_start=s[5];merge_orig_end=s[5]+s[6];merge_read=merge_orig_start;merge_new_start=merge_write;merge_new_count=0;merge_active=1;);
    merge_read>=merge_orig_end ? (
      s[5]=merge_new_start;s[6]=max(1,merge_new_count);a[4]=s[2]/s[3]/max(1,s[6]);merge_active=0;merge_source+=1;
    ) : (
      first=merge_read;groupend=first+1;
      window_setting<=0 ? (
        target=cp_micro_target(first,merge_orig_start,merge_orig_end);seconds=cp_g(first)[3]/cp_g(first)[4];minsec=passage_mode==0 ? 0.035 : 0.09;stop=0;
        while(groupend<merge_orig_end && seconds<(passage_mode==0 ? 0.24 : 0.68) && !stop)(
          boundary=cp_sensor_change(groupend-1,groupend);
          seconds>=minsec && (seconds>=target || boundary>=(passage_mode==0 ? 0.24 : 0.62)) ? stop=1 : (seconds+=cp_g(groupend)[3]/cp_g(groupend)[4];groupend+=1;);
        );
        while(groupend<merge_orig_end && seconds<minsec)(seconds+=cp_g(groupend)[3]/cp_g(groupend)[4];groupend+=1;);
        // Never strand a tiny Auto tail as its own Micro unit. If the complete
        // remaining source tail is shorter than the 90 ms normal floor, absorb it
        // into this group. A whole source shorter than the floor remains one unit.
        groupend<merge_orig_end ? (
          rem=0;k=groupend;while(k<merge_orig_end && rem<minsec)(rem+=cp_g(k)[3]/cp_g(k)[4];k+=1;);
          k>=merge_orig_end && rem<minsec ? groupend=merge_orig_end;
        );
      );
      cp_merge_group(merge_source,first,groupend,merge_write);merge_read=groupend;merge_write+=1;merge_new_count+=1;groups-=1;
    );
  );
  merge_source>=source_count && !merge_done ? (grain_count=merge_write;tile_total=grain_count;effective_window=total_seconds/max(1,grain_count);merge_done=1;build_phase=8;);
  ); // Aggressive / Auto / manual merge
);
function cp_quantiles() local(d j sum lo hi ql qh span center) (
  d=0;loop(8,
    sum=0;lo=0;hi=127;ql=0;qh=0;j=0;
    loop(128,sum+=hist[d*128+j];
      !ql && sum>=max(1,max(0,grain_count-auto_quiet_n)*0.05) ? (lo=j;ql=1;);
      !qh && sum>=max(1,max(0,grain_count-auto_quiet_n)*0.95) ? (hi=j;qh=1;);j+=1;
    );
