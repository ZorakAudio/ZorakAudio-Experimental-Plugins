ready && floor(slider56)!=h_last_mode ? (
  h_last_mode=floor(slider56);
  h_last_mode>0 && !h_ready && h_phase==0 ? h_rebuild_requested=1;
);
ready && xc_ready && h_rebuild_requested && cp_hold_count()==0 && cp_busy()==0 ? (h_begin();h_rebuild_requested=0;);
h_phase>0 && h_live_model()==0 ? h_build();
xc_ready && h_ready && h_phase==0 && cp_hold_count()==0 && cp_busy()==0 ? (
  xc_grammar_epoch!=index_epoch && xc_post_phase==0 ? xc_post_begin();
  xc_grammar_ready && xc_post_phase==0 && xc_map_phase==0 && (!xc_map_ready || xc_map_source!=floor(slider64)-1 || xc_map_target!=floor(slider14)) ? xc_map_begin();
  xc_post_phase>0 || xc_map_phase>0 ? xc_post_step();
