);
function ui_dim(d) (ui_desc_name(d););
function ui_desc_from_menu(n) local(d) (
  d=-1;
  n>=2 && n<=9 ? d=n-2;
  n>=11 && n<=22 ? d=8+n-11;
  n>=24 && n<=31 ? d=20+n-24;
  n>=33 && n<=45 ? d=28+n-33;
  n>=47 && n<=49 ? d=41+n-47;
  n>=51 && n<=53 ? d=44+n-51;
  n>=55 && n<=58 ? d=47+n-55;d;
);
function ui_desc_menu() local(n) (
  gfx_x=mouse_x;gfx_y=mouse_y;
  n=gfx_showmenu("#CORE|Energy|Brightness|LF weight|Motion|Onset|Crest|Decay|Width|#SPECTRAL|Sub 125 Hz|125-250 Hz|250-500 Hz|500 Hz-1 kHz|1-2 kHz|2-4 kHz|4-8 kHz|8 kHz+|Spectral centroid|Spectral spread|Spectral flatness|Spectral tilt|#TEMPORAL|Local stability|Periodicity|Pulse confidence|Pulse rate|Spectral evolution|Energy direction|Centroid direction|Boundary activity|#TONAL|Harmonicity|Chroma C|Chroma C#|Chroma D|Chroma D#|Chroma E|Chroma F|Chroma F#|Chroma G|Chroma G#|Chroma A|Chroma A#|Chroma B|#SPATIAL|Stereo correlation|L/R balance|Spatial evolution|#CONTEXT|Recurrence|Adjacency confidence|Replaceability|#LEARNED FROM THIS CORPUS|Corpus Axis 1|Corpus Axis 2|Corpus Axis 3|Corpus Axis 4");
  ui_desc_from_menu(n);
);
function ui_desc_row_id(row) local(d) (
  d=-1;
  row>=1 && row<=8 ? d=row-1;
  row>=10 && row<=21 ? d=8+row-10;
  row>=23 && row<=30 ? d=20+row-23;
  row>=32 && row<=44 ? d=28+row-32;
