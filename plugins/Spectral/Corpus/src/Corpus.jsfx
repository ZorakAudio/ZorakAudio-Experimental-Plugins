  when=floor(when+0.5);h_active=0;h_is_rest=0;h_until=1000000000000;h_current=-1;h_reference=-1;h_effect=0;h_q=-1;
  wi=floor((e-event_base)/64);q=h_state+wi*96;root=cp_w(wi*3);
  q[0]!=e[1] ? (
