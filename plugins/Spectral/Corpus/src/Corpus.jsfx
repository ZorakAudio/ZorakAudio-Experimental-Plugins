        loop(min(16,n),ix=min(n-1,floor((i+0.5)*n/max(1,min(16,n))));id=use_rich ? (pg_preview ? pg_reservoir : ((pg_changed && !pg_bypass && pg_ready) ? pg_live_res : desc_reservoir))[k*32+ix] : path_reservoir[(axis*16+bin)*64+ix];
          cp_valid(id) ? (g=cp_g(id);src<=0 || g[1]==src-1 ? (
