  g[10]>=0 ? g[41+g[10]]=cp_01(g[41+g[10]]+0.40);
  best=-1;n=0;i=0;loop(4,
    g[41+i]>best ? (best=g[41+i];n=i;);
    cp_valid(id) ? (
      role_stats[i]+=g[41+i];role_stats[4+i]+=g[41+i]*g[41+i];
      g[41+i]>=0.35 ? role_stats[8+i]+=1;
    );i+=1;
  );g[8]=n;
);
function cp_count_grain(id apply_edits) local(g d raw norm e v) (
  g=cp_g(id);d=0;loop(8,
