    base=xc_frame==0 ? 32 : 48;i=0;loop(8,p[base+i]=xc_tmp[i];i+=1;);
    p[base+8]=cp_db(energy);p[base+9]=xc_tmp[8];p[base+10]=flat;p[base+11]=tonal;
    p[base+12]=cp_01(bestcorr);p[base+13]=xc_tmp[14];p[base+14]=xc_tmp[15];p[base+15]=freq;
    base=xc_frame==0 ? 64 : 76;memcpy(p+base,xc_tmp+16,12);
