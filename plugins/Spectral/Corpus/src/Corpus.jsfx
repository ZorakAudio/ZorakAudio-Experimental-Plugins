function pt_config(id frames rate role enabled) local(g p native tonal) (
  g=cp_g(id);native=g[4]/max(8000,srate);
  pt_duration=max(1,ceil(frames/max(0.000001,rate)));pt_half=0;pt_period=0;
  // Nominal zero survives float parameter snapping and stays a bit-exact bypass.
