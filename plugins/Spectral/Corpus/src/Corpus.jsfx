function ui_desc_menu() local(n) (
  gfx_x=mouse_x;gfx_y=mouse_y;
  n=gfx_showmenu("#CORE|Energy|Length|Brightness|LF weight|Motion|Onset|Crest|Decay|Width|#SPECTRAL|Sub 125 Hz|125-250 Hz|250-500 Hz|500 Hz-1 kHz|1-2 kHz|2-4 kHz|4-8 kHz|8 kHz+|Spectral centroid|Spectral spread|Spectral flatness|Spectral tilt|#TEMPORAL|Local stability|Periodicity|Pulse confidence|Pulse rate|Spectral evolution|Energy direction|Centroid direction|Boundary activity|#TONAL|Harmonicity|Chroma C|Chroma C#|Chroma D|Chroma D#|Chroma E|Chroma F|Chroma F#|Chroma G|Chroma G#|Chroma A|Chroma A#|Chroma B|#SPATIAL|Stereo correlation|L/R balance|Spatial evolution|#CONTEXT|Recurrence|Adjacency confidence|Replaceability|#LEARNED FROM THIS CORPUS|Corpus Axis 1|Corpus Axis 2|Corpus Axis 3|Corpus Axis 4|#PREDICTION ERROR|Region PE|EC PE");
  ui_desc_from_menu(n);
);
function ui_desc_row_id(row) local(d) (
  d=-1;
  row==1 ? d=0;row==2 ? d=53;
  row>=3 && row<=9 ? d=row-2;
  row>=11 && row<=22 ? d=8+row-11;
  row>=24 && row<=31 ? d=20+row-24;
  row>=33 && row<=45 ? d=28+row-33;
  row>=47 && row<=49 ? d=41+row-47;
  row>=51 && row<=53 ? d=44+row-51;
  row>=55 && row<=58 ? d=47+row-55;
  row>=60 && row<=61 ? d=51+row-60;d;
);
function ui_desc_row_category(row) (
  row==0 ? strcpy(#ui_desc_cat,"CORE");
  row==10 ? strcpy(#ui_desc_cat,"SPECTRAL");
  row==23 ? strcpy(#ui_desc_cat,"TEMPORAL");
  row==32 ? strcpy(#ui_desc_cat,"TONAL");
  row==46 ? strcpy(#ui_desc_cat,"SPATIAL");
  row==50 ? strcpy(#ui_desc_cat,"CONTEXT");
  row==54 ? strcpy(#ui_desc_cat,"LEARNED FROM THIS CORPUS");
  row==59 ? strcpy(#ui_desc_cat,"PREDICTION ERROR");
);
function ui_desc_id_row(d) local(row found) (
  d=cp_clamp(floor(d),0,cp_desc_count()-1);row=0;found=0;
  while(row<ui_desc_rows())(ui_desc_row_id(row)==d ? found=row;row+=1;);found;
);
function ui_desc_popup_open(id) local(d lane p) (
  ui_desc_popup=id;ui_desc_popup_x=mouse_x;ui_desc_popup_y=mouse_y;
  id>=100 && id<112 ? (lane=id-100;p=ui_traj+lane*40;d=floor(p[1]);) : (id>=200 && id<203 ? d=61216[32+(id-200)*5+1] : d=ui_axis_value(id));
  ui_desc_popup_scroll=0;ui_desc_popup_drag=0;ui_desc_popup_just=1;
);
function ui_desc_choice(id x y w label) local(d) (
  d=cp_clamp(ui_axis_value(id),0,53);ui_desc_name(d);sprintf(#ui_choice_label,"%s: %s",label,#ui_dim);
  ui_button(x,y,w,34,#ui_choice_label,ui_desc_popup==id) ? ui_desc_popup_open(id);
  ui_hit(x,y,w,34) ? ui_tip("Unified Corpus descriptor registry. Core includes Length near the top. Click for the scrollable categorized picker; mouse wheel or drag its scrollbar. Spectral/spatial evidence is universal; tonal/pulse axes are confidence-gated; Corpus Axes are learned from this load during preprocessing.");
);
function ui_desc_popup_draw() local(px py pw ph headh rowh total vis maxscroll first count i row d ry current inside tracky trackh thumbh thumby rel) (
  ui_desc_popup>0 ? (
    gfx_dest=-1;gfx_mode=0;ui_ox=0;ui_oy=0;ui_vh=gfx_h;ui_mouse_in=1;ui_mx=mouse_x;ui_my=mouse_y;ui_input_blocked=0;
    pw=max(190,min(360,gfx_w-16));ph=max(190,min(590,gfx_h-16));
    px=cp_clamp(ui_desc_popup_x-pw*0.18,8,max(8,gfx_w-pw-8));
    py=cp_clamp(ui_desc_popup_y-36,8,max(8,gfx_h-ph-8));
    headh=42;rowh=28;total=ui_desc_rows();vis=max(3,floor((ph-headh-10)/rowh));maxscroll=max(0,total-vis);
    inside=mouse_x>=px && mouse_x<px+pw && mouse_y>=py && mouse_y<py+ph;
    inside && ui_wheel!=0 ? (ui_desc_popup_scroll-=ui_wheel/120*3;ui_wheel=0;);
    ui_desc_popup_scroll=cp_clamp(ui_desc_popup_scroll,0,maxscroll);
    // Click outside closes the picker. The opening click is ignored for one frame.
    !ui_desc_popup_just && ui_lpress && !inside ? (ui_desc_popup=0;ui_desc_popup_drag=0;);
    ui_desc_popup>0 ? (
      ui_box(px,py,pw,ph,0.030,0.044,0.060);ui_border(px,py,pw,ph,0.31,0.54,0.58);
      ui_desc_popup==40 ? strcpy(#ui_desc_cat,"X DESCRIPTOR") : (ui_desc_popup==41 ? strcpy(#ui_desc_cat,"Y DESCRIPTOR") : strcpy(#ui_desc_cat,"TRAJECTORY DESCRIPTOR"));
      ui_text(px+12,py+9,pw-50,17,#ui_desc_cat,0.88,0.96,0.97);
      ui_text(px+pw-82,py+10,68,14,"SCROLL",0.50,0.70,0.75);
      first=floor(ui_desc_popup_scroll);count=min(vis,total-first);i=0;
      loop(count,
        row=first+i;ry=py+headh+i*rowh;d=ui_desc_row_id(row);
        d<0 ? (
          ui_desc_row_category(row);ui_box(px+7,ry+2,pw-26,rowh-4,0.055,0.082,0.100);
          ui_text(px+14,ry+7,pw-42,14,#ui_desc_cat,0.48,0.75,0.78);
        ) : (
          ui_desc_popup>=100 && ui_desc_popup<112 ? (ui_dp=ui_traj+(ui_desc_popup-100)*40;current=floor(ui_dp[1]);) : (ui_desc_popup>=200 && ui_desc_popup<203 ? current=61216[32+(ui_desc_popup-200)*5+1] : current=ui_axis_value(ui_desc_popup));
          d==current ? ui_box(px+7,ry+2,pw-26,rowh-4,0.105,0.255,0.255) : (
            mouse_x>=px+7 && mouse_x<px+pw-24 && mouse_y>=ry+2 && mouse_y<ry+rowh-2 ? ui_box(px+7,ry+2,pw-26,rowh-4,0.075,0.125,0.145);
          );
          ui_desc_name(d);ui_text(px+15,ry+7,pw-48,14,#ui_dim,d==current ? 0.91 : 0.77,d==current ? 0.98 : 0.88,d==current ? 0.96 : 0.91);
          d==current ? ui_text(px+pw-49,ry+7,24,14,"*",0.55,0.90,0.78);
          !ui_desc_popup_just && ui_lpress && mouse_x>=px+7 && mouse_x<px+pw-24 && mouse_y>=ry+2 && mouse_y<ry+rowh-2 ? (
            ui_desc_popup>=100 && ui_desc_popup<112 ? ui_traj_meta(ui_desc_popup-100,16+d) : (ui_desc_popup>=200 && ui_desc_popup<203 ? ui_enqueue(14,59000+(ui_desc_popup-200)*1000+d) : ui_set_axis(ui_desc_popup,d));ui_desc_popup=0;ui_desc_popup_drag=0;
          );
        );i+=1;
      );
      // Visible scrollbar; wheel and direct thumb/track dragging both work.
      tracky=py+headh+2;trackh=ph-headh-8;thumbh=max(34,trackh*vis/total);
      thumby=tracky+(trackh-thumbh)*(maxscroll>0 ? ui_desc_popup_scroll/maxscroll : 0);
      ui_box(px+pw-14,tracky,7,trackh,0.075,0.105,0.125);ui_box(px+pw-14,thumby,7,thumbh,0.30,0.58,0.60);
      !ui_desc_popup_just && ui_lpress && mouse_x>=px+pw-20 && mouse_x<px+pw && mouse_y>=tracky && mouse_y<tracky+trackh ? ui_desc_popup_drag=1;
      ui_down && ui_desc_popup_drag ? (
        rel=cp_01((mouse_y-tracky-thumbh*0.5)/max(1,trackh-thumbh));ui_desc_popup_scroll=rel*maxscroll;
      );
      !ui_down ? ui_desc_popup_drag=0;
    );
    ui_desc_popup_just=0;
  );
);
function ui_desc_pick(x y w label current) local(nd) (
  current=cp_clamp(floor(current),0,53);ui_desc_name(current);sprintf(#ui_choice_label,"%s: %s",label,#ui_dim);
  ui_button(x,y,w,34,#ui_choice_label,0) ? (nd=ui_desc_menu();nd>=0 ? current=nd;);
  ui_hit(x,y,w,34) ? ui_tip("Choose from Core, Spectral, Temporal, Tonal, Spatial, Context, or corpus-derived Learned axes.");current;
);
function ui_role(r) (
  r==0 ? strcpy(#ui_role,"Attack");r==1 ? strcpy(#ui_role,"Body");r==2 ? strcpy(#ui_role,"Detail");r==3 ? strcpy(#ui_role,"Tail");
);
function ui_phase(r) (
  r==0 ? strcpy(#ui_phase,"Attack");r==1 ? strcpy(#ui_phase,"Decay");r==2 ? strcpy(#ui_phase,"Sustain");r==3 ? strcpy(#ui_phase,"Release");
);
function ui_vertex(v) local(d b) (
  v>=15 && v<19 ? (ui_role(v-15);sprintf(#ui_vertex,"%s eligible",#ui_role);) : (
    v<15 ? (d=floor(v/3);b=v%3;) : (d=5+floor((v-19)/3);b=(v-19)%3;);
    ui_dim(d);b==0 ? strcpy(#ui_bin,"low") : (b==1 ? strcpy(#ui_bin,"mid") : strcpy(#ui_bin,"high"));
    sprintf(#ui_vertex,"%s / %s",#ui_dim,#ui_bin);
  );
);
function ui_record_feat(rec d) (d<5 ? rec[16+d] : rec[51+d-5];);
function ui_wave(rec x y w h) local(i xx amp peak) (
  peak=max(0.0000001,rec[7]);i=0;loop(16,
    xx=x+(i+0.5)*w/16;amp=cp_01(rec[24+i]/peak)*h*0.45;
    ui_line(xx,y+h*0.5-amp,xx,y+h*0.5+amp,0.33,0.77,0.70,1);i+=1;
  );
);
function ui_grain_menu(id) local(n) (
  gfx_x=mouse_x;gfx_y=mouse_y;n=gfx_showmenu("Audition exact grain|Use as identity anchor|Toggle exclusion|Cycle role BIAS (Auto/A/B/D/T)|Inspect without playing");
  n==1 ? ui_enqueue(1,id);n==2 ? (ui_notify(15,id+1,1);ui_enqueue(9,id););
  n==3 ? ui_enqueue(7,id);n==4 ? ui_enqueue(8,id);n==5 ? ui_enqueue(9,id);
);
function ui_brush_touch(id) (
  // Capture happens only on a grain/point press, not by dragging a scrollbar
