      frac=max(0,(when-e[5])/total);cycle=floor(frac);e[12]<=0 ? frac-=cycle;
      seconds=min(s[2]/s[3]-0.000000001,frac*s[2]/s[3]);guide=h_at_time(source,seconds+0.0000000001);
      guide>=0 ? (
