// v1.4 Auto Micro: short scout/index tiles are sensors. Before normalization,
// adjacent sensors are merged into variable-duration acoustic Micro units.
function cp_sensor_change(a b) local(x y db score) (
  x=cp_g(a);y=cp_g(b);x[1]!=y[1] ? 1 : (
    db=min(1,abs(cp_db(max(0.000000001,x[6]))-cp_db(max(0.000000001,y[6])))/30);
    score=0.24*db+0.18*abs(x[12]-y[12])+0.12*abs(x[13]-y[13])+0.18*abs(x[14]-y[14])+0.14*abs(x[15]-y[15])+0.08*abs(x[47]-y[47])+0.06*abs(x[45]-y[45]);
    cp_01(score*1.45);
  );
);
function cp_micro_target(id first last) local(g a b change instability transient target) (
  g=cp_g(id);a=id>first ? cp_sensor_change(id-1,id) : 0;b=id+1<last ? cp_sensor_change(id,id+1) : 0;
  change=max(a,b);instability=cp_01(0.58*change+0.25*g[14]+0.17*g[15]);
  transient=cp_01(0.58*g[15]+0.42*g[45]);
  target=0.11+0.50*pow(max(0,1-instability),1.35);
  transient>0.72 ? target=min(target,0.16);
  cp_clamp(target,0.09,0.61);
);
function cp_merge_group(src firstid endid outid) local(first last out i j g frames total power bright body motion edge width conf peak head tail rms crest decay tb pos rel maxbin maxv raw d bin sampleid startframe endframe sr nch) (
  first=cp_g(firstid);last=cp_g(endid-1);sampleid=first[0];startframe=first[2];endframe=last[2]+last[3];sr=first[4];nch=first[5];head=first[21];tail=last[22];
  total=0;power=0;bright=0;body=0;motion=0;edge=0;width=0;conf=0;peak=0;memset(scout_hist,0,16);
  i=firstid;while(i<endid)(g=cp_g(i);frames=max(1,g[3]);total+=frames;power+=g[6]*g[6]*frames;bright+=g[12]*frames;body+=g[13]*frames;motion+=g[14]*frames;edge=max(edge,g[15]);width+=g[47]*g[47]*frames;conf+=g[49]*frames;peak=max(peak,g[7]);
    j=0;loop(16,pos=g[2]+g[3]*(j+0.5)/16;rel=(pos-first[2])/max(1,(last[2]+last[3])-first[2]);tb=min(15,max(0,floor(rel*16)));scout_hist[tb]=max(scout_hist[tb],g[24+j]);j+=1;);i+=1;);
  rms=sqrt(power/max(1,total));crest=cp_01(log(max(1,peak/max(0.000000001,rms)))/log(16));decay=cp_01((head-tail)/max(0.000000001,head+tail));
  out=cp_g(outid);memset(out,0,64);out[0]=sampleid;out[1]=src;out[2]=startframe;out[3]=max(1,endframe-startframe);out[4]=sr;out[5]=nch;
  out[6]=rms;out[7]=peak;out[8]=1;out[9]=0;out[10]=-1;out[11]=cp_01((cp_db(rms)+84)/84);out[12]=bright/max(1,total);out[13]=body/max(1,total);out[14]=motion/max(1,total);out[15]=edge;
  out[21]=head;out[22]=tail;out[23]=cp_clamp(0.16/max(0.000001,rms),0.35,2);out[45]=crest;out[46]=decay;out[47]=sqrt(cp_01(width/max(1,total)));out[49]=conf/max(1,total);
  maxbin=0;maxv=-1;j=0;loop(16,out[24+j]=scout_hist[j];scout_hist[j]>maxv ? (maxv=scout_hist[j];maxbin=j;);j+=1;);out[40]=maxbin/15;
  cp_quiet(outid);out[60]>0.5 ? auto_quiet_n+=0; // cp_quiet already increments
