    gfx_setfont(1,"Arial",max(14,size),0);ui_color(r,g,b,1);gfx_x=x+ui_ox;gfx_y=y+ui_oy;
    gfx_drawstr(text,0,x+ui_ox+w,y+ui_oy+size+7);
  );
);
function ui_line(x y x2 y2 r g b a) (
