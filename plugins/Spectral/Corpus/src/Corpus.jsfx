desc:Corpus v1.7.1 - EC Focus audition / axis selector repair / local Essence + PCA refinement
tags:instrument sampler granular synthesis ui
// #GFX_RESIZE: responsive
// #FILE: Corpus sources {Slot 0: use Open Multiple, as in Sample v71. A single long file is valid.}
filename:0,sample.wav
in_pin:none
out_pin:Left
out_pin:Right
options:maxmem=25165824 gfx_hz=30
// @za:gfx_sync_policy EXPLICIT
// @za:gfx_sync_mem 49152 16384 DSP_TO_GFX
// Corpus v0.7.0: combined representation, walk, envelope, mutation, branching,
// and exploration prototype. Requires Sample v71's EXTENDED sample-pool host.
// Not stock REAPER JSFX. No compiler/runtime modifications or imports needed.
// Loader and analysis scaffolding derived from Corpus v0.1.2 / Sample v71.
// DSP owns corpus, analysis, scheduler, history and voices. GFX reads ONLY the
// bounded explicit snapshot and writes acknowledged slider24 command packets.
// Audio stays in the immutable host pool. Never adopt while voices/events exist.
// Roles are four independent fuzzy eligibilities, NEVER exclusive retrieval bins.
// Feature labels are acoustic PROXIES, not learned semantic/material recognition.
// The map is a user-selected two-descriptor projection, not a neural embedding.
// Existing slider slots are preserved; role filtering is now fuzzy eligibility.
// v0.9.3: decoupled analysis/audio clocks, active-run playback spans, audible-hole diagnostics.
// v1.7.0: optional EC Focus adds class-local Essence + PC1/PC2/PC3 refinement without changing broad class discovery.
// v1.7.1: explicit axis buttons, audible dot scrubbing, preview-vs-apply focus ranges, and immediate focused audition.
// v1.5.1: child walkers own independent Micro lineages; newer controls support right-click reset.
// v1.5.0: performance-first Explore and bounded 0..12 child cloud with gap-fill action.
// v1.4.0: unified 51-axis descriptor registry, corpus-derived axes, variable Auto Micro segmentation, and Structure re-synthesis audition.
// v1.4.1: X/Y descriptor selection uses an in-plugin scrollable picker instead of an OS-sized menu.
// Slots 22/23 now hold quiet detection and source matching. Slot IDs otherwise stable.
// New defaults are for fresh instances. Saved explicit choices are not overwritten.
// #HELP: Load files in slot 0, wait for INDEX READY, click grains/vertices to hear them.
// #HELP: MIDI notes launch the same continuous walker in One-shot or Gated mode.
// #HELP: A/D/R are milliseconds; known windows proportionally fit A+D+R when needed.
// #HELP: Sustain is gain. Stability is the separate identity-leash parameter.
// #HELP: Draw a map path to guide selected descriptor axes through an event.
// #HELP: Click map point = audition, Shift = anchor, Ctrl+drag = focus, Draw = path.
// #HELP: Structure: click Meso/Macro = re-synthesize with the current engine; Shift+click = original source region; Ctrl+click = pending exclusion.
// #HELP: EC Focus is an optional second-stage Meso refinement. Essence measures class-defining direction vs corpus background; PC1/PC2/PC3 measure within-class variation. Click/drag member dots to audition originals, Shift-click a dot to re-synthesize it, and drag the lower range strip to preview/retain a slice. FOCUS ON applies that slice to generation; broad EC membership is never destroyed.
// #HELP: Child walkers share the structural trajectory but own independent Micro lineages; Follow is not a grain-for-grain clone.
// #HELP: Trajectory Solver adds up to 12 synchronized one-dimensional descriptor lanes (Target / Maximum / Minimum) over event progress. Curves are painted freehand with the mouse; there are no editable control points.
// #HELP: Descriptor lanes use cached 51-axis evidence and bounded successor lookahead; no FFT or corpus analysis runs from playback.
// #HELP: Amplitude can use conventional ADSR or a custom smooth freehand MSEG curve. Fixed one-shots traverse the whole curve; Gated/Natural hold at the sustain marker then traverse the release segment.
// #HELP: Right-click resets both ordinary and newer cloud/coherence controls to their documented defaults.
// #HELP: Explore is the performance surface: child cloud, lifecycle, ADSR, overlap/coherence and descriptor map are reachable without changing pages.
// #HELP: Up to 12 non-recursive child walkers can act as Follow, Resonance, Debris, Contrast, Shadow, Fill-gaps, or Mixed companions. Child Level is total-cloud intent and is energy-compensated as count rises.
// #HELP: Auto Micro uses short internal probes but merges them into variable-duration acoustic units before hierarchy learning.
// #HELP: All panes scroll. Small windows use tabs; no minimum-size blocker.
// #HELP: Sample Hub CC118/119 v1 packets: Play/Retrigger/Continue/Choke/End supported.
// #HELP: Unsupported modifier packets are rejected and counted, not misinterpreted.
// #HELP: REPEAT uses a completed recorded plan; overflow/continued/forced plans are disabled.
// #HELP: Live controls affect future selections; replay uses recorded decisions.
// #HELP: Analysis rebuilds automatically after source/settings changes; active audio finishes first.
// #HELP: Micro/Meso boundaries retarget future selections; they never truncate sounding audio.
// #HELP: Only event deadlines, explicit stops/source ends and Macro REST may terminate active audio.
// #HELP: Inspector distinguishes scheduler gaps, source holes and final audible holes.
// #HELP: Source matching is capped at +24 dB. Low-salience material stays playable; only Macro may schedule structural REST.
// #HELP: Draw commits on mouse-up. Locks/scope remain authoritative; target error is visible.
slider1:0.5<0,1,0.001>--Force target
slider2:0.35<0,1,0.001>--Variation
slider3:0.8<0,1,0.001>--Coherence
slider4:0.4<0,1,0.001>--Detail density
slider5:0<0,1000,1>--Micro window (0=Auto variable; positive=fixed manual ms)
slider6:1<0,4,1{4096,8192,16384,32768,65536}>--Grain index budget (Apply)
slider7:0<-36,12,0.1>--Output (dB)
slider8:0<-24,24,0.1>--Pitch (semitones; generated only)
slider9:1<0,1,0.001>--Velocity influence
slider10:0<0,2,1{One-shot,Gated,Natural}>--MIDI lifecycle
slider11:12345<1,16777213,1>--Random seed
slider12:0<0,1,1{Evolve,Fixed}>--Seed mode
slider13:0<0,65536,256>--Pool RAM budget (MB; 0=resident)
slider14:0<0,65536,1>--Source scope (0=all)
slider15:0<0,65536,1>--Identity anchor (0=none)
slider16:0<0,153,1>--Descriptor filter (0=all; encoded descriptor/bin)
slider17:0<0,4,1{All,Attack,Body,Detail,Tail}>--Role eligibility filter
slider18:0<0,3276,1>--Grain browser page
slider19:0<0,99,1>--Traversal history offset
slider20:1<0,1,1{Off,On}>--Safety peak catch
slider21:1<0,2,1{Fast,Balanced,Detailed}>--Analysis quality (Apply)
slider22:1<0,2,1{Off,Auto,Manual}>--Low-salience detection
slider23:1<0,1,1{Raw,Match active}>--Source level policy
slider24:0<0,16777215,1>--UI action packet (internal; do not automate)
slider25:800<20,30000,1>--One-shot duration (ms)
slider26:5<0,2000,1>--Attack (ms)
slider27:100<0,5000,1>--Decay (ms)
slider28:0.75<0,1,0.001>--Sustain level
slider29:180<0,5000,1>--Release (ms)
slider30:0.55<0,1,0.001>--Walk flow / overlap
slider31:0.5<0,1,0.001>--Brightness mutation
slider32:0.5<0,1,0.001>--Mass (LF-weight mutation)
slider33:0.5<0,1,0.001>--Roughness mutation
slider34:0.65<0,1,0.001>--Novelty pressure
slider35:0.8<0,1,0.001>--Identity stability
slider36:0<0,3,1{Linear,Resonance,Debris,Layered}>--Branch morphology
slider37:0.25<0,1,0.001>--Branch level
slider38:0.85<0,1,0.001>--Branch identity inheritance
slider39:1<0,1,0.001>--Drawn path influence
slider40:1<0,50,1>--Map X descriptor
slider41:2<0,50,1>--Map Y descriptor
slider42:0.5<0,1,0.001>--Map focus X
slider43:0.5<0,1,0.001>--Map focus Y
slider44:0<0,1,0.001>--Map focus influence
slider45:0<0,255,1>--Map stratum page
slider46:0.75<0,1,0.001>--Envelope trajectory influence
slider47:2<0.2,20,0.01>--Gated path cycle (seconds)
slider48:0.35<0,1,0.001>--Role browser threshold
slider49:1<0,1,1{Off,On}>--Sample Hub duration packets
slider50:0<0,2251799813685247,1>--Locked identity descriptors (51-bit registry mask)
slider51:0.95<0,1,0.001>--Identity lock strength
slider52:1200<80,1500,1>--Adaptive playback ceiling (ms)
slider53:0.3<0,1,0.001>--Branch stereo spread
slider54:0<0,1,1{Navigate,Draw}>--Map mouse mode
slider55:4<0,4,1{Explore,Inspector,Controls,Inspector legacy,Structure}>--Interface page

// v0.8.0: source-local chronology, soft behavioural ECs, explicit durations,
// ordered member scaffolds, optional hierarchical rendering and Structure view.
// EC labels are approximate clusters; no semantic classification is asserted.
// Auto selects supported Macro/Meso/Micro levels. Learning always follows load/change.
// Bank/index reconstruction is deterministic; no playback RNG is used by learning.
// File ends are censored observations, NOT learned instructions to terminate.
// Micro analysis is still burst-sampled; no sub-tile boundary precision claimed.
slider56:5<0,6,1{Off,Inspect,Meso,Hierarchical,Reconstruct,Auto,Transfer}>--Hierarchy mode
slider57:0.8<0,1,0.001>--Behaviour target influence
slider58:0.35<0,1,0.001>--Behaviour variation
slider59:0.25<0,1,0.001>--Structure variation
slider60:0.5<0,1,0.001>--Boundary sensitivity (hierarchy rebuild)
slider61:-70<-100,-30,0.5>--Manual low-salience floor (dB; auto rebuild)
slider62:1<0.25,4,0.01>--Learned duration scale
slider63:0.5<0,1,0.001>--EC detail (hierarchy rebuild)
slider64:1<1,65536,1>--Structure / reconstruction source

@init

function cp_clamp(x a b) ( min(b,max(a,x)); );
function cp_01(x) ( cp_clamp(x,0,1); );
function cp_db(x) (20*log(max(0.000000000001,x))/log(10););
function cp_amp(x) (exp(x*log(10)/20););
function cp_frames(x) (x<0 ? x+4294967296 : x;);
function cp_rng() local(hi lo nx) (
  hi=floor(rng_state/127773); lo=rng_state-hi*127773;
  nx=16807*lo-2836*hi; nx<=0 ? nx+=2147483647;
  rng_state=nx; nx/2147483647;
);
function cp_g(id) (grain_base+id*64;);
function cp_s(id) (source_base+id*8;);
function cp_e(id) (event_base+id*64;);
function cp_w(id) (walker_base+id*64;);
function cp_v(id) (voice_base+id*32;);
// v1.5 bounded multi-child performance layer. The old 0..3 Morphology slider is
// retained only as a project-compatibility fallback until the new child count is
// explicitly touched. New events snapshot their child plan at trigger time.
function cp_child_legacy() (xc_params[12]<=0.000001 && floor(slider36)>0;);
function cp_child_count() local(n m) (
  cp_child_legacy() ? (m=floor(slider36);m==3 ? 2 : 1) : (n=floor(xc_params[12]*12+0.5);cp_clamp(n,0,12));
);
function cp_child_mode() local(m legacy) (
  legacy=cp_child_legacy();
  legacy ? (m=floor(slider36);m==1 ? 1 : (m==2 ? 2 : (m==3 ? 6 : 0))) : cp_clamp(floor(xc_params[13]*6+0.5),0,6);
);
// Internal walker kinds: 0 primary, 1 resonance, 2 debris, 3 follow,
// 4 contrast, 5 shadow, 6 fill. Mixed cycles a deterministic balanced roster.
function cp_child_kind(index mode) local(k) (
  mode==0 ? 3 : (mode==1 ? 1 : (mode==2 ? 2 : (mode==3 ? 4 : (mode==4 ? 5 : (mode==5 ? 6 : (
    k=(max(1,floor(index))-1)%6;k==0 ? 3 : (k==1 ? 1 : (k==2 ? 6 : (k==3 ? 2 : (k==4 ? 5 : 4))))
  ))))));
);
function cp_source_cells(id) local(s) (s=cp_s(id);s[6];);
function cp_valid(id) local(g ok) (
  // Low-salience is NOT silence. Keep it playable and let scoring de-prioritize it.
  // Only explicit exclusion or the hard numerical floor removes a Micro grain.
  ok=0; id>=0 && id<grain_count ? (g=cp_g(id);ok=g[9]<0.5 && g[6]>0.00001;);ok;
);
function cp_feat(id d) local(g) (g=cp_g(id); d<5 ? g[16+d] : g[51+d-5];);
function cp_member(id vertex) local(d b g) (
  g=cp_g(id);vertex==28 ? 1 : (
    vertex>=15 && vertex<19 ? g[41+vertex-15] : (
      vertex<15 ? (d=floor(vertex/3);b=vertex-d*3;) : (d=5+floor((vertex-19)/3);b=(vertex-19)%3;);
      max(0,1-abs(2*cp_feat(id,d)-b));
    );
  );
);
function cp_dim_vertex(d b) (d<5 ? d*3+b : 19+(d-5)*3+b;);
function cp_lower(lo hi key) local(mid) (
  while(lo<hi) (mid=floor((lo+hi)/2);postings[mid]<key ? lo=mid+1 : hi=mid;);lo;
);
function cp_range(vertex src) local(lo hi s) (
  vertex=cp_clamp(floor(vertex),0,28);lo=offsets[vertex];hi=offsets[vertex+1];
  src>0 ? (src<=source_count ? (
    s=cp_s(src-1);lo=cp_lower(lo,hi,s[5]);hi=cp_lower(lo,hi,s[5]+s[6]);
  ) : hi=lo;);
  range_lo=lo;range_hi=hi;hi-lo;
);
// Per-source scout data: desired window, quiet floor dB, active RMS, confidence,
// actual indexed window, capped source gain, probe interval, probe count.
function cp_auto(src) (auto_sources+src*8;);
function cp_source_gain(src) local(a) (a=cp_auto(src);slider23>=0.5 ? a[5] : 1;);
function cp_quiet_floor(src) local(a) (a=cp_auto(src);quiet_mode==0 ? 0.00001 : cp_amp(quiet_mode==2 ? quiet_db : a[1]););
// This is a LOW-SALIENCE flag, distinct from explicit exclusion and from structural REST.
function cp_quiet(id) local(g a floorv low prev p) (
  g=cp_g(id);floorv=cp_quiet_floor(g[1]);low=floorv;
  id>0 ? (p=cp_g(id-1);p[1]==g[1] && p[60]<0.5 ? low*=0.501187233627272;);
  g[60]=(g[6]<low && g[7]<floorv*3.98107170553497) || g[6]<=0.00001;
  g[60]>0.5 ? auto_quiet_n+=1;
);
// Analysis anchors and playback grains are intentionally different scales.
// Anchors preserve local descriptor resolution; emitted regions may extend into
// adjacent source material when stability supports a longer, safer splice.
function cp_play_seconds(id kind) local(g stable motion onset detail lo hi) (
  g=cp_g(id);motion=cp_feat(id,3);onset=g[41];detail=g[43];
  stable=cp_01(0.50*g[48]+0.25*(1-motion)+0.15*(1-onset)+0.10*(1-detail));
  lo=kind==0 || kind==2 ? 0.050 : 0.075;
  hi=max(lo,slider52/1000);
  cp_clamp(lo+(hi-lo)*(0.18+0.82*stable),lo,hi);
);
// Local peak bins are load-time evidence. They are used only to keep an
// expanded playback span inside one contiguous active source run; they do not
// classify quiet material as REST. Scan is bounded to neighbouring index tiles.
function cp_bin_active(id bin) local(g floorv peakv) (
  g=cp_g(id);bin=cp_clamp(floor(bin),0,15);peakv=g[24+bin];
  floorv=max(0.000003,max(cp_quiet_floor(g[1])*1.20,g[7]*0.012));
  g[9]<0.5 && peakv>floorv;
);
function cp_play_region(id kind) local(g s seconds want center abin bestbd besti b i li lb ri rb gg left right cand span start frames sid first last steps ok) (
  g=cp_g(id);sid=g[1];s=cp_s(sid);seconds=cp_play_seconds(id,kind);want=min(s[2],max(1,floor(seconds*s[3])));
  center=g[2]+g[3]*(kind==0 ? (0.18+0.68*g[40]) : 0.5);
  abin=cp_clamp(floor((center-g[2])/max(1,g[3])*16),0,15);
  !cp_bin_active(id,abin) ? (
    bestbd=100;besti=-1;i=0;loop(16,cp_bin_active(id,i) && abs(i-abin)<bestbd ? (bestbd=abs(i-abin);besti=i;);i+=1;);
    besti>=0 ? (abin=besti;center=g[2]+g[3]*(abin+0.5)/16;);
  );
  first=s[5];last=first+s[6]-1;
  // If this tile contains no active sub-bin, keep its original bounded region;
  // retrieval scoring can still de-prioritize it as low-salience.
  cp_bin_active(id,abin) ? (
    li=id;lb=abin;gg=cp_g(li);left=gg[2]+floor(gg[3]*lb/16);steps=0;ok=1;
    while(ok && steps<96 && center-left<want)(
      lb>0 ? lb-=1 : (li>first ? (li-=1;lb=15;) : ok=0;);
      ok ? (gg=cp_g(li);gg[1]==sid && cp_bin_active(li,lb) ? left=gg[2]+floor(gg[3]*lb/16) : ok=0;);steps+=1;
    );
    ri=id;rb=abin;gg=cp_g(ri);right=gg[2]+floor(gg[3]*(rb+1)/16);steps=0;ok=1;
    while(ok && steps<96 && right-center<want)(
      rb<15 ? rb+=1 : (ri<last ? (ri+=1;rb=0;) : ok=0;);
      ok ? (gg=cp_g(ri);gg[1]==sid && cp_bin_active(ri,rb) ? right=gg[2]+floor(gg[3]*(rb+1)/16) : ok=0;);steps+=1;
    );
    span=max(1,right-left);frames=min(want,span);
    start=floor(center-frames*(kind==0 ? 0.25 : 0.5));start=cp_clamp(start,left,max(left,right-frames));
    play_srcpos=cp_clamp(start,0,max(0,s[2]-frames));play_frames=max(1,min(frames,s[2]-play_srcpos));
    play_run_limited=play_frames<want;
  ) : (
    frames=min(want,g[3]);start=floor(center-frames*(kind==0 ? 0.25 : 0.5));
    play_srcpos=cp_clamp(start,g[2],max(g[2],g[2]+g[3]-frames));play_frames=max(1,frames);play_run_limited=1;
  );
);
function h_meso_floor(src) local(a base) (
  a=cp_auto(src);base=max(0.06,max(a[0],a[4]));cp_clamp(max(0.16,base*2.50),0.16,0.75);
);
// Cheap two-axis retrieval reservoirs; at most 64 actual eligible grains per bin.
function cp_path_index(id) local(d b k n slot) (
  cp_valid(id) ? (d=0;loop(8,
    b=min(15,floor(cp_feat(id,d)*16));k=d*16+b;n=path_res_counts[k];path_res_counts[k]=n+1;
    slot=n<64 ? n : ((id*127+k*8191)%max(1,n+1));
    slot<64 ? path_reservoir[k*64+slot]=id;d+=1;
  ););
);
function cp_clear_voices() (memset(voice_base,0,2048); voice_list_n=0; active_voices=0;);
function cp_clear_events() (memset(event_base,0,512);memset(walker_base,0,walker_total*64); event_count=0;);
function cp_busy() (voice_list_n;);
function cp_hold_count() local(i n e) (
  i=0;n=0;loop(8,e=cp_e(i);e[0]>0 ? n+=1;i+=1;);n;
);
function cp_stop_event(ei when fade) local(i v e w) (
  e=cp_e(ei);e[0]>0 ? (
    e[1]==record_event && when<e[10] && !replaying ? record_overflow=max(record_overflow,3);
    when<e[14] ? (e[14]=when;e[15]=max(0,fade);) : (when==e[14] ? e[15]=min(e[15],max(0,fade)););
    i=0;loop(walker_total,w=cp_w(i);w[0]>0 && w[1]==ei ? w[0]=0;i+=1;);
    i=0;loop(voice_list_n,v=cp_v(voice_list[i]);v[26]==ei && v[17]==e[1] ? (
      v[14]=min(v[14],when+fade);v[15]=max(1,fade);
    );i+=1;);
  );
);
function cp_stop_all(when fade channel) local(i e) (
  i=0;loop(8,e=cp_e(i);e[0]>0 && (channel<0 || e[3]==channel) ? cp_stop_event(i,when,fade);i+=1;);
  i=0;loop(voice_list_n,stop_v=cp_v(voice_list[i]);(channel<0 || stop_v[13]==channel) ? (
    stop_v[14]=min(stop_v[14],when+fade);stop_v[15]=max(1,fade);
  );i+=1;);
);
// ---------- v1.6.1 shared freehand curve engine ----------
// Curves are fixed 32-sample normalized shapes painted directly with the mouse.
// There are no user-visible control points. Smooth mode uses a bounded Catmull-
// Rom interpolation; Linear and Step remain available for descriptor lanes.
// The 32-sample representation is deliberate: these are event-scale retrieval
// trajectories, not audio-rate LFOs, and evaluation stays constant/bounded.
function tr_curve_eval_samples(data n interp u) local(x i q ym y0 y1 yp q2 q3 z) (
  n=cp_clamp(floor(n),2,32);interp=cp_clamp(floor(interp),0,2);u=cp_01(u);x=u*(n-1);i=min(n-2,floor(x));q=x-i;
  y0=data[i];y1=data[i+1];
  interp==2 ? y0 : (interp==1 ? y0+(y1-y0)*q : (
    ym=data[max(0,i-1)];yp=data[min(n-1,i+2)];q2=q*q;q3=q2*q;
    z=0.5*((2*y0)+(-ym+y1)*q+(2*ym-5*y0+4*y1-yp)*q2+(-ym+3*y0-3*y1+yp)*q3);cp_01(z);
  ));
);
function tr_curve_eval(base nidx interpidx u) local(n) (
  n=cp_clamp(floor(base[nidx]),2,32);tr_curve_eval_samples(base+8,n,base[interpidx],u);
);
// v1.6 point-pair evaluator retained only for one-time migration of saved v1.6.0
// projects into the freehand 32-sample representation.
function tr_curve_eval_legacy(base nidx interpidx u) local(n interp i x0 y0 x1 y1 z q) (
  n=cp_clamp(floor(base[nidx]),2,16);interp=cp_clamp(floor(base[interpidx]),0,2);u=cp_01(u);i=0;
  while(i<n-2 && u>base[8+(i+1)*2])(i+=1;);
  x0=base[8+i*2];y0=base[9+i*2];x1=base[8+(i+1)*2];y1=base[9+(i+1)*2];
  q=cp_01((u-x0)/max(0.000001,x1-x0));
  interp==2 ? y0 : (interp==0 ? (z=q*q*(3-2*q);y0+(y1-y0)*z;) : y0+(y1-y0)*q;);
);
function tr_fill_linear_samples(p start end) local(i u) (
  i=0;loop(32,u=i/31;p[8+i]=cp_01(start+(end-start)*u);i+=1;);
);
function amp_evt(i) (amp_event_base+i*40;);
function amp_custom_eval(e t ei) local(a sx u ru base val nominal edge) (
  a=amp_evt(ei);sx=cp_clamp(a[3],0.05,0.95);
  e[12]>0 ? (
    u=cp_01((t-e[5])/max(1,e[10]-e[5]));val=tr_curve_eval(a,1,2,u);
    edge=cp_01((t-e[5])/max(1,srate*0.002))*cp_01((e[10]-t)/max(1,srate*0.002));val*=edge;
  ) : (
    t<e[9] ? (
      nominal=max(1,e[49]);u=min(sx,max(0,(t-e[5])/nominal));val=tr_curve_eval(a,1,2,u);
      val*=cp_01((t-e[5])/max(1,srate*0.002));
    ) : (
      ru=cp_01((t-e[9])/max(1,e[10]-e[9]));u=sx+(1-sx)*ru;
      base=max(0.000001,tr_curve_eval(a,1,2,sx));val=e[11]*tr_curve_eval(a,1,2,u)/base;
      val*=cp_01((e[10]-t)/max(1,srate*0.002));
    );
  );cp_01(val);
);
// Analytical event envelope: late Note Off never changes samples BEFORE its timestamp.
function cp_env_pre(e t) local(x) (
  x=t<e[5] ? 0 : (t<e[6] ? (t-e[5])/max(1,e[6]-e[5]) : (
    t<e[7] ? 1-(1-e[8])*(t-e[6])/max(1,e[7]-e[6]) : e[8]
  ));
