// ---------- Snapshot-only coherence/structure/transfer controls ----------
function ui_xset(id value) (
  ui_enqueue(0,7*8192+1024+id*256+cp_clamp(floor(value*255+0.5),0,255));
);
function ui_xtip(id) (
  id==0 ? ui_tip("Enable the cached coherence model. Learning still runs upfront; Off removes its retrieval/structural costs. No neural model or semantic labels.");
  id==1 ? ui_tip("Weight cached spectral shape, stereo and endpoint compatibility during grain selection. High values favor smoother measured joins, not guaranteed phase-aligned splices.");
  id==2 ? ui_tip("Favor genuine source continuation when boundary evidence also agrees. This is a prior, not an instruction to replay the entire file.");
  id==3 ? ui_tip("Check up to four cached successors against the expected future scaffold. This is bounded context, not knowledge of future live MIDI.");
  id==4 ? ui_tip("Use locally measured pulse period/phase only when the onset pattern supports it. Noise and nonperiodic Foley are not forced onto a tempo grid.");
  id==5 ? ui_tip("Use coarse chroma and periodicity evidence only for confident tonal frames. No key, chord, instrument or polyphonic fundamental is asserted.");
  id==6 ? ui_tip("Use cached multiscale recurrence evidence in Macro boundary discovery and candidate routes. Changes to this setting take full effect after Reload analysis.");
  id==7 ? ui_tip("Required quality of guide-to-target behavioral mapping. Weak mappings are explicitly reported as approximate; output never falls back to guide audio.");
  id==8 ? ui_tip("Transfer the guide's relative energy, movement and onset contour while target recordings provide material. This is structural resynthesis, not voice conversion.");
  id==9 ? ui_tip("Blend observed second-order class transitions with first-order backoff. No unobserved transition is relabelled as observed support.");
  id==10 ? ui_tip("Maximum hold seconds for Natural mode when the corpus has no reliable ending evidence. The Inspector distinguishes a learned ending from this safety cap. Explicit MIDI duration overrides it.");
  id==11 ? ui_tip("Permit Natural events to end at internally observed closures before verified rests. File ends are censored, not assumed intentional endings.");
  id==14 ? ui_tip("Child-cloud density. Higher values shorten companion hops so children overlap more densely; Fill-gaps receives an additional continuity bias. It does not create recursive branches.");
  id==15 ? ui_tip("Timing scatter for child start offsets and hop timing. Zero is orderly; higher values decorrelate the cloud while remaining deterministic under Fixed seed mode.");
);
