  color_auto_alt_active = 0;
);
(!mouse_down && ui_active != 337 && ui_active != 336) ? (
  color_pivot_alt_active = 0;
  color_auto_alt_active = 0;
);
color_pivot_alt_use = color_pivot_alt_active || (ui_alt && (color_hot || ui_active == 337));
color_auto_alt_use = (!color_pivot_alt_use) && (color_auto_alt_active || (ui_shift && !ui_alt && (color_hot || ui_active == 336)));
color_pivot_alt_use ? (
