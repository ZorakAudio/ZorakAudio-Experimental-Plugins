  space_late_s_l = 0;
  space_late_s_r = 0;
  space_tank_energy = 0;
  space_governor_s = 1;
  space_env = 0;
  space_tail_meter = 0;
  space_mod_phase = 0;
  space_room_runtime_active = 0;
);


function reset_output_harmonics_buffers()
(
  memset(harm_lpa_l_base, 0, HARM_XOVERS);
  memset(harm_lpb_l_base, 0, HARM_XOVERS);
  memset(harm_lpa_r_base, 0, HARM_XOVERS);
  memset(harm_lpb_r_base, 0, HARM_XOVERS);
  memset(harm_band_l_base, 0, HARM_BANDS);
  memset(harm_band_r_base, 0, HARM_BANDS);
  memset(harm_env_base, 0, HARM_BANDS);
  memset(harm_dcx_l_base, 0, HARM_BANDS);
  memset(harm_dcy_l_base, 0, HARM_BANDS);
  memset(harm_dcx_r_base, 0, HARM_BANDS);
  memset(harm_dcy_r_base, 0, HARM_BANDS);
  output_harm_runtime_active = 0;
);


function reset_push_pop_buffers()
(
  memset(pop_lpa_l_base, 0, POP_XOVERS);
  memset(pop_lpb_l_base, 0, POP_XOVERS);
  memset(pop_lpa_r_base, 0, POP_XOVERS);
  memset(pop_lpb_r_base, 0, POP_XOVERS);
  memset(pop_band_l_base, 0, POP_BANDS);
  memset(pop_band_r_base, 0, POP_BANDS);
  memset(pop_fast_l_base, 0, POP_BANDS);
  memset(pop_fast_r_base, 0, POP_BANDS);
  memset(pop_mid_l_base, 0, POP_BANDS);
  memset(pop_mid_r_base, 0, POP_BANDS);
  memset(pop_slow_l_base, 0, POP_BANDS);
  memset(pop_slow_r_base, 0, POP_BANDS);
  memset(pop_env_fast_base, 0, POP_BANDS);
  memset(pop_env_slow_base, 0, POP_BANDS);
  memset(pop_floor_base, 0, POP_BANDS);
  pop_dcx_l = 0;
  pop_dcy_l = 0;
  pop_dcx_r = 0;
  pop_dcy_r = 0;
  pop_air_guard_s = 1;
  push_pop_runtime_active = 0;
);

function pop_xover_freq(idx)
(
  idx <= 0 ? 520
  : idx == 1 ? 1200
  : idx == 2 ? 3800
  : 9000;
);

function pop_band_weight(idx air_guard)
(
  idx <= 0 ? 0.04
  : idx == 1 ? 0.34
  : idx == 2 ? 1.00
  : idx == 3 ? 0.88
  : 0.30 * air_guard;
);

function pop_update_coeffs() local(i f msf msm mss)
(
  i = 0;
  while (i < POP_XOVERS) (
    f = min(pop_xover_freq(i), srate * 0.46);
    pop_xover_coeff_base[i] = clamp(1 - exp(-6.283185307179586 * f / max(srate, 1)), 0.00002, 0.98);
    i += 1;
  );

  i = 0;
  while (i < POP_BANDS) (
    i <= 0 ? (
      msf = 3.2; msm = 18; mss = 90;
    ) : i == 1 ? (
      msf = 1.8; msm = 9.5; mss = 52;
    ) : i == 2 ? (
      msf = 0.90; msm = 5.0; mss = 28;
    ) : i == 3 ? (
      msf = 0.42; msm = 2.3; mss = 14;
    ) : (
      msf = 0.28; msm = 1.4; mss = 8.0;
    );

    pop_fast_coeff_base[i] = clamp(1 - exp(-1 / max(1, floor(msf * 0.001 * srate))), 0.0001, 0.98);
    pop_mid_coeff_base[i]  = clamp(1 - exp(-1 / max(1, floor(msm * 0.001 * srate))), 0.0001, 0.72);
    pop_slow_coeff_base[i] = clamp(1 - exp(-1 / max(1, floor(mss * 0.001 * srate))), 0.00001, 0.36);
    i += 1;
  );

  pop_env_fast_att = 1 - exp(-1 / max(1, floor(0.0035 * srate)));
  pop_env_fast_rel = 1 - exp(-1 / max(1, floor(0.0400 * srate)));
  pop_env_slow_coeff = 1 - exp(-1 / max(1, floor(0.1800 * srate)));
  pop_floor_up_coeff = 1 - exp(-1 / max(1, floor(3.5000 * srate)));
  pop_floor_down_coeff = 1 - exp(-1 / max(1, floor(0.2400 * srate)));
);

function pop_dcblock_l(x) local(y)
(
  y = x - pop_dcx_l + 0.995 * pop_dcy_l;
  pop_dcx_l = x;
  pop_dcy_l = denorm_zap(y);
  pop_dcy_l;
);

function pop_dcblock_r(x) local(y)
(
  y = x - pop_dcx_r + 0.995 * pop_dcy_r;
  pop_dcx_r = x;
  pop_dcy_r = denorm_zap(y);
  pop_dcy_r;
);

function harm_xover_freq(idx)
(
  idx <= 0 ? 140
  : idx == 1 ? 260
  : idx == 2 ? 480
  : idx == 3 ? 900
  : idx == 4 ? 1700
  : idx == 5 ? 3200
  : 6200;
);

function harm_update_coeffs() local(i f)
(
  i = 0;
  while (i < HARM_XOVERS) (
    f = min(harm_xover_freq(i), srate * 0.46);
    harm_coeff_base[i] = clamp(1 - exp(-6.283185307179586 * f / max(srate, 1)), 0.00002, 0.98);
    i += 1;
  );
);

function reset_push_buffers()
(
  push_m_lp15 = 0;
  push_m_lp32 = 0;
  push_m_lp55 = 0;
  push_s_lp15 = 0;
  push_s_lp32 = 0;
  push_s_lp55 = 0;

  push_bodyE = 0;
  push_formE = 0;
  push_edgeE = 0;
  push_airE = 0;
  push_srcE = 0;
  push_m_hiE = 0;
  push_s_hiE = 0;
  push_click_fastE = 0;
  push_click_slowE = 0;

  push_common_dB = 0;
  push_side_dB = 0;
  push_hot_dB = -150;
  push_click_dB = 0;
  push_side_rel_dB = -150;
);



function reset_formant_buffers()
(
  form_lp1_l = 0; form_lp2_l = 0; form_lp3_l = 0; form_lp4_l = 0; form_lp5_l = 0;
  form_lp1_r = 0; form_lp2_r = 0; form_lp3_r = 0; form_lp4_r = 0; form_lp5_r = 0;

  form_env0 = 0; form_env1 = 0; form_env2 = 0; form_env3 = 0; form_env4 = 0; form_env5 = 0;
  form_g0 = 1; form_g1 = 1; form_g2 = 1; form_g3 = 1; form_g4 = 1; form_g5 = 1;
  form_level = 1;
);

function reset_focus_peak_buffers() local(i base)
(
  fpk_lp1_l = 0; fpk_lp2_l = 0; fpk_lp3_l = 0; fpk_lp4_l = 0;
  fpk_lp1_r = 0; fpk_lp2_r = 0; fpk_lp3_r = 0; fpk_lp4_r = 0;
  fpk_env0 = 0; fpk_env1 = 0; fpk_env2 = 0; fpk_env3 = 0; fpk_env4 = 0;
  fpk_g0 = 1; fpk_g1 = 1; fpk_g2 = 1; fpk_g3 = 1; fpk_g4 = 1;
  fpk_level = 1;

  i = 0;
  while (i < FPK_BANDS) (
    fpk_env_base[i] = 0;
    fpk_gain_base[i] = 0;
    fpk_band_l_base[i] = 0;
    fpk_band_r_base[i] = 0;
    base = i * FPK_BQ_STRIDE;
    fpk_bq_base[base + 5] = 0;
    fpk_bq_base[base + 6] = 0;
    fpk_bq_base[base + 7] = 0;
    fpk_bq_base[base + 8] = 0;
    i += 1;
  );
);


function reset_color_tilt_buffers() local(i)
(
  i = 0;
  while (i < COLOR_TILT_XOVERS) (
    color_tilt_lp_l_base[i] = 0;
    color_tilt_lp_r_base[i] = 0;
    i += 1;
  );
  i = 0;
  while (i < COLOR_TILT_BANDS) (
    color_tilt_pre_base[i] = 0;
    color_tilt_post_base[i] = 0;
    color_tilt_env_f_base[i] = 0;
    color_tilt_env_s_base[i] = 0;
    i += 1;
  );
  color_tilt_global_gain = 1;
  color_tilt_runtime_active = 0;
);

function color_tilt_erb_from_hz(f)
(
  21.4 * log(0.00437 * max(0, f) + 1) * LOG10_INV;
);

function color_tilt_hz_from_erb(e)
(
  (exp((e / 21.4) * log(10)) - 1) / 0.00437;
);

function color_tilt_a_weight_amp(f) local(f2 num den1 den2 den3 ra)
(
  f = max(1, f);
  f2 = f * f;
  num = (12200 * 12200) * (f2 * f2);
  den1 = f2 + (20.6 * 20.6);
  den2 = sqrt((f2 + (107.7 * 107.7)) * (f2 + (737.9 * 737.9)));
  den3 = f2 + (12200 * 12200);
  ra = num / max(0.000000000001, den1 * den2 * den3);
  ra * 1.2589254117941673;
);

function color_tilt_auto_pivot_hz() local(br sh t)
(
  // Bank brightness is the sampler's spectral-centroid-like summary. Use it as
  // the auto hinge so a dark bank tilts around body, while a bright bank tilts
  // around upper presence/air.
  sample_count <= 0 ? 1000 : (
    br = clamp01(bank_brightness);
    sh = clamp01(bank_sharpness);
    t = clamp01(br * 0.88 + sh * 0.12);
    t = t ^ 1.08;
    exp(lerp(log(280), log(6500), t));
  );
);

function color_tilt_effective_pivot_hz()
(
  color_pivot_hz < 0 ? color_tilt_auto_pivot_hz() : clamp(abs(color_pivot_hz), 20, min(20000, srate * 0.49));
);

function color_pivot_norm_to_hz(n)
(
  exp(lerp(log(20), log(20000), clamp01(n)));
);

function color_pivot_hz_to_norm(f)
(
  clamp01((log(clamp(f, 20, 20000)) - log(20)) / max(0.000001, log(20000) - log(20)));
);

function color_tilt_update_coeffs() local(i erb_c fc aw erb_b f a nyq work_srate)
(
  work_srate = max(1000, srate);
  nyq = work_srate * 0.5;
  color_tilt_fmax = min(20000, nyq * 0.98);
  color_tilt_fmax < 40 ? color_tilt_fmax = 40;

  color_tilt_erb_min = color_tilt_erb_from_hz(20);
  color_tilt_erb_max = color_tilt_erb_from_hz(color_tilt_fmax);
  color_tilt_erb_range = max(0.000001, color_tilt_erb_max - color_tilt_erb_min);

  i = 0;
  while (i < COLOR_TILT_BANDS) (
    erb_c = color_tilt_erb_min + (i + 0.5) * color_tilt_erb_range / COLOR_TILT_BANDS;
    fc = clamp(color_tilt_hz_from_erb(erb_c), 20, color_tilt_fmax);
    color_tilt_erb_base[i] = erb_c;
    color_tilt_fc_base[i] = fc;
    aw = color_tilt_a_weight_amp(fc);
    color_tilt_weight_base[i] = aw * aw;
    i += 1;
  );

  i = 0;
  while (i < COLOR_TILT_XOVERS) (
    erb_b = color_tilt_erb_min + (i + 1) * color_tilt_erb_range / COLOR_TILT_BANDS;
    f = clamp(color_tilt_hz_from_erb(erb_b), 10, nyq * 0.98);
    a = exp(-6.283185307179586 * f / work_srate);
    color_tilt_coeff_base[i] = clamp(a, 0.000001, 0.999999);
    i += 1;
  );

  color_tilt_energy_coeff = 1 - exp(-1 / max(1, floor(0.300 * work_srate)));
  color_tilt_rough_fast_coeff = 1 - exp(-1 / max(1, floor(0.008 * work_srate)));
  color_tilt_rough_slow_coeff = 1 - exp(-1 / max(1, floor(0.080 * work_srate)));
  color_tilt_gain_coeff = 1 - exp(-1 / max(1, floor(0.120 * work_srate)));
);

function color_tilt_recalc_gains() local(i pivot erb_pivot slope gdB)
(
  pivot = color_tilt_effective_pivot_hz();
  erb_pivot = color_tilt_erb_from_hz(pivot);
  slope = (2 * color_tilt_db) / max(0.000001, color_tilt_erb_range);
  i = 0;
  while (i < COLOR_TILT_BANDS) (
    gdB = slope * (color_tilt_erb_base[i] - erb_pivot);
    gdB = clamp(gdB, -24, 24);
    color_tilt_gain_base[i] = db2amp(gdB);
    i += 1;
  );
);

function apply_color_erb_tilt() local(
  inL inR outTL outTR i a lpL lpR prevL prevR bandL bandR yL yR idx
  amp mod sat pre post g Lpre Lpost target level
)
(
  inL = outL;
  inR = outR;

  abs(color_tilt_db) <= 0.0001 ? (
    color_tilt_runtime_active > 0 ? reset_color_tilt_buffers();
  ) : (
    color_tilt_runtime_active = 1;

    outTL = 0;
    outTR = 0;
    prevL = 0;
    prevR = 0;

    i = 0;
    while (i < COLOR_TILT_XOVERS) (
      a = color_tilt_coeff_base[i];
      lpL = denorm_zap((1 - a) * inL + a * color_tilt_lp_l_base[i]);
      lpR = denorm_zap((1 - a) * inR + a * color_tilt_lp_r_base[i]);
      color_tilt_lp_l_base[i] = lpL;
      color_tilt_lp_r_base[i] = lpR;

      bandL = i == 0 ? lpL : (lpL - prevL);
      bandR = i == 0 ? lpR : (lpR - prevR);
      prevL = lpL;
      prevR = lpR;

      pre = 0.5 * (bandL * bandL + bandR * bandR);
      color_tilt_pre_base[i] = denorm_zap(color_tilt_pre_base[i] + (pre - color_tilt_pre_base[i]) * color_tilt_energy_coeff);

      g = color_tilt_gain_base[i];
      yL = bandL * g;
      yR = bandR * g;

      color_tilt_fc_base[i] > COLOR_TILT_ROUGH_START ? (
        amp = 0.5 * (abs(yL) + abs(yR));
        color_tilt_env_f_base[i] = denorm_zap(color_tilt_env_f_base[i] + (amp - color_tilt_env_f_base[i]) * color_tilt_rough_fast_coeff);
        color_tilt_env_s_base[i] = denorm_zap(color_tilt_env_s_base[i] + (amp - color_tilt_env_s_base[i]) * color_tilt_rough_slow_coeff);
        mod = max(0, (color_tilt_env_f_base[i] - color_tilt_env_s_base[i]) / max(color_tilt_env_s_base[i], 0.000001));
        // Fixed Roughness Guard = 50%. It activates only when upper-band rough AM is detected.
        sat = 0.50 * mod * 6;
        yL = yL / (1 + sat * abs(yL));
        yR = yR / (1 + sat * abs(yR));
      );

      post = 0.5 * (yL * yL + yR * yR);
      color_tilt_post_base[i] = denorm_zap(color_tilt_post_base[i] + (post - color_tilt_post_base[i]) * color_tilt_energy_coeff);
      outTL += yL;
      outTR += yR;
      i += 1;
    );

    idx = COLOR_TILT_BANDS - 1;
    bandL = inL - prevL;
    bandR = inR - prevR;
    pre = 0.5 * (bandL * bandL + bandR * bandR);
    color_tilt_pre_base[idx] = denorm_zap(color_tilt_pre_base[idx] + (pre - color_tilt_pre_base[idx]) * color_tilt_energy_coeff);

    g = color_tilt_gain_base[idx];
    yL = bandL * g;
    yR = bandR * g;
    color_tilt_fc_base[idx] > COLOR_TILT_ROUGH_START ? (
      amp = 0.5 * (abs(yL) + abs(yR));
      color_tilt_env_f_base[idx] = denorm_zap(color_tilt_env_f_base[idx] + (amp - color_tilt_env_f_base[idx]) * color_tilt_rough_fast_coeff);
      color_tilt_env_s_base[idx] = denorm_zap(color_tilt_env_s_base[idx] + (amp - color_tilt_env_s_base[idx]) * color_tilt_rough_slow_coeff);
      mod = max(0, (color_tilt_env_f_base[idx] - color_tilt_env_s_base[idx]) / max(color_tilt_env_s_base[idx], 0.000001));
      sat = 0.50 * mod * 6;
      yL = yL / (1 + sat * abs(yL));
      yR = yR / (1 + sat * abs(yR));
    );
    post = 0.5 * (yL * yL + yR * yR);
    color_tilt_post_base[idx] = denorm_zap(color_tilt_post_base[idx] + (post - color_tilt_post_base[idx]) * color_tilt_energy_coeff);
    outTL += yL;
    outTR += yR;

    // Fixed loudness compensation = 100%, using A-weighted ERB-band energy.
    Lpre = 0;
    Lpost = 0;
    i = 0;
    while (i < COLOR_TILT_BANDS) (
      Lpre += color_tilt_weight_base[i] * color_tilt_pre_base[i];
      Lpost += color_tilt_weight_base[i] * color_tilt_post_base[i];
      i += 1;
    );
    target = sqrt((Lpre + 0.0000000001) / (Lpost + 0.0000000001));
    target = clamp(target, 0.25, 4);
    color_tilt_global_gain = denorm_zap(color_tilt_global_gain + (target - color_tilt_global_gain) * color_tilt_gain_coeff);
    level = clamp(color_tilt_global_gain, 0.25, 4);
    outL = denorm_zap(outTL * level);
    outR = denorm_zap(outTR * level);
  );
);


function reset_processing_buffers() local(i total)
(
  proc_hpf1_l = 0; proc_hpf2_l = 0;
  proc_hpf1_r = 0; proc_hpf2_r = 0;
  proc_lpf1_l = 0; proc_lpf2_l = 0;
  proc_lpf1_r = 0; proc_lpf2_r = 0;

  posteq_solo_z1_l = 0; posteq_solo_z2_l = 0;
  posteq_solo_z1_r = 0; posteq_solo_z2_r = 0;
  posteq_solo_mix = 0;
  posteq_solo_mode_latched = 0;

  i = 0;
  while (i < POSTEQ_SPEC_BINS) (
    posteq_spec_lp_base[i] = 0;
    posteq_spec_z2_base[i] = 0;
    posteq_pre_rz1_base[i] = 0;
    posteq_pre_rz2_base[i] = 0;
    posteq_spec_env_base[i] = 0;
    posteq_post_z1_base[i] = 0;
    posteq_post_z2_base[i] = 0;
    posteq_post_rz1_base[i] = 0;
    posteq_post_rz2_base[i] = 0;
    posteq_post_env_base[i] = 0;
    i += 1;
  );

  i = 0;
  while (i < POSTEQ_BQ_COUNT) (
    posteq_bq_base[i * POSTEQ_BQ_STRIDE + 5] = 0;
    posteq_bq_base[i * POSTEQ_BQ_STRIDE + 6] = 0;
    posteq_bq_base[i * POSTEQ_BQ_STRIDE + 7] = 0;
    posteq_bq_base[i * POSTEQ_BQ_STRIDE + 8] = 0;
    i += 1;
  );

  i = 0;
  while (i < POSTEQ_CHAR_BQ_COUNT) (
    posteq_char_bq_base[i * POSTEQ_CHAR_BQ_STRIDE + 5] = 0;
    posteq_char_bq_base[i * POSTEQ_CHAR_BQ_STRIDE + 6] = 0;
    posteq_char_bq_base[i * POSTEQ_CHAR_BQ_STRIDE + 7] = 0;
    posteq_char_bq_base[i * POSTEQ_CHAR_BQ_STRIDE + 8] = 0;
    i += 1;
  );
);

function posteq_slope_db(idx)
(
  idx <= 0 ? 6 : idx * 12;
);

function posteq_cut_q_norm(q)
(
  clamp01((clamp(q, 0.35, 4.0) - 0.707) / max(0.000001, 4.0 - 0.707));
);

function posteq_cut_filter_q(q)
(
  // Keep cascaded HPF/LPF stages stable. Resonance is handled by the explicit
  // cutoff-peak stage below, so high Q no longer turns steep filters brittle.
  q = clamp(q, 0.35, 4.0);
  q <= 0.707 ? q : clamp(0.707 + (q - 0.707) * 0.12, 0.707, 1.10);
);

function posteq_cut_res_gain_db(q) local(n)
(
  n = posteq_cut_q_norm(q);
  n <= 0 ? 0 : 12.0 * (n ^ 0.72);
);

function posteq_cut_res_peak_q(q) local(n)
(
  n = posteq_cut_q_norm(q);
  clamp(0.55 + n * 5.25, 0.55, 5.80);
);

function posteq_cut_res_resp_db(freq cf q) local(n amt width octv)
(
  // Visual model for HPF/LPF resonance. This is deliberately the same concept
  // as the DSP: Q raises a narrow-ish peak at the cutoff instead of silently
  // changing a hidden biquad parameter.
  amt = posteq_cut_res_gain_db(q);
  amt <= 0.0001 ? 0 : (
    n = posteq_cut_q_norm(q);
    octv = log(max(20, freq) / max(20, cf)) / log(2);
    width = lerp(0.72, 0.16, n);
    amt * exp(-(octv * octv) / max(0.000001, 2 * width * width));
  );
);

function posteq_bq_identity(slot) local(base)
(
  base = slot * POSTEQ_BQ_STRIDE;
  posteq_bq_base[base + 0] = 1;
  posteq_bq_base[base + 1] = 0;
  posteq_bq_base[base + 2] = 0;
  posteq_bq_base[base + 3] = 0;
  posteq_bq_base[base + 4] = 0;
);

function posteq_bq_set_peak(slot freq q gain_db) local(base A w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  base = slot * POSTEQ_BQ_STRIDE;
  abs(gain_db) < 0.000001 ? (
    posteq_bq_identity(slot);
  ) : (
    freq = clamp(freq, 20, min(20000, srate * 0.49));
    q = clamp(q, 0.35, 8);
    A = exp(gain_db * 0.05756462732485114); // 10^(dB/40)
    w0 = 6.283185307179586 * freq / max(srate, 1);
    sn = sin(w0);
    cs = cos(w0);
    alpha = sn / max(0.000001, 2 * q);

    b0 = 1 + alpha * A;
    b1 = -2 * cs;
    b2 = 1 - alpha * A;
    a0 = 1 + alpha / A;
    a1 = -2 * cs;
    a2 = 1 - alpha / A;

    posteq_bq_base[base + 0] = b0 / a0;
    posteq_bq_base[base + 1] = b1 / a0;
    posteq_bq_base[base + 2] = b2 / a0;
    posteq_bq_base[base + 3] = a1 / a0;
    posteq_bq_base[base + 4] = a2 / a0;
  );
);

function posteq_bq_set_highpass(slot freq q) local(base w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  base = slot * POSTEQ_BQ_STRIDE;
  freq = clamp(freq, 20, min(20000, srate * 0.49));
  q = clamp(q, 0.35, 4.0);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);
  b0 = (1 + cs) * 0.5;
  b1 = -(1 + cs);
  b2 = (1 + cs) * 0.5;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;
  posteq_bq_base[base + 0] = b0 / a0;
  posteq_bq_base[base + 1] = b1 / a0;
  posteq_bq_base[base + 2] = b2 / a0;
  posteq_bq_base[base + 3] = a1 / a0;
  posteq_bq_base[base + 4] = a2 / a0;
);

function posteq_bq_set_lowpass(slot freq q) local(base w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  base = slot * POSTEQ_BQ_STRIDE;
  freq = clamp(freq, 20, min(20000, srate * 0.49));
  q = clamp(q, 0.35, 4.0);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);
  b0 = (1 - cs) * 0.5;
  b1 = 1 - cs;
  b2 = (1 - cs) * 0.5;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;
  posteq_bq_base[base + 0] = b0 / a0;
  posteq_bq_base[base + 1] = b1 / a0;
  posteq_bq_base[base + 2] = b2 / a0;
  posteq_bq_base[base + 3] = a1 / a0;
  posteq_bq_base[base + 4] = a2 / a0;
);

function posteq_bq_process_l(slot x) local(base y)
(
  base = slot * POSTEQ_BQ_STRIDE;
  y = posteq_bq_base[base + 0] * x + posteq_bq_base[base + 5];
  posteq_bq_base[base + 5] = denorm_zap(posteq_bq_base[base + 1] * x - posteq_bq_base[base + 3] * y + posteq_bq_base[base + 6]);
  posteq_bq_base[base + 6] = denorm_zap(posteq_bq_base[base + 2] * x - posteq_bq_base[base + 4] * y);
  denorm_zap(y);
);

function posteq_bq_process_r(slot x) local(base y)
(
  base = slot * POSTEQ_BQ_STRIDE;
  y = posteq_bq_base[base + 0] * x + posteq_bq_base[base + 7];
  posteq_bq_base[base + 7] = denorm_zap(posteq_bq_base[base + 1] * x - posteq_bq_base[base + 3] * y + posteq_bq_base[base + 8]);
  posteq_bq_base[base + 8] = denorm_zap(posteq_bq_base[base + 2] * x - posteq_bq_base[base + 4] * y);
  denorm_zap(y);
);


function posteq_char_bq_set_band(slot freq q) local(base w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  base = slot * POSTEQ_CHAR_BQ_STRIDE;
  freq = clamp(freq, 35, min(18000, srate * 0.46));
  q = clamp(q, 0.45, 6.0);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);

  // Constant-skirt bandpass extractor used only for nonlinear character.
  b0 = alpha;
  b1 = 0;
  b2 = -alpha;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;

  posteq_char_bq_base[base + 0] = b0 / a0;
  posteq_char_bq_base[base + 1] = b1 / a0;
  posteq_char_bq_base[base + 2] = b2 / a0;
  posteq_char_bq_base[base + 3] = a1 / a0;
  posteq_char_bq_base[base + 4] = a2 / a0;
);

function posteq_char_bq_process_l(slot x) local(base y)
(
  base = slot * POSTEQ_CHAR_BQ_STRIDE;
  y = posteq_char_bq_base[base + 0] * x + posteq_char_bq_base[base + 5];
  posteq_char_bq_base[base + 5] = denorm_zap(posteq_char_bq_base[base + 1] * x - posteq_char_bq_base[base + 3] * y + posteq_char_bq_base[base + 6]);
  posteq_char_bq_base[base + 6] = denorm_zap(posteq_char_bq_base[base + 2] * x - posteq_char_bq_base[base + 4] * y);
  y;
);

function posteq_char_bq_process_r(slot x) local(base y)
(
  base = slot * POSTEQ_CHAR_BQ_STRIDE;
  y = posteq_char_bq_base[base + 0] * x + posteq_char_bq_base[base + 7];
  posteq_char_bq_base[base + 7] = denorm_zap(posteq_char_bq_base[base + 1] * x - posteq_char_bq_base[base + 3] * y + posteq_char_bq_base[base + 8]);
  posteq_char_bq_base[base + 8] = denorm_zap(posteq_char_bq_base[base + 2] * x - posteq_char_bq_base[base + 4] * y);
  y;
);

function posteq_topology_shape(x topo) local(ax y)
(
  ax = abs(x);
  topo <= 0 ? x
  : topo == 1 ? (
    // Transistor-ish: slightly asymmetric forward grit, still residual/parallel.
    y = x + 0.18 * x * x - 0.10 * x * x * x;
    y / (1 + abs(y) * 0.62);
  ) : (
    // Diode-ish: rounder/smoother, compresses hard edges more than it crunches.
    y = x / sqrt(1 + x * x * 1.45);
    y + 0.055 * (x * x / (1 + ax * 1.8) - 0.18 * x);
  );
);

function posteq_char_mode(slot)
(
  slot == 0 ? posteq_hpf_char
  : slot == 1 ? posteq_b1_char
  : slot == 2 ? posteq_b2_char
  : slot == 3 ? posteq_b3_char
  : posteq_lpf_char;
);

function posteq_char_drive(slot)
(
  slot == 0 ? posteq_hpf_drive
  : slot == 1 ? posteq_b1_drive
  : slot == 2 ? posteq_b2_drive
  : slot == 3 ? posteq_b3_drive
  : posteq_lpf_drive;
);

function posteq_set_char_var(slot val)
(
  val = clamp(val | 0, 0, 2);
  slot == 0 ? posteq_hpf_char = val
  : slot == 1 ? posteq_b1_char = val
  : slot == 2 ? posteq_b2_char = val
  : slot == 3 ? posteq_b3_char = val
  : posteq_lpf_char = val;
);

function posteq_set_drive_var(slot val)
(
  // v61: store Drive as the live per-filter front buffer. The hidden pack is
  // now just persistence, not the value source for the currently selected band.
  // Quantize to 0.5 dB to keep the packed host parameter stable and independent
  // per filter. This fixes Drive snapping to another band's value while editing.
  val = clamp(floor(clamp(val, 0, 24) * 2 + 0.5) * 0.5, 0, 24);
  slot == 0 ? posteq_hpf_drive = val
  : slot == 1 ? posteq_b1_drive = val
  : slot == 2 ? posteq_b2_drive = val
  : slot == 3 ? posteq_b3_drive = val
  : posteq_lpf_drive = val;
);

function posteq_pack_char_state() local(p)
(
  p = 0;
  p = pack_set_base(p, 0, 3, posteq_hpf_char);
  p = pack_set_base(p, 1, 3, posteq_b1_char);
  p = pack_set_base(p, 2, 3, posteq_b2_char);
  p = pack_set_base(p, 3, 3, posteq_b3_char);
  p = pack_set_base(p, 4, 3, posteq_lpf_char);
  p;
);

function posteq_pack_drive_state() local(p)
(
  p = floor(posteq_hpf_drive * 2 + 0.5);
  p += 49 * floor(posteq_b1_drive * 2 + 0.5);
  p += 2401 * floor(posteq_b2_drive * 2 + 0.5);
  p;
);

function posteq_pack_drive_upper()
(
  floor(posteq_b3_drive * 2 + 0.5) + 49 * floor(posteq_lpf_drive * 2 + 0.5);
);

function posteq_update_char_active()
(
  posteq_char_active = ((posteq_hpf_char > 0 && posteq_hpf_drive > 0.0001)
    || (posteq_b1_char > 0 && posteq_b1_drive > 0.0001)
    || (posteq_b2_char > 0 && posteq_b2_drive > 0.0001)
    || (posteq_b3_char > 0 && posteq_b3_drive > 0.0001)
    || (posteq_lpf_char > 0 && posteq_lpf_drive > 0.0001)) ? 1 : 0;
);

function posteq_apply_character_band(slot l r) local(topo drive driveamp invdrive wet bpL bpR shL shR resL resR air_guard)
(
  topo = posteq_char_mode(slot);
  drive = posteq_char_drive(slot);
  (topo > 0 && drive > 0.0001) ? (
    bpL = posteq_char_bq_process_l(slot, l + denorm_guard);
    bpR = posteq_char_bq_process_r(slot, r - denorm_guard);
    driveamp = db2amp(drive);
    invdrive = 1 / max(driveamp, 0.000001);
    wet = clamp01((drive / 24) ^ 0.72);

    shL = posteq_topology_shape(bpL * driveamp, topo) * invdrive;
    shR = posteq_topology_shape(bpR * driveamp, topo) * invdrive;

    resL = shL - bpL;
    resR = shR - bpR;

    // High-band diode is meant to smooth clicky brightness, not add fizz.
    air_guard = slot >= 3 ? (topo == 2 ? 0.78 : 0.62) : 1;
    posteq_char_wet = max(posteq_char_wet, wet * max(abs(resL), abs(resR)) * 8);
    outL += denorm_zap(resL * wet * air_guard);
    outR += denorm_zap(resR * wet * air_guard);
  );
);

function apply_posteq_character() local(l r)
(
  posteq_char_wet = 0;
  l = outL;
  r = outR;
  posteq_apply_character_band(0, l, r);
  posteq_apply_character_band(1, l, r);
  posteq_apply_character_band(2, l, r);
  posteq_apply_character_band(3, l, r);
  posteq_apply_character_band(4, l, r);
  outL = denorm_zap(outL);
  outR = denorm_zap(outR);
);

function posteq_spec_bq_set_band(bin freq q) local(base w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  // Analyzer-only constant-peak bandpass. This replaces the old adjacent
  // lowpass-difference display, which was broad enough to read as one fat blob.
  base = (bin | 0) * POSTEQ_SPEC_COEFFS;
  freq = clamp(freq, 28, min(19000, srate * 0.49));
  q = clamp(q, 1.0, 10.0);

  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);

  b0 = alpha;
  b1 = 0;
  b2 = -alpha;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;

  posteq_spec_coeff_base[base + 0] = b0 / a0;
  posteq_spec_coeff_base[base + 1] = b1 / a0;
  posteq_spec_coeff_base[base + 2] = b2 / a0;
  posteq_spec_coeff_base[base + 3] = a1 / a0;
  posteq_spec_coeff_base[base + 4] = a2 / a0;
);

function posteq_update_analyzer_coeffs() local(i norm cf specq)
(
  (posteq_analyzer_coeff_srate != srate || posteq_analyzer_coeff_base != posteq_spec_coeff_base) ? (
  i = 0;
  while (i < POSTEQ_SPEC_BINS) (
    norm = i / max(1, POSTEQ_SPEC_BINS - 1);
    cf = exp(log(32) + norm * (log(19000) - log(32)));
    // Wider lows, tighter highs. Enough resolution to show useful pockets,
    // not so much that the tiny panel becomes a nervous FFT waterfall.
    specq = lerp(2.20, 6.25, norm ^ 0.72);
    posteq_spec_bq_set_band(i, cf, specq);
    i += 1;
  );
    posteq_analyzer_coeff_srate = srate;
    posteq_analyzer_coeff_base = posteq_spec_coeff_base;
  );
);

function posteq_update_coeffs() local(cutq)
(
  cutq = posteq_cut_filter_q(proc_hpf_q);
  posteq_bq_set_highpass(0, proc_hpf_hz, cutq);
  posteq_bq_set_highpass(1, proc_hpf_hz, cutq);
  posteq_bq_set_highpass(2, proc_hpf_hz, cutq);
  posteq_bq_set_highpass(3, proc_hpf_hz, cutq);

  posteq_bq_set_peak(4, proc_eq_band1_hz, proc_eq_band1_q, proc_eq_band1_db);
  posteq_bq_set_peak(5, proc_eq_band2_hz, proc_eq_band2_q, proc_eq_band2_db);
  posteq_bq_set_peak(6, proc_eq_band3_hz, proc_eq_band3_q, proc_eq_band3_db);

  cutq = posteq_cut_filter_q(proc_lpf_q);
  posteq_bq_set_lowpass(7, proc_lpf_hz, cutq);
  posteq_bq_set_lowpass(8, proc_lpf_hz, cutq);
  posteq_bq_set_lowpass(9, proc_lpf_hz, cutq);
  posteq_bq_set_lowpass(10, proc_lpf_hz, cutq);

  posteq_hpf_res_db = (proc_hpf_hz > 22) ? posteq_cut_res_gain_db(proc_hpf_q) : 0;
  posteq_lpf_res_db = (proc_lpf_hz < min(19000, srate * 0.47)) ? posteq_cut_res_gain_db(proc_lpf_q) : 0;
  posteq_bq_set_peak(11, proc_hpf_hz, posteq_cut_res_peak_q(proc_hpf_q), posteq_hpf_res_db);
  posteq_bq_set_peak(12, proc_lpf_hz, posteq_cut_res_peak_q(proc_lpf_q), posteq_lpf_res_db);

  // Analyzer coefficients do not depend on EQ settings. Do not rebuild them
  // for hidden visualizations or ordinary parameter automation.
  posteq_analyzer_active ? posteq_update_analyzer_coeffs();

  posteq_char_bq_set_band(0, max(70, proc_hpf_hz * 1.25), clamp(proc_hpf_q, 0.45, 4));
  posteq_char_bq_set_band(1, proc_eq_band1_hz, proc_eq_band1_q);
  posteq_char_bq_set_band(2, proc_eq_band2_hz, proc_eq_band2_q);
  posteq_char_bq_set_band(3, proc_eq_band3_hz, proc_eq_band3_q);
  posteq_char_bq_set_band(4, min(16000, max(1200, proc_lpf_hz * 0.72)), clamp(proc_lpf_q, 0.45, 4));
);

function posteq_zero_pre_spectrum() local(i)
(
  i = 0;
  while (i < POSTEQ_SPEC_BINS) (
    posteq_spec_lp_base[i] = 0;
    posteq_spec_z2_base[i] = 0;
    posteq_pre_rz1_base[i] = 0;
    posteq_pre_rz2_base[i] = 0;
    posteq_spec_env_base[i] = 0;
    i += 1;
  );
);

function posteq_zero_post_spectrum() local(i)
(
  i = 0;
  while (i < POSTEQ_SPEC_BINS) (
    posteq_post_z1_base[i] = 0;
    posteq_post_z2_base[i] = 0;
    posteq_post_rz1_base[i] = 0;
    posteq_post_rz2_base[i] = 0;
    posteq_post_env_base[i] = 0;
    i += 1;
  );
);

function posteq_zero_filter_states() local(i base)
(
  proc_hpf1_l = 0; proc_hpf2_l = 0;
  proc_hpf1_r = 0; proc_hpf2_r = 0;
  proc_lpf1_l = 0; proc_lpf2_l = 0;
  proc_lpf1_r = 0; proc_lpf2_r = 0;
  i = 0;
  while (i < POSTEQ_BQ_COUNT) (
    base = i * POSTEQ_BQ_STRIDE;
    posteq_bq_base[base + 5] = 0;
    posteq_bq_base[base + 6] = 0;
    posteq_bq_base[base + 7] = 0;
    posteq_bq_base[base + 8] = 0;
    i += 1;
  );
  i = 0;
  while (i < POSTEQ_CHAR_BQ_COUNT) (
    base = i * POSTEQ_CHAR_BQ_STRIDE;
    posteq_char_bq_base[base + 5] = 0;
    posteq_char_bq_base[base + 6] = 0;
    posteq_char_bq_base[base + 7] = 0;
    posteq_char_bq_base[base + 8] = 0;
    i += 1;
  );
);

function posteq_analyze_spectrum(l r) local(i base y yr z1 z2 det env)
(
  max(abs(l), abs(r)) < DENORM_AUDIO_FLOOR ? posteq_pre_silent += 1 : posteq_pre_silent = 0;
  posteq_pre_silent == DENORM_ANALYZER_HOLD ? posteq_zero_pre_spectrum();
  posteq_pre_silent < DENORM_ANALYZER_HOLD ? (
    i = 0;
    while (i < POSTEQ_SPEC_BINS) (
      base = i * POSTEQ_SPEC_COEFFS;
      y = posteq_spec_coeff_base[base] * l + posteq_spec_lp_base[i];
      posteq_spec_lp_base[i] = denorm_zap(posteq_spec_coeff_base[base + 1] * l - posteq_spec_coeff_base[base + 3] * y + posteq_spec_z2_base[i]);
      posteq_spec_z2_base[i] = denorm_zap(posteq_spec_coeff_base[base + 2] * l - posteq_spec_coeff_base[base + 4] * y);
      yr = posteq_spec_coeff_base[base] * r + posteq_pre_rz1_base[i];
      posteq_pre_rz1_base[i] = denorm_zap(posteq_spec_coeff_base[base + 1] * r - posteq_spec_coeff_base[base + 3] * yr + posteq_pre_rz2_base[i]);
      posteq_pre_rz2_base[i] = denorm_zap(posteq_spec_coeff_base[base + 2] * r - posteq_spec_coeff_base[base + 4] * yr);
      det = sqrt(0.5 * (y * y + yr * yr));
      env = posteq_spec_env_base[i];
      posteq_spec_env_base[i] = denorm_zap(env + (det - env) * (det > env ? posteq_spec_att_coeff : posteq_spec_rel_coeff));
      i += 1;
    );
  ) : posteq_pre_silent = DENORM_ANALYZER_HOLD + 1;
);


function posteq_analyze_post_spectrum(l r) local(i base y yr z1 z2 det env)
(
  max(abs(l), abs(r)) < DENORM_AUDIO_FLOOR ? posteq_post_silent += 1 : posteq_post_silent = 0;
  posteq_post_silent == DENORM_ANALYZER_HOLD ? posteq_zero_post_spectrum();
  posteq_post_silent < DENORM_ANALYZER_HOLD ? (
    i = 0;
    while (i < POSTEQ_SPEC_BINS) (
      base = i * POSTEQ_SPEC_COEFFS;
      y = posteq_spec_coeff_base[base] * l + posteq_post_z1_base[i];
      posteq_post_z1_base[i] = denorm_zap(posteq_spec_coeff_base[base + 1] * l - posteq_spec_coeff_base[base + 3] * y + posteq_post_z2_base[i]);
      posteq_post_z2_base[i] = denorm_zap(posteq_spec_coeff_base[base + 2] * l - posteq_spec_coeff_base[base + 4] * y);
      yr = posteq_spec_coeff_base[base] * r + posteq_post_rz1_base[i];
      posteq_post_rz1_base[i] = denorm_zap(posteq_spec_coeff_base[base + 1] * r - posteq_spec_coeff_base[base + 3] * yr + posteq_post_rz2_base[i]);
      posteq_post_rz2_base[i] = denorm_zap(posteq_spec_coeff_base[base + 2] * r - posteq_spec_coeff_base[base + 4] * yr);
      det = sqrt(0.5 * (y * y + yr * yr));
      env = posteq_post_env_base[i];
      posteq_post_env_base[i] = denorm_zap(env + (det - env) * (det > env ? posteq_spec_att_coeff : posteq_spec_rel_coeff));
      i += 1;
    );
  ) : posteq_post_silent = DENORM_ANALYZER_HOLD + 1;
);


function posteq_solo_zero()
(
  posteq_solo_z1_l = 0; posteq_solo_z2_l = 0;
  posteq_solo_z1_r = 0; posteq_solo_z2_r = 0;
);

function posteq_solo_set_identity()
(
  posteq_solo_b0 = 1;
  posteq_solo_b1 = 0;
  posteq_solo_b2 = 0;
  posteq_solo_a1 = 0;
  posteq_solo_a2 = 0;
);

function posteq_solo_set_lowpass(freq q) local(w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  freq = clamp(freq, 20, min(20000, srate * 0.49));
  q = clamp(q, 0.45, 4.0);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);
  b0 = (1 - cs) * 0.5;
  b1 = 1 - cs;
  b2 = (1 - cs) * 0.5;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;
  posteq_solo_b0 = b0 / a0;
  posteq_solo_b1 = b1 / a0;
  posteq_solo_b2 = b2 / a0;
  posteq_solo_a1 = a1 / a0;
  posteq_solo_a2 = a2 / a0;
);

function posteq_solo_set_highpass(freq q) local(w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  freq = clamp(freq, 20, min(20000, srate * 0.49));
  q = clamp(q, 0.45, 4.0);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);
  b0 = (1 + cs) * 0.5;
  b1 = -(1 + cs);
  b2 = (1 + cs) * 0.5;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;
  posteq_solo_b0 = b0 / a0;
  posteq_solo_b1 = b1 / a0;
  posteq_solo_b2 = b2 / a0;
  posteq_solo_a1 = a1 / a0;
  posteq_solo_a2 = a2 / a0;
);

function posteq_solo_set_bandpass(freq q) local(w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  freq = clamp(freq, 20, min(20000, srate * 0.49));
  q = clamp(q, 0.45, 12.0);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);
  b0 = alpha;
  b1 = 0;
  b2 = -alpha;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;
  posteq_solo_b0 = b0 / a0;
  posteq_solo_b1 = b1 / a0;
  posteq_solo_b2 = b2 / a0;
  posteq_solo_a1 = a1 / a0;
  posteq_solo_a2 = a2 / a0;
);

function posteq_solo_refresh() local(mode freq q kind)
(
  mode = posteq_solo_target > 0 ? posteq_solo_target : posteq_solo_mode_latched;
  mode = clamp(mode | 0, 0, 5);
  mode > 0 ? posteq_solo_mode_latched = mode;

  mode <= 0 ? (
    posteq_solo_set_identity();
  ) : (
    mode == 1 ? (
      kind = 1; freq = slider38; q = max(0.60, slider45);
    ) : mode == 2 ? (
      kind = 2; freq = slider35; q = slider40;
    ) : mode == 3 ? (
      kind = 2; freq = slider36; q = slider41;
    ) : mode == 4 ? (
      kind = 2; freq = slider37; q = slider42;
    ) : (
      kind = 3; freq = slider39; q = max(0.60, slider46);
    );

    (kind != posteq_solo_kind_last || abs(freq - posteq_solo_freq_last) > 0.01 || abs(q - posteq_solo_q_last) > 0.0001) ? (
      kind == 1 ? posteq_solo_set_lowpass(freq, q)
      : kind == 3 ? posteq_solo_set_highpass(freq, q)
      : posteq_solo_set_bandpass(freq, q);
      posteq_solo_kind_last = kind;
      posteq_solo_freq_last = freq;
      posteq_solo_q_last = q;
    );
  );
);

function posteq_solo_process_l(x) local(y)
(
  y = posteq_solo_b0 * x + posteq_solo_z1_l;
  posteq_solo_z1_l = denorm_zap(posteq_solo_b1 * x - posteq_solo_a1 * y + posteq_solo_z2_l);
  posteq_solo_z2_l = denorm_zap(posteq_solo_b2 * x - posteq_solo_a2 * y);
  denorm_zap(y);
);

function posteq_solo_process_r(x) local(y)
(
  y = posteq_solo_b0 * x + posteq_solo_z1_r;
  posteq_solo_z1_r = denorm_zap(posteq_solo_b1 * x - posteq_solo_a1 * y + posteq_solo_z2_r);
  posteq_solo_z2_r = denorm_zap(posteq_solo_b2 * x - posteq_solo_a2 * y);
  denorm_zap(y);
);

function apply_posteq_solo() local(target coeff soloL soloR gain mode)
(
  target = posteq_solo_target > 0 ? 1 : 0;
  coeff = target ? 0.085 : 0.045;
  posteq_solo_mix += (target - posteq_solo_mix) * coeff;
  posteq_solo_mix = clamp01(posteq_solo_mix);

  (posteq_solo_mix > 0.0001 || target > 0) ? (
    posteq_solo_refresh();
    soloL = posteq_solo_process_l(outL + denorm_guard);
    soloR = posteq_solo_process_r(outR - denorm_guard);
    mode = posteq_solo_mode_latched | 0;
    gain = (mode == 1 || mode == 5) ? 1.65 : 2.35;
    outL = denorm_zap(lerp(outL, soloL * gain, posteq_solo_mix));
    outR = denorm_zap(lerp(outR, soloR * gain, posteq_solo_mix));
  ) : (
    posteq_solo_mix = 0;
    posteq_solo_mode_latched = 0;
    posteq_solo_zero();
  );
);

function apply_posteq_filter() local(xL xR idx count)
(
  xL = outL + denorm_guard;
  xR = outR - denorm_guard;

  proc_hpf_hz > 22 ? (
    proc_hpf_slope_idx <= 0 ? (
      proc_hpf1_l = denorm_zap(proc_hpf1_l + (xL - proc_hpf1_l) * proc_hpf_coeff);
      proc_hpf1_r = denorm_zap(proc_hpf1_r + (xR - proc_hpf1_r) * proc_hpf_coeff);
      xL = xL - proc_hpf1_l;
      xR = xR - proc_hpf1_r;
    ) : (
      count = min(4, proc_hpf_slope_idx);
      idx = 0;
      while (idx < count) (
        xL = posteq_bq_process_l(idx, xL);
        xR = posteq_bq_process_r(idx, xR);
        idx += 1;
      );
    );
    posteq_hpf_res_db > 0.0001 ? (
      xL = posteq_bq_process_l(11, xL);
      xR = posteq_bq_process_r(11, xR);
    );
  );

  abs(proc_eq_band1_db) > 0.000001 ? (
    xL = posteq_bq_process_l(4, xL);
    xR = posteq_bq_process_r(4, xR);
  );
  abs(proc_eq_band2_db) > 0.000001 ? (
    xL = posteq_bq_process_l(5, xL);
    xR = posteq_bq_process_r(5, xR);
  );
  abs(proc_eq_band3_db) > 0.000001 ? (
    xL = posteq_bq_process_l(6, xL);
    xR = posteq_bq_process_r(6, xR);
  );

  proc_lpf_hz < min(19000, srate * 0.47) ? (
    posteq_lpf_res_db > 0.0001 ? (
      xL = posteq_bq_process_l(12, xL);
      xR = posteq_bq_process_r(12, xR);
    );
    proc_lpf_slope_idx <= 0 ? (
      proc_lpf1_l = denorm_zap(proc_lpf1_l + (xL - proc_lpf1_l) * proc_lpf_coeff);
      proc_lpf1_r = denorm_zap(proc_lpf1_r + (xR - proc_lpf1_r) * proc_lpf_coeff);
      xL = proc_lpf1_l;
      xR = proc_lpf1_r;
    ) : (
      count = min(4, proc_lpf_slope_idx);
      idx = 0;
      while (idx < count) (
        xL = posteq_bq_process_l(7 + idx, xL);
        xR = posteq_bq_process_r(7 + idx, xR);
        idx += 1;
      );
    );
  );

  outL = denorm_zap(xL);
  outR = denorm_zap(xR);
  denorm_near_silence(outL, outR) ? (
    posteq_filter_silent += 1;
    posteq_filter_silent == DENORM_ANALYZER_HOLD ? posteq_zero_filter_states();
    posteq_filter_silent > DENORM_ANALYZER_HOLD ? posteq_filter_silent = DENORM_ANALYZER_HOLD;
  ) : (
    posteq_filter_silent = 0;
  );
);

function apply_processing_strip()
(
  (proc_hpf_hz > 22 || proc_lpf_hz < min(19000, srate * 0.47) || abs(proc_eq_band1_db) > 0.0001 || abs(proc_eq_band2_db) > 0.0001 || abs(proc_eq_band3_db) > 0.0001) ? apply_posteq_filter();
  posteq_char_active ? apply_posteq_character();
  (posteq_solo_target > 0 || posteq_solo_mix > 0.0001) ? apply_posteq_solo();
);


function clean_scrub_gain(idx det amount bias) local(
  fast slow floorv floor_target noise snr_margin clear under stable bed
  noise_cut bed_cut min_g tgt g upc
)
(
  // v40 CleanScrub: SNR-aware per-band noise/bed suppression.
  // The old Clean was a polite expander. This version distinguishes clear signal
  // from sustained low-SNR bed/hiss and becomes intentionally obvious near max.
  det = max(det, 0);

  fast = clean_env_base[idx];
  fast += (det - fast) * (det > fast ? clean_env_att_coeff : clean_env_rel_coeff);
  fast = denorm_zap(fast);
  clean_env_base[idx] = fast;

  slow = clean_slow_base[idx];
  slow += (det - slow) * (det > slow ? clean_slow_att_coeff : clean_slow_rel_coeff);
  slow = denorm_zap(slow);
  clean_slow_base[idx] = slow;

  // Adaptive noise floor: rises slowly with sustained bed, falls faster so stale
  // floor estimates do not eat new dry hits. It is capped below the live envelope.
  floor_target = min(slow * 0.92 + det * 0.08, fast * 0.78 + clean_abs_floor);
  floorv = clean_floor_base[idx];
  floorv += (floor_target - floorv) * (floor_target > floorv ? clean_floor_up_coeff : clean_floor_down_coeff);
  floorv = denorm_zap(clamp(floorv, clean_abs_floor, fast * 0.86 + clean_abs_floor));
  clean_floor_base[idx] = floorv;

  noise = max(floorv, clean_abs_floor);
  snr_margin = lerp(3.60, 1.22, amount);
  clear = clamp01((fast - noise * snr_margin) / max(fast + noise * snr_margin, 0.000000000001));
  under = 1 - clear;

  // Stable/sustained bands are more likely to be room bed, hiss, or static.
  // Transients have fast >> slow and are protected by both clear and global protect.
  stable = clamp01(slow / max(fast + 0.000000000001, clean_abs_floor));
  bed = clamp01((stable - lerp(0.82, 0.46, amount)) / max(0.0001, lerp(0.30, 0.48, amount)));

  min_g = clean_min_gain;
  noise_cut = amount * bias * under * (0.36 + 0.88 * amount);
  bed_cut   = amount * bias * bed   * (0.12 + 0.76 * amount);

  tgt = 1 - noise_cut - bed_cut;
  // If the band is clearly above its floor, preserve it. This prevents Clean from
  // acting like a crude static EQ on healthy signal.
  tgt = lerp(tgt, 1, clear * lerp(0.28, 0.64, 1 - amount));
  tgt = clamp(tgt, min_g, 1);

  g = clean_gain_base[idx];
  upc = amount < 0.02 ? clean_gain_protect_coeff : clean_gain_up_coeff;
  g += (tgt - g) * (tgt < g ? clean_gain_down_coeff : upc);
  g = denorm_zap(clamp(g, min_g, 1));
  clean_gain_base[idx] = g;
  g;
);

function apply_cleaner() local(
  inL inR dryL dryR
  b0l b1l b2l b3l b4l b0r b1r b2r b3r b4r
  d0 d1 d2 d3 d4 totalD hf_ratio air_ratio hiss_bias
  protect amount tail_region clean_power
  g0 g1 g2 g3 g4 air_trim pres_trim wetL wetR wetmix dryE wetE level
)
(
  // v40 CleanScrub: transient-safe de-noise/de-bed. It targets sustained low-SNR
  // material, top hiss, and static tail beds harder than the old broad expander.
  inL = outL;
  inR = outR;
  dryL = inL;
  dryR = inR;

  inL += denorm_guard;
  inR -= denorm_guard;

  clean_lp1_l = denorm_zap(clean_lp1_l + (inL - clean_lp1_l) * clean_lp_c1);
  clean_lp2_l = denorm_zap(clean_lp2_l + (inL - clean_lp2_l) * clean_lp_c2);
  clean_lp3_l = denorm_zap(clean_lp3_l + (inL - clean_lp3_l) * clean_lp_c3);
  clean_lp4_l = denorm_zap(clean_lp4_l + (inL - clean_lp4_l) * clean_lp_c4);

  clean_lp1_r = denorm_zap(clean_lp1_r + (inR - clean_lp1_r) * clean_lp_c1);
  clean_lp2_r = denorm_zap(clean_lp2_r + (inR - clean_lp2_r) * clean_lp_c2);
  clean_lp3_r = denorm_zap(clean_lp3_r + (inR - clean_lp3_r) * clean_lp_c3);
  clean_lp4_r = denorm_zap(clean_lp4_r + (inR - clean_lp4_r) * clean_lp_c4);

  b0l = clean_lp1_l;
  b1l = clean_lp2_l - clean_lp1_l;
  b2l = clean_lp3_l - clean_lp2_l;
  b3l = clean_lp4_l - clean_lp3_l;
  b4l = inL - clean_lp4_l;

  b0r = clean_lp1_r;
  b1r = clean_lp2_r - clean_lp1_r;
  b2r = clean_lp3_r - clean_lp2_r;
  b3r = clean_lp4_r - clean_lp3_r;
  b4r = inR - clean_lp4_r;

  d0 = max(abs(b0l), abs(b0r)) * 0.62 + abs(0.5 * (b0l + b0r)) * 0.38;
  d1 = max(abs(b1l), abs(b1r)) * 0.62 + abs(0.5 * (b1l + b1r)) * 0.38;
  d2 = max(abs(b2l), abs(b2r)) * 0.62 + abs(0.5 * (b2l + b2r)) * 0.38;
  d3 = max(abs(b3l), abs(b3r)) * 0.62 + abs(0.5 * (b3l + b3r)) * 0.38;
  d4 = max(abs(b4l), abs(b4r)) * 0.62 + abs(0.5 * (b4l + b4r)) * 0.38;

  protect = clamp01(transient_guard_s * (0.92 + 0.08 * trans_mode_mix) + clean_head_bus * 0.95);
  tail_region = clamp01(clean_tail_bus * 0.92 + room_tail_bus * 0.18);
  amount = clamp01(clean_amt * (1 - protect));
  amount = clamp01(amount * (1 + tail_region * (0.34 + 0.42 * clean_amt)));
  clean_power = clean_amt ^ 1.35;

  totalD = d0 + d1 + d2 + d3 + d4 + 0.000000000001;
  hf_ratio = clamp01((d3 + d4) / totalD);
  air_ratio = clamp01(d4 / max(d2 + d3 + d4 + 0.000000000001, 0.000000000001));
  hiss_bias = clamp01((hf_ratio - 0.30) / 0.55) * clamp01((air_ratio - 0.34) / 0.46);

  // Lows are deliberately conservative; upper bands are allowed to scrub hard.
  g0 = clean_scrub_gain(0, d0, amount, 0.16);
  g1 = clean_scrub_gain(1, d1, amount, 0.48);
  g2 = clean_scrub_gain(2, d2, amount, 0.86);
  g3 = clean_scrub_gain(3, d3, amount, 1.22 + hiss_bias * 0.22);
  g4 = clean_scrub_gain(4, d4, amount, 1.58 + hiss_bias * 0.42);

  // Extra hiss/static trim only when the spectrum actually looks top-heavy and
  // the user is asking for strong cleanup. This keeps ordinary dark material safe.
  air_trim = 1 - hiss_bias * amount * (0.10 + 0.62 * clean_power);
  pres_trim = 1 - hiss_bias * amount * (0.04 + 0.26 * clean_power);
  g3 = clamp(g3 * pres_trim, clean_min_gain, 1);
  g4 = clamp(g4 * air_trim, clean_min_gain, 1);

  wetL = b0l * g0 + b1l * g1 + b2l * g2 + b3l * g3 + b4l * g4;
  wetR = b0r * g0 + b1r * g1 + b2r * g2 + b3r * g3 + b4r * g4;

  // Keep the correction from becoming only a volume drop. This is deliberately
  // mild; high Clean should still sound obviously cleaned, not normalized away.
  dryE = dryL*dryL + dryR*dryR + 0.000000000001;
  wetE = wetL*wetL + wetR*wetR + 0.000000000001;
  level = clamp(sqrt(dryE / wetE), 0.76, 1.12);
  level = lerp(1, level, 0.24 + 0.18 * clean_amt);
  wetL *= level;
  wetR *= level;

  wetmix = amount <= 0.0001 ? 0 : clamp01(0.30 + 0.70 * amount);
  outL = denorm_zap(lerp(dryL, wetL, wetmix));
  outR = denorm_zap(lerp(dryR, wetR, wetmix));
);

function apply_room_tame() local(
  inL inR det eps
  b0l b1l b2l b3l b4l b0r b1r b2r b3r b4r
  d0 d1 d2 d3 d4
  late0 late1 late2 late3 late4 late_raw late_s
  mid1 side1 mid2 side2 mid3 side3 side4 sideE midE side_rel diffuse diffuse_s
  protect tail_region amount base_amt room_power
  a0 a1 a2 a3 a4
  target0 target1 target2 target3 target4 side_target side_trim
  dryL dryR wetL wetR wetmix artifact_guard
)
(
  // v39 RoomScrub: transient-protected multiband de-room/de-smear.
  // The old path was deliberately mild. This one detects late/diffuse energy per band,
  // trims low-mid/presence room wash harder, narrows roomy side smear, and backs off
  // quickly around attacks. High values are intentionally obvious rather than subtle.
  inL = outL;
  inR = outR;
  eps = 0.000000000001;

  room_lp1_l = denorm_zap(room_lp1_l + (inL - room_lp1_l) * room_lp_c1);
  room_lp2_l = denorm_zap(room_lp2_l + (inL - room_lp2_l) * room_lp_c2);
  room_lp3_l = denorm_zap(room_lp3_l + (inL - room_lp3_l) * room_lp_c3);
  room_lp4_l = denorm_zap(room_lp4_l + (inL - room_lp4_l) * room_lp_c4);

  room_lp1_r = denorm_zap(room_lp1_r + (inR - room_lp1_r) * room_lp_c1);
  room_lp2_r = denorm_zap(room_lp2_r + (inR - room_lp2_r) * room_lp_c2);
  room_lp3_r = denorm_zap(room_lp3_r + (inR - room_lp3_r) * room_lp_c3);
  room_lp4_r = denorm_zap(room_lp4_r + (inR - room_lp4_r) * room_lp_c4);

  b0l = room_lp1_l;
  b1l = room_lp2_l - room_lp1_l;
  b2l = room_lp3_l - room_lp2_l;
  b3l = room_lp4_l - room_lp3_l;
  b4l = inL - room_lp4_l;

  b0r = room_lp1_r;
  b1r = room_lp2_r - room_lp1_r;
  b2r = room_lp3_r - room_lp2_r;
  b3r = room_lp4_r - room_lp3_r;
  b4r = inR - room_lp4_r;

  d0 = max(abs(b0l), abs(b0r)) * 0.58 + abs(0.5 * (b0l + b0r)) * 0.42;
  d1 = max(abs(b1l), abs(b1r)) * 0.58 + abs(0.5 * (b1l + b1r)) * 0.42;
  d2 = max(abs(b2l), abs(b2r)) * 0.58 + abs(0.5 * (b2l + b2r)) * 0.42;
  d3 = max(abs(b3l), abs(b3r)) * 0.58 + abs(0.5 * (b3l + b3r)) * 0.42;
  d4 = max(abs(b4l), abs(b4r)) * 0.58 + abs(0.5 * (b4l + b4r)) * 0.42;

  det = max(abs(inL), abs(inR)) * 0.54 + abs(0.5 * (inL + inR)) * 0.46;
  room_fast_env = denorm_zap(room_fast_env + (det - room_fast_env) * (det > room_fast_env ? room_env_att_coeff : room_env_fast_rel_coeff));
  room_slow_env = denorm_zap(room_slow_env + (det - room_slow_env) * (det > room_slow_env ? room_env_slow_att_coeff : room_env_slow_rel_coeff));

  room_b0_fast = denorm_zap(room_b0_fast + (d0 - room_b0_fast) * (d0 > room_b0_fast ? room_band_att_coeff : room_band_fast_rel_coeff));
  room_b1_fast = denorm_zap(room_b1_fast + (d1 - room_b1_fast) * (d1 > room_b1_fast ? room_band_att_coeff : room_band_fast_rel_coeff));
  room_b2_fast = denorm_zap(room_b2_fast + (d2 - room_b2_fast) * (d2 > room_b2_fast ? room_band_att_coeff : room_band_fast_rel_coeff));
  room_b3_fast = denorm_zap(room_b3_fast + (d3 - room_b3_fast) * (d3 > room_b3_fast ? room_band_att_coeff : room_band_fast_rel_coeff));
  room_b4_fast = denorm_zap(room_b4_fast + (d4 - room_b4_fast) * (d4 > room_b4_fast ? room_band_att_coeff : room_band_fast_rel_coeff));

  room_b0_slow = denorm_zap(room_b0_slow + (d0 - room_b0_slow) * (d0 > room_b0_slow ? room_band_slow_att_coeff : room_band_slow_rel_coeff));
  room_b1_slow = denorm_zap(room_b1_slow + (d1 - room_b1_slow) * (d1 > room_b1_slow ? room_band_slow_att_coeff : room_band_slow_rel_coeff));
  room_b2_slow = denorm_zap(room_b2_slow + (d2 - room_b2_slow) * (d2 > room_b2_slow ? room_band_slow_att_coeff : room_band_slow_rel_coeff));
  room_b3_slow = denorm_zap(room_b3_slow + (d3 - room_b3_slow) * (d3 > room_b3_slow ? room_band_slow_att_coeff : room_band_slow_rel_coeff));
  room_b4_slow = denorm_zap(room_b4_slow + (d4 - room_b4_slow) * (d4 > room_b4_slow ? room_band_slow_att_coeff : room_band_slow_rel_coeff));

  late0 = clamp01((room_b0_slow - room_b0_fast) / max(room_b0_slow, eps));
  late1 = clamp01((room_b1_slow - room_b1_fast) / max(room_b1_slow, eps));
  late2 = clamp01((room_b2_slow - room_b2_fast) / max(room_b2_slow, eps));
  late3 = clamp01((room_b3_slow - room_b3_fast) / max(room_b3_slow, eps));
  late4 = clamp01((room_b4_slow - room_b4_fast) / max(room_b4_slow, eps));
  late_raw = clamp01((room_slow_env - room_fast_env) / max(room_slow_env, eps));
  late_raw = clamp01(max(late_raw, late1 * 0.70 + late2 * 0.85 + late3 * 0.48 + late4 * 0.20));
  room_late_s = denorm_zap(room_late_s + (late_raw - room_late_s) * (late_raw > room_late_s ? room_late_att_coeff : room_late_rel_coeff));
  late_s = room_late_s;

  mid1 = 0.5 * (b1l + b1r); side1 = 0.5 * (b1l - b1r);
  mid2 = 0.5 * (b2l + b2r); side2 = 0.5 * (b2l - b2r);
  mid3 = 0.5 * (b3l + b3r); side3 = 0.5 * (b3l - b3r);
  side4 = 0.5 * (b4l - b4r);
  sideE = side1*side1 + side2*side2 + side3*side3 + side4*side4;
  midE = mid1*mid1 + mid2*mid2 + mid3*mid3 + eps;
  side_rel = sideE / max(sideE + midE, eps);
  diffuse = clamp01((side_rel - 0.16) / 0.62);
  room_diffuse_s = denorm_zap(room_diffuse_s + (diffuse - room_diffuse_s) * (diffuse > room_diffuse_s ? room_late_att_coeff : room_late_rel_coeff));
  diffuse_s = room_diffuse_s;

  protect = clamp01(transient_guard_s * (0.98 + 0.12 * trans_mode_mix) + room_head_bus * 1.10);
  tail_region = clamp01(room_tail_bus * 0.92 + late_s * (0.42 + 0.45 * room_amt) + diffuse_s * late_s * 0.42);
  room_power = room_amt ^ 0.78;
  base_amt = room_power * (1 - protect) * tail_region;
  // fail-fast: above the midpoint, the knob moves from useful restraint into obvious de-rooming.
  amount = clamp01(base_amt * (0.82 + 0.55 * room_amt + 0.70 * max(0, room_amt - 0.50)));

  a0 = clamp01(amount * (0.20 + 0.52 * late0 + 0.10 * diffuse_s));
  a1 = clamp01(amount * (0.42 + 1.38 * late1 + 0.44 * diffuse_s + 0.12 * late_s));
  a2 = clamp01(amount * (0.36 + 1.30 * late2 + 0.38 * diffuse_s + 0.10 * late_s));
  a3 = clamp01(amount * (0.22 + 0.86 * late3 + 0.30 * diffuse_s));
  a4 = clamp01(amount * (0.10 + 0.48 * late4 + 0.14 * diffuse_s));

  target0 = max(room_min_gain0, db2amp(-(0.8 + 4.6 * room_amt) * a0));
  target1 = max(room_min_gain1, db2amp(-(2.2 + 18.0 * room_amt) * a1));
  target2 = max(room_min_gain2, db2amp(-(1.8 + 15.5 * room_amt) * a2));
  target3 = max(room_min_gain3, db2amp(-(0.9 + 9.8 * room_amt) * a3));
  target4 = max(room_min_gain4, db2amp(-(0.4 + 5.4 * room_amt) * a4));

  room_g0 = denorm_zap(room_g0 + (target0 - room_g0) * (target0 < room_g0 ? room_gain_down_coeff : room_gain_up_coeff));
  room_g1 = denorm_zap(room_g1 + (target1 - room_g1) * (target1 < room_g1 ? room_gain_down_coeff : room_gain_up_coeff));
  room_g2 = denorm_zap(room_g2 + (target2 - room_g2) * (target2 < room_g2 ? room_gain_down_coeff : room_gain_up_coeff));
  room_g3 = denorm_zap(room_g3 + (target3 - room_g3) * (target3 < room_g3 ? room_gain_down_coeff : room_gain_up_coeff));
  room_g4 = denorm_zap(room_g4 + (target4 - room_g4) * (target4 < room_g4 ? room_gain_down_coeff : room_gain_up_coeff));

  side_target = db2amp(-(1.0 + 11.0 * room_amt) * clamp01(amount * (0.16 + 0.92 * diffuse_s + 0.45 * late_s)));
  side_target = clamp(side_target, db2amp(-(1.0 + 12.0 * room_amt)), 1);
  room_side_g = denorm_zap(room_side_g + (side_target - room_side_g) * (side_target < room_side_g ? room_gain_down_coeff : room_gain_up_coeff));
  side_trim = clamp01(1 - room_side_g);

  side1 *= room_side_g * (1 - side_trim * 0.28);
  side2 *= room_side_g;
  side3 *= room_side_g * (1 - side_trim * 0.18);

  wetL = b0l * room_g0 + (mid1 + side1) * room_g1 + (mid2 + side2) * room_g2 + (mid3 + side3) * room_g3 + b4l * room_g4;
  wetR = b0r * room_g0 + (mid1 - side1) * room_g1 + (mid2 - side2) * room_g2 + (mid3 - side3) * room_g3 + b4r * room_g4;

  // Keep high settings obvious, but avoid turning uncertain full-range material into gated rubble.
  artifact_guard = clamp01(0.30 + late_s * 0.44 + diffuse_s * 0.22 + room_tail_bus * 0.24 + room_amt * 0.22);
  wetmix = clamp01(0.52 + room_amt * 0.48);
  wetmix *= artifact_guard;
  outL = denorm_zap(lerp(inL, wetL, wetmix));
  outR = denorm_zap(lerp(inR, wetR, wetmix));
);

function space_softclip(x)
(
  x / (1 + abs(x) * 0.42);
);

function space_tap_l(delay_samps) local(d idx)
(
  d = clamp(floor(delay_samps), 1, SPACE_BUF_LEN - 2) | 0;
  idx = (space_pos - d) & SPACE_BUF_MASK;
  space_l_base[idx];
);

function space_tap_r(delay_samps) local(d idx)
(
  d = clamp(floor(delay_samps), 1, SPACE_BUF_LEN - 2) | 0;
  idx = (space_pos - d) & SPACE_BUF_MASK;
  space_r_base[idx];
);

function apply_space_verb() local(
  dryL dryR amount char amt ch base_size pred early_scale late_scale wet_gain
  send_amt low_hz damp_hz low_c damp_c fb maxd
  dE1 dE2 dE3 d1 d2 d3 d4 d5 d6
  eL eR l1L l1R l2L l2R l3L l3R l4L l4R l5L l5R l6L l6R
  lateL lateR writeL writeR verbL verbR vmid vside width modv taildet
  earlyInL earlyInR lateInL lateInR sendL sendR bodyL bodyR
  in_att in_rel tank_hot governor_target governor send_drive late_drive early_drive
)
(
  // v57 SpaceVerb SoftRollback: keep the v54 voice-envelope send architecture
  // and shared tank, but undo the v55 audibility boost/fallback feed that made
  // Space too loud and forward. Voice envelopes feed the room; the room output
  // is not sidechain-ducked or hard-tied to the voice envelope.
  dryL = outL;
  dryR = outR;
  amount = clamp01(space_room_amt);
  char = clamp01(space_room_char);
  amt = amount ^ 1.18;
  ch = char;

  // Character maps from tight early room to wide/dark long bloom.
  base_size = lerp(0.42, 1.82, ch ^ 1.35) * lerp(0.82, 1.24, amt);
  pred = srate * lerp(0.004, 0.046, ch ^ 1.25);

  dE1 = pred + srate * lerp(0.0065, 0.018, ch);
  dE2 = pred + srate * lerp(0.0130, 0.034, ch);
  dE3 = pred + srate * lerp(0.0240, 0.057, ch);

  d1 = srate * 0.061 * base_size + pred;
  d2 = srate * 0.083 * base_size + pred;
  d3 = srate * 0.127 * base_size + pred;
  d4 = srate * 0.181 * base_size + pred;
  d5 = srate * 0.293 * base_size + pred;
  d6 = srate * 0.421 * base_size + pred;
  maxd = SPACE_BUF_LEN - 4;
  d1 = min(d1, maxd); d2 = min(d2, maxd); d3 = min(d3, maxd);
  d4 = min(d4, maxd); d5 = min(d5, maxd); d6 = min(d6, maxd);

  eL = space_tap_l(dE1) * 0.48 + space_tap_r(dE2) * 0.26 + space_tap_l(dE3) * 0.18;
  eR = space_tap_r(dE1 * 1.07) * 0.48 + space_tap_l(dE2 * 0.93) * 0.26 + space_tap_r(dE3 * 1.11) * 0.18;

  l1L = space_tap_l(d1);       l1R = space_tap_r(d1 * 1.09);
  l2L = space_tap_l(d2 * 1.03); l2R = space_tap_r(d2 * 0.97);
  l3L = space_tap_l(d3 * 0.91); l3R = space_tap_r(d3 * 1.06);
  l4L = space_tap_l(d4 * 1.07); l4R = space_tap_r(d4 * 0.94);
  l5L = space_tap_l(d5 * 0.98); l5R = space_tap_r(d5 * 1.04);
  l6L = space_tap_l(d6 * 1.03); l6R = space_tap_r(d6 * 0.96);

  lateL = l1R * 0.34 + l2L * 0.28 - l3R * 0.22 + l4L * 0.18 + l5R * 0.12 - l6L * 0.08;
  lateR = l1L * 0.34 + l2R * 0.28 - l3L * 0.22 + l4R * 0.18 + l5L * 0.12 - l6R * 0.08;

  damp_hz = lerp(9200, 1250, ch ^ 0.82);
  damp_c = clamp(1 - exp(-6.283185307179586 * min(damp_hz, srate * 0.45) / max(srate, 1)), 0.0002, 0.92);
  space_damp_l = denorm_zap(space_damp_l + (lateL - space_damp_l) * damp_c);
  space_damp_r = denorm_zap(space_damp_r + (lateR - space_damp_r) * damp_c);

  // Smooth cross-voice send changes. This is the anti-click / anti-pump layer;
  // it is not output ducking. Fast attacks still enter the space quickly.
  in_att = clamp(1 - exp(-6.90775527898214 / max(1, floor(srate * lerp(0.0025, 0.0090, ch)))), 0.001, 1);
  in_rel = clamp(1 - exp(-6.90775527898214 / max(1, floor(srate * lerp(0.0550, 0.2100, ch)))), 0.00002, 1);
  earlyInL = space_early_bus_l;
  earlyInR = space_early_bus_r;
  lateInL = space_late_bus_l;
  lateInR = space_late_bus_r;
  space_early_s_l = denorm_zap(space_early_s_l + (earlyInL - space_early_s_l) * (abs(earlyInL) > abs(space_early_s_l) ? in_att : in_rel));
  space_early_s_r = denorm_zap(space_early_s_r + (earlyInR - space_early_s_r) * (abs(earlyInR) > abs(space_early_s_r) ? in_att : in_rel));
  space_late_s_l  = denorm_zap(space_late_s_l  + (lateInL  - space_late_s_l)  * (abs(lateInL)  > abs(space_late_s_l)  ? in_att * 0.72 : in_rel));
  space_late_s_r  = denorm_zap(space_late_s_r  + (lateInR  - space_late_s_r)  * (abs(lateInR)  > abs(space_late_s_r)  ? in_att * 0.72 : in_rel));

  // Keep subs mostly dry; Space is body/air/room, not a low-end mud generator.
  sendL = space_early_s_l * lerp(0.68, 0.36, ch) + space_late_s_l * lerp(0.46, 0.84, ch);
  sendR = space_early_s_r * lerp(0.68, 0.36, ch) + space_late_s_r * lerp(0.46, 0.84, ch);
  low_hz = lerp(135, 310, ch);
  low_c = clamp(1 - exp(-6.283185307179586 * low_hz / max(srate, 1)), 0.0001, 0.16);
  space_low_l = denorm_zap(space_low_l + (sendL - space_low_l) * low_c);
  space_low_r = denorm_zap(space_low_r + (sendR - space_low_r) * low_c);
  bodyL = sendL - space_low_l * lerp(0.42, 0.72, ch);
  bodyR = sendR - space_low_r * lerp(0.42, 0.72, ch);

  // Tail-energy governor. This reduces new excitation/feedback only when the
  // shared tank is already overloaded; it does not duck the audible verb output.
  space_tank_energy = denorm_zap(space_tank_energy + (space_tail_meter - space_tank_energy) * (space_tail_meter > space_tank_energy ? 0.006 : 0.0012));
  tank_hot = clamp01((space_tank_energy - lerp(0.24, 0.46, 1 - amt)) / max(0.0001, lerp(0.54, 0.28, amt)));
  governor_target = 1 - tank_hot * lerp(0.18, 0.48, amt) * lerp(0.65, 1.05, ch);
  governor_target = clamp(governor_target, 0.48, 1);
  space_governor_s = denorm_zap(space_governor_s + (governor_target - space_governor_s) * (governor_target < space_governor_s ? 0.0035 : 0.0008));
  governor = clamp(space_governor_s, 0.44, 1);

  early_drive = amt * lerp(0.72, 0.30, ch);
  late_drive = amt * lerp(0.28, 0.95, ch ^ 0.82);
  send_drive = (early_drive + late_drive) * 0.62 * governor;

  fb = clamp(lerp(0.34, 0.865, ch ^ 1.18) * lerp(0.78, 1.08, amt) * lerp(1.0, 0.84, tank_hot), 0.12, 0.895);
  modv = sin(space_mod_phase) * srate * 0.00075 * amt * clamp01((ch - 0.38) / 0.62);
  space_mod_phase += 6.283185307179586 * lerp(0.045, 0.155, ch) / max(srate, 1);
  space_mod_phase > 6.283185307179586 ? space_mod_phase -= 6.283185307179586;

  writeL = bodyL * send_drive
         + (space_damp_r * 0.62 + space_damp_l * 0.20 + space_tap_r(min(maxd, d4 + modv)) * 0.10) * fb;
  writeR = bodyR * send_drive
         + (space_damp_l * 0.62 + space_damp_r * 0.20 + space_tap_l(min(maxd, d4 - modv)) * 0.10) * fb;

  writeL = denorm_zap(space_softclip(writeL));
  writeR = denorm_zap(space_softclip(writeR));
  space_l_base[space_pos] = writeL;
  space_r_base[space_pos] = writeR;
  space_pos = (space_pos + 1) & SPACE_BUF_MASK;

  early_scale = amt * lerp(0.38, 0.15, ch);
  late_scale  = amt * lerp(0.12, 0.86, ch ^ 0.88);
  verbL = eL * early_scale + (lateL * 0.45 + space_damp_l * 0.78) * late_scale;
  verbR = eR * early_scale + (lateR * 0.45 + space_damp_r * 0.78) * late_scale;

  vmid = 0.5 * (verbL + verbR);
  vside = 0.5 * (verbL - verbR);
  width = lerp(0.05, 1.05, ch) * amt;
  vside *= 1 + width;
  verbL = vmid + vside;
  verbR = vmid - vside;

  wet_gain = lerp(0.78, 1.50, amt) * lerp(0.90, 1.12, ch);
  verbL = space_softclip(verbL * wet_gain);
  verbR = space_softclip(verbR * wet_gain);

  taildet = max(abs(verbL), abs(verbR));
  space_tail_meter = denorm_zap(space_tail_meter + (taildet - space_tail_meter) * (taildet > space_tail_meter ? 0.020 : 0.002));

  outL = denorm_zap(dryL + verbL);
  outR = denorm_zap(dryR + verbR);
);


function harm_smoothstep(e0 e1 x) local(t)
(
  t = clamp01((x - e0) / max(0.000001, e1 - e0));
  t * t * (3 - 2 * t);
);

function harm_band_weight(idx)
(
  idx <= 0 ? 0.16
  : idx == 1 ? 0.56
  : idx == 2 ? 0.86
  : idx == 3 ? 1.00
  : idx == 4 ? 0.92
  : idx == 5 ? 0.66
  : idx == 6 ? 0.28
  : 0.08;
);

function harm_hi_weight(idx)
(
  idx <= 0 ? 0.08
  : idx == 1 ? 0.54
  : idx == 2 ? 1.00
  : idx == 3 ? 0.72
  : idx == 4 ? 0.30
  : idx == 5 ? 0.08
  : 0;
);

function harm_ultra_weight(idx)
(
  idx <= 0 ? 0
  : idx == 1 ? 0.36
  : idx == 2 ? 0.72
  : idx == 3 ? 0.42
  : idx == 4 ? 0.10
  : 0;
);

function harm_dc_l(idx x) local(y)
(
  y = x - harm_dcx_l_base[idx] + 0.995 * harm_dcy_l_base[idx];
  harm_dcx_l_base[idx] = x;
  harm_dcy_l_base[idx] = denorm_zap(y);
  harm_dcy_l_base[idx];
);

function harm_dc_r(idx x) local(y)
(
  y = x - harm_dcx_r_base[idx] + 0.995 * harm_dcy_r_base[idx];
  harm_dcx_r_base[idx] = x;
  harm_dcy_r_base[idx] = denorm_zap(y);
  harm_dcy_r_base[idx];
);

function harm_safe(x)
(
  x / (1 + abs(x) * 0.34);
);

function apply_output_harmonics() local(
  a h2 h3 h4 h5 h7
  inL inR prevL prevR i c lp1 lp2 bL bR bandE totalE highE bright_guard trans_guard
  env xL xR x2L x3L x4L x5L x7L x2R x3R x4R x5R x7R
  evenL evenR oddL oddR busL busR bw hw uw harmL harmR mix_gain wet ceiling det lim
)
(
  // v52 Harmonics: clean parallel enrichment, not saturation.
  // An 8-band ERB/gammatone-ish scaffold controls where harmonic residuals are
  // generated. The dry signal is not driven; a guarded harmonic layer is added.
  a = clamp01(output_harmonics_amt);
  a > 0.0001 ? (
    output_harm_runtime_active = 1;
    inL = outL;
    inR = outR;

    h2 = 0.30 * (a ^ 0.92);
    h3 = 0.22 * (a ^ 1.14);
    h4 = 0.13 * harm_smoothstep(0.30, 0.88, a);
    h5 = 0.12 * harm_smoothstep(0.44, 0.96, a);
    h7 = 0.075 * harm_smoothstep(0.70, 1.00, a);

    prevL = 0;
    prevR = 0;
    totalE = 0;
    highE = 0;

    i = 0;
    while (i < HARM_XOVERS) (
      c = harm_coeff_base[i];
      lp1 = harm_lpa_l_base[i] + (inL - harm_lpa_l_base[i]) * c;
      harm_lpa_l_base[i] = denorm_zap(lp1);
      lp2 = harm_lpb_l_base[i] + (lp1 - harm_lpb_l_base[i]) * c;
      harm_lpb_l_base[i] = denorm_zap(lp2);
      bL = lp2 - prevL;
      prevL = lp2;

      lp1 = harm_lpa_r_base[i] + (inR - harm_lpa_r_base[i]) * c;
      harm_lpa_r_base[i] = denorm_zap(lp1);
      lp2 = harm_lpb_r_base[i] + (lp1 - harm_lpb_r_base[i]) * c;
      harm_lpb_r_base[i] = denorm_zap(lp2);
      bR = lp2 - prevR;
      prevR = lp2;

      harm_band_l_base[i] = bL;
      harm_band_r_base[i] = bR;
      bandE = abs(bL) + abs(bR);
      totalE += bandE;
      i >= 5 ? highE += bandE;
      i += 1;
    );

    bL = inL - prevL;
    bR = inR - prevR;
    harm_band_l_base[HARM_BANDS - 1] = bL;
    harm_band_r_base[HARM_BANDS - 1] = bR;
    bandE = abs(bL) + abs(bR);
    totalE += bandE;
    highE += bandE;

    bright_guard = clamp01(1 - clamp01(highE / max(totalE, 0.000000001)) * (0.42 + 0.46 * a));
    trans_guard = clamp(1 - transient_guard_s * (0.30 + 0.45 * a), 0.25, 1);

    harmL = 0;
    harmR = 0;
    i = 0;
    while (i < HARM_BANDS) (
      bL = harm_band_l_base[i];
      bR = harm_band_r_base[i];
      bandE = max(abs(bL), abs(bR));
      env = harm_env_base[i];
      env += (bandE - env) * (bandE > env ? harm_env_att_coeff : harm_env_rel_coeff);
      env = denorm_zap(env);
      harm_env_base[i] = env;

      xL = clamp(bL / max(0.0000009, env * 1.55), -1, 1);
      xR = clamp(bR / max(0.0000009, env * 1.55), -1, 1);

      x2L = xL * xL; x3L = x2L * xL; x4L = x2L * x2L; x5L = x4L * xL; x7L = x5L * x2L;
      x2R = xR * xR; x3R = x2R * xR; x4R = x2R * x2R; x5R = x4R * xR; x7R = x5R * x2R;

      bw = harm_band_weight(i);
      hw = harm_hi_weight(i);
      uw = harm_ultra_weight(i);

      evenL = h2 * (2 * x2L - 1) * bw + h4 * (8 * x4L - 8 * x2L + 1) * hw;
      evenR = h2 * (2 * x2R - 1) * bw + h4 * (8 * x4R - 8 * x2R + 1) * hw;
      evenL = harm_dc_l(i, evenL);
      evenR = harm_dc_r(i, evenR);

      oddL = h3 * (4 * x3L - 3 * xL) * bw
           + h5 * (16 * x5L - 20 * x3L + 5 * xL) * hw
           + h7 * (64 * x7L - 112 * x5L + 56 * x3L - 7 * xL) * uw;
      oddR = h3 * (4 * x3R - 3 * xR) * bw
           + h5 * (16 * x5R - 20 * x3R + 5 * xR) * hw
           + h7 * (64 * x7R - 112 * x5R + 56 * x3R - 7 * xR) * uw;

      // The generated layer follows the original band envelope. This keeps the
      // effect in the realm of enrichment rather than crunchy full-band drive.
      mix_gain = env * (0.22 + 0.78 * (a ^ 1.22)) * trans_guard * bright_guard;
      harmL += (evenL + oddL) * mix_gain;
      harmR += (evenR + oddR) * mix_gain;

      i += 1;
    );

    wet = clamp01(0.20 + 0.88 * (a ^ 1.18));
    busL = harm_safe(harmL * wet);
    busR = harm_safe(harmR * wet);

    outL = inL + busL;
    outR = inR + busR;

    // Protection only. This is not intended as the tone source.
    ceiling = 1.14;
    det = max(abs(outL), abs(outR));
    det > ceiling ? (
      lim = ceiling / max(det, 0.000001);
      outL *= lim;
      outR *= lim;
    );
  );
);

function apply_push() local(
  inL inR M S
  M_body M_form M_edge M_air S_body S_form S_edge S_air
  body_inst form_inst edge_inst air_inst src_inst M_hi S_hi
  src_dB src_w self_allow trans_allow side_allow
  ex_self ex_trans ex_side level_want common_want side_want
  head_damp cC cS g_form g_edge g_air g_side g_broad
  formW edgeW airW broadW broad_dB
)
(
  // Single-knob salience budget. Derived from the separate Salience Push idea,
  // but self-keyed only: it trims presence/air, reins in pokey upper spikes,
  // narrows bright side wash, and adds broadband distance at high settings.
  inL = outL;
  inR = outR;

  M = 0.5 * (inL + inR);
  S = 0.5 * (inL - inR);

  push_m_lp15 += (M - push_m_lp15) * push_lp15_c;
  push_m_lp32 += (M - push_m_lp32) * push_lp32_c;
  push_m_lp55 += (M - push_m_lp55) * push_lp55_c;
  push_s_lp15 += (S - push_s_lp15) * push_lp15_c;
  push_s_lp32 += (S - push_s_lp32) * push_lp32_c;
  push_s_lp55 += (S - push_s_lp55) * push_lp55_c;

  M_body = push_m_lp15;
  M_form = push_m_lp32 - push_m_lp15;
  M_edge = push_m_lp55 - push_m_lp32;
  M_air  = M - push_m_lp55;

  S_body = push_s_lp15;
  S_form = push_s_lp32 - push_s_lp15;
  S_edge = push_s_lp55 - push_s_lp32;
  S_air  = S - push_s_lp55;

  body_inst = M_body*M_body + S_body*S_body;
  form_inst = M_form*M_form + S_form*S_form;
  edge_inst = M_edge*M_edge + S_edge*S_edge;
  air_inst  = M_air*M_air   + S_air*S_air;
  src_inst  = 0.5 * (inL*inL + inR*inR);

  M_hi = M_edge + M_air;
  S_hi = S_edge + S_air;

  push_bodyE += push_a_lev * (body_inst - push_bodyE);
  push_formE += push_a_lev * (form_inst - push_formE);
  push_edgeE += push_a_lev * (edge_inst - push_edgeE);
  push_airE  += push_a_lev * (air_inst  - push_airE);
  push_srcE  += push_a_src * (src_inst  - push_srcE);
  push_m_hiE += push_a_lev * (M_hi*M_hi - push_m_hiE);
  push_s_hiE += push_a_lev * (S_hi*S_hi - push_s_hiE);

  push_click_fastE += push_a_fast * ((edge_inst + 0.62*air_inst) - push_click_fastE);
  push_click_slowE += push_a_slow * ((edge_inst + 0.62*air_inst) - push_click_slowE);

  push_hot_dB = 10 * log((0.35*push_formE + 1.00*push_edgeE + 1.18*push_airE + PUSH_EPS) / (push_bodyE + 0.55*push_formE + PUSH_EPS)) * LOG10_INV;
  push_click_dB = 10 * log((push_click_fastE + PUSH_EPS) / (push_click_slowE + PUSH_EPS)) * LOG10_INV;
  push_side_rel_dB = 10 * log((push_s_hiE + PUSH_EPS) / (push_m_hiE + PUSH_EPS)) * LOG10_INV;
  src_dB = 10 * log(push_srcE + PUSH_EPS) * LOG10_INV;

  src_w = clamp01((src_dB + 72) / 20);

  self_allow  = -5.0 - 6.5 * push_amt + 4.0 * push_preserve - 1.5;
  trans_allow = clamp(6.5 - 3.2 * push_amt + 2.0 * push_preserve + 0.7, 1.0, 10.0);
  side_allow  = clamp(3.0 - 2.0 * push_amt + 3.0 * push_preserve - 2.3, -3.0, 8.0);

  ex_self = max(0, push_hot_dB - self_allow);
  ex_trans = max(0, push_click_dB - trans_allow);
  ex_side = max(0, push_side_rel_dB - side_allow);

  level_want = src_w * ex_self * (0.18 + 0.92 * push_amt);
  common_want = level_want + src_w * ex_trans * push_trans_w;
  common_want = min(common_want, push_max_common_dB);

  side_want = src_w * ex_side * push_side_w;
  side_want = min(side_want, push_max_side_dB);

  // Keep hit identity, but do not let attacks punch all the way forward at high Push.
  head_damp = clamp01(transient_guard_s * (0.38 - 0.18 * push_amt));
  common_want *= 1 - head_damp;
  side_want *= 1 - head_damp * 0.55;

  cC = common_want > push_common_dB ? push_common_att_coeff : push_common_rel_coeff;
  push_common_dB += (common_want - push_common_dB) * cC;

  cS = side_want > push_side_dB ? push_side_att_coeff : push_side_rel_coeff;
  push_side_dB += (side_want - push_side_dB) * cS;

  formW = clamp((0.50 - 0.24 * push_preserve), 0.12, 0.80);
  edgeW = clamp((0.98 - 0.10 * push_preserve), 0.68, 1.18);
  airW  = clamp((1.20 - 0.34 * push_preserve), 0.54, 1.36);
  broadW = clamp(0.05 + 0.22 * push_amt * (1 - 0.35 * push_preserve), 0, 0.30);

  g_form = db2amp(-(push_common_dB * formW));
  g_edge = db2amp(-(push_common_dB * edgeW));
  g_air  = db2amp(-(push_common_dB * airW));
  g_side = db2amp(-push_side_dB);
  broad_dB = push_common_dB * broadW + push_broad_static_dB * src_w;
  g_broad = db2amp(-broad_dB);

  M_form *= g_form;  S_form *= g_form;
  M_edge *= g_edge;  S_edge *= g_edge * g_side;
  M_air  *= g_air;   S_air  *= g_air  * g_side;

  M = M_body + M_form + M_edge + M_air;
  S = S_body + S_form + S_edge + S_air;

  outL = (M + S) * g_broad;
  outR = (M - S) * g_broad;
);



function formant_env_lookup(idx)
(
  idx <= 0 ? form_env0
  : idx == 1 ? form_env1
  : idx == 2 ? form_env2
  : idx == 3 ? form_env3
  : idx == 4 ? form_env4
  : form_env5;
);

function formant_env_at(x) local(i t a b)
(
  x = clamp(x, 0, 5);
  i = floor(x);
  t = x - i;
  a = formant_env_lookup(i);
  b = formant_env_lookup(min(5, i + 1));
  lerp(a, b, t);
);

function formant_gain_from_ratio(cur target depth band_depth) local(r g d)
(
  d = clamp01(depth * band_depth);
  r = clamp((target + 0.000000000001) / (cur + 0.000000000001), 0.12, 8.50);
  // v18: v17 used a 0.50 exponent and was too polite. This is still bounded,
  // but the envelope move is now strong enough to A/B at +/-12.
  g = exp(log(r) * 0.92 * d);
  clamp(g, db2amp(-15.0 * d), db2amp(13.0 * d));
);


function apply_push_pop() local(
  a sane extreme gain inL inR prevL prevR i c lp1 lp2 bL bR
  fl fr ml mr sl sr fc mc sc microL microR edgeL edgeR shapeL shapeR
  detailL detailR det efast eslow floorv event snr cue bed roomg bandw airg
  popL popR total_fast air_fast air_ratio air_excess target_air trans_shape lim
)
(
  a = clamp01(push_pop_amt);
  a > 0.0001 ? (
    push_pop_runtime_active = 1;

    // v53 PopCue: a parallel concrete-cue bus. Source is captured before Push,
    // then reintroduced after Push so high Push can remain distant but legible.
    inL = pop_src_l + denorm_guard;
    inR = pop_src_r - denorm_guard;

    prevL = 0;
    prevR = 0;
    i = 0;
    while (i < POP_XOVERS) (
      c = pop_xover_coeff_base[i];

      lp1 = pop_lpa_l_base[i] + (inL - pop_lpa_l_base[i]) * c;
      pop_lpa_l_base[i] = denorm_zap(lp1);
      lp2 = pop_lpb_l_base[i] + (lp1 - pop_lpb_l_base[i]) * c;
      pop_lpb_l_base[i] = denorm_zap(lp2);
      bL = lp2 - prevL;
      prevL = lp2;

      lp1 = pop_lpa_r_base[i] + (inR - pop_lpa_r_base[i]) * c;
      pop_lpa_r_base[i] = denorm_zap(lp1);
      lp2 = pop_lpb_r_base[i] + (lp1 - pop_lpb_r_base[i]) * c;
      pop_lpb_r_base[i] = denorm_zap(lp2);
      bR = lp2 - prevR;
      prevR = lp2;

      pop_band_l_base[i] = bL;
      pop_band_r_base[i] = bR;
      i += 1;
    );
    pop_band_l_base[POP_BANDS - 1] = inL - prevL;
    pop_band_r_base[POP_BANDS - 1] = inR - prevR;

    popL = 0;
    popR = 0;
    total_fast = 0;
    air_fast = 0;
    sane = a ^ 1.25;
    extreme = a ^ 3.20;

    i = 0;
    while (i < POP_BANDS) (
      bL = pop_band_l_base[i];
      bR = pop_band_r_base[i];
      fc = pop_fast_coeff_base[i];
      mc = pop_mid_coeff_base[i];
      sc = pop_slow_coeff_base[i];

      fl = pop_fast_l_base[i] + (bL - pop_fast_l_base[i]) * fc;
      fr = pop_fast_r_base[i] + (bR - pop_fast_r_base[i]) * fc;
      ml = pop_mid_l_base[i] + (fl - pop_mid_l_base[i]) * mc;
      mr = pop_mid_r_base[i] + (fr - pop_mid_r_base[i]) * mc;
      sl = pop_slow_l_base[i] + (ml - pop_slow_l_base[i]) * sc;
      sr = pop_slow_r_base[i] + (mr - pop_slow_r_base[i]) * sc;

      pop_fast_l_base[i] = denorm_zap(fl);
      pop_fast_r_base[i] = denorm_zap(fr);
      pop_mid_l_base[i] = denorm_zap(ml);
      pop_mid_r_base[i] = denorm_zap(mr);
      pop_slow_l_base[i] = denorm_zap(sl);
      pop_slow_r_base[i] = denorm_zap(sr);

      microL = bL - fl;
      microR = bR - fr;
      edgeL = fl - ml;
      edgeR = fr - mr;
      shapeL = ml - sl;
      shapeR = mr - sr;

      // Temporal-detail ladder: mostly micro/edge, only a small amount of contour.
      detailL = microL * (0.38 + 0.38 * sane) + edgeL * (0.76 + 0.34 * sane) + shapeL * (0.14 + 0.22 * extreme);
      detailR = microR * (0.38 + 0.38 * sane) + edgeR * (0.76 + 0.34 * sane) + shapeR * (0.14 + 0.22 * extreme);
      det = max(abs(detailL), abs(detailR)) * 0.58 + abs(0.5 * (detailL + detailR)) * 0.42;

      efast = pop_env_fast_base[i];
      efast += (det - efast) * (det > efast ? pop_env_fast_att : pop_env_fast_rel);
      efast = denorm_zap(efast);
      pop_env_fast_base[i] = efast;

      eslow = pop_env_slow_base[i];
      eslow += (det - eslow) * pop_env_slow_coeff;
      eslow = denorm_zap(eslow);
      pop_env_slow_base[i] = eslow;

      floorv = pop_floor_base[i];
      floorv += (det - floorv) * (det > floorv ? pop_floor_up_coeff : pop_floor_down_coeff);
      floorv = min(floorv, eslow * 0.86 + 0.00000003);
      floorv = denorm_zap(max(0, floorv));
      pop_floor_base[i] = floorv;

      event = clamp01((efast - eslow * (0.88 - 0.16 * sane)) / max(0.0000002, eslow * (0.88 - 0.36 * sane) + 0.0000002));
      snr = clamp01((efast - floorv * (1.65 - 0.52 * sane)) / max(0.0000002, floorv * (5.0 - 2.8 * sane) + 0.0000002));
      bed = clamp01(eslow / max(efast + eslow, 0.000000000001));
      cue = event * snr * (1 - bed * (0.16 + 0.26 * sane));
      cue = clamp01(cue);
      cue = cue ^ max(0.42, 1.20 - 0.62 * sane);

      roomg = 1 - clamp01(room_tail_bus * (0.20 + 0.46 * sane) + clean_tail_bus * 0.18 * sane);
      airg = i >= (POP_BANDS - 1) ? pop_air_guard_s : 1;
      bandw = pop_band_weight(i, airg);

      popL += detailL * cue * roomg * bandw;
      popR += detailR * cue * roomg * bandw;

      total_fast += efast;
      i >= (POP_BANDS - 1) ? air_fast += efast;
      i += 1;
    );

    air_ratio = air_fast / max(total_fast, 0.000000000001);
    air_excess = clamp01((air_ratio - 0.30) / 0.42);
    target_air = 1 - air_excess * (0.35 + 0.48 * sane);
    pop_air_guard_s = denorm_zap(pop_air_guard_s + (target_air - pop_air_guard_s) * 0.010);
    pop_air_guard_s = clamp(pop_air_guard_s, 0.16, 1);

    popL = pop_dcblock_l(popL);
    popR = pop_dcblock_r(popR);

    gain = 0.16 + 1.58 * sane + 3.10 * extreme;
    trans_shape = 1 - clamp01(max(0, transient_guard_s - 0.82) * (0.18 + 0.16 * sane));
    popL *= gain * trans_shape;
    popR *= gain * trans_shape;

    // Safety only: keep Pop from becoming a clipper/distortion macro.
    lim = max(abs(popL), abs(popR));
    lim > 0.85 ? (
      lim = 0.85 / max(lim, 0.0000001);
      popL *= lim;
      popR *= lim;
    );

    outL = denorm_zap(outL + popL);
    outR = denorm_zap(outR + popR);
  ) : (
    push_pop_runtime_active > 0 ? reset_push_pop_buffers();
  );
);

function apply_formant_shift() local(
  inL inR
  b0l b1l b2l b3l b4l b5l b0r b1r b2r b3r b4r b5r
  e0 e1 e2 e3 e4 e5
  amt protect shift wetL wetR dryE wetE level target0 target1 target2 target3 target4 target5
  g0 g1 g2 g3 g4 g5 coeff fs drive_db bump wetmix
)
(
  // v18 FormantDrive: audible transient-safe spectral-envelope warp.
  // This is deliberately not LPC/voice-only. It shifts the perceived resonance
  // envelope with a cheap log-spaced band model and bypasses hard attacks.
  inL = outL;
  inR = outR;

  form_lp1_l = denorm_zap(form_lp1_l + (inL - form_lp1_l) * form_lp_c1);
  form_lp2_l = denorm_zap(form_lp2_l + (inL - form_lp2_l) * form_lp_c2);
  form_lp3_l = denorm_zap(form_lp3_l + (inL - form_lp3_l) * form_lp_c3);
  form_lp4_l = denorm_zap(form_lp4_l + (inL - form_lp4_l) * form_lp_c4);
  form_lp5_l = denorm_zap(form_lp5_l + (inL - form_lp5_l) * form_lp_c5);

  form_lp1_r = denorm_zap(form_lp1_r + (inR - form_lp1_r) * form_lp_c1);
  form_lp2_r = denorm_zap(form_lp2_r + (inR - form_lp2_r) * form_lp_c2);
  form_lp3_r = denorm_zap(form_lp3_r + (inR - form_lp3_r) * form_lp_c3);
  form_lp4_r = denorm_zap(form_lp4_r + (inR - form_lp4_r) * form_lp_c4);
  form_lp5_r = denorm_zap(form_lp5_r + (inR - form_lp5_r) * form_lp_c5);

  b0l = form_lp1_l;
  b1l = form_lp2_l - form_lp1_l;
  b2l = form_lp3_l - form_lp2_l;
  b3l = form_lp4_l - form_lp3_l;
  b4l = form_lp5_l - form_lp4_l;
  b5l = inL - form_lp5_l;

  b0r = form_lp1_r;
  b1r = form_lp2_r - form_lp1_r;
  b2r = form_lp3_r - form_lp2_r;
  b3r = form_lp4_r - form_lp3_r;
  b4r = form_lp5_r - form_lp4_r;
  b5r = inR - form_lp5_r;

  e0 = b0l*b0l + b0r*b0r;
  e1 = b1l*b1l + b1r*b1r;
  e2 = b2l*b2l + b2r*b2r;
  e3 = b3l*b3l + b3r*b3r;
  e4 = b4l*b4l + b4r*b4r;
  e5 = b5l*b5l + b5r*b5r;

  form_env0 = denorm_zap(form_env0 + (e0 - form_env0) * (e0 > form_env0 ? form_env_att_coeff : form_env_rel_coeff));
  form_env1 = denorm_zap(form_env1 + (e1 - form_env1) * (e1 > form_env1 ? form_env_att_coeff : form_env_rel_coeff));
  form_env2 = denorm_zap(form_env2 + (e2 - form_env2) * (e2 > form_env2 ? form_env_att_coeff : form_env_rel_coeff));
  form_env3 = denorm_zap(form_env3 + (e3 - form_env3) * (e3 > form_env3 ? form_env_att_coeff : form_env_rel_coeff));
  form_env4 = denorm_zap(form_env4 + (e4 - form_env4) * (e4 > form_env4 ? form_env_att_coeff : form_env_rel_coeff));
  form_env5 = denorm_zap(form_env5 + (e5 - form_env5) * (e5 > form_env5 ? form_env_att_coeff : form_env_rel_coeff));

  amt = clamp01(abs(formant_shift_semi) / 12);
  // v17 often vanished on short/transient-heavy sources because protection could
  // zero the whole effect. v18 protects the head, but never fully mutes max shift.
  protect = clamp01(transient_guard_s * (0.42 + 0.10 * trans_mode_mix) + clean_head_bus * 0.08 + room_head_bus * 0.06);
  amt *= (1 - protect * 0.72);

  amt > 0.0001 ? (
    // +/-12 now spans roughly half the six-band envelope, not barely one band.
    shift = (formant_shift_semi / 12) * 2.70;

    // Positive formant shift means the envelope moves upward: each high band
    // borrows the energy expectation that used to live lower on the log axis.
    target0 = formant_env_at(0 - shift);
    target1 = formant_env_at(1 - shift);
    target2 = formant_env_at(2 - shift);
    target3 = formant_env_at(3 - shift);
    target4 = formant_env_at(4 - shift);
    target5 = formant_env_at(5 - shift);

    g0 = formant_gain_from_ratio(form_env0, target0, amt, 0.72);
    g1 = formant_gain_from_ratio(form_env1, target1, amt, 1.00);
    g2 = formant_gain_from_ratio(form_env2, target2, amt, 1.12);
    g3 = formant_gain_from_ratio(form_env3, target3, amt, 1.12);
    g4 = formant_gain_from_ratio(form_env4, target4, amt, 1.00);
    g5 = formant_gain_from_ratio(form_env5, target5, amt, 0.78);

    // Static resonance-drive fallback: if the live envelope is flat/noisy, a pure
    // ratio warp can do almost nothing. This makes +/-12 unmistakable without a
    // full extra Color knob; it is shaped like body/mouth size, not a simple tilt.
    fs = clamp(formant_shift_semi / 12, -1, 1);
    drive_db = fs * (4.0 + 8.0 * amt);
    g0 *= db2amp(-0.92 * drive_db);
    g1 *= db2amp(-0.58 * drive_db);
    g2 *= db2amp(-0.12 * drive_db);
    g3 *= db2amp( 0.34 * drive_db);
    g4 *= db2amp( 0.70 * drive_db);
    g5 *= db2amp( 0.82 * drive_db);

    bump = abs(fs) * (1.8 + 4.2 * amt);
    fs >= 0 ? (
      g3 *= db2amp( bump * 0.65);
      g4 *= db2amp( bump * 0.52);
      g1 *= db2amp(-bump * 0.26);
    ) : (
      g1 *= db2amp( bump * 0.70);
      g2 *= db2amp( bump * 0.46);
      g4 *= db2amp(-bump * 0.30);
    );

    coeff = form_gain_coeff * (0.70 + 0.90 * amt);
    form_g0 += (g0 - form_g0) * coeff;
    form_g1 += (g1 - form_g1) * coeff;
    form_g2 += (g2 - form_g2) * coeff;
    form_g3 += (g3 - form_g3) * coeff;
    form_g4 += (g4 - form_g4) * coeff;
    form_g5 += (g5 - form_g5) * coeff;

    wetL = b0l * form_g0 + b1l * form_g1 + b2l * form_g2 + b3l * form_g3 + b4l * form_g4 + b5l * form_g5;
    wetR = b0r * form_g0 + b1r * form_g1 + b2r * form_g2 + b3r * form_g3 + b4r * form_g4 + b5r * form_g5;

    dryE = inL*inL + inR*inR + 0.000000000001;
    wetE = wetL*wetL + wetR*wetR + 0.000000000001;
    // Keep level sane, but do not normalize the audible formant contrast away.
    level = clamp(sqrt(dryE / wetE), 0.78, 1.22);
    form_level += (level - form_level) * form_level_coeff;
    abs(form_level - 1) < DENORM_CUT ? form_level = 1;
    wetL *= form_level;
    wetR *= form_level;

    wetmix = clamp01(0.20 + 0.80 * sqrt(amt));
    outL = lerp(inL, wetL, wetmix);
    outR = lerp(inR, wetR, wetmix);
  ) : (
    form_g0 += (1 - form_g0) * form_gain_coeff;
    form_g1 += (1 - form_g1) * form_gain_coeff;
    form_g2 += (1 - form_g2) * form_gain_coeff;
    form_g3 += (1 - form_g3) * form_gain_coeff;
    form_g4 += (1 - form_g4) * form_gain_coeff;
    form_g5 += (1 - form_g5) * form_gain_coeff;
    form_level += (1 - form_level) * form_level_coeff;
    abs(form_level - 1) < DENORM_CUT ? form_level = 1;
  );
);


function fpk_peakness(e center) local(p)
(
  // v32 Peak Pack Pro: high-threshold local-maximum detector for the narrow
  // resonance bank. Moderate settings stay sane; extremes become flattening or
  // resonant transformation.
  p = e <= 0.000000000001 ? 0 : max(0, e - center) / max(e + center * 0.22, 0.000000000001);
  clamp01((p * 3.15) ^ 0.82);
);


function fpk_band_freq(idx)
(
  idx == 0 ? 180
  : idx == 1 ? 280
  : idx == 2 ? 430
  : idx == 3 ? 660
  : idx == 4 ? 1000
  : idx == 5 ? 1550
  : idx == 6 ? 2400
  : idx == 7 ? 3700
  : idx == 8 ? 5900
  : idx == 9 ? 9200
  : idx == 10 ? 13500
  : 17500;
);

function fpk_bq_set_bandpass(slot freq q) local(base w0 sn cs alpha a0 b0 b1 b2 a1 a2)
(
  base = slot * FPK_BQ_STRIDE;
  freq = clamp(freq, 40, min(19000, srate * 0.49));
  q = clamp(q, 2.5, 32);
  w0 = 6.283185307179586 * freq / max(srate, 1);
  sn = sin(w0);
  cs = cos(w0);
  alpha = sn / max(0.000001, 2 * q);
  b0 = alpha;
  b1 = 0;
  b2 = -alpha;
  a0 = 1 + alpha;
  a1 = -2 * cs;
  a2 = 1 - alpha;
  fpk_bq_base[base + 0] = b0 / a0;
  fpk_bq_base[base + 1] = b1 / a0;
  fpk_bq_base[base + 2] = b2 / a0;
  fpk_bq_base[base + 3] = a1 / a0;
  fpk_bq_base[base + 4] = a2 / a0;
);

function fpk_bq_process_l(slot x) local(base y)
(
  base = slot * FPK_BQ_STRIDE;
  y = fpk_bq_base[base + 0] * x + fpk_bq_base[base + 5];
  fpk_bq_base[base + 5] = denorm_zap(fpk_bq_base[base + 1] * x - fpk_bq_base[base + 3] * y + fpk_bq_base[base + 6]);
  fpk_bq_base[base + 6] = denorm_zap(fpk_bq_base[base + 2] * x - fpk_bq_base[base + 4] * y);
  denorm_zap(y);
);

function fpk_bq_process_r(slot x) local(base y)
(
  base = slot * FPK_BQ_STRIDE;
  y = fpk_bq_base[base + 0] * x + fpk_bq_base[base + 7];
  fpk_bq_base[base + 7] = denorm_zap(fpk_bq_base[base + 1] * x - fpk_bq_base[base + 3] * y + fpk_bq_base[base + 8]);
  fpk_bq_base[base + 8] = denorm_zap(fpk_bq_base[base + 2] * x - fpk_bq_base[base + 4] * y);
  denorm_zap(y);
);

function fpk_update_coeffs() local(i freq q)
(
  i = 0;
  while (i < FPK_BANDS) (
    freq = fpk_band_freq(i);
    q = clamp(5.5 + i * 1.65, 4.8, 24);
    fpk_bq_set_bandpass(i, freq, q);
    i += 1;
  );
);

function apply_focus_peak_pack() local(
  inL inR i bl br e env avgE maxE neigh pk thresh active depth sign protect sane extreme coeff
  db g wetL wetR dryE wetE level wetmix sumActive
)
(
  // v32 Peak Pack Pro: sparse narrow-band peak processor. Negative values
  // suppress only standout resonances; positive values exaggerate them. This is
  // no longer broad Color/Focus behavior. It behaves closer to a dynamic bank of
  // tiny soothe/accent filters.
  inL = outL;
  inR = outR;
  depth = abs(clamp(focus_peak_amt, -1, 1));
  sign = focus_peak_amt >= 0 ? 1 : -1;


  protect = sign > 0 ? transient_guard_s * (0.30 + 0.10 * trans_mode_mix) : transient_guard_s * 0.02;
  depth *= 1 - clamp01(protect);

  depth > 0.0001 ? (
    sane = depth ^ 1.55;
    extreme = depth ^ 4.25;

    avgE = 0;
    maxE = 0;
    i = 0;
    while (i < FPK_BANDS) (
      bl = fpk_bq_process_l(i, inL);
      br = fpk_bq_process_r(i, inR);
      fpk_band_l_base[i] = bl;
      fpk_band_r_base[i] = br;
      e = bl*bl + br*br;
      env = fpk_env_base[i];
      env += (e - env) * (e > env ? fpk_env_att_coeff : fpk_env_rel_coeff);
      fpk_env_base[i] = denorm_zap(env);
      avgE += env;
      maxE = max(maxE, env);
      i += 1;
    );
    avgE = avgE / max(1, FPK_BANDS) + 0.000000000001;

    wetL = inL;
    wetR = inR;
    sumActive = 0;
    thresh = lerp(0.88, 0.58, extreme) - sane * 0.05;

    i = 0;
    while (i < FPK_BANDS) (
      env = fpk_env_base[i];
      neigh = 0;
      i > 0 ? neigh += fpk_env_base[i - 1] : neigh += avgE;
      i < FPK_BANDS - 1 ? neigh += fpk_env_base[i + 1] : neigh += avgE;
      neigh *= 0.5;

      pk = fpk_peakness(env, max(neigh * 1.32, avgE * 1.70));
      pk *= clamp01((env - avgE * 1.18) / max(env + avgE * 0.22, 0.000000000001));
      active = clamp01((pk - thresh) / max(0.0001, 1 - thresh));
      active = active ^ 1.48;
      sumActive += active;

      sign < 0 ? (
        db = -(sane * (3.0 + 18.0 * active) + extreme * (12.0 + 46.0 * active)) * active;
        db = clamp(db, -54, 0);
      ) : (
        db = (sane * (2.0 + 12.0 * active) + extreme * (6.0 + 34.0 * active)) * active;
        db = clamp(db, 0, 32);
      );

      coeff = fpk_gain_coeff * (0.82 + 1.20 * sane + 1.30 * extreme);
      fpk_gain_base[i] = denorm_zap(fpk_gain_base[i] + (db - fpk_gain_base[i]) * coeff);
      g = db2amp(fpk_gain_base[i]) - 1;
      wetL += fpk_band_l_base[i] * g;
      wetR += fpk_band_r_base[i] * g;
      i += 1;
    );

    dryE = inL*inL + inR*inR + 0.000000000001;
    wetE = wetL*wetL + wetR*wetR + 0.000000000001;
    level = sign > 0 ? clamp(sqrt(dryE / wetE), 0.40, 1.06) : clamp(sqrt(dryE / wetE), 0.58, 1.18);
    level = lerp(1, level, sign > 0 ? 0.72 : 0.52);
    fpk_level = denorm_zap(fpk_level + (level - fpk_level) * fpk_level_coeff);
    wetL *= fpk_level;
    wetR *= fpk_level;

    wetmix = clamp01(0.18 + 0.58 * sqrt(depth) + 0.22 * extreme);
    outL = lerp(inL, wetL, wetmix);
    outR = lerp(inR, wetR, wetmix);
  ) : (
    i = 0;
    while (i < FPK_BANDS) (
      fpk_gain_base[i] = denorm_zap(fpk_gain_base[i] + (0 - fpk_gain_base[i]) * fpk_gain_coeff);
      i += 1;
    );
    fpk_level = denorm_zap(fpk_level + (1 - fpk_level) * fpk_level_coeff);
  );
);

function reset_input_trigger_buffers()
(
  input_trig_fast = 0;
  input_trig_slow = 0;
  input_trig_floor = 0;
  input_trig_env = 0;
  input_trig_gate = 0;
  input_trig_silence = 0;
  input_trig_cooldown = 0;
  input_trig_norm = 0;
  input_trigger_was_armed = 0;
);


function reset_edge_melt_buffers()
(
  edge_melt_post_lp_l = 0;
  edge_melt_post_lp_r = 0;
  edge_melt_post_hi_l = 0;
  edge_melt_post_hi_r = 0;
  edge_melt_post_smooth_l = 0;
  edge_melt_post_smooth_r = 0;
  edge_melt_post_fast = 0;
  edge_melt_post_slow = 0;
  edge_melt_runtime_active = 0;
);

function apply_edge_melt_post() local(m mm blur declick post_mix hiL hiR smoothL smoothR det ratio gate lpL lpR)
(
  m = (playback_mode == 3) ? edge_melt_amt : 0;
  m > 0.0001 ? (
    edge_melt_runtime_active = 1;
    mm = m * m * (3 - 2 * m);
    // High-mid micro-edge smoother: acts mostly on 2-8 kHz grain-border scratch.
    edge_melt_post_lp_l = denorm_zap(edge_melt_post_lp_l + (outL - edge_melt_post_lp_l) * edge_melt_post_hi_coeff);
    edge_melt_post_lp_r = denorm_zap(edge_melt_post_lp_r + (outR - edge_melt_post_lp_r) * edge_melt_post_hi_coeff);
    hiL = outL - edge_melt_post_lp_l;
    hiR = outR - edge_melt_post_lp_r;

    edge_melt_post_smooth_l = denorm_zap(edge_melt_post_smooth_l + (hiL - edge_melt_post_smooth_l) * edge_melt_post_smooth_coeff);
    edge_melt_post_smooth_r = denorm_zap(edge_melt_post_smooth_r + (hiR - edge_melt_post_smooth_r) * edge_melt_post_smooth_coeff);
    smoothL = edge_melt_post_smooth_l;
    smoothR = edge_melt_post_smooth_r;

    det = max(abs(hiL - smoothL), abs(hiR - smoothR));
    edge_melt_post_fast = denorm_zap(edge_melt_post_fast + (det - edge_melt_post_fast) * edge_melt_post_fast_coeff);
    edge_melt_post_slow = denorm_zap(edge_melt_post_slow + (det - edge_melt_post_slow) * edge_melt_post_slow_coeff);
    ratio = edge_melt_post_fast / max(edge_melt_post_slow * 1.22 + 0.00000008, 0.00000008);
    gate = clamp01((ratio - 1.0) * 0.72);

    declick = 0.50 * (m ^ 1.20);
    blur = max(0, (m - 0.50) * 2);
    blur = (blur ^ 1.50) * 0.35;
    post_mix = clamp01(declick * (0.25 + 0.75 * gate) + blur);

    lpL = edge_melt_post_lp_l;
    lpR = edge_melt_post_lp_r;
    outL = lpL + lerp(hiL, smoothL, post_mix);
    outR = lpR + lerp(hiR, smoothR, post_mix);
  ) : (
    edge_melt_runtime_active > 0 ? reset_edge_melt_buffers();
  );
);

function denorm_flush_scalar_states() local(i)
(
  mix_fast = denorm_zap(mix_fast);
  mix_slow = denorm_zap(mix_slow);
  transient_guard_s = denorm_zap(transient_guard_s);
  tone_lp_l = denorm_zap(tone_lp_l); tone_lp_r = denorm_zap(tone_lp_r);
  focus_lp_l = denorm_zap(focus_lp_l); focus_lp_r = denorm_zap(focus_lp_r);
  dyn_env = denorm_zap(dyn_env);
  dynx_gain = denorm_zap(dynx_gain); dynx_detector_slow = denorm_zap(dynx_detector_slow); dynx_lim_gain = denorm_zap(dynx_lim_gain); dynx_hpf_lp = denorm_zap(dynx_hpf_lp); dynx_lpf_y = denorm_zap(dynx_lpf_y);
  input_trig_fast = denorm_zap(input_trig_fast); input_trig_slow = denorm_zap(input_trig_slow); input_trig_floor = denorm_zap(input_trig_floor); input_trig_env = denorm_zap(input_trig_env);
  edge_melt_post_lp_l = denorm_zap(edge_melt_post_lp_l); edge_melt_post_lp_r = denorm_zap(edge_melt_post_lp_r);
  edge_melt_post_smooth_l = denorm_zap(edge_melt_post_smooth_l); edge_melt_post_smooth_r = denorm_zap(edge_melt_post_smooth_r);
  edge_melt_post_fast = denorm_zap(edge_melt_post_fast); edge_melt_post_slow = denorm_zap(edge_melt_post_slow);

  clean_lp1_l = denorm_zap(clean_lp1_l); clean_lp2_l = denorm_zap(clean_lp2_l); clean_lp3_l = denorm_zap(clean_lp3_l); clean_lp4_l = denorm_zap(clean_lp4_l);
  clean_lp1_r = denorm_zap(clean_lp1_r); clean_lp2_r = denorm_zap(clean_lp2_r); clean_lp3_r = denorm_zap(clean_lp3_r); clean_lp4_r = denorm_zap(clean_lp4_r);

  room_lp1_l = denorm_zap(room_lp1_l); room_lp2_l = denorm_zap(room_lp2_l); room_lp3_l = denorm_zap(room_lp3_l); room_lp4_l = denorm_zap(room_lp4_l);
  room_lp1_r = denorm_zap(room_lp1_r); room_lp2_r = denorm_zap(room_lp2_r); room_lp3_r = denorm_zap(room_lp3_r); room_lp4_r = denorm_zap(room_lp4_r);
  room_fast_env = denorm_zap(room_fast_env); room_slow_env = denorm_zap(room_slow_env);
  room_late_s = denorm_zap(room_late_s); room_diffuse_s = denorm_zap(room_diffuse_s); room_side_g = denorm_zap(room_side_g);
  room_b0_fast = denorm_zap(room_b0_fast); room_b1_fast = denorm_zap(room_b1_fast); room_b2_fast = denorm_zap(room_b2_fast); room_b3_fast = denorm_zap(room_b3_fast); room_b4_fast = denorm_zap(room_b4_fast);
  room_b0_slow = denorm_zap(room_b0_slow); room_b1_slow = denorm_zap(room_b1_slow); room_b2_slow = denorm_zap(room_b2_slow); room_b3_slow = denorm_zap(room_b3_slow); room_b4_slow = denorm_zap(room_b4_slow);

  space_fb_l = denorm_zap(space_fb_l); space_fb_r = denorm_zap(space_fb_r);
  space_damp_l = denorm_zap(space_damp_l); space_damp_r = denorm_zap(space_damp_r);
  space_low_l = denorm_zap(space_low_l); space_low_r = denorm_zap(space_low_r);
  space_early_s_l = denorm_zap(space_early_s_l); space_early_s_r = denorm_zap(space_early_s_r);
  space_late_s_l = denorm_zap(space_late_s_l); space_late_s_r = denorm_zap(space_late_s_r);
  space_tank_energy = denorm_zap(space_tank_energy); space_governor_s = denorm_zap(space_governor_s);
  space_env = denorm_zap(space_env); space_tail_meter = denorm_zap(space_tail_meter);
  (output_harmonics_amt > 0.0001 || output_harm_runtime_active > 0) ? (
    // v52: only touch harmonic recursive states while the hidden mode is/was active.
    i = 0;
    while (i < HARM_XOVERS) (
      harm_lpa_l_base[i] = denorm_zap(harm_lpa_l_base[i]);
      harm_lpb_l_base[i] = denorm_zap(harm_lpb_l_base[i]);
      harm_lpa_r_base[i] = denorm_zap(harm_lpa_r_base[i]);
      harm_lpb_r_base[i] = denorm_zap(harm_lpb_r_base[i]);
      i += 1;
    );
    i = 0;
    while (i < HARM_BANDS) (
      harm_env_base[i] = denorm_zap(harm_env_base[i]);
      harm_dcy_l_base[i] = denorm_zap(harm_dcy_l_base[i]);
      harm_dcy_r_base[i] = denorm_zap(harm_dcy_r_base[i]);
      i += 1;
    );
  );

  (push_pop_amt > 0.0001 || push_pop_runtime_active > 0) ? (
    i = 0;
    while (i < POP_XOVERS) (
      pop_lpa_l_base[i] = denorm_zap(pop_lpa_l_base[i]);
      pop_lpb_l_base[i] = denorm_zap(pop_lpb_l_base[i]);
      pop_lpa_r_base[i] = denorm_zap(pop_lpa_r_base[i]);
      pop_lpb_r_base[i] = denorm_zap(pop_lpb_r_base[i]);
      i += 1;
    );
    i = 0;
    while (i < POP_BANDS) (
      pop_fast_l_base[i] = denorm_zap(pop_fast_l_base[i]);
      pop_fast_r_base[i] = denorm_zap(pop_fast_r_base[i]);
      pop_mid_l_base[i] = denorm_zap(pop_mid_l_base[i]);
      pop_mid_r_base[i] = denorm_zap(pop_mid_r_base[i]);
      pop_slow_l_base[i] = denorm_zap(pop_slow_l_base[i]);
      pop_slow_r_base[i] = denorm_zap(pop_slow_r_base[i]);
      pop_env_fast_base[i] = denorm_zap(pop_env_fast_base[i]);
      pop_env_slow_base[i] = denorm_zap(pop_env_slow_base[i]);
      pop_floor_base[i] = denorm_zap(pop_floor_base[i]);
      i += 1;
    );
    pop_dcy_l = denorm_zap(pop_dcy_l);
    pop_dcy_r = denorm_zap(pop_dcy_r);
    pop_air_guard_s = denorm_zap(pop_air_guard_s);
  );

  form_lp1_l = denorm_zap(form_lp1_l); form_lp2_l = denorm_zap(form_lp2_l); form_lp3_l = denorm_zap(form_lp3_l); form_lp4_l = denorm_zap(form_lp4_l); form_lp5_l = denorm_zap(form_lp5_l);
  form_lp1_r = denorm_zap(form_lp1_r); form_lp2_r = denorm_zap(form_lp2_r); form_lp3_r = denorm_zap(form_lp3_r); form_lp4_r = denorm_zap(form_lp4_r); form_lp5_r = denorm_zap(form_lp5_r);
  form_env0 = denorm_zap(form_env0); form_env1 = denorm_zap(form_env1); form_env2 = denorm_zap(form_env2); form_env3 = denorm_zap(form_env3); form_env4 = denorm_zap(form_env4); form_env5 = denorm_zap(form_env5);

  push_m_lp15 = denorm_zap(push_m_lp15); push_m_lp32 = denorm_zap(push_m_lp32); push_m_lp55 = denorm_zap(push_m_lp55);
  push_s_lp15 = denorm_zap(push_s_lp15); push_s_lp32 = denorm_zap(push_s_lp32); push_s_lp55 = denorm_zap(push_s_lp55);
  push_bodyE = denorm_zap(push_bodyE); push_formE = denorm_zap(push_formE); push_edgeE = denorm_zap(push_edgeE); push_airE = denorm_zap(push_airE); push_srcE = denorm_zap(push_srcE);
  push_m_hiE = denorm_zap(push_m_hiE); push_s_hiE = denorm_zap(push_s_hiE); push_click_fastE = denorm_zap(push_click_fastE); push_click_slowE = denorm_zap(push_click_slowE);
);

function denorm_flush_silent_tail_state()
(
  reset_weight_buffers();
  reset_clean_buffers();
  reset_room_buffers();
  reset_space_verb_buffers();
  reset_output_harmonics_buffers();
  reset_push_buffers();
  reset_push_pop_buffers();
  reset_formant_buffers();
  reset_focus_peak_buffers();
  reset_color_tilt_buffers();
  reset_dynamics_expand_buffers();
  reset_input_trigger_buffers();
  reset_processing_buffers();
  posteq_update_coeffs();
  fpk_update_coeffs();
  mix_fast = 0;
  mix_slow = 0;
  tone_lp_l = 0; tone_lp_r = 0;
  focus_lp_l = 0; focus_lp_r = 0;
  transient_guard_s = 0;
  dyn_env = 0;
  reset_dynamics_expand_buffers();
  reset_input_trigger_buffers();
);

function reset_bank_state() local(i)
(
  sample_count = 0;
  bank_selected_count = 0;
  bank_scan_count = 0;
  bank_skipped_count = 0;
  bank_cap_limited = 0;
  bank_memory_limited = 0;
  bank_pool_capacity = sample_pool_capacity;
  bank_pitchiness = 0;
  bank_brightness = 0;
  bank_brightness_spread = 0;
  bank_brightness_reliability = 0;
  bank_color_extreme = 0;
  bank_sharpness = 0;
  bank_sharpness_spread = 0;
  bank_sharpness_reliability = 0;
  bank_focus_extreme = 0;
  bank_exp_floor_db = -86;
  bank_exp_body_db = -48;
  bank_exp_peak_db = -18;
  bank_exp_tail_db = -72;
  bank_exp_range_db = 30;
  corpus_count = 0;
  corpus_best_idx = -1;
  corpus_best_sid = -1;
  next_audio = AUDIO_BASE;
  seq_cursor = 0;
  walk_last_sid = -1;
  walk_prev_sid = -1;
  walk_steps = 0;
  last_sid = -1;
  last_note = -1;
  i = 0;
  while (i < RECENT_LEN) (
    recent_base[i] = -1;
    i += 1;
  );
  reset_grain_histories();
  reset_voices();
  reset_note_gates();
  reset_weight_buffers();
  reset_clean_buffers();
  decrust_clear_state();
  reset_room_buffers();
  reset_space_verb_buffers();
  reset_output_harmonics_buffers();
  reset_push_buffers();
  reset_push_pop_buffers();
  reset_formant_buffers();
  reset_focus_peak_buffers();
  reset_color_tilt_buffers();
  reset_dynamics_expand_buffers();
  reset_input_trigger_buffers();
  reset_processing_buffers();
  init_flow_model();
  corpus_dirty = 1;
  posteq_pre_silent = 0;
  posteq_post_silent = 0;
  posteq_filter_silent = 0;
  denorm_silence_samps = 0;
  denorm_flush_counter = 0;
  transient_guard_s = 0;
  seam_bridge_env = 0;
  seam_bridge_idx = -1;
  seam_bridge_phase = -1;
  seam_bridge_same_note = 0;
);

function load_one_pool_sample(sample_index) local(
  sid nch sr frames sm j el er xl xr
)
(
  sid = sample_get(bank_pool, sample_index);
  sid > 0 && sample_count < sample_pool_capacity ? (
    nch = max(1, sample_channels(bank_pool, sid) | 0);
    sr = sample_srate(bank_pool, sid);
    frames = sample_len(bank_pool, sid) | 0;

    (nch > 0 && sr > 1000 && frames > 1) ? (
      sm = sample_meta_base + sample_count * SM_STRIDE;
      sm[SM_PTR]      = sid;
      sm[SM_NCH]      = nch;
      sm[SM_SR]       = sr;
      sm[SM_FRAMES]   = frames;
      sm[SM_LASTUSED] = -1000000;
      sm[SM_PEAK]     = sample_peak(bank_pool, sid);
      sm[SM_RMS]      = sample_rms(bank_pool, sid);
      el = 0; er = 0; j = 0;
      // One whole-file decision avoids sign changes from a per-frame max channel.
      while (j < frames) (
        xl = sample_read(bank_pool, sid, 0, j);
        xr = nch > 1 ? sample_read(bank_pool, sid, 1, j) : xl;
        el += xl * xl; er += xr * xr;
        j += 1;
      );
      analysis_channel_base[sid] = er > el ? 1 : 0;
      analyze_sample(sm);
      sample_count += 1;
    );
  );
);

function refresh_bank_stats() local(
  i sm spread_step spread_root pitch_sum bright_sum bright2_sum sharp_sum sharp2_sum bright_mean bright_var sharp_mean sharp_var exp_floor_sum exp_body_sum exp_peak_sum exp_tail_sum
)
(
  bank_pitchiness = 0;
  bank_brightness = 0;
  bank_brightness_spread = 0;
  bank_brightness_reliability = 0;
  bank_color_extreme = 0;
  bank_sharpness = 0;
  bank_sharpness_spread = 0;
  bank_sharpness_reliability = 0;
  bank_focus_extreme = 0;

  sample_count > 0 ? (
    spread_step = sample_count > 1 ? (ROOT_HIGH - ROOT_LOW) / (sample_count - 1) : 0;
    pitch_sum = 0;
    exp_floor_sum = 0;
    exp_body_sum = 0;
    exp_peak_sum = 0;
    exp_tail_sum = 0;
    bright_sum = 0;
    bright2_sum = 0;
    sharp_sum = 0;
    sharp2_sum = 0;
    i = 0;
    while (i < sample_count) (
      sm = sample_meta_base + i * SM_STRIDE;
      spread_root = ROOT_LOW + i * spread_step;
      sm[SM_ROOT] = sm[SM_PITCHCONF] > 0.40 ? clamp(sm[SM_PITCHNOTE], 0, 127) : spread_root;
      update_sample_cluster(sm);
      pitch_sum += sm[SM_PITCHCONF];
      exp_floor_sum += sm[SM_EXPFLOOR];
      exp_body_sum += sm[SM_EXPBODY];
      exp_peak_sum += sm[SM_EXPPEAK];
      exp_tail_sum += sm[SM_EXPTAIL];
      bright_sum += sm[SM_BRIGHT];
      bright2_sum += sm[SM_BRIGHT] * sm[SM_BRIGHT];
      sharp_sum += sm[SM_SHARP];
      sharp2_sum += sm[SM_SHARP] * sm[SM_SHARP];
      i += 1;
    );
    bank_pitchiness = clamp01(pitch_sum / sample_count);
    bank_exp_floor_db = exp_floor_sum / sample_count;
    bank_exp_body_db = max(bank_exp_floor_db + 8, exp_body_sum / sample_count);
    bank_exp_peak_db = max(bank_exp_body_db + 3, exp_peak_sum / sample_count);
    bank_exp_tail_db = exp_tail_sum / sample_count;
    bank_exp_range_db = clamp(bank_exp_body_db - bank_exp_floor_db, 8, 58);
    bright_mean = bright_sum / sample_count;
    bright_var = max(0, bright2_sum / sample_count - bright_mean * bright_mean);
    bank_brightness = clamp01(bright_mean);
    bank_brightness_spread = clamp(sqrt(bright_var), 0, 0.50);
    bank_brightness_reliability = clamp01(1 - bank_brightness_spread / 0.28);
    // Used by Color: extreme bright/dark banks get a stronger, more useful tilt.
    // Diverse banks get less automatic aggression because the average is less decisive.
    bank_color_extreme = clamp01(abs(bank_brightness - 0.50) / 0.32) * (0.55 + 0.45 * bank_brightness_reliability);

    sharp_mean = sharp_sum / sample_count;
    sharp_var = max(0, sharp2_sum / sample_count - sharp_mean * sharp_mean);
    bank_sharpness = clamp01(sharp_mean);
    bank_sharpness_spread = clamp(sqrt(sharp_var), 0, 0.50);
    bank_sharpness_reliability = clamp01(1 - bank_sharpness_spread / 0.30);
    // Used by Focus: sharp/dull banks get stronger corrective behavior,
    // but mixed banks avoid over-trusting the average.
    bank_focus_extreme = clamp01(abs(bank_sharpness - 0.50) / 0.32) * (0.55 + 0.45 * bank_sharpness_reliability);
  );

  sample_count > 0 ? (
    // v37 PerfGate: learned_flow_pick() is no longer called, so training the
    // tiny flow model was pure load-time overhead. The GrainCorpus is useful
    // only for Granular, so build it only when Granular is currently selected;
    // otherwise mark it dirty and build lazily on mode switch.
    init_flow_model();
    playback_mode == 3 ? (
      build_grain_corpus();
    ) : (
      corpus_count = 0;
      corpus_dirty = 1;
    );
  ) : (
    init_flow_model();
    corpus_count = 0;
    corpus_dirty = 0;
  );
  (abs(color_tilt_db) > 0.0001 && color_pivot_hz < 0) ? color_tilt_recalc_gains();

  bank_loaded = sample_count > 0;
);

function reanalyze_bank() local(i sm)
(
  i = 0;
  while (i < RECENT_LEN) (
    recent_base[i] = -1;
    i += 1;
  );
  reset_grain_histories();
  reset_weight_buffers();
  reset_clean_buffers();
  reset_room_buffers();
  reset_space_verb_buffers();
  reset_output_harmonics_buffers();
  reset_push_buffers();
  reset_formant_buffers();
  reset_focus_peak_buffers();
  transient_guard_s = 0;
  seq_cursor = 0;
  last_sid = -1;

  i = 0;
  while (i < sample_count) (
    sm = sample_meta_base + i * SM_STRIDE;
    analyze_sample(sm);
    i += 1;
  );

  refresh_bank_stats();
  rescan_flash = 1;
);

// v71 integration policy: independent state, true mix, lazy engines.
function v71_decode_controls() local(code)
(
  code = max(0, floor(slider59 + 0.5));
  v71_profile = min(20, code % 32);
  v71_thrill = min(150, floor(code / 32)) / 150;
  v71_mix = clamp01(slider27 / 100);
);

function v71_reset_input_delay()
(
  v71_input_epoch += 1;
  v71_input_pos = 0;
  v71_input_left = 0;
);

function v71_init_memory(base) local(nextbase)
(
  nextbase = sa_init(base);
  nextbase = st_init(nextbase + 32);
  nextbase = sc_init(nextbase + 32);
  v71_delay_ring = 16384;
  v71_input_l = nextbase + 32;
  v71_input_r = v71_input_l + v71_delay_ring;
  v71_input_tag = v71_input_r + v71_delay_ring;
  memset(v71_input_tag, 0, v71_delay_ring);
  v71_input_epoch = 0;
  v71_reset_input_delay();
  v71_decode_controls();
  v71_profile_live = v71_profile;
  v71_profile_gain = 1; v71_profile_target = 1;
  v71_profile_step = 1 / max(32, floor(0.005 * srate));
  v71_legacy_mix = 0; v71_legacy_idle = 0;
  v71_legacy_count = 0;
  v71_legacy_step = 1 / max(32, floor(0.012 * srate));
  v71_cached_profile = -1; v71_cached_mix = -1; v71_cached_thrill = -1;
  v71_cached_contour = -1;
  v71_contour_active = slider50 > 0.0001 ? 1 : 0;
  sc_config(v71_contour_active ? clamp01(slider50) : 0);
  v71_total_delay = (v71_contour_active ? sc_n : 0) + (dc_latency_active ? DECRUST_LATENCY : 0);
  v71_ready = 1;
  v71_input_tag + v71_delay_ring + 32;
);

function v71_sync_controls()
(
  v71_ready ? (
    v71_decode_controls();
    v71_profile != v71_profile_live ? (
      (event_clock_samps <= 0 || v71_profile_gain <= 0 || (!sa_running && v71_legacy_idle <= 0)) ? (
        sa_reset(); reset_push_buffers();
        v71_legacy_mix = 0; v71_legacy_idle = 0;
        v71_profile_live = v71_profile;
        v71_cached_profile = -1;
        v71_profile_target = 1;
      ) : v71_profile_target = 0;
    ) : v71_profile_target = 1;
    (v71_cached_profile != v71_profile_live || v71_cached_mix != v71_mix) ? (
      v71_profile_live > 0 ? sa_config(v71_profile_live, v71_mix) : sa_config(1, 0);
      v71_cached_profile = v71_profile_live; v71_cached_mix = v71_mix;
      event_clock_samps <= 0 && v71_profile_live == 0 ? v71_legacy_mix = v71_mix;
    );
    v71_cached_thrill != v71_thrill ? (
      st_config(v71_thrill); v71_cached_thrill = v71_thrill;
    );
    // A disable request retains the old delayed path until the output fade is
    // silent; decrust_sync_latency then commits topology at a block boundary.
    dynamics_expand_amt > 0.0001 && v71_cached_contour != dynamics_expand_amt ? (
      sc_config(dynamics_expand_amt); v71_cached_contour = dynamics_expand_amt;
    );
  );
);

function v71_reset_engines()
(
  v71_ready ? (
    sa_reset(); st_reset(); sc_reset();
    v71_reset_input_delay();
    v71_legacy_idle = 0;
  );
);

function v71_apply_antisalience() local(dryL dryR)
(
  dryL = outL; dryR = outR;
  v71_profile_gain += clamp(v71_profile_target - v71_profile_gain, -v71_profile_step, v71_profile_step);
  v71_profile_live == 0 ? (
    v71_legacy_mix += clamp(v71_mix - v71_legacy_mix, -v71_legacy_step, v71_legacy_step);
    v71_legacy_mix > 0 ? (
      max(abs(dryL), abs(dryR)) > 0.00000000000000000001 ? v71_legacy_idle = max(1, floor(0.120 * srate));
      v71_legacy_idle > 0 ? (
        // Legacy is the original full-strength Push processor. The visible
        // knob is now a real overall dry/wet mix for every profile.
        apply_push(); v71_legacy_count += 1;
        v71_legacy_idle -= 1;
        outL = lerp(dryL, outL, v71_legacy_mix * v71_profile_gain);
        outR = lerp(dryR, outR, v71_legacy_mix * v71_profile_gain);
        v71_legacy_idle <= 0 ? reset_push_buffers();
      );
    ) : v71_legacy_idle > 0 ? (reset_push_buffers(); v71_legacy_idle = 0;);
  ) : (
    (v71_mix > 0 || sa_running || sa_mix_cur > 0) ? (
      sa_process(dryL, dryR);
      outL = lerp(dryL, sa_out_l, v71_profile_gain);
      outR = lerp(dryR, sa_out_r, v71_profile_gain);
    );
  );
);

function configure_memory_layout(selected_count) local(cap) (
  cap = max(SAMPLE_POOL_MIN, selected_count | 0);
  cap > SAMPLE_POOL_HARD_MAX ? cap = SAMPLE_POOL_HARD_MAX;
  sample_pool_capacity = cap;

  sample_meta_base = 0;
  corpus_capacity = clamp(max(GRAIN_CORPUS_MIN, (selected_count | 0) * 64), GRAIN_CORPUS_MIN, GRAIN_CORPUS_HARD_MAX) | 0;
  grain_corpus_base = sample_meta_base + sample_pool_capacity * SM_STRIDE + 32;
  voice_base = grain_corpus_base + corpus_capacity * GC_STRIDE + 64;
  recent_base = voice_base + MAX_VOICES * VC_STRIDE;
  grain_hist_sid_base = recent_base + RECENT_LEN + 32;
  grain_hist_pos_base = grain_hist_sid_base + MAX_VOICES * GRAIN_HIST_LEN;
  grain_hist_phase_base = grain_hist_pos_base + MAX_VOICES * GRAIN_HIST_LEN;
  flow_model_base = grain_hist_phase_base + MAX_VOICES * GRAIN_HIST_LEN + 32;
  sig_scratch_base = flow_model_base + FLOW_WEIGHTS + 32;
  onset_raw_base = sig_scratch_base + SIG_PEEK_WORDS + 64;
  onset_smooth_base = onset_raw_base + ONSET_SCRATCH_MAX;

  note_gate_base = onset_smooth_base + ONSET_SCRATCH_MAX + 96;

  note_on_seq_base = note_gate_base + NOTE_GATE_CELLS;
  note_off_seq_base = note_on_seq_base + NOTE_GATE_CELLS;
  midi_queue_base = note_off_seq_base + NOTE_GATE_CELLS;
  analysis_copy_base = midi_queue_base + MIDI_QUEUE_CAP * 3;
  analysis_channel_base = analysis_copy_base + SM_STRIDE;
  analysis_filter_base = analysis_channel_base + sample_pool_capacity + 1;
  weight_ap1_l_base = analysis_filter_base + 1025 + 64;
  weight_ap1_r_base = weight_ap1_l_base + AP_BUF_LEN;
  weight_ap2_l_base = weight_ap1_r_base + AP_BUF_LEN;
  weight_ap2_r_base = weight_ap2_l_base + AP_BUF_LEN;
  weight_er_l_base  = weight_ap2_r_base + AP_BUF_LEN;
  weight_er_r_base  = weight_er_l_base + ER_BUF_LEN;

  clean_env_base   = weight_er_r_base + ER_BUF_LEN + 256;
  clean_floor_base = clean_env_base + CLEAN_BANDS;
  clean_slow_base  = clean_floor_base + CLEAN_BANDS;
  clean_gain_base  = clean_slow_base + CLEAN_BANDS;

  posteq_spec_lp_base = clean_gain_base + CLEAN_BANDS + 32;
  posteq_spec_z2_base = posteq_spec_lp_base + POSTEQ_SPEC_BINS;
  posteq_spec_env_base = posteq_spec_z2_base + POSTEQ_SPEC_BINS;
  posteq_post_z1_base = posteq_spec_env_base + POSTEQ_SPEC_BINS;
  posteq_post_z2_base = posteq_post_z1_base + POSTEQ_SPEC_BINS;
  posteq_post_env_base = posteq_post_z2_base + POSTEQ_SPEC_BINS;
  posteq_spec_coeff_base = posteq_post_env_base + POSTEQ_SPEC_BINS;
  posteq_pre_rz1_base = posteq_spec_coeff_base + POSTEQ_SPEC_BINS * POSTEQ_SPEC_COEFFS;
  posteq_pre_rz2_base = posteq_pre_rz1_base + POSTEQ_SPEC_BINS;
  posteq_post_rz1_base = posteq_pre_rz2_base + POSTEQ_SPEC_BINS;
  posteq_post_rz2_base = posteq_post_rz1_base + POSTEQ_SPEC_BINS;
  posteq_bq_base = posteq_post_rz2_base + POSTEQ_SPEC_BINS + 32;
  posteq_char_bq_base = posteq_bq_base + POSTEQ_BQ_COUNT * POSTEQ_BQ_STRIDE + 32;
  fpk_env_base = posteq_char_bq_base + POSTEQ_CHAR_BQ_COUNT * POSTEQ_CHAR_BQ_STRIDE + 32;
  fpk_gain_base = fpk_env_base + FPK_BANDS;
  fpk_band_l_base = fpk_gain_base + FPK_BANDS;
  fpk_band_r_base = fpk_band_l_base + FPK_BANDS;
  fpk_bq_base = fpk_band_r_base + FPK_BANDS + 32;

  color_tilt_lp_l_base = fpk_bq_base + FPK_BANDS * FPK_BQ_STRIDE + 256;
  color_tilt_lp_r_base = color_tilt_lp_l_base + COLOR_TILT_XOVERS;
  color_tilt_pre_base = color_tilt_lp_r_base + COLOR_TILT_XOVERS;
  color_tilt_post_base = color_tilt_pre_base + COLOR_TILT_BANDS;
  color_tilt_env_f_base = color_tilt_post_base + COLOR_TILT_BANDS;
  color_tilt_env_s_base = color_tilt_env_f_base + COLOR_TILT_BANDS;
  color_tilt_gain_base = color_tilt_env_s_base + COLOR_TILT_BANDS;
  color_tilt_weight_base = color_tilt_gain_base + COLOR_TILT_BANDS;
  color_tilt_fc_base = color_tilt_weight_base + COLOR_TILT_BANDS;
  color_tilt_erb_base = color_tilt_fc_base + COLOR_TILT_BANDS;
  color_tilt_coeff_base = color_tilt_erb_base + COLOR_TILT_BANDS;

  dc_inl_base = color_tilt_coeff_base + COLOR_TILT_XOVERS + 256;
  dc_inr_base = dc_inl_base + DECRUST_RING;
  dc_outl_base = dc_inr_base + DECRUST_RING;
  dc_outr_base = dc_outl_base + DECRUST_RING;
  dc_fftl_base = dc_outr_base + DECRUST_RING;
  dc_fftr_base = dc_fftl_base + DECRUST_FFT * 2;
  dc_win_base = dc_fftr_base + DECRUST_FFT * 2;
  dc_syn_base = dc_win_base + DECRUST_FFT;
  dc_mag_base = dc_syn_base + DECRUST_FFT;
  dc_base_base = dc_mag_base + DECRUST_BINS;
  dc_prev_base = dc_base_base + DECRUST_BINS;
  dc_m1_base = dc_prev_base + DECRUST_BINS;
  dc_m2_base = dc_m1_base + DECRUST_BINS;
  dc_m3_base = dc_m2_base + DECRUST_BINS;
  dc_m4_base = dc_m3_base + DECRUST_BINS;
  dc_gain_base = dc_m4_base + DECRUST_BINS;

  dc_padl_base = dc_gain_base + DECRUST_BINS;
  dc_padr_base = dc_padl_base + 8;
  input_delay_l_base = dc_padr_base + 8;
  input_delay_r_base = input_delay_l_base + DECRUST_RING;
  space_l_base = input_delay_r_base + DECRUST_RING + 256;
  space_r_base = space_l_base + SPACE_BUF_LEN;

  harm_lpa_l_base = space_r_base + SPACE_BUF_LEN + 256;
  harm_lpb_l_base = harm_lpa_l_base + HARM_XOVERS;
  harm_lpa_r_base = harm_lpb_l_base + HARM_XOVERS;
  harm_lpb_r_base = harm_lpa_r_base + HARM_XOVERS;
  harm_band_l_base = harm_lpb_r_base + HARM_XOVERS;
  harm_band_r_base = harm_band_l_base + HARM_BANDS;
  harm_env_base = harm_band_r_base + HARM_BANDS;
  harm_dcx_l_base = harm_env_base + HARM_BANDS;
  harm_dcy_l_base = harm_dcx_l_base + HARM_BANDS;
  harm_dcx_r_base = harm_dcy_l_base + HARM_BANDS;
  harm_dcy_r_base = harm_dcx_r_base + HARM_BANDS;
  harm_coeff_base = harm_dcy_r_base + HARM_BANDS;

  pop_lpa_l_base = harm_coeff_base + HARM_XOVERS + 32;
  pop_lpb_l_base = pop_lpa_l_base + POP_XOVERS;
  pop_lpa_r_base = pop_lpb_l_base + POP_XOVERS;
  pop_lpb_r_base = pop_lpa_r_base + POP_XOVERS;
  pop_band_l_base = pop_lpb_r_base + POP_XOVERS;
  pop_band_r_base = pop_band_l_base + POP_BANDS;
  pop_fast_l_base = pop_band_r_base + POP_BANDS;
  pop_fast_r_base = pop_fast_l_base + POP_BANDS;
  pop_mid_l_base = pop_fast_r_base + POP_BANDS;
  pop_mid_r_base = pop_mid_l_base + POP_BANDS;
  pop_slow_l_base = pop_mid_r_base + POP_BANDS;
  pop_slow_r_base = pop_slow_l_base + POP_BANDS;
  pop_env_fast_base = pop_slow_r_base + POP_BANDS;
  pop_env_slow_base = pop_env_fast_base + POP_BANDS;
  pop_floor_base = pop_env_slow_base + POP_BANDS;
  pop_xover_coeff_base = pop_floor_base + POP_BANDS;
  pop_fast_coeff_base = pop_xover_coeff_base + POP_XOVERS;
  pop_mid_coeff_base = pop_fast_coeff_base + POP_BANDS;
  pop_slow_coeff_base = pop_mid_coeff_base + POP_BANDS;

  dynx_bank_base = pop_slow_coeff_base + POP_BANDS + 32;

  hub_packet_base = dynx_bank_base + DYNX_BANDS * DYNX_STRIDE + 64;
  hub_mod_base = hub_packet_base + 16 * HP_STRIDE;
  hub_log_base = hub_mod_base + HUB_MOD_CAP * HM_STRIDE;
  memset(hub_packet_base, 0, 16 * HP_STRIDE + HUB_MOD_CAP * HM_STRIDE + 1200);
  hub_log_head = 0; hub_log_count = 0; hub_log_serial = 0;
  hub_log_accepted = 0; hub_log_rejected = 0;
  hub_accept_count = 0; hub_reject_count = 0;
  hub_voice_count = 0; hub_mod_count = 0; hub_pending_mask = 0;
  hub_rng_on = 0; hub_starting = 0;
  AUDIO_BASE = v71_init_memory(hub_log_base + 1200 + 256);
  MEM_LIMIT   = max(AUDIO_BASE + 1024, (__memtop() | 0) - 256);
);

function load_bank() local(
  selected loaded count i before_count
)
(
  sample_pool_set_mode(bank_pool, bank_budget_mb > 0 ? SAMPLE_MODE_BUDGETED : SAMPLE_MODE_RESIDENT);
  sample_pool_set_budget_mb(bank_pool, bank_budget_mb);
  sample_pool_commit(bank_pool);

  selected = max(0, sample_pool_selected(bank_pool) | 0);
  loaded = max(0, sample_pool_loaded(bank_pool) | 0);
  pool_state = sample_pool_state(bank_pool);
  pool_ram_mb = sample_pool_ram_mb(bank_pool);

  (pool_state != SAMPLE_POOL_SCANNING && pool_state != SAMPLE_POOL_LOADING) ? (
    sample_pool_adopt(bank_pool) < 0 ? pool_state = SAMPLE_POOL_LOADING;
  );
  (pool_state == SAMPLE_POOL_SCANNING || pool_state == SAMPLE_POOL_LOADING) ? (
    // Keep the previous generation playable while the worker builds the next one.
    bank_selected_count = selected;
    rescan_pending = 1;
  ) : (
    loaded = max(0, sample_pool_loaded(bank_pool) | 0);
    configure_memory_layout(max(selected, loaded));
    reset_bank_state();
    posteq_update_coeffs();
    fpk_update_coeffs();
    color_tilt_update_coeffs();
    color_tilt_recalc_gains();

    harm_update_coeffs();

    bank_selected_count = selected;
    bank_scan_count = loaded;
    bank_pool_capacity = sample_pool_capacity;
    bank_cap_limited = bank_selected_count > sample_pool_capacity ? 1 : 0;
    bank_memory_limited = sample_pool_failed(bank_pool) > 0 ? 1 : 0;

    count = min(sample_pool_capacity, loaded);
    i = 0;
    while (i < count) (
      before_count = sample_count;
      load_one_pool_sample(i);
      sample_count == before_count ? bank_skipped_count += 1;
      i += 1;
    );

    bank_skipped_count += max(0, selected - loaded);
    refresh_bank_stats();
    seq_cursor = 0;
    rescan_flash = 1;
    next_audio = AUDIO_BASE;
    freembuf(AUDIO_BASE);
  );
);

function compute_slot_signature() local(sig)
(
  sample_pool_set_mode(bank_pool, bank_budget_mb > 0 ? SAMPLE_MODE_BUDGETED : SAMPLE_MODE_RESIDENT);
  sample_pool_set_budget_mb(bank_pool, bank_budget_mb);
  sample_pool_commit(bank_pool);

  pool_state = sample_pool_state(bank_pool);
  pool_ram_mb = sample_pool_ram_mb(bank_pool);
  bank_selected_count = max(0, sample_pool_selected(bank_pool) | 0);

  sig = sample_pool_generation(bank_pool);
  sig += sample_pool_loaded(bank_pool) * 8191;
  sig += sample_pool_failed(bank_pool) * 131;
  sig += pool_state * 17;
  sig;
);

function schedule_rescan(sig force)
(
  pending_signature = sig;
  rescan_pending = 1;
  force ? rescan_force = 1;
);

function poll_slot(force) local(sig)
(
  sig = compute_slot_signature();
  force || sig != slot_signature_loaded ? schedule_rescan(sig, force);
);

function choose_sample(note velnorm) local(sid)
(
  sample_count <= 0 ? 0 : (
    selection_mode == 1 ? (
      sid = seq_cursor % max(sample_count, 1);
      seq_cursor = (seq_cursor + 1) % max(sample_count, 1);
      sid;
    ) : selection_mode == 2 ? (
      choose_walk_sample(note, velnorm);
    ) : (
      choose_random_sample(note, velnorm);
    );
  );
);

function choose_tail_donor(src_sid wideness) local(
  src sm i pick accum totalw score weight sid
  brighterr sharperr transerr lenerr pitcherr tailerr walkerr temp
)
(
  (sample_count <= 1 || src_sid < 0) ? src_sid : (
    src = sample_meta_base + src_sid * SM_STRIDE;
    temp = lerp(8.0, 2.4, clamp01(wideness));
    totalw = 0;

    i = 0;
    while (i < sample_count) (
      i != src_sid ? (
        sm = sample_meta_base + i * SM_STRIDE;
        brighterr = abs(sm[SM_BRIGHT] - src[SM_BRIGHT]);
        sharperr  = abs(sm[SM_SHARP] - src[SM_SHARP]);
        transerr  = abs(sm[SM_FLAGS] - src[SM_FLAGS]);
        lenerr    = abs(log((sm[SM_LENMS] + 1) / (src[SM_LENMS] + 1)));
        tailerr   = abs((sm[SM_FRAMES] - sm[SM_TAILSTART]) - (src[SM_FRAMES] - src[SM_TAILSTART])) / max(src[SM_FRAMES], 1);

        pitcherr = 0;
        (src[SM_PITCHCONF] > 0.38 && sm[SM_PITCHCONF] > 0.38) ? (
          pitcherr = abs(sm[SM_ROOT] - src[SM_ROOT]) / 24;
        );

        score = brighterr * 1.10 + sharperr * 1.15 + transerr * 0.85 + lenerr * 0.42 + tailerr * 0.55;
        score += pitcherr * (0.20 + 0.70 * bank_pitchiness);
        walk_mode ? (
          walkerr = sample_descriptor_distance(src, sm, 1);
          score += walkerr * 0.22;
        );

        weight = 0.02 + exp(-score * temp);
        totalw += weight;
      );
      i += 1;
    );

    totalw <= 0 ? src_sid : (
      pick = hub_random(totalw);
      accum = 0;
      sid = src_sid;
      i = 0;
      while (i < sample_count) (
        i != src_sid ? (
          sm = sample_meta_base + i * SM_STRIDE;
          brighterr = abs(sm[SM_BRIGHT] - src[SM_BRIGHT]);
          sharperr  = abs(sm[SM_SHARP] - src[SM_SHARP]);
          transerr  = abs(sm[SM_FLAGS] - src[SM_FLAGS]);
          lenerr    = abs(log((sm[SM_LENMS] + 1) / (src[SM_LENMS] + 1)));
          tailerr   = abs((sm[SM_FRAMES] - sm[SM_TAILSTART]) - (src[SM_FRAMES] - src[SM_TAILSTART])) / max(src[SM_FRAMES], 1);

          pitcherr = 0;
          (src[SM_PITCHCONF] > 0.38 && sm[SM_PITCHCONF] > 0.38) ? (
            pitcherr = abs(sm[SM_ROOT] - src[SM_ROOT]) / 24;
          );

          score = brighterr * 1.10 + sharperr * 1.15 + transerr * 0.85 + lenerr * 0.42 + tailerr * 0.55;
          score += pitcherr * (0.20 + 0.70 * bank_pitchiness);
          walk_mode ? (
            walkerr = sample_descriptor_distance(src, sm, 1);
            score += walkerr * 0.22;
          );

          weight = 0.02 + exp(-score * temp);
          accum += weight;
          accum >= pick ? (
            sid = i;
            i = sample_count;
          ) : i += 1;
        ) : i += 1;
      );
      sid;
    );
  );
);


function alloc_voice() local(i v found best best_age)
(
  found = -1;
  best = 0;
  best_age = 100000000000;

  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    v[VC_ACTIVE] <= 0 ? (
      found = i;
      i = MAX_VOICES;
    ) : (
      v[VC_AGE] < best_age ? (
        best_age = v[VC_AGE];
        best = i;
      );
      i += 1;
    );
  );

  found >= 0 ? found : best;
);

function prepare_release_attack_bridge(note chan) local(
  i v env same_count any_count same_best any_best same_idx any_idx
  lo hi phase
)
(
  seam_bridge_env = 0;
  seam_bridge_idx = -1;
  seam_bridge_phase = -1;
  seam_bridge_same_note = 0;
  seam_bridge_note = note;
  seam_bridge_chan = chan;

  // Hybrid retrigger seam: if the previous sample is still in granular Release,
  // the next Attack begins from the equivalent envelope level instead of from 0.
  // Same-note releases are preferred; a single same-channel release can bridge too.
  (playback_mode >= 2 && granular_amt > 0.0001) ? (
    same_count = 0;
    any_count = 0;
    same_best = 0;
    any_best = 0;
    same_idx = -1;
    any_idx = -1;

    i = 0;
    while (i < MAX_VOICES) (
      v = voice_base + i * VC_STRIDE;
      (v[VC_ACTIVE] > 0 && v[VC_HUB_ID] <= 0 && v[VC_STAGE] == ENV_RELEASE && v[VC_GMODE] > 0 && v[VC_GMIX] > 0.0001 && v[VC_CHAN] == chan) ? (
        env = clamp01(v[VC_ENV]);
        env > 0.0005 ? (
          (v[VC_NOTE] == note) ? (
            same_count += 1;
            env > same_best ? (
              same_best = env;
              same_idx = i;
            );
          ) : (
            any_count += 1;
            env > any_best ? (
              any_best = env;
              any_idx = i;
            );
          );
        );
      );
      i += 1;
    );

    same_count > 0 ? (
      seam_bridge_env = same_best;
      seam_bridge_idx = same_idx;
      seam_bridge_same_note = 1;
    ) : (any_count == 1 ? (
      seam_bridge_env = any_best;
      seam_bridge_idx = any_idx;
      seam_bridge_same_note = 0;
    ));

    seam_bridge_idx >= 0 ? (
      v = voice_base + seam_bridge_idx * VC_STRIDE;
      lo = max(0, floor(v[VC_BODYSTART]));
      hi = max(lo + 1, floor(v[VC_BODYEND]));
      phase = clamp01((v[VC_NEXTSRC] - lo) / max(1, hi - lo));
      seam_bridge_phase = phase;
    );
  );

  seam_bridge_env;
);

function apply_release_attack_bridge(skip_idx) local(i v use)
(
  seam_bridge_env > 0.0005 ? (
    i = 0;
    while (i < MAX_VOICES) (
      v = voice_base + i * VC_STRIDE;
      use = 0;
      (i != skip_idx && v[VC_ACTIVE] > 0 && v[VC_HUB_ID] <= 0 && v[VC_STAGE] == ENV_RELEASE && v[VC_GMODE] > 0 && v[VC_GMIX] > 0.0001 && v[VC_CHAN] == seam_bridge_chan) ? (
        seam_bridge_same_note ? (
          v[VC_NOTE] == seam_bridge_note ? use = 1;
        ) : (
          i == seam_bridge_idx ? use = 1;
        );
      );

      use ? (
        // Handoff, not a hard kill: the old release keeps granular continuity but
        // fades on a short seam budget so the new Attack can take over smoothly.
        v[VC_RSTEP] = min(v[VC_RSTEP], seam_bridge_release_coef);
        v[VC_RHLEFT] = min(v[VC_RHLEFT], seam_bridge_samps);
        // Once this release has been consumed by a new Attack, do not let the
        // old voice spawn fresh body grains. Existing grains can fade, but this
        // prevents the old sample from sounding like a second retrigger.
        v[VC_CANSPAWN] = 0;
        v[VC_GTIMER] = max(v[VC_GTIMER], seam_bridge_samps);
        (!env_slope_is_classic(v[VC_RCURVE], ENV_FALL)) ? (
          v[VC_EPHASE] = 0;
          v[VC_ESTART] = v[VC_ENV];
          v[VC_RLEN] = min(max(1, floor(v[VC_RLEN])), seam_bridge_samps);
        );
      );

      i += 1;
    );
  );
);

function fade_same_note_releases_for_retrigger(note chan skip_idx) local(i v)
(
  // Same-note retriggers should hand off; they should not leave an old Tape/Raw
  // release audibly trailing behind the new Attack. This is deliberately scoped
  // to already-releasing voices so normal polyphonic overlaps remain intact.
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (i != skip_idx && v[VC_ACTIVE] > 0 && v[VC_HUB_ID] <= 0 && v[VC_AUDIOTRIG] <= 0 && v[VC_STAGE] == ENV_RELEASE && v[VC_NOTE] == note && v[VC_CHAN] == chan) ? (
      v[VC_RSTEP] = min(v[VC_RSTEP], seam_bridge_release_coef);
      v[VC_RHLEFT] = min(v[VC_RHLEFT], seam_bridge_samps);
      v[VC_CANSPAWN] = 0;
      v[VC_GTIMER] = max(v[VC_GTIMER], seam_bridge_samps);
      (!env_slope_is_classic(v[VC_RCURVE], ENV_FALL)) ? (
        v[VC_EPHASE] = 0;
        v[VC_ESTART] = v[VC_ENV];
        v[VC_RLEN] = min(max(1, floor(v[VC_RLEN])), seam_bridge_samps);
      );
    );
    i += 1;
  );
);

function start_voice(note vel chan) local(
  velnorm sid sm donor donor_sm voice_idx v source_rng_on
  srcsr norm gain env0 lively playmode gran_voice ggrain_amt voice_stretch voice_stretch_norm
  driftcents raw_rate base_rate attack_rate pitch_protect pitch_abs head_hold_src head_hold_out
  transrich transprot translock hold_ms trans_hold_src trans_hold_out attack_preroll
  attack_anchor attack_norm pre_avail pre_keep align_guard align_jit
  j jmax pre startpos softskip gain_jit_db
  bodystart bodyend tailstart donor_tail min_body_span remain voice_hold_samps
  gesture_len gesture_depth
  voice_attack_samps voice_release_samps voice_attack_coef voice_release_coef
)
(
  sample_count <= 0 ? 0 : (
    velnorm = vel / 127;
    source_rng_on = hub_rng_on;
    hub_rng_on = 0;
    sid = choose_sample(note, velnorm);
    hub_rng_on = source_rng_on;
    sm = sample_meta_base + sid * SM_STRIDE;

    hub_starting ? (
      seam_bridge_env = 0; seam_bridge_idx = -1; seam_bridge_phase = -1;
    ) : prepare_release_attack_bridge(note, chan);

    voice_idx = alloc_voice();
    last_start_voice_idx = voice_idx;
    hub_cancel_voice(voice_idx, 16);
    v = voice_base + voice_idx * VC_STRIDE;

    j = 0;
    while (j < VC_STRIDE) (
      v[j] = 0;
      j += 1;
    );
    grain_hist_clear_voice(voice_idx);

    note_counter += 1;
    last_note = note;
    last_sid = sid;

    lively = clamp01(slider9);
    playmode = playback_mode;
    gran_voice = playmode == 3 ? 1 : 0;
    ggrain_amt = gran_voice ? max(0.18, granular_amt) : granular_amt;
    playmode == 0 ? voice_stretch = 1 : voice_stretch = stretch_ratio;
    voice_stretch = max(1, voice_stretch);
    voice_stretch_norm = clamp01((voice_stretch - 1) / 3);

    voice_attack_samps = auto_smooth_ar ? max(1, floor(auto_smooth_next_attack_samps)) : attack_samps;
    voice_release_samps = auto_smooth_ar ? max(1, floor(auto_smooth_next_release_samps)) : release_samps;
    voice_attack_coef = voice_attack_samps <= 1 ? 1 : (1 - exp(-6.90775527898214 / max(1, voice_attack_samps)));
    voice_release_coef = voice_release_samps <= 1 ? 0 : exp(-6.90775527898214 / max(1, voice_release_samps));

    attack_anchor = onset_mode_active ? sm[SM_GAUSS_ATTACK] : sm[SM_CLASSIC_ATTACK];
    srcsr = sm[SM_SR];
    norm  = sm[SM_NORM];
    gain  = (0.10 + 0.90 * (velnorm ^ 1.35)) * lerp(norm, 1, truth_mix);
    gain_jit_db = (hub_random(1) - 0.5) * lively * 0.8;
    gain *= db2amp(gain_jit_db);
    gain  = min(gain, 2.0);

    transrich = clamp01(sm[SM_FLAGS]);
    transprot = 0;
    transient_mode == 1 ? transprot = 1
    : transient_mode == 2 ? transprot = 0
    : transprot = clamp01((transrich - 0.38) / 0.44);
    translock = transprot >= 0.22 ? 1 : 0;

    driftcents = (hub_random(1) - 0.5) * (0.25 + lively * lively * 10.0);

    onset_mode_active ? (
      attack_norm = curve_norm(slider2, 0.1, 500, CURVE_TIME);
      pre_avail = max(0, attack_anchor);
      pre_keep = floor(pre_avail * attack_norm);

      translock ? (
        align_guard = min(pre_avail, max(0, floor(srcsr * (0.00020 + 0.00035 * transprot))));
        align_jit = floor(lively * (1 - transprot) * max(1, min(6, 1 + pre_avail * 0.035)));
        startpos = floor(attack_anchor - pre_keep - align_guard + (hub_random(1) - 0.5) * align_jit);
      ) : (
        pre  = min(pre_avail, floor(2 + attack_norm * min(64, 8 + pre_avail * 0.18)));
        jmax = floor((0.35 + lively * 2.05) * max(2, min(18, 2 + pre_avail * 0.08)));
        softskip = max(0, -slider7) * min(16, 2 + pre_avail * 0.06);
        startpos = floor(attack_anchor - max(pre_keep, pre) + (hub_random(1) - 0.5) * jmax + softskip);
      );
    ) : (
      translock ? (
        attack_preroll = min(attack_anchor, max(0, floor(srcsr * (0.00035 + 0.00045 * transprot))));
        jmax = floor(lively * (1 - transprot) * min(4, 1 + attack_anchor * 0.02));
        startpos = floor(attack_anchor - attack_preroll + (hub_random(1) - 0.5) * jmax);
      ) : (
        pre  = min(attack_anchor, 8 + lively * 8);
        jmax = floor((0.25 + lively * 1.75) * min(16, 2 + attack_anchor * 0.08));
        softskip = max(0, -slider7) * min(16, 2 + attack_anchor * 0.06);
        startpos = floor(attack_anchor - pre + (hub_random(1) - 0.5) * jmax + softskip);
      );
    );

    startpos = clamp(startpos, 0, max(0, sm[SM_FRAMES] - 2));
    raw_rate = (srcsr / srate) * midi_ratio(pitch_semi) * cents_ratio(driftcents);
    base_rate = raw_rate / voice_stretch;

    // v14 PitchSnap: transient-pinned attack rate. Stretch never slows the
    // protected head, and large pitch shifts are eased on transient-rich hits
    // so impacts keep their snap instead of becoming smeared clicks.
    pitch_abs = clamp01(abs(pitch_semi) / 12);
    pitch_protect = transient_mode == 2 ? 0 : clamp01(transprot * (0.28 + 0.72 * pitch_abs));
    transient_mode == 1 ? pitch_protect = clamp01(pitch_protect * 1.15 + transprot * 0.08);
    attack_rate = (srcsr / srate) * midi_ratio(pitch_semi * (1 - pitch_protect)) * cents_ratio(driftcents);

    hold_ms = translock ? (lerp(5.5, 15.5, transprot) + voice_stretch_norm * lerp(2.0, 9.5, transprot) + pitch_abs * transprot * 5.0) : 0;
    hold_ms = min(hold_ms, sm[SM_LENMS] * 0.30);
    trans_hold_src = translock ? min(max(0, sm[SM_FRAMES] - 2 - startpos), floor(srcsr * hold_ms * 0.001)) : 0;
    head_hold_src = translock ? clamp(sm[SM_HEADEND] - startpos + floor(srcsr * 0.0015), 0, max(0, sm[SM_FRAMES] - 2 - startpos)) : 0;
    head_hold_src = min(head_hold_src, floor(srcsr * lerp(0.010, 0.034, transprot)));
    trans_hold_src = max(trans_hold_src, head_hold_src);
    trans_hold_out = translock ? clamp(floor(trans_hold_src / max(abs(attack_rate), 0.000001)), 0, 8192) : 0;

    bodystart = clamp(sm[SM_HEADEND], 0, max(0, sm[SM_FRAMES] - 2));
    tailstart = clamp(sm[SM_TAILSTART], bodystart + 1, max(bodystart + 1, sm[SM_FRAMES] - 2));
    remain = max(1, tailstart - bodystart);
    min_body_span = min(max(48, floor(max(srcsr * (0.020 + 0.016 * lively), hybrid_grain_samps * 0.85))), remain);
    remain < min_body_span ? (
      bodystart = max(sm[SM_HEADEND], tailstart - min_body_span);
      bodystart = clamp(bodystart, 0, max(0, tailstart - 1));
    );
    bodyend = max(bodystart + 1, tailstart);
    voice_hold_samps = max(0, hold_samps);

    donor = choose_region_donor(sid, 1, tail_borrow * (0.55 + 0.45 * lively), voice_idx);
    donor < 0 ? donor = sid;
    donor_sm = sample_meta_base + donor * SM_STRIDE;
    donor_tail = clamp(donor_sm[SM_TAILSTART], 0, max(0, donor_sm[SM_FRAMES] - 2));

    v[VC_ACTIVE] = 1;
    v[VC_NOTE]   = note;
    v[VC_CHAN]   = chan;
    v[VC_KEYTOKEN] = note_on_seq_base[note_gate_idx(note, chan)];
    v[VC_SAMPLE] = sid;
    v[VC_POS]    = startpos;
    v[VC_RATE]   = base_rate;
    v[VC_BASE]   = gain * (gran_voice ? 1.55 : 1);
    env0 = (voice_attack_samps <= 1 || (translock && voice_attack_samps <= floor(0.010 * srate))) ? 1 : 0;
    (playmode >= 2 && ggrain_amt > 0.0001 && seam_bridge_env > 0.0005) ? (
      // Attack begins from the current Release level, matching the Phase Plant-style
      // release-point -> equivalent-attack-point retrigger behavior. This overrides
      // the usual fast Punch/Gaussian env=1 shortcut, except for a true 1-sample attack.
      env0 = voice_attack_samps <= 1 ? 1 : min(0.985, seam_bridge_env);
    );
    v[VC_ENV]    = env0;
    v[VC_ASTEP]  = voice_attack_coef;
    v[VC_DSTEP]  = decay_coef;
    v[VC_RSTEP]  = voice_release_coef;
    v[VC_HLEFT]  = voice_hold_samps;
    v[VC_STAGE]  = env0 >= 1 ? (voice_hold_samps > 0 ? ENV_HOLD : ENV_DECAY) : ENV_ATTACK;
    v[VC_AGE]    = note_counter;
    v[VC_EPHASE] = 0;
    v[VC_ESTART] = env0;
    v[VC_ALEN]   = voice_attack_samps;
    v[VC_DLEN]   = decay_samps;
    v[VC_RLEN]   = voice_release_samps;
    v[VC_ACURVE] = attack_slope_pct;
    v[VC_DCURVE] = decay_slope_pct;
    v[VC_RCURVE] = release_slope_pct;
    (playmode >= 2 && ggrain_amt > 0.0001 && seam_bridge_env > 0.0005 && env0 < 1 && !env_slope_is_classic(attack_slope_pct, ENV_RISE)) ? (
      // For non-classic slopes, continue from the equivalent Attack curve point
      // instead of spending a full Attack time above the inherited Release level.
      v[VC_ESTART] = 0; // inherited level is represented by phase, not added twice
      v[VC_EPHASE] = env_slope_inv(env0, env_segment_slope(attack_slope_pct, ENV_RISE)) * max(1, voice_attack_samps);
    );

    v[VC_GMODE]    = (playmode >= 2 && ggrain_amt > 0.0001) ? 1 : 0;
    v[VC_OHOP]     = hybrid_hop_samps;
    v[VC_GSIZE]    = gran_voice ? max(hybrid_hop_samps + 1, floor(hybrid_grain_samps * lerp(1.0, 2.20, granular_event_stretch))) : hybrid_grain_samps;
    // Hybrid waits until transient protection clears because the direct head is audible.
    // Granular has no audible direct head, so its HybridCore grain layer starts immediately.
    v[VC_GTIMER]   = gran_voice ? (-floor(max(1, hybrid_hop_samps) * 3)) : max(1, trans_hold_out + 1);
    v[VC_NEXTSRC]  = max(bodystart, min(startpos, bodyend - 1));
    (playmode >= 2 && ggrain_amt > 0.0001 && seam_bridge_env > 0.0005 && seam_bridge_phase >= 0) ? (
      // The new Hybrid body cursor starts at the matching normalized body phase
      // of the releasing voice, while the direct head still uses Gaussian/onset alignment.
      v[VC_NEXTSRC] = clamp(bodystart + seam_bridge_phase * max(1, bodyend - bodystart - 1), bodystart, max(bodystart, bodyend - 1));
      v[VC_GTIMER] = min(v[VC_GTIMER], max(1, floor(hybrid_hop_samps * 0.25)));
    );
    v[VC_SRCHOP]   = max(0.25, abs(base_rate) * hybrid_hop_samps);
    v[VC_CANSPAWN] = (playmode >= 2 && ggrain_amt > 0.0001) ? 1 : 0;
    v[VC_TLEFT]    = gran_voice ? 0 : trans_hold_out;
    v[VC_TPROT]    = transprot;
    v[VC_DONOR]    = donor;
    v[VC_DONORPOS] = donor_tail;
    v[VC_BODYSTART]= bodystart;
    v[VC_TAILSTART]= tailstart;
    v[VC_BODYEND]  = bodyend;
    v[VC_GMIX]     = ggrain_amt;
    v[VC_TAILMIX]  = tail_borrow;
    v[VC_MODE]     = playmode;
    v[VC_STRETCH]  = voice_stretch;
    v[VC_THOLD]    = max(1, trans_hold_out);
    v[VC_RHLEFT]   = 0;
    v[VC_RHLEN]    = max(1, release_handoff_samps);
    v[VC_RAWRATE]  = raw_rate;
    v[VC_ATKRATE]  = attack_rate;
    v[VC_HEADSAFE] = sm[SM_HEADEND];
    v[VC_GENV]     = 0.36;
    v[VC_GENVDELTA]= 0;
    v[VC_AUDIOTRIG] = 0;
    v[VC_AUDIOENV]  = 1;
    v[VC_AUTOVEL]   = velnorm;
    v[VC_PRATIO]    = max(0.000001, midi_ratio(pitch_semi));
    v[VC_PDRYPOS]   = startpos;
    v[VC_PDRYRATE]  = base_rate / max(0.000001, v[VC_PRATIO]);

    gesture_len = floor(srate * lerp(0.22, 1.20, hub_random(1)) * lerp(0.82, 1.22, stretch_norm) * (gran_voice ? lerp(1.0, 2.75, granular_event_stretch) : 1));
    gesture_len = max(64, gesture_len);
    gesture_depth = lively * (0.38 + 0.62 * ggrain_amt) * (gran_voice ? 1.0 : 0.32);
    v[VC_GPHASE]  = hub_random(1);
    v[VC_GLEN]    = gesture_len;
    v[VC_GDEPTH]  = gesture_depth;
    v[VC_GACCENT] = hub_random(1);
    v[VC_LGSID]   = -1;
    v[VC_LGPOS]   = 0;
    v[VC_LGLO]    = 0;
    v[VC_LGHI]    = 1;
    v[VC_LGREG]   = -1;
    v[VC_LGRUN]   = 0;
    v[VC_LGCIDX]  = -1;

    !hub_starting ? (
      apply_release_attack_bridge(voice_idx);
      fade_same_note_releases_for_retrigger(note, chan, voice_idx);
    );

    sm[SM_LASTUSED] = note_counter;
    push_recent(sid);

    walk_prev_sid = walk_last_sid;
    walk_last_sid = sid;
    walk_steps += 1;
  );
);

function release_voice_internal(v) local(donor donor_sm donor_tail body_start body_end release_src sid sm auto_len rel_len rel_coef stage_now attack_interrupt base_rel_len)
(
  (v[VC_ACTIVE] > 0 && v[VC_STAGE] != ENV_RELEASE) ? (
    stage_now = v[VC_STAGE] | 0;
    attack_interrupt = stage_now == ENV_ATTACK ? 1 : 0;

    sid = clamp(v[VC_SAMPLE] | 0, 0, max(0, sample_count - 1));
    sm = sample_meta_base + sid * SM_STRIDE;
    auto_len = max(1, floor(sm[SM_AUTOREL] * auto_release_amt * srate * 0.001));
    // Minimal Attack interrupt: if Note Off arrives while the envelope is still
    // rising, go straight to the user Release time. All normal release grain /
    // tail behavior remains unchanged.
    base_rel_len = auto_smooth_ar ? max(1, floor(auto_smooth_next_release_samps)) : release_samps;
    rel_len = attack_interrupt ? base_rel_len : (auto_smooth_ar ? base_rel_len : max(release_samps, auto_len));
    rel_coef = exp(-6.90775527898214 / max(1, rel_len));

    rel_len <= 1 ? (
      v[VC_ENV] = 0;
      v[VC_STAGE] = ENV_OFF;
      v[VC_ACTIVE] = 0;
    ) : (
      v[VC_STAGE] = ENV_RELEASE;
      v[VC_RSTEP] = rel_coef;
      v[VC_HLEFT] = 0;
      v[VC_TLEFT] = 0;
      v[VC_EPHASE] = 0;
      v[VC_ESTART] = v[VC_ENV];
      v[VC_RLEN] = rel_len;
      v[VC_RCURVE] = release_slope_pct;
      (v[VC_GMODE] > 0) ? (
        // Release must continue from the current body/playback position, not
        // restart the body window. This prevents short one-shots from replaying
        // their body grain after the direct head has already finished.
        (v[VC_GMIX] > 0.0001) ? (
          body_start = max(0, floor(v[VC_BODYSTART]));
          body_end = max(body_start + 1, floor(v[VC_BODYEND]));
          release_src = clamp(max(v[VC_NEXTSRC], min(v[VC_POS], body_end - 1)), body_start, max(body_start, body_end - 1));
          v[VC_NEXTSRC] = release_src;
        );
        v[VC_CANSPAWN] = (v[VC_GMIX] > 0.0001 || v[VC_TAILMIX] > 0.0001) ? 1 : 0;
        v[VC_RHLEN] = max(1, release_handoff_samps);
        v[VC_RHLEFT] = v[VC_RHLEN];
        donor = v[VC_DONOR] | 0;
        donor_sm = sample_meta_base + donor * SM_STRIDE;
        donor_tail = clamp(donor_sm[SM_TAILSTART], 0, max(0, donor_sm[SM_FRAMES] - 2));
        v[VC_DONORPOS] < donor_tail ? v[VC_DONORPOS] = donor_tail;
        v[VC_GTIMER] = min(v[VC_GTIMER], 1);
      ) : (
        v[VC_CANSPAWN] = 0;
        v[VC_RHLEFT] = 0;
      );
    );
  );
);

function release_oldest_held_note_voice(note chan) local(i v best_idx best_age)
(
  best_idx = -1;
  best_age = 100000000000;

  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_AUDIOTRIG] <= 0 && v[VC_NOTE] == note && v[VC_CHAN] == chan && v[VC_STAGE] != ENV_RELEASE) ? (
      v[VC_AGE] < best_age ? (
        best_age = v[VC_AGE];
        best_idx = i;
      );
    );
    i += 1;
  );

  best_idx >= 0 ? (
    v = voice_base + best_idx * VC_STRIDE;
    release_voice_internal(v);
    1;
  ) : 0;
);

function release_voice(note chan) local(i v token)
(
  token = note_off_seq_base[note_gate_idx(note, chan)];
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_AUDIOTRIG] <= 0 && v[VC_NOTE] == note && v[VC_CHAN] == chan && v[VC_KEYTOKEN] == token && v[VC_HUB_ID] <= 0) ? release_voice_internal(v);
    i += 1;
  );
);

function auto_smooth_calc_lengths(budget_samps) local(total_norm a_norm r_norm a_share a_len r_len)
(
  budget_samps = max(2, floor(budget_samps));
  // In Auto Smooth mode the visible Attack/Release sliders become a ratio,
  // so use their normalized slider positions rather than raw milliseconds.
  a_norm = max(0.0001, curve_norm(slider2, 0.1, 500, CURVE_TIME));
  r_norm = max(0.0001, curve_norm(slider5, 5, 5000, CURVE_TIME));
  total_norm = max(0.0001, a_norm + r_norm);
  a_share = clamp(a_norm / total_norm, 0.02, 0.98);
  a_len = max(1, floor(budget_samps * a_share));
  r_len = max(1, budget_samps - a_len);
  (a_len + r_len) > budget_samps ? r_len = max(1, budget_samps - a_len);
  auto_smooth_attack_share = a_len / max(1, budget_samps);
  auto_smooth_release_share = r_len / max(1, budget_samps);
  auto_smooth_next_attack_samps = a_len;
  auto_smooth_next_release_samps = r_len;
);

function auto_smooth_prepare_note_on(now_samps) local(ioi budget)
(
  auto_smooth_ar ? (
    (auto_smooth_last_on_samps > -999999999) ? (
      ioi = clamp(now_samps - auto_smooth_last_on_samps, 1, max(1, floor(8 * srate)));
      auto_smooth_ioi_samps <= 0 ? auto_smooth_ioi_samps = ioi : auto_smooth_ioi_samps = auto_smooth_ioi_samps * 0.72 + ioi * 0.28;
    );
    auto_smooth_last_on_samps = now_samps;

    budget = auto_smooth_budget_samps;
    auto_smooth_ioi_samps > 0 ? (
      budget = min(budget, max(2, floor(auto_smooth_ioi_samps * 0.50)));
    );
    auto_smooth_calc_lengths(budget);
  ) : (
    auto_smooth_next_attack_samps = attack_samps;
    auto_smooth_next_release_samps = release_samps;
  );
);

function auto_smooth_release_same_note_for_new(note chan) local(i v)
(
  auto_smooth_ar ? (
    i = 0;
    while (i < MAX_VOICES) (
      v = voice_base + i * VC_STRIDE;
      (v[VC_ACTIVE] > 0 && v[VC_HUB_ID] <= 0 && v[VC_AUDIOTRIG] <= 0 && v[VC_NOTE] == note && v[VC_CHAN] == chan && v[VC_STAGE] != ENV_RELEASE) ? (
        release_voice_internal(v);
      );
      i += 1;
    );
  );
);

function release_all_voices_transport(hard) local(i v)
(
  hub_reset(15);
  hard ? v71_reset_engines();
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    v[VC_ACTIVE] > 0 ? (
      hard ? (v[VC_ENV] = 0; v[VC_STAGE] = ENV_OFF; v[VC_ACTIVE] = 0;) : release_voice_internal(v);
    );
    i += 1;
  );
  reset_note_gates();
  hard ? (
    denorm_flush_silent_tail_state();
    reset_edge_melt_buffers();
    decrust_clear_state();
    transient_guard_s = 0;
    dyn_env = 0; dyn_comp_gain = 1; dyn_lim_gain = 1;
    mix_fast = 0; mix_slow = 0;
    seam_bridge_env = 0; seam_bridge_idx = -1; seam_bridge_phase = -1;
    midi_queue_count = 0; midi_queue_read = 0;
  );
);

function release_channel_voices(chan hard) local(i v idx)
(
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_CHAN] == chan && v[VC_AUDIOTRIG] <= 0) ? (
      hard ? (v[VC_ACTIVE] = 0; v[VC_ENV] = 0; v[VC_STAGE] = ENV_OFF;) : release_voice_internal(v);
    );
    i += 1;
  );
  i = 0;
  while (i < 128) (
    idx = chan * 128 + i;
    note_gate_base[idx] = 0;
    note_on_seq_base[idx] = 0;
    note_off_seq_base[idx] = 0;
    i += 1;
  );
  // Shared effects cannot separate channels. Flush only when no voices remain.
  hard && !voices_busy() ? (
    v71_reset_engines();
    denorm_flush_silent_tail_state();
    decrust_clear_state();
  );
);

function count_audio_trigger_voices() local(i v cnt)
(
  cnt = 0;
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_AUDIOTRIG] > 0) ? cnt += 1;
    i += 1;
  );
  cnt;
);

function update_audio_trigger_voice_envs(env_amt) local(i v e)
(
  e = clamp01(env_amt);
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_AUDIOTRIG] > 0) ? (
      v[VC_AUDIOENV] = e;
      v[VC_AUTOVEL] = max(v[VC_AUTOVEL], e);
    );
    i += 1;
  );
);

function release_audio_trigger_voices(hard) local(i v)
(
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_AUDIOTRIG] > 0) ? (
      hard ? (
        v[VC_ENV] = 0;
        v[VC_STAGE] = ENV_OFF;
        v[VC_ACTIVE] = 0;
        v[VC_AUDIOTRIG] = 0;
      ) : (
        release_voice_internal(v);
      );
    );
    i += 1;
  );
);

function flush_hidden_state_sliders()
(
  // Hidden alt-mode controls are real host sliders under the hood. JSFX @init can
  // run again during sample-rate/render-engine changes; sliders survive that,
  // plain internal variables do not. Keep these mirrors current whenever the
  // custom UI edits a hidden control.
  slider47 = clamp(formant_shift_semi, -12, 12);
  slider48 = clamp01(auto_release_amt);
  slider49 = clamp(focus_peak_amt, -1, 1);
  slider50 = clamp01(dynamics_expand_amt);
  slider51 = clamp01(edge_melt_amt);
  slider52 = clamp01(clean_decrust_amt);
  slider53 = clamp01(space_room_amt);
  slider54 = clamp01(space_room_char);
  slider55 = clamp01(output_harmonics_amt);
  slider60 = abs(color_pivot_hz) < 1 ? 1000 : clamp(color_pivot_hz, -20000, 20000);
  slider61 = clamp01(pitch_parallel_mix);

  // Use individual sliderchange calls instead of a giant summed mask. Powers
  // above 2^53 are exact, but sums can lose precision in double-based EEL2.
  sliderchange(MASK_S47);
  sliderchange(MASK_S48);
  sliderchange(MASK_S49);
  sliderchange(MASK_S50);
  sliderchange(MASK_S51);
  sliderchange(MASK_S52);
  sliderchange(MASK_S53);
  sliderchange(MASK_S54);
  sliderchange(MASK_S55);
  sliderchange(MASK_S60);
  sliderchange(MASK_S61);
  hidden_state_dirty = 0;
);

// Sample v71 UI helpers. Keep these in @init, before @gfx can call them.
// Slider59: profile 0..20 + 32 * Thrill steps 0..150 (one step = 0.1%).
// Read the current slider for each edit so the other packed field survives.
function ui_v71_decode() local(p steps)
(
  p = floor(clamp(slider59, 0, 4820) + 0.5);
  steps = min(150, floor(p / 32));
  v71_profile = min(20, p - steps * 32);
  v71_thrill = steps / 150;
);

function ui_v71_touch(mask)
(
  // Individual masks preserve high slider bits and mark the host parameter
  // as touched. Never combine the packed slider mask with lower bits.
  sliderchange(mask);
  slider_automate(mask, 0);
  mask == MASK_S59 ? ui_v71_touch59 = 1;
  mask == MASK_S50 ? ui_v71_touch50 = 1;
  mask == MASK_S27 ? ui_v71_touch27 = 1;
  mask == MASK_S9 ? ui_v71_touch9 = 1;
  ui_value_changed = 1;
);

function ui_v71_set_profile(profile) local(p steps packed)
(
  p = floor(clamp(slider59, 0, 4820) + 0.5);
  steps = min(150, floor(p / 32));
  packed = floor(clamp(profile, 0, 20) + 0.5) + 32 * steps;
  packed != slider59 ? (
    slider59 = packed;
    ui_v71_touch(MASK_S59);
  );
  ui_v71_decode();
);

function ui_v71_set_thrill(amount) local(p steps profile packed)
(
  p = floor(clamp(slider59, 0, 4820) + 0.5);
  steps = min(150, floor(p / 32));
  profile = min(20, p - steps * 32);
  packed = profile + 32 * floor(clamp01(amount) * 150 + 0.5);
  packed != slider59 ? (
    slider59 = packed;
    ui_v71_touch(MASK_S59);
  );
  ui_v71_decode();
);

function ui_v71_set_contour(amount)
(
  dynamics_expand_amt = clamp01(amount);
  dynamics_expand_amt != slider50 ? (
    slider50 = dynamics_expand_amt;
    ui_v71_touch(MASK_S50);
  );
);

function ui_v71_profile_name(profile) local(group style)
(
  profile = floor(clamp(profile, 0, 20));
  profile == 0 ? (
    strcpy(#ui_v71_profile_label, "Legacy");
  ) : (
    group = floor((profile - 1) / 4);
    style = profile - 1 - group * 4;
    group == 0 ? strcpy(#ui_v71_source_label, "Neutral")
    : group == 1 ? strcpy(#ui_v71_source_label, "Vocals")
    : group == 2 ? strcpy(#ui_v71_source_label, "SFX")
    : group == 3 ? strcpy(#ui_v71_source_label, "Foley")
    : strcpy(#ui_v71_source_label, "BG");
    style == 0 ? strcpy(#ui_v71_style_label, "Transparent")
    : style == 1 ? strcpy(#ui_v71_style_label, "Anti-Lock")
    : style == 2 ? strcpy(#ui_v71_style_label, "Scattered")
    : strcpy(#ui_v71_style_label, "Obliterate");
    sprintf(#ui_v71_profile_label, "%s / %s", #ui_v71_source_label, #ui_v71_style_label);
  );
);

function ui_v71_profile_menu() local(i choice)
(
  strcpy(#ui_v71_menu, "");
  i = 0;
  loop(21,
    i > 0 ? strcat(#ui_v71_menu, "|");
    i == v71_profile ? strcat(#ui_v71_menu, "!");
    ui_v71_profile_name(i);
    strcat(#ui_v71_menu, #ui_v71_profile_label);
    i += 1;
  );
  gfx_x = mouse_x;
  gfx_y = mouse_y;
  choice = gfx_showmenu(#ui_v71_menu);
  choice > 0 ? ui_v71_set_profile(choice - 1);
  0;
);

function ui_v71_finish_touches()
(
  !mouse_down ? (
    ui_v71_touch59 ? (slider_automate(MASK_S59, 1); ui_v71_touch59 = 0;);
    ui_v71_touch50 ? (slider_automate(MASK_S50, 1); ui_v71_touch50 = 0;);
    ui_v71_touch27 ? (slider_automate(MASK_S27, 1); ui_v71_touch27 = 0;);
    ui_v71_touch9 ? (slider_automate(MASK_S9, 1); ui_v71_touch9 = 0;);
    ui_v71_profile_hold = 0;
  );
);

function ui_panel(x y w h) local(i t)
(
  gfx_r = 0.000; gfx_g = 0.000; gfx_b = 0.000; gfx_a = 0.34;
  gfx_rect(x + 3, y + 5, w, h, 1);

  i = 0;
  while (i < h) (
    t = i / max(1, h - 1);
    gfx_r = 0.045 + 0.020 * (1 - t);
    gfx_g = 0.058 + 0.024 * (1 - t);
    gfx_b = 0.078 + 0.030 * (1 - t);
    gfx_a = 1;
    gfx_line(x, y + i, x + w, y + i);
    i += 1;
  );

  gfx_r = 0.18; gfx_g = 0.25; gfx_b = 0.32; gfx_a = 0.96;
  gfx_rect(x, y, w, h, 0);
  gfx_r = 0.40; gfx_g = 0.66; gfx_b = 0.94; gfx_a = 0.15;
  gfx_line(x + 1, y + 1, x + w - 2, y + 1);
  gfx_r = 0.02; gfx_g = 0.025; gfx_b = 0.032; gfx_a = 0.80;
  gfx_line(x + 1, y + h - 1, x + w - 2, y + h - 1);

  // small screw-like corner marks, purely decorative
  gfx_r = 0.14; gfx_g = 0.19; gfx_b = 0.24; gfx_a = 0.85;
  gfx_circle(x + 7, y + 7, 2, 1);
  gfx_circle(x + w - 7, y + 7, 2, 1);
  gfx_circle(x + 7, y + h - 7, 2, 1);
  gfx_circle(x + w - 7, y + h - 7, 2, 1);
);

function ui_inner_panel(x y w h) local(i t)
(
  i = 0;
  while (i < h) (
    t = i / max(1, h - 1);
    gfx_r = 0.030 + 0.018 * (1 - t);
    gfx_g = 0.038 + 0.020 * (1 - t);
    gfx_b = 0.052 + 0.030 * (1 - t);
    gfx_a = 1;
    gfx_line(x, y + i, x + w, y + i);
    i += 1;
  );
  gfx_r = 0.11; gfx_g = 0.17; gfx_b = 0.22; gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
  gfx_r = 0.29; gfx_g = 0.56; gfx_b = 0.82; gfx_a = 0.13;
  gfx_line(x + 1, y + 1, x + w - 2, y + 1);
);

function ui_led(x y on cr cg cb) local(rr)
(
  rr = on ? 7 : 6;
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.52;
  gfx_circle(x + 1, y + 1, rr + 2, 1);
  gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = on ? 0.24 : 0.10;
  gfx_circle(x, y, rr + 5, 1);
  gfx_r = on ? cr : 0.13;
  gfx_g = on ? cg : 0.16;
  gfx_b = on ? cb : 0.20;
  gfx_a = 1;
  gfx_circle(x, y, rr, 1);
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = on ? 0.42 : 0.10;
  gfx_circle(x - rr * 0.25, y - rr * 0.30, rr * 0.34, 1);
);

function ui_hmeter(x y w h val cr cg cb) local(v i t)
(
  v = clamp01(val);
  gfx_r = 0.030; gfx_g = 0.038; gfx_b = 0.052; gfx_a = 1;
  gfx_rect(x, y, w, h, 1);
  gfx_r = 0.11; gfx_g = 0.15; gfx_b = 0.18; gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.28;
  gfx_rect(x + 1, y + 1, w - 2, h - 2, 1);
  i = 0;
  while (i < max(0, floor((w - 2) * v))) (
    t = i / max(1, w - 2);
    gfx_r = cr * (0.70 + 0.30 * t) + 0.10 * t;
    gfx_g = cg * (0.72 + 0.25 * t) + 0.12 * t;
    gfx_b = cb * (0.72 + 0.24 * t) + 0.16 * t;
    gfx_a = 0.96;
    gfx_line(x + 1 + i, y + 1, x + 1 + i, y + h - 2);
    i += 1;
  );
  gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.34;
  gfx_rect(x + 1, y + 1, (w - 2) * v, h - 2, 0);
);

function ui_value_pill(x y w h) local(i t)
(
  i = 0;
  while (i < h) (
    t = i / max(1, h - 1);
    gfx_r = 0.030 + 0.020 * (1 - t);
    gfx_g = 0.040 + 0.025 * (1 - t);
    gfx_b = 0.055 + 0.035 * (1 - t);
    gfx_a = 1;
    gfx_line(x, y + i, x + w, y + i);
    i += 1;
  );
  gfx_r = 0.13; gfx_g = 0.21; gfx_b = 0.28; gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
);

function ui_draw_header_logo(cx cy s) local(i xx h)
(
  gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.04; gfx_a = 0.92;
  gfx_circle(cx, cy, s * 1.05, 1);
  gfx_r = 0.12; gfx_g = 0.18; gfx_b = 0.23; gfx_a = 1;
  gfx_circle(cx, cy, s * 1.05, 0);
  gfx_r = 0.24; gfx_g = 0.62; gfx_b = 0.96; gfx_a = 0.25;
  gfx_circle(cx, cy, s * 1.25, 0);

  i = -3;
  while (i <= 3) (
    xx = cx + i * s * 0.22;
    h = s * (0.22 + 0.18 * (3 - abs(i)));
    i == 0 ? h = s * 0.72;
    gfx_r = 0.46; gfx_g = 0.82; gfx_b = 1.0; gfx_a = 0.90;
    gfx_line(xx, cy - h, xx, cy + h);
    i += 1;
  );
);

function ui_button(id x y w h) local(hot clicked i t)
(
  clicked = 0;
  hot = pt_in(x, y, w, h);

  (hot || ui_active == id) ? ui_hover_id = id;

  mouse_pressed && hot && ui_active < 0 ? ui_active = id;
  ui_active == id ? (
    !mouse_down ? (
      hot ? clicked = 1;
      ui_active = -1;
    );
  );

  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.35;
  gfx_rect(x + 1, y + 2, w, h, 1);
  i = 0;
  while (i < h) (
    t = i / max(1, h - 1);
    gfx_r = (hot || ui_active == id) ? (0.115 - t * 0.030) : (0.085 - t * 0.022);
    gfx_g = (hot || ui_active == id) ? (0.160 - t * 0.035) : (0.115 - t * 0.025);
    gfx_b = (hot || ui_active == id) ? (0.220 - t * 0.045) : (0.155 - t * 0.030);
    gfx_a = 1;
    gfx_line(x, y + i, x + w, y + i);
    i += 1;
  );
  gfx_r = (hot || ui_active == id) ? 0.35 : 0.17;
  gfx_g = (hot || ui_active == id) ? 0.62 : 0.25;
  gfx_b = (hot || ui_active == id) ? 0.90 : 0.34;
  gfx_a = (hot || ui_active == id) ? 1 : 0.95;
  gfx_rect(x, y, w, h, 0);
  gfx_r = 0.55; gfx_g = 0.80; gfx_b = 1.00; gfx_a = (hot || ui_active == id) ? 0.40 : 0.12;
  gfx_line(x + 2, y + 1, x + w - 3, y + 1);
  gfx_r = 0.02; gfx_g = 0.03; gfx_b = 0.04; gfx_a = 0.70;
  gfx_line(x + 2, y + h - 1, x + w - 3, y + h - 1);

  clicked;
);

function ui_knob(id x y r val vmin vmax defval wheel_step) local(hot norm ang px py vv dbl step_amt i a rr x1 y1 x2 y2 tickn active_n)
(
  hot = ((mouse_x - x) * (mouse_x - x) + (mouse_y - y) * (mouse_y - y)) <= r * r;
  (hot || ui_active == id) ? ui_hover_id = id;

  mouse_rpressed && hot ? (
    abs(val - defval) > 0.0000001 ? (
      val = defval;
      ui_value_changed = 1;
    );
    ui_active == id ? ui_active = -1;
  );

  mouse_pressed && hot && ui_active < 0 ? (
    dbl = (ui_last_click_id == id) && ((ui_now - ui_last_click_t) < ui_dblclick_time);
    ui_last_click_id = id;
    ui_last_click_t = ui_now;

    dbl ? (
      abs(val - defval) > 0.0000001 ? (
        val = defval;
        ui_value_changed = 1;
      );
      ui_active = -1;
    ) : (
      ui_active = id;
      ui_down_y = mouse_y;
      ui_down_val = curve_norm(val, vmin, vmax, CURVE_LINEAR);
    );
  );

  hot && !ui_wheel_used && abs(ui_wheel) >= 1 && !ui_shift ? (
    step_amt = wheel_step * max(1, floor(abs(ui_wheel) / 120 + 0.5));
    norm = curve_norm(val, vmin, vmax, CURVE_LINEAR);
    norm = clamp01(norm + (ui_wheel > 0 ? step_amt : -step_amt));
    vv = curve_denorm(norm, vmin, vmax, CURVE_LINEAR);
    abs(vv - val) > 0.0000001 ? (
      val = vv;
      ui_value_changed = 1;
    );
    ui_wheel_used = 1;
  );

  ui_active == id ? (
    mouse_down ? (
      norm = clamp01(ui_down_val - (mouse_y - ui_down_y) / 150);
      vv = curve_denorm(norm, vmin, vmax, CURVE_LINEAR);
      abs(vv - val) > 0.0000001 ? (
        val = vv;
        ui_value_changed = 1;
      );
    ) : (
      ui_active = -1;
    );
  );

  norm = curve_norm(val, vmin, vmax, CURVE_LINEAR);

  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.48;
  gfx_circle(x + 2, y + 3, r + 5, 1);
  gfx_r = 0.020; gfx_g = 0.026; gfx_b = 0.034; gfx_a = 1;
  gfx_circle(x, y, r + 4, 1);
  gfx_r = 0.11; gfx_g = 0.15; gfx_b = 0.19; gfx_a = 1;
  gfx_circle(x, y, r + 3, 0);

  tickn = 32;
  i = 0;
  while (i <= tickn) (
    a = (-0.76 + (i / tickn) * 1.52) * 3.14159265358979;
    rr = (i % 4 == 0) ? r + 3 : r + 2;
    x1 = x + cos(a) * rr;
    y1 = y + sin(a) * rr;
    x2 = x + cos(a) * (rr + ((i % 4 == 0) ? 4 : 2));
    y2 = y + sin(a) * (rr + ((i % 4 == 0) ? 4 : 2));
    gfx_r = 0.21; gfx_g = 0.28; gfx_b = 0.35; gfx_a = 0.70;
    gfx_line(x1, y1, x2, y2);
    i += 1;
  );

  active_n = floor(norm * tickn);
  i = 0;
  while (i <= active_n) (
    a = (-0.76 + (i / tickn) * 1.52) * 3.14159265358979;
    x1 = x + cos(a) * (r + 2);
    y1 = y + sin(a) * (r + 2);
    x2 = x + cos(a) * (r + 7);
    y2 = y + sin(a) * (r + 7);
    gfx_r = 0.05 + 0.23 * norm; gfx_g = 0.50 + 0.32 * norm; gfx_b = 1.00; gfx_a = 0.96;
    gfx_line(x1, y1, x2, y2);
    i += 1;
  );

  gfx_r = 0.045; gfx_g = 0.055; gfx_b = 0.070; gfx_a = 1;
  gfx_circle(x, y, r, 1);
  gfx_r = 0.18; gfx_g = 0.22; gfx_b = 0.27; gfx_a = 1;
  gfx_circle(x - 1, y - 1, r * 0.76, 1);
  gfx_r = 0.045; gfx_g = 0.050; gfx_b = 0.060; gfx_a = 0.88;
  gfx_circle(x + 1, y + 2, r * 0.62, 1);
  gfx_r = 0.32; gfx_g = 0.44; gfx_b = 0.54; gfx_a = 0.64;
  gfx_circle(x - r * 0.25, y - r * 0.34, r * 0.22, 1);

  ang = (-0.75 + norm * 1.5) * 3.14159265358979;
  px = x + cos(ang) * (r - 5);
  py = y + sin(ang) * (r - 5);
  gfx_r = hot || ui_active == id ? 0.85 : 0.50;
  gfx_g = hot || ui_active == id ? 0.95 : 0.76;
  gfx_b = 1.00;
  gfx_a = 1;
  gfx_line(x, y, px, py);
  gfx_circle(px, py, 2, 1);

  (hot || ui_active == id) ? (
    gfx_r = 0.22; gfx_g = 0.62; gfx_b = 1.0; gfx_a = 0.36;
    gfx_circle(x, y, r + 10, 0);
  );

  val;
);

function ui_vslider(id x y w h val vmin vmax curve_mode defval wheel_step) local(hot norm py vv fillh dbl step_amt i t tickn)
(
  hot = pt_in(x, y, w, h);
  (hot || ui_active == id) ? ui_hover_id = id;

  mouse_rpressed && hot ? (
    (id == 204 && ui_shift) ? (
      auto_release_amt = 1;
      ui_value_changed = 1;
      hidden_state_dirty = 1;
      ui_alt_release_drag = 0;
    ) : (
      abs(val - defval) > 0.0000001 ? (
        val = defval;
        ui_value_changed = 1;
      );
    );
    ui_active == id ? ui_active = -1;
  );

  mouse_pressed && hot && ui_active < 0 ? (
    dbl = (ui_last_click_id == id) && ((ui_now - ui_last_click_t) < ui_dblclick_time);
    ui_last_click_id = id;
    ui_last_click_t = ui_now;

    dbl ? (
      (id == 204 && ui_shift) ? (
        auto_release_amt = 1;
        ui_value_changed = 1;
        hidden_state_dirty = 1;
      ) : (
        abs(val - defval) > 0.0000001 ? (
          val = defval;
          ui_value_changed = 1;
        );
      );
      ui_alt_release_drag = 0;
      ui_active = -1;
    ) : (
      ui_active = id;
      ui_alt_release_drag = (id == 204 && ui_shift) ? 1 : 0;
    );
  );

  hot && !ui_wheel_used && abs(ui_wheel) >= 1 && !ui_shift ? (
    step_amt = wheel_step * max(1, floor(abs(ui_wheel) / 120 + 0.5));
    norm = curve_norm(val, vmin, vmax, curve_mode);
    norm = clamp01(norm + (ui_wheel > 0 ? step_amt : -step_amt));
    vv = curve_denorm(norm, vmin, vmax, curve_mode);
    abs(vv - val) > 0.0000001 ? (
      val = vv;
      ui_value_changed = 1;
    );
    ui_wheel_used = 1;
  );

  ui_active == id ? (
    mouse_down ? (
      norm = clamp01(1 - ((mouse_y - y) / max(h, 1)));
      (id == 204 && ui_alt_release_drag) ? (
        abs(norm - auto_release_amt) > 0.0000001 ? (
          auto_release_amt = norm;
          ui_value_changed = 1;
          hidden_state_dirty = 1;
        );
      ) : (
        vv = curve_denorm(norm, vmin, vmax, curve_mode);
        abs(vv - val) > 0.0000001 ? (
          val = vv;
          ui_value_changed = 1;
        );
      );
    ) : (
      ui_active = -1;
      ui_alt_release_drag = 0;
    );
  );

  norm = curve_norm(val, vmin, vmax, curve_mode);
  fillh = clamp01(norm) * h;

  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.40;
  gfx_rect(x + 2, y + 2, w, h, 1);
  ui_inner_panel(x, y, w, h);

  tickn = 12;
  i = 1;
  while (i < tickn) (
    t = y + h - (i / tickn) * h;
    gfx_r = 0.24; gfx_g = 0.31; gfx_b = 0.38; gfx_a = 0.42;
    gfx_line(x - 8, t, x - 2, t);
    gfx_line(x + w + 2, t, x + w + 8, t);
    i += 1;
  );

  gfx_r = 0.02; gfx_g = 0.10; gfx_b = 0.18; gfx_a = 0.65;
  gfx_rect(x + 3, y + 3, w - 6, h - 6, 1);
  gfx_r = 0.00; gfx_g = 0.43; gfx_b = 0.96; gfx_a = 0.24;
  gfx_rect(x + 4, y + h - fillh + 2, w - 8, max(0, fillh - 4), 1);
  gfx_r = 0.04; gfx_g = 0.62; gfx_b = 1.0; gfx_a = 0.92;
  gfx_rect(x + 6, y + h - fillh + 4, w - 12, max(0, fillh - 8), 1);

  py = y + h - norm * h;
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.45;
  gfx_rect(x - 6, py - 3, w + 12, 8, 1);
  gfx_r = 0.78; gfx_g = 0.88; gfx_b = 0.98; gfx_a = 1;
  gfx_rect(x - 5, py - 4, w + 10, 7, 1);
  gfx_r = 0.30; gfx_g = 0.52; gfx_b = 0.70; gfx_a = 1;
  gfx_rect(x - 5, py - 4, w + 10, 7, 0);
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.52;
  gfx_line(x - 3, py - 3, x + w + 3, py - 3);

  hot || ui_active == id ? (
    gfx_r = 0.25; gfx_g = 0.62; gfx_b = 1.0; gfx_a = 0.55;
    gfx_rect(x - 4, y - 4, w + 8, h + 8, 0);
  );

  val;
);

function ui_shift_wheel_slope(id val defval) local(step_amt)
(
  (ui_hover_id == id && ui_shift && !ui_wheel_used && abs(ui_wheel) >= 1) ? (
    step_amt = 5 * max(1, floor(abs(ui_wheel) / 120 + 0.5));
    val = clamp(val + (ui_wheel > 0 ? step_amt : -step_amt), -100, 100);
    ui_wheel_used = 1;
    ui_value_changed = 1;
  );

  val;
);

function draw_curve_line(x1 y1 x2 y2 mode) local(i steps t u px py nx ny)
(
  steps = 24;
  px = x1;
  py = y1;
  i = 1;
  while (i <= steps) (
    t = i / steps;
    u = env_slope_shape(t, mode);
    nx = x1 + (x2 - x1) * t;
    ny = y1 + (y2 - y1) * u;
    gfx_line(px, py, nx, ny);
    px = nx;
    py = ny;
    i += 1;
  );
);

function draw_center_buf(x y w) local(tw th)
(
  gfx_measurestr(#ui_buf, tw, th);
  gfx_x = x + max(0, (w - tw) * 0.5);
  gfx_y = y;
  gfx_drawstr(#ui_buf);
);


function ui_tab_button(id x y w h active) local(hot clicked i t)
(
  clicked = 0;
  hot = pt_in(x, y, w, h);
  (hot || ui_active == id) ? ui_hover_id = id;

  mouse_pressed && hot && ui_active < 0 ? ui_active = id;
  ui_active == id ? (
    !mouse_down ? (
      hot ? clicked = 1;
      ui_active = -1;
    );
  );

  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.34;
  gfx_rect(x + 1, y + 2, w, h, 1);
  i = 0;
  while (i < h) (
    t = i / max(1, h - 1);
    active ? (
      gfx_r = 0.155 - t * 0.035;
      gfx_g = 0.214 - t * 0.046;
      gfx_b = 0.292 - t * 0.050;
    ) : (
      gfx_r = (hot || ui_active == id) ? (0.095 - t * 0.026) : (0.055 - t * 0.016);
      gfx_g = (hot || ui_active == id) ? (0.128 - t * 0.030) : (0.074 - t * 0.020);
      gfx_b = (hot || ui_active == id) ? (0.172 - t * 0.036) : (0.100 - t * 0.024);
    );
    gfx_a = 1;
    gfx_line(x, y + i, x + w, y + i);
    i += 1;
  );
  gfx_r = active ? 0.82 : ((hot || ui_active == id) ? 0.35 : 0.16);
  gfx_g = active ? 0.66 : ((hot || ui_active == id) ? 0.62 : 0.25);
  gfx_b = active ? 0.22 : ((hot || ui_active == id) ? 0.90 : 0.34);
  gfx_a = 1;
  gfx_rect(x, y, w, h, 0);
  active ? (
    gfx_r = 0.96; gfx_g = 0.72; gfx_b = 0.18; gfx_a = 0.95;
    gfx_rect(x + 2, y + h - 4, w - 4, 2, 1);
  );

  clicked;
);

function proc_freq_x(freq x w) local(n)
(
  n = (log(max(20, min(20000, freq))) - log(20)) / (log(20000) - log(20));
  x + clamp01(n) * w;
);

function proc_x_freq(mx x w) local(n)
(
  n = clamp01((mx - x) / max(w, 1));
  exp(log(20) + n * (log(20000) - log(20)));
);

function proc_db_y(db y h) local(n)
(
  n = (18 - clamp(db, -18, 18)) / 36;
  y + clamp01(n) * h;
);

function proc_y_db(my y h) local(n)
(
  n = clamp01((my - y) / max(h, 1));
  clamp(18 - n * 36, -18, 18);
);

function proc_band_resp(freq cf q gain_db) local(
  A w0 sn cs alpha a0 b0 b1 b2 a1 a2
  w c1 s1 c2 s2 nre nim dre dim mag2
)
(
  // Match the DSP peaking biquad instead of drawing an over-wide Gaussian.
  // The old graph made Q0.75 look like it affected nearly the entire spectrum.
  abs(gain_db) < 0.000001 ? 0 : (
    cf = clamp(cf, 20, min(20000, srate * 0.49));
    q = clamp(q, 0.35, 8);
    A = exp(gain_db * 0.05756462732485114); // 10^(dB/40)
    w0 = 6.283185307179586 * cf / max(srate, 1);
    sn = sin(w0);
    cs = cos(w0);
    alpha = sn / max(0.000001, 2 * q);

    b0 = 1 + alpha * A;
    b1 = -2 * cs;
    b2 = 1 - alpha * A;
    a0 = 1 + alpha / A;
    a1 = -2 * cs;
    a2 = 1 - alpha / A;

    b0 /= a0; b1 /= a0; b2 /= a0; a1 /= a0; a2 /= a0;

    w = 6.283185307179586 * clamp(freq, 20, min(20000, srate * 0.49)) / max(srate, 1);
    c1 = cos(w); s1 = sin(w);
    c2 = cos(2 * w); s2 = sin(2 * w);

    nre = b0 + b1 * c1 + b2 * c2;
    nim = -(b1 * s1 + b2 * s2);
    dre = 1 + a1 * c1 + a2 * c2;
    dim = -(a1 * s1 + a2 * s2);

    mag2 = (nre * nre + nim * nim) / max(0.000000000001, dre * dre + dim * dim);
    10 * log(max(0.000000000001, mag2)) * LOG10_INV;
  );
);

function proc_cut_slope_db(idx)
(
  idx <= 0 ? 6 : idx * 12;
);

function proc_eq_resp_db(freq) local(resp hpfhz lpfhz slope r octv)
(
  // UI response reads sliders directly so graph movement is immediate.
  resp = 0;
  resp += proc_band_resp(freq, clamp(slider35, 20, 20000), clamp(slider40, 0.35, 8), clamp(slider32, -18, 18));
  resp += proc_band_resp(freq, clamp(slider36, 20, 20000), clamp(slider41, 0.35, 8), clamp(slider33, -18, 18));
  resp += proc_band_resp(freq, clamp(slider37, 20, 20000), clamp(slider42, 0.35, 8), clamp(slider34, -18, 18));

  hpfhz = clamp(slider38, 20, 1000);
  hpfhz > 22 ? (
    resp += posteq_cut_res_resp_db(freq, hpfhz, slider45);
    freq < hpfhz ? (
      slope = proc_cut_slope_db(clamp(slider43 | 0, 0, 4));
      octv = log(hpfhz / max(freq, 1)) / log(2);
      resp -= slope * octv;
    );
  );

  lpfhz = clamp(slider39, 1000, 20000);
  lpfhz < min(19000, srate * 0.47) ? (
    resp += posteq_cut_res_resp_db(freq, lpfhz, slider46);
    freq > lpfhz ? (
      slope = proc_cut_slope_db(clamp(slider44 | 0, 0, 4));
      octv = log(max(freq, 1) / lpfhz) / log(2);
      resp -= slope * octv;
    );
  );

  clamp(resp, -42, 18);
);

function proc_draw_node(cx cy r hot active label_id) local(tw th)
(
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.42;
  gfx_circle(cx + 1, cy + 2, r + 3, 1);
  gfx_r = active ? 0.96 : (hot ? 0.34 : 0.08);
  gfx_g = active ? 0.72 : (hot ? 0.62 : 0.22);
  gfx_b = active ? 0.18 : (hot ? 0.96 : 0.36);
  gfx_a = 1;
  gfx_circle(cx, cy, r + 1, 1);
  gfx_r = 0.030; gfx_g = 0.040; gfx_b = 0.055; gfx_a = 1;
  gfx_circle(cx, cy, r - 1, 1);
  gfx_r = active ? 1.0 : 0.74;
  gfx_g = active ? 0.86 : 0.88;
  gfx_b = active ? 0.34 : 1.0;
  gfx_a = 1;
  gfx_setfont(1, "Arial", 9, 0);
  label_id == 0 ? sprintf(#ui_buf, "HP")
  : label_id == 1 ? sprintf(#ui_buf, "1")
  : label_id == 2 ? sprintf(#ui_buf, "2")
  : label_id == 3 ? sprintf(#ui_buf, "3")
  : label_id == 4 ? sprintf(#ui_buf, "LP")
  : sprintf(#ui_buf, "?");
  gfx_measurestr(#ui_buf, tw, th);
  gfx_x = cx - tw * 0.5;
  gfx_y = cy - th * 0.5;
  gfx_drawstr(#ui_buf);
);

function draw_tooltip_box() local(tw1 th1 tw2 th2 tw th pad bx by bw bh)
(
  strlen(#tip_title) > 0 ? (
    pad = 10;

    gfx_setfont(1, "Arial", 13, 0);
    gfx_measurestr(#tip_title, tw1, th1);
    gfx_setfont(1, "Arial", 12, 0);
    gfx_measurestr(#tip_body, tw2, th2);

    tw = max(tw1, tw2);
    th = th1 + th2 + 7;
    bw = tw + pad * 2;
    bh = th + pad * 2;

    bx = clamp(mouse_x + 18, 8, gfx_w - bw - 8);
    by = clamp(mouse_y + 18, 8, gfx_h - bh - 8);

    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.55;
    gfx_rect(bx + 3, by + 5, bw, bh, 1);
    ui_inner_panel(bx, by, bw, bh);
    gfx_r = 0.36; gfx_g = 0.68; gfx_b = 1.0; gfx_a = 0.55;
    gfx_rect(bx, by, bw, bh, 0);

    gfx_setfont(1, "Arial", 13, 0);
    gfx_r = 0.92; gfx_g = 0.96; gfx_b = 1.0; gfx_a = 1;
    gfx_x = bx + pad; gfx_y = by + pad - 1;
    gfx_drawstr(#tip_title);

    gfx_setfont(1, "Arial", 12, 0);
    gfx_r = 0.70; gfx_g = 0.80; gfx_b = 0.92; gfx_a = 1;
    gfx_x = bx + pad; gfx_y = by + pad + th1 + 4;
    gfx_drawstr(#tip_body);
  );
);

function hub_plan_voice(v p duration continuing) local(sm attacklen relen need loopok deadline scale bodybudget wasloop oldgmode oldgmix oldtail oldmode oldcan horizon wetneed dryneed protect wastransition intended wantloop)
(
  wasloop = v[VC_HUB_LOOP]; oldgmode = v[VC_GMODE]; oldgmix = v[VC_GMIX];
  oldtail = v[VC_TAILMIX]; oldmode = v[VC_MODE]; oldcan = v[VC_CANSPAWN];
  wastransition = v[VC_HUB_TLEN] > 0;
  intended = wastransition && v[VC_HUB_TTO] > 0 ? v[VC_HUB_DESTLOOP] : wasloop;
  sm = sample_meta_base + v[VC_SAMPLE] * SM_STRIDE;
  deadline = event_clock_samps + duration;
  v[VC_HUB_START] = event_clock_samps; v[VC_HUB_END] = deadline;
  v[VC_HUB_BOUNDARY] = p[8]; v[VC_HUB_FILL] = p[9];
  v[VC_HUB_AUTH] = p[10]; v[VC_HUB_AMOUNT] = p[11] / 127;
  v[VC_HUB_SHAPE] = p[12]; v[VC_HUB_FINISH] = 0; v[VC_HUB_TERMINAL] = 1;
  attacklen = p[17] == 127 ? attack_samps : duration * p[17] / 100;
  relen = p[18] == 127 ? release_samps : duration * p[18] / 100;
  // Free retains the analyzed source-tail allowance when using the instrument
  // release. Tail instead commits to its requested post-end release window.
  // Explicit event release fractions remain authoritative in either policy.
  p[8] == 0 && p[18] == 127 && duration > attacklen ? (
    relen = max(relen, floor(sm[SM_AUTOREL] * auto_release_amt * srate * 0.001));
  );
  attacklen = max(1, min(attacklen, duration)); relen = max(1, relen);
  p[8] == 1 && attacklen + relen > duration ? (
    scale = duration / max(1, attacklen + relen); attacklen *= scale; relen *= scale;
  );
  v[VC_HUB_ATTACK] = max(1, floor(attacklen));
  v[VC_HUB_RELEASE] = max(1, floor(relen));
  p[8] == 1 ? v[VC_HUB_RELEASE] = max(1, min(v[VC_HUB_RELEASE], duration - v[VC_HUB_ATTACK]));
  bodybudget = max(0, duration - v[VC_HUB_ATTACK] - (p[8] == 1 ? v[VC_HUB_RELEASE] : 0));
  v[VC_HUB_RAMPFROM] = continuing ? v[VC_HUB_EFFECTIVE] : 0;
  continuing ? (
    v[VC_ENV] = v[VC_HUB_BASEENV];
    v[VC_STAGE] = ENV_SUSTAIN;
    v[VC_HUB_HANDOFF] = max(1, min(floor(0.005 * srate), floor(duration * 0.25)));
  ) : (
    v[VC_HUB_HANDOFF] = 0;
    // A finite attack prevents long AHDSR phases from swallowing short Fit events.
    p[8] == 1 || p[17] != 127 ? (
      v[VC_ALEN] = v[VC_HUB_ATTACK]; v[VC_ACURVE] = 0;
      v[VC_ASTEP] = 1 - exp(-6.90775527898214 / v[VC_ALEN]);
      v[VC_HLEFT] = min(v[VC_HLEFT], floor(bodybudget * 0.25));
      v[VC_DLEN] = max(1, min(v[VC_DLEN], bodybudget - v[VC_HLEFT]));
      v[VC_DCURVE] = 0; v[VC_DSTEP] = 1 - exp(-6.90775527898214 / v[VC_DLEN]);
    );
  );
  horizon = duration + (p[8] == 1 ? 0 : v[VC_HUB_RELEASE]);
  protect = min(horizon, max(0, v[VC_TLEFT]));
  wetneed = horizon * abs(v[VC_RATE]) + protect * max(0, abs(v[VC_ATKRATE]) - abs(v[VC_RATE]));
  dryneed = horizon * abs(v[VC_PDRYRATE]) + protect * max(0, abs(v[VC_RAWRATE] / max(0.000001, v[VC_PRATIO])) - abs(v[VC_PDRYRATE]));
  need = wetneed > max(0, sm[SM_FRAMES] - v[VC_POS]) || dryneed > max(0, sm[SM_FRAMES] - v[VC_PDRYPOS]);
  loopok = sm[SM_HUB_LOOPHI] > sm[SM_HUB_LOOPLO] + 2 * sm[SM_HUB_LOOPXF];
  (p[9] == 2 || (p[9] == 1 && (need || continuing))) ? (
    loopok ? (
      v[VC_HUB_LOOP] = 1;
      v[VC_HUB_LOOPLO] = sm[SM_HUB_LOOPLO]; v[VC_HUB_LOOPHI] = sm[SM_HUB_LOOPHI];
      v[VC_HUB_LOOPXF] = sm[SM_HUB_LOOPXF];
      // Explicit source filling uses the small same-source renderer. Pitch/tape
      // rates remain those chosen by Sample. No donor texture is introduced.
      v[VC_GMODE] = 0; v[VC_GMIX] = 0; v[VC_TAILMIX] = 0; v[VC_CANSPAWN] = 0;
      !continuing ? (
        v[VC_MODE] == 3 ? (v[VC_MODE] = 0; v[VC_BASE] /= 1.55;);
        memset(v + VC_GBASE, 0, NUM_GRAINS * VG_STRIDE);
      );
    ) : (
      v[VC_HUB_LOOP] = 0;
      hub_log(v[VC_HUB_ACTION], v[VC_HUB_ID], 0, 2, 10, v[VC_SAMPLE], duration / max(1, srate), p[8], p[9], v[VC_CHAN]);
    );
  ) : v[VC_HUB_LOOP] = 0;
  wantloop = v[VC_HUB_LOOP];
  continuing && wastransition ? (
    // Preserve both running cursors and the last rendered mix. A repeated
    // request keeps the fade; a changed request reverses it from that mix.
    v[VC_HUB_LOOP] = wasloop;
    v[VC_GMODE] = oldgmode; v[VC_GMIX] = oldgmix; v[VC_TAILMIX] = oldtail;
    v[VC_MODE] = oldmode; v[VC_CANSPAWN] = oldcan;
    wantloop != intended ? (
      v[VC_HUB_TFROM] = v[VC_HUB_TWEIGHT];
      v[VC_HUB_TTO] = wantloop == v[VC_HUB_DESTLOOP] ? 1 : 0;
      v[VC_HUB_TLEN] = max(2, min(floor(0.008 * srate), floor(duration * 0.25)));
      v[VC_HUB_TLEFT] = v[VC_HUB_TLEN];
    );
  ) : continuing && wantloop != wasloop ? (
    // Keep rendering the old source while a second pair of cursors crossfades
    // into the requested direct renderer. Existing grains finish under the fade.
    v[VC_HUB_DESTLOOP] = wantloop; v[VC_HUB_LOOP] = wasloop;
    v[VC_GMODE] = oldgmode; v[VC_GMIX] = oldgmix; v[VC_TAILMIX] = oldtail;
    v[VC_MODE] = oldmode; v[VC_CANSPAWN] = oldcan;
    v[VC_HUB_NEWPOS] = v[VC_POS]; v[VC_HUB_NEWDRY] = v[VC_PDRYPOS];
    v[VC_HUB_TFROM] = 0; v[VC_HUB_TTO] = 1; v[VC_HUB_TWEIGHT] = 0;
    v[VC_HUB_TLEN] = max(2, min(floor(0.008 * srate), floor(duration * 0.25)));
    v[VC_HUB_TLEFT] = v[VC_HUB_TLEN];
  );
);

function hub_execute(p chan) local(action id target vi mi freev freem v m duration valid reason j oldindex oldid)
(
  action = p[1]; id = p[2] * 128 + p[3]; target = p[4] * 128 + p[5];
  duration = floor((p[14] * 16384 + p[15] * 128 + p[16]) * srate * (p[13] == 1 ? 0.000015625 : 0.001) + 0.5);
  valid = p[0] == 1 && action >= 0 && action <= 7 && id > 0 && p[8] <= 2 && p[9] <= 2 && p[10] <= 2 && p[13] <= 1;
  valid = valid && (p[17] <= 100 || p[17] == 127) && (p[18] <= 100 || p[18] == 127);
  action != 7 ? valid = valid && p[7] > 0 && duration > 0;
  valid ? (
    reason = 0; vi = hub_find_voice(id); mi = hub_find_mod(id);
    action == 7 ? (
      vi >= 0 ? (
        v = voice_base + vi * VC_STRIDE;
        v[VC_CHAN] == chan ? (
          v[VC_HUB_BOUNDARY] == 1 && event_clock_samps >= v[VC_HUB_END] - 1 ? (
            // Deadline is processed after all same-offset commands.
            0;
          ) : hub_request_finish(v, event_clock_samps < v[VC_HUB_END] - 1 ? min(v[VC_HUB_RELEASE], max(1, floor(0.003 * srate))) : v[VC_HUB_RELEASE], 13);
        ) : reason = 6;
      ) : mi >= 0 ? (
        m = hub_mod_base + mi * HM_STRIDE;
        m[HM_CHAN] == chan ? hub_stop_mod(mi) : reason = 6;
      );
      // Late End is intentionally idempotent; it cannot resolve by note pitch.
      reason == 0 ? hub_log(action, id, target, 1, 13, vi >= 0 ? v[VC_SAMPLE] : -1, 0, p[8], p[9], chan);
    ) : (
      (vi >= 0 || mi >= 0) ? reason = 5;
      reason == 0 && !bank_loaded ? reason = 9;
      oldindex = target > 0 ? hub_find_voice(target) : -1;
      reason == 0 && ((action >= 1 && action <= 4) || action == 6 || (action == 5 && target > 0)) && oldindex < 0 ? reason = 6;
      reason == 0 && oldindex >= 0 && voice_base[oldindex * VC_STRIDE + VC_CHAN] != chan ? reason = 6;
      reason == 0 && action == 0 && target != 0 ? reason = 4;
      reason == 0 && (action == 0 || action == 5) ? (
        freev = -1; j = 0;
        while(j < MAX_VOICES && freev < 0) (
          voice_base[j * VC_STRIDE + VC_ACTIVE] <= 0 ? freev = j;
          j += 1;
        );
        freev < 0 ? reason = 7 : (
          hub_rng_on = 1; hub_rng = 1 + ((id * 131 + p[19] * 65537 + p[6] * 17) % 2147483646);
          hub_starting = 1;
          start_voice(p[6], p[7], chan);
          hub_starting = 0;
          vi = last_start_voice_idx; v = voice_base + vi * VC_STRIDE;
          hub_serial += 1; hub_voice_count += 1;
          v[VC_HUB_ID] = id; v[VC_HUB_SERIAL] = hub_serial;
          v[VC_HUB_ACTION] = action; v[VC_HUB_RNG] = hub_rng;
          v[VC_HUB_EFFECTIVE] = v[VC_ENV]; v[VC_HUB_REPLVAL] = v[VC_ENV]; v[VC_HUB_BASEENV] = v[VC_ENV];
          v[VC_KEYTOKEN] = -hub_serial;
          hub_rng_on = 0;
          hub_plan_voice(v, p, duration, 0);
          action == 5 && oldindex >= 0 ? hub_request_finish(voice_base + oldindex * VC_STRIDE, max(1, floor(0.005 * srate)), 16);
          hub_log(action, id, target, 1, 0, v[VC_SAMPLE], duration / max(1, srate), p[8], p[9], chan);
        );
      ) : reason == 0 && action == 6 ? (
        v = voice_base + oldindex * VC_STRIDE;
        oldid = v[VC_HUB_ID];
        v[VC_HUB_ID] = id; v[VC_HUB_ACTION] = action;
        // Source and serial are retained: already attached modifiers still ride it.
        v[VC_CHAN] = chan; v[VC_NOTE] = p[6];
        hub_plan_voice(v, p, duration, 1);
        hub_log(action, id, target, 1, 0, v[VC_SAMPLE], duration / max(1, srate), p[8], p[9], chan);
      ) : reason == 0 && action >= 1 && action <= 4 ? (
        freem = -1; j = 0;
        while(j < HUB_MOD_CAP && freem < 0) (
          hub_mod_base[j * HM_STRIDE + HM_ACTIVE] <= 0 ? freem = j;
          j += 1;
        );
        freem < 0 ? reason = 8 : (
          v = voice_base + oldindex * VC_STRIDE;
          action != 4 && p[10] == 2 && v[VC_HUB_REPLACE] > 0 ? hub_remove_mod(v[VC_HUB_REPLACE] - 1, 16);
          m = hub_mod_base + freem * HM_STRIDE; memset(m, 0, HM_STRIDE);
          m[HM_ACTIVE] = 1; m[HM_ID] = id; m[HM_TARGET] = target;
          m[HM_VOICE] = oldindex; m[HM_SERIAL] = v[VC_HUB_SERIAL];
          m[HM_NEXT] = v[VC_HUB_MODHEAD]; v[VC_HUB_MODHEAD] = freem + 1;
          m[HM_ACTION] = action; m[HM_AUTH] = action == 4 ? 0 : p[10]; m[HM_AMOUNT] = p[11] / 127;
          m[HM_SHAPE] = p[12]; m[HM_START] = event_clock_samps; m[HM_LEN] = duration;
          m[HM_ATTACK] = p[17]; m[HM_RELEASE] = p[18];
          m[HM_CHAN] = chan; m[HM_FROM] = v[VC_HUB_REPLVAL];
          m[HM_OFFSET] = v[VC_HUB_REPLVAL] - v[VC_HUB_BASEENV];
          action != 4 && p[10] == 2 ? v[VC_HUB_REPLACE] = freem + 1;
          action == 4 ? (
            m[HM_LEN] = min(duration, max(1, floor(0.020 * srate)));
            hub_request_finish(v, m[HM_LEN], 14);
          );
          hub_mod_count += 1;
          hub_log(action, id, target, 1, 0, v[VC_SAMPLE], duration / max(1, srate), p[8], p[9], chan);
        );
      );
    );
    reason > 0 ? hub_log(action, id, target, -1, reason, -1, duration / max(1, srate), p[8], p[9], chan);
  ) : hub_log(action, id, target, -1, p[0] != 1 ? 3 : 4, -1, 0, p[8], p[9], chan);
);

function hub_cc(chan cc value) local(h consumed count now)
(
  consumed = 0; h = hub_packet_base + chan * HP_STRIDE; now = event_clock_samps;
  h[HP_ACTIVE] > 0 && h[HP_TIME] != now ? (
    hub_log(-1, 0, 0, -1, 17, -1, 0, 0, 0, chan); h[HP_ACTIVE] = 0;
  );
  cc == 118 && value == 83 ? (
    hub_pending_mask |= 1 << chan;
    h[HP_ACTIVE] = 1; h[HP_COUNT] = 0; h[HP_SUM] = 0; h[HP_TIME] = now;
    consumed = 1;
  ) : cc == 119 && h[HP_ACTIVE] > 0 ? (
    count = h[HP_COUNT];
    count < 21 ? (
      h[HP_DATA + count] = value;
      count < 20 ? h[HP_SUM] = (h[HP_SUM] + (count + 1) * value) % 128;
    );
    h[HP_COUNT] = min(22, count + 1); consumed = 1;
  ) : cc == 118 && value == 84 && h[HP_ACTIVE] > 0 ? (
    h[HP_COUNT] == 21 ? (
      h[HP_DATA + 20] == h[HP_SUM] ? hub_execute(h + HP_DATA, chan)
      : hub_log(-1, 0, 0, -1, 2, -1, 0, 0, 0, chan);
    ) : hub_log(-1, 0, 0, -1, 1, -1, 0, 0, 0, chan);
    h[HP_ACTIVE] = 0; hub_pending_mask &= 65535 - (1 << chan); consumed = 1;
  ) : h[HP_ACTIVE] > 0 && cc == 118 ? (
    h[HP_ACTIVE] = 0; hub_log(-1, 0, 0, -1, 1, -1, 0, 0, 0, chan);
  );
  consumed;
);

function hub_expire_packets() local(ch h)
(
  ch = 0;
  while(ch < 16) (
    h = hub_packet_base + ch * HP_STRIDE;
    h[HP_ACTIVE] > 0 ? (
      h[HP_ACTIVE] = 0;
      hub_log(-1, 0, 0, -1, 1, -1, 0, 0, 0, ch);
    );
    ch += 1;
  );
  hub_pending_mask = 0;
);

function hub_pre_voice(v) local(now remain rel)
(
  v[VC_HUB_ID] > 0 ? (
    now = event_clock_samps - 1;
    v[VC_HUB_FINISH] <= 0 ? (
      remain = v[VC_HUB_END] - now;
      rel = v[VC_HUB_RELEASE];
      v[VC_HUB_BOUNDARY] == 1 ? (
        remain <= rel ? (
          // Scheduler clock for commands is the current sample, before increment.
          event_clock_samps -= 1;
          hub_request_finish(v, max(1, remain), 11);
          event_clock_samps += 1;
        );
      ) : remain <= 0 ? (
        event_clock_samps -= 1; hub_request_finish(v, rel, 11); event_clock_samps += 1;
      );
    );
    // This seed is local to this semantic voice, never the global EEL generator.
    hub_rng_on = 1; hub_rng = max(1, v[VC_HUB_RNG]);
  );
);

function hub_read_loop(v sm phase) local(lo hi xf u b al ar)
(
  lo = v[VC_HUB_LOOPLO]; hi = v[VC_HUB_LOOPHI]; xf = v[VC_HUB_LOOPXF];
  phase = hub_wrap_phase(phase, lo, hi, xf);
  sample_frame2(sm[SM_PTR], sm[SM_NCH], phase);
  phase >= hi - xf ? (
    al = readL; ar = readR;
    u = hub_smooth((phase - (hi - xf)) / max(1, xf));
    b = lo + phase - (hi - xf);
    sample_frame2(sm[SM_PTR], sm[SM_NCH], b);
    // Complementary amplitude weights preserve coherent source level.
    readL = lerp(al, readL, u); readR = lerp(ar, readR, u);
  );
  phase;
);

function hub_read_natural(sm phase) local(fade len ok)
(
  readL = 0; readR = 0; ok = 0;
  phase >= 0 && phase < sm[SM_FRAMES] - 1 ? (
    ok = sample_frame2(sm[SM_PTR], sm[SM_NCH], phase);
    len = max(2, floor(sm[SM_ENDFADE] * auto_release_amt * sm[SM_SR] * 0.001));
    len = min(len, max(2, floor(sm[SM_FRAMES] * 0.42)));
    fade = hub_smooth((sm[SM_FRAMES] - 1 - phase) / len);
    readL *= fade; readR *= fade;
    fade <= 0.0003 ? ok = 0;
  );
  ok;
);

function hub_transition_mix(v sm left right) local(pos ppos nl nr dl dr valid wetok dryok weight scale)
(
  pos = v[VC_HUB_NEWPOS]; ppos = v[VC_HUB_NEWDRY];
  v[VC_HUB_DESTLOOP] > 0 ? (
    pos = hub_read_loop(v, sm, pos); wetok = 1;
  ) : wetok = hub_read_natural(sm, pos);
  nl = readL; nr = readR; dryok = 0;
  pitch_parallel_active ? (
    v[VC_HUB_DESTLOOP] > 0 ? (ppos = hub_read_loop(v, sm, ppos); dryok = 1;)
    : dryok = hub_read_natural(sm, ppos);
    nl = lerp(readL, nl, pitch_parallel_mix); nr = lerp(readR, nr, pitch_parallel_mix);
  ) : v[VC_HUB_DESTLOOP] > 0 && ppos >= v[VC_HUB_LOOPHI] ? (
    ppos = hub_wrap_phase(ppos, v[VC_HUB_LOOPLO], v[VC_HUB_LOOPHI], v[VC_HUB_LOOPXF]);
  );
  weight = lerp(v[VC_HUB_TFROM], v[VC_HUB_TTO], hub_smooth((v[VC_HUB_TLEN] - v[VC_HUB_TLEFT]) / max(1, v[VC_HUB_TLEN])));
  v[VC_HUB_TWEIGHT] = weight;
  // The old Granular source has its own 1.55 calibration in VC_BASE. Compensate
  // only the new direct side until ownership and that calibration transfer.
  scale = v[VC_MODE] == 3 ? 1 / 1.55 : 1;
  hub_mix_l = lerp(left, nl * scale, weight); hub_mix_r = lerp(right, nr * scale, weight);
  v[VC_HUB_NEWPOS] = pos + play_rate; v[VC_HUB_NEWDRY] = ppos + dry_play_rate;
  v[VC_HUB_TLEFT] = max(0, v[VC_HUB_TLEFT] - 1);
  wetok || dryok;
);

function hub_transition_commit(v)
(
  v[VC_HUB_TLEN] > 0 && v[VC_HUB_TLEFT] <= 0 ? (
    v[VC_HUB_TTO] > 0 ? (
      v[VC_POS] = v[VC_HUB_NEWPOS]; v[VC_PDRYPOS] = v[VC_HUB_NEWDRY];
      v[VC_HUB_LOOP] = v[VC_HUB_DESTLOOP];
      v[VC_GMODE] = 0; v[VC_GMIX] = 0; v[VC_TAILMIX] = 0; v[VC_CANSPAWN] = 0;
      v[VC_MODE] == 3 ? (v[VC_MODE] = 0; v[VC_BASE] /= 1.55;);
      memset(v + VC_GBASE, 0, NUM_GRAINS * VG_STRIDE);
    );
    v[VC_HUB_TLEN] = 0;
  );
);

function hub_mod_weight(u shape action af rf len) local(peak x a r scale)
(
  peak = action == 2 ? lerp(0.40, 0.88, shape / 127) : lerp(0.18, 0.82, shape / 127);
  a = af == 127 ? peak : af / 100;
  r = rf == 127 ? 1 - peak : rf / 100;
  a = max(1 / max(1, len), a); r = max(1 / max(1, len), r);
  a + r > 1 ? (scale = 1 / (a + r); a *= scale; r *= scale;);
  x = u < a ? u / a : u > 1 - r ? (1 - u) / r : 1;
  x = sin(clamp01(x) * 1.570796326794897); x * x;
);

function hub_envelope(v base) local(now age dur value db curr next m u w goal offset repl index decay natural_base terminal)
(
  now = event_clock_samps - 1;
  age = max(0, now - v[VC_HUB_START]); dur = max(1, v[VC_HUB_END] - v[VC_HUB_START]);
  value = base;
  v[VC_HUB_AUTH] == 2 ? (
    value = v[VC_HUB_AMOUNT] * (hub_smooth(age / max(1, v[VC_HUB_ATTACK])) ^ lerp(0.65, 1.60, v[VC_HUB_SHAPE] / 127));
    );
  db = v[VC_HUB_AUTH] == 1 ? 6 * v[VC_HUB_AMOUNT] * hub_mod_weight(clamp01(age / dur), v[VC_HUB_SHAPE], 2, 127, 127, dur) : 0;
  terminal = 1;
  v[VC_HUB_FINISH] > 0 ? (
    terminal = v[VC_HUB_FGAIN] * (1 - hub_smooth((now - v[VC_HUB_FSTART]) / max(1, v[VC_HUB_FLEN])));
    value = v[VC_HUB_FLEVEL];
  );
  v[VC_HUB_TERMINAL] = terminal;
  v[VC_HUB_BASEENV] = value;
  natural_base = value;
  curr = v[VC_HUB_MODHEAD];
  while(curr > 0) (
    index = curr - 1; m = hub_mod_base + index * HM_STRIDE; next = m[HM_NEXT];
    u = (now - m[HM_START]) / max(1, m[HM_LEN]);
    (m[HM_SERIAL] != v[VC_HUB_SERIAL] || (m[HM_STOP] <= 0 && u >= 1) || (m[HM_STOP] > 0 && now >= m[HM_STOPSTART] + m[HM_STOPLEN])) ? (
      hub_remove_mod(index, m[HM_STOP] > 0 ? 13 : 11);
    ) : (
      w = hub_mod_weight(clamp01(u), m[HM_SHAPE], m[HM_ACTION], m[HM_ATTACK], m[HM_RELEASE], m[HM_LEN]);
      m[HM_AUTH] == 2 ? (
        goal = m[HM_ACTION] == 3 ? m[HM_FROM] * db2amp(-24 * m[HM_AMOUNT]) : m[HM_AMOUNT];
        offset = m[HM_OFFSET] * (1 - hub_smooth((now - m[HM_START]) / max(1, min(0.003 * srate, m[HM_LEN] * 0.15))));
        repl = (goal - natural_base) * w + offset;
        m[HM_STOP] > 0 ? repl = m[HM_STOPVAL] * (1 - hub_smooth((now - m[HM_STOPSTART]) / max(1, m[HM_STOPLEN])));
        value = natural_base + repl; m[HM_LAST] = repl;
      ) : (
        repl = (m[HM_ACTION] == 4 ? 0 : m[HM_ACTION] == 3 ? -24 : 6) * m[HM_AMOUNT] * w;
        m[HM_STOP] > 0 ? repl = m[HM_STOPVAL] * (1 - hub_smooth((now - m[HM_STOPSTART]) / max(1, m[HM_STOPLEN])));
        db += repl; m[HM_LAST] = repl;
      );
    );
    curr = next;
  );
  v[VC_HUB_REPLVAL] = value;
  value *= db2amp(clamp(db, -36, 12));
  v[VC_HUB_FINISH] > 0 ? (
    u = (now - v[VC_HUB_FSTART]) / max(1, v[VC_HUB_FLEN]);
    // The finite terminal gate encloses all modifiers, including replacements.
    // Accents can ride a release but cannot reopen its completed endpoint.
    value *= terminal;
    now - v[VC_HUB_FSTART] < v[VC_HUB_FBRIDGE] ? value = lerp(v[VC_HUB_FFROM], value, hub_smooth((now - v[VC_HUB_FSTART]) / max(1, v[VC_HUB_FBRIDGE])));
    u >= 1 ? (value = 0; v[VC_ACTIVE] = 0; v[VC_STAGE] = ENV_OFF;)
    : (
      // The base AHDSR may already be silent. It cannot retire a running Hub
      // terminal gate (including a replacement/ride over that base envelope).
      v[VC_ACTIVE] = 1; v[VC_STAGE] = ENV_RELEASE;
    );
  );
  // Continuation transfers the FINAL envelope. Blending before retained
  // modifiers would count their gain twice at the ownership boundary.
  v[VC_ACTIVE] > 0 && v[VC_HUB_HANDOFF] > 0 && age < v[VC_HUB_HANDOFF] ? value = lerp(v[VC_HUB_RAMPFROM], value, hub_smooth(age / v[VC_HUB_HANDOFF]));
  v[VC_HUB_EFFECTIVE] = max(0, value);
  max(0, value);
);

// Sample Hub v1.0: engine-owned execution log, read-only GFX presentation.
// Integrate all functions below into @init AFTER ui_button/draw_center_buf.
// GFX integration calls are documented in Hub_Log_GFX_v1.0.md.
// Ring ABI: 100 rows x 12 doubles. See the companion integration document.
// No DSP buffers, counters, parameters, or source ownership are mutated here.

function hub_log_action_name(value)
(
  value == 0 ? sprintf(#hub_log_action, "Play") :
  value == 1 ? sprintf(#hub_log_action, "Accent") :
  value == 2 ? sprintf(#hub_log_action, "Swell") :
  value == 3 ? sprintf(#hub_log_action, "Damp") :
  value == 4 ? sprintf(#hub_log_action, "Choke") :
  value == 5 ? sprintf(#hub_log_action, "Retrigger") :
  value == 6 ? sprintf(#hub_log_action, "Continue") :
  value == 7 ? sprintf(#hub_log_action, "End") :
  sprintf(#hub_log_action, "Frame");
);

function hub_log_reason_name(value)
(
  value == 0 ? sprintf(#hub_log_reason, "OK") :
  value == 1 ? sprintf(#hub_log_reason, "Malformed frame") :
  value == 2 ? sprintf(#hub_log_reason, "Checksum mismatch") :
  value == 3 ? sprintf(#hub_log_reason, "Unsupported protocol version") :
  value == 4 ? sprintf(#hub_log_reason, "Invalid field") :
  value == 5 ? sprintf(#hub_log_reason, "Event ID already live") :
  value == 6 ? sprintf(#hub_log_reason, "Target is not live") :
  value == 7 ? sprintf(#hub_log_reason, "Audio voice limit") :
  value == 8 ? sprintf(#hub_log_reason, "Modifier limit") :
  value == 9 ? sprintf(#hub_log_reason, "No playable bank") :
  value == 10 ? sprintf(#hub_log_reason, "No usable body: natural playback") :
  value == 11 ? sprintf(#hub_log_reason, "Planned deadline") :
  value == 12 ? sprintf(#hub_log_reason, "Source reached its end") :
  value == 13 ? sprintf(#hub_log_reason, "Authored End") :
  value == 14 ? sprintf(#hub_log_reason, "Target choked") :
  value == 15 ? sprintf(#hub_log_reason, "Transport reset") :
  value == 16 ? sprintf(#hub_log_reason, "Ownership transferred") :
  value == 17 ? sprintf(#hub_log_reason, "Frame spans sample offsets") :
  value == 18 ? sprintf(#hub_log_reason, "Bank changed") :
  sprintf(#hub_log_reason, "Reason %d", value);
);

function hub_log_result_name(value)
(
  value == 1 ? sprintf(#hub_log_result, "ACCEPTED") :
  value == 0 ? sprintf(#hub_log_result, "ENDED") :
  value == 2 ? sprintf(#hub_log_result, "FALLBACK") :
  sprintf(#hub_log_result, "REJECTED");
);

function hub_log_boundary_name(value)
(
  value == 1 ? sprintf(#hub_log_boundary, "Fit") :
  value == 2 ? sprintf(#hub_log_boundary, "Tail") :
  sprintf(#hub_log_boundary, "Free");
);

function hub_log_fill_name(value)
(
  value == 1 ? sprintf(#hub_log_fill, "Auto") :
  value == 2 ? sprintf(#hub_log_fill, "Loop") :
  sprintf(#hub_log_fill, "Natural");
);

// Use an explicit text-width bound without reducing the 14px minimum font.
// The unshortened reason remains available as a tooltip on every row.
function hub_log_text(x y width) local(tw th n)
(
  gfx_measurestr(#hub_log_text, tw, th);
  n = strlen(#hub_log_text);
  sprintf(#hub_log_clip, "");
  while (tw > width && n > 1) (
    n -= 1;
    strncpy(#hub_log_clip, #hub_log_text, n);
    strcat(#hub_log_clip, "...");
    gfx_measurestr(#hub_log_clip, tw, th);
  );
  gfx_x = x; gfx_y = y;
  n < strlen(#hub_log_text) ? gfx_drawstr(#hub_log_clip) : gfx_drawstr(#hub_log_text);
);

function hub_log_header() local(x y w h)
(
  w = 100; h = 30;
  x = max(450, gfx_w - 352); y = 24;
  ui_tab_button(1700, x, y, w, h, hub_ui_open) ? (
    hub_ui_open = !hub_ui_open;
    // A previous drag must not remain captured beneath the diagnostic panel.
    ui_active = -1;
  );
  gfx_setfont(1, "Arial", 14, 0);
  gfx_r = 0.88; gfx_g = 0.95; gfx_b = 1; gfx_a = 1;
  sprintf(#ui_buf, "MIDI LOG"); draw_center_buf(x, y + 7, w);
  ui_hover_id == 1700 ? (
    sprintf(#tip_title, "Sample execution log");
    sprintf(#tip_body, "Open the last 100 MIDI Hub results from this Sample instance.");
  );
);

function hub_log_draw() local(
  x y w h top rowh rows count maxscroll scroll step
  i slot p yy seq result narrow infoheight bottom labelw
)
(
  x = 10; y = 104; w = max(1, gfx_w - 20); h = max(1, gfx_h - 116);
  ui_panel(x, y, w, h);
  gfx_setfont(1, "Arial", 19, 0);
  gfx_r = 0.91; gfx_g = 0.97; gfx_b = 1; gfx_a = 1;
  sprintf(#hub_log_text, "MIDI Hub / Sample execution");
  hub_log_text(x + 18, y + 16, max(1, w - 230));

  ui_button(1701, x + w - 104, y + 12, 86, 30) ? (
    hub_ui_open = 0; ui_active = -1;
  );
  gfx_setfont(1, "Arial", 14, 0);
  gfx_r = 0.9; gfx_g = 0.95; gfx_b = 1; gfx_a = 1;
  sprintf(#ui_buf, "CLOSE"); draw_center_buf(x + w - 104, y + 20, 86);
  ui_button(1702, x + w - 198, y + 12, 86, 30) ? hub_ui_anchor = 0;
  gfx_r = 0.9; gfx_g = 0.95; gfx_b = 1; gfx_a = 1;
  sprintf(#ui_buf, "LATEST"); draw_center_buf(x + w - 198, y + 20, 86);

  count = clamp(hub_log_count | 0, 0, 100);
  narrow = w < 940;
  rowh = narrow ? 79 : 61;
  infoheight = narrow ? 59 : 39;
  top = y + 54 + infoheight;
  bottom = y + h - 36;
  rows = max(0, floor((bottom - top) / rowh));
  maxscroll = max(0, count - rows);
  // Zero anchor follows newest. A nonzero serial anchors the history even
  // while new DSP records arrive. Only explicit UI input changes the anchor.
  scroll = hub_ui_anchor > 0 ? clamp(hub_log_serial - hub_ui_anchor, 0, maxscroll) : 0;

  pt_in(x + 10, top, w - 20, max(0, bottom - top)) && !ui_wheel_used && abs(ui_wheel) >= 1 ? (
    step = max(1, floor(abs(ui_wheel) / 120 + 0.5));
    scroll = clamp(scroll + (ui_wheel > 0 ? -step : step) * 3, 0, maxscroll);
    hub_ui_anchor = scroll > 0 ? hub_log_serial - scroll : 0;
    ui_wheel_used = 1;
  );
  mouse_rpressed && pt_in(x + 10, top, w - 20, max(0, bottom - top)) ? (
    hub_ui_anchor = 0; scroll = 0;
  );

  gfx_setfont(1, "Arial", 14, 0);
  gfx_r = 0.68; gfx_g = 0.80; gfx_b = 0.90; gfx_a = 1;
  sprintf(#hub_log_text, "Executed here: %d accepted | %d rejected | %d retained of 100", hub_log_accepted, hub_log_rejected, count);
  hub_log_text(x + 18, y + 54, w - 36);
  sprintf(#hub_log_text, "Newest first. Time is engine time since reset. The Lua Hub logs authoring separately.");
  hub_log_text(x + 18, y + 74, w - 36);
  narrow ? (
    sprintf(#hub_log_text, "Wheel: history. Right-click or LATEST: follow new events.");
    hub_log_text(x + 18, y + 94, w - 36);
  );

  count == 0 ? (
    gfx_setfont(1, "Arial", 16, 0);
    gfx_r = 0.79; gfx_g = 0.88; gfx_b = 0.96; gfx_a = 1;
    sprintf(#hub_log_text, "No Hub command has executed in this Sample instance.");
    hub_log_text(x + 18, top + 20, w - 36);
    gfx_setfont(1, "Arial", 14, 0);
    sprintf(#hub_log_text, "Play an item authored by Sample MIDI Hub. Regular MIDI notes are not added to this log.");
    hub_log_text(x + 18, top + 46, w - 36);
  );

  i = 0;
  while (i < rows && i + scroll < count) (
    slot = (hub_log_head - 1 - scroll - i + 200) % 100;
    p = hub_log_base + slot * 12;
    yy = top + i * rowh;
    seq = p[0]; result = p[5];
    gfx_r = i % 2 ? 0.035 : 0.045;
    gfx_g = i % 2 ? 0.049 : 0.062;
    gfx_b = i % 2 ? 0.066 : 0.081; gfx_a = 1;
    gfx_rect(x + 10, yy, w - 20, rowh - 3, 1);
    hub_log_action_name(p[2]); hub_log_result_name(result);
    hub_log_reason_name(p[6]);
    hub_log_boundary_name(p[9]); hub_log_fill_name(p[10]);

    gfx_setfont(1, "Arial", 15, 0);
    gfx_r = result < 0 ? 1 : (result == 2 ? 1 : 0.68);
    gfx_g = result < 0 ? 0.55 : (result == 2 ? 0.82 : 0.96);
    gfx_b = result < 0 ? 0.47 : (result == 2 ? 0.42 : 0.84); gfx_a = 1;
    labelw = narrow ? min(120, w * 0.22) : 140;
    sprintf(#hub_log_text, "%s", #hub_log_result);
    hub_log_text(x + w - labelw - 18, yy + 6, labelw);
    gfx_r = 0.90; gfx_g = 0.94; gfx_b = 0.99; gfx_a = 1;
    sprintf(#hub_log_text, "#%d  %.3fs   %s   ID %d / target %d", seq, p[1], #hub_log_action, p[3], p[4]);
    hub_log_text(x + 18, yy + 6, max(1, w - labelw - 55));

    gfx_setfont(1, "Arial", 14, 0);
    gfx_r = 0.72; gfx_g = 0.82; gfx_b = 0.92; gfx_a = 1;
    p[7] >= 0 ? sprintf(#hub_log_source, "Source %d", p[7] + 1) : sprintf(#hub_log_source, "Source --");
    narrow ? (
      sprintf(#hub_log_text, "%s | planned %.3fs | %s / %s | Ch %d", #hub_log_source, p[8], #hub_log_boundary, #hub_log_fill, p[11] + 1);
      hub_log_text(x + 18, yy + 28, w - 36);
      sprintf(#hub_log_text, "%s", #hub_log_reason);
      hub_log_text(x + 18, yy + 49, w - 36);
    ) : (
      sprintf(#hub_log_text, "%s | planned %.3fs | %s / %s | Ch %d | %s", #hub_log_source, p[8], #hub_log_boundary, #hub_log_fill, p[11] + 1, #hub_log_reason);
      hub_log_text(x + 18, yy + 29, w - 36);
    );

    pt_in(x + 10, yy, w - 20, rowh - 3) ? (
      // One bounded shared hover ID; existing sample-map hover IDs are >=5000.
      ui_hover_id = 1703;
      sprintf(#tip_title, "%s / ID %d / target %d / %s", #hub_log_action, p[3], p[4], #hub_log_result);
      sprintf(#tip_body, "%s | %s | planned %.3fs | channel %d", #hub_log_reason, #hub_log_source, p[8], p[11] + 1);
    );
    i += 1;
  );

  gfx_setfont(1, "Arial", 14, 0);
  gfx_r = 0.67; gfx_g = 0.78; gfx_b = 0.88; gfx_a = 1;
  count > 0 ? sprintf(#hub_log_text, "Showing %d-%d of %d | %s", min(count, scroll + 1), min(count, scroll + rows), count, hub_ui_anchor > 0 ? "History" : "Following latest")
  : sprintf(#hub_log_text, "0 records | Following latest");
  hub_log_text(x + 18, y + h - 26, w - 36);

  ui_hover_id == 1701 ? (
    sprintf(#tip_title, "Close MIDI log");
    sprintf(#tip_body, "Return to Sample controls. Logging continues while this panel is closed.");
  );
  ui_hover_id == 1702 ? (
    sprintf(#tip_title, "Follow latest");
    sprintf(#tip_body, "Return to the newest engine record. The audio-owned log is never cleared from GFX.");
  );
);

// Sample metadata is capacity-driven. The old fixed 64-sample bank cap
