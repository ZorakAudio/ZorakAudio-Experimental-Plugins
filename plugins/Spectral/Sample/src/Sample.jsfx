    bright = sm[SM_BRIGHT];
    sharp = sm[SM_SHARP];
    bh = 10 + (map_h - 20) * clamp01(0.15 + bright * 0.85);
    bx = map_x + i * bw;
    by = map_y + map_h - bh - 4;
