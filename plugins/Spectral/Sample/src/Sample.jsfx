(slider57 | 0) ? sprintf(#ui_buf, "%.0f%%", auto_smooth_release_share * 100) : ((ui_shift && (ui_hover_id == 204 || ui_active == 204)) ? sprintf(#ui_buf, "G%.2f", auto_release_amt) : sprintf(#ui_buf, "%.0f", slider5)); gfx_x = track_x + (track_w - 18) * 0.5; gfx_y = adsr_y - 20; gfx_r = 0.70; gfx_g = 0.78; gfx_b = 0.88; gfx_drawstr(#ui_buf);

