            corpus_pick_role == 2 ? gxpand *= 1.25;
            gxpand *= slider9 * (0.10 + 0.38 * v[VC_TAILMIX] + 0.18 * gesture_arc) * (1 - 0.88 * gran_slow_glue) * (1 - 0.86 * edge_melt_active);
            gxpand = clamp01(gxpand);

            prefill_age = floor(spawn_gsize * (slider9 * (0.015 + 0.075 * gesture_arc) + gran_slow_glue * 0.110 + gran_mscont * 0.060 + gran_stretch_glue * 0.075 + edge_melt_active * (0.045 + 0.085 * max(gran_slow_glue, max(gran_mscont, gran_xcont)))) * hub_random(1));
            schedule_prefill > 0 ? prefill_age = max(prefill_age, min(max(0, spawn_gsize - 2), floor(schedule_prefill)));
            prefill_src = gsrc - prefill_age * grate;
