          gran_stretch_glue = granular_event_stretch * clamp01(0.14 + 0.36 * gran_mscont + 0.58 * gran_xcont + 0.26 * gran_slow_glue - 0.38 * gran_mstrans);
          gran_slow_glue = clamp01(gran_slow_glue + gran_stretch_glue * (0.42 + 0.26 * (1 - truth_mix)));

          granular_voice ? (
            gran_tail_region = cur_region_mode;

            // v58 EdgeMelt: smooth source-position motion instead of making
            // grain starts teleport. This attacks the root of patchwork/edge fizz.
            edge_melt_active = edge_melt_amt * ((stage == ENV_ATTACK || stage == ENV_HOLD) ? 0.55 : 1.0);
            edge_melt_slew = (edge_melt_active ^ 1.30) * clamp01(0.22 + 0.78 * max(gran_slow_glue, max(gran_mscont, gran_xcont)));
            edge_melt_slew > 0.0001 && (v[VC_LGSID] | 0) == gsid && (v[VC_LGREG] | 0) == cur_region_mode ? (
              melt_pred = v[VC_LGPOS] + max(1, abs(v[VC_SRCHOP]) * (0.68 + 0.20 * edge_melt_active));
              gran_tail_region ? (
                melt_pred = clamp(melt_pred, ghist_lo, max(ghist_lo, ghist_hi - 1));
                gsrc = lerp(gsrc, melt_pred, clamp01(0.12 + 0.48 * edge_melt_slew));
