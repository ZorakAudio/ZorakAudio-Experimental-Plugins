              spawn_hop_base = floor(spawn_hop_base * lerp(1.0, 0.52, edge_melt_overlap * melt_overlap_w));
            );
            hop_jit = floor(spawn_hop_base * slider9 * (0.05 + 0.11 * (1 - truth_mix)) * (1 - 0.72 * gran_slow_glue) * (1 - 0.65 * max(gran_mscont, gran_xcont)) * (1 - 0.58 * granular_event_stretch) * (1 - 0.82 * edge_melt_active) * ((hub_random(1) - 0.5) * 2));
            gran_min_hop = floor(srate * lerp(lerp(0.0046, 0.0026, gran_hop_scale), lerp(0.0100, 0.0064, gran_hop_scale), granular_event_stretch));
            gran_min_hop = max(floor(srate * 0.0040), floor(lerp(gran_min_hop, srate * 0.0046, edge_melt_overlap)));
            gran_max_hop_ratio = lerp(lerp(0.285, 0.118, gran_hop_scale), lerp(0.360, 0.220, gran_hop_scale), granular_event_stretch);
            gran_max_hop_ratio *= lerp(1.0, 0.56, edge_melt_overlap * clamp01(0.42 + 0.58 * max(gran_slow_glue, max(gran_mscont, gran_xcont))));
            spawn_hop = clamp(spawn_hop_base + hop_jit, max(1, gran_min_hop), max(1, floor(spawn_gsize * gran_max_hop_ratio)));
