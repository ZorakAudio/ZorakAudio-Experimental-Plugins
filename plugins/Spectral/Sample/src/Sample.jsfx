                gl *= gsource_end_fade; gr *= gsource_end_fade;
                gdry_l *= gdry_fade; gdry_r *= gdry_fade;
                w = wbase * entry_fade;
                gw = w * gb[VG_GAIN];
                sumL += gl * gw;
                sumR += gr * gw;
