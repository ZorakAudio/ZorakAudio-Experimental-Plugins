                    gb[VG_LPL] = gl;
                    gb[VG_LPR] = gr;
                  );
                  gb[VG_LPL] = denorm_zap(gb[VG_LPL] + (gl - gb[VG_LPL]) * edge_melt_lpf_coeff);
                  gb[VG_LPR] = denorm_zap(gb[VG_LPR] + (gr - gb[VG_LPR]) * edge_melt_lpf_coeff);
                  melt_lpf_mix = edge_melt_amt * clamp01(0.12 + 0.88 * clamp01(gsm[SM_BRIGHT] * 0.52 + gsm[SM_EDGE] * 0.74));
                  gl = lerp(gl, gb[VG_LPL], melt_lpf_mix);
                  gr = lerp(gr, gb[VG_LPR], melt_lpf_mix);
                );

                gpan = gb[VG_PAN];
