            );

            edge_melt_active > 0.0001 ? (
              melt_len_score = clamp01(max(gran_slow_glue, max(gran_mscont, gran_xcont)) + 0.18 * clamp01(gran_evtfrac * 1.6) - 0.30 * gran_mstrans);
              melt_len_mul = 1 + (edge_melt_active ^ 1.35) * lerp(0.34, 2.55, melt_len_score);
              gran_region == GC_REGION_ATTACK ? ( melt_len_mul = 1 + (melt_len_mul - 1) * 0.36; );
              melt_max_ms = gran_region == GC_REGION_ATTACK ? 0.190 : (gran_region == GC_REGION_TAIL ? lerp(0.520, 1.650, melt_len_score) : lerp(0.440, 1.350, melt_len_score));
              spawn_gsize = clamp(floor(spawn_gsize * melt_len_mul), max(hop + 1, floor(gsize * 0.62)), max(hop + 1, floor(srate * melt_max_ms)));
            );

            reverse_grain = gran_tail_region && slider9 > 0.55 && v[VC_TAILMIX] > 0.25 && hub_random(1) < (0.006 + 0.030 * slider9 * v[VC_TAILMIX] * gesture_arc) * (1 - 0.85 * edge_melt_active);
            reverse_grain ? (
              rev_span = min(max(1, ghist_hi - ghist_lo - 2), (spawn_gsize - 1) * abs(grate));
