@init
// Sample v71 embedded Anti-Salience MX; source: Anti-Salience MX v1.1.0 supplied 2026-09-16.
// 20 profiles: 1 + source_profile*4 + preset. Index 0 Legacy is owned by Sample.
// Source-only integration: no external reference detector, standalone UI diagnostics, or trim.
// All helpers belong to @init. See AntiSalience_Integration_v71.md for lifecycle and compatibility.
function sa_clampv(sa_x,sa_lo,sa_hi) (
    sa_x<sa_lo ? sa_lo : (sa_x>sa_hi ? sa_hi : sa_x);
  );

function sa_clamp01(sa_x) (
    sa_clampv(sa_x,0,1);
  );

function sa_db2amp(sa_x) (
    pow(10,sa_x/20);
  );

function sa_denorm(sa_x) (
    abs(sa_x)<0.000000000000000001 ? 0 : sa_x;
  );

function sa_ring_read(sa_base,sa_delay) local(sa_rp,sa_i0,sa_i1,sa_fr,sa_a,sa_b) (
    sa_rp=sa_sc_wpos-sa_delay;
    sa_rp<0 ? sa_rp+=sa_sc_buf_len;
    sa_rp<0 ? sa_rp+=sa_sc_buf_len;
    sa_i0=floor(sa_rp);
    sa_fr=sa_rp-sa_i0;
    sa_i1=sa_i0+1;
    sa_i1>=sa_sc_buf_len ? sa_i1=0;
    sa_a=sa_mem[sa_base+sa_i0];
    sa_b=sa_mem[sa_base+sa_i1];
    sa_a+(sa_b-sa_a)*sa_fr;
  );

function sa_ap_process(sa_x,sa_base,sa_delay,sa_g) local(sa_d,sa_y,sa_w) (
    sa_d=sa_ring_read(sa_base,sa_delay);
    sa_y=sa_d-sa_g*sa_x;
    sa_w=sa_x+sa_g*sa_y;
    sa_mem[sa_base+sa_sc_wpos]=sa_w;
    sa_y;
  );
function sa_recalc() local(sa_i,sa_fc) (
    sa_sr=max(8000,srate);

    // Eight broad perceptual regions for the post-core anchor tax.
    sa_mem[sa_XOVER_F+0]=120;
    sa_mem[sa_XOVER_F+1]=250;
    sa_mem[sa_XOVER_F+2]=500;
    sa_mem[sa_XOVER_F+3]=1000;
    sa_mem[sa_XOVER_F+4]=2000;
    sa_mem[sa_XOVER_F+5]=4000;
    sa_mem[sa_XOVER_F+6]=7500;

    sa_i=0;
    loop(sa_NX,
      sa_fc=min(sa_mem[sa_XOVER_F+sa_i],sa_sr*0.45);
      sa_mem[sa_XOVER_G+sa_i]=1-exp(-2*$pi*sa_fc/sa_sr);
      sa_i+=1;
    );

    // Original Salience Push split coefficients.
    sa_g15=1-exp(-2*$pi*min(1500,sa_sr*0.45)/sa_sr);
    sa_g32=1-exp(-2*$pi*min(3200,sa_sr*0.45)/sa_sr);
    sa_g55=1-exp(-2*$pi*min(5500,sa_sr*0.45)/sa_sr);

    // Analysis followers.
    sa_aLev=1-exp(-1/(0.100*sa_sr));
    sa_aSrc=1-exp(-1/(0.150*sa_sr));
    sa_aFast=1-exp(-1/(0.020*sa_sr));
    sa_aSlow=1-exp(-1/(0.500*sa_sr));
    sa_band_fast_a=1-exp(-1/(0.018*sa_sr));
    sa_band_slow_a=1-exp(-1/(0.340*sa_sr));
    sa_band_long_a=1-exp(-1/(4.000*sa_sr));
    sa_control_a=1-exp(-1/(0.050*sa_sr));
    sa_level_down_a=1-exp(-1/(0.080*sa_sr));
    sa_level_up_a=1-exp(-1/(1.300*sa_sr));
    sa_limiter_rel_a=1-exp(-1/(0.140*sa_sr));

    // Optional scatter network. No PDC: the clean core remains zero-latency.
    sa_sc_buf_len=max(128,floor(0.035*sa_sr)+16);
    sa_SC_L1=sa_SC_BUF_BASE;
    sa_SC_R1=sa_SC_L1+sa_sc_buf_len;
    sa_SC_L2=sa_SC_R1+sa_sc_buf_len;
    sa_SC_R2=sa_SC_L2+sa_sc_buf_len;
    sa_SC_L3=sa_SC_R2+sa_sc_buf_len;
    sa_SC_R3=sa_SC_L3+sa_sc_buf_len;
    sa_SC_L4=sa_SC_R3+sa_sc_buf_len;
    sa_SC_R4=sa_SC_L4+sa_sc_buf_len;
  );
function sa_set_profile() (
    // Original Neutral policy.
    sa_pf_formW=0.95;
    sa_pf_edgeW=1.00;
    sa_pf_airW=1.00;
    sa_pf_tameBias=1.00;
    sa_pf_sideBias=1.00;
    sa_pf_selfOff=0.0;
    sa_pf_transOff=0.0;
    sa_pf_sideOff=0.0;
    sa_pf_commonCap=1.00;
    sa_pf_sideCap=1.00;
    sa_pf_broad=1.00;
    sa_base_atk=0.22;
    sa_base_rel=6.0;
    sa_base_satk=0.35;
    sa_base_srel=8.0;

    // Neutral post-core salience priors.
    sa_mem[sa_PROFILE_W+0]=0.20;
    sa_mem[sa_PROFILE_W+1]=0.30;
    sa_mem[sa_PROFILE_W+2]=0.48;
    sa_mem[sa_PROFILE_W+3]=0.72;
    sa_mem[sa_PROFILE_W+4]=1.00;
    sa_mem[sa_PROFILE_W+5]=1.18;
    sa_mem[sa_PROFILE_W+6]=1.16;
    sa_mem[sa_PROFILE_W+7]=1.02;

    sa_profile_i==1 ? ( // Vocals
      sa_pf_formW=0.70;
      sa_pf_edgeW=0.88;
      sa_pf_airW=0.90;
      sa_pf_tameBias=0.80;
      sa_pf_sideBias=0.50;
      sa_pf_selfOff=2.5;
      sa_pf_transOff=1.2;
      sa_pf_sideOff=1.5;
      sa_pf_commonCap=0.78;
      sa_pf_sideCap=0.50;
      sa_pf_broad=0.75;
      sa_base_atk=0.28;
      sa_base_rel=7.5;
      sa_base_satk=0.45;
      sa_base_srel=9.5;
      sa_mem[sa_PROFILE_W+0]=0.10;
      sa_mem[sa_PROFILE_W+1]=0.18;
      sa_mem[sa_PROFILE_W+2]=0.32;
      sa_mem[sa_PROFILE_W+3]=0.62;
      sa_mem[sa_PROFILE_W+4]=1.12;
      sa_mem[sa_PROFILE_W+5]=1.34;
      sa_mem[sa_PROFILE_W+6]=1.10;
      sa_mem[sa_PROFILE_W+7]=0.72;
    );

    sa_profile_i==2 ? ( // SFX
      sa_pf_formW=0.95;
      sa_pf_edgeW=1.10;
      sa_pf_airW=1.05;
      sa_pf_tameBias=1.25;
      sa_pf_sideBias=1.10;
      sa_pf_selfOff=-1.0;
      sa_pf_transOff=-0.8;
      sa_pf_sideOff=-0.5;
      sa_pf_commonCap=1.20;
      sa_pf_sideCap=1.10;
      sa_pf_broad=1.00;
      sa_base_atk=0.15;
      sa_base_rel=4.5;
      sa_base_satk=0.22;
      sa_base_srel=6.0;
      sa_mem[sa_PROFILE_W+0]=0.18;
      sa_mem[sa_PROFILE_W+1]=0.28;
      sa_mem[sa_PROFILE_W+2]=0.46;
      sa_mem[sa_PROFILE_W+3]=0.70;
      sa_mem[sa_PROFILE_W+4]=0.98;
      sa_mem[sa_PROFILE_W+5]=1.20;
      sa_mem[sa_PROFILE_W+6]=1.32;
      sa_mem[sa_PROFILE_W+7]=1.26;
    );

    sa_profile_i==3 ? ( // Foley
      sa_pf_formW=0.82;
      sa_pf_edgeW=0.95;
      sa_pf_airW=0.92;
      sa_pf_tameBias=1.00;
      sa_pf_sideBias=0.70;
      sa_pf_selfOff=0.5;
      sa_pf_transOff=0.4;
      sa_pf_sideOff=0.8;
      sa_pf_commonCap=0.92;
      sa_pf_sideCap=0.70;
      sa_pf_broad=0.85;
      sa_base_atk=0.20;
      sa_base_rel=6.2;
      sa_base_satk=0.30;
      sa_base_srel=7.5;
      sa_mem[sa_PROFILE_W+0]=0.18;
      sa_mem[sa_PROFILE_W+1]=0.28;
      sa_mem[sa_PROFILE_W+2]=0.44;
      sa_mem[sa_PROFILE_W+3]=0.68;
      sa_mem[sa_PROFILE_W+4]=0.94;
      sa_mem[sa_PROFILE_W+5]=1.10;
      sa_mem[sa_PROFILE_W+6]=1.00;
      sa_mem[sa_PROFILE_W+7]=0.82;
    );

    sa_profile_i==4 ? ( // BG
      sa_pf_formW=1.00;
      sa_pf_edgeW=1.00;
      sa_pf_airW=1.12;
      sa_pf_tameBias=0.75;
      sa_pf_sideBias=1.35;
      sa_pf_selfOff=-1.5;
      sa_pf_transOff=0.8;
      sa_pf_sideOff=-2.0;
      sa_pf_commonCap=1.10;
      sa_pf_sideCap=1.35;
      sa_pf_broad=1.10;
      sa_base_atk=0.34;
      sa_base_rel=8.5;
      sa_base_satk=0.45;
      sa_base_srel=10.0;
      sa_mem[sa_PROFILE_W+0]=0.14;
      sa_mem[sa_PROFILE_W+1]=0.22;
      sa_mem[sa_PROFILE_W+2]=0.34;
      sa_mem[sa_PROFILE_W+3]=0.54;
      sa_mem[sa_PROFILE_W+4]=0.84;
      sa_mem[sa_PROFILE_W+5]=1.10;
      sa_mem[sa_PROFILE_W+6]=1.30;
      sa_mem[sa_PROFILE_W+7]=1.36;
    );

    // Low-body protection is invariant across profiles.
    sa_mem[sa_BODY_PROTECT+0]=0.04;
    sa_mem[sa_BODY_PROTECT+1]=0.08;
    sa_mem[sa_BODY_PROTECT+2]=0.15;
    sa_mem[sa_BODY_PROTECT+3]=0.28;
    sa_mem[sa_BODY_PROTECT+4]=0.50;
    sa_mem[sa_BODY_PROTECT+5]=0.72;
    sa_mem[sa_BODY_PROTECT+6]=0.90;
    sa_mem[sa_BODY_PROTECT+7]=1.00;
  );
function sa_clear_scatter() (
  memset(sa_SC_BUF_BASE,0,8*sa_sc_buf_len);
  sa_sc_wpos=0;sa_sc_lpL=0;sa_sc_lpR=0;sa_sc_init=0;
  sa_target_energy=0;sa_scatter_energy=0;sa_scatter_governor=1;sa_scatter_dirty=0;
);
function sa_clear_filters() (
  sa_M_lp15=0;sa_M_lp32=0;sa_M_lp55=0;sa_S_lp15=0;sa_S_lp32=0;sa_S_lp55=0;
  memset(sa_LP_M,0,16);memset(sa_LP_S,0,16);
  sa_clear_scatter();
);
function sa_reset() (
  sa_clear_filters();
  sa_A_bodyE=0;sa_A_formE=0;sa_A_edgeE=0;sa_A_airE=0;sa_A_srcE=0;sa_M_hiE=0;sa_S_hiE=0;
  sa_A_click_fastE=0;sa_A_click_slowE=0;sa_common_dB=0;sa_side_dB=0;
  memset(sa_ENV_FAST,0,16);memset(sa_ENV_SLOW,0,16);memset(sa_ENV_LONG,0,16);
  memset(sa_ENV_PREV,0,16);memset(sa_M_ENV,0,16);memset(sa_S_ENV,0,16);
  memset(sa_ANCHOR_MEM,0,16);memset(sa_PE2_DEBT,0,16);memset(sa_CAND_PREV,0,16);
  memset(sa_CUT_CUR,0,16);memset(sa_CUT_RAW,0,16);memset(sa_SIDE_CUR,0,16);memset(sa_SIDE_RAW,0,16);
  memset(sa_ENV_DELTA,0,16);
  sa_input_energy=0;sa_core_energy=0;sa_level_gain=1;sa_limiter_gain=1;sa_source_age=0;
  sa_mix_cur=0;sa_running=0;sa_silent_samples=0;sa_idle_samples=0;sa_sleeping=0;
  sa_out_l=0;sa_out_r=0;sa_wet_l=0;sa_wet_r=0;
);
function sa_seed_controls() (
  sa_erasure_s=sa_erasure_t;sa_tame_s=sa_tame_t;sa_identity_s=sa_identity_t;sa_half_s=sa_half_t;
  sa_scatter_mix_s=sa_scatter_mix_t;sa_scatter_spread_s=sa_scatter_spread_t;sa_scatter_tail_s=sa_scatter_tail_t;
  sa_novelty_s=sa_novelty_t;sa_flash_s=sa_flash_t;sa_adaptive_s=1;sa_pe2_s=1;sa_modulation_s=1;sa_level_s=1;
);
function sa_decay_idle(sa_n) local(sa_i,sa_a,sa_b,sa_c,sa_d) (
  // Followers see zero during sleep; apply their releases once on wake.
  sa_a=pow(1-sa_aLev,sa_n);
  sa_A_bodyE*=sa_a;sa_A_formE*=sa_a;sa_A_edgeE*=sa_a;sa_A_airE*=sa_a;sa_M_hiE*=sa_a;sa_S_hiE*=sa_a;
  sa_A_srcE*=pow(1-sa_aSrc,sa_n);sa_A_click_fastE*=pow(1-sa_aFast,sa_n);sa_A_click_slowE*=pow(1-sa_aSlow,sa_n);
  sa_input_energy*=pow(1-sa_aSlow,sa_n);sa_core_energy*=pow(1-sa_aSlow,sa_n);
  sa_common_dB*=pow(sa_c_cr,sa_n);sa_side_dB*=pow(sa_c_sr,sa_n);
  sa_source_age=max(0,sa_source_age-8*sa_n);
  sa_limiter_gain=1+(sa_limiter_gain-1)*pow(1-sa_limiter_rel_a,sa_n);
  sa_a=pow(1-sa_band_fast_a,sa_n);sa_b=pow(1-sa_band_slow_a,sa_n);sa_c=pow(1-sa_band_long_a,sa_n);
  sa_i=0;
  loop(sa_NB,
    sa_mem[sa_ENV_FAST+sa_i]*=sa_a;sa_mem[sa_ENV_PREV+sa_i]=sa_mem[sa_ENV_FAST+sa_i];
    sa_mem[sa_ENV_SLOW+sa_i]*=sa_b;sa_mem[sa_ENV_LONG+sa_i]*=sa_c;sa_mem[sa_M_ENV+sa_i]*=sa_b;sa_mem[sa_S_ENV+sa_i]*=sa_b;
    sa_mem[sa_ENV_DELTA+sa_i]=0;sa_mem[sa_CAND_PREV+sa_i]=0;
    sa_i+=1;
  );
  sa_a=pow(1-sa_anchor_rel_a,sa_n);sa_b=pow(1-sa_pe2_rel_a,sa_n);sa_c=pow(1-sa_cut_rel_a,sa_n);sa_d=pow(1-sa_side_rel_a,sa_n);
  sa_i=0;
  loop(sa_NB,
    sa_mem[sa_ANCHOR_MEM+sa_i]*=sa_a;sa_mem[sa_PE2_DEBT+sa_i]*=sa_b;sa_mem[sa_CUT_CUR+sa_i]*=sa_c;sa_mem[sa_SIDE_CUR+sa_i]*=sa_d;
    sa_i+=1;
  );
);
function sa_block_params() local(sa_atkC,sa_relC,sa_atkS,sa_relS) (
  // Original core attack/release topology.
  sa_atkC=max(0.10,sa_base_atk-0.08*sa_tame_t);
  sa_relC=sa_base_rel+1.5*sa_erasure_t;
  sa_atkS=sa_base_satk;
  sa_relS=sa_base_srel+1.5*sa_erasure_t;
  sa_c_ca=exp(-1/(sa_atkC*sa_sr));
  sa_c_cr=exp(-1/(sa_relC*sa_sr));
  sa_c_sa=exp(-1/(sa_atkS*sa_sr));
  sa_c_sr=exp(-1/(sa_relS*sa_sr));

  // Adaptive anchor memory and cut smoothing.
  sa_anchor_attack_sec=max(0.055,sa_half_t*(0.24+0.32*sa_novelty_t));
  sa_anchor_release_sec=2.6+6.8*sa_identity_t+2.2*sa_half_t;
  sa_anchor_att_a=1-exp(-1/(sa_anchor_attack_sec*sa_sr));
  sa_anchor_rel_a=1-exp(-1/(sa_anchor_release_sec*sa_sr));
  sa_pe2_att_a=1-exp(-1/(max(0.20,sa_half_t*0.65)*sa_sr));
  sa_pe2_rel_a=1-exp(-1/((7.0+15.0*sa_identity_t+4.0*sa_half_t)*sa_sr));
  sa_cut_attack_sec=0.080+0.34*sa_half_t+0.24*sa_novelty_t+0.20*sa_flash_t;
  sa_cut_release_sec=3.0+7.0*sa_identity_t+2.2*sa_half_t;
  sa_cut_att_a=1-exp(-1/(sa_cut_attack_sec*sa_sr));
  sa_cut_rel_a=1-exp(-1/(sa_cut_release_sec*sa_sr));
  sa_side_att_a=1-exp(-1/((0.16+0.30*sa_novelty_t+0.20*sa_flash_t)*sa_sr));
  sa_side_rel_a=1-exp(-1/((4.0+5.0*sa_identity_t)*sa_sr));

  // Scatter topology. Delay lines are fixed per block and only audible through Scatter Mix.
  sa_spread_curve=sa_scatter_spread_t*sa_scatter_spread_t;
  sa_sc_d1L=(0.80+2.40*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d1R=(1.05+2.85*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d2L=(1.55+4.45*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d2R=(1.90+5.10*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d3L=(2.65+7.45*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d3R=(3.15+8.35*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d4L=(4.15+11.20*sa_spread_curve)*0.001*sa_sr;
  sa_sc_d4R=(4.85+12.60*sa_spread_curve)*0.001*sa_sr;
  sa_sc_fb=0.035+0.665*pow(sa_scatter_tail_t,1.25);
  sa_sc_g1=sa_sc_fb*0.64;
  sa_sc_g2=sa_sc_fb*0.76;
  sa_sc_g3=sa_sc_fb*0.88;
  sa_sc_g4=sa_sc_fb;
  sa_sc_theta=(0.06+0.34*sa_scatter_spread_t)*$pi;
  sa_sc_rot_c=cos(sa_sc_theta);
  sa_sc_rot_s=sin(sa_sc_theta);
  sa_sc_damp_fc=9500-4200*sa_scatter_tail_t;
  sa_sc_damp_a=1-exp(-2*$pi*min(sa_sc_damp_fc,sa_sr*0.42)/sa_sr);
  sa_sc_param_a=1-exp(-1/((0.090+0.260*sa_novelty_t)*sa_sr));


);
function sa_config(sa_profile_index,sa_mix) local(sa_p,sa_preset,sa_was_target) (
  sa_was_target=sa_mix_target;
  sa_p=sa_clampv(floor(sa_profile_index+0.5),1,20);
  sa_mix_target=sa_clamp01(sa_mix);
  sa_was_target>0 && sa_mix_target==0 && !sa_running ? sa_reset();
  sa_config_profile!=sa_p ? (
    sa_config_profile=sa_p;
    sa_profile_i=floor((sa_p-1)/4);
    sa_preset=sa_p-1-sa_profile_i*4;
    // Exact Anti-Salience MX v1.1.0 UI preset values (source profile is orthogonal).
    sa_preset==0 ? (
      sa_erasure_t=0.36;sa_tame_t=0.34;sa_identity_t=0.88;sa_half_t=1.100;
      sa_scatter_mix_t=0;sa_scatter_spread_t=0.35;sa_scatter_tail_t=0.10;sa_novelty_t=0.92;sa_flash_t=0.96;
    ) : sa_preset==1 ? (
      sa_erasure_t=0.68;sa_tame_t=0.48;sa_identity_t=0.72;sa_half_t=0.520;
      sa_scatter_mix_t=0;sa_scatter_spread_t=0.48;sa_scatter_tail_t=0.24;sa_novelty_t=0.84;sa_flash_t=0.92;
    ) : sa_preset==2 ? (
      sa_erasure_t=0.72;sa_tame_t=0.58;sa_identity_t=0.62;sa_half_t=0.420;
      sa_scatter_mix_t=0.32;sa_scatter_spread_t=0.62;sa_scatter_tail_t=0.38;sa_novelty_t=0.84;sa_flash_t=0.92;
    ) : (
      sa_erasure_t=0.95;sa_tame_t=0.78;sa_identity_t=0.34;sa_half_t=0.160;
      sa_scatter_mix_t=0.72;sa_scatter_spread_t=0.86;sa_scatter_tail_t=0.74;sa_novelty_t=0.72;sa_flash_t=0.88;
    );
    sa_adaptive_t=1;sa_pe2_t=1;sa_modulation_t=1;sa_level_t=1;
    sa_set_profile();
    sa_block_params();
    !sa_running ? sa_seed_controls();
  );
);
function sa_init(sa_base) (
  sa_mem=0;sa_eps=0.00000000000000000001;sa_ilog10=1/log(10);sa_NB=8;sa_NX=7;
  sa_XOVER_F=sa_base+0;
  sa_XOVER_G=sa_base+16;
  sa_LP_M=sa_base+32;
  sa_LP_S=sa_base+48;
  sa_BAND_M=sa_base+64;
  sa_BAND_S=sa_base+80;
  sa_ENV_FAST=sa_base+96;
  sa_ENV_SLOW=sa_base+112;
  sa_ENV_LONG=sa_base+128;
  sa_ENV_PREV=sa_base+144;
  sa_M_ENV=sa_base+160;
  sa_S_ENV=sa_base+176;
  sa_ANCHOR_MEM=sa_base+192;
  sa_PE2_DEBT=sa_base+208;
  sa_CAND_PREV=sa_base+224;
  sa_CUT_CUR=sa_base+240;
  sa_CUT_RAW=sa_base+256;
  sa_SIDE_CUR=sa_base+272;
  sa_SIDE_RAW=sa_base+288;
  sa_PROFILE_W=sa_base+304;
  sa_BODY_PROTECT=sa_base+320;
  sa_ENV_DELTA=sa_base+368;
  sa_SC_BUF_BASE=sa_base+384;
  sa_recalc();
  sa_fade_samples=max(1,floor(0.012*sa_sr));sa_fade_step=1/sa_fade_samples;
  sa_core_drain=max(sa_fade_samples+1,floor(0.120*sa_sr));sa_scatter_drain=max(sa_core_drain,floor(2.0*sa_sr));
  sa_config_profile=-1;sa_mix_target=0;sa_running=0;
  sa_config(2,0);
  sa_reset();
  sa_process_count=0;sa_scatter_count=0;
  sa_end=sa_SC_BUF_BASE+8*sa_sc_buf_len;
  sa_end;
);
function sa_step(sa_inL,sa_inR) (
  sa_process_count+=1;
  sa_erasure_s+=sa_control_a*(sa_erasure_t-sa_erasure_s);
  sa_tame_s+=sa_control_a*(sa_tame_t-sa_tame_s);
  sa_identity_s+=sa_control_a*(sa_identity_t-sa_identity_s);
  sa_half_s+=sa_control_a*(sa_half_t-sa_half_s);
  sa_scatter_mix_s+=sa_control_a*(sa_scatter_mix_t-sa_scatter_mix_s);
  sa_scatter_spread_s+=sa_control_a*(sa_scatter_spread_t-sa_scatter_spread_s);
  sa_scatter_tail_s+=sa_control_a*(sa_scatter_tail_t-sa_scatter_tail_s);
  sa_novelty_s+=sa_control_a*(sa_novelty_t-sa_novelty_s);
  sa_flash_s+=sa_control_a*(sa_flash_t-sa_flash_s);
  sa_adaptive_s+=sa_control_a*(sa_adaptive_t-sa_adaptive_s);
  sa_pe2_s+=sa_control_a*(sa_pe2_t-sa_pe2_s);
  sa_modulation_s+=sa_control_a*(sa_modulation_t-sa_modulation_s);
  sa_level_s+=sa_control_a*(sa_level_t-sa_level_s);

  // ---------------------------------------------------------------------------
  // LAYER 1: ORIGINAL SALIENCE PUSH CORE
  // Slow/capped, attenuation-only, broad perceptual bands. No generated signal.
  // ---------------------------------------------------------------------------
  sa_M=0.5*(sa_inL+sa_inR);
  sa_S=0.5*(sa_inL-sa_inR);

  sa_M_lp15+=sa_g15*(sa_M-sa_M_lp15);
  sa_M_lp32+=sa_g32*(sa_M-sa_M_lp32);
  sa_M_lp55+=sa_g55*(sa_M-sa_M_lp55);
  sa_S_lp15+=sa_g15*(sa_S-sa_S_lp15);
  sa_S_lp32+=sa_g32*(sa_S-sa_S_lp32);
  sa_S_lp55+=sa_g55*(sa_S-sa_S_lp55);

  sa_M_body=sa_M_lp15;
  sa_M_form=sa_M_lp32-sa_M_lp15;
  sa_M_edge=sa_M_lp55-sa_M_lp32;
  sa_M_air=sa_M-sa_M_lp55;
  sa_S_body=sa_S_lp15;
  sa_S_form=sa_S_lp32-sa_S_lp15;
  sa_S_edge=sa_S_lp55-sa_S_lp32;
  sa_S_air=sa_S-sa_S_lp55;


  sa_body_inst=sa_M_body*sa_M_body+sa_S_body*sa_S_body;
  sa_form_inst=sa_M_form*sa_M_form+sa_S_form*sa_S_form;
  sa_edge_inst=sa_M_edge*sa_M_edge+sa_S_edge*sa_S_edge;
  sa_air_inst=sa_M_air*sa_M_air+sa_S_air*sa_S_air;
  sa_src_inst=0.5*(sa_inL*sa_inL+sa_inR*sa_inR);
  sa_M_hi=sa_M_edge+sa_M_air;
  sa_S_hi=sa_S_edge+sa_S_air;
  sa_click_inst=sa_edge_inst+0.60*sa_air_inst;

  sa_A_bodyE+=sa_aLev*(sa_body_inst-sa_A_bodyE);
  sa_A_formE+=sa_aLev*(sa_form_inst-sa_A_formE);
  sa_A_edgeE+=sa_aLev*(sa_edge_inst-sa_A_edgeE);
  sa_A_airE+=sa_aLev*(sa_air_inst-sa_A_airE);
  sa_A_srcE+=sa_aSrc*(sa_src_inst-sa_A_srcE);
  sa_M_hiE+=sa_aLev*(sa_M_hi*sa_M_hi-sa_M_hiE);
  sa_S_hiE+=sa_aLev*(sa_S_hi*sa_S_hi-sa_S_hiE);
  sa_A_click_fastE+=sa_aFast*(sa_click_inst-sa_A_click_fastE);
  sa_A_click_slowE+=sa_aSlow*(sa_click_inst-sa_A_click_slowE);

  sa_A_hot_dB=10*log((0.35*sa_A_formE+1.00*sa_A_edgeE+1.10*sa_A_airE+sa_eps)/(sa_A_bodyE+0.55*sa_A_formE+sa_eps))*sa_ilog10;
  sa_A_src_dB=10*log(sa_A_srcE+sa_eps)*sa_ilog10;
  sa_delta_click_dB=10*log((sa_A_click_fastE+sa_eps)/(sa_A_click_slowE+sa_eps))*sa_ilog10;
  sa_side_hi_rel_dB=10*log((sa_S_hiE+sa_eps)/(sa_M_hiE+sa_eps))*sa_ilog10;

  sa_src_w=sa_clamp01((sa_A_src_dB+70)/18);
  sa_source_age=sa_src_w>0.08 ? min(sa_sr*6,sa_source_age+1) : max(0,sa_source_age-8);
  sa_baseline_ready=sa_clamp01(sa_source_age/(sa_sr*1.25));

  sa_self_allow=-6-5*sa_erasure_s+4*sa_identity_s+sa_pf_selfOff;
  sa_trans_allow=sa_clampv(5.5-2.5*sa_erasure_s+2.0*sa_identity_s+sa_pf_transOff,1,10);
  sa_side_allow=sa_clampv(2.5-1.5*sa_erasure_s+3.0*sa_identity_s+sa_pf_sideOff,-2,8);

  sa_max_common=sa_clampv((2.5+8.5*sa_erasure_s)*sa_pf_commonCap,0,14);
  sa_max_side=sa_clampv((1.5+5.0*sa_erasure_s)*sa_pf_sideCap*(1-0.35*sa_identity_s),0,10);
  sa_trans_w=(0.10+1.20*sa_tame_s)*sa_pf_tameBias;
  sa_side_w=(0.55+0.70*sa_erasure_s)*(1-0.50*sa_identity_s)*sa_pf_sideBias;
  sa_formW=sa_clampv((0.55-0.25*sa_identity_s)*sa_pf_formW,0.12,0.85);
  sa_edgeW=sa_clampv((0.95-0.10*sa_identity_s)*sa_pf_edgeW,0.65,1.15);
  sa_airW=sa_clampv((1.10-0.35*sa_identity_s)*sa_pf_airW,0.45,1.30);
  sa_broadW=sa_clampv((0.05+0.08*sa_erasure_s)*(1-0.35*sa_identity_s)*sa_pf_broad,0,0.20);

  sa_ex_self=max(0,sa_A_hot_dB-sa_self_allow);
  sa_ex_trans=max(0,sa_delta_click_dB-sa_trans_allow);
  sa_ex_side=max(0,sa_side_hi_rel_dB-sa_side_allow);

  sa_core_gate=sa_clamp01(sa_erasure_s*25);
  sa_level_want=sa_src_w*sa_ex_self;
  sa_common_want=min(sa_level_want+sa_src_w*(sa_trans_w*sa_ex_trans),sa_max_common)*sa_core_gate;
  sa_side_want=min(sa_src_w*(sa_side_w*sa_ex_side),sa_max_side)*sa_core_gate;

  sa_cC=sa_common_want>sa_common_dB ? sa_c_ca : sa_c_cr;
  sa_common_dB=sa_common_want+sa_cC*(sa_common_dB-sa_common_want);
  sa_cS=sa_side_want>sa_side_dB ? sa_c_sa : sa_c_sr;
  sa_side_dB=sa_side_want+sa_cS*(sa_side_dB-sa_side_want);

  sa_common_apply=sa_common_dB*sa_core_gate;
  sa_side_apply=sa_side_dB*sa_core_gate;
  sa_g_form=sa_db2amp(-(sa_common_apply*sa_formW));
  sa_g_edge=sa_db2amp(-(sa_common_apply*sa_edgeW));
  sa_g_air=sa_db2amp(-(sa_common_apply*sa_airW));
  sa_g_side=sa_db2amp(-sa_side_apply);
  sa_g_broad=sa_db2amp(-(sa_common_apply*sa_broadW));

  sa_M_form*=sa_g_form;
  sa_S_form*=sa_g_form;
  sa_M_edge*=sa_g_edge;
  sa_S_edge*=sa_g_edge*sa_g_side;
  sa_M_air*=sa_g_air;
  sa_S_air*=sa_g_air*sa_g_side;
  sa_coreM=(sa_M_body+sa_M_form+sa_M_edge+sa_M_air)*sa_g_broad;
  sa_coreS=(sa_S_body+sa_S_form+sa_S_edge+sa_S_air)*sa_g_broad;
  sa_core1L=sa_coreM+sa_coreS;
  sa_core1R=sa_coreM-sa_coreS;

  // ---------------------------------------------------------------------------
  // LAYER 2: ADAPTIVE SURVIVING-ANCHOR TAX
  // Eight-band attenuation-only analysis performed after the original core.
  // ---------------------------------------------------------------------------
  sa_coreM=0.5*(sa_core1L+sa_core1R);
  sa_coreS=0.5*(sa_core1L-sa_core1R);
  sa_prevLP_M=0;
  sa_prevLP_S=0;
  sa_total_fast=0;
  sa_total_slow=0;
  sa_total_long=0;
  sa_sum_delta=0;
  sa_sum_abs_delta=0;

  sa_i=0;
  loop(sa_NX,
    sa_lpM=sa_mem[sa_LP_M+sa_i]+sa_mem[sa_XOVER_G+sa_i]*(sa_coreM-sa_mem[sa_LP_M+sa_i]);
    sa_lpS=sa_mem[sa_LP_S+sa_i]+sa_mem[sa_XOVER_G+sa_i]*(sa_coreS-sa_mem[sa_LP_S+sa_i]);
    sa_mem[sa_LP_M+sa_i]=sa_lpM;
    sa_mem[sa_LP_S+sa_i]=sa_lpS;
    sa_bM=sa_lpM-sa_prevLP_M;
    sa_bS=sa_lpS-sa_prevLP_S;
    sa_mem[sa_BAND_M+sa_i]=sa_bM;
    sa_mem[sa_BAND_S+sa_i]=sa_bS;
    sa_prevLP_M=sa_lpM;
    sa_prevLP_S=sa_lpS;
    sa_i+=1;
  );
  sa_mem[sa_BAND_M+sa_NB-1]=sa_coreM-sa_prevLP_M;
  sa_mem[sa_BAND_S+sa_NB-1]=sa_coreS-sa_prevLP_S;

  sa_i=0;
  loop(sa_NB,
    sa_bM=sa_mem[sa_BAND_M+sa_i];
    sa_bS=sa_mem[sa_BAND_S+sa_i];
    sa_inst=sa_bM*sa_bM+sa_bS*sa_bS;
    sa_ef=sa_mem[sa_ENV_FAST+sa_i]+sa_band_fast_a*(sa_inst-sa_mem[sa_ENV_FAST+sa_i]);
    sa_es=sa_mem[sa_ENV_SLOW+sa_i]+sa_band_slow_a*(sa_inst-sa_mem[sa_ENV_SLOW+sa_i]);
    sa_el=sa_mem[sa_ENV_LONG+sa_i]+sa_band_long_a*(sa_inst-sa_mem[sa_ENV_LONG+sa_i]);
    sa_delta=sa_ef-sa_mem[sa_ENV_PREV+sa_i];
    sa_mem[sa_ENV_FAST+sa_i]=sa_ef;
    sa_mem[sa_ENV_SLOW+sa_i]=sa_es;
    sa_mem[sa_ENV_LONG+sa_i]=sa_el;
    sa_mem[sa_ENV_PREV+sa_i]=sa_ef;
    sa_mem[sa_ENV_DELTA+sa_i]=sa_delta;
    sa_mem[sa_M_ENV+sa_i]+=sa_band_slow_a*(sa_bM*sa_bM-sa_mem[sa_M_ENV+sa_i]);
    sa_mem[sa_S_ENV+sa_i]+=sa_band_slow_a*(sa_bS*sa_bS-sa_mem[sa_S_ENV+sa_i]);
    sa_total_fast+=sa_ef;
    sa_total_slow+=sa_es;
    sa_total_long+=sa_el;
    sa_sum_delta+=sa_delta;
    sa_sum_abs_delta+=abs(sa_delta);
    sa_i+=1;
  );

  sa_global_ratio_db=10*log((sa_total_fast+sa_eps)/(sa_total_slow+sa_eps))*sa_ilog10;
  sa_onset_metric=sa_clamp01((sa_global_ratio_db-0.7)/7.0)*sa_src_w;
  sa_common_mod=sa_sum_abs_delta>sa_eps ? sa_clamp01(abs(sa_sum_delta)/(sa_sum_abs_delta+sa_eps))*sa_src_w : 0;

  sa_raw_target_sum=0;

  sa_i=0;
  loop(sa_NB,
    sa_es=sa_mem[sa_ENV_SLOW+sa_i];
    sa_ef=sa_mem[sa_ENV_FAST+sa_i];
    sa_el=sa_mem[sa_ENV_LONG+sa_i];
    sa_prevE=sa_i>0 ? sa_mem[sa_ENV_SLOW+sa_i-1] : sa_mem[sa_ENV_SLOW+sa_i+1];
    sa_nextE=sa_i<sa_NB-1 ? sa_mem[sa_ENV_SLOW+sa_i+1] : sa_mem[sa_ENV_SLOW+sa_i-1];
    sa_neigh=sa_i>0&&sa_i<sa_NB-1 ? sqrt(max(sa_eps,sa_prevE*sa_nextE)) : 0.5*(sa_prevE+sa_nextE);
    sa_local_db=10*log((sa_es+sa_eps)/(sa_neigh+sa_eps))*sa_ilog10;
    sa_local_score=sa_clamp01((sa_local_db-1.0)/8.5);
    sa_share=sa_es/(sa_total_slow+sa_eps);
    sa_share_score=sa_clamp01((sa_share*sa_NB-0.82)/2.35);
    sa_rel_ratio=(sa_es/(sa_el+sa_eps))/(sa_total_slow/(sa_total_long+sa_eps)+sa_eps);
    sa_rel_db=10*log(max(sa_eps,sa_rel_ratio))*sa_ilog10;
    sa_rel_score=sa_clamp01((sa_rel_db-0.7)/7.5)*sa_baseline_ready;
    sa_spec_score=sa_clamp01(0.46*sa_local_score+0.34*sa_share_score+0.20*sa_rel_score);

    sa_trans_db=10*log((sa_ef+sa_eps)/(sa_es+sa_eps))*sa_ilog10;
    sa_trans_threshold=4.8-3.0*sa_tame_s;
    sa_trans_score=sa_clamp01((sa_trans_db-sa_trans_threshold)/7.0)*sa_tame_s;

    sa_delta=sa_mem[sa_ENV_DELTA+sa_i];
    sa_contribution=sa_sum_abs_delta>sa_eps ? sa_clamp01(abs(sa_delta)/(sa_sum_abs_delta+sa_eps)*sa_NB) : 0;
    sa_mod_score=sa_common_mod*sa_contribution*sa_modulation_s;

    sa_mE=sa_mem[sa_M_ENV+sa_i];
    sa_sE=sa_mem[sa_S_ENV+sa_i];
    sa_band_side_db=10*log((sa_sE+sa_eps)/(sa_mE+sa_eps))*sa_ilog10;
    sa_side_score=sa_clamp01((sa_band_side_db-(1.0+2.5*sa_identity_s))/9.0);

    sa_peak_score=max(sa_spec_score,max(sa_trans_score,sa_mod_score));
    sa_blend_score=0.56*sa_peak_score+0.26*sa_spec_score+0.11*sa_trans_score+0.07*sa_mod_score;
    sa_prof=sa_mem[sa_PROFILE_W+sa_i];
    sa_cand=sa_clamp01(sa_blend_score*(0.62+0.55*sa_prof))*sa_src_w;

    sa_anchor=sa_mem[sa_ANCHOR_MEM+sa_i];
    sa_aa=sa_cand>sa_anchor ? sa_anchor_att_a : sa_anchor_rel_a;
    sa_anchor+=sa_aa*(sa_cand-sa_anchor);
    sa_mem[sa_ANCHOR_MEM+sa_i]=sa_anchor;

    sa_prevcand=sa_mem[sa_CAND_PREV+sa_i];
    sa_reentry=sa_cand>0.58&&sa_prevcand<=0.58;
    sa_pe_target=sa_pe2_s>0.5 ? sa_clamp01(max(0,sa_cand-0.50)*1.65+(sa_reentry?0.24:0)) : 0;
    sa_debt=sa_mem[sa_PE2_DEBT+sa_i];
    sa_pa=sa_pe_target>sa_debt ? sa_pe2_att_a : sa_pe2_rel_a;
    sa_debt+=sa_pa*(sa_pe_target-sa_debt);
    sa_mem[sa_PE2_DEBT+sa_i]=sa_debt;
    sa_mem[sa_CAND_PREV+sa_i]=sa_cand;

    sa_protect=sa_mem[sa_BODY_PROTECT+sa_i];
    sa_identity_depth=0.20+0.80*(1-sa_identity_s);
    sa_maxcut=(0.45+8.80*sa_protect*sa_prof)*sa_erasure_s*sa_identity_depth;
    sa_drive=sa_clamp01(0.18*sa_cand+0.62*sa_anchor+0.34*sa_debt*sa_pe2_s);
    sa_rawcut=sa_maxcut*sa_drive*sa_adaptive_s*sa_core_gate;
    sa_mem[sa_CUT_RAW+sa_i]=sa_rawcut;

    sa_max_side_band=(0.25+4.50*sa_protect*sa_prof)*sa_erasure_s*(0.25+0.75*(1-sa_identity_s));
    sa_rawside=sa_max_side_band*sa_side_score*sa_adaptive_s*sa_core_gate;
    sa_mem[sa_SIDE_RAW+sa_i]=sa_rawside;

    sa_raw_target_sum+=sa_rawcut;
    sa_i+=1;
  );

  sa_target_mean=sa_raw_target_sum/sa_NB;
  sa_core2L=0;
  sa_core2R=0;
  sa_targetL=0;
  sa_targetR=0;

  sa_i=0;
  loop(sa_NB,
    sa_rawcut=sa_mem[sa_CUT_RAW+sa_i];
    sa_leftcut=sa_i>0 ? sa_mem[sa_CUT_RAW+sa_i-1] : sa_rawcut;
    sa_rightcut=sa_i<sa_NB-1 ? sa_mem[sa_CUT_RAW+sa_i+1] : sa_rawcut;
    sa_neighcut=0.25*sa_leftcut+0.50*sa_rawcut+0.25*sa_rightcut;
    sa_smooth_amt=0.72*sa_novelty_s;
    sa_targetcut=sa_rawcut+(sa_neighcut-sa_rawcut)*sa_smooth_amt;

    // Flash Guard limits abrupt simultaneous broadband taxation without removing selectivity.
    sa_flash_cap=sa_target_mean*(1.65-0.55*sa_flash_s)+1.0+2.0*(1-sa_flash_s);
    sa_targetcut=min(sa_targetcut,sa_flash_cap);
    sa_cut=sa_mem[sa_CUT_CUR+sa_i];
    sa_ca=sa_targetcut>sa_cut ? sa_cut_att_a : sa_cut_rel_a;
    sa_cut+=sa_ca*(sa_targetcut-sa_cut);
    sa_mem[sa_CUT_CUR+sa_i]=sa_cut;

    sa_rawside=sa_mem[sa_SIDE_RAW+sa_i];
    sa_leftside=sa_i>0 ? sa_mem[sa_SIDE_RAW+sa_i-1] : sa_rawside;
    sa_rightside=sa_i<sa_NB-1 ? sa_mem[sa_SIDE_RAW+sa_i+1] : sa_rawside;
    sa_targetside=sa_rawside+(0.25*sa_leftside+0.50*sa_rawside+0.25*sa_rightside-sa_rawside)*(0.54*sa_novelty_s);
    sa_sidecut=sa_mem[sa_SIDE_CUR+sa_i];
    sa_sa=sa_targetside>sa_sidecut ? sa_side_att_a : sa_side_rel_a;
    sa_sidecut+=sa_sa*(sa_targetside-sa_sidecut);
    sa_mem[sa_SIDE_CUR+sa_i]=sa_sidecut;

    sa_effective_cut=sa_cut*sa_core_gate;
    sa_effective_side=sa_sidecut*sa_core_gate;
    sa_gain=sa_db2amp(-sa_effective_cut);
    sa_sidegain=sa_db2amp(-sa_effective_side);
    sa_bM=sa_mem[sa_BAND_M+sa_i]*sa_gain;
    sa_bS=sa_mem[sa_BAND_S+sa_i]*sa_gain*sa_sidegain;
    sa_bandL=sa_bM+sa_bS;
    sa_bandR=sa_bM-sa_bS;
    sa_core2L+=sa_bandL;
    sa_core2R+=sa_bandR;

    sa_cand=sa_mem[sa_CAND_PREV+sa_i];
    sa_anchor=sa_mem[sa_ANCHOR_MEM+sa_i];
    sa_debt=sa_mem[sa_PE2_DEBT+sa_i];
    sa_prof=sa_mem[sa_PROFILE_W+sa_i];
    sa_protect=sa_mem[sa_BODY_PROTECT+sa_i];
    sa_focus=sa_clamp01((0.06+0.54*sa_cand+0.50*sa_anchor+0.24*sa_debt*sa_pe2_s)*(0.42+0.58*sa_prof)*(0.22+0.78*sa_protect));
    sa_targetL+=sa_bandL*sa_focus;
    sa_targetR+=sa_bandR*sa_focus;

    sa_i+=1;
  );

  // Core-only slow level restoration. The scatter branch is never used by this detector.
  sa_input_inst=0.5*(sa_inL*sa_inL+sa_inR*sa_inR);
  sa_core_inst=0.5*(sa_core2L*sa_core2L+sa_core2R*sa_core2R);
  sa_input_energy+=sa_aSlow*(sa_input_inst-sa_input_energy);
  sa_core_energy+=sa_aSlow*(sa_core_inst-sa_core_energy);
  sa_level_target=sa_level_s>0.5&&sa_input_energy>sa_eps ? sqrt((sa_input_energy+sa_eps)/(sa_core_energy+sa_eps)) : 1;
  sa_level_target=sa_clampv(sa_level_target,0.62,1.55);
  sa_level_target=1+(sa_level_target-1)*sa_core_gate;
  sa_la=sa_level_target<sa_level_gain ? sa_level_down_a : sa_level_up_a;
  sa_level_gain+=sa_la*(sa_level_target-sa_level_gain);
  sa_level_apply=1+(sa_level_gain-1)*sa_level_s*sa_core_gate;
  sa_core2L*=sa_level_apply;
  sa_core2R*=sa_level_apply;
  sa_targetL*=sa_level_apply;
  sa_targetR*=sa_level_apply;

  // ---------------------------------------------------------------------------
  // LAYER 3: OPTIONAL SELECTIVE SCATTER
  // Only the currently targeted residue is replaced. Untargeted core remains clean.
  // Scatter Mix = 0% is an exact clean-core output morph point.
  // ---------------------------------------------------------------------------
  sa_scatter_mix_t==0 && sa_scatter_mix_s<0.000001 ? sa_scatter_mix_s=0;
  sa_scatter_mix_s>0 || sa_scatter_mix_t>0 ? (
    sa_scatter_count+=1;
    sa_scatter_dirty=1;
  sa_sc_init<0.5 ? (
    sa_sc_d1L_cur=sa_sc_d1L;sa_sc_d1R_cur=sa_sc_d1R;sa_sc_d2L_cur=sa_sc_d2L;sa_sc_d2R_cur=sa_sc_d2R;
    sa_sc_d3L_cur=sa_sc_d3L;sa_sc_d3R_cur=sa_sc_d3R;sa_sc_d4L_cur=sa_sc_d4L;sa_sc_d4R_cur=sa_sc_d4R;
    sa_sc_g1_cur=sa_sc_g1;sa_sc_g2_cur=sa_sc_g2;sa_sc_g3_cur=sa_sc_g3;sa_sc_g4_cur=sa_sc_g4;
    sa_sc_rot_c_cur=sa_sc_rot_c;sa_sc_rot_s_cur=sa_sc_rot_s;sa_sc_damp_a_cur=sa_sc_damp_a;sa_sc_init=1;
  );
  sa_sc_d1L_cur+=sa_sc_param_a*(sa_sc_d1L-sa_sc_d1L_cur);sa_sc_d1R_cur+=sa_sc_param_a*(sa_sc_d1R-sa_sc_d1R_cur);
  sa_sc_d2L_cur+=sa_sc_param_a*(sa_sc_d2L-sa_sc_d2L_cur);sa_sc_d2R_cur+=sa_sc_param_a*(sa_sc_d2R-sa_sc_d2R_cur);
  sa_sc_d3L_cur+=sa_sc_param_a*(sa_sc_d3L-sa_sc_d3L_cur);sa_sc_d3R_cur+=sa_sc_param_a*(sa_sc_d3R-sa_sc_d3R_cur);
  sa_sc_d4L_cur+=sa_sc_param_a*(sa_sc_d4L-sa_sc_d4L_cur);sa_sc_d4R_cur+=sa_sc_param_a*(sa_sc_d4R-sa_sc_d4R_cur);
  sa_sc_g1_cur+=sa_sc_param_a*(sa_sc_g1-sa_sc_g1_cur);sa_sc_g2_cur+=sa_sc_param_a*(sa_sc_g2-sa_sc_g2_cur);
  sa_sc_g3_cur+=sa_sc_param_a*(sa_sc_g3-sa_sc_g3_cur);sa_sc_g4_cur+=sa_sc_param_a*(sa_sc_g4-sa_sc_g4_cur);
  sa_sc_rot_c_cur+=sa_sc_param_a*(sa_sc_rot_c-sa_sc_rot_c_cur);sa_sc_rot_s_cur+=sa_sc_param_a*(sa_sc_rot_s-sa_sc_rot_s_cur);
  sa_sc_rot_norm=sqrt(max(sa_eps,sa_sc_rot_c_cur*sa_sc_rot_c_cur+sa_sc_rot_s_cur*sa_sc_rot_s_cur));
  sa_sc_rot_c_eff=sa_sc_rot_c_cur/sa_sc_rot_norm;sa_sc_rot_s_eff=sa_sc_rot_s_cur/sa_sc_rot_norm;
  sa_sc_damp_a_cur+=sa_sc_param_a*(sa_sc_damp_a-sa_sc_damp_a_cur);

  sa_feed_gate=sa_clamp01(sa_scatter_mix_s*50);
  sa_scatter_flash_duck=1-sa_flash_s*sa_onset_metric*0.72;
  sa_scatter_send_gain=(0.94-0.20*sa_novelty_s)*sa_scatter_flash_duck*sa_feed_gate;
  sa_scInL=sa_targetL*sa_scatter_send_gain;
  sa_scInR=sa_targetR*sa_scatter_send_gain;

  sa_sc_lpL+=sa_sc_damp_a_cur*(sa_scInL-sa_sc_lpL);
  sa_sc_lpR+=sa_sc_damp_a_cur*(sa_scInR-sa_sc_lpR);
  sa_rotL=sa_sc_rot_c_eff*sa_sc_lpL+sa_sc_rot_s_eff*sa_sc_lpR;
  sa_rotR=-sa_sc_rot_s_eff*sa_sc_lpL+sa_sc_rot_c_eff*sa_sc_lpR;

  sa_ap1L=sa_ap_process(sa_rotL,sa_SC_L1,sa_sc_d1L_cur,sa_sc_g1_cur);
  sa_ap1R=sa_ap_process(sa_rotR,sa_SC_R1,sa_sc_d1R_cur,sa_sc_g1_cur);
  sa_rot2L=sa_sc_rot_c_eff*sa_ap1L-sa_sc_rot_s_eff*sa_ap1R;
  sa_rot2R=sa_sc_rot_s_eff*sa_ap1L+sa_sc_rot_c_eff*sa_ap1R;
  sa_ap2L=sa_ap_process(sa_rot2L,sa_SC_L2,sa_sc_d2L_cur,sa_sc_g2_cur);
  sa_ap2R=sa_ap_process(sa_rot2R,sa_SC_R2,sa_sc_d2R_cur,sa_sc_g2_cur);
  sa_rot3L=sa_sc_rot_c_eff*sa_ap2L+sa_sc_rot_s_eff*sa_ap2R;
  sa_rot3R=-sa_sc_rot_s_eff*sa_ap2L+sa_sc_rot_c_eff*sa_ap2R;
  sa_ap3L=sa_ap_process(sa_rot3L,sa_SC_L3,sa_sc_d3L_cur,sa_sc_g3_cur);
  sa_ap3R=sa_ap_process(sa_rot3R,sa_SC_R3,sa_sc_d3R_cur,sa_sc_g3_cur);
  sa_rot4L=sa_sc_rot_c_eff*sa_ap3L-sa_sc_rot_s_eff*sa_ap3R;
  sa_rot4R=sa_sc_rot_s_eff*sa_ap3L+sa_sc_rot_c_eff*sa_ap3R;
  sa_diffL=sa_ap_process(sa_rot4L,sa_SC_L4,sa_sc_d4L_cur,sa_sc_g4_cur);
  sa_diffR=sa_ap_process(sa_rot4R,sa_SC_R4,sa_sc_d4R_cur,sa_sc_g4_cur);

  sa_diffM=0.5*(sa_diffL+sa_diffR);
  sa_diffS=0.5*(sa_diffL-sa_diffR)*(1+0.82*sa_scatter_spread_s);
  sa_diffL=sa_diffM+sa_diffS;
  sa_diffR=sa_diffM-sa_diffS;

  // Novelty-linked Scatter Governor: the optional return cannot quietly become
  // the new dominant object. It compares raw diffuser energy only with the
  // targeted core portion; Level Lock is not part of this loop.
  sa_target_inst=0.5*(sa_targetL*sa_targetL+sa_targetR*sa_targetR);
  sa_scatter_inst_raw=0.5*(sa_diffL*sa_diffL+sa_diffR*sa_diffR);
  sa_target_energy+=sa_aSlow*(sa_target_inst-sa_target_energy);
  sa_scatter_energy+=sa_aSlow*(sa_scatter_inst_raw-sa_scatter_energy);
  sa_scatter_allow=sa_target_energy*(0.32+0.62*(1-sa_novelty_s))+sa_eps;
  sa_scatter_govern_target=sa_scatter_energy>sa_scatter_allow ? sqrt(sa_scatter_allow/(sa_scatter_energy+sa_eps)) : 1;
  sa_scatter_govern_target=sa_clampv(sa_scatter_govern_target,0.18,1);
  sa_sg_a=sa_scatter_govern_target<sa_scatter_governor ? sa_level_down_a : sa_level_up_a;
  sa_scatter_governor+=sa_sg_a*(sa_scatter_govern_target-sa_scatter_governor);
  sa_diffL*=sa_scatter_governor;
  sa_diffR*=sa_scatter_governor;

    sa_sc_wpos+=1;
    sa_sc_wpos>=sa_sc_buf_len ? sa_sc_wpos=0;
  ) : (
    sa_scatter_dirty ? sa_clear_scatter();
    sa_diffL=0;sa_diffR=0;
  );
  sa_untargetedL=sa_core2L-sa_targetL;
  sa_untargetedR=sa_core2R-sa_targetR;
  sa_scatteredL=sa_untargetedL+sa_diffL;
  sa_scatteredR=sa_untargetedR+sa_diffR;

  // Linear replacement morph: exact clean core at 0%, governed selective
  // scatter replacement at 100%. The core itself is never delayed.
  sa_processedL=sa_core2L+(sa_scatteredL-sa_core2L)*sa_scatter_mix_s;
  sa_processedR=sa_core2R+(sa_scatteredR-sa_core2R)*sa_scatter_mix_s;

  // Containment is restricted to the processed branch. Dry mix is exact at zero.
  sa_peak=max(abs(sa_processedL),abs(sa_processedR));
  sa_desired_limit=sa_peak>0.98 ? 0.98/max(sa_peak,sa_eps) : 1;
  sa_desired_limit<sa_limiter_gain ? sa_limiter_gain=sa_desired_limit : sa_limiter_gain+=sa_limiter_rel_a*(1-sa_limiter_gain);
  sa_wet_l=sa_denorm(sa_processedL*sa_limiter_gain);
  sa_wet_r=sa_denorm(sa_processedR*sa_limiter_gain);
  sa_wet_l!=sa_wet_l ? sa_wet_l=0;
  sa_wet_r!=sa_wet_r ? sa_wet_r=0;

);
function sa_process(sa_in_l,sa_in_r) local(sa_has_input,sa_drain_limit,sa_drain_gain) (
  sa_out_l=sa_in_l;sa_out_r=sa_in_r;
  sa_mix_target>0 || sa_mix_cur>0 || sa_running ? (
    sa_has_input=max(abs(sa_in_l),abs(sa_in_r))>0.000000000001;
    sa_mix_target==0 && sa_mix_cur<=sa_fade_step ? (
      sa_reset();
      sa_out_l=sa_in_l;sa_out_r=sa_in_r;
    ) : (
      !sa_running && !sa_has_input ? (
        // Enabled but silent: no filters, detectors, scatter, or coefficient work.
        sa_sleeping ? sa_idle_samples+=1;
      ) : (
        !sa_running ? (
          sa_idle_samples>0 ? sa_decay_idle(sa_idle_samples);
          sa_idle_samples=0;sa_sleeping=0;sa_running=1;sa_silent_samples=0;
          sa_mix_cur=0;sa_seed_controls();
        );
        sa_mix_cur< sa_mix_target ? sa_mix_cur=min(sa_mix_target,sa_mix_cur+sa_fade_step) : sa_mix_cur=max(sa_mix_target,sa_mix_cur-sa_fade_step);
        sa_has_input ? sa_silent_samples=0 : sa_silent_samples+=1;
        sa_drain_limit=sa_scatter_mix_s>0.000001 || sa_scatter_mix_t>0 ? sa_scatter_drain : sa_core_drain;
        sa_step(sa_in_l,sa_in_r);
        sa_drain_gain=sa_clamp01((sa_drain_limit-sa_silent_samples)/sa_fade_samples);
        sa_out_l=sa_in_l+(sa_wet_l-sa_in_l)*sa_mix_cur*sa_drain_gain;
        sa_out_r=sa_in_r+(sa_wet_r-sa_in_r)*sa_mix_cur*sa_drain_gain;
        sa_silent_samples>=sa_drain_limit ? (
          sa_clear_filters();sa_running=0;sa_sleeping=1;sa_idle_samples=0;sa_mix_cur=0;
          sa_out_l=sa_in_l;sa_out_r=sa_in_r;
        );
      );
    );
  );
);

// Thrill for Sample v71: supplied Somatic Accent Enhancer MX v3.3.0.
// All original source-analysis, lattice, governors and generator equations retained.
// st_config(0..1) controls 0..15% additive injection. Dry path remains unity.
// No rand(), sliders, sample-pool APIs, GFX, or generated-to-source feedback.
// Place every helper in @init. Call st_block() once per audio block while running.
// st_init(base) reserves 2*(ceil(0.047*srate)+16) cells and returns first free cell.
// Disabled and drained silence execute no filters, lattice or synthesis.


function st_clamp01(st_x) (
  min(max(st_x, 0), 1);
);

function st_clamp(st_x, st_lo, st_hi) (
  min(max(st_x, st_lo), st_hi);
);

function st_softsat(st_x) (
  st_x / (1 + abs(st_x));
);

function st_lerp(st_a, st_b, st_t) (
  st_a + (st_b-st_a)*st_t;
);



function st_opportunity_score(st_e, st_ref)
  local(st_p)
(
  st_p = st_clamp01(st_e / (st_ref*0.70 + 0.000400));
  st_p * (1 - 0.55*st_p);
);

// Prefer source-connected spectral structure with actual LOCAL room around it.
// A candidate must exist in the source, but adjacent occupancy is penalized so tiny injected energy
// lands where it creates disproportionate contrast rather than merely making the loudest HF peak louder.
function st_local_contrast_score(st_e, st_leftE, st_rightE, st_ref)
  local(st_p, st_n, st_connected, st_selfRoom, st_neighborRoom, st_localRelief)
(
  st_p = st_clamp01(st_e / (st_ref*0.55 + 0.000400));
  st_n = st_clamp01((0.50*st_leftE + 0.50*st_rightE) / (st_ref*0.55 + 0.000400));
  st_connected = st_clamp01(st_p*3.10);
  st_selfRoom = st_clamp01(1 - 0.76*st_p);
  st_neighborRoom = st_clamp01(1 - 0.66*st_n);
  st_localRelief = st_clamp01(0.50 + 0.82*(st_p-st_n));
  st_connected * (0.18 + 0.42*st_selfRoom + 0.24*st_neighborRoom + 0.16*st_localRelief);
);

// Finite causal Temporal Embodiment reservoir.
// Input first becomes Edge; slower scales receive bounded consequence from the preceding scale.
// This is intentionally not four independent envelope followers receiving the same source value.
function st_te_step(st_x)
  instance(st_edge,st_bloom,st_carry,st_trace)
  local(st_bloomTarget, st_carryTarget, st_traceTarget)
(
  st_x = st_clamp01(st_x);

  st_edge += (st_x-st_edge) * (st_x > st_edge ? st_teEdgeAtk : st_teEdgeRel);
  st_edge = st_clamp01(st_edge);

  st_bloomTarget = st_clamp01(0.64*st_edge + 0.18*st_x);
  st_bloom += (st_bloomTarget-st_bloom) * (st_bloomTarget > st_bloom ? st_teBloomAtk : st_teBloomRel);
  st_bloom = st_clamp01(st_bloom);

  st_carryTarget = st_clamp01(0.58*st_bloom + 0.12*st_x);
  st_carry += (st_carryTarget-st_carry) * (st_carryTarget > st_carry ? st_teCarryAtk : st_teCarryRel);
  st_carry = st_clamp01(st_carry);

  st_traceTarget = st_clamp01(0.66*st_carry + 0.12*st_bloom);
  st_trace += (st_traceTarget-st_trace) * (st_traceTarget > st_trace ? st_teTraceAtk : st_teTraceRel);
  st_trace = st_clamp01(st_trace);
);

function st_set_bp(st_freq, st_q)
  instance(st_b0,st_b1,st_b2,st_a1,st_a2)
  local(st_w, st_c, st_sn, st_alpha, st_norm)
(
  st_freq = st_clamp(st_freq, 20, srate*0.45);
  st_q = max(st_q, 0.1);
  st_w = st_two_pi*st_freq/srate;
  st_c = cos(st_w);
  st_sn = sin(st_w);
  st_alpha = st_sn/(2*st_q);
  st_norm = 1/(1 + st_alpha);
  st_b0 = st_alpha*st_norm;
  st_b1 = 0;
  st_b2 = -st_alpha*st_norm;
  st_a1 = -2*st_c*st_norm;
  st_a2 = (1 - st_alpha)*st_norm;
);

function st_set_hp(st_freq, st_q)
  instance(st_b0,st_b1,st_b2,st_a1,st_a2)
  local(st_w, st_c, st_sn, st_alpha, st_norm)
(
  st_freq = st_clamp(st_freq, 20, srate*0.45);
  st_q = max(st_q, 0.1);
  st_w = st_two_pi*st_freq/srate;
  st_c = cos(st_w);
  st_sn = sin(st_w);
  st_alpha = st_sn/(2*st_q);
  st_norm = 1/(1 + st_alpha);
  st_b0 = ((1 + st_c)*0.5)*st_norm;
  st_b1 = -(1 + st_c)*st_norm;
  st_b2 = ((1 + st_c)*0.5)*st_norm;
  st_a1 = -2*st_c*st_norm;
  st_a2 = (1 - st_alpha)*st_norm;
);

function st_run_bq(st_x)
  instance(st_b0,st_b1,st_b2,st_a1,st_a2,st_x1,st_x2,st_y1,st_y2)
  local(st_y)
(
  st_y = st_b0*st_x + st_b1*st_x1 + st_b2*st_x2 - st_a1*st_y1 - st_a2*st_y2;
  st_x2 = st_x1;
  st_x1 = st_x;
  st_y2 = st_y1;
  st_y1 = st_y;
  st_y;
);


function st_coefficients()
(


  // Fixed source-interpretation probes. These do not move with the renderers.
  st_anBodyA.st_set_bp(230, 0.82);
  st_anBodyB.st_set_bp(320, 0.82);
  st_anBodyC.st_set_bp(427, 0.78);

  st_anDetailA.st_set_bp(707, 0.78);
  st_anDetailB.st_set_bp(890, 0.82);
  st_anDetailC.st_set_bp(1109, 0.82);
  st_anDetailD.st_set_bp(1370, 0.76);

  st_anAttackA.st_set_bp(3033, 0.78);
  st_anAttackB.st_set_bp(3669, 0.76);

  st_anShineA.st_set_bp(4430, 0.76);
  st_anShineB.st_set_bp(5340, 0.76);
  st_anShineC.st_set_bp(7725, 0.72);
  st_anShineD.st_set_bp(9277, 0.68);
  st_anShineMid.st_set_bp(6426, 0.74);
  st_anAir.st_set_bp(11133, 0.68);

  st_fastAtk = 1 - exp(-1/(0.002*srate));
  st_fastRel = 1 - exp(-1/(0.025*srate));
  st_slowAtk = 1 - exp(-1/(0.075*srate));
  st_slowRel = 1 - exp(-1/(0.230*srate));
  st_hiAtk = 1 - exp(-1/(0.004*srate));
  st_hiRel = 1 - exp(-1/(0.090*srate));

  st_zoneAtk = 1 - exp(-1/(0.018*srate));
  st_zoneRel = 1 - exp(-1/(0.145*srate));
  st_sideAtk = 1 - exp(-1/(0.020*srate));
  st_sideRel = 1 - exp(-1/(0.180*srate));

  st_rootDCcoef = 1 - exp(-1/(0.070*srate));
  st_voiceFastAtk = 1 - exp(-1/(0.006*srate));
  st_voiceFastRel = 1 - exp(-1/(0.050*srate));
  st_voiceSlowAtk = 1 - exp(-1/(0.095*srate));
  st_voiceSlowRel = 1 - exp(-1/(0.380*srate));
  st_honkAtk = 1 - exp(-1/(0.012*srate));
  st_honkRel = 1 - exp(-1/(0.180*srate));
  st_nasalAtk = 1 - exp(-1/(0.010*srate));
  st_nasalRel = 1 - exp(-1/(0.160*srate));

  st_exposureCoef = 1 - exp(-1/(8.000*srate));
  st_authorityCoef = 1 - exp(-1/(0.028*srate));
  st_microCoef = 1 - exp(-1/(0.032*srate));
  st_widthCoef = 1 - exp(-1/(0.018*srate));
  st_expandCoef = 1 - exp(-1/(0.024*srate));
  st_corrCoef = 1 - exp(-1/(0.035*srate));

  // Temporal Embodiment: Edge -> Bloom -> Carry -> Trace.
  st_teEdgeAtk = 1 - exp(-1/(0.005*srate));
  st_teEdgeRel = 1 - exp(-1/(0.080*srate));
  st_teBloomAtk = 1 - exp(-1/(0.055*srate));
  st_teBloomRel = 1 - exp(-1/(0.360*srate));
  st_teCarryAtk = 1 - exp(-1/(0.240*srate));
  st_teCarryRel = 1 - exp(-1/(2.800*srate));
  st_teTraceAtk = 1 - exp(-1/(1.100*srate));
  st_teTraceRel = 1 - exp(-1/(22.000*srate));

  // PE predicts topology; PE2 predicts the magnitude of prediction error itself.
  st_topoPredCoef = 1 - exp(-1/(0.420*srate));
  st_pePredCoef = 1 - exp(-1/(1.600*srate));

  // Familiarity spans immediate morphology through long exposure.
  st_famImmediateCoef = 1 - exp(-1/(0.380*srate));
  st_famPhraseCoef = 1 - exp(-1/(4.500*srate));
  st_famSceneCoef = 1 - exp(-1/(20.000*srate));
  st_famExposureCoef = 1 - exp(-1/(75.000*srate));
  st_reprMemCoef = 1 - exp(-1/(3.200*srate));
  st_reprExposureCoef = 1 - exp(-1/(18.000*srate));
  st_reprExposureRecoveryCoef = 1 - exp(-1/(32.000*srate));
  st_exposureRecoveryCoef = 1 - exp(-1/(18.000*srate));
  st_eventSimDecay = exp(-1/(12.000*srate));
  st_eventPeWindowDecay = exp(-1/(0.160*srate));
  st_eventPe2Decay = exp(-1/(0.420*srate));

  st_genAtk = 1 - exp(-1/(0.006*srate));
  st_genRel = 1 - exp(-1/(0.120*srate));
  st_masterAtk = 1 - exp(-1/(0.002*srate));
  st_masterRel = 1 - exp(-1/(0.160*srate));
  st_beatDecay = exp(-1/(4.000*srate));
  st_pulseDriftSmooth = 1 - exp(-1/(0.750*srate));

  st_d1 = floor(0.0033*srate);
  st_d2 = floor(0.0068*srate);
  st_d3 = floor(0.0115*srate);
  st_d4 = floor(0.0185*srate);
  st_d5 = floor(0.0310*srate);
  st_d6 = floor(0.0470*srate);


);

function st_tune()
(
  st_block_count+=1;

  st_autoAuthority = 1;
  st_tuneConfidence = st_clamp01((st_slowEnv - 0.0010) * 85);
  st_tuneMix = st_autoAuthority * st_tuneConfidence;

  st_bodyScoreA = st_opportunity_score(st_eBodyA, st_slowEnv);
  st_bodyScoreB = st_opportunity_score(st_eBodyB, st_slowEnv);
  st_bodyScoreC = st_opportunity_score(st_eBodyC, st_slowEnv);
  st_bodyBest = 0;
  st_bodyBestScore = st_bodyScoreA;
  st_bodyScoreB > st_bodyBestScore ? (st_bodyBest = 1; st_bodyBestScore = st_bodyScoreB;);
  st_bodyScoreC > st_bodyBestScore ? (st_bodyBest = 2; st_bodyBestScore = st_bodyScoreC;);
  st_bodyCurScore = st_bodySel == 0 ? st_bodyScoreA : st_bodySel == 1 ? st_bodyScoreB : st_bodyScoreC;
  st_bodyBestScore > st_bodyCurScore*1.12 && st_slowEnv > 0.0015 ? st_bodySel = st_bodyBest;
  st_bodyCandidate = st_bodySel == 0 ? 230 : st_bodySel == 1 ? 320 : 427;
  st_bodyTarget = st_lerp(285, st_bodyCandidate, st_tuneMix);
  st_bodyHz += (st_bodyTarget - st_bodyHz) * 0.10;

  st_detailScoreA = st_opportunity_score(st_eDetailA, st_slowEnv);
  st_detailScoreB = st_opportunity_score(st_eDetailB, st_slowEnv);
  st_detailScoreC = st_opportunity_score(st_eDetailC, st_slowEnv);
  st_detailScoreD = st_opportunity_score(st_eDetailD, st_slowEnv);
  st_detailBest = 0;
  st_detailBestScore = st_detailScoreA;
  st_detailScoreB > st_detailBestScore ? (st_detailBest = 1; st_detailBestScore = st_detailScoreB;);
  st_detailScoreC > st_detailBestScore ? (st_detailBest = 2; st_detailBestScore = st_detailScoreC;);
  st_detailScoreD > st_detailBestScore ? (st_detailBest = 3; st_detailBestScore = st_detailScoreD;);
  st_detailCurScore = st_detailSel == 0 ? st_detailScoreA : st_detailSel == 1 ? st_detailScoreB : st_detailSel == 2 ? st_detailScoreC : st_detailScoreD;
  st_detailBestScore > st_detailCurScore*1.12 && st_slowEnv > 0.0015 ? st_detailSel = st_detailBest;
  st_detailCandidate = st_detailSel == 0 ? 707 : st_detailSel == 1 ? 890 : st_detailSel == 2 ? 1109 : 1370;
  st_detailTarget = st_lerp(835, st_detailCandidate, st_tuneMix);
  st_phoneFocus += (st_detailTarget - st_phoneFocus) * 0.10;

  // Local-neighborhood contrast seeking: source-connected structure with adjacent spectral room wins.
  st_shimmerScoreA = st_local_contrast_score(st_eShineA, st_eAttackB, st_eShineB, st_slowEnv);
  st_shimmerScoreB = st_local_contrast_score(st_eShineB, st_eShineA, st_eShineMid, st_slowEnv);
  st_shimmerScoreC = st_local_contrast_score(st_eShineC, st_eShineMid, st_eShineD, st_slowEnv);
  st_shimmerScoreD = st_local_contrast_score(st_eShineD, st_eShineC, st_eAir, st_slowEnv);
  st_shimmerBest = 0;
  st_shimmerBestScore = st_shimmerScoreA;
  st_shimmerScoreB > st_shimmerBestScore ? (st_shimmerBest = 1; st_shimmerBestScore = st_shimmerScoreB;);
  st_shimmerScoreC > st_shimmerBestScore ? (st_shimmerBest = 2; st_shimmerBestScore = st_shimmerScoreC;);
  st_shimmerScoreD > st_shimmerBestScore ? (st_shimmerBest = 3; st_shimmerBestScore = st_shimmerScoreD;);
  st_shimmerCurScore = st_shimmerSel == 0 ? st_shimmerScoreA : st_shimmerSel == 1 ? st_shimmerScoreB : st_shimmerSel == 2 ? st_shimmerScoreC : st_shimmerScoreD;
  st_shimmerBestScore > st_shimmerCurScore*1.14 && st_slowEnv > 0.0015 ? st_shimmerSel = st_shimmerBest;
  st_shimmerCandidate = st_shimmerSel == 0 ? 4430 : st_shimmerSel == 1 ? 5340 : st_shimmerSel == 2 ? 7725 : 9277;
  st_shimmerTarget = st_lerp(5340, st_shimmerCandidate, st_tuneMix);
  st_shimmerHz += (st_shimmerTarget - st_shimmerHz) * 0.08;
  st_shimmerContrast = st_shimmerBestScore;

  // Renderer coefficients are updated lazily once per audio block.
  // AUTO=0 reproduces the proven keeper point. With AUTO active, the event can briefly expand:
  // the body anchor nudges downward while the shimmer family opens upward, then both return home.
  st_bodyRenderHz = st_bodyHz * (1 - 0.036*st_autoAuthority*st_spectralExpand);
  st_shimmerRenderHz = st_shimmerHz * (1 + 0.058*st_autoAuthority*st_spectralExpand);
  st_bodyQ = st_clamp(0.90 + st_autoAuthority*(0.20*(1-st_sustainEvidence) + 0.10*st_bodyPresence - 0.08), 0.72, 1.22);
  st_body1L.st_set_bp(st_bodyRenderHz, st_bodyQ);
  st_body1R.st_set_bp(st_bodyRenderHz, st_bodyQ);
  st_body2L.st_set_bp(st_clamp(st_bodyRenderHz*1.22, 210, 560), max(st_bodyQ*0.85, 0.35));
  st_body2R.st_set_bp(st_clamp(st_bodyRenderHz*1.22, 210, 560), max(st_bodyQ*0.85, 0.35));

  st_biteL.st_set_bp(st_clamp(st_phoneFocus*4.00, 2800, 4300), 0.90);
  st_biteR.st_set_bp(st_clamp(st_phoneFocus*4.00, 2800, 4300), 0.90);

  st_sh1L.st_set_bp(st_shimmerRenderHz, 0.85);
  st_sh1R.st_set_bp(st_shimmerRenderHz, 0.85);
  st_sh2L.st_set_bp(st_clamp(st_shimmerRenderHz*1.45, 3500, 14500), 0.75);
  st_sh2R.st_set_bp(st_clamp(st_shimmerRenderHz*1.45, 3500, 14500), 0.75);
  st_sh3L.st_set_bp(st_clamp(st_shimmerRenderHz*1.74, 4500, 18000), 0.70);
  st_sh3R.st_set_bp(st_clamp(st_shimmerRenderHz*1.74, 4500, 18000), 0.70);
  st_guardL.st_set_hp(7600, 0.707);
  st_guardR.st_set_hp(7600, 0.707);

  st_resRootHz = st_clamp(st_bodyRenderHz/5.95, 36, 68);
  st_rootM.st_set_bp(st_resRootHz, 4.20);
  st_res4M.st_set_bp(st_clamp(st_resRootHz*4.00, 150, 320), 1.05);
  st_res5M.st_set_bp(st_clamp(st_resRootHz*4.85, 190, 370), 0.92);
  st_res7M.st_set_bp(st_clamp(st_resRootHz*7.00, 250, 540), 0.86);
  st_res8M.st_set_bp(st_clamp(st_resRootHz*8.10, 290, 650), 0.82);
  st_res12M.st_set_bp(st_clamp(st_resRootHz*11.60, 400, 820), 0.72);
  st_res15M.st_set_bp(st_clamp(st_resRootHz*14.80, 520, 980), 0.68);

  st_formantSpread = st_clamp(0.95 + st_autoAuthority*(0.16*st_sustainEvidence - 0.18*st_detailPresence), 0.72, 1.18);
  st_vq = st_clamp(1 / max(st_formantSpread, 0.10), 0.55, 2.35);
  st_vlLowM.st_set_bp(st_clamp(st_phoneFocus*0.34, 230, 390), 0.78*st_vq);
  st_vlBridgeM.st_set_bp(st_clamp(st_phoneFocus*0.54, 350, 640), 0.84*st_vq);
  st_vlWarmM.st_set_bp(st_clamp(st_phoneFocus*0.68, 430, 760), 0.90*st_vq);
  st_vlMeat1M.st_set_bp(st_clamp(st_phoneFocus*0.88, 560, 980), 1.00*st_vq);
  st_vlMeat2M.st_set_bp(st_clamp(st_phoneFocus, 630, 1450), 1.06*st_vq);
  st_vlMeat3M.st_set_bp(st_clamp(st_phoneFocus*1.11, 720, 1600), 0.96*st_vq);
  st_vlPres1M.st_set_bp(st_clamp(st_phoneFocus*1.39, 900, 1900), 0.74*st_vq);
  st_vlPres2M.st_set_bp(st_clamp(st_phoneFocus*1.56, 1000, 2200), 0.68*st_vq);
  st_vlBiteM.st_set_bp(st_clamp(st_phoneFocus*2.03, 1350, 2800), 0.60*st_vq);

  st_vlSideMeatM.st_set_bp(st_clamp(st_phoneFocus, 630, 1450), 0.90*st_vq);
  st_vlSidePresM.st_set_bp(st_clamp(st_phoneFocus*1.39, 900, 1900), 0.66*st_vq);

  st_vlSnapM.st_set_bp(st_clamp(st_phoneFocus*4.35, 2600, 4700), 0.82);
  st_vlSnap2M.st_set_bp(st_clamp(st_phoneFocus*5.20, 3300, 5900), 0.74);
  st_vlSheenL.st_set_bp(st_clamp(st_phoneFocus*5.60, 3600, 6500), 0.72);
  st_vlSheenR.st_set_bp(st_clamp(st_phoneFocus*5.60, 3600, 6500), 0.72);
  st_vlSheen2L.st_set_bp(st_clamp(st_phoneFocus*6.35, 4300, 7700), 0.68);
  st_vlSheen2R.st_set_bp(st_clamp(st_phoneFocus*6.35, 4300, 7700), 0.68);

  st_honkM.st_set_bp(st_clamp(st_phoneFocus*0.98, 620, 1450), 0.58);
  st_nasalM.st_set_bp(st_clamp(st_phoneFocus*1.55, 950, 2200), 0.58);
  st_nasal2M.st_set_bp(st_clamp(st_phoneFocus*2.03, 1400, 3000), 0.62);


);

function st_clear_audio()
(
  memset(st_bufL, 0, 2*st_delaySize);
  st_dpos=0;
  st_anAir.st_x1=0; st_anAir.st_x2=0; st_anAir.st_y1=0; st_anAir.st_y2=0;
  st_anAttackA.st_x1=0; st_anAttackA.st_x2=0; st_anAttackA.st_y1=0; st_anAttackA.st_y2=0;
  st_anAttackB.st_x1=0; st_anAttackB.st_x2=0; st_anAttackB.st_y1=0; st_anAttackB.st_y2=0;
  st_anBodyA.st_x1=0; st_anBodyA.st_x2=0; st_anBodyA.st_y1=0; st_anBodyA.st_y2=0;
  st_anBodyB.st_x1=0; st_anBodyB.st_x2=0; st_anBodyB.st_y1=0; st_anBodyB.st_y2=0;
  st_anBodyC.st_x1=0; st_anBodyC.st_x2=0; st_anBodyC.st_y1=0; st_anBodyC.st_y2=0;
  st_anDetailA.st_x1=0; st_anDetailA.st_x2=0; st_anDetailA.st_y1=0; st_anDetailA.st_y2=0;
  st_anDetailB.st_x1=0; st_anDetailB.st_x2=0; st_anDetailB.st_y1=0; st_anDetailB.st_y2=0;
  st_anDetailC.st_x1=0; st_anDetailC.st_x2=0; st_anDetailC.st_y1=0; st_anDetailC.st_y2=0;
  st_anDetailD.st_x1=0; st_anDetailD.st_x2=0; st_anDetailD.st_y1=0; st_anDetailD.st_y2=0;
  st_anShineA.st_x1=0; st_anShineA.st_x2=0; st_anShineA.st_y1=0; st_anShineA.st_y2=0;
  st_anShineB.st_x1=0; st_anShineB.st_x2=0; st_anShineB.st_y1=0; st_anShineB.st_y2=0;
  st_anShineC.st_x1=0; st_anShineC.st_x2=0; st_anShineC.st_y1=0; st_anShineC.st_y2=0;
  st_anShineD.st_x1=0; st_anShineD.st_x2=0; st_anShineD.st_y1=0; st_anShineD.st_y2=0;
