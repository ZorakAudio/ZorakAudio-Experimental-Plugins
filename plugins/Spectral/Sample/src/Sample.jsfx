// Sleep does not run the nonlinear lattice. On wake its finite reservoirs decay
// once, while familiarity/exposure debts use their original exponential times.
// The independent reservoir decay is an intentional idle-only approximation;
// active-source causal Edge -> Bloom -> Carry -> Trace is unchanged.
function st_te_sleep(st_seconds)
instance(st_edge,st_bloom,st_carry,st_trace)
(
  st_edge *= exp(-st_seconds/0.080);
  st_bloom *= exp(-st_seconds/0.360);
  st_carry *= exp(-st_seconds/2.800);
  st_trace *= exp(-st_seconds/22.000);
);

function st_recover_sleep()
local(st_gap_seconds,st_gap_frames,st_decay,st_share)
(
  st_gap_frames=st_sleep_samples;
  st_gap_seconds=st_gap_frames/srate;
  st_teContinuity.st_te_sleep(st_gap_seconds);
  st_teField.st_te_sleep(st_gap_seconds);
  st_teImpulse.st_te_sleep(st_gap_seconds);
  st_teMass.st_te_sleep(st_gap_seconds);
  st_teSheen.st_te_sleep(st_gap_seconds);
  st_teTexture.st_te_sleep(st_gap_seconds);
  st_famImmediate *= exp(-st_gap_seconds/0.380);
  st_famPhrase *= exp(-st_gap_seconds/4.500);
  st_famScene *= exp(-st_gap_seconds/20.000);
  st_famExposure *= exp(-st_gap_seconds/75.000);
  st_decay=exp(-st_gap_seconds/32.000);
  st_reprMassExp=0.333333+(st_reprMassExp-0.333333)*st_decay;
  st_reprContactExp=0.333333+(st_reprContactExp-0.333333)*st_decay;
  st_reprFluidExp=0.333333+(st_reprFluidExp-0.333333)*st_decay;
  st_decay=exp(-st_gap_seconds/3.200);
  st_share=st_reprMode==0;
  st_reprMassMem=st_share+(st_reprMassMem-st_share)*st_decay;
  st_share=st_reprMode==1;
  st_reprContactMem=st_share+(st_reprContactMem-st_share)*st_decay;
  st_share=st_reprMode==2;
  st_reprFluidMem=st_share+(st_reprFluidMem-st_share)*st_decay;
  st_decay=exp(-st_gap_seconds/18.000);
  st_expBody=0.15+(st_expBody-0.15)*st_decay;
  st_expResidue=0.07+(st_expResidue-0.07)*st_decay;
  st_expDetail=0.09+(st_expDetail-0.09)*st_decay;
  st_expSnap=0.12+(st_expSnap-0.12)*st_decay;
  st_expShimmer=0.37+(st_expShimmer-0.37)*st_decay;
  st_expFluid=0.20+(st_expFluid-0.20)*st_decay;
  st_eventSimilarity *= exp(-max(0,st_gap_frames-max(0,2*srate-(st_sampleClock-st_lastOnsetSample)))/srate/12);
  st_eventPeWindow *= exp(-st_gap_seconds/0.160);
  st_eventPe2State *= exp(-st_gap_seconds/0.420);
  st_beatConf *= exp(-st_gap_seconds/4.000);
  st_sampleClock += st_gap_frames;
  st_reprAgeSamples += st_gap_frames;
  st_sleep_samples=0;
  st_clear_audio();
);

