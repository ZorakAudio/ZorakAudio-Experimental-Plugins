                );
                gdry_rem = gb[VG_DRYRATE] < 0 ? max(0, dry_srcp) : max(0, gframes - 1 - dry_srcp);
                gdry_fade = clamp01(gdry_rem / max(1, gendfade_src));
                gdry_fade = gdry_fade * gdry_fade * (3 - 2 * gdry_fade);
