                granular_voice ? ( win_flat *= (1 - 0.88 * edge_melt_amt); );
                wbase = granular_voice ? stretch_window_morph(age, gsize, win_flat) : stretch_window(age, gsize);
                granular_voice && edge_melt_amt > 0.0001 ? (
                  wn = clamp01(age / max(1, gsize - 1));
