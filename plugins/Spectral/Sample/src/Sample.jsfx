  st_widthGesture=0;
  st_widthTarget=0;
  st_wrapRaw=0;
  st_xL=0;
  st_xR=0;
  st_zoneAtk=0;
  st_zoneRel=0;

  st_dpos = 0;

  st_phase = 0;
  st_driftPhaseA = 0.41;
  st_driftPhaseB = 2.17;
  st_pulseDriftSm = 0;
  st_pulseHzNow = 0;

  st_fastEnv = 0;
  st_slowEnv = 0;
  st_hiEnv = 0;
  st_rootDC = 0;
  st_sideEnv = 0;
  st_monoEnv = 0;
  st_genEnv = 0;

  st_eBodyA = 0;
  st_eBodyB = 0;
  st_eBodyC = 0;
  st_eDetailA = 0;
  st_eDetailB = 0;
  st_eDetailC = 0;
  st_eDetailD = 0;
  st_eAttackA = 0;
  st_eAttackB = 0;
  st_eShineA = 0;
  st_eShineB = 0;
  st_eShineC = 0;
  st_eShineD = 0;
  st_eShineMid = 0;
  st_eAir = 0;

  st_voiceFastEnv = 0;
  st_voiceSlowEnv = 0;
  st_honkEnv = 0;
  st_nasalEnv = 0;

  st_catGuard = 1;
  st_masterGov = 1;
  st_honkProtect = 1;
  st_nasalProtect = 1;

  // Shimmer-first prior: the old v2.6 signature is the home position, not six equal lanes.
  st_expBody = 0.150000;
  st_expResidue = 0.070000;
  st_expDetail = 0.090000;
  st_expSnap = 0.120000;
  st_expShimmer = 0.370000;
  st_expFluid = 0.200000;

  st_wBody = 0.150000;
  st_wResidue = 0.070000;
  st_wDetail = 0.090000;
  st_wSnap = 0.120000;
  st_wShimmer = 0.370000;
  st_wFluid = 0.200000;

  st_shW1 = 1.000000;
  st_shW2 = 0.720000;
  st_shW3 = 0.480000;
  st_widthGesture = 0;
  st_stereoOpportunity = 0;
  st_shimmerContrast = 0;
  st_spectralExpand = 0;

  // v3.3 four-act choreography state.
  st_actFlash = 0;
  st_actBloom = 0;
  st_actWrap = 0;
  st_actAfter = 0;

  // Correlation / mono-survival state. These are safety observers only.
  st_srcPowL = 0;
  st_srcPowR = 0;
  st_srcCross = 0;
  st_srcCorr = 1;
  st_genPowL = 0;
  st_genPowR = 0;
  st_genCross = 0;
  st_genMidPow = 0;
  st_genSidePow = 0;
  st_genCorr = 1;
  st_monoSurvival = 1;
  st_stereoSafety = 1;

  st_bodyPresence = 0;
  st_detailPresence = 0;
  st_attackPresence = 0;
  st_shinePresence = 0;
  st_airPresence = 0;
  st_sideEvidence = 0;
  st_sustainEvidence = 0;
  st_impactEvidence = 0;
  st_quietSense = 1;

  st_bodySel = 1;
  st_detailSel = 1;
  st_shimmerSel = 1;
  st_bodyHz = 285;
  st_phoneFocus = 835;
  st_shimmerHz = 5340;

  st_sampleClock = 0;
  st_lastOnsetSample = -1000000;
  st_prevInterval = 0;
  st_beatHz = 0;
  st_beatConf = 0;
  st_prevImpactGate = 0;

  // ---- v3.1 anti-habituation lattice state ----
  // Temporal Embodiment instances use namespace-local edge/bloom/carry/trace cells.
  st_teEdgeAvg = 0;
  st_teBloomAvg = 0;
  st_teCarryAvg = 0;
  st_teTraceAvg = 0;

  st_topoEvent = 0;
  st_topoSurface = 0;
  st_topoField = 0;
  st_topoTrace = 0;

  st_predTopoEvent = 0;
  st_predTopoSurface = 0;
  st_predTopoField = 0;
  st_predTopoTrace = 0;
  st_predPeEvent = 0;
  st_predPeSurface = 0;
  st_predPeField = 0;
  st_predPeTrace = 0;
  st_pe1Global = 0;
  st_pe2Global = 0;

  st_lastEventTopoEvent = 0;
  st_lastEventTopoSurface = 0;
  st_lastEventTopoField = 0;
  st_lastEventTopoTrace = 0;
  st_eventSimilarity = 0;
  st_eventCount = 0;
  st_eventPePred = 0;
  st_eventPe2State = 1;
  st_eventPeWindow = 0;
  st_pe2Effective = 1;

  st_famImmediate = 0;
  st_famPhrase = 0;
  st_famScene = 0;
  st_famExposure = 0;
  st_familiarity = 0;
  st_freshnessPressure = 0;

  // Reused state names now track DENSE / SILKY / SPARK microstructure memory.
  st_reprMassMem = 1.000000;
  st_reprContactMem = 0.000000;
  st_reprFluidMem = 0.000000;
  st_reprMassExp = 0.333333;
  st_reprContactExp = 0.333333;
  st_reprFluidExp = 0.333333;
  st_reprStability = 1;
  st_reprMode = 0;
  st_reprAgeSamples = 0;
  st_reinterpretPending = 1;
  st_interpCounter = 0;

  st_latBody = 0;
  st_latResidue = 0;
  st_latDetail = 0;
  st_latSnap = 0;
  st_latShimmer = 0;
  st_latFluid = 0;



  st_teContinuity.st_edge=0; st_teContinuity.st_bloom=0; st_teContinuity.st_carry=0; st_teContinuity.st_trace=0;
  st_teField.st_edge=0; st_teField.st_bloom=0; st_teField.st_carry=0; st_teField.st_trace=0;
  st_teImpulse.st_edge=0; st_teImpulse.st_bloom=0; st_teImpulse.st_carry=0; st_teImpulse.st_trace=0;
  st_teMass.st_edge=0; st_teMass.st_bloom=0; st_teMass.st_carry=0; st_teMass.st_trace=0;
  st_teSheen.st_edge=0; st_teSheen.st_bloom=0; st_teSheen.st_carry=0; st_teSheen.st_trace=0;
  st_teTexture.st_edge=0; st_teTexture.st_bloom=0; st_teTexture.st_carry=0; st_teTexture.st_trace=0;
  st_clear_audio();
  st_coefficients();
  st_tune();
  st_ready=1;
  st_current_amount=0; st_ramp_left=0; st_running=0;
  st_sleep_samples=0; st_idle_samples=0; st_quiet_count=0;
  st_had_source=0; st_forced_idle=0;
  st_out_l=0; st_out_r=0;
);

function st_init(st_base_address)
(
  st_two_pi=2*$pi;
  st_delaySize=max(64,ceil(0.047*srate)+16);
  st_bufL=floor(st_base_address);
  st_bufR=st_bufL+st_delaySize;
  st_amount=0; st_current_amount=0; st_running=0; st_ready=0;
  st_process_count=0; st_block_count=0;
  st_sleep_samples=0; st_idle_samples=0; st_quiet_count=0;
  st_had_source=0; st_forced_idle=0; st_ramp_left=0;
  st_ramp_samples=max(1,ceil(0.012*srate));
  st_quiet_window=max(64,ceil(0.003*srate));
  st_out_l=0; st_out_r=0;
  st_bufR+st_delaySize;
);

function st_config(st_new_amount)
local(st_next_amount)
(
  st_next_amount=min(1,max(0,st_new_amount));
  st_next_amount!=st_amount ? (
    st_next_amount>0 && !st_ready ? st_reset();
    st_amount=st_next_amount;
    st_running ? (
      st_ramp_left=st_ramp_samples;
      st_running=1;
    );
  );
);

function st_block()
(
  st_running ? (
    st_tune();
  );
);

function st_render(st_input_l,st_input_r)
(

  st_dryL = st_input_l;
  st_dryR = st_input_r;
  st_xL = st_dryL;
  st_xR = st_dryR;
  st_mono = 0.5*(st_xL + st_xR);
  st_side = 0.5*(st_xL - st_xR);
  st_sampleClock += 1;

  // Short-window source correlation. This never changes source evidence; it only constrains
  // how aggressively the GENERATED accent is allowed to erupt sideways.
  st_srcPowL += (st_xL*st_xL-st_srcPowL) * st_corrCoef;
  st_srcPowR += (st_xR*st_xR-st_srcPowR) * st_corrCoef;
  st_srcCross += (st_xL*st_xR-st_srcCross) * st_corrCoef;
  st_srcCorr = st_clamp(st_srcCross / sqrt(st_srcPowL*st_srcPowR + 0.000000001), -1, 1);

  st_injection = st_current_amount * 0.15;
  st_autoAuthority = 1;

  st_amp = max(abs(st_xL), abs(st_xR));
  st_fastEnv += (st_amp - st_fastEnv) * (st_amp > st_fastEnv ? st_fastAtk : st_fastRel);
  st_slowEnv += (st_amp - st_slowEnv) * (st_amp > st_slowEnv ? st_slowAtk : st_slowRel);
  st_tr = st_clamp((st_fastEnv - st_slowEnv) / (st_slowEnv + 0.006), 0, 2.0);
  st_impactGate = st_clamp01(st_tr*0.75);
  st_impactEvidence = st_clamp01(st_tr*0.68);
  st_sustainEvidence = st_clamp01(1 - st_tr*0.56);
  st_quietSense = st_clamp01((0.050 - st_slowEnv) / 0.045);

  st_monoAbs = abs(st_mono);
  st_sideAbs = abs(st_side);
  st_monoEnv += (st_monoAbs - st_monoEnv) * (st_monoAbs > st_monoEnv ? st_sideAtk : st_sideRel);
  st_sideEnv += (st_sideAbs - st_sideEnv) * (st_sideAbs > st_sideEnv ? st_sideAtk : st_sideRel);
  st_sideEvidence = st_clamp01(st_sideEnv / (st_monoEnv + st_sideEnv + 0.000300));

  st_p = abs(st_anBodyA.st_run_bq(st_mono));
  st_eBodyA += (st_p - st_eBodyA) * (st_p > st_eBodyA ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anBodyB.st_run_bq(st_mono));
  st_eBodyB += (st_p - st_eBodyB) * (st_p > st_eBodyB ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anBodyC.st_run_bq(st_mono));
  st_eBodyC += (st_p - st_eBodyC) * (st_p > st_eBodyC ? st_zoneAtk : st_zoneRel);

  st_p = abs(st_anDetailA.st_run_bq(st_mono));
  st_eDetailA += (st_p - st_eDetailA) * (st_p > st_eDetailA ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anDetailB.st_run_bq(st_mono));
  st_eDetailB += (st_p - st_eDetailB) * (st_p > st_eDetailB ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anDetailC.st_run_bq(st_mono));
  st_eDetailC += (st_p - st_eDetailC) * (st_p > st_eDetailC ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anDetailD.st_run_bq(st_mono));
  st_eDetailD += (st_p - st_eDetailD) * (st_p > st_eDetailD ? st_zoneAtk : st_zoneRel);

  st_p = abs(st_anAttackA.st_run_bq(st_mono));
  st_eAttackA += (st_p - st_eAttackA) * (st_p > st_eAttackA ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anAttackB.st_run_bq(st_mono));
  st_eAttackB += (st_p - st_eAttackB) * (st_p > st_eAttackB ? st_zoneAtk : st_zoneRel);

  st_p = abs(st_anShineA.st_run_bq(st_mono));
  st_eShineA += (st_p - st_eShineA) * (st_p > st_eShineA ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anShineB.st_run_bq(st_mono));
  st_eShineB += (st_p - st_eShineB) * (st_p > st_eShineB ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anShineC.st_run_bq(st_mono));
  st_eShineC += (st_p - st_eShineC) * (st_p > st_eShineC ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anShineD.st_run_bq(st_mono));
  st_eShineD += (st_p - st_eShineD) * (st_p > st_eShineD ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anShineMid.st_run_bq(st_mono));
  st_eShineMid += (st_p - st_eShineMid) * (st_p > st_eShineMid ? st_zoneAtk : st_zoneRel);
  st_p = abs(st_anAir.st_run_bq(st_mono));
  st_eAir += (st_p - st_eAir) * (st_p > st_eAir ? st_zoneAtk : st_zoneRel);

  st_sourceRef = st_slowEnv + 0.000700;
  st_bodyPresence = st_clamp01((st_eBodyA + st_eBodyB + st_eBodyC) * 0.70 / st_sourceRef);
  st_detailPresence = st_clamp01((st_eDetailA + st_eDetailB + st_eDetailC + st_eDetailD) * 0.48 / st_sourceRef);
  st_attackPresence = st_clamp01((st_eAttackA + st_eAttackB) * 0.78 / st_sourceRef);
  st_shinePresence = st_clamp01((st_eShineA + st_eShineB + st_eShineMid + st_eShineC + st_eShineD) * 0.44 / st_sourceRef);
  st_airPresence = st_clamp01(st_eAir * 0.95 / st_sourceRef);

  st_analysisActivity = st_clamp01((st_slowEnv - 0.0012) * 90);

  st_bodyHeadroom = st_clamp01(1 - st_bodyPresence*0.78);
  st_detailHeadroom = st_clamp01(1 - st_detailPresence*0.82);
  st_attackHeadroom = st_clamp01(1 - st_attackPresence*0.85);
  st_shineHeadroom = st_clamp01(1 - st_shinePresence*0.82);

  // ---- Temporal Embodiment lattice: 6 evidence dimensions x 4 causal time scales ----
  // Analysis remains authoritative. These cells are consequence memory, not new physical evidence.
  st_teImpulse.st_te_step(st_impactEvidence * st_analysisActivity);
  st_teMass.st_te_step(st_bodyPresence * st_analysisActivity);
  st_teTexture.st_te_step(st_detailPresence * st_analysisActivity);
  st_teSheen.st_te_step(st_shinePresence * (1-0.45*st_airPresence) * st_analysisActivity);
  st_teField.st_te_step(st_sideEvidence * st_analysisActivity);
  st_teContinuity.st_te_step(st_sustainEvidence * st_analysisActivity);

  st_teEdgeAvg = (st_teImpulse.st_edge + st_teMass.st_edge + st_teTexture.st_edge + st_teSheen.st_edge + st_teField.st_edge + st_teContinuity.st_edge) / 6;
  st_teBloomAvg = (st_teImpulse.st_bloom + st_teMass.st_bloom + st_teTexture.st_bloom + st_teSheen.st_bloom + st_teField.st_bloom + st_teContinuity.st_bloom) / 6;
  st_teCarryAvg = (st_teImpulse.st_carry + st_teMass.st_carry + st_teTexture.st_carry + st_teSheen.st_carry + st_teField.st_carry + st_teContinuity.st_carry) / 6;
  st_teTraceAvg = (st_teImpulse.st_trace + st_teMass.st_trace + st_teTexture.st_trace + st_teSheen.st_trace + st_teField.st_trace + st_teContinuity.st_trace) / 6;

  // ---- v3.3 four-act choreography ----
  // These are normalized temporal interpretations downstream of source evidence, not new physics.
  // FLASH: contact / upper shimmer. BLOOM: body catches underneath. WRAP: field + fluid continuation.
  // AFTERIMAGE: tiny center-returning trace after the obvious event has already spent its energy.
  st_flashRaw = st_clamp01(0.64*st_teImpulse.st_edge + 0.24*st_teSheen.st_edge + 0.12*st_teTexture.st_edge);
  st_bloomRaw = st_clamp01(0.48*st_teMass.st_bloom + 0.30*st_teSheen.st_bloom + 0.22*st_teTexture.st_bloom);
  st_wrapRaw = st_clamp01(0.34*st_teField.st_carry + 0.30*st_teSheen.st_carry + 0.24*st_teContinuity.st_carry + 0.12*st_teField.st_bloom);
  st_afterRaw = st_clamp01(0.52*st_teTraceAvg + 0.28*st_teSheen.st_carry + 0.20*st_teTexture.st_trace);

  st_actFlash = st_clamp01(st_flashRaw * (1 - 0.28*st_teCarryAvg));
  st_actBloom = st_clamp01(st_bloomRaw * (1 - 0.20*st_actFlash));
  st_actWrap = st_clamp01(st_wrapRaw * (1 - 0.18*st_actFlash));
  st_actAfter = st_clamp01(st_afterRaw * (1 - 0.34*st_analysisActivity));

  // Source-locked spectral expansion: rapid outward opening, slower return.
  st_expandTarget = st_clamp01(0.72*st_actFlash + 0.46*st_actBloom + 0.18*st_actWrap);
  st_spectralExpand += (st_expandTarget-st_spectralExpand) * st_expandCoef;

  // Phase Topology decoder: Event / Structure / Relation / Persistence.
  // 1.0 means Impulse, Surface, Field and Trace respectively.
  st_topoOccupancy = st_clamp01(st_analysisActivity + 0.55*st_teBloomAvg + 0.75*st_teCarryAvg + 0.85*st_teTraceAvg);
  st_topoEvent = st_clamp01((
      0.62*st_teImpulse.st_edge
    + 0.22*st_teImpulse.st_bloom
    + 0.16*(1-st_teContinuity.st_carry)
  ) * st_topoOccupancy);

  st_topoMassBasis = 0.55*st_teMass.st_bloom + 0.32*st_teMass.st_carry + 0.13*st_teMass.st_trace;
  st_topoSurfaceBasis = 0.32*st_teTexture.st_bloom + 0.28*st_teTexture.st_carry
                   + 0.24*st_teSheen.st_bloom + 0.16*st_teSheen.st_carry;
  st_topoSurface = st_clamp01(st_topoSurfaceBasis / (st_topoMassBasis + st_topoSurfaceBasis + 0.000500));

  st_topoField = st_clamp01(0.44*st_teField.st_bloom + 0.40*st_teField.st_carry + 0.16*st_teField.st_trace);

  st_topoDirectBasis = st_teEdgeAvg + 0.72*st_teBloomAvg;
  st_topoTraceBasis = 0.54*st_teCarryAvg + st_teTraceAvg;
  st_topoTrace = st_clamp01(st_topoTraceBasis / (st_topoDirectBasis + st_topoTraceBasis + 0.000500));

  // Source-only PE -> PE2. Generated enhancement is deliberately absent from this observer.
  st_peEvent = abs(st_topoEvent-st_predTopoEvent);
  st_peSurface = abs(st_topoSurface-st_predTopoSurface);
  st_peField = abs(st_topoField-st_predTopoField);
  st_peTrace = abs(st_topoTrace-st_predTopoTrace);

  st_pe2Event = abs(st_peEvent-st_predPeEvent);
  st_pe2Surface = abs(st_peSurface-st_predPeSurface);
  st_pe2Field = abs(st_peField-st_predPeField);
  st_pe2Trace = abs(st_peTrace-st_predPeTrace);

  st_predTopoEvent += (st_topoEvent-st_predTopoEvent) * st_topoPredCoef;
  st_predTopoSurface += (st_topoSurface-st_predTopoSurface) * st_topoPredCoef;
  st_predTopoField += (st_topoField-st_predTopoField) * st_topoPredCoef;
  st_predTopoTrace += (st_topoTrace-st_predTopoTrace) * st_topoPredCoef;

  st_predPeEvent += (st_peEvent-st_predPeEvent) * st_pePredCoef;
  st_predPeSurface += (st_peSurface-st_predPeSurface) * st_pePredCoef;
  st_predPeField += (st_peField-st_predPeField) * st_pePredCoef;
  st_predPeTrace += (st_peTrace-st_predPeTrace) * st_pePredCoef;

  st_pe1Global = st_clamp01((st_peEvent + st_peSurface + st_peField + st_peTrace) * 0.25);
  st_pe2Global = st_clamp01((st_pe2Event + st_pe2Surface + st_pe2Field + st_pe2Trace) * 0.25);

  // Temporal lane support changes WHEN a valid renderer deserves authority.
  // It does not invent evidence: every term is downstream of the source-only lattice above.
  st_latBody = st_clamp01(0.48*st_teMass.st_bloom + 0.34*st_teMass.st_carry + 0.18*st_teImpulse.st_bloom);
  st_latResidue = st_clamp01(0.36*st_teMass.st_carry + 0.36*st_teMass.st_trace + 0.28*st_teContinuity.st_trace);
  st_latDetail = st_clamp01(0.40*st_teTexture.st_edge + 0.34*st_teTexture.st_bloom + 0.26*st_teContinuity.st_bloom);
  st_latSnap = st_clamp01(0.70*st_teImpulse.st_edge + 0.30*st_teTexture.st_edge);
  st_latShimmer = st_clamp01(0.44*st_teSheen.st_edge + 0.36*st_teSheen.st_bloom + 0.20*st_teTexture.st_edge);
  st_latFluid = st_clamp01(0.28*st_teSheen.st_carry + 0.26*st_teField.st_bloom + 0.24*st_teField.st_carry + 0.22*st_teContinuity.st_carry);

  // Event-conditioned PE2 state decays between event boundaries.
  st_eventPeWindow *= st_eventPeWindowDecay;
  st_eventPe2State *= st_eventPe2Decay;

  // Periodicity inference. Pulse authority exists only when repeated onsets agree in timing.
  st_beatConf *= st_beatDecay;
  st_onsetNow = st_impactGate > 0.58 && st_prevImpactGate <= 0.58 && st_sampleClock-st_lastOnsetSample > 0.055*srate;
  st_onsetNow ? (
    st_lastOnsetSample > 0 ? (
      st_thisInterval = st_sampleClock - st_lastOnsetSample;
      st_intervalSec = st_thisInterval / srate;
      st_intervalSec >= 0.120 && st_intervalSec <= 1.500 ? (
        st_thisHz = 1 / st_intervalSec;
        st_prevInterval > 0 ? (
          st_timingErr = abs(st_thisInterval-st_prevInterval) / max(st_prevInterval, 1);
          st_timingMatch = st_clamp01((0.20-st_timingErr)/0.20);
          st_beatConf = st_clamp01(st_beatConf*0.68 + st_timingMatch*0.48);
        ) : (
          st_beatConf = max(st_beatConf, 0.20);
        );
        st_beatHz = st_beatHz > 0 ? st_lerp(st_beatHz, st_thisHz, 0.28) : st_thisHz;
        st_prevInterval = st_thisInterval;
      ) : (
        st_beatConf *= 0.55;
        st_prevInterval = 0;
      );
    );
    st_beatConf > 0.52 ? st_phase = 0.5*$pi;

    // Event morphology similarity is topology similarity, not raw waveform matching.
    st_eventCount > 0 ? (
      st_thisEventSimilarity = st_clamp01(
        1 - 0.25*(
            abs(st_topoEvent-st_lastEventTopoEvent)
          + abs(st_topoSurface-st_lastEventTopoSurface)
          + abs(st_topoField-st_lastEventTopoField)
          + abs(st_topoTrace-st_lastEventTopoTrace)
        )
      );
      st_eventSimilarity += (st_thisEventSimilarity-st_eventSimilarity) * 0.42;

      // Event-conditioned PE2 learns the expected morphology error at repeated onset boundaries.
      // This prevents a perfectly repeated impact from being called "novel" merely because PE spikes on every hit.
      st_thisEventPe = 1-st_thisEventSimilarity;
      st_thisEventPe2 = abs(st_thisEventPe-st_eventPePred);
      st_eventPePred += (st_thisEventPe-st_eventPePred) * 0.52;
      st_eventPe2State = st_clamp01(st_thisEventPe2);
      st_eventPeWindow = 1;
    ) : (
      st_eventSimilarity = 0.20;
      st_eventPe2State = 1;
      st_eventPeWindow = 1;
    );
    st_lastEventTopoEvent = st_topoEvent;
    st_lastEventTopoSurface = st_topoSurface;
    st_lastEventTopoField = st_topoField;
    st_lastEventTopoTrace = st_topoTrace;
    st_eventCount += 1;
    st_reinterpretPending = 1;

    st_lastOnsetSample = st_sampleClock;
  );
  st_prevImpactGate = st_impactGate;

  // Similarity decays when accents stop arriving; a quiet gap acts as perceptual recovery.
  st_sampleClock-st_lastOnsetSample > 2.000*srate ? st_eventSimilarity *= st_eventSimDecay;

  // ---- PE2 anti-habituation observer ----
  st_interpretActivity = st_analysisActivity;

  // Representation memory now describes which Shimmer microstructure has been stable.
  st_reprMassShare = st_reprMode == 0 ? 1 : 0;
  st_reprContactShare = st_reprMode == 1 ? 1 : 0;
  st_reprFluidShare = st_reprMode == 2 ? 1 : 0;

  st_reprMassMem += (st_reprMassShare-st_reprMassMem) * st_reprMemCoef;
  st_reprContactMem += (st_reprContactShare-st_reprContactMem) * st_reprMemCoef;
  st_reprFluidMem += (st_reprFluidShare-st_reprFluidMem) * st_reprMemCoef;
  st_reprStability = max(st_reprMassMem, max(st_reprContactMem, st_reprFluidMem));

  st_interpretActivity > 0.02 ? (
    st_reprExposureMove = st_reprExposureCoef * st_interpretActivity;
    st_reprMassTarget = st_reprMassShare;
    st_reprContactTarget = st_reprContactShare;
    st_reprFluidTarget = st_reprFluidShare;
  ) : (
    // Silence/bypass repays microstructure debt instead of preserving stale habituation forever.
    st_reprExposureMove = st_reprExposureRecoveryCoef;
    st_reprMassTarget = 0.333333;
    st_reprContactTarget = 0.333333;
    st_reprFluidTarget = 0.333333;
  );
  st_reprMassExp += (st_reprMassTarget-st_reprMassExp) * st_reprExposureMove;
  st_reprContactExp += (st_reprContactTarget-st_reprContactExp) * st_reprExposureMove;
  st_reprFluidExp += (st_reprFluidTarget-st_reprFluidExp) * st_reprExposureMove;

  st_temporalOccupancy = st_clamp01(0.22*st_teBloomAvg + 0.34*st_teCarryAvg + 0.44*st_teTraceAvg);

  // PE2 is the novelty authority. Near event boundaries, use event-conditioned PE2 so a
  // repeated impact may have large first-order PE without being falsely treated as novel.
  st_pe2Effective = st_lerp(st_pe2Global, st_eventPe2State, st_eventPeWindow);
  st_lowPe2 = st_clamp01(1 - 4.20*st_pe2Effective);
  st_eventRepetition = st_clamp01(st_eventSimilarity * (0.70 + 0.30*st_beatConf));
  st_continuityRepetition = st_clamp01(
      st_sustainEvidence
    * st_lowPe2
    * (0.42*st_teCarryAvg + 0.58*st_teTraceAvg)
    * st_analysisActivity
  );
  st_repetitionEvidence = max(st_eventRepetition, 0.58*st_continuityRepetition);

  st_familiarityInput = st_repetitionEvidence
                   * (0.34 + 0.66*st_temporalOccupancy)
                   * st_reprStability
                   * st_lowPe2
                   * st_interpretActivity;

  st_famImmediate += (st_familiarityInput-st_famImmediate) * st_famImmediateCoef;
  st_famPhrase += (st_familiarityInput-st_famPhrase) * st_famPhraseCoef;
  st_famScene += (st_familiarityInput-st_famScene) * st_famSceneCoef;
  st_famExposure += (st_familiarityInput-st_famExposure) * st_famExposureCoef;

  st_familiarity = st_clamp01(
      0.16*st_famImmediate
    + 0.34*st_famPhrase
    + 0.32*st_famScene
    + 0.18*st_famExposure
  );

  // Low PE2 means the prediction error itself has become predictable.
  // This is the anti-habituation gate: no arbitrary variation merely because PE is nonzero.
  st_freshnessPressure = st_clamp01(st_familiarity * st_lowPe2 * st_autoAuthority);

  // Three source-supported microstructures that all remain inside the Pelvic-Shimmer signature.
  // DENSE = body-anchored primary shimmer; SILKY = width/carry; SPARK = upper/air transient shimmer.
  st_massSupport = st_clamp01(
      0.26*(1-st_topoSurface)
    + 0.24*st_bodyPresence
    + 0.24*st_shinePresence
    + 0.16*(1-st_topoField)
    + 0.10*st_teMass.st_bloom
  );
  st_contactSupport = st_clamp01(
      0.28*st_topoSurface
    + 0.26*st_topoField
    + 0.20*st_sustainEvidence
    + 0.18*st_shinePresence
    + 0.08*st_teSheen.st_carry
  );
  st_fluidSupport = st_clamp01(
      0.32*st_topoEvent
    + 0.24*st_attackPresence
    + 0.20*st_shineHeadroom
    + 0.14*(1-st_topoTrace)
    + 0.10*st_shinePresence
  );

  // Lazy interpretation: reconsider on event boundaries, topology surprise,
  // or when a stable representation has accumulated enough familiarity pressure.
  st_reprAgeSamples += 1;
  st_interpCounter += 1;
  st_interpCounter >= 256 ? (
    st_interpCounter = 0;
    st_reprAgeSec = st_reprAgeSamples / srate;

    st_massScore = st_massSupport * (1 + st_freshnessPressure*(1-st_reprMassExp)*2.20);
    st_contactScore = st_contactSupport * (1 + st_freshnessPressure*(1-st_reprContactExp)*2.20);
    st_fluidScore = st_fluidSupport * (1 + st_freshnessPressure*(1-st_reprFluidExp)*2.20);

    st_reprMode == 0 ? st_massScore *= 1 - st_freshnessPressure*st_reprMassExp*0.30;
    st_reprMode == 1 ? st_contactScore *= 1 - st_freshnessPressure*st_reprContactExp*0.30;
    st_reprMode == 2 ? st_fluidScore *= 1 - st_freshnessPressure*st_reprFluidExp*0.30;

    st_currentScore = st_reprMode == 0 ? st_massScore : st_reprMode == 1 ? st_contactScore : st_fluidScore;
    st_bestMode = 0;
    st_bestScore = st_massScore;
    st_contactScore > st_bestScore ? (st_bestMode = 1; st_bestScore = st_contactScore;);
    st_fluidScore > st_bestScore ? (st_bestMode = 2; st_bestScore = st_fluidScore;);

    st_needReinterpret = st_reinterpretPending
                   || (st_pe1Global > 0.095 && st_reprAgeSec > 0.120)
                   || (st_pe2Effective > 0.080 && st_reprAgeSec > 0.180)
                   || (st_freshnessPressure > 0.28 && st_reprAgeSec > 0.320);

    st_needReinterpret ? (
      st_canSwitch = st_bestScore > st_currentScore*1.055
               || st_freshnessPressure > 0.58
               || st_pe1Global > 0.14;
      st_canSwitch && st_bestMode != st_reprMode ? (
        st_reprMode = st_bestMode;
        st_reprAgeSamples = 0;
      );
      st_reinterpretPending = 0;
    );
  );

  st_pulseTrust = st_clamp01((st_beatConf - 0.52) / 0.40) * st_autoAuthority;
  st_pulseHz = st_pulseTrust > 0.02 ? st_clamp(st_beatHz, 0.67, 6.00) : 0;
  st_pulseAmt = 0.22 * st_pulseTrust;
  st_pulseDriftPct = 0.018 * st_autoAuthority;
  st_pulseDriftRate = 0.045 + 0.035*st_autoAuthority;

  st_pulse = 0;
  st_pulseHz > 0 ? (
    st_driftRange = min(st_pulseHz * st_pulseDriftPct, 0.18);
    st_driftPhaseA += st_two_pi*st_pulseDriftRate/srate;
    st_driftPhaseA >= st_two_pi ? st_driftPhaseA -= st_two_pi;
    st_driftPhaseB += st_two_pi*(st_pulseDriftRate*0.37 + 0.0017)/srate;
    st_driftPhaseB >= st_two_pi ? st_driftPhaseB -= st_two_pi;
    st_driftTarget = st_clamp(0.72*sin(st_driftPhaseA) + 0.28*sin(st_driftPhaseB + 1.13), -1, 1);
    st_pulseDriftSm += (st_driftTarget - st_pulseDriftSm) * st_pulseDriftSmooth;
    st_pulseHzNow = st_clamp(st_pulseHz + st_driftRange*st_pulseDriftSm, 0.05, 8.0);
    st_phase += st_two_pi*st_pulseHzNow/srate;
    st_phase >= st_two_pi ? st_phase -= st_two_pi;
    st_pulse = 0.5 + 0.5*sin(st_phase);
  ) : (
    st_pulseHzNow = 0;
  );
  st_pulseMul = 1 + st_pulseAmt*st_impactGate*st_pulse;

  // Continuous opportunity field, temporally weighted by embodiment.
  st_bodyOppRaw = (0.22 + 0.78*st_impactEvidence) * (0.30 + 0.70*st_bodyPresence) * (0.40 + 0.60*st_bodyHeadroom)
             * (0.78 + 0.22*st_latBody);
  st_residueOppRaw = (0.24 + 0.76*st_quietSense) * (0.32 + 0.68*st_bodyPresence) * (0.40 + 0.60*st_sustainEvidence)
                * (0.75 + 0.25*st_latResidue);
  st_detailOppRaw = (0.30 + 0.70*st_detailPresence) * (0.28 + 0.42*st_quietSense + 0.30*st_impactEvidence) * (0.42 + 0.58*st_detailHeadroom)
               * (0.78 + 0.22*st_latDetail);
  st_snapOppRaw = st_impactEvidence * (0.20 + 0.80*st_attackPresence) * (0.35 + 0.65*st_attackHeadroom)
             * (0.82 + 0.18*st_latSnap);
  st_shimmerOppRaw = (0.34 + 0.66*st_impactEvidence) * (0.36 + 0.64*st_shinePresence) * (0.46 + 0.54*st_shineHeadroom) * (1 - 0.58*st_airPresence)
                * (0.76 + 0.24*st_latShimmer) * (0.62 + 0.38*st_shimmerContrast);
  st_fluidOppRaw = (0.34 + 0.66*st_shinePresence) * (0.30 + 0.70*st_sustainEvidence) * (0.62 + 0.38*st_sideEvidence) * (1 - 0.38*st_airPresence)
              * (0.72 + 0.28*st_latFluid);

  st_bodyOpp = st_lerp(1, st_bodyOppRaw, st_analysisActivity);
  st_residueOpp = st_lerp(1, st_residueOppRaw, st_analysisActivity);
  st_detailOpp = st_lerp(1, st_detailOppRaw, st_analysisActivity);
  st_snapOpp = st_lerp(1, st_snapOppRaw, st_analysisActivity);
  st_shimmerOpp = st_lerp(1, st_shimmerOppRaw, st_analysisActivity);
  st_fluidOpp = st_lerp(1, st_fluidOppRaw, st_analysisActivity);

  // Lane-use memory only matters when PE2 confirms perceptual predictability.
  st_noveltyBody = st_lerp(1, 1 / (1 + st_freshnessPressure*st_expBody*1.60), st_analysisActivity);
  st_noveltyResidue = st_lerp(1, 1 / (1 + st_freshnessPressure*st_expResidue*1.45), st_analysisActivity);
  st_noveltyDetail = st_lerp(1, 1 / (1 + st_freshnessPressure*st_expDetail*1.55), st_analysisActivity);
  st_noveltySnap = st_lerp(1, 1 / (1 + st_freshnessPressure*st_expSnap*1.65), st_analysisActivity);
  // Shimmer is the identity: anti-habituation reshapes it before it ever heavily suppresses it.
  st_noveltyShimmer = st_lerp(1, 1 / (1 + st_freshnessPressure*st_expShimmer*0.72), st_analysisActivity);
  st_noveltyFluid = st_lerp(1, 1 / (1 + st_freshnessPressure*st_expFluid*1.05), st_analysisActivity);

  st_midRiskProtect = st_clamp(st_honkProtect*st_nasalProtect, 0.15, 1);
  st_hiRiskProtect = st_clamp(st_catGuard, 0.12, 1);

  // Microstructure targets: all three keep Shimmer load-bearing.
  st_reprStrength = st_freshnessPressure * st_autoAuthority * st_analysisActivity;
  st_denseAmt = st_reprMode == 0 ? st_reprStrength : 0;
  st_silkyAmt = st_reprMode == 1 ? st_reprStrength : 0;
  st_sparkAmt = st_reprMode == 2 ? st_reprStrength : 0;

  st_denseSh1 = 1.000000; st_denseSh2 = 0.720000; st_denseSh3 = 0.480000;
  st_silkySh1 = 0.750000; st_silkySh2 = 1.000000; st_silkySh3 = 0.620000;
  st_sparkSh1 = 0.520000; st_sparkSh2 = 0.780000; st_sparkSh3 = 1.000000;
  st_reprMode == 0 ? (st_shSel1=st_denseSh1; st_shSel2=st_denseSh2; st_shSel3=st_denseSh3;);
  st_reprMode == 1 ? (st_shSel1=st_silkySh1; st_shSel2=st_silkySh2; st_shSel3=st_silkySh3;);
  st_reprMode == 2 ? (st_shSel1=st_sparkSh1; st_shSel2=st_sparkSh2; st_shSel3=st_sparkSh3;);
  // AUTO=0 is hard-anchored to the original Dense 1/.72/.48 signature.
  st_microAuthority = st_autoAuthority * st_clamp01(0.18*st_analysisActivity + 0.82*st_reprStrength);
  st_shT1 = st_lerp(st_denseSh1, st_shSel1, st_microAuthority);
  st_shT2 = st_lerp(st_denseSh2, st_shSel2, st_microAuthority);
  st_shT3 = st_lerp(st_denseSh3, st_shSel3, st_microAuthority);
  st_shW1 += (st_shT1-st_shW1) * st_microCoef;
  st_shW2 += (st_shT2-st_shW2) * st_microCoef;
  st_shW3 += (st_shT3-st_shW3) * st_microCoef;

  // Shimmer-first finite budget. Fluid is a cooperating continuation of shimmer, not a rival effect.
  st_reqBody = 1.20 * st_lerp(1, st_bodyOpp, st_autoAuthority) * st_noveltyBody * (1 + 0.22*st_denseAmt);
  st_reqResidue = 0.58 * st_lerp(1, st_residueOpp, st_autoAuthority) * st_noveltyResidue * (1 + 0.10*st_denseAmt);
  st_reqDetail = 0.72 * st_lerp(1, st_detailOpp, st_autoAuthority) * st_noveltyDetail * st_lerp(1, st_midRiskProtect, st_autoAuthority) * (1 + 0.14*st_sparkAmt);
  st_reqSnap = 0.96 * st_lerp(1, st_snapOpp, st_autoAuthority) * st_noveltySnap * st_lerp(1, 0.72+0.28*st_hiRiskProtect, st_autoAuthority) * (1 + 0.22*st_sparkAmt);
  st_reqShimmer = 2.45 * st_lerp(1, st_shimmerOpp, st_autoAuthority) * st_noveltyShimmer * st_lerp(1, st_hiRiskProtect, st_autoAuthority)
             * (1 + 0.12*st_denseAmt + 0.18*st_silkyAmt + 0.24*st_sparkAmt);
  st_shimmerComplex = max(st_shimmerOpp, 0.62*st_fluidOpp + 0.38*st_shimmerOpp);
  st_reqFluid = 1.48 * st_lerp(1, st_shimmerComplex, st_autoAuthority) * st_noveltyFluid * st_lerp(1, 0.74+0.26*st_hiRiskProtect, st_autoAuthority)
           * (1 + 0.32*st_silkyAmt);

  st_reqSum = st_reqBody + st_reqResidue + st_reqDetail + st_reqSnap + st_reqShimmer + st_reqFluid + 0.000001;
  st_targetWBody = st_reqBody / st_reqSum;
  st_targetWResidue = st_reqResidue / st_reqSum;
  st_targetWDetail = st_reqDetail / st_reqSum;
  st_targetWSnap = st_reqSnap / st_reqSum;
  st_targetWShimmer = st_reqShimmer / st_reqSum;
  st_targetWFluid = st_reqFluid / st_reqSum;

  st_authorityMove = st_authorityCoef * (0.25 + 0.75*st_analysisActivity);
  st_wBody += (st_targetWBody-st_wBody) * st_authorityMove;
  st_wResidue += (st_targetWResidue-st_wResidue) * st_authorityMove;
  st_wDetail += (st_targetWDetail-st_wDetail) * st_authorityMove;
  st_wSnap += (st_targetWSnap-st_wSnap) * st_authorityMove;
  st_wShimmer += (st_targetWShimmer-st_wShimmer) * st_authorityMove;
  st_wFluid += (st_targetWFluid-st_wFluid) * st_authorityMove;

  st_interpretActivity > 0.02 ? (
    st_exposureMove = st_exposureCoef * st_interpretActivity;
    st_expBodyTarget = st_wBody; st_expResidueTarget = st_wResidue; st_expDetailTarget = st_wDetail;
    st_expSnapTarget = st_wSnap; st_expShimmerTarget = st_wShimmer; st_expFluidTarget = st_wFluid;
  ) : (
    st_exposureMove = st_exposureRecoveryCoef;
    st_expBodyTarget = 0.150000; st_expResidueTarget = 0.070000; st_expDetailTarget = 0.090000;
    st_expSnapTarget = 0.120000; st_expShimmerTarget = 0.370000; st_expFluidTarget = 0.200000;
  );
  st_expBody += (st_expBodyTarget-st_expBody) * st_exposureMove;
  st_expResidue += (st_expResidueTarget-st_expResidue) * st_exposureMove;
  st_expDetail += (st_expDetailTarget-st_expDetail) * st_exposureMove;
  st_expSnap += (st_expSnapTarget-st_expSnap) * st_exposureMove;
  st_expShimmer += (st_expShimmerTarget-st_expShimmer) * st_exposureMove;
  st_expFluid += (st_expFluidTarget-st_expFluid) * st_exposureMove;

  // Proven v2.6 internal operating point is the baseline. AUTO moves around it; Injection does not scale it.
  st_bodyDrive = st_clamp(0.85 + st_autoAuthority*(0.55*(st_wBody-0.15)*3.2 + 0.18*st_bodyOppRaw + 0.10*st_denseAmt), 0.55, 1.35);
  st_residueAmt = st_clamp(0.60 + st_autoAuthority*(0.42*(st_wResidue-0.07)*4.0 + 0.18*st_quietSense), 0.38, 1.05);
  st_voiceAmt = st_clamp(0.55 + st_autoAuthority*(0.46*(st_wDetail-0.09)*3.8 + 0.12*st_detailOppRaw), 0.32, 1.05);
  st_impact = st_clamp(0.70 + st_autoAuthority*(0.52*(st_wSnap-0.12)*3.4 + 0.16*st_impactEvidence + 0.10*st_sparkAmt), 0.45, 1.25);
  st_shimmerDrive = st_clamp(1.42 + st_autoAuthority*(1.30*(st_wShimmer-0.37)*2.3 + 0.38*st_shimmerContrast + 0.20*st_shineHeadroom + 0.14*st_sparkAmt), 0.95, 2.00);
  st_fluidAmt = st_clamp(0.70 + st_autoAuthority*(0.78*(st_wFluid-0.20)*2.8 + 0.30*st_fluidOppRaw + 0.18*st_silkyAmt), 0.42, 1.35);

  st_missAmt = st_clamp(0.70 + st_autoAuthority*(0.18*st_bodyHeadroom + 0.10*st_quietSense), 0.55, 1.00);
  st_resEdge = st_clamp(0.18 + st_autoAuthority*(0.12*st_detailPresence), 0.10, 0.32);
  st_quietHold = st_clamp(0.40 + st_autoAuthority*(0.24*st_quietSense), 0.32, 0.72);
  st_residueFlash = 0.08*st_pulseTrust;

  st_voiceBias = st_clamp(0.55 + st_autoAuthority*(0.20*st_detailPresence), 0.45, 0.78);
  st_midLift = st_clamp(0.65 + st_autoAuthority*(0.20*st_quietSense), 0.55, 0.86);
  st_formantCoherence = st_clamp(0.85 + st_autoAuthority*(0.11*(1-st_sideEvidence)), 0.80, 0.96);
  st_sfxFollow = st_clamp(0.70 + st_autoAuthority*(0.20*st_impactEvidence), 0.68, 0.92);
  st_v1FlashFollow = st_clamp(0.85 - st_autoAuthority*(0.24*(1-st_pulseTrust)), 0.58, 0.90);
  st_translationFloor = st_clamp(0.55 + st_autoAuthority*(0.25*st_quietSense), 0.45, 0.82);
  st_phoneSnapAmt = st_clamp(0.35 + st_autoAuthority*(0.52*min(st_wSnap*4.0,1.0) + 0.18*st_sparkAmt), 0.22, 1.05);
  st_phoneSheenAmt = st_clamp(0.14 + st_autoAuthority*(0.30*min(st_wShimmer*3.0,1.0) + 0.12*st_silkyAmt), 0.10, 0.58);

  // Correlation-governed generated-only stereo eruption.
  // Negative generated correlation and poor mono survival close the width gate immediately;
  // uncorrelated-but-mono-safe sheen is still allowed to go extremely wide.
  st_corrGuard = st_clamp01((st_genCorr + 0.45) / 0.45);
  st_monoGuard = st_clamp01((st_monoSurvival - 0.18) / 0.62);
  st_srcAntiGuard = st_clamp01((st_srcCorr + 0.85) / 0.85);
  st_stereoSafety = min(1, (0.72 + 0.38*st_monoGuard) * st_corrGuard * st_srcAntiGuard);

  st_widthTarget = st_clamp01(0.72*st_actFlash + 0.34*st_actBloom + 0.62*st_actWrap - 0.42*st_actAfter);
  st_widthGesture += (st_widthTarget-st_widthGesture) * st_widthCoef;
  st_stereoOpportunity = st_clamp01(0.12 + 0.42*st_sideEvidence + 0.18*st_topoField + 0.40*st_widthGesture);
  st_stereoEruption = st_clamp01((0.78*st_actFlash + 0.66*st_actWrap) * st_stereoSafety);
  st_stereoAmt = st_clamp(
      0.45
    + st_autoAuthority*(1.10*st_stereoOpportunity + 0.78*st_stereoEruption + 0.30*st_silkyAmt),
    0.35, 2.00
  );
  st_midLock = st_clamp(0.95 - st_autoAuthority*(0.22*st_sideEvidence*min(st_wDetail*4.00, 1.00)), 0.72, 0.96);

  st_fatigueAmt = st_clamp(0.65 + st_autoAuthority*(0.38*st_airPresence + 0.18*max(st_shimmerDrive-1.42,0)), 0.62, 1.35);
  st_honkGuardAmt = st_clamp(0.65 + st_autoAuthority*(0.32*st_detailPresence), 0.62, 1.18);
  st_nasalGuardAmt = st_clamp(0.70 + st_autoAuthority*(0.34*st_detailPresence), 0.66, 1.22);

  // Temporal energy concentration: AUTO=0 is exactly neutral; AUTO>0 spends more energy
  // in the informative window and less between acts rather than simply raising average level.
  st_bodyChoreo = st_lerp(1, 0.58 + 0.92*st_actBloom + 0.22*st_actFlash, st_autoAuthority);
  st_residueChoreo = st_lerp(1, 0.38 + 0.42*st_actWrap + 0.88*st_actAfter, st_autoAuthority);
  st_detailChoreo = st_lerp(1, 0.50 + 0.78*st_actFlash + 0.48*st_actBloom + 0.12*st_actAfter, st_autoAuthority);
  st_snapChoreo = st_lerp(1, 0.42 + 1.48*st_actFlash, st_autoAuthority);
  st_shimmerChoreo = st_lerp(1, 0.50 + 1.18*st_actFlash + 0.40*st_actBloom + 0.12*st_actWrap, st_autoAuthority);
  st_fluidChoreo = st_lerp(1, 0.38 + 0.24*st_actBloom + 1.08*st_actWrap + 0.14*st_actAfter, st_autoAuthority);

  // Distinct nonlinear personalities inside the SAME Shimmer identity.
  st_denseBodyNL = 1 + st_autoAuthority*0.46*st_denseAmt*st_actBloom;
  st_sparkShimmerNL = 1 + st_autoAuthority*0.62*st_sparkAmt*st_actFlash;
  st_silkyFluidNL = 1 + st_autoAuthority*0.48*st_silkyAmt*st_actWrap;

  st_bL = st_body1L.st_run_bq(st_xL) + 0.80*st_body2L.st_run_bq(st_xL);
  st_bR = st_body1R.st_run_bq(st_xR) + 0.80*st_body2R.st_run_bq(st_xR);
  st_bSatL = st_softsat(st_bL * (1.60 + 2.80*st_bodyDrive) * st_denseBodyNL);
  st_bSatR = st_softsat(st_bR * (1.60 + 2.80*st_bodyDrive) * st_denseBodyNL);
  st_bodyGain = 0.185 * st_bodyDrive * (0.65 + 0.80*st_impact*st_tr) * st_pulseMul * st_bodyChoreo;
  st_bodyAddL = st_bSatL * st_bodyGain;
  st_bodyAddR = st_bSatR * st_bodyGain;

  st_quietMul = 1 + st_quietHold*(0.22 + 0.88*st_quietSense);
  st_rootRaw = st_rootM.st_run_bq(st_mono);
  st_rootDrive = 1.80 + 3.80*st_missAmt;
  st_rootUnit = st_softsat(st_rootRaw * st_rootDrive);
  st_rootEven = st_rootUnit * st_rootUnit;
  st_rootDC += (st_rootEven - st_rootDC) * st_rootDCcoef;
  st_rootFold = st_rootEven - st_rootDC;
  st_genRoot = 0.78*st_rootUnit + 0.22*st_softsat(st_rootFold * (1.05 + 0.45*st_missAmt));

  st_resBody = 0.96*st_res4M.st_run_bq(st_genRoot) + 0.76*st_res5M.st_run_bq(st_genRoot) + 0.52*st_res7M.st_run_bq(st_genRoot) + 0.36*st_res8M.st_run_bq(st_genRoot);
  st_resCarry = st_resEdge*(0.18*st_res12M.st_run_bq(st_genRoot) + 0.11*st_res15M.st_run_bq(st_genRoot));
  st_residueCore = st_softsat((st_resBody + st_resCarry) * (0.95 + 1.10*st_residueAmt));
  st_resDyn = 0.62 + 0.46*st_impact*min(st_tr, 1.15);
  st_resPulseMul = 1 + st_residueFlash*(st_pulseMul - 1);
  st_residueGain = 0.066 * st_residueAmt * st_missAmt * st_resDyn * st_quietMul * st_resPulseMul * st_residueChoreo;
  st_residueAddL = st_residueCore * st_residueGain;
  st_residueAddR = st_residueAddL;

  // Detail Translation lane (renamed from v2.6 Voice-Life for general SFX use).
  st_vlLow = st_vlLowM.st_run_bq(st_mono);
  st_vlBridge = st_vlBridgeM.st_run_bq(st_mono);
  st_vlWarm = st_vlWarmM.st_run_bq(st_mono);
  st_vlMeat1 = st_vlMeat1M.st_run_bq(st_mono);
  st_vlMeat2 = st_vlMeat2M.st_run_bq(st_mono);
  st_vlMeat3 = st_vlMeat3M.st_run_bq(st_mono);
  st_vlPres1 = st_vlPres1M.st_run_bq(st_mono);
  st_vlPres2 = st_vlPres2M.st_run_bq(st_mono);
  st_vlBite = st_vlBiteM.st_run_bq(st_mono);

  st_vlLinear = 0.18*st_vlLow + 0.30*st_vlBridge + 0.42*st_vlWarm
           + 0.74*st_vlMeat1 + 1.00*st_vlMeat2 + 0.82*st_vlMeat3
           + (0.34 + 0.20*st_voiceBias)*st_vlPres1 + (0.24 + 0.18*st_voiceBias)*st_vlPres2
           + (0.05 + 0.10*st_voiceBias)*st_vlBite;

  st_vlAnimated = 0.12*st_softsat(st_vlLow*2.0) + 0.20*st_softsat(st_vlBridge*2.2) + 0.28*st_softsat(st_vlWarm*2.4)
             + 0.54*st_softsat(st_vlMeat1*2.7) + 0.72*st_softsat(st_vlMeat2*2.9) + 0.52*st_softsat(st_vlMeat3*2.6)
             + 0.22*st_softsat(st_vlPres1*(2.0 + 0.9*st_voiceBias)) + 0.16*st_softsat(st_vlPres2*(1.8 + 0.8*st_voiceBias));

  st_voiceRaw = st_formantCoherence*st_vlLinear + (1 - st_formantCoherence)*st_vlAnimated;
  st_voiceAmp = abs(st_voiceRaw);
  st_voiceFastEnv += (st_voiceAmp - st_voiceFastEnv) * (st_voiceAmp > st_voiceFastEnv ? st_voiceFastAtk : st_voiceFastRel);
  st_voiceSlowEnv += (st_voiceAmp - st_voiceSlowEnv) * (st_voiceAmp > st_voiceSlowEnv ? st_voiceSlowAtk : st_voiceSlowRel);
  st_voiceTr = st_clamp((st_voiceFastEnv - st_voiceSlowEnv) / (st_voiceSlowEnv + 0.003), 0, 2.0);

  st_voiceQuietSense = st_clamp01((0.026 - st_voiceSlowEnv) / 0.026);
  st_voiceUpMul = 1 + st_midLift*(0.12 + 0.45*st_voiceQuietSense + 0.35*st_quietSense);
  st_voiceEnvMul = (1 - st_sfxFollow) + st_sfxFollow*(0.62 + 0.72*st_clamp01(st_voiceTr*0.72));
  st_voiceFlashMul = 1 + st_v1FlashFollow*(st_pulseMul - 1);
  st_voiceFloorMul = 1 + st_translationFloor*(0.16 + 0.64*st_quietSense);

  st_honkProbe = abs(st_honkM.st_run_bq(st_mono));
  st_honkEnv += (st_honkProbe - st_honkEnv) * (st_honkProbe > st_honkEnv ? st_honkAtk : st_honkRel);
  st_honkProtect = 1 / (1 + st_honkGuardAmt * max(st_honkEnv - 0.010, 0) * 52);

  st_nasalProbe = 0.64*abs(st_nasalM.st_run_bq(st_mono)) + 0.36*abs(st_nasal2M.st_run_bq(st_mono));
  st_nasalEnv += (st_nasalProbe - st_nasalEnv) * (st_nasalProbe > st_nasalEnv ? st_nasalAtk : st_nasalRel);
  st_nasalProtect = 1 / (1 + st_nasalGuardAmt * max(st_nasalEnv - 0.009, 0) * 56);
  st_voiceProtect = st_honkProtect * st_nasalProtect;

  st_voiceCore = st_softsat(st_voiceRaw * (1.05 + 2.25*st_voiceAmt + 1.05*st_voiceBias));
  st_voiceGain = 0.052 * st_voiceAmt * st_voiceUpMul * st_voiceEnvMul * st_voiceFlashMul * st_voiceFloorMul
            * (0.64 + 0.42*st_impact*min(st_tr, 1.25)) * st_voiceProtect * st_detailChoreo;

  st_vlSideRaw = 0.72*st_vlSideMeatM.st_run_bq(st_side) + 0.28*st_vlSidePresM.st_run_bq(st_side);
  st_vlSideCore = st_softsat(st_vlSideRaw * (0.9 + 1.7*st_voiceAmt));
  st_vlSideGain = st_voiceGain * (1 - st_midLock) * 0.45;
  st_detailAddL = st_voiceCore*st_voiceGain + st_vlSideCore*st_vlSideGain;
  st_detailAddR = st_voiceCore*st_voiceGain - st_vlSideCore*st_vlSideGain;

  st_vlSnapRaw = 0.70*st_vlSnapM.st_run_bq(st_mono) + 0.30*st_vlSnap2M.st_run_bq(st_mono);
  st_vlSnapCore = st_softsat(st_vlSnapRaw * (1.65 + 3.10*st_phoneSnapAmt));
  st_vlSnapGain = 0.023 * st_voiceAmt * st_phoneSnapAmt * (0.18 + 1.42*st_voiceTr) * st_voiceFlashMul * st_voiceProtect
             * st_lerp(1, 0.62 + 0.92*st_actFlash, st_autoAuthority);
  st_detailSnapAddL = st_vlSnapCore * st_vlSnapGain;
  st_detailSnapAddR = st_detailSnapAddL;

  st_vlSheenRawL = st_vlSheenL.st_run_bq(st_xL) + 0.62*st_vlSheen2L.st_run_bq(st_xL);
  st_vlSheenRawR = st_vlSheenR.st_run_bq(st_xR) + 0.62*st_vlSheen2R.st_run_bq(st_xR);
  st_vlSheenCoreL = st_softsat(st_vlSheenRawL * (1.35 + 2.25*st_phoneSheenAmt));
  st_vlSheenCoreR = st_softsat(st_vlSheenRawR * (1.35 + 2.25*st_phoneSheenAmt));
  st_vlSheenGain = 0.020 * st_voiceAmt * st_phoneSheenAmt * st_catGuard * (0.66 + 0.52*st_impact*min(st_tr, 1.3))
              * st_lerp(1, 0.58 + 0.72*st_actFlash + 0.42*st_actWrap, st_autoAuthority);
  st_detailSheenAddL = st_vlSheenCoreL * st_vlSheenGain;
  st_detailSheenAddR = st_vlSheenCoreR * st_vlSheenGain;
  st_vlSheenSide = 0.5*(st_detailSheenAddL - st_detailSheenAddR);
  st_detailSheenAddL += st_stereoAmt*0.18*st_vlSheenSide;
  st_detailSheenAddR -= st_stereoAmt*0.18*st_vlSheenSide;

  st_biteInL = st_biteL.st_run_bq(st_xL);
  st_biteInR = st_biteR.st_run_bq(st_xR);
  st_snapGain = 0.090 * st_impact * (0.35 + 1.35*st_tr) * st_pulseMul * st_snapChoreo;
  st_snapL = st_softsat(st_biteInL * (2.2 + 3.2*st_impact)) * st_snapGain;
  st_snapR = st_softsat(st_biteInR * (2.2 + 3.2*st_impact)) * st_snapGain;

  st_h1L = st_sh1L.st_run_bq(st_xL);
  st_h1R = st_sh1R.st_run_bq(st_xR);
  st_h2L = st_sh2L.st_run_bq(st_xL);
  st_h2R = st_sh2R.st_run_bq(st_xR);
  st_h3L = st_sh3L.st_run_bq(st_xL);
  st_h3R = st_sh3R.st_run_bq(st_xR);
  st_hiL = st_shW1*st_h1L + st_shW2*st_h2L + st_shW3*st_h3L;
  st_hiR = st_shW1*st_h1R + st_shW2*st_h2R + st_shW3*st_h3R;

  st_guardProbe = 0.5*(abs(st_guardL.st_run_bq(st_xL)) + abs(st_guardR.st_run_bq(st_xR)));
  st_hiEnv += (st_guardProbe - st_hiEnv) * (st_guardProbe > st_hiEnv ? st_hiAtk : st_hiRel);
  st_guard = 1 / (1 + st_fatigueAmt * max(st_hiEnv - 0.028, 0) * 30);
  st_catGuard = st_guard;

  st_shSatL = st_softsat(st_hiL * (2.0 + 4.0*st_shimmerDrive) * st_sparkShimmerNL);
  st_shSatR = st_softsat(st_hiR * (2.0 + 4.0*st_shimmerDrive) * st_sparkShimmerNL);
  st_shGain = 0.115 * st_shimmerDrive * st_guard * (0.75 + 0.70*st_impact*st_tr) * st_shimmerChoreo;
  st_shineL = st_shSatL * st_shGain;
  st_shineR = st_shSatR * st_shGain;

  st_fInL = st_softsat((st_hiL + 0.40*st_snapL) * (1.8 + 3.2*st_fluidAmt) * st_silkyFluidNL) * st_guard;
  st_fInR = st_softsat((st_hiR + 0.40*st_snapR) * (1.8 + 3.2*st_fluidAmt) * st_silkyFluidNL) * st_guard;

  st_idx1 = st_dpos - st_d1;
  st_idx1 < 0 ? st_idx1 += st_delaySize;
  st_idx2 = st_dpos - st_d2;
  st_idx2 < 0 ? st_idx2 += st_delaySize;
  st_idx3 = st_dpos - st_d3;
  st_idx3 < 0 ? st_idx3 += st_delaySize;
  st_idx4 = st_dpos - st_d4;
  st_idx4 < 0 ? st_idx4 += st_delaySize;
  st_idx5 = st_dpos - st_d5;
  st_idx5 < 0 ? st_idx5 += st_delaySize;
  st_idx6 = st_dpos - st_d6;
  st_idx6 < 0 ? st_idx6 += st_delaySize;
  st_tapL1 = st_bufL[st_idx1];
  st_tapR1 = st_bufR[st_idx1];
  st_tapL2 = st_bufL[st_idx2];
  st_tapR2 = st_bufR[st_idx2];
  st_tapL3 = st_bufL[st_idx3];
  st_tapR3 = st_bufR[st_idx3];
  st_tapL4 = st_bufL[st_idx4];
  st_tapR4 = st_bufR[st_idx4];
  st_tapL5 = st_bufL[st_idx5];
  st_tapR5 = st_bufR[st_idx5];
  st_tapL6 = st_bufL[st_idx6];
  st_tapR6 = st_bufR[st_idx6];

  st_fb = min(0.090, 0.045 * st_fluidAmt * (1 + st_autoAuthority*0.42*st_silkyAmt*st_actWrap));
  st_bufL[st_dpos] = st_fInL + st_fb*st_tapR3;
  st_bufR[st_dpos] = st_fInR + st_fb*st_tapL3;
  st_dpos += 1;
  st_dpos >= st_delaySize ? st_dpos = 0;

  st_tap1W = 0.58 - 0.10*st_silkyAmt + 0.08*st_sparkAmt;
  st_tap2W = 0.34 + 0.12*st_silkyAmt;
  st_tap3W = 0.18 + 0.14*st_silkyAmt - 0.05*st_sparkAmt;
  st_smearL = st_tap1W*st_tapL1 + st_tap2W*st_tapR2 + st_tap3W*st_tapL3;
  st_smearR = st_tap1W*st_tapR1 + st_tap2W*st_tapL2 + st_tap3W*st_tapR3;
  st_smearSide = 0.5*(st_smearL - st_smearR);
  st_fluidL = 0.105 * st_fluidAmt * (st_smearL + st_stereoAmt*st_smearSide) * st_fluidChoreo;
  st_fluidR = 0.105 * st_fluidAmt * (st_smearR - st_stereoAmt*st_smearSide) * st_fluidChoreo;

  st_shSide = 0.5*(st_shineL - st_shineR);
  // At AUTO=0 this is exactly the old generated-only 0.40 * Stereo Sheen widening law.
  st_sheenWidthBase = st_stereoAmt * 0.40;
  st_sheenWidthAuto = st_clamp(
      st_stereoAmt
    * (0.18 + 0.50*st_actFlash + 0.42*st_actWrap + 0.16*st_silkyAmt)
    * st_stereoSafety,
    0, 1.65
  );
  st_sheenWidth = st_lerp(st_sheenWidthBase, st_sheenWidthAuto, st_autoAuthority);
  st_shineL += st_sheenWidth*st_shSide;
  st_shineR -= st_sheenWidth*st_shSide;

  // AFTERIMAGE: longer taps from the SAME shimmer/fluid memory, strongly center-returning.
  // It cannot feed PE2 or source analysis and is tiny even before the 0-15% output injection.
  st_afterRawL = 0.48*st_tapL4 + 0.32*st_tapR5 + 0.20*st_tapL6;
  st_afterRawR = 0.48*st_tapR4 + 0.32*st_tapL5 + 0.20*st_tapR6;
  st_afterMid = 0.5*(st_afterRawL + st_afterRawR);
  st_afterSide = 0.5*(st_afterRawL - st_afterRawR);
  st_afterGain = st_autoAuthority * (0.010 + 0.040*st_actAfter) * st_guard * (0.78 + 0.22*st_silkyAmt);
  st_afterWidth = 0.08 + 0.16*st_actWrap*(1-st_actAfter);
  st_afterL = (st_afterMid + st_afterWidth*st_afterSide) * st_afterGain;
  st_afterR = (st_afterMid - st_afterWidth*st_afterSide) * st_afterGain;

  st_genL = st_bodyAddL + st_residueAddL + st_detailAddL + st_detailSnapAddL + st_detailSheenAddL + st_snapL + st_shineL + st_fluidL + st_afterL;
  st_genR = st_bodyAddR + st_residueAddR + st_detailAddR + st_detailSnapAddR + st_detailSheenAddR + st_snapR + st_shineR + st_fluidR + st_afterR;

  // Generated-path correlation and mono survival are observed AFTER width/afterimage.
  // These values govern the NEXT samples' width authority, creating a fast closed-loop safety governor.
  st_genPowL += (st_genL*st_genL-st_genPowL) * st_corrCoef;
  st_genPowR += (st_genR*st_genR-st_genPowR) * st_corrCoef;
  st_genCross += (st_genL*st_genR-st_genCross) * st_corrCoef;
  st_genMidNow = 0.5*(st_genL+st_genR);
  st_genSideNow = 0.5*(st_genL-st_genR);
  st_genMidPow += (st_genMidNow*st_genMidNow-st_genMidPow) * st_corrCoef;
  st_genSidePow += (st_genSideNow*st_genSideNow-st_genSidePow) * st_corrCoef;
  st_genCorr = st_clamp(st_genCross / sqrt(st_genPowL*st_genPowR + 0.000000001), -1, 1);
  st_monoSurvival = st_clamp01(sqrt(st_genMidPow / (st_genMidPow + st_genSidePow + 0.000000001)));

  // Safety is evaluated AFTER the tiny parallel injection. Internal synthesis is allowed to stay hot.
  st_genPeak = max(abs(st_genL), abs(st_genR));
  st_genEnv += (st_genPeak-st_genEnv) * (st_genPeak > st_genEnv ? st_genAtk : st_genRel);
  st_injectedEnv = st_genEnv * st_injection;
  st_injectedPeak = st_genPeak * st_injection;
  st_injectedRatio = st_injectedEnv / (st_slowEnv + 0.0030);
  // Spend more of the SAME tiny budget on FLASH/BLOOM, then tighten again for WRAP/AFTERIMAGE.
  // This prevents the master governor from flattening the very event contrast v3.3 is trying to create.
  st_eventSpend = 1 + st_autoAuthority*(0.62*st_actFlash + 0.20*st_actBloom);
  st_targetRatio = (0.035 + 0.72*st_injection) * st_eventSpend;
  st_energyGov = 1 / (1 + max(st_injectedRatio-st_targetRatio, 0) * 4.20);
  st_peakAllowance = (0.035 + 0.78*st_injection + 0.12*st_amp) * (1 + st_autoAuthority*0.48*st_actFlash);
  st_peakGov = min(1, st_peakAllowance / (st_injectedPeak + 0.000100));
  st_masterTarget = min(st_energyGov, st_peakGov);
  st_masterGov += (st_masterTarget-st_masterGov) * (st_masterTarget < st_masterGov ? st_masterAtk : st_masterRel);


  st_out_l=st_input_l+st_genL*st_masterGov*st_injection;
  st_out_r=st_input_r+st_genR*st_masterGov*st_injection;
);

function st_process(st_input_l,st_input_r)
local(st_input_peak,st_output_peak,st_ramp_target)
(
  st_out_l=st_input_l; st_out_r=st_input_r;
  st_input_peak=max(abs(st_input_l),abs(st_input_r));
  st_amount>0 || st_running ? (
    st_input_peak>0.000000000001 ? (
      !st_running ? (
        st_had_source ? st_recover_sleep();
        st_current_amount=0;
        st_ramp_left=st_ramp_samples;
        st_tune();
      );
      st_running=1; st_had_source=1;
      st_idle_samples=0; st_quiet_count=0; st_forced_idle=0;
    );
    st_running && st_had_source ? (
      st_ramp_target=st_forced_idle ? 0 : st_amount;
      st_ramp_left>0 ? (
        st_current_amount += (st_ramp_target-st_current_amount)/st_ramp_left;
        st_ramp_left-=1;
      ) : st_current_amount=st_ramp_target;
      st_current_amount>0 ? (
        st_render(st_input_l,st_input_r);
        st_process_count+=1;
        st_input_peak<=0.000000000001 ? (
          st_idle_samples+=1;
          st_output_peak=max(abs(st_out_l-st_input_l),abs(st_out_r-st_input_r));
          st_output_peak<0.0000000001 ? st_quiet_count+=1 : st_quiet_count=0;
          st_idle_samples>0.060*srate && st_quiet_count>=st_quiet_window ? (
            st_running=0; st_current_amount=0; st_sleep_samples=0;
          ) : st_idle_samples>2*srate && !st_forced_idle ? (
            st_forced_idle=1; st_ramp_left=st_ramp_samples;
          );
        );
      ) : (
        st_running=0; st_sleep_samples=0;
      );
    ) : st_sleep_samples+=1;
  );
);

// Sample v71: source-adaptive spectral contour, derived from Vocal Contour MX.
// @init helper snippet. Host owns routing, enable fades and PDC.
// No source classifier: flatness, energy share, decay and persistence are evidence.
function sc_clamp(sc_v,sc_lo,sc_hi) (max(sc_lo,min(sc_hi,sc_v)););
function sc_sat(sc_v) (max(0,min(1,sc_v)););
function sc_smooth(sc_v) local(sc_t) (sc_t=sc_sat(sc_v);sc_t*sc_t*(3-2*sc_t););
function sc_powdb(sc_v) (10*log(max(.000000000000000000000000000001,sc_v))/log(10););
function sc_amp(sc_v) (exp(sc_v*.1151292546497022842););
function sc_time(sc_ms) (1-exp(-sc_dt/max(.001,sc_ms*.001)););
function sc_soft_over(sc_d,sc_k) (
 sc_k<=.0001?max(0,sc_d):sc_d<=-sc_k*.5?0:sc_d>=sc_k*.5?sc_d:(sc_d+sc_k*.5)^2/(2*sc_k);
);
function sc_pos(sc_hz) (31*log(max(20,sc_hz)/20)/sc_log_span;);

// Large state is invalidated with generation tags, never cleared at a note edge.
// Only the 32-band detector bank is reset. Debug counters remain cumulative.
function sc_reset() local(sc_i) (
 sc_epoch+=1;
 sc_write=0;sc_read=0;sc_hopcount=0;sc_drain=0;sc_running=0;
 sc_global_prev=-180;sc_global_art=0;sc_global_silence=1;sc_cold=1;
 sc_aggr_s=sc_aggression;
 sc_gr_tail=0;sc_gr_noise=0;sc_gr_res=0;sc_gr_total=0;
 sc_i=0;loop(32,
   sc_bprev[sc_i]=-180;sc_bfast[sc_i]=-180;sc_bref[sc_i]=-180;
   sc_bhold[sc_i]=0;sc_btail[sc_i]=0;sc_bnoisegr[sc_i]=0;sc_bart[sc_i]=0;
   sc_bdecay[sc_i]=0;sc_bdominance[sc_i]=0;
   sc_btrend[sc_i]=0;sc_bfallage[sc_i]=0;
   sc_i+=1;
 );
 sc_out_l=0;sc_out_r=0;
);
function sc_config(sc_amount) (
 sc_aggression=sc_sat(sc_amount);
);
function sc_targets() local(sc_a) (
 sc_aggr_s+=sc_param_a*(sc_aggression-sc_aggr_s);sc_a=sc_aggr_s;
 sc_tail_amt=sc_a;
 sc_noise_amt=sc_smooth((sc_a-.20)/.80);
 sc_res_amt=sc_smooth((sc_a-.35)/.65);
 sc_cap=18*sc_a;
 sc_tail_gap=14-10*sc_a;
 sc_exp_ratio=1+3*sc_a;sc_knee=6;
 sc_hold_time=(60-40*sc_a)*.001;
 sc_close_a=sc_time(180-100*sc_a);sc_open_a=sc_time(8);
 sc_ref_drop=18*sc_dt/(.65+.65*sc_a);
 sc_res_threshold=9-4*sc_a;
 sc_res_persist=(220-100*sc_a)*.001;
 sc_res_a=sc_time(150-60*sc_a);sc_noise_a=sc_time(130-50*sc_a);
 sc_decay_authority=sc_smooth((sc_a-.25)/.75);
);
function sc_init(sc_base) local(sc_p,sc_i,sc_hz) (
 sc_sr=sc_clamp(srate,8000,768000);
 // Match source time resolution until8192 cap: 2048 at44.1/48k,4096 at88.2/96k.
 sc_n=512;while(sc_n<2048*sc_sr/48000&&sc_n<8192)(sc_n*=2;);
 sc_k=sc_n/2;sc_hop=sc_n/4;sc_ringn=2*sc_n;sc_dt=sc_hop/sc_sr;
 sc_inv_n=1/sc_n;sc_power_norm=1/(sc_n*sc_n*.375);
 sc_log_span=log(max(40,min(20000,sc_sr*.5))/20);
 // Both complex FFT buffers fit inside one64k page at the largest supported N.
 sc_p=ceil(max(0,sc_base)/65536)*65536;
 sc_fft_l=sc_p;sc_p+=2*sc_n;sc_fft_r=sc_p;sc_p+=2*sc_n;
 sc_window=sc_p;sc_p+=sc_n;
 sc_in_l=sc_p;sc_p+=sc_n;sc_in_r=sc_p;sc_p+=sc_n;
 sc_in_tag=sc_p;sc_p+=sc_n;
 sc_ola_l=sc_p;sc_p+=sc_ringn;sc_ola_r=sc_p;sc_p+=sc_ringn;
 sc_ola_tag=sc_p;sc_p+=sc_ringn;
 sc_power=sc_p;sc_p+=sc_k+1;sc_prefix=sc_p;sc_p+=sc_k+2;
 sc_res_raw=sc_p;sc_p+=sc_k+1;sc_res_state=sc_p;sc_p+=sc_k+1;
 sc_res_timer=sc_p;sc_p+=sc_k+1;sc_res_tag=sc_p;sc_p+=sc_k+1;
 sc_binpos=sc_p;sc_p+=sc_k+1;sc_radius=sc_p;sc_p+=sc_k+1;
 sc_band_start=sc_p;
 sc_bsum=sc_p;sc_p+=32;sc_bcount=sc_p;sc_p+=32;sc_blog=sc_p;sc_p+=32;
 sc_bpeak=sc_p;sc_p+=32;sc_bprev=sc_p;sc_p+=32;sc_bfast=sc_p;sc_p+=32;
 sc_bref=sc_p;sc_p+=32;sc_bhold=sc_p;sc_p+=32;sc_btail=sc_p;sc_p+=32;
 sc_bnoisegr=sc_p;sc_p+=32;sc_btone=sc_p;sc_p+=32;sc_bnoise=sc_p;sc_p+=32;
 sc_bart=sc_p;sc_p+=32;sc_bdecay=sc_p;sc_p+=32;sc_bdominance=sc_p;sc_p+=32;
 sc_btrend=sc_p;sc_p+=32;sc_bfallage=sc_p;sc_p+=32;
 sc_mem_end=sc_p;
 // Init-only clears are restricted to generation arrays and a small band bank.
 memset(sc_in_tag,0,sc_n);memset(sc_ola_tag,0,sc_ringn);
 memset(sc_res_tag,0,sc_k+1);memset(sc_band_start,0,32*17);
 sc_i=0;loop(sc_n,sc_window[sc_i]=.5-.5*cos(2*$pi*sc_i/sc_n);sc_i+=1;);
 sc_i=0;loop(sc_k+1,
   sc_hz=sc_i*sc_sr/sc_n;
   sc_binpos[sc_i]=sc_clamp(sc_pos(sc_hz),0,31);
   sc_radius[sc_i]=max(2,floor(sc_i*.12));sc_i+=1;
 );
 sc_param_a=sc_time(25);sc_fast_a=sc_time(8);sc_fast_r=sc_time(45);
 sc_trend_a=sc_time(100);
 sc_art_r=exp(-sc_dt/.065);
 sc_epoch=0;sc_aggression=0;sc_frame_count=0;sc_process_count=0;sc_faults=0;
 sc_reset();sc_mem_end;
);

function sc_frame() local(sc_i,sc_j,sc_idx,sc_w,sc_lr,sc_li,sc_rr,sc_ri,
 sc_p,sc_q,sc_b,sc_b1,sc_frac,sc_wt,sc_total,sc_totaldb,sc_onset_global,
 sc_level,sc_flat,sc_crest,sc_noise,sc_tone,sc_prev,sc_rise,sc_onset,sc_ref,
 sc_req,sc_a,sc_art,sc_protect,sc_diff,sc_ps,sc_lo,sc_hi,sc_env,sc_prom,
 sc_age,sc_raw,sc_rt,sc_rb,sc_rrq,sc_ratio,sc_g,sc_sum,sc_body,sc_tailfade,
 sc_noise_sum,sc_global_noise,sc_dominance,sc_context,sc_summean,sc_weak,
 sc_fall,sc_decay,sc_release) (
 sc_frame_count+=1;sc_targets();
 // sc_write is the oldest input after the newest sample has been written.
 sc_i=0;loop(sc_n,
   sc_idx=(sc_write+sc_i)%sc_n;sc_w=sc_window[sc_i];
   sc_in_tag[sc_idx]==sc_epoch?(
     sc_fft_l[2*sc_i]=sc_in_l[sc_idx]*sc_w;
     sc_fft_r[2*sc_i]=sc_in_r[sc_idx]*sc_w;
   ):(sc_fft_l[2*sc_i]=0;sc_fft_r[2*sc_i]=0;);
   sc_fft_l[2*sc_i+1]=0;sc_fft_r[2*sc_i+1]=0;sc_i+=1;
 );
 fft(sc_fft_l,sc_n);fft_permute(sc_fft_l,sc_n);
 fft(sc_fft_r,sc_n);fft_permute(sc_fft_r,sc_n);
 memset(sc_bsum,0,32*4);
 sc_prefix[0]=0;sc_total=0;
 sc_i=0;loop(sc_k+1,
   sc_lr=sc_fft_l[2*sc_i];sc_li=sc_fft_l[2*sc_i+1];
   sc_rr=sc_fft_r[2*sc_i];sc_ri=sc_fft_r[2*sc_i+1];
   sc_p=.5*(sc_lr*sc_lr+sc_li*sc_li+sc_rr*sc_rr+sc_ri*sc_ri);
   sc_power[sc_i]=sc_p;sc_prefix[sc_i+1]=sc_prefix[sc_i]+sc_p;
   sc_q=sc_p*sc_power_norm*(sc_i>0&&sc_i<sc_k?2:1);sc_total+=sc_q;
   sc_ps=sc_binpos[sc_i];sc_b=floor(sc_ps);sc_b1=min(31,sc_b+1);sc_frac=sc_ps-sc_b;
   sc_wt=1-sc_frac;
   sc_bsum[sc_b]+=sc_wt*sc_q;sc_bcount[sc_b]+=sc_wt;
   sc_blog[sc_b]+=sc_wt*log(max(.000000000000000000000000000001,sc_q));
   sc_bpeak[sc_b]=max(sc_bpeak[sc_b],sc_q);
   sc_b1!=sc_b&&sc_frac>0?(
     sc_bsum[sc_b1]+=sc_frac*sc_q;sc_bcount[sc_b1]+=sc_frac;
     sc_blog[sc_b1]+=sc_frac*log(max(.000000000000000000000000000001,sc_q));
     sc_bpeak[sc_b1]=max(sc_bpeak[sc_b1],sc_q);
   );sc_i+=1;
 );
 sc_totaldb=sc_powdb(sc_total);
 sc_onset_global=sc_totaldb>-105&&(sc_global_prev<-105||sc_totaldb-sc_global_prev>5);
 sc_totaldb<-110?sc_global_silence+=sc_dt:sc_global_silence=0;
 sc_global_art=max(sc_global_art*sc_art_r,sc_onset_global);sc_global_prev=sc_totaldb;
 sc_noise_sum=0;
 // Describe the current source before deciding whether flatness is unwanted.
 sc_i=0;loop(32,
   sc_bcount[sc_i]>1.5&&sc_bsum[sc_i]>.000000000000000000000001?(
     sc_summean=sc_bsum[sc_i]/sc_bcount[sc_i];
     sc_flat=exp(sc_blog[sc_i]/sc_bcount[sc_i])/sc_summean;
     sc_crest=sc_bpeak[sc_i]/max(.000000000000000000000001,sc_summean);
     sc_noise=sc_sat((sc_flat-.08)/.48);
     sc_tone=max(1-sc_noise,sc_sat((sc_crest-3)/10));
   ):(sc_noise=0;sc_tone=1;);
   sc_bnoise[sc_i]=sc_noise;sc_btone[sc_i]=sc_tone;
   sc_noise_sum+=sc_noise*sc_bsum[sc_i];
   sc_bdominance[sc_i]=sc_smooth((sc_bsum[sc_i]/max(.000000000000000000000001,sc_total)-.035)/.18);
   sc_i+=1;
 );
 sc_global_noise=sc_noise_sum/max(.000000000000000000000001,sc_total);
 sc_i=0;loop(32,
   sc_level=sc_powdb(sc_bsum[sc_i]);sc_prev=sc_bprev[sc_i];sc_rise=sc_level-sc_prev;
   sc_noise=sc_bnoise[sc_i];sc_tone=sc_btone[sc_i];sc_dominance=sc_bdominance[sc_i];
   sc_onset=(sc_level>-115&&(sc_rise>4||sc_onset_global));
   sc_art=max(sc_bart[sc_i]*sc_art_r,sc_sat((sc_rise-1)/8));sc_bart[sc_i]=sc_art;
   sc_a=sc_level>sc_bfast[sc_i]?sc_fast_a:sc_fast_r;
   sc_bfast[sc_i]+=sc_a*(sc_level-sc_bfast[sc_i]);
   sc_onset||sc_cold?(
     sc_bref[sc_i]=max(-150,sc_level);sc_bhold[sc_i]=sc_hold_time;sc_bfast[sc_i]=sc_level;
     sc_btrend[sc_i]=0;sc_bfallage[sc_i]=0;
   ):(
     sc_bref[sc_i]=max(sc_level,sc_bref[sc_i]-sc_ref_drop);
     sc_bhold[sc_i]=max(0,sc_bhold[sc_i]-sc_dt);
   );
   sc_global_silence>.30?(sc_bref[sc_i]=sc_level;sc_bfast[sc_i]=sc_level;sc_bhold[sc_i]=0;);
   sc_ref=sc_bref[sc_i];sc_diff=sc_ref-sc_tail_gap-sc_bfast[sc_i];
   // A sustained signed downward trend distinguishes a ringing decay from
   // stable tonal body. Positive and negative fluctuations cancel in the
   //100ms tracker; protection is not relaxed by flatness/prominence alone.
   sc_fall=sc_clamp((sc_prev-sc_level)/sc_dt,-120,120);
   sc_onset||sc_cold?sc_fall=0;
   sc_btrend[sc_i]+=sc_trend_a*(sc_fall-sc_btrend[sc_i]);
   sc_btrend[sc_i]>3&&sc_level>-140&&!sc_onset?(
     sc_bfallage[sc_i]=min(.30,sc_bfallage[sc_i]+sc_dt);
   ):sc_bfallage[sc_i]=max(0,sc_bfallage[sc_i]-2*sc_dt);
   sc_decay=sc_smooth((sc_bfallage[sc_i]-.06)/.14)*sc_smooth((sc_btrend[sc_i]-3)/12);
   sc_release=sc_decay_authority*sc_decay;
   sc_body=(1-.90*sc_tone*(1-sc_release))*(1-.50*sc_dominance*(1-sc_release));
   sc_protect=sc_body*(1-.97*max(sc_art,sc_global_art));
   sc_tailfade=sc_smooth((sc_ref-sc_level-1)/5);sc_bdecay[sc_i]=sc_decay;
   sc_req=sc_soft_over(sc_diff,sc_knee)*(sc_exp_ratio-1)*sc_tail_amt*sc_tailfade*sc_protect;
   sc_bhold[sc_i]>0||sc_level<-150?sc_req=0;
   sc_req=sc_clamp(sc_req,0,48);sc_a=sc_req>sc_btail[sc_i]?sc_close_a:sc_open_a;
   sc_btail[sc_i]+=sc_a*(sc_req-sc_btail[sc_i]);
   // Noise is only residue evidence when decaying, or weak beside structured
   // material. A steady noise source does not lose its main texture by default.
   sc_raw=sc_sat((sc_noise-.35)/.65);
   sc_weak=1-sc_dominance;
   sc_context=max(sc_tailfade,(1-sc_global_noise)*sc_weak*.55);
   sc_req=9*sc_noise_amt*sc_raw*sc_context*sc_protect;
   sc_totaldb<-110||sc_level<-140?sc_req=0;
   sc_a=sc_req>sc_bnoisegr[sc_i]?sc_noise_a:sc_open_a;
   sc_bnoisegr[sc_i]+=sc_a*(sc_req-sc_bnoisegr[sc_i]);
   sc_bprev[sc_i]=sc_level;sc_i+=1;
 );
 sc_cold=0;
 sc_i=1;loop(sc_k-1,
   sc_res_tag[sc_i]!=sc_epoch?(
     sc_res_timer[sc_i]=0;sc_res_state[sc_i]=0;sc_res_tag[sc_i]=sc_epoch;
   );
   sc_ps=sc_binpos[sc_i];sc_b=floor(sc_ps);sc_b1=min(31,sc_b+1);sc_frac=sc_ps-sc_b;
   sc_tone=sc_btone[sc_b]*(1-sc_frac)+sc_btone[sc_b1]*sc_frac;
   sc_dominance=sc_bdominance[sc_b]*(1-sc_frac)+sc_bdominance[sc_b1]*sc_frac;
   sc_art=max(sc_global_art,sc_bart[sc_b]*(1-sc_frac)+sc_bart[sc_b1]*sc_frac);
   sc_decay=sc_bdecay[sc_b]*(1-sc_frac)+sc_bdecay[sc_b1]*sc_frac;
   sc_release=sc_decay_authority*sc_decay;
   sc_protect=(1-.90*sc_tone*(1-sc_release))*(1-.65*sc_dominance*(1-sc_release))*(1-.97*sc_art);
   sc_raw=0;
   sc_res_amt>0&&sc_totaldb>-110?(
     sc_lo=max(1,sc_i-sc_radius[sc_i]);sc_hi=min(sc_k-1,sc_i+sc_radius[sc_i]);
     sc_env=(sc_prefix[sc_hi+1]-sc_prefix[sc_lo])/max(1,sc_hi-sc_lo+1);
     sc_prom=sc_powdb(sc_power[sc_i])-sc_powdb(sc_env);
     sc_age=sc_res_timer[sc_i];
     sc_prom>sc_res_threshold?sc_age=min(sc_res_persist*2,sc_age+sc_dt):sc_age=max(0,sc_age-sc_dt*2);
     sc_res_timer[sc_i]=sc_age;
     sc_raw=sc_soft_over(sc_prom-sc_res_threshold,3)*sc_res_amt*
       sc_smooth(sc_age/sc_res_persist)*sc_protect*(.25+.75*sc_decay);
   ):sc_res_timer[sc_i]=0;
   sc_res_raw[sc_i]=sc_clamp(sc_raw,0,48);sc_i+=1;
 );
 sc_res_raw[0]=0;sc_res_raw[sc_k]=0;sc_res_state[0]=0;sc_res_state[sc_k]=0;
 sc_gr_tail=0;sc_gr_noise=0;sc_gr_res=0;sc_gr_total=0;
 sc_i=0;loop(sc_k+1,
   sc_ps=sc_binpos[sc_i];sc_b=floor(sc_ps);sc_b1=min(31,sc_b+1);sc_frac=sc_ps-sc_b;
   sc_rt=sc_btail[sc_b]*(1-sc_frac)+sc_btail[sc_b1]*sc_frac;
   sc_rb=sc_bnoisegr[sc_b]*(1-sc_frac)+sc_bnoisegr[sc_b1]*sc_frac;
   sc_i>0&&sc_i<sc_k?sc_raw=(sc_res_raw[sc_i-1]+2*sc_res_raw[sc_i]+sc_res_raw[sc_i+1])*.25:sc_raw=0;
   sc_a=sc_raw>sc_res_state[sc_i]?sc_res_a:sc_open_a;
   sc_res_state[sc_i]+=sc_a*(sc_raw-sc_res_state[sc_i]);sc_rrq=sc_res_state[sc_i];
   // DC and Nyquist stay neutral. Equal stereo gains preserve the image.
   sc_i==0||sc_i==sc_k?(sc_rt=0;sc_rb=0;sc_rrq=0;);
   sc_sum=sc_rt+sc_rb+sc_rrq;sc_ratio=sc_sum>.000000001?min(1,sc_cap/sc_sum):1;
   sc_rt*=sc_ratio;sc_rb*=sc_ratio;sc_rrq*=sc_ratio;sc_sum=sc_rt+sc_rb+sc_rrq;
   sc_gr_tail=max(sc_gr_tail,sc_rt);sc_gr_noise=max(sc_gr_noise,sc_rb);
   sc_gr_res=max(sc_gr_res,sc_rrq);sc_gr_total=max(sc_gr_total,sc_sum);
   sc_g=sc_amp(-sc_sum);
   sc_fft_l[2*sc_i]*=sc_g;sc_fft_l[2*sc_i+1]*=sc_g;
   sc_fft_r[2*sc_i]*=sc_g;sc_fft_r[2*sc_i+1]*=sc_g;
   sc_i>0&&sc_i<sc_k?(
     sc_j=sc_n-sc_i;
     sc_fft_l[2*sc_j]*=sc_g;sc_fft_l[2*sc_j+1]*=sc_g;
     sc_fft_r[2*sc_j]*=sc_g;sc_fft_r[2*sc_j+1]*=sc_g;
   );sc_i+=1;
 );
 fft_ipermute(sc_fft_l,sc_n);ifft(sc_fft_l,sc_n);
 fft_ipermute(sc_fft_r,sc_n);ifft(sc_fft_r,sc_n);
 // Four periodic Hann squared windows sum to1.5; FFT roundtrip contributes N.
 // Input sample n appears at n+N, including startup with zero-padded history.
 sc_i=0;loop(sc_n,
   sc_idx=(sc_read+1+sc_i)%sc_ringn;sc_w=sc_window[sc_i]*(2/3)*sc_inv_n;
   sc_ola_tag[sc_idx]!=sc_epoch?(
     sc_ola_l[sc_idx]=0;sc_ola_r[sc_idx]=0;sc_ola_tag[sc_idx]=sc_epoch;
   );
   sc_ola_l[sc_idx]+=sc_fft_l[2*sc_i]*sc_w;
   sc_ola_r[sc_idx]+=sc_fft_r[2*sc_i]*sc_w;sc_i+=1;
 );
);

function sc_process(sc_l,sc_r) (
 sc_out_l=sc_l;sc_out_r=sc_r;
 sc_aggression>0?(
   // Reject invalid values, not finite audio peaks; there is no output limiter.
   (!(sc_l==sc_l)||abs(sc_l)>1000000000000)?(sc_l=0;sc_faults+=1;);
   (!(sc_r==sc_r)||abs(sc_r)>1000000000000)?(sc_r=0;sc_faults+=1;);
   abs(sc_l)<.000000000000000000000000000001?sc_l=0;
   abs(sc_r)<.000000000000000000000000000001?sc_r=0;
   abs(sc_l)>0||abs(sc_r)>0?(
     sc_running<=0?(sc_reset();sc_running=1;);
     sc_drain=2*sc_n+sc_hop;
   );
   sc_running>0?(
     sc_process_count+=1;
     sc_in_l[sc_write]=sc_l;sc_in_r[sc_write]=sc_r;sc_in_tag[sc_write]=sc_epoch;
     sc_write+=1;sc_write>=sc_n?sc_write=0;
     sc_hopcount+=1;sc_hopcount>=sc_hop?(sc_hopcount=0;sc_frame(););
     sc_ola_tag[sc_read]==sc_epoch?(
       sc_out_l=sc_ola_l[sc_read];sc_out_r=sc_ola_r[sc_read];
       sc_ola_l[sc_read]=0;sc_ola_r[sc_read]=0;
     ):(sc_out_l=0;sc_out_r=0;);
     sc_read+=1;sc_read>=sc_ringn?sc_read=0;
     sc_drain-=1;
     sc_drain<=0?(sc_running=0;sc_gr_tail=0;sc_gr_noise=0;sc_gr_res=0;sc_gr_total=0;);
   ):(sc_out_l=0;sc_out_r=0;);
 ):(sc_running=0;);
);

/*
Runtime sample-pool API used here:
  pool  = sample_pool_from_slot(slot, #name);
  sample_pool_commit(pool);
  id    = sample_get(pool, index);
  value = sample_read_interp(pool, id, channel, phase);

Decoded audio is held outside JSFX mem[] as packed float32 by the runtime.
This keeps large banks from expanding into 64-bit JSFX double cells.

This instrument stays load-and-go:
- slot 0 is polled automatically
- sample_pool_generation() detects completed reloads
- the metadata rebuild is deferred until voices are idle
- no zones or bank metadata are required
*/

function clamp(x lo hi)
(
  min(hi, max(lo, x));
);

function clamp01(x)
(
  clamp(x, 0, 1);
);

function denorm_zap(x)
(
  abs(x) < DENORM_CUT ? 0 : x;
);

function denorm_guard_tick()
(
  denorm_flip = -denorm_flip;
  denorm_flip * DENORM_GUARD_LEVEL;
);

function denorm_near_silence(l r)
(
  (abs(l) + abs(r)) < DENORM_AUDIO_FLOOR;
);


function pack_get_base(pack idx base) local(v i)
(
  v = floor(pack + 0.5);
  i = 0;
  while (i < idx) (
    v = floor(v / base);
    i += 1;
  );
  v % base;
);

function pack_set_base(pack idx base val) local(v i pow cur nv)
(
  v = floor(pack + 0.5);
  pow = 1;
  i = 0;
  while (i < idx) (
    pow *= base;
    i += 1;
  );
  cur = floor(v / pow) % base;
  nv = clamp(val | 0, 0, base - 1);
  v + (nv - cur) * pow;
);

function wrap_in_range(x lo hi) local(span)
(
  span = max(1, hi - lo);
  while (x < lo) (x += span;);
  while (x >= hi) (x -= span;);
  x;
);

function curve_denorm(norm vmin vmax mode) local(n ratio)
(
  n = clamp01(norm);
  mode == CURVE_TIME ? (
    ratio = max(vmax / max(vmin, 0.000001), 1.000001);
    exp(log(max(vmin, 0.000001)) + n * log(ratio));
  ) : mode == CURVE_SUSTAIN ? (
    sqrt(n);
  ) : (
    vmin + n * (vmax - vmin);
  );
);

function curve_norm(val vmin vmax mode) local(v ratio)
(
  v = clamp(val, vmin, vmax);
  mode == CURVE_TIME ? (
    ratio = max(vmax / max(vmin, 0.000001), 1.000001);
    clamp01(log(max(v, 0.000001) / max(vmin, 0.000001)) / log(ratio));
  ) : mode == CURVE_SUSTAIN ? (
    clamp01(v * v);
  ) : (
    clamp01((v - vmin) / max(vmax - vmin, 0.000001));
  );
);

function env_curve01(t) local(k d)
(
  k = ENV_VIS_SHAPE;
  d = 1 - exp(-k);
  d <= 0 ? clamp01(t) : (1 - exp(-k * clamp01(t))) / d;
);

function env_slope_shape(t slope_pct) local(n a p d)
(
  n = clamp01(t);
  a = clamp(slope_pct, -100, 100) / 100;

  abs(a) < 0.000001 ? (
    n;
  ) : a >= 0.999999 ? (
    // Full positive slope is the original one-pole envelope curve.
    env_curve01(n);
  ) : a > 0 ? (
    // Positive: fast start, slow finish.
    p = 1 + a * (ENV_VIS_SHAPE - 1);
    1 - ((1 - n) ^ p);
  ) : (
    // Negative: slow start, fast finish.
    p = 1 + (-a) * (ENV_VIS_SHAPE - 1);
    n ^ p;
  );
);

function env_slope_inv(y slope_pct) local(n a p d)
(
  n = clamp01(y);
  a = clamp(slope_pct, -100, 100) / 100;

  abs(a) < 0.000001 ? (
    n;
  ) : a >= 0.999999 ? (
    d = 1 - exp(-ENV_VIS_SHAPE);
    d <= 0 ? n : clamp01(-log(max(0.000000001, 1 - n * d)) / ENV_VIS_SHAPE);
  ) : a > 0 ? (
    p = 1 + a * (ENV_VIS_SHAPE - 1);
    1 - ((1 - n) ^ (1 / p));
  ) : (
    p = 1 + (-a) * (ENV_VIS_SHAPE - 1);
    n ^ (1 / p);
  );
);

function env_segment_slope(raw_slope polarity)
(
  clamp(raw_slope, -100, 100) * polarity;
);

function env_slope_is_classic(raw_slope polarity)
(
  env_segment_slope(raw_slope, polarity) >= 99.999;
);

function env_migrate_old_slope(v polarity)
(
  v == 0 ? (polarity == ENV_RISE ? 100 : -100)
  : v == 1 ? 0
  : v == 2 ? (polarity == ENV_RISE ? -70 : 70)
  : v == 3 ? (polarity == ENV_RISE ? 70 : -70)
  : v == 4 ? 0
  : v;
);

function stretch_window(age gsize) local(n denom)
(
  // Periodic Hann window for COLA-friendly grain overlap.
  // With a 25%% hop (4x overlap), the summed window is constant.
  n = clamp(age, 0, max(0, gsize - 1));
  denom = max(gsize, 1);
  0.5 - 0.5 * cos(6.283185307179586 * n / denom);
);

function lerp(a b t)
(
  a + (b-a)*t;
);

function stretch_window_morph(age gsize flatness) local(n hann fade edge tuk)
(
  // v35 MacroGrain OLAGlue: small grains keep Hann. Long coherent grains morph
  // toward a cosine-edged flat-top window so full-event material is not forced
  // through a huge whole-window fade.
  hann = stretch_window(age, gsize);
  flatness = clamp01(flatness);
  flatness <= 0.0001 ? (
    hann;
  ) : (
    n = clamp01(age / max(1, gsize - 1));
    fade = lerp(0.50, 0.17, flatness);
    n < fade ? (
      edge = n / max(0.000001, fade);
      tuk = 0.5 - 0.5 * cos(3.141592653589793 * edge);
    ) : n > (1 - fade) ? (
      edge = (1 - n) / max(0.000001, fade);
      tuk = 0.5 - 0.5 * cos(3.141592653589793 * edge);
    ) : (
      tuk = 1;
    );
    lerp(hann, tuk, flatness);
  );
);


function db2amp(db)
(
  exp(db * 0.11512925464970229);
);

function midi_ratio(semi)
(
  exp(semi * 0.0577622650466621);
);

function cents_ratio(cents)
(
  exp(cents * 0.000577622650466621);
);

function mono_frame(ptr nch frame) local(l r)
(
  // SM_PTR stores a runtime sample-pool ID, not a mem[] pointer.
  nch >= 2 ? (
    l = sample_read(bank_pool, ptr, 0, frame);
    r = sample_read(bank_pool, ptr, 1, frame);
    mono_source ? 0.5 * (l + r) : (analysis_channel_base[ptr] > 0 ? r : l);
  ) : (
    sample_read(bank_pool, ptr, 0, frame);
  );
);

function sample_frame2(ptr nch phase) local(ok l r)
(
  ok = sample_read2_interp(bank_pool, ptr, phase, l, r);
  mono_source ? (
    l = 0.5 * (l + r);
    r = l;
  );
  readL = l;
  readR = r;
  ok;
);

// v70 Sample MIDI Hub: all protocol and event execution runs inside Sample.
function hub_random(n) local(hi lo next)
(
  hub_rng_on ? (
    // Schrage's Park-Miller step: EEL/compiler % converts operands to i32.
    // A direct seed*16807 remainder overflows and collapses into short cycles.
    hi = floor(hub_rng / 127773);
    lo = hub_rng - hi * 127773;
    next = 16807 * lo - 2836 * hi;
    next <= 0 ? next += 2147483647;
    hub_rng = next;
    n * hub_rng / 2147483647;
  ) : rand(n);
);

function hub_wrap_phase(phase lo hi xf) local(period excess)
(
  phase >= hi ? (
    period = max(1, hi - lo - xf);
    excess = phase - hi;
    // Preserve sub-sample phase; EEL % is an integer remainder.
    phase = lo + xf + excess - floor(excess / period) * period;
  );
  phase;
);

function hub_smooth(u) local(t)
(
  t = clamp01(u); t * t * (3 - 2 * t);
);

function hub_log(action id target result reason source duration boundary fill chan) local(p)
(
  hub_log_base > 0 ? (
    p = hub_log_base + hub_log_head * 12;
    p[0] = hub_log_serial + 1; p[1] = event_clock_samps / max(1, srate);
    p[2] = action; p[3] = id; p[4] = target; p[5] = result;
    p[6] = reason; p[7] = source; p[8] = duration;
    p[9] = boundary; p[10] = fill; p[11] = chan;
    hub_log_head = (hub_log_head + 1) % 100;
    hub_log_count = min(100, hub_log_count + 1);
    hub_log_serial += 1;
    result == 1 ? (hub_log_accepted += 1; hub_accept_count += 1;);
    result < 0 ? (hub_log_rejected += 1; hub_reject_count += 1;);
  );
);

function hub_find_voice(id) local(i v found)
(
  found = -1; i = 0;
  id > 0 ? (while(i < MAX_VOICES && found < 0) (
    v = voice_base + i * VC_STRIDE;
    v[VC_ACTIVE] > 0 && v[VC_HUB_ID] == id ? found = i;
    i += 1;
  ););
  found;
);

function hub_find_mod(id) local(i p found)
(
  found = -1; i = 0;
  id > 0 && hub_mod_count > 0 ? (while(i < HUB_MOD_CAP && found < 0) (
    p = hub_mod_base + i * HM_STRIDE;
    p[HM_ACTIVE] > 0 && p[HM_ID] == id ? found = i;
    i += 1;
  ););
  found;
);

function hub_remove_mod(index reason) local(p v curr prev node guard)
(
  index >= 0 && index < HUB_MOD_CAP ? (
    p = hub_mod_base + index * HM_STRIDE;
    p[HM_ACTIVE] > 0 ? (
      v = voice_base + p[HM_VOICE] * VC_STRIDE;
      curr = v[VC_HUB_MODHEAD]; prev = 0; guard = 0;
      while(curr > 0 && guard < HUB_MOD_CAP) (
        node = hub_mod_base + (curr - 1) * HM_STRIDE;
        curr == index + 1 ? (
          prev > 0 ? hub_mod_base[(prev - 1) * HM_STRIDE + HM_NEXT] = node[HM_NEXT]
          : v[VC_HUB_MODHEAD] = node[HM_NEXT];
          curr = 0;
        ) : (prev = curr; curr = node[HM_NEXT];);
        guard += 1;
      );
      v[VC_HUB_REPLACE] == index + 1 ? v[VC_HUB_REPLACE] = 0;
      hub_log(p[HM_ACTION], p[HM_ID], p[HM_TARGET], 0, reason, v[VC_SAMPLE],
        p[HM_LEN] / max(1, srate), 0, 0, p[HM_CHAN]);
      p[HM_ACTIVE] = 0; p[HM_NEXT] = 0;
      hub_mod_count = max(0, hub_mod_count - 1);
    );
  );
);

function hub_cancel_voice(index reason) local(v guard)
(
  v = voice_base + index * VC_STRIDE;
  guard = 0;
  while(v[VC_HUB_MODHEAD] > 0 && guard < HUB_MOD_CAP) (
    hub_remove_mod(v[VC_HUB_MODHEAD] - 1, reason); guard += 1;
  );
  v[VC_HUB_ID] > 0 ? (
    hub_log(v[VC_HUB_ACTION], v[VC_HUB_ID], 0, 0, reason, v[VC_SAMPLE],
      (v[VC_HUB_END] - v[VC_HUB_START]) / max(1, srate), v[VC_HUB_BOUNDARY], v[VC_HUB_FILL], v[VC_CHAN]);
    v[VC_HUB_ID] = 0;
    hub_voice_count = max(0, hub_voice_count - 1);
  );
  v[VC_HUB_MODHEAD] = 0; v[VC_HUB_REPLACE] = 0;
);

function hub_reset(reason) local(i v)
(
  (hub_voice_count > 0 || hub_mod_count > 0) ? (
    i = 0;
    while(i < MAX_VOICES) (hub_cancel_voice(i, reason); i += 1;);
  );
  hub_packet_base > 0 ? memset(hub_packet_base, 0, 16 * HP_STRIDE);
  hub_mod_base > 0 ? memset(hub_mod_base, 0, HUB_MOD_CAP * HM_STRIDE);
  hub_voice_count = 0; hub_mod_count = 0; hub_rng_on = 0; hub_starting = 0; hub_pending_mask = 0;
  hub_epoch += 1;
);

function hub_request_finish(v len reason) local(now)
(
  now = event_clock_samps;
  v[VC_ACTIVE] > 0 && v[VC_HUB_ID] > 0 ? (
    // Same-offset Continue can cancel this request before a single audio sample.
    (v[VC_HUB_FINISH] <= 0 || now + len < v[VC_HUB_FSTART] + v[VC_HUB_FLEN]) ? (
      v[VC_HUB_FGAIN] = v[VC_HUB_FINISH] > 0 ? clamp01(v[VC_HUB_TERMINAL]) : 1;
      v[VC_HUB_FFROM] = v[VC_HUB_EFFECTIVE];
      v[VC_HUB_FBRIDGE] = max(1, min(floor(0.003 * srate), floor(len * 0.20)));
      v[VC_HUB_HANDOFF] = 0;
      v[VC_HUB_FINISH] = reason;
      v[VC_HUB_FSTART] = now;
      v[VC_HUB_FLEN] = max(1, floor(len));
      v[VC_HUB_FLEVEL] = max(0, v[VC_HUB_BASEENV]);
      v[VC_STAGE] = ENV_RELEASE;
      v[VC_EPHASE] = 0; v[VC_ESTART] = v[VC_ENV];
      v[VC_RLEN] = max(1, len); v[VC_RCURVE] = 0;
      v[VC_RSTEP] = exp(-6.90775527898214 / max(1, len));
    );
  );
);

function hub_stop_mod(index) local(p)
(
  p = hub_mod_base + index * HM_STRIDE;
  p[HM_ACTIVE] > 0 && p[HM_STOP] <= 0 ? (
    p[HM_STOP] = 1; p[HM_STOPSTART] = event_clock_samps;
    p[HM_STOPVAL] = p[HM_LAST];
    p[HM_STOPLEN] = max(1, min(floor(0.003 * srate), p[HM_LEN]));
  );
);

function hub_channel_end(chan hard) local(i p v)
(
  i = 0;
  while(i < HUB_MOD_CAP) (
    p = hub_mod_base + i * HM_STRIDE;
    p[HM_ACTIVE] > 0 && p[HM_CHAN] == chan ? (
      hard ? hub_remove_mod(i, 13) : hub_stop_mod(i);
    );
    i += 1;
  );
  i = 0;
  while(i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    v[VC_HUB_ID] > 0 && v[VC_CHAN] == chan ? (
      (hard || v[VC_ACTIVE] <= 0) ? hub_cancel_voice(i, 13) : hub_request_finish(v, v[VC_HUB_RELEASE], 13);
    );
    i += 1;
  );
  memset(hub_packet_base + chan * HP_STRIDE, 0, HP_STRIDE);
  hub_pending_mask &= 65535 - (1 << chan);
);

function hub_analyze_loop(sm) local(lo hi span xf candidate bestlo bestcost cost n k a b al ar bl br power diff sr minspan)
(
  // Bounded waveform matching: 8 candidates x 24 stereo tap pairs per file.
  // Run with bank analysis, never search the whole bank from a MIDI command.
  sm[SM_HUB_LOOPLO] = 0; sm[SM_HUB_LOOPHI] = 0; sm[SM_HUB_LOOPXF] = 0;
  sm[SM_HUB_LOOPQUALITY] = 0;
  sr = max(1, sm[SM_SR]);
  lo = max(sm[SM_HEADEND], sm[SM_ATTACK] + sr * 0.020);
  hi = min(sm[SM_TAILSTART], sm[SM_FRAMES] - 3);
  span = hi - lo; minspan = max(64, sr * 0.040);
  span >= minspan && sm[SM_RMS] > 0.000001 ? (
    xf = max(8, min(span * 0.18, sr * 0.018));
    bestcost = 1000000; bestlo = lo;
    k = 0;
    while(k < 8) (
      candidate = lo + k / 7 * min(span * 0.28, sr * 0.060);
      cost = 0; power = 0; n = 0;
      while(n < 24) (
        a = hi - xf + n / 23 * xf;
        b = candidate + n / 23 * xf;
        sample_frame2(sm[SM_PTR], sm[SM_NCH], a); al = readL; ar = readR;
        sample_frame2(sm[SM_PTR], sm[SM_NCH], b); bl = readL; br = readR;
        diff = (al - bl) * (al - bl) + (ar - br) * (ar - br);
        cost += diff; power += al * al + ar * ar + bl * bl + br * br;
        n += 1;
      );
      power > 96 * sm[SM_RMS] * sm[SM_RMS] * 0.0025 ? (
        cost /= max(0.000000000001, power);
        cost < bestcost ? (bestcost = cost; bestlo = candidate;);
      );
      k += 1;
    );
    bestcost < 0.75 ? (
      sm[SM_HUB_LOOPLO] = bestlo; sm[SM_HUB_LOOPHI] = hi; sm[SM_HUB_LOOPXF] = xf;
      sm[SM_HUB_LOOPQUALITY] = 1 - min(1, bestcost);
    );
  );
);


function pt_in(x y w h)
(
  mouse_x >= x && mouse_x <= (x + w) && mouse_y >= y && mouse_y <= (y + h);
);

function recent_penalty(sample_id) local(i pen)
(
  pen = 0;
  i = 0;
  while (i < RECENT_LEN) (
    recent_base[i] == sample_id ? pen += (RECENT_LEN - i);
    i += 1;
  );
  pen;
);

function push_recent(sample_id) local(i)
(
  i = RECENT_LEN - 1;
  while (i > 0) (
    recent_base[i] = recent_base[i-1];
    i -= 1;
  );
  recent_base[0] = sample_id;
);

function grain_hist_clear_voice(vix) local(base j)
(
  base = vix * GRAIN_HIST_LEN;
  j = 0;
  while (j < GRAIN_HIST_LEN) (
    grain_hist_sid_base[base + j] = -1;
    grain_hist_pos_base[base + j] = -1000000;
    grain_hist_phase_base[base + j] = -1;
    j += 1;
  );
);

function reset_grain_histories() local(vix)
(
  vix = 0;
  while (vix < MAX_VOICES) (
    grain_hist_clear_voice(vix);
    vix += 1;
  );
);

function grain_hist_push(vix sid pos lo hi) local(base j span phasebin)
(
  span = max(1, hi - lo);
  phasebin = min(GRAIN_PHASE_BINS - 1, max(0, floor(clamp01((pos - lo) / max(1, span - 1)) * GRAIN_PHASE_BINS)));
  base = vix * GRAIN_HIST_LEN;
  j = GRAIN_HIST_LEN - 1;
  while (j > 0) (
    grain_hist_sid_base[base + j] = grain_hist_sid_base[base + j - 1];
    grain_hist_pos_base[base + j] = grain_hist_pos_base[base + j - 1];
    grain_hist_phase_base[base + j] = grain_hist_phase_base[base + j - 1];
    j -= 1;
  );
  grain_hist_sid_base[base] = sid;
  grain_hist_pos_base[base] = pos;
  grain_hist_phase_base[base] = phasebin;
);

function grain_sid_penalty(vix sid) local(base j pen)
(
  pen = 0;
  base = vix * GRAIN_HIST_LEN;
  j = 0;
  while (j < GRAIN_HIST_LEN) (
    grain_hist_sid_base[base + j] == sid ? pen += (GRAIN_HIST_LEN - j) * 0.22;
    j += 1;
  );
  pen;
);

function grain_hist_penalty(vix sid pos lo hi) local(base j pen span phasebin hsid hpos hbin near1 near2)
(
  pen = 0;
  span = max(1, hi - lo);
  phasebin = min(GRAIN_PHASE_BINS - 1, max(0, floor(clamp01((pos - lo) / max(1, span - 1)) * GRAIN_PHASE_BINS)));
  near1 = max(12, floor(span * 0.09));
  near2 = max(24, floor(span * 0.18));
  base = vix * GRAIN_HIST_LEN;
  j = 0;
  while (j < GRAIN_HIST_LEN) (
    hsid = grain_hist_sid_base[base + j] | 0;
    hsid >= 0 ? (
      hpos = grain_hist_pos_base[base + j];
      hbin = grain_hist_phase_base[base + j] | 0;
      hsid == sid ? pen += (GRAIN_HIST_LEN - j) * 0.16;
      hbin == phasebin ? pen += (GRAIN_HIST_LEN - j) * 0.06;
      (hsid == sid && abs(pos - hpos) < near2) ? pen += (GRAIN_HIST_LEN - j) * 0.22;
      (hsid == sid && abs(pos - hpos) < near1) ? pen += (GRAIN_HIST_LEN - j) * 0.38;
      (hsid == sid && hbin == phasebin) ? pen += (GRAIN_HIST_LEN - j) * 0.14;
    );
    j += 1;
  );
  pen;
);


function grain_run_limit(lively truth spice)
(
  // Same-source phrases should be long enough to feel connected but short
  // enough to avoid reconstructing one original take.
  max(4, floor(6 + (1 - spice) * 5 + truth * 3 + (1 - lively) * 2 + granular_event_stretch * (5 + 9 * (1 - spice) + 4 * truth)));
);

function corpus_phrase_targets(v stage lively truth spice) local(gphase arc lift accent rel envbase envlift)
(
  // v32 PhraseTrajectory: hidden per-voice phrase arc. This does not command
  // the selector; it provides a moving descriptor target so Granular can feel
  // like a phrase instead of a sequence of unrelated tiles.
  gphase = clamp01(v[VC_GPHASE]);
  arc = sin(gphase * 3.141592653589793);
  arc = arc * arc;
  accent = clamp01(v[VC_GACCENT]);
  lift = clamp01(arc * lively * (0.42 + 0.58 * v[VC_GDEPTH]) * (0.78 + 0.22 * accent));
  rel = stage == ENV_RELEASE ? 1 : 0;

  stage == ENV_ATTACK || stage == ENV_HOLD ? (
    phrase_bright_t = 0.46 + 0.16 * lively;
    phrase_edge_t   = 0.42 + 0.20 * lively;
    phrase_sal_t    = 0.54 + 0.18 * lively;
    phrase_phase_t  = 0.10 + 0.18 * lift;
    phrase_attack_pull = 0.74;
    phrase_env_t = 0.54 + 0.24 * lively + 0.12 * lift;
    phrase_env_delta_t = 0.16 + 0.18 * lively;
    phrase_env_peak_t = 0.36 + 0.24 * lively;
  ) : rel ? (
    phrase_bright_t = 0.26 + 0.20 * spice + 0.08 * lift;
    phrase_edge_t   = 0.16 + 0.16 * spice + 0.06 * lift;
    phrase_sal_t    = 0.22 + 0.20 * spice + 0.12 * lift;
    phrase_phase_t  = 0.72 + 0.24 * lift;
    phrase_attack_pull = 0.04 + 0.10 * spice;
    phrase_env_t = 0.24 + 0.18 * spice + 0.10 * lift;
    phrase_env_delta_t = -0.22 - 0.08 * (1 - spice);
    phrase_env_peak_t = 0.12 + 0.12 * spice;
  ) : (
    // Body/sustain trajectory: slow material stays coherent and forward;
    // high Lively crests toward brighter/attack-colored grains without hard
    // retriggering attack grains by default.
    phrase_bright_t = 0.30 + 0.22 * lively * lift + 0.08 * spice;
    phrase_edge_t   = 0.20 + 0.24 * lively * lift + 0.06 * spice;
    phrase_sal_t    = 0.30 + 0.26 * lively * lift + 0.10 * spice;
    phrase_phase_t  = 0.30 + 0.50 * gphase;
    phrase_attack_pull = clamp01((lift - 0.58) / 0.42) * lively * (0.30 + 0.40 * spice);
    envbase = 0.32 + 0.12 * (1 - truth) + 0.08 * spice;
    envlift = lift * (0.28 + 0.28 * lively + 0.14 * spice);
    phrase_env_t = envbase + envlift;
    phrase_env_delta_t = (lift - 0.46) * (0.12 + 0.20 * lively + 0.10 * spice);
    phrase_env_peak_t = clamp01((lift - 0.38) / 0.62) * (0.22 + 0.28 * lively);
  );

  phrase_bright_t = clamp01(phrase_bright_t);
  phrase_edge_t = clamp01(phrase_edge_t);
  phrase_sal_t = clamp01(phrase_sal_t);
  phrase_phase_t = clamp01(phrase_phase_t);
  phrase_env_t = clamp01(phrase_env_t);
  phrase_env_delta_t = clamp(phrase_env_delta_t, -1, 1);
  phrase_env_peak_t = clamp01(phrase_env_peak_t);
);

function corpus_snap_soft_point(sm pos lo hi glen region) local(ptr nch frames sr strength radius step p best bestscore score x xm xp dist)
(
  // v32: slow/dark material exposes grain edges. At load time only, snap corpus
  // entry starts toward nearby low-amplitude / low-slope points. Bright noisy
  // squelches keep their raw positions because they already mask boundaries.
  ptr = sm[SM_PTR] | 0;
  nch = max(1, sm[SM_NCH] | 0);
  frames = sm[SM_FRAMES] | 0;
  sr = max(1000, sm[SM_SR]);
  strength = clamp01((0.64 - sm[SM_BRIGHT]) / 0.54) * clamp01((0.46 - sm[SM_EDGE]) / 0.42);
  region == GC_REGION_ATTACK ? strength *= 0.18;
  strength > 0.025 ? (
    radius = min(floor(glen * 0.18), floor(sr * 0.010));
    radius = min(radius, max(2, floor((hi - lo) * 0.18)));
    step = max(1, floor(radius / 14));
    best = clamp(pos, lo, max(lo, hi - 1));
    bestscore = 1000000000;
    p = max(lo + 1, floor(pos - radius));
    while (p <= min(max(lo + 1, hi - 2), floor(pos + radius))) (
      x = mono_frame(ptr, nch, p);
      xm = mono_frame(ptr, nch, p - 1);
      xp = mono_frame(ptr, nch, p + 1);
      dist = abs(p - pos) / max(1, radius);
      score = abs(x) * 0.74 + abs(xp - xm) * 0.22 + dist * (0.012 + 0.060 * (1 - strength));
      score < bestscore ? (
        bestscore = score;
        best = p;
      );
      p += step;
    );
    lerp(pos, best, strength);
  ) : pos;
);


function corpus_region_bounds(sid region) local(sm frames sr gatt ghead gtail alo ahi blo bhi tlo thi)
(
  sm = sample_meta_base + sid * SM_STRIDE;
  frames = sm[SM_FRAMES] | 0;
  sr = max(1000, sm[SM_SR]);

  // Granular has its own Gaussian-style corpus markers, even when the global
  // Onset mode is Classic. Raw/Tape/Hybrid continue to use SM_ATTACK/HEAD/TAIL.
  gatt = sm[SM_GCATTACK];
  ghead = sm[SM_GCHEAD];
  gtail = sm[SM_GCTAIL];
  ghead <= 0 ? ghead = sm[SM_HEADEND];
  gtail <= ghead ? gtail = sm[SM_TAILSTART];

  alo = max(0, floor(gatt - sr * 0.006));
  ahi = clamp(ghead, alo + 1, max(alo + 1, frames - 2));
  blo = clamp(ghead, 0, max(0, frames - 2));
  bhi = clamp(gtail, blo + 1, max(blo + 1, frames - 2));
  tlo = clamp(gtail, 0, max(0, frames - 2));
  thi = max(tlo + 1, frames - 2);

  region == GC_REGION_TAIL ? (
    corpus_lo = tlo;
    corpus_hi = thi;
  ) : region == GC_REGION_ATTACK ? (
    corpus_lo = alo;
    corpus_hi = ahi;
  ) : (
    corpus_lo = blo;
    corpus_hi = bhi;
  );
);

function corpus_measure_at(sm pos win) local(ptr nch sr frames a b i step x ax prev lp hf sumsq sumabs sumdiff sumhf rough n lpcoef rms edge bright sharp sal j local_span)
(
  ptr = sm[SM_PTR] | 0;
  nch = max(1, sm[SM_NCH] | 0);
  sr = max(1000, sm[SM_SR]);
  frames = sm[SM_FRAMES] | 0;
  // v35: allow ultra-scale load-time measurements up to ~1.2s.
  // Runtime cost stays low because corpus analysis happens only at load/rescan.
  win = clamp(floor(win), 64, min(floor(sr * 1.20), max(64, frames - 2)));
  a = clamp(floor(pos - win * 0.5), 0, max(0, frames - 2));
  b = clamp(a + win, a + 1, max(a + 1, frames - 1));
  step = max(1, floor((b - a) / 256));

  // A centered local lowpass has a fixed physical aperture (~0.28 ms).
  // Stride chooses observation centers; it does not change the filter sample rate.
  local_span = max(1, floor(sr / 7200));
  lp = 0;
  prev = mono_frame(ptr, nch, a);
  sumsq = 0;
  sumabs = 0;
  sumdiff = 0;
  sumhf = 0;
  rough = 0;
  n = 0;

  i = a;
  while (i < b) (
    x = mono_frame(ptr, nch, i);
    ax = abs(x);
    lp = 0; j = -local_span;
    while (j <= local_span) (
      lp += mono_frame(ptr, nch, clamp(i + j, 0, frames - 1));
      j += 1;
    );
    lp /= 2 * local_span + 1;
    prev = mono_frame(ptr, nch, max(0, i - 1));
    hf = x - lp;
    sumsq += x * x;
    sumabs += ax;
    sumhf += abs(hf);
    n > 0 ? (
      sumdiff += abs(x - prev);
      rough += abs(hf - (prev - lp));
    );
    prev = x;
    n += 1;
    i += step;
  );

  rms = sqrt(sumsq / max(1, n));
  edge = clamp01((sumdiff / max(sumabs, 0.000000001)) * 0.22);
  bright = clamp01((sumhf / max(sumabs, 0.000000001) - 0.08) * 1.65);
  sharp = clamp01(edge * 0.62 + bright * 0.20 + sm[SM_SHARP] * 0.18);
  sal = clamp01(edge * 0.36 + bright * 0.25 + clamp01(rms / max(sm[SM_RMS] * 2.5, 0.000001)) * 0.25 + sm[SM_SHARP] * 0.14);

  corpus_tmp_rms = clamp01(rms / max(sm[SM_RMS] * 2.85, 0.000001));
  corpus_tmp_bright = bright;
  corpus_tmp_edge = edge;
  corpus_tmp_sharp = sharp;
  corpus_tmp_sal = sal;
);

function corpus_write_entry(sid region pos glen phase) local(
  sm gc frames sr prevpos nextpos span event_id crms cbright cedge csharp csal prms nrms nbright nedge envdir envpeak envlevel
  microwin shortwin midwin longwin ultrawin microrms micbright micedge micsal srms sbright sedge ssal mrms mbright medge msal lrms lbright ledge lsal urms ubright uedge usal
  slowmat stable ultrastable mscont mstrans event_len len_goal minlen maxlen lenmix evtfrac eventscale transscale
)
(
  corpus_count < corpus_capacity ? (
    sm = sample_meta_base + sid * SM_STRIDE;
    frames = sm[SM_FRAMES] | 0;
    sr = max(1000, sm[SM_SR]);
    corpus_region_bounds(sid, region);
    span = max(1, corpus_hi - corpus_lo);
    pos = region == GC_REGION_BODY ? wrap_in_range(pos, corpus_lo, corpus_hi) : clamp(pos, corpus_lo, max(corpus_lo, corpus_hi - 1));
    phase = clamp01((pos - corpus_lo) / max(1, span - 1));
    glen = clamp(floor(glen), 64, max(64, span));

    // v35 EventScaleOLA: evaluate the same corpus point over micro/short/mid/
    // long/ultra windows. Fast grains still use short information; slow coherent
    // events can now request 100ms-1s grains when the source supports it.
    microwin = clamp(floor(sr * 0.0016), 64, min(max(64, span), floor(sr * 0.010)));
    shortwin = clamp(floor(max(glen * 0.36, sr * 0.010)), max(64, floor(sr * 0.006)), min(max(64, span), floor(sr * 0.080)));
    midwin   = clamp(floor(max(glen, sr * 0.030)), max(80, floor(sr * 0.018)), min(max(96, span), floor(sr * 0.220)));
    longwin  = clamp(floor(max(glen * 3.20, sr * 0.110)), max(midwin + 16, floor(sr * 0.075)), min(max(128, span), floor(sr * 0.620)));
    ultrawin = clamp(floor(max(glen * 8.00, sr * 0.320)), max(longwin + 32, floor(sr * 0.220)), min(max(160, span), floor(sr * 1.120)));

    corpus_measure_at(sm, pos, microwin);
    microrms = corpus_tmp_rms;
    micbright = corpus_tmp_bright;
    micedge = corpus_tmp_edge;
    micsal = corpus_tmp_sal;

    corpus_measure_at(sm, pos, shortwin);
    srms = corpus_tmp_rms;
    sbright = corpus_tmp_bright;
    sedge = corpus_tmp_edge;
    ssal = corpus_tmp_sal;

    corpus_measure_at(sm, pos, midwin);
    mrms = corpus_tmp_rms;
    mbright = corpus_tmp_bright;
    medge = corpus_tmp_edge;
    msal = corpus_tmp_sal;

    corpus_measure_at(sm, pos, longwin);
    lrms = corpus_tmp_rms;
    lbright = corpus_tmp_bright;
    ledge = corpus_tmp_edge;
    lsal = corpus_tmp_sal;

    corpus_measure_at(sm, pos, ultrawin);
    urms = corpus_tmp_rms;
    ubright = corpus_tmp_bright;
    uedge = corpus_tmp_edge;
    usal = corpus_tmp_sal;

    slowmat = clamp01((0.70 - mbright) / 0.56) * clamp01((0.44 - medge) / 0.40);
    stable = clamp01(1 - abs(srms - lrms) * 1.38) * clamp01(1 - abs(sbright - lbright) * 1.05) * clamp01(1 - abs(sedge - ledge) * 0.96);
    ultrastable = clamp01(1 - abs(mrms - urms) * 1.20) * clamp01(1 - abs(mbright - ubright) * 0.92) * clamp01(1 - abs(medge - uedge) * 0.84);
    transscale = clamp01(micedge * 0.72 + max(0, microrms - urms) * 0.54 + sm[SM_FLAGS] * 0.18);
    mstrans = clamp01(sedge * 0.56 + micedge * 0.30 + sbright * 0.18 + sm[SM_FLAGS] * 0.18 + max(0, srms - lrms) * 0.36);
    eventscale = clamp01(slowmat * 0.42 + stable * 0.34 + ultrastable * 0.52 + clamp01(urms - 0.035) * 0.18 - transscale * 0.26);
    mscont = clamp01(slowmat * 0.42 + stable * 0.38 + eventscale * 0.58 + clamp01(lrms - 0.05) * 0.10 - mstrans * 0.22);
    region == GC_REGION_ATTACK ? (
      mscont *= 0.24;
      mstrans = max(mstrans, 0.46 + sm[SM_SHARP] * 0.22);
    );
    region == GC_REGION_TAIL ? (
      mscont = clamp01(mscont * 1.12 + clamp01(0.42 - ledge) * 0.08);
      mstrans *= 0.76;
    );

    region == GC_REGION_ATTACK ? (
      len_goal = sr * lerp(0.018, 0.095, clamp01(1 - mstrans + mscont * 0.22));
      maxlen = min(max(96, span), floor(sr * 0.130));
      minlen = max(64, floor(sr * 0.010));
    ) : region == GC_REGION_TAIL ? (
      len_goal = sr * lerp(0.055, 1.180, max(mscont, eventscale) ^ 0.78) * lerp(1.0, 0.58, mstrans);
      maxlen = min(max(128, span), floor(sr * lerp(0.180, 1.250, max(mscont, eventscale))));
      minlen = max(96, floor(sr * 0.030));
    ) : (
      len_goal = sr * lerp(0.030, 1.050, max(mscont, eventscale) ^ 0.74) * lerp(1.0, 0.58, mstrans);
      // If the body region itself is short or behaves like one coherent event,
      // use most of the event rather than chopping it into little tiles.
      span < sr * lerp(0.260, 1.050, eventscale) && mscont > 0.30 ? len_goal = max(len_goal, span * lerp(0.60, 0.94, max(mscont, eventscale)));
      maxlen = min(max(128, span), floor(sr * lerp(0.120, 1.120, max(mscont, eventscale))));
      minlen = max(80, floor(sr * 0.016));
    );

    lenmix = clamp01(0.48 + 0.30 * mscont + 0.34 * eventscale - 0.20 * mstrans);
    event_len = clamp(floor(lerp(glen, len_goal, lenmix)), minlen, maxlen);
    event_len = clamp(event_len, 64, max(64, span));
    evtfrac = clamp01(event_len / max(1, span));

    pos = corpus_snap_soft_point(sm, pos, corpus_lo, corpus_hi, event_len, region);
    phase = clamp01((pos - corpus_lo) / max(1, span - 1));

    gc = grain_corpus_base + corpus_count * GC_STRIDE;
    corpus_measure_at(sm, pos, event_len);
    crms = corpus_tmp_rms;
    cbright = corpus_tmp_bright;
    cedge = corpus_tmp_edge;
    csharp = corpus_tmp_sharp;
    csal = corpus_tmp_sal;

    // v33 EnvTrajectory: learn local energy motion at load time. v34 uses the
    // adaptive event length for this motion so the envelope follows the same
    // scale as the grain that will actually be played.
    prevpos = pos - max(16, floor(event_len * 0.62));
    prevpos = clamp(prevpos, corpus_lo, max(corpus_lo, corpus_hi - 1));
    corpus_measure_at(sm, prevpos, max(shortwin, floor(event_len * 0.62)));
    prms = corpus_tmp_rms;

    // Phrase-linear. Do not wrap body-end back to body-start.
    nextpos = pos + max(16, floor(event_len * 0.62));
    nextpos = clamp(nextpos, corpus_lo, max(corpus_lo, corpus_hi - 1));
    corpus_measure_at(sm, nextpos, max(shortwin, floor(event_len * 0.62)));
    nrms = corpus_tmp_rms;
    nbright = corpus_tmp_bright;
    nedge = corpus_tmp_edge;

    envdir = clamp(nrms - prms, -1, 1);
    envpeak = clamp01((crms - max(prms, nrms)) * 2.8 + max(0, mrms - lrms) * 0.28);
    envlevel = clamp01((prms + crms * 2 + nrms + lrms) * 0.20);

    gc[GC_SID] = sid;
    gc[GC_POS] = pos;
    gc[GC_LEN] = event_len;
    gc[GC_REGION] = region;
    gc[GC_PHASE] = phase;
    gc[GC_RMS] = crms;
    gc[GC_BRIGHT] = cbright;
    gc[GC_EDGE] = cedge;
    gc[GC_SHARP] = csharp;
    gc[GC_SAL] = csal;
    gc[GC_NRMS] = nrms;
    gc[GC_NBRIGHT] = nbright;
    gc[GC_NEDGE] = nedge;

    // Event id is now adaptive: longer coherent grains create wider event cells,
    // short transient grains keep finer cells.
    event_id = floor(pos / max(1, max(sr * 0.090, event_len * 1.30)));
    gc[GC_EVENT] = sid * 1000000 + event_id;
    gc[GC_PRMS] = prms;
    gc[GC_EDIR] = envdir;
    gc[GC_EPEAK] = envpeak;
    gc[GC_ELEVEL] = envlevel;
    gc[GC_MSCONT] = mscont;
    gc[GC_MSTRANS] = mstrans;
    gc[GC_LRMS] = lrms;
    gc[GC_EVTFRAC] = evtfrac;
    gc[GC_XCONT] = eventscale;
    gc[GC_URMS] = urms;
    gc[GC_UEDGE] = uedge;

    sm[SM_GCCOUNT] += 1;
    corpus_count += 1;
    1;
  ) : 0;
);


function estimate_granular_corpus_markers(sm) local(
  ptr nch sr frames onset_scan hop onset_lpcoef nov_count i j x ax lp hf env_prev hf_prev env_now hf_now cnt nov novsum
  peaki peakv mean_nov smoothv starti peakthr lowthr onset_conf attack onset_rise onset_rise_ms head_ms head_end tail_start fallback_attack fallback_scan fallback_peak fallback_sumsq fallback_rms thresh
)
(
  // v32: Granular prefers Gaussian/novelty markers. This is corpus-only and
  // does not rewrite the playback markers used by Raw/Tape/Hybrid.
  ptr = sm[SM_PTR] | 0;
  nch = max(1, sm[SM_NCH] | 0);
  sr = max(1000, sm[SM_SR]);
  frames = sm[SM_FRAMES] | 0;

  attack = sm[SM_ATTACK];
  head_end = sm[SM_HEADEND];
  tail_start = sm[SM_TAILSTART];

  frames > 256 ? (
    onset_scan = min(frames, max(4096, floor(sr * 1.50)));
    hop = max(1, floor(sr * 0.00075));
    hop = max(hop, floor((onset_scan + ONSET_SCRATCH_MAX - 1) / max(1, ONSET_SCRATCH_MAX)));
    onset_lpcoef = clamp(2200 / max(sr, 1), 0.015, 0.40);

    lp = 0; env_prev = 0; hf_prev = 0; nov_count = 0; novsum = 0; i = 0;
    while (i < onset_scan && nov_count < ONSET_SCRATCH_MAX) (
      env_now = 0; hf_now = 0; cnt = 0; j = 0;
      while (j < hop && (i + j) < onset_scan) (
        x = mono_frame(ptr, nch, i + j);
        ax = abs(x);
        lp += (x - lp) * onset_lpcoef;
        hf = x - lp;
        env_now += ax;
        hf_now += abs(hf);
        cnt += 1;
        j += 1;
      );
      env_now /= max(cnt, 1);
      hf_now /= max(cnt, 1);
      nov = max(0, hf_now - hf_prev * 0.90) + 0.32 * max(0, env_now - env_prev * 0.94);
      nov += 0.10 * max(0, hf_now - env_now * 0.22);
      onset_raw_base[nov_count] = nov;
      novsum += nov;
      env_prev = env_now;
      hf_prev = hf_now;
      nov_count += 1;
      i += hop;
    );

    peaki = 0; peakv = 0; i = 0;
    while (i < nov_count) (
      smoothv = (
        onset_raw_base[clamp(i - 3, 0, max(0, nov_count - 1))] +
        onset_raw_base[clamp(i - 2, 0, max(0, nov_count - 1))] * 6 +
        onset_raw_base[clamp(i - 1, 0, max(0, nov_count - 1))] * 15 +
        onset_raw_base[i] * 20 +
        onset_raw_base[clamp(i + 1, 0, max(0, nov_count - 1))] * 15 +
        onset_raw_base[clamp(i + 2, 0, max(0, nov_count - 1))] * 6 +
        onset_raw_base[clamp(i + 3, 0, max(0, nov_count - 1))]
      ) * 0.015625;
      onset_smooth_base[i] = smoothv;
      smoothv > peakv ? (peakv = smoothv; peaki = i;);
      i += 1;
    );

    fallback_scan = min(frames, onset_scan);
    fallback_peak = 0; fallback_sumsq = 0; i = 0;
    while (i < fallback_scan) (
      x = mono_frame(ptr, nch, i);
      ax = abs(x);
      fallback_peak = max(fallback_peak, ax);
      fallback_sumsq += x * x;
      i += 1;
    );
    fallback_rms = sqrt(fallback_sumsq / max(fallback_scan, 1));
    thresh = max(fallback_peak * 0.12, fallback_rms * 1.8);
    fallback_attack = -1; i = 0;
    while (i < fallback_scan && fallback_attack < 0) (
      abs(mono_frame(ptr, nch, i)) >= thresh ? fallback_attack = i;
      i += 1;
    );
    fallback_attack < 0 ? fallback_attack = 0;

    mean_nov = nov_count > 0 ? (novsum / nov_count) : 0;
    onset_conf = peakv > 0 ? clamp01((peakv - mean_nov * 1.35) / max(peakv, 0.000001)) : 0;
    starti = peaki;
    peakthr = peakv * (0.18 + 0.08 * (1 - onset_conf));
    while (starti > 0 && onset_smooth_base[starti - 1] >= peakthr) (starti -= 1;);
    lowthr = peakv * 0.10;
    while (starti > 0 && onset_smooth_base[starti - 1] > lowthr && (peaki - starti) < 8) (starti -= 1;);

    onset_conf >= 0.10 && peakv > 0.00001 ? attack = floor(starti * hop) : attack = fallback_attack;
    attack = clamp(attack, 0, max(0, frames - 2));
    onset_rise = max(hop, (peaki - starti) * hop);
    onset_rise_ms = 1000 * onset_rise / max(sr, 1);

    head_ms = 5 + clamp01(sm[SM_FLAGS]) * 34 + min(15, onset_rise_ms * 0.34);
    head_end = clamp(attack + floor(sr * head_ms * 0.001), attack + 8, max(attack + 8, frames - 2));
    tail_start = clamp(sm[SM_TAILSTART], head_end + 1, max(head_end + 1, frames - 2));
  );

  sm[SM_GCATTACK] = attack;
  sm[SM_GCHEAD] = head_end;
  sm[SM_GCTAIL] = tail_start;
);

function build_sample_corpus_region(sid region lo hi cnt) local(sm sr span j phase pos cell jitter glen seed_slow)
(
  sm = sample_meta_base + sid * SM_STRIDE;
  sr = max(1000, sm[SM_SR]);
  span = max(1, hi - lo);
  cnt = min(cnt | 0, max(0, corpus_capacity - corpus_count));
  cnt > 0 && span > 8 ? (
    j = 0;
    while (j < cnt && corpus_count < corpus_capacity) (
      phase = (j + 0.5) / max(1, cnt);
      cell = span / max(1, cnt);
      jitter = (hub_random(1) - 0.5) * cell * 0.46;
      pos = lo + phase * span + jitter;
      region == GC_REGION_BODY ? pos = wrap_in_range(pos, lo, hi) : pos = clamp(pos, lo, max(lo, hi - 1));
      seed_slow = clamp01((0.70 - sm[SM_BRIGHT]) / 0.56) * clamp01((0.44 - sm[SM_EDGE]) / 0.40);
      glen = region == GC_REGION_ATTACK ? floor(sr * lerp(0.020, 0.048, 1 - seed_slow)) : region == GC_REGION_TAIL ? floor(sr * lerp(0.070, 0.180, seed_slow)) : floor(sr * lerp(0.042, 0.145, seed_slow));
      // v34: this is only the seed window. corpus_write_entry() expands or
      // contracts it using multi-scale descriptor stability.
      glen = clamp(glen, 80, min(8192, max(96, floor(span * 0.88))));
      corpus_write_entry(sid, region, pos, glen, phase);
      j += 1;
    );
  );
);

function build_grain_corpus() local(total_frames i sm frames sr lenms target share cnt remain avail reserve atkcnt tailcnt bodycnt alo ahi blo bhi tlo thi span)
(
  corpus_count = 0;
  total_frames = 0;
  i = 0;
  while (i < sample_count) (
    sm = sample_meta_base + i * SM_STRIDE;
    sm[SM_GCSTART] = 0;
    sm[SM_GCCOUNT] = 0;
    total_frames += max(1, sm[SM_FRAMES]);
    i += 1;
  );

  i = 0;
  while (i < sample_count && corpus_count < corpus_capacity) (
    sm = sample_meta_base + i * SM_STRIDE;
    // v37 PerfGate: Granular Gaussian corpus markers are calculated lazily
    // while building the corpus, not during non-Granular bank analysis.
    estimate_granular_corpus_markers(sm);
    frames = sm[SM_FRAMES] | 0;
    sr = max(1000, sm[SM_SR]);
    lenms = sm[SM_LENMS];
    sm[SM_GCSTART] = corpus_count;
    sm[SM_GCCOUNT] = 0;

    target = clamp(floor(lenms / 55) + 8, 8, 512);
    sample_count <= 1 ? target = clamp(floor(lenms / 38) + 24, 64, 2048);
    share = floor((frames / max(1, total_frames)) * corpus_capacity * 0.96) + 4;
    cnt = min(target, max(6, share));
    remain = max(0, sample_count - i - 1);
    avail = max(0, corpus_capacity - corpus_count);
    reserve = remain * 4;
    cnt = min(cnt, max(0, avail - reserve));

    cnt > 0 ? (
      alo = max(0, floor(sm[SM_GCATTACK] - sr * 0.006));
      ahi = clamp(sm[SM_GCHEAD], alo + 1, max(alo + 1, frames - 2));
      blo = clamp(sm[SM_GCHEAD], 0, max(0, frames - 2));
      bhi = clamp(sm[SM_GCTAIL], blo + 1, max(blo + 1, frames - 2));
      tlo = clamp(sm[SM_GCTAIL], 0, max(0, frames - 2));
      thi = max(tlo + 1, frames - 2);

      atkcnt = cnt >= 10 ? clamp(floor(cnt * 0.14), 1, 24) : 1;
      tailcnt = cnt >= 10 ? clamp(floor(cnt * 0.18), 1, 48) : 1;
      bodycnt = max(0, cnt - atkcnt - tailcnt);

      // Long single sources need the corpus concentrated in the continuous body,
      // not in one global attack/tail pair.
      sample_count <= 1 ? (
        atkcnt = min(atkcnt, 12);
        tailcnt = min(tailcnt, 24);
        bodycnt = max(0, cnt - atkcnt - tailcnt);
      );

      (ahi - alo) > 8 ? build_sample_corpus_region(i, GC_REGION_ATTACK, alo, ahi, atkcnt);
      (bhi - blo) > 8 ? build_sample_corpus_region(i, GC_REGION_BODY, blo, bhi, bodycnt);
      (thi - tlo) > 8 ? build_sample_corpus_region(i, GC_REGION_TAIL, tlo, thi, tailcnt);

      // If segmentation produced too few usable regions, backfill from the whole file.
      sm[SM_GCCOUNT] < 4 ? (
        span = max(1, frames - 2);
        build_sample_corpus_region(i, GC_REGION_BODY, 0, max(1, frames - 2), max(4, cnt - sm[SM_GCCOUNT]));
      );
    );

    i += 1;
  );
  corpus_dirty = 0;
);

function corpus_consider_candidate(vix v idx want_region gsize lively truth spice stage fallback_sid) local(
  gc csid cpos clen creg cphase crms cbright cedge csharp csal cevent sm sr lo hi span
  lastidx lastgc hasprev prms pbr pedge psid ppos pevent pphase pregion descer phaseerr histpen regionpen saltarget salpen nearwin nearpen runpen regresspen crosspen score runlim force_cross sameevent
  nextgap seqbonus lowrms_min lowrmspen phase_adv target_phase role rolepen motion_slow gstretch cohscore
  trajpen crossneeded loopbackpen phrase_boundary phrase_cross_bonus cedir cepeak celevel penvdir penvpeak envpen envtarget envdeltatarget envpeaktarget cmscont cmstrans clongrms cevtfrac cxcont curms cuedge lenpen
)
(
  (idx >= 0 && idx < corpus_count) ? (
    gc = grain_corpus_base + idx * GC_STRIDE;
    csid = gc[GC_SID] | 0;
    (csid >= 0 && csid < sample_count) ? (
      cpos = gc[GC_POS];
      clen = max(1, gc[GC_LEN]);
      creg = gc[GC_REGION] | 0;
      cphase = clamp01(gc[GC_PHASE]);
      crms = gc[GC_RMS];
      cbright = gc[GC_BRIGHT];
      cedge = gc[GC_EDGE];
      csharp = gc[GC_SHARP];
      csal = gc[GC_SAL];
      cevent = gc[GC_EVENT];
      cedir = gc[GC_EDIR];
      cepeak = gc[GC_EPEAK];
      celevel = gc[GC_ELEVEL];
      cmscont = gc[GC_MSCONT];
      cmstrans = gc[GC_MSTRANS];
      clongrms = gc[GC_LRMS];
      cevtfrac = gc[GC_EVTFRAC];
      cxcont = gc[GC_XCONT];
      curms = gc[GC_URMS];
      cuedge = gc[GC_UEDGE];

      corpus_region_bounds(csid, creg);
      lo = corpus_lo;
      hi = corpus_hi;
      span = max(1, hi - lo);

      lastidx = v[VC_LGCIDX] | 0;
      hasprev = (lastidx >= 0 && lastidx < corpus_count) ? 1 : 0;
      hasprev ? (
        lastgc = grain_corpus_base + lastidx * GC_STRIDE;
        psid = lastgc[GC_SID] | 0;
        ppos = lastgc[GC_POS];
        pevent = lastgc[GC_EVENT];
        pphase = clamp01(lastgc[GC_PHASE]);
        pregion = lastgc[GC_REGION] | 0;
        prms = lastgc[GC_NRMS];
        pbr = lastgc[GC_NBRIGHT];
        pedge = lastgc[GC_NEDGE];
        penvdir = lastgc[GC_EDIR];
        penvpeak = lastgc[GC_EPEAK];
        nextgap = (csid == psid && creg == pregion) ? (idx - lastidx) : 9999;
        phase_adv = clamp((clen * 0.32 + abs(v[VC_SRCHOP]) * 0.58) / max(1, span), 0.010, 0.185);
        target_phase = clamp01(pphase + phase_adv);
        descer = abs(crms - prms) * 0.72 + abs(cbright - pbr) * 1.12 + abs(cedge - pedge) * 0.92;
        phaseerr = abs(cphase - target_phase);
      ) : (
        psid = fallback_sid;
        ppos = v[VC_LGPOS];
        pevent = -999999;
        pphase = 0.5;
        pregion = -1;
        nextgap = 9999;
        descer = 0;
        phaseerr = 0;
        penvdir = 0;
        penvpeak = 0;
      );

      corpus_phrase_targets(v, stage, lively, truth, spice);

      want_region == GC_REGION_TAIL ? (
        regionpen = creg == GC_REGION_TAIL ? 0 : 4.5;
      ) : (
        (stage == ENV_ATTACK || stage == ENV_HOLD) ? (
          regionpen = creg == GC_REGION_ATTACK ? -0.15 : (creg == GC_REGION_BODY ? 0.36 : 2.8);
        ) : (
          regionpen = creg == GC_REGION_BODY ? 0 : (creg == GC_REGION_ATTACK ? (0.95 + 1.25 * (1 - lively) - 1.10 * phrase_attack_pull) : 2.0);
        );
      );

      histpen = grain_hist_penalty(vix, csid, cpos, lo, hi) * (0.20 + 0.28 * lively + 0.14 * (1 - truth));
      sm = sample_meta_base + csid * SM_STRIDE;
      sr = max(1000, sm[SM_SR]);
      nearwin = max(gsize * (1.20 + 0.62 * lively), sr * 0.082);
      // v30: adjacent corpus entries are not "repeats"; they are the coherent
      // continuation stream. Penalize only stalling/regression/re-hitting.
      nearpen = (hasprev && csid == psid && abs(cpos - ppos) < nearwin) ? (
        (nextgap >= 1 && nextgap <= 5) ? (0.08 + 0.14 * lively) : (3.2 + 3.6 * lively + 0.85 * (1 - truth))
      ) : 0;
      idx == lastidx ? nearpen += 1000;

      runlim = grain_run_limit(lively, truth, spice);
      force_cross = (sample_count > 1 && hasprev && v[VC_LGRUN] >= runlim) ? 1 : 0;
      crosspen = (force_cross && csid == psid) ? 1000 : 0;
      runpen = (hasprev && csid == psid) ? max(0, v[VC_LGRUN] - runlim * 0.72) * (0.22 + 0.34 * lively) : (-0.045 * spice);

      sameevent = hasprev && csid == psid && cevent == pevent;
      seqbonus = (hasprev && csid == psid && nextgap >= 1 && nextgap <= 5) ? (-(0.72 - nextgap * 0.085) * (0.52 + 0.34 * (1 - spice) + 0.20 * (1 - truth))) : 0;
      sample_count <= 1 && sameevent ? (
        (nextgap >= 1 && nextgap <= 5) ? nearpen += 0.04 * lively : nearpen += 2.2 + 2.2 * lively
      );
      regresspen = (hasprev && csid == psid && cphase < pphase - 0.14) ? (1.9 + 2.1 * lively) : 0;

      saltarget = (stage == ENV_ATTACK || stage == ENV_HOLD) ? 0.58 : (stage == ENV_RELEASE ? (0.28 + 0.22 * spice) : (0.34 + 0.18 * lively + 0.08 * spice));
      salpen = abs(csal - saltarget) * 0.50 + max(0, csal - saltarget - 0.30) * (0.78 + 0.82 * lively);
      lowrms_min = want_region == GC_REGION_TAIL ? 0.016 : (creg == GC_REGION_ATTACK ? 0.030 : 0.046);
      lowrmspen = max(0, lowrms_min - crms) * (17 + 10 * (1 - truth) + 5 * lively);

      // v32 ThreeStream/PhraseTrajectory: one stream carries continuity, one fills low-salience
      // texture, and a rare spice stream is allowed to be more salient. This is a
      // lightweight role bias over the same corpus selector, not a separate engine.
      role = corpus_pick_role | 0;
      motion_slow = max(clamp01((0.58 - cbright) / 0.48) * clamp01((0.34 - cedge) / 0.30), max(cmscont * 0.82 - cmstrans * 0.18, cxcont * 0.95 - cmstrans * 0.10));
      // v36 GranStretch: higher Stretch in Granular biases selection toward
      // coherent event playback. At 1x this is exactly zero, preserving v35.
      gstretch = granular_event_stretch * ((stage == ENV_ATTACK || stage == ENV_HOLD) ? 0.30 : 1.0);
      cohscore = clamp01(max(cmscont, cxcont) - cmstrans * 0.20 + motion_slow * 0.28);
      rolepen = 0;
      role == 0 ? (
        // Anchor: prefer same-source/event forward motion and penalize jumpy tiles.
        rolepen += (hasprev && csid == psid && creg == pregion && nextgap >= 1 && nextgap <= 6) ? -0.52 : 0.38;
        rolepen += (hasprev && csid != psid) ? (0.45 + 0.34 * (1 - spice)) : 0;
        rolepen += abs(csal - (0.30 + 0.10 * lively)) * 0.20;
        rolepen -= cmscont * (0.22 + 0.22 * motion_slow);
        rolepen += cmstrans * 0.10;
      ) : role == 1 ? (
        // Texture: prefer filler that masks seams without becoming a hero grain.
        rolepen += max(0, csal - (0.34 + 0.10 * lively)) * (1.10 + 0.55 * lively);
        rolepen += sameevent ? 0.18 : -0.08;
        rolepen += motion_slow * -0.18;
        rolepen -= cmscont * 0.16;
      ) : (
        // Spice: rare high-character grains are allowed, but still scored.
        rolepen += -csal * (0.42 + 0.42 * spice + 0.32 * lively);
        rolepen += creg == GC_REGION_ATTACK ? -0.12 * lively : 0;
        rolepen += sameevent ? 0.36 : -0.08;
        rolepen -= cmstrans * (0.14 + 0.18 * lively);
        salpen *= 0.42;
        regionpen *= 0.62;
      );

      gstretch > 0 && hasprev ? (
        // Slow-event Stretch should sound like a plausible continuation of the
        // same source/event when possible, not a fresh patchwork tile.
        csid != psid ? rolepen += gstretch * cohscore * (0.62 + 0.48 * (1 - spice)) * (role == 0 ? 1.0 : 0.48);
        (csid == psid && creg == pregion && nextgap >= 1 && nextgap <= 12) ? seqbonus -= gstretch * cohscore * (0.30 + 0.34 * (1 - truth));
        (csid == psid && nextgap > 12) ? nearpen += gstretch * cohscore * 0.40;
      );

      phrase_boundary = hasprev && csid == psid && pphase > (0.72 - 0.14 * lively) ? clamp01((pphase - (0.72 - 0.14 * lively)) / max(0.05, 0.28 + 0.14 * lively)) : 0;
      crossneeded = (sample_count > 1 && phrase_boundary > 0.55 && v[VC_LGRUN] >= max(3, floor(runlim * 0.52))) ? 1 : 0;
      phrase_cross_bonus = crossneeded && csid != psid ? -(0.35 + 0.35 * spice + 0.20 * lively) : 0;
      loopbackpen = (hasprev && csid == psid && cphase < pphase - (0.07 + 0.06 * lively)) ? (1.6 + 2.4 * lively + 1.2 * motion_slow) : 0;
      trajpen = abs(cbright - phrase_bright_t) * (0.18 + 0.42 * lively)
              + abs(cedge - phrase_edge_t) * (0.16 + 0.40 * lively)
              + abs(csal - phrase_sal_t) * (0.14 + 0.28 * lively);

      // v33 EnvTrajectory: phrase target and learned corpus envelope must agree.
      // This is the first pass at co-determining phrase and amplitude motion.
      envtarget = phrase_env_t;
      envdeltatarget = phrase_env_delta_t;
      envpeaktarget = phrase_env_peak_t;
      hasprev ? (
        // Prefer grains whose current energy plausibly follows the previous
        // grain's learned next energy, then blend toward the phrase envelope.
        envtarget = lerp(prms, phrase_env_t, 0.28 + 0.26 * lively + 0.18 * spice);
        envdeltatarget = lerp(penvdir, phrase_env_delta_t, 0.35 + 0.30 * lively);
        envpeaktarget = lerp(penvpeak, phrase_env_peak_t, 0.42 + 0.24 * lively);
      );
      envpen = abs(celevel - envtarget) * (0.72 + 0.55 * (1 - truth) + 0.45 * motion_slow)
             + abs(cedir - envdeltatarget) * (0.42 + 0.48 * lively + 0.30 * motion_slow)
             + abs(cepeak - envpeaktarget) * (0.20 + 0.34 * lively);
      role == 0 ? ( envpen *= 1.18; ); // anchor owns the prosody
      role == 1 ? ( envpen *= 0.72; ); // texture can be flatter as seam glue
      role == 2 ? ( envpen *= 0.52; ); // spice can violate the curve
      motion_slow > 0.18 && hasprev ? (
        // Slow/bassy material needs continuity more than novelty. Bright squelch
        // can jump around; low-motion material must flow.
        csid != psid ? trajpen += motion_slow * (0.55 + 0.45 * (1 - spice)) * (1 - 0.55 * phrase_boundary);
        (csid == psid && nextgap >= 1 && nextgap <= 8) ? seqbonus -= motion_slow * (0.38 + 0.30 * (1 - truth));
      );

      // v34: prefer event-scale grains when the multi-scale analysis says this
      // point wants continuity, but do not force huge windows on bright attacks.
      lenpen = 0;
      cmscont > 0.30 ? lenpen -= cmscont * clamp01(cevtfrac * 2.2) * (0.20 + 0.22 * (1 - truth));
      cxcont > 0.35 ? lenpen -= cxcont * clamp01(cevtfrac * 1.65) * (0.18 + 0.30 * (1 - truth));
      gstretch > 0 ? lenpen -= gstretch * cohscore * clamp01(cevtfrac * 2.35) * (0.30 + 0.42 * (1 - truth));
      cmstrans > 0.55 ? lenpen += max(0, cevtfrac - lerp(0.36, 0.56, gstretch)) * cmstrans * (0.48 + 0.40 * lively) * (1 - 0.35 * gstretch);

      // v58 EdgeMelt: as the macro rises, prefer smoother corpus points and
      // stronger forward continuity. Salient/transient edge grains can still be
      // used as Spice, but they no longer dominate the smoothing path.
      melt_score = edge_melt_amt * edge_melt_amt * (3 - 2 * edge_melt_amt);
      meltpen = melt_score * (
        cedge * (0.34 + 0.22 * motion_slow)
        + cmstrans * 0.52
        + csharp * 0.16
        + max(0, csal - 0.52) * 0.46
      );
      meltbonus = 0;
      melt_score > 0 && hasprev ? (
        (csid == psid && creg == pregion && nextgap >= 1 && nextgap <= 10) ? meltbonus -= melt_score * cohscore * (0.32 + 0.28 * motion_slow + 0.16 * (1 - truth));
        csid != psid ? meltbonus += melt_score * motion_slow * (0.28 + 0.24 * (1 - spice));
      );

      score = regionpen + descer * (1.28 + 0.52 * (1 - truth) + 0.55 * motion_slow + 0.34 * gstretch * cohscore + 0.28 * melt_score * motion_slow) + phaseerr * (0.62 + 0.46 * (1 - spice) + 0.38 * motion_slow + 0.44 * gstretch * cohscore + 0.36 * melt_score * motion_slow);
      score += histpen + nearpen + runpen + regresspen + crosspen + salpen + lowrmspen + seqbonus + rolepen + trajpen + envpen + lenpen + loopbackpen + phrase_cross_bonus + meltpen + meltbonus;
      csid == fallback_sid ? score -= 0.030 * (1 - spice);
      score < corpus_best_score ? (
        corpus_best_score = score;
        corpus_best_idx = idx;
        corpus_best_sid = csid;
        corpus_best_pos = cpos;
        corpus_best_lo = lo;
        corpus_best_hi = hi;
        corpus_best_len = clen;
      );
    );
  );
);

function corpus_pick_grain(vix v want_region fallback_sid fallback_pos fallback_lo fallback_hi gsize lively truth spice stage) local(
  tries idx sm start count r lastidx lastgc psid pstart pcount nearidx k phase idx2
)
(
  corpus_best_idx = -1;
  corpus_best_sid = -1;
  corpus_best_pos = fallback_pos;
  corpus_best_lo = fallback_lo;
  corpus_best_hi = fallback_hi;
  corpus_best_len = gsize;
  corpus_best_score = 1000000000;

  corpus_count > 0 ? (
    // Seed the search with candidates around the anchor sample so Granular still
    // feels related to the triggered note, then add corpus-wide candidates so a
    // single long file or mixed bank can transform instead of merely replay.
    (fallback_sid >= 0 && fallback_sid < sample_count) ? (
      sm = sample_meta_base + fallback_sid * SM_STRIDE;
      start = sm[SM_GCSTART] | 0;
      count = sm[SM_GCCOUNT] | 0;
      count > 0 ? (
        k = 0;
        while (k < 5) (
          idx = start + floor(hub_random(count));
          corpus_consider_candidate(vix, v, idx, want_region, gsize, lively, truth, spice, stage, fallback_sid);
          k += 1;
        );
      );
    );

    lastidx = v[VC_LGCIDX] | 0;
    (lastidx >= 0 && lastidx < corpus_count) ? (
      lastgc = grain_corpus_base + lastidx * GC_STRIDE;
      psid = lastgc[GC_SID] | 0;
      (psid >= 0 && psid < sample_count) ? (
        sm = sample_meta_base + psid * SM_STRIDE;
        pstart = sm[SM_GCSTART] | 0;
        pcount = sm[SM_GCCOUNT] | 0;
        pcount > 0 ? (
          // v30: feed the selector actual forward continuations before random
          // candidates. This makes the corpus behave like plausible motion, not
          // disconnected tiles. No wrap is used at the end.
          k = 1;
          while (k <= (16 + floor(24 * granular_event_stretch))) (
            nearidx = lastidx + k;
            (nearidx >= pstart && nearidx < pstart + pcount) ? (
              corpus_consider_candidate(vix, v, nearidx, want_region, gsize, lively, truth, spice, stage, fallback_sid);
            );
            k += 1;
          );
          k = 0;
          while (k < 4) (
            idx = pstart + floor(hub_random(pcount));
            corpus_consider_candidate(vix, v, idx, want_region, gsize, lively, truth, spice, stage, fallback_sid);
            k += 1;
          );
        );
      );
    );

    tries = floor((22 + floor(20 * lively) + floor(10 * spice)) * lerp(1.0, 0.58, granular_event_stretch));
    tries = max(10, tries);
    while (tries > 0) (
      idx = floor(hub_random(corpus_count));
      corpus_consider_candidate(vix, v, idx, want_region, gsize, lively, truth, spice, stage, fallback_sid);
      tries -= 1;
    );
  );
);


function update_sample_cluster(sm) local(br sh tr len pitch len_norm pitch_norm)
(
  // Compact descriptor-bin cluster for Walk mode.
  // It is intentionally cheap: brightness, attack focus, transient richness, length, and pitch bin.
  br = min(3, max(0, floor(clamp01(sm[SM_BRIGHT]) * 4)));
  sh = min(3, max(0, floor(clamp01(sm[SM_SHARP]) * 4)));
  tr = min(3, max(0, floor(clamp01(sm[SM_FLAGS]) * 4)));
  len_norm = clamp01(log(sm[SM_LENMS] + 1) / log(5001));
  len = min(4, max(0, floor(len_norm * 5)));
  pitch_norm = clamp01((sm[SM_ROOT] - ROOT_LOW) / max(ROOT_HIGH - ROOT_LOW, 1));
  pitch = sm[SM_PITCHCONF] > 0.42 ? min(5, max(0, floor(pitch_norm * 6))) : 0;

  sm[SM_CLUSTER] = br + sh * 4 + tr * 16 + len * 64 + pitch * 320;
);

function walk_cluster_distance(a b) local(
  ca cb
  abr ash atr alen apit
  bbr bsh btr blen bpit
)
(
  ca = a[SM_CLUSTER] | 0;
  cb = b[SM_CLUSTER] | 0;

  abr = ca % 4; ca = floor(ca / 4);
  ash = ca % 4; ca = floor(ca / 4);
  atr = ca % 4; ca = floor(ca / 4);
  alen = ca % 5; ca = floor(ca / 5);
  apit = ca % 6;

  bbr = cb % 4; cb = floor(cb / 4);
  bsh = cb % 4; cb = floor(cb / 4);
  btr = cb % 4; cb = floor(cb / 4);
  blen = cb % 5; cb = floor(cb / 5);
  bpit = cb % 6;

  abs(abr - bbr) * 0.12
  + abs(ash - bsh) * 0.13
  + abs(atr - btr) * 0.10
  + abs(alen - blen) * 0.10
  + abs(apit - bpit) * (bank_pitchiness > 0.35 ? 0.055 : 0.018);
);

function sample_descriptor_distance(a b region_mode) local(
  brighterr sharperr transerr lenerr pitcherr regionerr clustererr
  aspan bspan
)
(
  brighterr = abs(a[SM_BRIGHT] - b[SM_BRIGHT]);
  sharperr  = abs(a[SM_SHARP] - b[SM_SHARP]);
  transerr  = abs(a[SM_FLAGS] - b[SM_FLAGS]);
  lenerr    = min(1.8, abs(log((a[SM_LENMS] + 1) / (b[SM_LENMS] + 1))));

  pitcherr = 0;
  (a[SM_PITCHCONF] > 0.38 && b[SM_PITCHCONF] > 0.38) ? (
    pitcherr = min(1.5, abs(a[SM_ROOT] - b[SM_ROOT]) / 24);
  );

  region_mode ? (
    aspan = max(1, a[SM_FRAMES] - a[SM_TAILSTART]) / max(1, a[SM_FRAMES]);
    bspan = max(1, b[SM_FRAMES] - b[SM_TAILSTART]) / max(1, b[SM_FRAMES]);
  ) : (
    aspan = max(1, a[SM_TAILSTART] - a[SM_HEADEND]) / max(1, a[SM_FRAMES]);
    bspan = max(1, b[SM_TAILSTART] - b[SM_HEADEND]) / max(1, b[SM_FRAMES]);
  );
  regionerr = abs(aspan - bspan);

  clustererr = walk_cluster_distance(a, b);

  brighterr * 0.80
  + sharperr * 0.88
  + transerr * 0.66
  + lenerr * 0.22
  + regionerr * 0.55
  + pitcherr * (0.10 + 0.36 * bank_pitchiness)
  + clustererr * 0.38;
);

function choose_random_sample(note velnorm) local(
  i sm sid score bright_t brighterr sharp_t sharperr
  rep rep_scale totalw pick accum weight temp
)
(
  sample_count <= 0 ? 0 : (
    bright_t = clamp01(0.5 + color_tilt_norm * 0.20 + (velnorm - 0.5) * 0.06);
    sharp_t  = clamp01(0.48 + slider7 * 0.22 + (velnorm - 0.5) * 0.10);
    rep_scale = 0.30 + slider9 * 1.45;
    temp = lerp(4.0, 1.4, slider9);
    totalw = 0;

    i = 0;
    while (i < sample_count) (
      sm = sample_meta_base + i * SM_STRIDE;
      brighterr = abs(sm[SM_BRIGHT] - bright_t);
      sharperr  = abs(sm[SM_SHARP] - sharp_t);
      score = brighterr * 0.95 + sharperr * 1.10;
      score += recent_penalty(i) * rep_scale / max(RECENT_LEN, 1);
      weight = 0.15 + exp(-score * temp);
      totalw += weight;
      i += 1;
    );

    totalw <= 0 ? (
      floor(hub_random(max(sample_count, 1)));
    ) : (
      pick = hub_random(totalw);
      accum = 0;
      sid = sample_count - 1;
      i = 0;
      while (i < sample_count) (
        sm = sample_meta_base + i * SM_STRIDE;
        brighterr = abs(sm[SM_BRIGHT] - bright_t);
        sharperr  = abs(sm[SM_SHARP] - sharp_t);
        score = brighterr * 0.95 + sharperr * 1.10;
        score += recent_penalty(i) * rep_scale / max(RECENT_LEN, 1);
        weight = 0.15 + exp(-score * temp);
        accum += weight;
        accum >= pick ? (
          sid = i;
          i = sample_count;
        ) : i += 1;
      );
      sid;
    );
  );
);

function choose_walk_sample(note velnorm) local(
  i sm sid lastsm prevsm
  score bright_t sharperr brighterr toneerr
  dlast dprev clustererr target jump too_close prev_bounce
  rep rep_scale totalw pick accum weight temp
)
(
  sample_count <= 0 ? 0 : (
    (walk_last_sid < 0 || walk_last_sid >= sample_count || sample_count <= 1) ? (
      choose_random_sample(note, velnorm);
    ) : (
      lastsm = sample_meta_base + walk_last_sid * SM_STRIDE;
      prevsm = (walk_prev_sid >= 0 && walk_prev_sid < sample_count) ? (sample_meta_base + walk_prev_sid * SM_STRIDE) : lastsm;

      bright_t = clamp01(0.5 + color_tilt_norm * 0.18 + (velnorm - 0.5) * 0.05);
      target = 0.16 + slider9 * 0.30 + truth_mix * 0.06;
      rep_scale = 0.45 + slider9 * 1.30;
      temp = lerp(7.2, 2.0, slider9);
      totalw = 0;

      i = 0;
      while (i < sample_count) (
        i != walk_last_sid ? (
          sm = sample_meta_base + i * SM_STRIDE;

          dlast = sample_descriptor_distance(lastsm, sm, 0);
          dprev = sample_descriptor_distance(prevsm, sm, 0);
          clustererr = walk_cluster_distance(lastsm, sm);

          brighterr = abs(sm[SM_BRIGHT] - bright_t);
          sharperr  = abs(sm[SM_SHARP] - clamp01(lastsm[SM_SHARP] * 0.72 + slider7 * 0.12 + 0.18));
          toneerr = brighterr * 0.36 + sharperr * 0.28;

          jump = max(0, dlast - (0.44 + slider9 * 0.38));
          too_close = max(0, (0.035 + (1 - slider9) * 0.045) - dlast);
          prev_bounce = (walk_prev_sid >= 0 && i == walk_prev_sid && sample_count > 2) ? 0.42 : 0;
          (dprev < 0.055 && sample_count > 3) ? prev_bounce += 0.18;

          score = abs(dlast - target) * 2.15;
          score += jump * 3.20;
          score += too_close * 4.60;
          score += clustererr * (0.18 + 0.24 * (1 - slider9));
          score += toneerr;
          score += prev_bounce;
          score += recent_penalty(i) * rep_scale / max(RECENT_LEN, 1);

          weight = 0.002 + exp(-score * temp);
          totalw += weight;
        );
        i += 1;
      );

      totalw <= 0 ? (
        choose_random_sample(note, velnorm);
      ) : (
        pick = hub_random(totalw);
        accum = 0;
        sid = walk_last_sid;
        i = 0;
        while (i < sample_count) (
          i != walk_last_sid ? (
            sm = sample_meta_base + i * SM_STRIDE;

            dlast = sample_descriptor_distance(lastsm, sm, 0);
            dprev = sample_descriptor_distance(prevsm, sm, 0);
            clustererr = walk_cluster_distance(lastsm, sm);

            brighterr = abs(sm[SM_BRIGHT] - bright_t);
            sharperr  = abs(sm[SM_SHARP] - clamp01(lastsm[SM_SHARP] * 0.72 + slider7 * 0.12 + 0.18));
            toneerr = brighterr * 0.36 + sharperr * 0.28;

            jump = max(0, dlast - (0.44 + slider9 * 0.38));
            too_close = max(0, (0.035 + (1 - slider9) * 0.045) - dlast);
            prev_bounce = (walk_prev_sid >= 0 && i == walk_prev_sid && sample_count > 2) ? 0.42 : 0;
            (dprev < 0.055 && sample_count > 3) ? prev_bounce += 0.18;

            score = abs(dlast - target) * 2.15;
            score += jump * 3.20;
            score += too_close * 4.60;
            score += clustererr * (0.18 + 0.24 * (1 - slider9));
            score += toneerr;
            score += prev_bounce;
            score += recent_penalty(i) * rep_scale / max(RECENT_LEN, 1);

            weight = 0.002 + exp(-score * temp);
            accum += weight;
            accum >= pick ? (
              sid = i;
              i = sample_count;
            ) : i += 1;
          ) : i += 1;
        );
        sid == walk_last_sid ? choose_random_sample(note, velnorm) : sid;
      );
    );
  );
);

function choose_region_donor(src_sid region_mode wideness vix) local(
  src sm i pick accum totalw sid temp minspan
  src_lo src_hi src_span lo hi span
  brighterr sharperr transerr lenerr pitcherr regionerr histpen walkerr score weight
)
(
  (sample_count <= 1 || src_sid < 0) ? src_sid : (
    src = sample_meta_base + src_sid * SM_STRIDE;
    region_mode ? (
      src_lo = clamp(src[SM_TAILSTART], 0, max(0, src[SM_FRAMES] - 2));
      src_hi = max(src_lo + 1, src[SM_FRAMES] - 2);
      minspan = max(24, floor(hybrid_grain_samps * 0.22));
    ) : (
      src_lo = clamp(src[SM_HEADEND], 0, max(0, src[SM_TAILSTART] - 1));
      src_hi = clamp(src[SM_TAILSTART], src_lo + 1, max(src_lo + 1, src[SM_FRAMES] - 2));
      minspan = max(48, floor(hybrid_grain_samps * 0.36));
    );
    src_span = max(1, src_hi - src_lo);
    temp = lerp(10.0, 1.25, clamp01(wideness));
    totalw = 0;

    i = 0;
    while (i < sample_count) (
      i != src_sid ? (
        sm = sample_meta_base + i * SM_STRIDE;
        region_mode ? (
          lo = clamp(sm[SM_TAILSTART], 0, max(0, sm[SM_FRAMES] - 2));
          hi = max(lo + 1, sm[SM_FRAMES] - 2);
        ) : (
          lo = clamp(sm[SM_HEADEND], 0, max(0, sm[SM_TAILSTART] - 1));
          hi = clamp(sm[SM_TAILSTART], lo + 1, max(lo + 1, sm[SM_FRAMES] - 2));
        );
        span = max(1, hi - lo);

        span >= minspan ? (
          brighterr = abs(sm[SM_BRIGHT] - src[SM_BRIGHT]);
          sharperr  = abs(sm[SM_SHARP] - src[SM_SHARP]);
          transerr  = abs(sm[SM_FLAGS] - src[SM_FLAGS]);
          lenerr    = abs(log((sm[SM_LENMS] + 1) / (src[SM_LENMS] + 1)));
          regionerr = abs(log((span + 1) / (src_span + 1)));

          pitcherr = 0;
          (src[SM_PITCHCONF] > 0.38 && sm[SM_PITCHCONF] > 0.38) ? (
            pitcherr = abs(sm[SM_ROOT] - src[SM_ROOT]) / 24;
          );

          histpen = grain_sid_penalty(vix, i);
          score = brighterr * 1.00 + sharperr * 1.05 + transerr * 0.72 + lenerr * 0.26 + regionerr * 0.62;
          score += pitcherr * (0.14 + 0.56 * bank_pitchiness);
          score += histpen * 0.24;
          walk_mode ? (
            walkerr = sample_descriptor_distance(src, sm, region_mode);
            score += walkerr * (0.16 + 0.34 * (1 - clamp01(wideness)));
          );

          weight = 0.0005 + exp(-score * temp);
          totalw += weight;
        );
      );
      i += 1;
    );

    totalw <= 0 ? src_sid : (
      pick = hub_random(totalw);
      accum = 0;
      sid = src_sid;
      i = 0;
      while (i < sample_count) (
        i != src_sid ? (
          sm = sample_meta_base + i * SM_STRIDE;
          region_mode ? (
            lo = clamp(sm[SM_TAILSTART], 0, max(0, sm[SM_FRAMES] - 2));
            hi = max(lo + 1, sm[SM_FRAMES] - 2);
          ) : (
            lo = clamp(sm[SM_HEADEND], 0, max(0, sm[SM_TAILSTART] - 1));
            hi = clamp(sm[SM_TAILSTART], lo + 1, max(lo + 1, sm[SM_FRAMES] - 2));
          );
          span = max(1, hi - lo);

          span >= minspan ? (
            brighterr = abs(sm[SM_BRIGHT] - src[SM_BRIGHT]);
            sharperr  = abs(sm[SM_SHARP] - src[SM_SHARP]);
            transerr  = abs(sm[SM_FLAGS] - src[SM_FLAGS]);
            lenerr    = abs(log((sm[SM_LENMS] + 1) / (src[SM_LENMS] + 1)));
            regionerr = abs(log((span + 1) / (src_span + 1)));

            pitcherr = 0;
            (src[SM_PITCHCONF] > 0.38 && sm[SM_PITCHCONF] > 0.38) ? (
              pitcherr = abs(sm[SM_ROOT] - src[SM_ROOT]) / 24;
            );

            histpen = grain_sid_penalty(vix, i);
            score = brighterr * 1.00 + sharperr * 1.05 + transerr * 0.72 + lenerr * 0.26 + regionerr * 0.62;
            score += pitcherr * (0.14 + 0.56 * bank_pitchiness);
            score += histpen * 0.24;
            walk_mode ? (
              walkerr = sample_descriptor_distance(src, sm, region_mode);
              score += walkerr * (0.16 + 0.34 * (1 - clamp01(wideness)));
            );

            weight = 0.0005 + exp(-score * temp);
            accum += weight;
            accum >= pick ? (
              sid = i;
              i = sample_count;
            ) : i += 1;
          ) : i += 1;
        ) : i += 1;
      );
      sid;
    );
  );
);

function choose_region_pos(vix sid region_mode phase01 jitter_norm) local(
  sm lo hi span center pos jitter scale
  best bestscore score dist try limit
)
(
  sm = sample_meta_base + sid * SM_STRIDE;
  region_mode ? (
    lo = clamp(sm[SM_TAILSTART], 0, max(0, sm[SM_FRAMES] - 2));
    hi = max(lo + 1, sm[SM_FRAMES] - 2);
    limit = hybrid_tail_jitter;
  ) : (
    lo = clamp(sm[SM_HEADEND], 0, max(0, sm[SM_TAILSTART] - 1));
    hi = clamp(sm[SM_TAILSTART], lo + 1, max(lo + 1, sm[SM_FRAMES] - 2));
    limit = hybrid_body_jitter;
  );
  span = max(1, hi - lo);
  center = lo + clamp01(phase01) * max(1, span - 1);
  best = clamp(center, lo, max(lo, hi - 1));
  bestscore = 1000000000;

  try = 0;
  while (try < GRAIN_CAND_TRIES) (
    scale = min(span * lerp(0.16, 0.52, clamp01(jitter_norm)), limit);
    jitter = (hub_random(1) - 0.5) * scale * 2;
    pos = center + jitter;
    region_mode ? (
      pos = clamp(pos, lo, max(lo, hi - 1));
    ) : (
      pos = wrap_in_range(pos, lo, hi);
    );
    dist = abs(pos - center) / max(1, span);
    score = grain_hist_penalty(vix, sid, pos, lo, hi) + dist * (region_mode ? 0.12 : 0.16);
    score < bestscore ? (
      bestscore = score;
      best = pos;
    );
    try += 1;
  );

  best;
);


function source_phase_jitter_samples(sid region_mode lively truth spice) local(sm sr conf note hz period amt maxms off)
(
  (sid < 0 || sid >= sample_count) ? 0 : (
    sm = sample_meta_base + sid * SM_STRIDE;
    sr = max(1, sm[SM_SR]);
    conf = clamp01(sm[SM_PITCHCONF] * bank_pitchiness);

    // Pitched material: source offset up to roughly +/- half a pitch period.
    // Noisy material: small millisecond dephasing. This avoids hard polarity flips.
    conf > 0.38 ? (
      note = sm[SM_ROOT];
      hz = 440 * exp((note - 69) * 0.0577622650466621);
      period = sr / max(20, hz);
      amt = clamp01(lively) * lerp(0.22, 0.82, 1 - truth) * lerp(0.82, 1.10, spice);
      off = (hub_random(1) - 0.5) * period * amt;
    ) : (
      maxms = lerp(0.00025, 0.00280, clamp01(lively)) * lerp(1.00, 0.66, truth) * lerp(0.84, 1.16, spice);
      off = (hub_random(1) - 0.5) * 2 * sr * maxms;
    );

    region_mode ? off *= 0.82 : off *= 0.70;
    off;
  );
);


function wrap01(x) local(y)
(
  y = x - floor(x);
  y < 0 ? y += 1;
  y;
);

function phase_lerp_region(a b amt region_mode) local(t)
(
  // v13: phase is no longer circular for body grains. Circular interpolation was
  // one reason learned-flow could rebuild a source phrase, hit the end, wrap to
  // the beginning, and make the same take audible again.
  t = clamp01(amt);
  lerp(clamp01(a), clamp01(b), t);
);

function grain_region_lo(sid region_mode) local(sm)
(
  sm = sample_meta_base + sid * SM_STRIDE;
  region_mode ? (
    clamp(sm[SM_TAILSTART], 0, max(0, sm[SM_FRAMES] - 2));
  ) : (
    clamp(sm[SM_HEADEND], 0, max(0, sm[SM_TAILSTART] - 1));
  );
);

function grain_region_hi(sid region_mode) local(sm lo)
(
  sm = sample_meta_base + sid * SM_STRIDE;
  region_mode ? (
    lo = clamp(sm[SM_TAILSTART], 0, max(0, sm[SM_FRAMES] - 2));
    max(lo + 1, sm[SM_FRAMES] - 2);
  ) : (
    lo = clamp(sm[SM_HEADEND], 0, max(0, sm[SM_TAILSTART] - 1));
    clamp(sm[SM_TAILSTART], lo + 1, max(lo + 1, sm[SM_FRAMES] - 2));
  );
);

function grain_follow_phase(v region_mode) local(lo hi span ph step f)
(
  (v[VC_LGSID] < 0 || v[VC_LGREG] != region_mode) ? -1 : (
    lo = v[VC_LGLO];
    hi = max(lo + 1, v[VC_LGHI]);
    span = max(1, hi - lo);
    ph = clamp01((v[VC_LGPOS] - lo) / max(1, span - 1));
    step = clamp(abs(v[VC_SRCHOP]) / max(1, span), 0.006, 0.24);
    f = ph + step * (0.78 + 0.20 * hub_random(1));
    // No wrap. Reaching the end of a body phrase should cause cross-sample
    // continuation, not restart the same take.
    clamp01(f);
  );
);


function grain_follow_strength(v lively truth spice) local(runw runlim)
(
  // Strong at the start of a phrase, then fades hard as the same source repeats.
  // v12 faded too slowly, causing take-sized loops.
  runlim = max(1, grain_run_limit(lively, truth, spice));
  runw = clamp01(v[VC_LGRUN] / runlim);
  clamp01(0.82 + 0.08 * (1 - lively) + 0.05 * (1 - truth) - 0.10 * spice - 0.58 * runw);
);


function flow_slot(region_mode bin feat)
(
  SM_FLOWBASE + ((clamp(region_mode, 0, 1) | 0) * FLOW_BINS + clamp(bin | 0, 0, FLOW_BINS - 1)) * FLOW_FEATS + clamp(feat | 0, 0, FLOW_FEATS - 1);
);

function flow_weight_slot(region_mode outfeat infeat)
(
  flow_model_base + ((clamp(region_mode, 0, 1) | 0) * FLOW_FEATS + clamp(outfeat | 0, 0, FLOW_FEATS - 1)) * FLOW_IN + clamp(infeat | 0, 0, FLOW_IN - 1);
);

function flow_region_bounds(sm region_mode) local(lo hi)
(
  region_mode ? (
    flow_lo = clamp(sm[SM_TAILSTART], 0, max(0, sm[SM_FRAMES] - 2));
    flow_hi = max(flow_lo + 1, sm[SM_FRAMES] - 2);
  ) : (
    flow_lo = clamp(sm[SM_HEADEND], 0, max(0, sm[SM_TAILSTART] - 1));
    flow_hi = clamp(sm[SM_TAILSTART], flow_lo + 1, max(flow_lo + 1, sm[SM_FRAMES] - 2));
  );
);

function analyze_sample_flow(sm) local(
  ptr nch sr frames region bin lo hi span center win a b n i x ax prev sumsq sumabs sumdiff
  frms fbright fedge relrms slot fallback_rms
)
(
  ptr    = sm[SM_PTR] | 0;
  nch    = max(1, sm[SM_NCH] | 0);
  sr     = sm[SM_SR];
  frames = sm[SM_FRAMES] | 0;
  fallback_rms = max(sm[SM_RMS], 0.000001);

  region = 0;
  while (region < 2) (
    flow_region_bounds(sm, region);
    lo = flow_lo;
    hi = flow_hi;
    span = max(1, hi - lo);

    bin = 0;
    while (bin < FLOW_BINS) (
      center = lo + (bin + 0.5) * span / FLOW_BINS;
      win = clamp(floor(sr * 0.0065), 48, 512);
      win = min(win, max(32, floor(span * 0.45)));
      a = clamp(floor(center - win * 0.5), 0, max(0, frames - 2));
      b = clamp(a + win, a + 1, max(a + 1, frames - 1));

      n = 0;
      sumsq = 0;
      sumabs = 0;
      sumdiff = 0;
      prev = mono_frame(ptr, nch, a);
      i = a;
      while (i < b) (
        x = mono_frame(ptr, nch, i);
        ax = abs(x);
        sumsq += x * x;
        sumabs += ax;
        i > a ? sumdiff += abs(x - prev);
        prev = x;
        n += 1;
        i += 1;
      );

      frms = sqrt(sumsq / max(n, 1));
      relrms = clamp01(frms / max(fallback_rms * 2.85, 0.000001));
      fedge = clamp01((sumdiff / max(sumabs, 0.000001)) * 0.20);
      fbright = clamp01(sm[SM_BRIGHT] * 0.42 + fedge * 0.58 + sm[SM_SHARP] * 0.08);

      slot = flow_slot(region, bin, 0); sm[slot] = relrms;
      slot = flow_slot(region, bin, 1); sm[slot] = fbright;
      slot = flow_slot(region, bin, 2); sm[slot] = clamp01(fedge * 0.70 + sm[SM_FLAGS] * 0.20 + sm[SM_SHARP] * 0.10);

      bin += 1;
    );

    region += 1;
  );
);

function init_flow_model() local(region o inn widx)
(
  region = 0;
  while (region < 2) (
    o = 0;
    while (o < FLOW_FEATS) (
      inn = 0;
      while (inn < FLOW_IN) (
        widx = flow_weight_slot(region, o, inn);
        flow_model_base[widx - flow_model_base] = 0;
        inn += 1;
      );
      // Identity-biased one-layer predictor. Training nudges this toward the
      // corpus' actual next-grain statistics, but it starts safe.
      widx = flow_weight_slot(region, o, o);
      flow_model_base[widx - flow_model_base] = 0.86;
      widx = flow_weight_slot(region, o, 4);
      flow_model_base[widx - flow_model_base] = 0.04;
      o += 1;
    );
    region += 1;
  );
  flow_model_trained = 0;
);

function flow_predict(region_mode outfeat x0 x1 x2 phase) local(wbase y)
(
  wbase = flow_weight_slot(region_mode, outfeat, 0);
  y = flow_model_base[wbase - flow_model_base] * x0
    + flow_model_base[wbase - flow_model_base + 1] * x1
    + flow_model_base[wbase - flow_model_base + 2] * x2
    + flow_model_base[wbase - flow_model_base + 3] * phase
    + flow_model_base[wbase - flow_model_base + 4];
  clamp01(y);
);

function train_flow_model() local(
  region o inn epoch i sm bin slot0 slot1 x0 x1 x2 ph y0 y1 y2 p0 p1 p2 err lr widx
)
(
  init_flow_model();
  sample_count > 0 ? (
    epoch = 0;
    while (epoch < 2) (
      lr = epoch == 0 ? 0.030 : 0.014;
      region = 0;
      while (region < 2) (
        i = 0;
        while (i < sample_count) (
          sm = sample_meta_base + i * SM_STRIDE;
          bin = 0;
          while (bin < FLOW_BINS - 1) (
            slot0 = flow_slot(region, bin, 0);
            slot1 = flow_slot(region, bin + 1, 0);
            x0 = sm[slot0];
            x1 = sm[slot0 + 1];
            x2 = sm[slot0 + 2];
            ph = bin / max(1, FLOW_BINS - 1);
            y0 = sm[slot1];
            y1 = sm[slot1 + 1];
            y2 = sm[slot1 + 2];

            o = 0;
            while (o < FLOW_FEATS) (
              p0 = flow_predict(region, o, x0, x1, x2, ph);
              err = (o == 0 ? y0 : (o == 1 ? y1 : y2)) - p0;
              widx = flow_weight_slot(region, o, 0);
              flow_model_base[widx - flow_model_base]     = clamp(flow_model_base[widx - flow_model_base]     + lr * err * x0, -1.8, 1.8);
              flow_model_base[widx - flow_model_base + 1] = clamp(flow_model_base[widx - flow_model_base + 1] + lr * err * x1, -1.8, 1.8);
              flow_model_base[widx - flow_model_base + 2] = clamp(flow_model_base[widx - flow_model_base + 2] + lr * err * x2, -1.8, 1.8);
              flow_model_base[widx - flow_model_base + 3] = clamp(flow_model_base[widx - flow_model_base + 3] + lr * err * ph, -1.8, 1.8);
              flow_model_base[widx - flow_model_base + 4] = clamp(flow_model_base[widx - flow_model_base + 4] + lr * err, -1.8, 1.8);
              o += 1;
            );

            bin += 1;
          );
          i += 1;
        );
        region += 1;
      );
      epoch += 1;
    );
    flow_model_trained = 1;
  );
);

function flow_bin_from_pos(sid region_mode pos) local(lo hi span phase)
(
  lo = grain_region_lo(sid, region_mode);
  hi = grain_region_hi(sid, region_mode);
  span = max(1, hi - lo);
  phase = clamp01((pos - lo) / max(1, span - 1));
  clamp(floor(phase * FLOW_BINS), 0, FLOW_BINS - 1) | 0;
);

function flow_feat_sid(sid region_mode bin feat) local(sm slot)
(
  sm = sample_meta_base + sid * SM_STRIDE;
  slot = flow_slot(region_mode, bin, feat);
  sm[slot];
);

function flow_phase_distance(a b region_mode) local(d)
(
  // v13: learned flow is phrase-linear. Do not score body phase as circular,
  // because circular distance rewards wraparound into the same take.
  d = abs(a - b);
  d;
);

function learned_flow_score(vix prev_sid prev_pos region_mode cand_sid cand_pos cand_lo cand_hi target_phase gsize lively truth spice same_run force_cross) local(
  pbin cbin x0 x1 x2 ph pred0 pred1 pred2 c0 c1 c2 err phase cand_phase hist near same_current same_sid nextbin local_mix
  prev_phase runlim same_run_norm same_sid_pen regression end_rehit cross_bonus
)
(
  (prev_sid < 0 || prev_sid >= sample_count || cand_sid < 0 || cand_sid >= sample_count || flow_model_trained <= 0) ? (
    1000000;
  ) : (
    pbin = flow_bin_from_pos(prev_sid, region_mode, prev_pos);
    cbin = flow_bin_from_pos(cand_sid, region_mode, cand_pos);
    x0 = flow_feat_sid(prev_sid, region_mode, pbin, 0);
    x1 = flow_feat_sid(prev_sid, region_mode, pbin, 1);
    x2 = flow_feat_sid(prev_sid, region_mode, pbin, 2);
    ph = pbin / max(1, FLOW_BINS - 1);
    prev_phase = ph;

    // Use the trained corpus predictor as the target. v12 mixed in the actual
    // same-source successor too strongly, making the system rebuild and loop the
    // take it came from.
    pred0 = flow_predict(region_mode, 0, x0, x1, x2, ph);
    pred1 = flow_predict(region_mode, 1, x0, x1, x2, ph);
    pred2 = flow_predict(region_mode, 2, x0, x1, x2, ph);
    nextbin = min(FLOW_BINS - 1, pbin + 1);
    local_mix = clamp01(0.035 + 0.075 * (1 - truth) - 0.030 * spice);
    pred0 = lerp(pred0, flow_feat_sid(prev_sid, region_mode, nextbin, 0), local_mix);
    pred1 = lerp(pred1, flow_feat_sid(prev_sid, region_mode, nextbin, 1), local_mix);
    pred2 = lerp(pred2, flow_feat_sid(prev_sid, region_mode, nextbin, 2), local_mix);

    c0 = flow_feat_sid(cand_sid, region_mode, cbin, 0);
    c1 = flow_feat_sid(cand_sid, region_mode, cbin, 1);
    c2 = flow_feat_sid(cand_sid, region_mode, cbin, 2);
    err = abs(c0 - pred0) * 0.78 + abs(c1 - pred1) * 1.14 + abs(c2 - pred2) * 0.92;

    cand_phase = clamp01((cand_pos - cand_lo) / max(1, cand_hi - cand_lo - 1));
    phase = flow_phase_distance(cand_phase, target_phase, region_mode);
    hist = grain_hist_penalty(vix, cand_sid, cand_pos, cand_lo, cand_hi) * (0.25 + 0.34 * (1 - truth) + 0.16 * lively);

    same_current = (cand_sid == prev_sid && abs(cand_pos - prev_pos) < max(16, floor(gsize * 0.50))) ? 1 : 0;
    same_sid = cand_sid == prev_sid ? 1 : 0;
    near = same_current ? (5.8 + 2.8 * lively) : 0;

    runlim = max(1, grain_run_limit(lively, truth, spice));
    same_run_norm = clamp01((same_run - 2) / max(1, runlim - 2));
    same_sid_pen = same_sid ? (same_run_norm * (1.55 + 1.35 * lively + 0.85 * (1 - truth)) - (1 - same_run_norm) * 0.045 * (1 - spice)) : 0;
    force_cross && same_sid ? same_sid_pen += 1000;

    // Regression is the real take-loop tell: same sample, phase jumps backward.
    regression = (!region_mode && same_sid && cand_phase < prev_phase - 0.10) ? 1 : 0;
    end_rehit = (!region_mode && same_sid && prev_phase > 0.72 && cand_phase > 0.68) ? clamp01((prev_phase - 0.72) / 0.28) : 0;
    cross_bonus = same_sid ? 0 : (-0.08 - 0.10 * spice - 0.07 * lively);

    err * (1.24 + 0.36 * (1 - truth))
    + phase * (0.72 + 0.22 * (1 - spice))
    + hist
    + near
    + same_sid_pen
    + regression * (3.4 + 2.2 * lively)
    + end_rehit * (1.5 + 1.4 * lively)
    + cross_bonus;
  );
);

function learned_flow_consider(vix prev_sid prev_pos region_mode cand_sid cand_phase gsize lively truth spice same_run force_cross) local(
  lo hi span pos score
)
(
  cand_sid >= 0 && cand_sid < sample_count ? (
    lo = grain_region_lo(cand_sid, region_mode);
    hi = grain_region_hi(cand_sid, region_mode);
    span = max(1, hi - lo);
    span > max(32, floor(gsize * 0.36)) ? (
      pos = choose_region_pos(vix, cand_sid, region_mode, cand_phase, 0.06 + 0.16 * lively + 0.07 * spice);
      score = learned_flow_score(vix, prev_sid, prev_pos, region_mode, cand_sid, pos, lo, hi, cand_phase, gsize, lively, truth, spice, same_run, force_cross);
      score < learned_best_score ? (
        learned_best_score = score;
        learned_sid = cand_sid;
        learned_pos = pos;
        learned_lo = lo;
        learned_hi = hi;
      );
    );
  );
);

function learned_flow_pick(vix v region_mode fallback_sid fallback_pos fallback_lo fallback_hi gsize lively truth spice) local(
  prev_sid prev_pos target_phase fallback_score strength tries donor sid_anchor cand_phase
  same_run runlim prev_lo prev_hi prev_phase boundary_thr end_pressure force_cross donor2
)
(
  learned_sid = fallback_sid;
  learned_pos = fallback_pos;
  learned_lo = fallback_lo;
  learned_hi = fallback_hi;
  learned_best_score = 1000000;

  (flow_model_trained > 0 && v[VC_LGSID] >= 0 && v[VC_LGREG] == region_mode) ? (
    prev_sid = v[VC_LGSID] | 0;
    prev_pos = v[VC_LGPOS];
    same_run = max(0, v[VC_LGRUN]);
    runlim = grain_run_limit(lively, truth, spice);

    target_phase = grain_follow_phase(v, region_mode);
    target_phase < 0 ? target_phase = clamp01((fallback_pos - fallback_lo) / max(1, fallback_hi - fallback_lo - 1));

    prev_lo = grain_region_lo(prev_sid, region_mode);
    prev_hi = grain_region_hi(prev_sid, region_mode);
    prev_phase = clamp01((prev_pos - prev_lo) / max(1, prev_hi - prev_lo - 1));
    boundary_thr = region_mode ? 0.92 : clamp(0.76 + 0.10 * spice - 0.12 * lively, 0.58, 0.88);
    end_pressure = (!region_mode && prev_phase > boundary_thr) ? clamp01((prev_phase - boundary_thr) / max(0.02, 1 - boundary_thr)) : 0;
    force_cross = (sample_count > 1 && ((same_run >= runlim) || end_pressure > 0.50)) ? 1 : 0;

    // At a phrase boundary, the next event may start early in another sample.
    // That is a cross-sample continuation, not same-sample wraparound.
    end_pressure > 0 ? (
      target_phase = phase_lerp_region(target_phase, 0.06 + 0.32 * hub_random(1), clamp01(end_pressure * 0.90), region_mode);
    );

    fallback_score = learned_flow_score(vix, prev_sid, prev_pos, region_mode, fallback_sid, fallback_pos, fallback_lo, fallback_hi, target_phase, gsize, lively, truth, spice, same_run, force_cross);
    learned_best_score = fallback_score;

    // Same-source continuation is allowed only as a short phrase. v12 always
    // considered prev_sid first; this was the main same-take reconstruction bug.
    !force_cross ? (
      learned_flow_consider(vix, prev_sid, prev_pos, region_mode, prev_sid, target_phase, gsize, lively, truth, spice, same_run, force_cross);
    );

    sid_anchor = v[VC_SAMPLE] | 0;
    sid_anchor != prev_sid ? learned_flow_consider(vix, prev_sid, prev_pos, region_mode, sid_anchor, target_phase, gsize, lively, truth, spice, same_run, force_cross);
    fallback_sid != prev_sid && fallback_sid != sid_anchor ? learned_flow_consider(vix, prev_sid, prev_pos, region_mode, fallback_sid, target_phase, gsize, lively, truth, spice, same_run, force_cross);

    tries = 0;
    while (tries < 7) (
      donor = choose_region_donor(prev_sid, region_mode, clamp01(0.12 + 0.20 * lively + 0.34 * spice + 0.10 * tries + 0.30 * end_pressure), vix);
      donor != prev_sid ? (
        cand_phase = phase_lerp_region(target_phase, hub_random(1), 0.035 + 0.10 * spice + 0.15 * end_pressure, region_mode);
        learned_flow_consider(vix, prev_sid, prev_pos, region_mode, donor, cand_phase, gsize, lively, truth, spice, same_run, force_cross);
      );
      tries += 1;
    );

    // Hard escape valve: if we must cross but the weighted donor search came
    // back empty, ask from the original anchor too. Still never accept prev_sid.
    (force_cross && learned_sid == prev_sid && sample_count > 1) ? (
      donor2 = choose_region_donor(sid_anchor, region_mode, 1, vix);
      donor2 != prev_sid ? (
        learned_flow_consider(vix, prev_sid, prev_pos, region_mode, donor2, 0.06 + 0.36 * hub_random(1), gsize, lively, truth, spice, same_run, 0);
      );
    );

    strength = clamp01(0.16 + 0.46 * lively + 0.16 * (1 - truth) - 0.06 * spice);
    // Bias, don't command, unless we are escaping a same-take phrase boundary.
    (!force_cross && learned_best_score > fallback_score + (0.48 + 1.10 * strength)) ? (
      learned_sid = fallback_sid;
      learned_pos = fallback_pos;
      learned_lo = fallback_lo;
      learned_hi = fallback_hi;
    );
  );
);

function voices_busy() local(i v busy)
(
  busy = 0;
  i = 0;
  while (i < MAX_VOICES && !busy) (
    v = voice_base + i * VC_STRIDE;
    v[VC_ACTIVE] > 0 ? busy = 1;
    i += 1;
  );
  busy;
);

function count_active_voices() local(i v cnt)
(
  cnt = 0;
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    v[VC_ACTIVE] > 0 ? cnt += 1;
    i += 1;
  );
  cnt;
);

function prepare_pitch_filter(decim) local(i half x cutoff w sum)
(
  half = min(512, max(8, 8 * decim));
  pitch_filter_half = half;
  cutoff = 0.45 / decim;
  sum = 0;
  i = -half;
  while (i <= half) (
    x = 6.283185307179586 * cutoff * i;
    w = (i == 0 ? 2 * cutoff : sin(x) / (3.141592653589793 * i));
    w *= 0.5 + 0.5 * cos(3.141592653589793 * i / half);
    analysis_filter_base[i + half] = w;
    sum += w;
    i += 1;
  );
  i = 0;
  while (i <= 2 * half) (
    analysis_filter_base[i] /= max(sum, 0.000001);
    i += 1;
  );
);

function pitch_filtered_frame(ptr nch frame) local(i x)
(
  i = -pitch_filter_half; x = 0;
  while (i <= pitch_filter_half) (
    x += mono_frame(ptr, nch, frame + i) * analysis_filter_base[i + pitch_filter_half];
    i += 1;
  );
  x;
);

function estimate_pitch(sm) local(
  ptr nch sr frames attack head tail
  decim effsr win minlag maxlag cand start maxstart
  i j lag endn x lp hp sumsq rms diff cumdiff cmndf
  best_note best_conf best_score cand_bestlag cand_bestcm cand_note cand_conf cand_score
  fallback_lag fallback_cm fallback_val val lagf y0 y1 y2 den delta
  sumxy sumx2 sumy2 x0 y0s corr freq cycles energy_ok transient_bias
)
(
  // v14 PitchSnap: replace brittle zero-cross pitch with a cheap YIN-style
  // normalized difference pass on stable post-onset windows. This intentionally
  // looks for pitched/ringing body content, not the noisy transient itself.
  ptr    = sm[SM_PTR]   | 0;
  nch    = max(1, sm[SM_NCH] | 0);
  sr     = max(1000, sm[SM_SR]);
  frames = sm[SM_FRAMES] | 0;
  attack = clamp(sm[SM_ATTACK] | 0, 0, max(0, frames - 2));
  head   = clamp(sm[SM_HEADEND] | 0, attack, max(attack, frames - 2));
  tail   = clamp(sm[SM_TAILSTART] | 0, head + 1, max(head + 1, frames - 2));

  best_note = 60;
  best_conf = 0;
  best_score = -1000000;

  frames > 320 ? (
    // Decimate to keep bank scan cheap while still covering musical pitch.
    decim = max(1, floor(sr / 12000));
    effsr = sr / decim;
    prepare_pitch_filter(decim);
    win = clamp(floor(effsr * 0.055), 320, min(896, ONSET_SCRATCH_MAX));
    win = min(win, max(64, floor((frames - 2) / decim)));
    minlag = max(3, floor(effsr / 2600));
    maxlag = min(floor(effsr / 42), floor(win * 0.58));

    (win > 96 && maxlag > minlag + 4) ? (
      cand = 0;
      while (cand < 3) (
        cand == 0 ? start = head + floor(sr * 0.006)
        : cand == 1 ? start = attack + floor(sr * 0.026)
        : start = head + floor(max(0, tail - head) * 0.42);

        maxstart = max(0, frames - 2 - win * decim);
        start = clamp(floor(start), 0, maxstart);

        lp = pitch_filtered_frame(ptr, nch, start);
        sumsq = 0;
        i = 0;
        while (i < win) (
          x = pitch_filtered_frame(ptr, nch, start + i * decim);
          lp += (x - lp) * 0.038;
          hp = x - lp;
          onset_raw_base[i] = hp;
          sumsq += hp * hp;
          i += 1;
        );

        rms = sqrt(sumsq / max(1, win));
        energy_ok = rms > max(0.000003, sm[SM_RMS] * 0.045);
        energy_ok ? (
          cumdiff = 0;
          lag = 1;
          while (lag <= maxlag) (
            diff = 0;
            endn = win - lag;
            j = 0;
            while (j < endn) (
              x0 = onset_raw_base[j];
              y0s = onset_raw_base[j + lag];
              diff += (x0 - y0s) * (x0 - y0s);
              j += 1;
            );

            cumdiff += diff;
            onset_smooth_base[lag] = diff * lag / max(cumdiff, 0.00000000000000000001);
            lag += 1;
          );

          cand_bestlag = -1;
          cand_bestcm = 1000000;
          fallback_lag = -1;
          fallback_cm = 1000000;
          fallback_val = 1000000;

          lag = minlag + 1;
          while (lag < maxlag) (
            cmndf = onset_smooth_base[lag];
            val = cmndf + (lag / max(1, maxlag)) * 0.035;
            val < fallback_val ? (
              fallback_val = val;
              fallback_cm = cmndf;
              fallback_lag = lag;
            );

            // First credible local minimum. This avoids octave/subharmonic creep
            // where a later repeated period looks slightly cleaner.
            (cand_bestlag < 0 && cmndf < 0.28 && cmndf <= onset_smooth_base[lag - 1] && cmndf < onset_smooth_base[lag + 1]) ? (
              cand_bestlag = lag;
              cand_bestcm = cmndf;
            );
            lag += 1;
          );

          cand_bestlag < 0 ? (
            cand_bestlag = fallback_lag;
            cand_bestcm = fallback_cm;
          );

          cand_bestlag > 0 ? (
            lagf = cand_bestlag;
            (cand_bestlag > 1 && cand_bestlag < maxlag) ? (
              y0 = onset_smooth_base[cand_bestlag - 1];
              y1 = onset_smooth_base[cand_bestlag];
              y2 = onset_smooth_base[cand_bestlag + 1];
              den = y0 - 2 * y1 + y2;
              abs(den) > 0.000000000001 ? (
                delta = 0.5 * (y0 - y2) / den;
                abs(delta) <= 0.5 ? lagf = cand_bestlag + delta;
              );
            );

            sumxy = 0;
            sumx2 = 0;
            sumy2 = 0;
            endn = win - cand_bestlag;
            j = 0;
            while (j < endn) (
              x0 = onset_raw_base[j];
              y0s = onset_raw_base[j + cand_bestlag];
              sumxy += x0 * y0s;
              sumx2 += x0 * x0;
              sumy2 += y0s * y0s;
              j += 1;
            );

            corr = sumxy / sqrt(max(sumx2 * sumy2, 0.00000000000000000001));
            corr = clamp(corr, -1, 1);
            freq = effsr / max(1, lagf);

            (freq >= 35 && freq <= 2600) ? (
              cycles = win / max(1, lagf);
              cand_note = 69 + 17.31234049066756 * log(freq / 440);
              transient_bias = clamp01(sm[SM_FLAGS]);
              cand_conf = clamp01((0.62 - cand_bestcm) / 0.54);
              cand_conf *= clamp01((corr - 0.06) / 0.70);
              cand_conf *= clamp01((cycles - 1.45) / 4.30);
              // Transient-rich impacts can have a valid ring, but do not let the
              // detector hallucinate a huge confidence from the click itself.
              cand_conf *= lerp(1.00, 0.76, transient_bias * (1 - clamp01(corr)));
              cand_conf = clamp01(cand_conf);
              cand_score = cand_conf + corr * 0.11 - cand_bestcm * 0.06;

              cand_score > best_score ? (
                best_score = cand_score;
                best_note = cand_note;
                best_conf = cand_conf;
              );
            );
          );
        );

        cand += 1;
      );
    );
  );

  sm[SM_PITCHNOTE] = best_note;
  sm[SM_PITCHCONF] = best_conf;
);


function estimate_brightness_metric(ptr nch sr start scan) local(
  i endp x ax
  c250 c1000 c3500 c8500
  lp250 lp1000 lp3500 lp8500
  b0 b1 b2 b3 b4
  e0 e1 e2 e3 e4 total centroid rawbright highratio airratio br
  warmup
)
(
  // Robust brightness proxy: cheap filterbank spectral-centroid estimate.
  // The previous metric was a single high-pass residual ratio, which saturates
  // on clicks/noise and made the bank brightness meter sit near 1.0.
  start = clamp(floor(start), 0, max(0, sample_len(bank_pool, ptr) - 2));
  scan = max(64, floor(scan));
  endp = min(sample_len(bank_pool, ptr) | 0, start + scan);

  c250  = clamp(1 - exp(-6.283185307179586 * min(250,  sr * 0.45) / max(sr, 1)), 0.0001, 0.70);
  c1000 = clamp(1 - exp(-6.283185307179586 * min(1000, sr * 0.45) / max(sr, 1)), 0.0001, 0.82);
  c3500 = clamp(1 - exp(-6.283185307179586 * min(3500, sr * 0.45) / max(sr, 1)), 0.0001, 0.90);
  c8500 = clamp(1 - exp(-6.283185307179586 * min(8500, sr * 0.45) / max(sr, 1)), 0.0001, 0.96);

  lp250 = 0; lp1000 = 0; lp3500 = 0; lp8500 = 0;
  e0 = 0; e1 = 0; e2 = 0; e3 = 0; e4 = 0;

  i = start;
  warmup = min(max(16, floor(sr * 0.0015)), max(16, endp - start));
  while (i < endp) (
    x = mono_frame(ptr, nch, i);
    lp250  += (x - lp250)  * c250;
    lp1000 += (x - lp1000) * c1000;
    lp3500 += (x - lp3500) * c3500;
    lp8500 += (x - lp8500) * c8500;

    (i - start) >= warmup ? (
      b0 = lp250;
      b1 = lp1000 - lp250;
      b2 = lp3500 - lp1000;
      b3 = lp8500 - lp3500;
      b4 = x - lp8500;

      // Power energy. This damps click-only maxing compared with abs(highpass).
      e0 += b0 * b0;
      e1 += b1 * b1;
      e2 += b2 * b2;
      e3 += b3 * b3;
      e4 += b4 * b4;
    );
    i += 1;
  );

  total = e0 + e1 + e2 + e3 + e4 + 0.00000000000000000001;
  centroid = (e0 * 170 + e1 * 700 + e2 * 2200 + e3 * 5200 + e4 * 10500) / total;

  // Log-frequency normalization is closer to perceived brightness than linear Hz.
  rawbright = clamp01((log(max(centroid, 80) / 180) / log(10500 / 180)));
  highratio = clamp01((e3 + e4) / total);
  airratio = clamp01(e4 / total);

  // Blend centroid with high-band occupancy, then re-scale conservatively so
  // normal banks land around the middle instead of pegging at 1.0.
  br = rawbright * 0.78 + sqrt(highratio) * 0.17 + sqrt(airratio) * 0.05;
  br = clamp01((br - 0.16) / 0.78);
  br = br ^ 1.16;
  br;
);


function estimate_sample_tail_grace(sm) local(
  ptr nch sr frames head tail span len_ms tail_ms
  chunks chunk_len stride c a b i x ax n e first_e last_e mean_e max_e prev_e rise_e
  end_ratio rms_ratio tail_presence end_hot end_rise trans bright focus auto_ms fade_ms short_guard hot
)
(
  // v19 AutoRelease: per-sample ending analysis. The goal is not to make every
  // sample long; it is to stop energetic or room-like endings from being hard-cut
  // by a short MIDI Release or by reaching EOF before the envelope has time to land.
  ptr    = sm[SM_PTR] | 0;
  nch    = max(1, sm[SM_NCH] | 0);
  sr     = max(1000, sm[SM_SR]);
  frames = sm[SM_FRAMES] | 0;
  head   = clamp(sm[SM_HEADEND] | 0, 0, max(0, frames - 2));
  tail   = clamp(sm[SM_TAILSTART] | 0, head + 1, max(head + 1, frames - 2));

  len_ms = 1000 * frames / max(sr, 1);
  span = max(1, frames - tail);
  tail_ms = 1000 * span / max(sr, 1);

  chunks = clamp(floor(tail_ms / 22), 4, 12);
  chunk_len = max(32, floor(span / chunks));
  stride = max(1, floor(chunk_len / 192));

  first_e = 0;
  last_e = 0;
  mean_e = 0;
  max_e = 0;
  prev_e = 0;
  rise_e = 0;

  c = 0;
  while (c < chunks) (
    a = clamp(tail + c * chunk_len, tail, max(tail, frames - 2));
    b = c == chunks - 1 ? frames - 1 : clamp(a + chunk_len, a + 1, frames - 1);
    e = 0;
    n = 0;
    i = a;
    while (i < b) (
      x = mono_frame(ptr, nch, i);
      ax = abs(x);
      e += ax;
      n += 1;
      i += stride;
    );
    e /= max(1, n);

    c == 0 ? first_e = e;
    c == chunks - 1 ? last_e = e;
    c > 0 ? rise_e = max(rise_e, e - prev_e);
    prev_e = e;
    mean_e += e;
    max_e = max(max_e, e);
    c += 1;
  );

  mean_e /= max(1, chunks);
  trans = clamp01(sm[SM_FLAGS]);
  bright = clamp01(sm[SM_BRIGHT]);
  focus = clamp01(sm[SM_SHARP]);

  end_ratio = clamp01(last_e / max(mean_e, 0.000000001));
  rms_ratio = clamp01(last_e / max(sm[SM_RMS], 0.000000001));
  tail_presence = clamp01((tail_ms - 35) / 520);
  end_hot = clamp01((rms_ratio - 0.020) / 0.22);
  end_rise = clamp01(rise_e / max(mean_e, 0.000000001));
  short_guard = clamp01((len_ms - 38) / 220);

  // "Hot" means the end is not safely silent. It can be an abrupt chopped hit,
  // a room tail, a noisy sustain, or a pitched decay that is still audible.
  hot = clamp01(end_hot * 0.62 + end_ratio * 0.28 + end_rise * 0.10);

  auto_ms = 18
    + tail_presence * (36 + 90 * (1 - trans) + 28 * bright)
    + hot * (52 + 210 * tail_presence + 45 * focus)
    + end_rise * 70;
  auto_ms *= lerp(0.42, 1.0, short_guard);
  auto_ms = clamp(auto_ms, 10, min(900, max(24, len_ms * 0.65)));

  fade_ms = 8
    + tail_presence * (24 + 76 * (1 - trans))
    + hot * (34 + 165 * tail_presence + 32 * bright)
    + end_rise * 72;
  fade_ms *= lerp(0.48, 1.0, short_guard);
  fade_ms = clamp(fade_ms, 6, min(650, max(12, len_ms * 0.42)));

  sm[SM_AUTOREL] = auto_ms;
  sm[SM_ENDFADE] = fade_ms;
  sm[SM_TAILHOT] = hot;
);

function analyze_sample_classic(sm) local(
  ptr nch sr frames scan i x ax prev lp hf prevhf
  peak sumsq sumabs sumdiff brightsum roughsum rms bright edge
  thresh attack attack_ms sharp transrich
  target_rms norm lpcoef
  head_ms head_end tail_start tail_thresh tail_minlen
  step chunkabs cnt j found
)
(
  ptr    = sm[SM_PTR]   | 0;
  nch    = max(1, sm[SM_NCH] | 0);
  sr     = sm[SM_SR];
  frames = sm[SM_FRAMES] | 0;

  peak = 0;
  sumsq = 0;
  sumabs = 0;
  sumdiff = 0;
  brightsum = 0;
  roughsum = 0;
  prev = 0;
  prevhf = 0;
  lp = 0;

  scan = min(frames, max(256, floor(sr * 0.16)));
  lpcoef = clamp(1400 / max(sr, 1), 0.01, 0.35);

  i = 0;
  while (i < scan) (
    x = mono_frame(ptr, nch, i);
    ax = abs(x);
    peak = max(peak, ax);
    sumsq += x * x;
    sumabs += ax;
    i > 0 ? sumdiff += abs(x - prev);

    lp += (x - lp) * lpcoef;
    hf = x - lp;
    brightsum += abs(hf);
    i > 0 ? roughsum += abs(hf - prevhf);

    prev = x;
    prevhf = hf;
    i += 1;
  );

  rms = sqrt(sumsq / max(scan, 1));
  edge = clamp01((roughsum / max(brightsum, 0.000001)) * 0.34);

  thresh = max(peak * 0.12, rms * 1.8);
  attack = -1;
  i = 0;
  while (i < scan && attack < 0) (
    abs(mono_frame(ptr, nch, i)) >= thresh ? attack = i;
    i += 1;
  );
  attack < 0 ? attack = 0;

  bright = estimate_brightness_metric(ptr, nch, sr, attack, min(frames - attack, max(384, floor(sr * 0.20))));

  attack_ms = 1000 * attack / max(sr, 1);
  sharp = clamp01((1 - min(1, attack_ms / 70)) * 0.72 + edge * 0.28);
  transrich = clamp01(sharp * 0.64 + edge * 0.18 + (1 - min(1, attack_ms / 55)) * 0.24 + bright * 0.06);

  head_ms = 8 + transrich * 48;
  head_end = clamp(attack + floor(sr * head_ms * 0.001), attack + 8, max(attack + 8, frames - 2));
  head_end = clamp(head_end, 0, max(0, frames - 2));

  tail_thresh = max(rms * (0.46 + 0.22 * transrich), peak * (0.040 + 0.020 * bright));
  step = max(1, floor(frames / 1024));
  tail_start = max(head_end + 16, frames - 2);
  found = 0;
  i = frames - 1;
  while (i > head_end + step && !found) (
    chunkabs = 0;
    cnt = 0;
    j = 0;
    while (j < step && (i - j) >= 0) (
      chunkabs += abs(mono_frame(ptr, nch, i - j));
      cnt += 1;
      j += 1;
    );
    (chunkabs / max(cnt, 1)) > tail_thresh ? (
      tail_start = clamp(i + step * 2, head_end + 16, max(head_end + 16, frames - 2));
      found = 1;
    );
    i -= step;
  );

  tail_minlen = min(max(floor(sr * (0.08 + 0.04 * (1 - transrich))), 192), max(192, floor(frames * 0.34)));
  !found ? tail_start = clamp(floor(frames * (0.60 + 0.14 * (1 - transrich))), head_end + 16, max(head_end + 16, frames - 2));
  tail_start = min(tail_start, max(head_end + 16, frames - tail_minlen));
  tail_start <= (head_end + 8) ? tail_start = min(max(head_end + 24, floor(frames * 0.72)), max(head_end + 24, frames - 2));
  tail_start = clamp(tail_start, min(head_end + 1, max(0, frames - 2)), max(0, frames - 2));

  target_rms = 0.12;
  norm = clamp(target_rms / max(rms, 0.000001), 0.25, 4.0);

  sm[SM_RMS]    = rms;
  sm[SM_PEAK]   = peak;
  sm[SM_EDGE]   = edge;
  sm[SM_ATTACK] = attack;
  sm[SM_SHARP]  = sharp;
  sm[SM_NORM]   = norm;
  sm[SM_LENMS]  = 1000 * frames / max(sr, 1);
  sm[SM_BRIGHT] = bright;
  sm[SM_FLAGS]  = transrich;
  sm[SM_HEADEND] = head_end;
  sm[SM_TAILSTART] = tail_start;

  estimate_pitch(sm);
);

function analyze_sample_gauss(sm) local(
  ptr nch sr frames
  onset_scan hop onset_lpcoef nov_count i j x ax lp hf env_prev hf_prev env_now hf_now cnt nov novsum
  peaki peakv mean_nov smoothv starti peakthr lowthr onset_conf onset_rise onset_rise_ms
  fallback_scan fallback_peak fallback_sumsq fallback_rms thresh attack fallback_attack
  feat_lo feat_hi scan prev prevhf lpcoef
  peak sumsq sumabs sumdiff brightsum roughsum rms bright edge
  sharp transrich
  target_rms norm head_ms head_end tail_start tail_thresh tail_minlen
  step chunkabs found
)
(
  ptr    = sm[SM_PTR]   | 0;
  nch    = max(1, sm[SM_NCH] | 0);
  sr     = sm[SM_SR];
  frames = sm[SM_FRAMES] | 0;

  onset_scan = min(frames, max(4096, floor(sr * 2.00)));
  hop = max(1, floor(sr * 0.00075));
  hop = max(hop, floor((onset_scan + ONSET_SCRATCH_MAX - 1) / max(1, ONSET_SCRATCH_MAX)));
  onset_lpcoef = clamp(2200 / max(sr, 1), 0.015, 0.40);

  lp = 0;
  env_prev = 0;
  hf_prev = 0;
  nov_count = 0;
  novsum = 0;

  i = 0;
  while (i < onset_scan && nov_count < ONSET_SCRATCH_MAX) (
    env_now = 0;
    hf_now = 0;
    cnt = 0;
    j = 0;
    while (j < hop && (i + j) < onset_scan) (
      x = mono_frame(ptr, nch, i + j);
      ax = abs(x);
      lp += (x - lp) * onset_lpcoef;
      hf = x - lp;
      env_now += ax;
      hf_now += abs(hf);
      cnt += 1;
      j += 1;
    );
    env_now /= max(cnt, 1);
    hf_now /= max(cnt, 1);
    nov = max(0, hf_now - hf_prev * 0.90) + 0.32 * max(0, env_now - env_prev * 0.94);
    nov += 0.10 * max(0, hf_now - env_now * 0.22);
    onset_raw_base[nov_count] = nov;
    novsum += nov;
    env_prev = env_now;
    hf_prev = hf_now;
    nov_count += 1;
    i += hop;
  );

  peaki = 0;
  peakv = 0;
  i = 0;
  while (i < nov_count) (
    smoothv = (
      onset_raw_base[clamp(i - 3, 0, max(0, nov_count - 1))] +
      onset_raw_base[clamp(i - 2, 0, max(0, nov_count - 1))] * 6 +
      onset_raw_base[clamp(i - 1, 0, max(0, nov_count - 1))] * 15 +
      onset_raw_base[i] * 20 +
      onset_raw_base[clamp(i + 1, 0, max(0, nov_count - 1))] * 15 +
      onset_raw_base[clamp(i + 2, 0, max(0, nov_count - 1))] * 6 +
      onset_raw_base[clamp(i + 3, 0, max(0, nov_count - 1))]
    ) * 0.015625;
    onset_smooth_base[i] = smoothv;
    smoothv > peakv ? (
      peakv = smoothv;
      peaki = i;
    );
    i += 1;
  );

  fallback_scan = min(frames, onset_scan);
  fallback_peak = 0;
  fallback_sumsq = 0;
  i = 0;
  while (i < fallback_scan) (
    x = mono_frame(ptr, nch, i);
    ax = abs(x);
    fallback_peak = max(fallback_peak, ax);
    fallback_sumsq += x * x;
    i += 1;
  );
  fallback_rms = sqrt(fallback_sumsq / max(fallback_scan, 1));
  thresh = max(fallback_peak * 0.12, fallback_rms * 1.8);
  fallback_attack = -1;
  i = 0;
  while (i < fallback_scan && fallback_attack < 0) (
    abs(mono_frame(ptr, nch, i)) >= thresh ? fallback_attack = i;
    i += 1;
  );
  fallback_attack < 0 ? fallback_attack = 0;

  mean_nov = nov_count > 0 ? (novsum / nov_count) : 0;
  onset_conf = peakv > 0 ? clamp01((peakv - mean_nov * 1.35) / max(peakv, 0.000001)) : 0;
  starti = peaki;
  peakthr = peakv * (0.18 + 0.08 * (1 - onset_conf));
  while (starti > 0 && onset_smooth_base[starti - 1] >= peakthr) (
    starti -= 1;
  );
  lowthr = peakv * 0.10;
  while (starti > 0 && onset_smooth_base[starti - 1] > lowthr && (peaki - starti) < 8) (
    starti -= 1;
  );

  attack = floor(starti * hop);
  (onset_conf < 0.12 || peakv <= 0.00001) ? attack = fallback_attack;
  attack = clamp(attack, 0, max(0, frames - 2));

  onset_rise = max(hop, (peaki - starti) * hop);
  onset_rise_ms = 1000 * onset_rise / max(sr, 1);

  feat_lo = max(0, attack - min(attack, floor(sr * 0.008)));
  feat_hi = min(frames, attack + max(256, floor(sr * 0.18)));
  scan = max(1, feat_hi - feat_lo);
  lpcoef = clamp(1400 / max(sr, 1), 0.01, 0.35);

  peak = 0;
  sumsq = 0;
  sumabs = 0;
  sumdiff = 0;
  brightsum = 0;
  roughsum = 0;
  lp = 0;
  prev = mono_frame(ptr, nch, feat_lo);
  prevhf = 0;

  i = feat_lo;
  while (i < feat_hi) (
    x = mono_frame(ptr, nch, i);
    ax = abs(x);
    peak = max(peak, ax);
    sumsq += x * x;
    sumabs += ax;
    i > feat_lo ? sumdiff += abs(x - prev);

    lp += (x - lp) * lpcoef;
    hf = x - lp;
    brightsum += abs(hf);
    i > feat_lo ? roughsum += abs(hf - prevhf);

    prev = x;
    prevhf = hf;
    i += 1;
  );

  rms = sqrt(sumsq / max(scan, 1));
  edge = clamp01((roughsum / max(brightsum, 0.000001)) * 0.34);
  bright = estimate_brightness_metric(ptr, nch, sr, feat_lo, scan);

  sharp = clamp01((1 - min(1, onset_rise_ms / 18)) * 0.58 + edge * 0.24 + onset_conf * 0.18);
  transrich = clamp01(sharp * 0.58 + edge * 0.14 + onset_conf * 0.18 + bright * 0.10);

  head_ms = 4 + transrich * 30 + min(14, onset_rise_ms * 0.32);
  head_end = clamp(attack + floor(sr * head_ms * 0.001), attack + 8, max(attack + 8, frames - 2));
  head_end = clamp(head_end, 0, max(0, frames - 2));

  tail_thresh = max(rms * (0.46 + 0.22 * transrich), peak * (0.040 + 0.020 * bright));
  step = max(1, floor(frames / 1024));
  tail_start = max(head_end + 16, frames - 2);
  found = 0;
  i = frames - 1;
  while (i > head_end + step && !found) (
    chunkabs = 0;
    cnt = 0;
    j = 0;
    while (j < step && (i - j) >= 0) (
      chunkabs += abs(mono_frame(ptr, nch, i - j));
      cnt += 1;
      j += 1;
    );
    (chunkabs / max(cnt, 1)) > tail_thresh ? (
      tail_start = clamp(i + step * 2, head_end + 16, max(head_end + 16, frames - 2));
      found = 1;
    );
    i -= step;
  );

  tail_minlen = min(max(floor(sr * (0.08 + 0.04 * (1 - transrich))), 192), max(192, floor(frames * 0.34)));
  !found ? tail_start = clamp(floor(frames * (0.60 + 0.14 * (1 - transrich))), head_end + 16, max(head_end + 16, frames - 2));
  tail_start = min(tail_start, max(head_end + 16, frames - tail_minlen));
  tail_start <= (head_end + 8) ? tail_start = min(max(head_end + 24, floor(frames * 0.72)), max(head_end + 24, frames - 2));
  tail_start = clamp(tail_start, min(head_end + 1, max(0, frames - 2)), max(0, frames - 2));

  target_rms = 0.12;
  norm = clamp(target_rms / max(rms, 0.000001), 0.25, 4.0);

  sm[SM_RMS]    = rms;
  sm[SM_PEAK]   = peak;
  sm[SM_EDGE]   = edge;
  sm[SM_ATTACK] = attack;
  sm[SM_SHARP]  = sharp;
  sm[SM_NORM]   = norm;
  sm[SM_LENMS]  = 1000 * frames / max(sr, 1);
  sm[SM_BRIGHT] = bright;
  sm[SM_FLAGS]  = transrich;
  sm[SM_HEADEND] = head_end;
  sm[SM_TAILSTART] = tail_start;

  estimate_pitch(sm);
);



function dynx_db_from_amp(a)
(
  20 * log(max(a, 0.000000001)) * LOG10_INV;
);

function estimate_sample_expander_profile(sm) local(
  ptr nch sr frames win hop a b j stride x sumsq n rms db bin total total_e pwr target acc acc_e hist_bins bi
  floor_bin body_bin peak_bin floor_db body_db peak_db tail_db range_db rms_db peak_raw len_guard body_bias
)
(
  // v65 SourceExpand DepthCap: load-time profile is energy-aware, not just count-based.
  // BODY is now the energy median: the approximate level where half the window energy is above/below.
  // This gives the runtime expander a useful source-relative threshold center instead of a fixed dBFS guess.
  ptr    = sm[SM_PTR] | 0;
  nch    = max(1, sm[SM_NCH] | 0);
  sr     = max(1000, sm[SM_SR]);
  frames = sm[SM_FRAMES] | 0;
  hist_bins = DYNX_HIST_BINS;

  bi = 0;
  while (bi < hist_bins) (
    onset_raw_base[bi] = 0;       // count histogram
    onset_smooth_base[bi] = 0;    // energy histogram
    bi += 1;
  );

  frames > 96 ? (
    win = clamp(floor(sr * 0.018), 96, 2048);
    hop = max(32, floor(win * 0.50));
    total = 0;
    total_e = 0;
    a = 0;
    while (a < frames - 2) (
      b = min(frames - 1, a + win);
      stride = max(1, floor((b - a) / 96));
      sumsq = 0;
      n = 0;
      j = a;
      while (j < b) (
        x = mono_frame(ptr, nch, j);
        sumsq += x * x;
        n += 1;
        j += stride;
      );
      pwr = sumsq / max(1, n);
      rms = sqrt(pwr);
      db = dynx_db_from_amp(rms);
      db > -108 ? (
        bin = clamp(floor((db + 108) * (hist_bins - 1) / 108), 0, hist_bins - 1) | 0;
        onset_raw_base[bin] += 1;
        onset_smooth_base[bin] += max(pwr, 0.00000000000000000001);
        total += 1;
        total_e += max(pwr, 0.00000000000000000001);
      );
      a += hop;
    );

    total > 0 ? (
      // Floor: lower count percentile. This tracks bed/silence without letting one hot transient dominate.
      target = total * 0.08;
      acc = 0; floor_bin = -1; bi = 0;
      while (bi < hist_bins) (
        acc += onset_raw_base[bi];
        (acc >= target && floor_bin < 0) ? floor_bin = bi;
        bi += 1;
      );
      floor_bin < 0 ? floor_bin = 0;

      // Body: energy median. This is the important v64 change.
      target = total_e * 0.50;
      acc_e = 0; body_bin = -1; bi = 0;
      while (bi < hist_bins) (
        acc_e += onset_smooth_base[bi];
        (acc_e >= target && body_bin < 0) ? body_bin = bi;
        bi += 1;
      );
      body_bin < 0 ? body_bin = max(0, floor(hist_bins * 0.50));

      // Peak: high energy percentile, not absolute max. Avoids one click defining the whole profile.
      target = total_e * 0.92;
      acc_e = 0; peak_bin = -1; bi = 0;
      while (bi < hist_bins) (
        acc_e += onset_smooth_base[bi];
        (acc_e >= target && peak_bin < 0) ? peak_bin = bi;
        bi += 1;
      );
      peak_bin < 0 ? peak_bin = hist_bins - 1;

      floor_db = -108 + floor_bin * 108 / max(1, hist_bins - 1);
      body_db  = -108 + body_bin  * 108 / max(1, hist_bins - 1);
      peak_db  = -108 + peak_bin  * 108 / max(1, hist_bins - 1);
    ) : (
      rms_db = dynx_db_from_amp(sm[SM_RMS]);
      peak_raw = max(sm[SM_PEAK], sm[SM_RMS]);
      peak_db = dynx_db_from_amp(peak_raw);
      body_db = rms_db;
      floor_db = rms_db - 30;
    );
  ) : (
    rms_db = dynx_db_from_amp(sm[SM_RMS]);
    peak_raw = max(sm[SM_PEAK], sm[SM_RMS]);
    peak_db = dynx_db_from_amp(peak_raw);
    body_db = rms_db;
    floor_db = rms_db - 30;
  );

  len_guard = clamp01((sm[SM_LENMS] - 20) / 300);
  body_bias = clamp01(sm[SM_FLAGS]) * 1.2 - clamp01(sm[SM_TAILHOT]) * 2.5;
  body_db = clamp(body_db + body_bias, -104, 0);
  peak_db = max(peak_db, body_db + 2);
  floor_db = min(floor_db, body_db - (8 + 14 * len_guard));
  floor_db = clamp(floor_db - clamp01(sm[SM_TAILHOT]) * 5.0, -108, body_db - 5);
  range_db = clamp(body_db - floor_db, 6, 78);
  tail_db = clamp(floor_db + range_db * (0.14 + 0.36 * clamp01(sm[SM_TAILHOT])), floor_db, peak_db);

  sm[SM_EXPFLOOR] = floor_db;
  sm[SM_EXPBODY]  = clamp(body_db, floor_db + 3, min(0, peak_db));
  sm[SM_EXPPEAK]  = clamp(peak_db, sm[SM_EXPBODY] + 1, 0);
  sm[SM_EXPTAIL]  = clamp(tail_db, floor_db, sm[SM_EXPPEAK]);
  sm[SM_EXPRANGE] = clamp(sm[SM_EXPBODY] - sm[SM_EXPFLOOR], 6, 78);
);

function dynx_erb_from_hz(f)
(
  21.4 * log(0.00437 * max(0, f) + 1) * LOG10_INV;
);

function dynx_hz_from_erb(e)
(
  (exp((e / 21.4) * log(10)) - 1) / 0.00437;
);

function dynx_svf_bp(x idx) local(v0 v1 v2 g k den ic1 ic2)
(
  v0 = x;
  g = idx[0];
  k = idx[1];
  ic1 = idx[2];
  ic2 = idx[3];
  den = 1 + g * (g + k);
  v1 = (g * (v0 - ic2) + ic1) / max(0.000000001, den);
  v2 = ic2 + g * v1;
  idx[2] = denorm_zap(2 * v1 - ic1);
  idx[3] = denorm_zap(2 * v2 - ic2);
  v1;
);

function dynx_svf_bp_r(x idx) local(v0 v1 v2 g k den ic1 ic2)
(
  v0 = x;
  g = idx[0];
  k = idx[1];
  ic1 = idx[6];
  ic2 = idx[7];
  den = 1 + g * (g + k);
  v1 = (g * (v0 - ic2) + ic1) / max(0.000000001, den);
  v2 = ic2 + g * v1;
  idx[6] = denorm_zap(2 * v1 - ic1);
  idx[7] = denorm_zap(2 * v2 - ic2);
  v1;
);

function dynx_update_coeffs() local(i base fmin fmax erb_min erb_max e fc g k sumw w)
(
  fmin = 80;
  fmax = min(8000, srate * 0.45);
  fmax < 400 ? fmax = min(400, srate * 0.45);
  erb_min = dynx_erb_from_hz(fmin);
  erb_max = dynx_erb_from_hz(fmax);
  sumw = 0;
  i = 0;
  while (i < DYNX_BANDS) (
    e = erb_min + (erb_max - erb_min) * i / max(1, DYNX_BANDS - 1);
    fc = clamp(dynx_hz_from_erb(e), 20, min(srate * 0.45, 20000));
    g = tan(3.141592653589793 * fc / max(1000, srate));
    k = 1.0;
    w = fc < 200 ? 0.50 : (fc < 800 ? 0.80 : (fc < 4000 ? 1.00 : 0.70));
    base = dynx_bank_base + i * DYNX_STRIDE;
    base[0] = clamp(g, 0.000001, 1000);
    base[1] = k;
    base[5] = w;
    sumw += w;
    i += 1;
  );
  i = 0;
  while (i < DYNX_BANDS) (
    base = dynx_bank_base + i * DYNX_STRIDE;
    base[5] = base[5] / max(sumw, 0.000001);
    i += 1;
  );

  dynx_band_coeff = 1 - exp(-1 / max(1, 0.030 * srate));
  dynx_open_coeff = 1 - exp(-1 / max(1, 0.008 * srate));
  dynx_close_fast_coeff = 1 - exp(-1 / max(1, 0.060 * srate));
  dynx_close_slow_coeff = 1 - exp(-1 / max(1, 0.250 * srate));
  dynx_live_ref_coeff = 1 - exp(-1 / max(1, 0.220 * srate));
  dynx_live_rel_coeff = 1 - exp(-1 / max(1, 1.400 * srate));
  dynx_detector_slow_coeff = 1 - exp(-1 / max(1, 0.200 * srate));
  dynx_hpf_coeff = 1 - exp(-6.283185307179586 * 70 / max(1, srate));
  dynx_lpf_coeff = 1 - exp(-6.283185307179586 * min(15000, srate * 0.45) / max(1, srate));
);

function update_active_expander_profile() local(i v sid sm env gain_db stage w floor_lin body_lin peak_lin wt fdb bdb pdb tdb)
(
  floor_lin = 0;
  body_lin = 0;
  peak_lin = 0;
  wt = 0;
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    v[VC_ACTIVE] > 0 ? (
      sid = v[VC_SAMPLE] | 0;
      (sid >= 0 && sid < sample_count) ? (
        sm = sample_meta_base + sid * SM_STRIDE;
        env = clamp01(v[VC_ENV]);
        w = max(0.015, env * max(0.10, abs(v[VC_BASE])));
        gain_db = dynx_db_from_amp(max(abs(v[VC_BASE]), 0.000000001));
        stage = v[VC_STAGE] | 0;
        fdb = sm[SM_EXPFLOOR] + gain_db;
        bdb = sm[SM_EXPBODY] + gain_db;
        pdb = sm[SM_EXPPEAK] + gain_db;
        tdb = sm[SM_EXPTAIL] + gain_db;
        stage == ENV_RELEASE ? (
          bdb = max(tdb, fdb + 5);
          fdb = min(fdb, bdb - 6);
          pdb = max(pdb, bdb + 2);
        );
        floor_lin += db2amp(fdb) * db2amp(fdb) * w;
        body_lin += db2amp(bdb) * db2amp(bdb) * w;
        peak_lin += db2amp(pdb) * db2amp(pdb) * w;
        wt += w;
      );
    );
    i += 1;
  );

  wt > 0 ? (
    dynx_profile_floor_db = clamp(10 * log(max(floor_lin / wt, 0.00000000000000000001)) * LOG10_INV, -108, 12);
    dynx_profile_body_db = clamp(10 * log(max(body_lin / wt, 0.00000000000000000001)) * LOG10_INV, -108, 12);
    dynx_profile_peak_db = clamp(10 * log(max(peak_lin / wt, 0.00000000000000000001)) * LOG10_INV, -108, 12);
    dynx_profile_body_db = max(dynx_profile_body_db, dynx_profile_floor_db + 4);
    dynx_profile_peak_db = max(dynx_profile_peak_db, dynx_profile_body_db + 2);
    dynx_profile_range_db = clamp(dynx_profile_body_db - dynx_profile_floor_db, 6, 78);
  ) : (
    dynx_profile_floor_db = bank_exp_floor_db;
    dynx_profile_body_db = bank_exp_body_db;
    dynx_profile_peak_db = bank_exp_peak_db;
    dynx_profile_range_db = bank_exp_range_db;
  );
);

function reset_dynamics_expand_buffers() local(i base)
(
  dynx_gain = 1;
  dynx_lim_gain = 1;
  dynx_detector_slow = 0;
  dynx_live_ref_db = bank_exp_body_db;
  dynx_det_db_m = -96;
  dynx_gr_db_m = 0;
  dynx_expanding = 0;
  dynx_hpf_lp = 0;
  dynx_lpf_y = 0;
  dynx_hpf_lp_r = 0; dynx_lpf_y_r = 0;
  i = 0;
  while (i < DYNX_BANDS) (
    base = dynx_bank_base + i * DYNX_STRIDE;
    base[2] = 0;
    base[3] = 0;
    base[4] = 0; base[6] = 0; base[7] = 0;
    i += 1;
  );
);

function apply_dynamics_expand() local(
  inL inR depth x x_det x_det_r base i bp bpr p env sum det_lin det_db threshold_db live_conf profile_thr live_thr
  d xk s ratio_base ratio_eff target_gr target_gain_db target_gain post lim_tgt protect knee_db hys_db depth_cap_db depth_cap_norm close_c body_anchor thr_span thr_offset hi_room
)
(
  // v65 SourceExpand DepthCap: ERB detector -> single broadband gain.
  // Threshold is anchored around the active source energy median and becomes intentionally aggressive at high amounts.
  inL = outL;
  inR = outR;
  depth = clamp01(dynamics_expand_amt);


  depth > 0.0001 ? (
    update_active_expander_profile();

    x = inL;
    x_det = x;
    dynx_hpf_lp = denorm_zap(dynx_hpf_lp + (x_det - dynx_hpf_lp) * dynx_hpf_coeff);
    x_det -= dynx_hpf_lp;
    dynx_lpf_y = denorm_zap(dynx_lpf_y + (x_det - dynx_lpf_y) * dynx_lpf_coeff);
    x_det = dynx_lpf_y;
    dynx_hpf_lp_r = denorm_zap(dynx_hpf_lp_r + (inR - dynx_hpf_lp_r) * dynx_hpf_coeff);
    dynx_lpf_y_r = denorm_zap(dynx_lpf_y_r + (inR - dynx_hpf_lp_r - dynx_lpf_y_r) * dynx_lpf_coeff);
    x_det_r = dynx_lpf_y_r;

    sum = 0;
    i = 0;
    while (i < DYNX_BANDS) (
      base = dynx_bank_base + i * DYNX_STRIDE;
      bp = dynx_svf_bp(x_det, base);
      bpr = dynx_svf_bp_r(x_det_r, base);
      p = 0.5 * (bp * bp + bpr * bpr);
      env = base[4];
      env = denorm_zap(env + (p - env) * dynx_band_coeff);
      base[4] = env;
      sum += base[5] * env;
      i += 1;
    );

    det_lin = sqrt(max(sum, 0.000000000001));
    det_db = dynx_db_from_amp(det_lin);
    dynx_det_db_m = denorm_zap(dynx_det_db_m + (det_db - dynx_det_db_m) * 0.035);
    dynx_detector_slow = denorm_zap(dynx_detector_slow + (det_lin - dynx_detector_slow) * dynx_detector_slow_coeff);

    // The source profile BODY is an energy median. The threshold orbits that median:
    // low amounts sit below it, high amounts climb slightly above it for obvious cleanup.
    body_anchor = dynx_profile_body_db;
    hi_room = clamp(dynx_profile_peak_db - body_anchor, 2, 24);
    thr_offset = lerp(-17.0, min(6.0, hi_room * 0.55), depth ^ 0.72);
    profile_thr = body_anchor + thr_offset;
    profile_thr = clamp(profile_thr, dynx_profile_floor_db + 3.0, dynx_profile_peak_db - 0.5);

    // Live correction is intentionally mild. Fully adaptive thresholds follow beds and stop cleaning.
    live_conf = clamp01((det_db - dynx_profile_floor_db - 4) / max(6, dynx_profile_range_db * 0.30));
    live_conf > 0.12 ? (
      dynx_live_ref_db = denorm_zap(dynx_live_ref_db + (det_db - dynx_live_ref_db) * dynx_live_ref_coeff * live_conf);
    ) : (
      dynx_live_ref_db = denorm_zap(dynx_live_ref_db + (body_anchor - dynx_live_ref_db) * dynx_live_rel_coeff);
    );
    live_thr = dynx_live_ref_db - (5.0 + 10.0 * ((1 - depth) ^ 0.8));
    threshold_db = clamp(lerp(profile_thr, live_thr, 0.10 * live_conf * (1 - depth * 0.35)), dynx_profile_floor_db + 2, dynx_profile_peak_db - 0.5);
    dynx_threshold_db = threshold_db;

    // Ctrl+Dynamics sets the maximum gain reduction. Expansion Amount still
    // decides threshold aggression/ratio; Depth only caps how far it may pull.
    depth_cap_db = clamp(dynamics_expand_depth_db, 0, 60);
    depth_cap_norm = clamp01(depth_cap_db / 60);
    knee_db = lerp(12.0, 2.0, depth ^ 1.20) * lerp(1.15, 0.75, depth_cap_norm);
    knee_db = clamp(knee_db, 1.5, 14.0);
    hys_db = clamp(knee_db * 0.30, 1.0, 4.0);

    dynx_expanding <= 0 ? (
      det_db < threshold_db ? dynx_expanding = 1;
    ) : (
      det_db > (threshold_db + hys_db) ? dynx_expanding = 0;
    );

    target_gr = 0;
    dynx_expanding ? (
      d = threshold_db - det_db;
      d < 0 ? d = 0;
      ratio_base = 1.25 + 5.25 * (depth ^ 0.86);
      d < knee_db ? (
        xk = clamp01(d / max(0.000001, knee_db));
        s = xk * xk * (3 - 2 * xk);
        ratio_eff = 1 + (ratio_base - 1) * s;
      ) : (
        ratio_eff = ratio_base;
      );
      target_gr = d * (ratio_eff - 1);
      target_gr > depth_cap_db ? target_gr = depth_cap_db;
    );

    // Keep attacks from being shaved, but do not neuter high expansion amounts.
    protect = clamp01(transient_guard_s * (0.22 + 0.12 * trans_mode_mix) * (1 - 0.55 * depth));
    target_gr *= 1 - protect;

    target_gain_db = -target_gr;
    dynx_gr_db_m = denorm_zap(dynx_gr_db_m + (target_gr - dynx_gr_db_m) * 0.075);
    close_c = (det_lin < dynx_detector_slow * lerp(0.98, 0.86, depth)) ? dynx_close_fast_coeff : dynx_close_slow_coeff;
    target_gain = db2amp(target_gain_db);
    dynx_gain = denorm_zap(dynx_gain + (target_gain - dynx_gain) * (target_gain > dynx_gain ? dynx_open_coeff : close_c));
    dynx_gain = clamp(dynx_gain, db2amp(-78), 1.08);

    outL = inL * dynx_gain;
    outR = inR * dynx_gain;

    post = max(abs(outL), abs(outR));
    lim_tgt = post > 1.02 ? 1.02 / post : 1;
    dynx_lim_gain = denorm_zap(dynx_lim_gain + (lim_tgt - dynx_lim_gain) * (lim_tgt < dynx_lim_gain ? dyn_lim_att_coeff : dyn_lim_rel_coeff));
    outL *= dynx_lim_gain;
    outR *= dynx_lim_gain;
  ) : (
    reset_dynamics_expand_buffers();
  );
);


function analyze_sample(sm) local(j anchor classic_anchor gauss_anchor)
(
  onset_mode_active ? analyze_sample_gauss(sm) : analyze_sample_classic(sm);
  anchor = sm[SM_ATTACK];
  memcpy(analysis_copy_base, sm, SM_STRIDE);
  onset_mode_active ? analyze_sample_classic(sm) : analyze_sample_gauss(sm);
  classic_anchor = onset_mode_active ? sm[SM_ATTACK] : anchor;
  gauss_anchor = onset_mode_active ? anchor : sm[SM_ATTACK];
  memcpy(sm, analysis_copy_base, SM_STRIDE);
  sm[SM_CLASSIC_ATTACK] = classic_anchor;
  sm[SM_GAUSS_ATTACK] = gauss_anchor;
  hub_analyze_loop(sm);
  estimate_sample_tail_grace(sm);
  // Retired broadband expander profile is no longer analyzed.
  // v37 PerfGate: skip Granular-only corpus markers and obsolete learned-flow
  // extraction during normal bank analysis. Corpus markers are computed lazily
  // inside build_grain_corpus(), only when Granular mode needs them.
);


function reset_voices() local(i j v)
(
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    j = 0;
    while (j < VC_STRIDE) (
      v[j] = 0;
      j += 1;
    );
    v[VC_STAGE] = ENV_OFF;
    i += 1;
  );
);

function note_gate_idx(note chan)
(
  (clamp(chan, 0, 15) | 0) * 128 + (clamp(note, 0, 127) | 0);
);

function reset_note_gates() local(i)
(
  i = 0;
  while (i < NOTE_GATE_CELLS) (
    note_gate_base[i] = 0;
    note_on_seq_base[i] = 0;
    note_off_seq_base[i] = 0;
    i += 1;
  );
);

function note_gate_on(note chan) local(idx)
(
  idx = note_gate_idx(note, chan);
  note_gate_base[idx] += 1;
  note_on_seq_base[idx] += 1;
);

function note_gate_off(note chan) local(idx)
(
  idx = note_gate_idx(note, chan);
  note_off_seq_base[idx] < note_on_seq_base[idx] ? (
    note_off_seq_base[idx] += 1;
    note_gate_base[idx] = max(0, note_gate_base[idx] - 1);
  );
);

function count_held_note_voices(note chan) local(i v cnt)
(
  cnt = 0;
  i = 0;
  while (i < MAX_VOICES) (
    v = voice_base + i * VC_STRIDE;
    (v[VC_ACTIVE] > 0 && v[VC_AUDIOTRIG] <= 0 && v[VC_NOTE] == note && v[VC_CHAN] == chan && v[VC_STAGE] != ENV_RELEASE) ? cnt += 1;
    i += 1;
  );
  cnt;
);

function reset_weight_buffers() local(i)
(
  weight_ap1_pos = 0;
  weight_ap2_pos = 0;
  weight_er_pos = 0;
  weight_in_lp_l = 0;
  weight_in_lp_r = 0;
  weight_wet_lp_l = 0;
  weight_wet_lp_r = 0;

  i = 0;
  while (i < AP_BUF_LEN) (
    weight_ap1_l_base[i] = 0;
    weight_ap1_r_base[i] = 0;
    weight_ap2_l_base[i] = 0;
    weight_ap2_r_base[i] = 0;
    i += 1;
  );

  i = 0;
  while (i < ER_BUF_LEN) (
    weight_er_l_base[i] = 0;
    weight_er_r_base[i] = 0;
    i += 1;
  );
);

function decrust_zap(x)
(
  abs(x) < DENORM_CUT ? 0 : x;
);

function cubic_mid(a b d e)
(
  // DeCrust curvature assist predictor. Must live before apply_clean_decrust()
  // because JSFX/EEL2 function resolution is top-down.
  (-a + 9 * b + 9 * d - e) / 16;
);

function decrust_clear_state() 
(
  memset(dc_inl_base, 0, DECRUST_RING);
  memset(dc_inr_base, 0, DECRUST_RING);
  memset(dc_outl_base, 0, DECRUST_RING);
  memset(dc_outr_base, 0, DECRUST_RING);
  memset(dc_mag_base, 0, DECRUST_BINS);
  memset(dc_base_base, 0, DECRUST_BINS);
  memset(dc_prev_base, 0, DECRUST_BINS);
  memset(dc_m1_base, 0, DECRUST_BINS);
  memset(dc_m2_base, 0, DECRUST_BINS);
  memset(dc_m3_base, 0, DECRUST_BINS);
  memset(dc_m4_base, 0, DECRUST_BINS);
  memset(dc_gain_base, 0, DECRUST_BINS);

  memset(dc_padl_base, 0, 8); memset(dc_padr_base, 0, 8);
  memset(input_delay_l_base, 0, DECRUST_RING); memset(input_delay_r_base, 0, DECRUST_RING);
  dc_enable_mix = 0; dc_warm_left = DECRUST_LATENCY + DECRUST_FFT;
  dc_padpos = 0; input_delay_pos = 0;
  dc_fft_ready = 0;
  dc_ringpos = 0;
  dc_hop_ctr = 0;
  dc_last_detect = 0;
  dc_tdl0 = 0; dc_tdl1 = 0; dc_tdl2 = 0; dc_tdl3 = 0; dc_tdl4 = 0;
  dc_tdr0 = 0; dc_tdr1 = 0; dc_tdr2 = 0; dc_tdr3 = 0; dc_tdr4 = 0;
);

// Switch delay topology only at a block boundary and at zero transition gain.
// A live toggle fades the entire aligned output (including external input).
// No delay, curvature, FFT or ring traffic occurs in settled bypass.
function decrust_sync_latency() local(requested contour_requested)
(
  requested = clean_decrust_amt > 0.0001 ? 1 : 0;
  contour_requested = dynamics_expand_amt > 0.0001 ? 1 : 0;
  (requested != dc_latency_active || contour_requested != v71_contour_active) ? (
    (event_clock_samps <= 0 || dc_switch_gain <= 0) ? (
      dc_latency_active = requested;
      v71_contour_active = contour_requested;
      sc_config(contour_requested ? dynamics_expand_amt : 0);
      v71_cached_contour = contour_requested ? dynamics_expand_amt : 0;
      sc_reset();
      v71_total_delay = (dc_latency_active ? DECRUST_LATENCY : 0) + (v71_contour_active ? sc_n : 0);
      decrust_clear_state();
      v71_input_epoch += 1; v71_input_pos = 0; v71_input_left = 0;
      dc_output_warm_left = event_clock_samps > 0 ? v71_total_delay : 0;
      dc_switch_target = 1;
    ) : dc_switch_target = 0;
  ) : dc_switch_target = 1;
  pdc_delay = v71_total_delay;
  za_keep_awake = (dc_switch_gain < 1 || dc_switch_target < 1 || dc_output_warm_left > 0 || sc_running || sa_running || st_running || v71_profile_gain != v71_profile_target);
);

function decrust_build_windows() local(i j idx w sum overlaps)
(
  i = 0;
  while (i < DECRUST_FFT) (
    w = 0.5 - 0.5 * cos(6.283185307179586 * i / max(1, DECRUST_FFT - 1));
    dc_win_base[i] = w;
    i += 1;
  );

  overlaps = max(1, floor(DECRUST_FFT / DECRUST_HOP));
  i = 0;
  while (i < DECRUST_FFT) (
    sum = 0;
    j = 0;
    idx = i;
    while (j < overlaps) (
      sum += dc_win_base[idx] * dc_win_base[idx];
      idx += DECRUST_HOP;
      idx >= DECRUST_FFT ? idx -= DECRUST_FFT;
      j += 1;
    );
    dc_syn_base[i] = sum > 0.000000000001 ? dc_win_base[i] / sum : dc_win_base[i];
    i += 1;
  );
  dc_fft_ready = 1;
);

function decrust_update_params() local(drive stage extreme sens_eff)
(
  drive = clamp01(clean_decrust_amt);
  stage = clamp01(drive * 2.0);
  extreme = clamp01((drive - 0.5) * 2.0);
  sens_eff = min(1.55, 0.18 + 1.12 * stage + 0.45 * extreme);

  dc_stage = stage;
  dc_extreme = extreme;
  dc_neighbor = lerp(0.65, 0.88, extreme);
  dc_curve_amt = min(1.85, stage + 0.85 * extreme);
  dc_kurt_thr = max(0.10, 4.0 - 3.25 * sens_eff - 1.15 * extreme);
  dc_peak_thr = max(0.12, 2.6 - 1.4 * sens_eff - 0.55 * extreme);
  dc_flux_thr = max(0.08, 1.6 - 1.2 * sens_eff - 0.48 * extreme);
  dc_ceiling_mult = max(0.28, 2.1 - 0.9 * sens_eff - 0.58 * extreme);
  dc_tau_m = max(0.040, 0.250 * lerp(1.0, 0.62, extreme));
  dc_tau_b = max(0.060, dc_tau_m * 1.5);
  dc_am = exp(-DECRUST_HOP / max(1, dc_tau_m * srate));
  dc_bm = 1 - dc_am;
  dc_ab = exp(-DECRUST_HOP / max(1, dc_tau_b * srate));
  dc_bb = 1 - dc_ab;
  dc_focus_hz = 6000;
  dc_fft_ready <= 0 ? decrust_build_windows();
);

function decrust_process_frame() local(
  i k idx srcidx outidx reL imL reR imR mag2L mag2R magbin base_old x x2 x3 x4
  m1v m2v m3v m4v mu2 mu4 exk flux n1 n2 n3 n4 neigh peak dk dp df fw control
  repair_ref hard_gain raw_gain sm_gain g0 g1 g2 scale avg_red strength
)
(
  srcidx = (dc_ringpos - DECRUST_FFT + 1) & DECRUST_RINGMASK;

  i = 0;
  while (i < DECRUST_FFT) (
    idx = 2 * i;
    dc_fftl_base[idx] = dc_inl_base[srcidx] * dc_win_base[i];
    dc_fftl_base[idx + 1] = 0;
    dc_fftr_base[idx] = dc_inr_base[srcidx] * dc_win_base[i];
    dc_fftr_base[idx + 1] = 0;
    srcidx = (srcidx + 1) & DECRUST_RINGMASK;
    i += 1;
  );

  fft(dc_fftl_base, DECRUST_FFT);
  fft(dc_fftr_base, DECRUST_FFT);
  fft_permute(dc_fftl_base, DECRUST_FFT);
  fft_permute(dc_fftr_base, DECRUST_FFT);

  k = 0;
  while (k < DECRUST_BINS) (
    idx = 2 * k;
    reL = dc_fftl_base[idx]; imL = dc_fftl_base[idx + 1];
    reR = dc_fftr_base[idx]; imR = dc_fftr_base[idx + 1];
    mag2L = max(0, reL * reL + imL * imL);
    mag2R = max(0, reR * reR + imR * imR);
    dc_mag_base[k] = sqrt(0.5 * (mag2L + mag2R));
    k += 1;
  );

  dc_gain_base[0] = 1;
  dc_gain_base[DECRUST_BINS - 1] = 1;
  avg_red = 0;

  k = 1;
  while (k < (DECRUST_BINS - 1)) (
    magbin = dc_mag_base[k];
    base_old = dc_base_base[k];
    base_old < 0.000000000000000001 ? base_old = max(magbin, 0.000000000000000001);

    x = min(10, magbin / (base_old + 0.000000000000000001));
    x2 = x * x; x3 = x2 * x; x4 = x2 * x2;

    m1v = dc_m1_base[k] = decrust_zap(dc_am * dc_m1_base[k] + dc_bm * x);
    m2v = dc_m2_base[k] = decrust_zap(dc_am * dc_m2_base[k] + dc_bm * x2);
    m3v = dc_m3_base[k] = decrust_zap(dc_am * dc_m3_base[k] + dc_bm * x3);
    m4v = dc_m4_base[k] = decrust_zap(dc_am * dc_m4_base[k] + dc_bm * x4);

    dc_base_base[k] = decrust_zap(dc_ab * base_old + dc_bb * magbin);

    mu2 = m2v - m1v * m1v;
    mu2 < 0.0000000001 ? (
      exk = 0;
    ) : (
      mu4 = m4v - 4 * m1v * m3v + 6 * m1v * m1v * m2v - 3 * m1v * m1v * m1v * m1v;
      exk = clamp(mu4 / (mu2 * mu2 + 0.000000000000000001) - 3, 0, 30);
    );

    flux = max(0, magbin - dc_prev_base[k]) / (base_old + 0.000000000000000001);
    dc_prev_base[k] = magbin;

    n1 = dc_mag_base[max(0, k - 2)];
    n2 = dc_mag_base[k - 1];
    n3 = dc_mag_base[k + 1];
    n4 = dc_mag_base[min(DECRUST_BINS - 1, k + 2)];
    neigh = 0.25 * (n1 + n2 + n3 + n4);
    neigh < 0.000000000000000001 ? neigh = base_old;

    peak = magbin / (neigh + 0.000000000000000001);
    dk = clamp01((exk - dc_kurt_thr) / max(0.25, dc_kurt_thr + 1));
    dp = clamp01((peak - dc_peak_thr) / max(0.18, dc_peak_thr));
    df = clamp01((flux - dc_flux_thr) / max(0.14, dc_flux_thr));

    fw = clamp01((k * srate / DECRUST_FFT) / max(100, dc_focus_hz));
    fw = fw * fw;

    strength = clamp01((0.55 * dk + 0.30 * dp + 0.15 * df) * (1 + 0.95 * dc_extreme));
    control = dc_stage * strength * (0.2 + 0.8 * fw);

    repair_ref = dc_neighbor * neigh + (1 - dc_neighbor) * base_old;
    hard_gain = min(1, (dc_ceiling_mult * repair_ref + 0.000000000000000001) / (magbin + 0.000000000000000001));
    raw_gain = 1 - control * (1 - hard_gain);
    dc_extreme > 0 ? raw_gain = min(raw_gain, 1 - clamp01(control * (1.0 + 0.55 * dc_extreme)) * (1 - hard_gain));
    raw_gain = clamp(raw_gain, 0.025, 1);
    dc_gain_base[k] = raw_gain;
    avg_red += 1 - raw_gain;
    k += 1;
  );

  dc_last_detect = denorm_zap(dc_last_detect * 0.92 + 0.08 * (avg_red / max(1, DECRUST_BINS - 2)));

  k = 1;
  while (k < (DECRUST_BINS - 1)) (
    g0 = dc_gain_base[k - 1];
    g1 = dc_gain_base[k];
    g2 = dc_gain_base[k + 1];
    sm_gain = 0.16 * g0 + 0.68 * g1 + 0.16 * g2;
    dc_gain_base[k] = sm_gain;

    idx = 2 * k;
    dc_fftl_base[idx] *= sm_gain;
    dc_fftl_base[idx + 1] *= sm_gain;
    dc_fftr_base[idx] *= sm_gain;
    dc_fftr_base[idx + 1] *= sm_gain;

    idx = 2 * (DECRUST_FFT - k);
    dc_fftl_base[idx] *= sm_gain;
    dc_fftl_base[idx + 1] *= sm_gain;
    dc_fftr_base[idx] *= sm_gain;
    dc_fftr_base[idx + 1] *= sm_gain;
    k += 1;
  );

  fft_ipermute(dc_fftl_base, DECRUST_FFT);
  fft_ipermute(dc_fftr_base, DECRUST_FFT);
  ifft(dc_fftl_base, DECRUST_FFT);
  ifft(dc_fftr_base, DECRUST_FFT);

  scale = 1 / DECRUST_FFT;
  outidx = (dc_ringpos + 1) & DECRUST_RINGMASK;
  i = 0;
  while (i < DECRUST_FFT) (
    idx = 2 * i;
    dc_outl_base[outidx] += dc_fftl_base[idx] * scale * dc_syn_base[i];
    dc_outr_base[outidx] += dc_fftr_base[idx] * scale * dc_syn_base[i];
    outidx = (outidx + 1) & DECRUST_RINGMASK;
    i += 1;
  );
);

function apply_clean_decrust() local(
  dryidx dryL dryR rawL rawR predL predR envL envR oddL oddR bendL bendR metricL metricR
  curve_gate ctrl_mid mid_in side_in mid_pred side_pred mid_wet side_wet wetL wetR deltaL deltaR wetmix
)
(
  // v46 CleanDeCrust: FFT-512 spectral-kurtosis crust repair. This is the
  // hidden Shift+Clean mode and the only place the FFT runs. Amount 0.5 roughly
  // matches the standalone DeCrust settings shown by the user; above that goes
  // intentionally fail-fast and more extreme.
  dc_latency_active ? (
    dc_fft_ready <= 0 ? decrust_update_params();

    dc_inl_base[dc_ringpos] = outL;
    dc_inr_base[dc_ringpos] = outR;

    rawL = dc_outl_base[dc_ringpos];
    rawR = dc_outr_base[dc_ringpos];
    dc_outl_base[dc_ringpos] = 0;
    dc_outr_base[dc_ringpos] = 0;

    dc_hop_ctr += 1;
    dc_hop_ctr >= DECRUST_HOP ? (
      dc_hop_ctr = 0;
      (clean_decrust_amt > 0.0001 || dc_enable_mix > 0) ? decrust_process_frame();
    );

    dryidx = (dc_ringpos - DECRUST_LATENCY) & DECRUST_RINGMASK;
    dryL = dc_inl_base[dryidx];
    dryR = dc_inr_base[dryidx];

    dc_tdl0 = dc_tdl1; dc_tdl1 = dc_tdl2; dc_tdl2 = dc_tdl3; dc_tdl3 = dc_tdl4; dc_tdl4 = rawL;
    dc_tdr0 = dc_tdr1; dc_tdr1 = dc_tdr2; dc_tdr2 = dc_tdr3; dc_tdr3 = dc_tdr4; dc_tdr4 = rawR;

    predL = cubic_mid(dc_tdl0, dc_tdl1, dc_tdl3, dc_tdl4);
    predR = cubic_mid(dc_tdr0, dc_tdr1, dc_tdr3, dc_tdr4);
    envL = abs(dc_tdl1) + abs(dc_tdl2) + abs(dc_tdl3) + 0.000000000000000001;
    envR = abs(dc_tdr1) + abs(dc_tdr2) + abs(dc_tdr3) + 0.000000000000000001;
    oddL = abs(dc_tdl2 - predL) / (abs(predL) + envL + 0.000000000000000001);
    oddR = abs(dc_tdr2 - predR) / (abs(predR) + envR + 0.000000000000000001);
    bendL = abs(dc_tdl1 - 2 * dc_tdl2 + dc_tdl3) / envL;
    bendR = abs(dc_tdr1 - 2 * dc_tdr2 + dc_tdr3) / envR;
    metricL = clamp01(0.7 * clamp01((oddL - 0.04) / 0.16) + 0.3 * clamp01((bendL - 0.01) / 0.08));
    metricR = clamp01(0.7 * clamp01((oddR - 0.04) / 0.16) + 0.3 * clamp01((bendR - 0.01) / 0.08));
    curve_gate = clamp01((dc_last_detect - 0.001) * 80);
    ctrl_mid = dc_curve_amt * curve_gate * max(metricL, metricR);

    mid_in = 0.5 * (dc_tdl2 + dc_tdr2);
    side_in = 0.5 * (dc_tdl2 - dc_tdr2);
    mid_pred = 0.5 * (predL + predR);
    side_pred = 0.5 * (predL - predR);
    mid_wet = mid_in + ctrl_mid * (mid_pred - mid_in);
    side_wet = side_in; // stereo-safe default: no side curvature in the sampler mode.
    wetL = mid_wet + side_wet;
    wetR = mid_wet - side_wet;

    dc_padl_base[dc_padpos] = wetL; dc_padr_base[dc_padpos] = wetR;
    wetL = dc_padl_base[(dc_padpos - 6) & 7]; wetR = dc_padr_base[(dc_padpos - 6) & 7];
    dc_padpos = (dc_padpos + 1) & 7;
    dc_warm_left = max(0, dc_warm_left - 1);
    dc_target_mix = clean_decrust_amt > 0.0001 && dc_warm_left <= 0 ? 1 : 0;
    dc_enable_mix += clamp(dc_target_mix - dc_enable_mix, -1 / DECRUST_FFT, 1 / DECRUST_FFT);
    deltaL = wetL - dryL;
    deltaR = wetR - dryR;
    wetmix = dc_stage * dc_enable_mix;
    outL = decrust_zap(dryL + wetmix * deltaL);
    outR = decrust_zap(dryR + wetmix * deltaR);

    dc_ringpos = (dc_ringpos + 1) & DECRUST_RINGMASK;
  );
);

function reset_clean_buffers() local(i)
(
  clean_lp1_l = 0;
  clean_lp2_l = 0;
  clean_lp3_l = 0;
  clean_lp4_l = 0;
  clean_lp1_r = 0;
  clean_lp2_r = 0;
  clean_lp3_r = 0;
  clean_lp4_r = 0;
  clean_head_bus = 0;
  clean_tail_bus = 0;

  i = 0;
  while (i < CLEAN_BANDS) (
    clean_env_base[i] = 0;
    clean_floor_base[i] = 0;
    clean_slow_base[i] = 0;
    clean_gain_base[i] = 1;
    i += 1;
  );

);

function reset_room_buffers()
(
  room_lp1_l = 0;
  room_lp2_l = 0;
  room_lp3_l = 0;
  room_lp4_l = 0;
  room_lp1_r = 0;
  room_lp2_r = 0;
  room_lp3_r = 0;
