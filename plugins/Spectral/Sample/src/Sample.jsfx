              gwet_valid = srcp >= 0 && srcp < gframes - 1;
              gdry_valid = pitch_parallel_active && dry_srcp >= 0 && dry_srcp < gframes - 1;
              (gwet_valid || gdry_valid) ? (
                gl = 0; gr = 0; gdry_l = 0; gdry_r = 0;
                gwet_valid ? (
                  sample_frame2(gptr, gnch, srcp); gl = readL; gr = readR;
                );
                gdry_valid ? (
                  sample_frame2(gptr, gnch, dry_srcp); gdry_l = readL; gdry_r = readR;
                );

                granular_voice && edge_melt_amt > 0.0001 ? (
                  // Per-grain pre-rolloff: smooths HF edge before panning/gain
                  // without dulling already-dark material. State is per grain.
