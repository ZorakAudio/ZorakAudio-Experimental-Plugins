cmd_sum_total=cmd_sum(cmd_safe0+cmd_safe1+cmd_safe2+cmd_safe3+cmd_safe4+cmd_safe5+cmd_safe6+cmd_safe7+cmd_safe8+cmd_safe9+cmd_safe10+cmd_safe11+cmd_safe12+cmd_safe13+cmd_safe14+cmd_safe15+cmd_safe16+cmd_safe17+cmd_safe18+cmd_safe19+cmd_safe20+cmd_safe21+cmd_safe22+cmd_safe23);
cmd_sum_low=cmd_sum(select2(cmd_fc0<260,0,cmd_safe0)+select2(cmd_fc1<260,0,cmd_safe1)+select2(cmd_fc2<260,0,cmd_safe2)+select2(cmd_fc3<260,0,cmd_safe3)+select2(cmd_fc4<260,0,cmd_safe4)+select2(cmd_fc5<260,0,cmd_safe5)+select2(cmd_fc6<260,0,cmd_safe6)+select2(cmd_fc7<260,0,cmd_safe7)+select2(cmd_fc8<260,0,cmd_safe8)+select2(cmd_fc9<260,0,cmd_safe9)+select2(cmd_fc10<260,0,cmd_safe10)+select2(cmd_fc11<260,0,cmd_safe11)+select2(cmd_fc12<260,0,cmd_safe12)+select2(cmd_fc13<260,0,cmd_safe13)+select2(cmd_fc14<260,0,cmd_safe14)+select2(cmd_fc15<260,0,cmd_safe15)+select2(cmd_fc16<260,0,cmd_safe16)+select2(cmd_fc17<260,0,cmd_safe17)+select2(cmd_fc18<260,0,cmd_safe18)+select2(cmd_fc19<260,0,cmd_safe19)+select2(cmd_fc20<260,0,cmd_safe20)+select2(cmd_fc21<260,0,cmd_safe21)+select2(cmd_fc22<260,0,cmd_safe22)+select2(cmd_fc23<260,0,cmd_safe23));
cmd_sum_contact=cmd_sum(select2((cmd_fc0>=1100)&(cmd_fc0<=8000),0,cmd_safe0)+select2((cmd_fc1>=1100)&(cmd_fc1<=8000),0,cmd_safe1)+select2((cmd_fc2>=1100)&(cmd_fc2<=8000),0,cmd_safe2)+select2((cmd_fc3>=1100)&(cmd_fc3<=8000),0,cmd_safe3)+select2((cmd_fc4>=1100)&(cmd_fc4<=8000),0,cmd_safe4)+select2((cmd_fc5>=1100)&(cmd_fc5<=8000),0,cmd_safe5)+select2((cmd_fc6>=1100)&(cmd_fc6<=8000),0,cmd_safe6)+select2((cmd_fc7>=1100)&(cmd_fc7<=8000),0,cmd_safe7)+select2((cmd_fc8>=1100)&(cmd_fc8<=8000),0,cmd_safe8)+select2((cmd_fc9>=1100)&(cmd_fc9<=8000),0,cmd_safe9)+select2((cmd_fc10>=1100)&(cmd_fc10<=8000),0,cmd_safe10)+select2((cmd_fc11>=1100)&(cmd_fc11<=8000),0,cmd_safe11)+select2((cmd_fc12>=1100)&(cmd_fc12<=8000),0,cmd_safe12)+select2((cmd_fc13>=1100)&(cmd_fc13<=8000),0,cmd_safe13)+select2((cmd_fc14>=1100)&(cmd_fc14<=8000),0,cmd_safe14)+select2((cmd_fc15>=1100)&(cmd_fc15<=8000),0,cmd_safe15)+select2((cmd_fc16>=1100)&(cmd_fc16<=8000),0,cmd_safe16)+select2((cmd_fc17>=1100)&(cmd_fc17<=8000),0,cmd_safe17)+select2((cmd_fc18>=1100)&(cmd_fc18<=8000),0,cmd_safe18)+select2((cmd_fc19>=1100)&(cmd_fc19<=8000),0,cmd_safe19)+select2((cmd_fc20>=1100)&(cmd_fc20<=8000),0,cmd_safe20)+select2((cmd_fc21>=1100)&(cmd_fc21<=8000),0,cmd_safe21)+select2((cmd_fc22>=1100)&(cmd_fc22<=8000),0,cmd_safe22)+select2((cmd_fc23>=1100)&(cmd_fc23<=8000),0,cmd_safe23));
cmd_sum_visc=cmd_sum(select2((cmd_fc0>=320)&(cmd_fc0<=6200),0,cmd_safe0)+select2((cmd_fc1>=320)&(cmd_fc1<=6200),0,cmd_safe1)+select2((cmd_fc2>=320)&(cmd_fc2<=6200),0,cmd_safe2)+select2((cmd_fc3>=320)&(cmd_fc3<=6200),0,cmd_safe3)+select2((cmd_fc4>=320)&(cmd_fc4<=6200),0,cmd_safe4)+select2((cmd_fc5>=320)&(cmd_fc5<=6200),0,cmd_safe5)+select2((cmd_fc6>=320)&(cmd_fc6<=6200),0,cmd_safe6)+select2((cmd_fc7>=320)&(cmd_fc7<=6200),0,cmd_safe7)+select2((cmd_fc8>=320)&(cmd_fc8<=6200),0,cmd_safe8)+select2((cmd_fc9>=320)&(cmd_fc9<=6200),0,cmd_safe9)+select2((cmd_fc10>=320)&(cmd_fc10<=6200),0,cmd_safe10)+select2((cmd_fc11>=320)&(cmd_fc11<=6200),0,cmd_safe11)+select2((cmd_fc12>=320)&(cmd_fc12<=6200),0,cmd_safe12)+select2((cmd_fc13>=320)&(cmd_fc13<=6200),0,cmd_safe13)+select2((cmd_fc14>=320)&(cmd_fc14<=6200),0,cmd_safe14)+select2((cmd_fc15>=320)&(cmd_fc15<=6200),0,cmd_safe15)+select2((cmd_fc16>=320)&(cmd_fc16<=6200),0,cmd_safe16)+select2((cmd_fc17>=320)&(cmd_fc17<=6200),0,cmd_safe17)+select2((cmd_fc18>=320)&(cmd_fc18<=6200),0,cmd_safe18)+select2((cmd_fc19>=320)&(cmd_fc19<=6200),0,cmd_safe19)+select2((cmd_fc20>=320)&(cmd_fc20<=6200),0,cmd_safe20)+select2((cmd_fc21>=320)&(cmd_fc21<=6200),0,cmd_safe21)+select2((cmd_fc22>=320)&(cmd_fc22<=6200),0,cmd_safe22)+select2((cmd_fc23>=320)&(cmd_fc23<=6200),0,cmd_safe23));
cmd_out_l=spl0+cmd_gain0*cmd_band_l0+cmd_gain1*cmd_band_l1+cmd_gain2*cmd_band_l2+cmd_gain3*cmd_band_l3+cmd_gain4*cmd_band_l4+cmd_gain5*cmd_band_l5+cmd_gain6*cmd_band_l6+cmd_gain7*cmd_band_l7+cmd_gain8*cmd_band_l8+cmd_gain9*cmd_band_l9+cmd_gain10*cmd_band_l10+cmd_gain11*cmd_band_l11+cmd_gain12*cmd_band_l12+cmd_gain13*cmd_band_l13+cmd_gain14*cmd_band_l14+cmd_gain15*cmd_band_l15+cmd_gain16*cmd_band_l16+cmd_gain17*cmd_band_l17+cmd_gain18*cmd_band_l18+cmd_gain19*cmd_band_l19+cmd_gain20*cmd_band_l20+cmd_gain21*cmd_band_l21+cmd_gain22*cmd_band_l22+cmd_gain23*cmd_band_l23;
cmd_out_r=spl1+cmd_gain0*cmd_band_r0+cmd_gain1*cmd_band_r1+cmd_gain2*cmd_band_r2+cmd_gain3*cmd_band_r3+cmd_gain4*cmd_band_r4+cmd_gain5*cmd_band_r5+cmd_gain6*cmd_band_r6+cmd_gain7*cmd_band_r7+cmd_gain8*cmd_band_r8+cmd_gain9*cmd_band_r9+cmd_gain10*cmd_band_r10+cmd_gain11*cmd_band_r11+cmd_gain12*cmd_band_r12+cmd_gain13*cmd_band_r13+cmd_gain14*cmd_band_r14+cmd_gain15*cmd_band_r15+cmd_gain16*cmd_band_r16+cmd_gain17*cmd_band_r17+cmd_gain18*cmd_band_r18+cmd_gain19*cmd_band_r19+cmd_gain20*cmd_band_r20+cmd_gain21*cmd_band_r21+cmd_gain22*cmd_band_r22+cmd_gain23*cmd_band_r23;
cmd_width=cmd_pole(width_smooth,-.25,.25,1,targetWidth);
cmd_sat=cmd_pole(sat_smooth,0,.35,1,targetSat);
cmd_mid=.5*(cmd_out_l+cmd_out_r);
cmd_side=.5*(cmd_out_l-cmd_out_r)*(1+cmd_width);
cmd_left=cmd_mid+cmd_side;cmd_right=cmd_mid-cmd_side;
cmd_shape(x)=select2(cmd_sat>.00001,x,x*(1+cmd_sat)/(1+cmd_sat*abs(x)));
process=min(8,max(-8,cmd_shape(cmd_left)*out_gain)),min(8,max(-8,cmd_shape(cmd_right)*out_gain));

@block
// Publish the final smoothing values to the original UI arrays.
smoothCut[0]=cmd_cut0; smoothSom[0]=cmd_som0;
smoothCut[1]=cmd_cut1; smoothSom[1]=cmd_som1;
smoothCut[2]=cmd_cut2; smoothSom[2]=cmd_som2;
smoothCut[3]=cmd_cut3; smoothSom[3]=cmd_som3;
smoothCut[4]=cmd_cut4; smoothSom[4]=cmd_som4;
smoothCut[5]=cmd_cut5; smoothSom[5]=cmd_som5;
smoothCut[6]=cmd_cut6; smoothSom[6]=cmd_som6;
smoothCut[7]=cmd_cut7; smoothSom[7]=cmd_som7;
smoothCut[8]=cmd_cut8; smoothSom[8]=cmd_som8;
smoothCut[9]=cmd_cut9; smoothSom[9]=cmd_som9;
smoothCut[10]=cmd_cut10; smoothSom[10]=cmd_som10;
smoothCut[11]=cmd_cut11; smoothSom[11]=cmd_som11;
smoothCut[12]=cmd_cut12; smoothSom[12]=cmd_som12;
smoothCut[13]=cmd_cut13; smoothSom[13]=cmd_som13;
smoothCut[14]=cmd_cut14; smoothSom[14]=cmd_som14;
smoothCut[15]=cmd_cut15; smoothSom[15]=cmd_som15;
smoothCut[16]=cmd_cut16; smoothSom[16]=cmd_som16;
smoothCut[17]=cmd_cut17; smoothSom[17]=cmd_som17;
smoothCut[18]=cmd_cut18; smoothSom[18]=cmd_som18;
smoothCut[19]=cmd_cut19; smoothSom[19]=cmd_som19;
smoothCut[20]=cmd_cut20; smoothSom[20]=cmd_som20;
smoothCut[21]=cmd_cut21; smoothSom[21]=cmd_som21;
smoothCut[22]=cmd_cut22; smoothSom[22]=cmd_som22;
smoothCut[23]=cmd_cut23; smoothSom[23]=cmd_som23;

@gfx 620 300
gfx_clear = 0;
w = gfx_w;
h = gfx_h;

gfx_set(0.80, 0.80, 0.80, 1);
gfx_x = 12; gfx_y = 10;
gfx_drawstr("Cross-Mix Somatic Bus v4 Manifold  |  Shared Bus  |  Active ");
gfx_drawnumber(active_instances, 0);
gfx_drawstr("  |  Peers ");
gfx_drawnumber(active_peer_instances, 0);
gfx_drawstr("  |  Role ");
role_name();

x0 = 14; y0 = 44; x1 = w - 14; y1 = 142;
barw = (x1 - x0) / max(active_nb, 1);

i = 0;
while (i < active_nb) (
  x = x0 + i * barw;
  a = env[i] / floor_energy - 1;
  a < 0 ? a = 0;
  a = clamp(a / 24, 0, 1);

  gr = smoothCut[i];
  gr = clamp(gr, 0, 1);

  sm = abs(smoothSom[i]);
  sm = clamp(sm * 8, 0, 1);

  gfx_set(0.20, 0.35 + 0.45 * a, 0.90, 0.82);
  gfx_rect(x, y1 - a * (y1 - y0), max(1, barw - 2), a * (y1 - y0), 1);

  gfx_set(0.95, 0.35, 0.20, 0.90);
  gfx_rect(x, y1 - gr * (y1 - y0), max(1, barw - 2), 2 + gr * (y1 - y0) * 0.08, 1);

  gfx_set(0.35, 0.95, 0.55, 0.80);
  gfx_rect(x, y1 - sm * (y1 - y0), max(1, barw - 2), 2, 1);

  i += 1;
);

gfx_set(0.55, 0.55, 0.55, 1);
gfx_line(x0, y1, x1, y1, 1);

gfx_x = 14; gfx_y = 156;
gfx_set(0.80, 0.80, 0.80, 1);
gfx_drawstr("Bus motion from peers:  Pressure "); gfx_drawnumber(bus_pressure * 100, 0); gfx_drawstr("%   Contact "); gfx_drawnumber(bus_contact * 100, 0); gfx_drawstr("%   Viscosity "); gfx_drawnumber(bus_viscosity * 100, 0); gfx_drawstr("%");

gfx_x = 14; gfx_y = 178;
gfx_drawstr("                         Thrust "); gfx_drawnumber(bus_thrust * 100, 0); gfx_drawstr("%   Arousal "); gfx_drawnumber(bus_arousal * 100, 0); gfx_drawstr("%   Fatigue "); gfx_drawnumber(bus_fatigue * 100, 0); gfx_drawstr("%");

gfx_x = 14; gfx_y = 206;
gfx_drawstr("This track drives: P "); gfx_drawnumber(local_pressure * 100, 0); gfx_drawstr("  C "); gfx_drawnumber(local_contact * 100, 0); gfx_drawstr("  V "); gfx_drawnumber(local_viscosity * 100, 0); gfx_drawstr("  T "); gfx_drawnumber(local_thrust * 100, 0);

gfx_x = 14; gfx_y = 232;
gfx_set(0.80, 0.80, 0.80, 1);
gfx_drawstr("TurnPulse manifold: rank "); gfx_drawnumber(my_rank + 1, 0); gfx_drawstr("/"); gfx_drawnumber(active_instances, 0);
gfx_drawstr("  pulse "); gfx_drawnumber(pistonPulse * 100, 0); gfx_drawstr("%  gate "); gfx_drawnumber(pistonGate * 100, 0); gfx_drawstr("%  width "); gfx_drawnumber(pistonTargetWidth * 100, 2); gfx_drawstr("%  swap "); gfx_drawnumber(piston_swap_on, 0);

gfx_x = 14; gfx_y = 266;
gfx_set(0.70, 0.70, 0.70, 1);
gfx_drawstr("Blue=local ERB activity. Orange=TurnPulse-shaped declutter yield. Green=somatic peer modulation. Width is M/S-capped below +/-1%.");
